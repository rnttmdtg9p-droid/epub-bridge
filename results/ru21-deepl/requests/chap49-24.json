  "response": {
    "translations": [
      {
        "text": "<p>\nВосемь весел снова вошли в воду, сливаясь в единый шум,\nиздавая единый удар, и лодка, казалось, летела по поверхности воды.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\nЧерез пять минут они пристали к берегу.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\nОфицер спрыгнул на тротуар и протянул руку Миледи.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\nКарета уже ждала.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n«Эта карета для нас?» — спросила Миледи.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Да, мадам, — ответил офицер.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Так гостиница находится очень далеко?\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— На другом конце города.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      }
    ]
  }
}