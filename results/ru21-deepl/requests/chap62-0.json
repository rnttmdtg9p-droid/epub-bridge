  "response": {
    "translations": [
      {
        "text": "<h2><a id=\"chap62\"/>\nГЛАВА LXII.<br/>\nДВА ВИДА ДЕМОНОВ</h2>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n«Ах! — воскликнули одновременно Рошфор и Миледи, — так это вы!»\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Да, это я.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— И вы прибыли…? — спросила Миледи.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Из Ла-Рошели, а вы?\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Из Англии.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Бакингем?\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Мертв или тяжело ранен; как раз когда я уезжал, не сумев ничего выведать у\nнего, какой-то фанатик только что убил его.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      }
    ]
  }
