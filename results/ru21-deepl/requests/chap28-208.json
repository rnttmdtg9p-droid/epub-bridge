  "response": {
    "translations": [
      {
        "text": "<p>\n— Честное слово, это такая мелочь, что даже не стоит учитывать в\nобщей сумме.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— А теперь посчитаем, сколько у нас всего: Портос?\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Тридцать эку.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Арамис?\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Десять пистолей.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— А у вас, д’Артаньян?\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Двадцать пять.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— А это в сумме? — спросил Атос.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      }
    ]
  }
