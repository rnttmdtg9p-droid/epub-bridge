    "translations": [
      {
        "text": "<p>\nИ Кетти достала из-за пазухи маленькую записку.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n«Для меня?» — спросил д’Артаньян, быстро хватая письмо.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Нет, это для другого.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Для кого-то другого?\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Да.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Его имя, его имя! — воскликнул д’Артаньян.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— Посмотрите на адрес.\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      },
      {
        "text": "<p>\n— «Граф де Вард».\n</p>",
        "detected_source_language": "FR",
        "model_type_used": "quality_optimized",
        "tag_handling_version": "v2"
      }
