      "target_sha256": "0898cbf995cd801c01f38fb2b0a07a044a7d05503036c862073064b311e15b9c"
    },
    {
      "source_id": "fr81-u306-r0033",
      "target": "Гаврош произвёл на баррикаде больше впечатления, чем ядро.",
      "source_sha256": "88f219f79258532de22acdf91090d8caea3fb7c55d4c982390a55098ac3c6554",
      "target_id": "ru-fr81-u306-r0033",
      "tag": "prose",
      "target_sha256": "ebf1aea3136f6f86e339b8db30269f0dc4cdad75d6d53b7b021ba364e934131d"
    },
    {
      "source_id": "fr81-u306-r0034",
      "target": "Ядро затерялось в груде обломков. Оно разбило самое большее одно колесо омнибуса да доконало старую тележку Ансо. Увидев это, баррикада расхохоталась.",
      "source_sha256": "eea88c9679898ba4c34fe0fed5a25c34ef9f58e18848f9d1595c3a3cc3bdbb28",
      "target_id": "ru-fr81-u306-r0034",
      "tag": "prose",
      "target_sha256": "b20a77ccdfb56a15e66721b8825811c98f8cc80002e4e1c520c25e79f4f0eeb0"
    },
    {
      "source_id": "fr81-u306-r0035",
      "target": "— Продолжайте, — крикнул Боссюэ артиллеристам.",
      "source_sha256": "5f49a04b622c60104f91837155cb943504ff17d588546e0c7dfe09720138d818",
