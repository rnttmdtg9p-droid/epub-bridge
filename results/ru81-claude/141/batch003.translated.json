{
  "unit": 141,
  "batch": 3,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u141-r0096",
      "target": "— Это верно.",
      "source_sha256": "1fa236e2447daa0f48ffd5c8a4a70fbe4bcef4fa03711354d064e959711bff99",
      "target_id": "ru-fr81-u141-r0096",
      "tag": "prose",
      "target_sha256": "7187123eb85427664fccb3fdfe99d8322b16538518b8c747279eff5fbd698075"
    },
    {
      "source_id": "fr81-u141-r0097",
      "target": "— Святой Теренций, епископ Порта, что у впадения Тибра в море, просил выбить на его камне знак, который ставили на могилах отцеубийц, в надежде, что прохожие будут плевать на его гробницу. Так и было сделано. Мёртвым надо повиноваться.",
      "source_sha256": "97a95e5b4583884bfcf4ab325c510580f6984d4a15be1aaeab7c12b84553f502",
      "target_id": "ru-fr81-u141-r0097",
      "tag": "prose",
      "target_sha256": "9a89e2a8014796b33f18fff91383fb71a4b7c0ebc76bcbc6099430f7312f28f9"
    },
    {
      "source_id": "fr81-u141-r0098",
      "target": "— Да будет так.",
      "source_sha256": "22bec2de7b23f18e53dd1f3689894f3f286091afbdac204fb7f9c0d02c73302b",
      "target_id": "ru-fr81-u141-r0098",
      "tag": "prose",
      "target_sha256": "145c3e9a220d7d35c40a4cc4e5525bf508b868fccabc42167244a15945d0b216"
    },
    {
      "source_id": "fr81-u141-r0099",
      "target": "— Тело Бернара Гвидониса, родившегося во Франции близ Рош-Абей, было, как он и повелел, и вопреки воле короля Кастилии, перенесено в церковь доминиканцев в Лиможе, хотя Бернар Гвидонис был епископом Туя в Испании. Можно ли сказать обратное?",
      "source_sha256": "c76b413e993bf06761161905e98761408dbbf18370a373f57194eec5e1e00fac",
      "target_id": "ru-fr81-u141-r0099",
      "tag": "prose",
      "target_sha256": "48585f506f07d2b11542337e88a4f153629ba2ec7b28350b906ec6ccc6dba9df"
    },
    {
      "source_id": "fr81-u141-r0100",
      "target": "— Что до этого, то нет, преподобная матушка.",
      "source_sha256": "f9838ce183864de1cf05dfabbaf8c680b86beeea97e42fb4c3ee0e75af1f6534",
      "target_id": "ru-fr81-u141-r0100",
      "tag": "prose",
      "target_sha256": "909dcc305d2676dd6fb129f5d51e805c14c75620844c2373d2749d47a29030d8"
    },
    {
      "source_id": "fr81-u141-r0101",
      "target": "— Факт засвидетельствован Плантавитом де ла Фоссом.",
      "source_sha256": "b4f6d97028dd883f832d00c2dfbeaaab3ef609c11184684b81a1b508f42e885d",
      "target_id": "ru-fr81-u141-r0101",
      "tag": "prose",
      "target_sha256": "025781ee2bf4bbd1caa0cafc965fa21add73d18c74b7d36c2a2859b2faa6b9f3"
    },
    {
      "source_id": "fr81-u141-r0102",
      "target": "Ещё несколько бусин чёток беззвучно скатилось под пальцами. Настоятельница продолжала:",
      "source_sha256": "e1462ffa315b6a0c2c1c55c3d97727f9f8061ffeda80a8af7bc416dfc0da12ec",
      "target_id": "ru-fr81-u141-r0102",
      "tag": "prose",
      "target_sha256": "74c60589602785af04bd60369925fbc4b135d69eefa51772b4b29cac03dc9db1"
    },
    {
      "source_id": "fr81-u141-r0103",
      "target": "— Отец Фовент, матушка Распятие будет погребена в том гробу, в котором она спала последние двадцать лет.",
      "source_sha256": "d16a20e9d58aed13d3d49ae12390b1e599d16643b6e9ec516335fc5d8c155e86",
      "target_id": "ru-fr81-u141-r0103",
      "tag": "prose",
      "target_sha256": "205ad00fdf5c8a678eb71a892f9279cc83d6af6892c3979bd12c9f70a82a352f"
    },
    {
      "source_id": "fr81-u141-r0104",
      "target": "— Это справедливо.",
      "source_sha256": "290d2b572cb3ceffbefa726fb82d094dfd8a1cbe073d069e14d5a29c0c37c1fa",
      "target_id": "ru-fr81-u141-r0104",
      "tag": "prose",
      "target_sha256": "c36a03c662cef774be6f04be416e3b31023e34a9dcc409ce73f08edfc61fbec7"
    },
    {
      "source_id": "fr81-u141-r0105",
      "target": "— Это продолжение сна.",
      "source_sha256": "d5ab216e631ec16235ae4e97932366a0a0b7a84d3d70b531e28b38cbf0bd38bf",
      "target_id": "ru-fr81-u141-r0105",
      "tag": "prose",
      "target_sha256": "fd8fa19326d678cef299d262ac90043d77ce8e63f0230c488be769e074245c22"
    },
    {
      "source_id": "fr81-u141-r0106",
      "target": "— Стало быть, мне придётся заколачивать её в этом самом гробу?",
      "source_sha256": "9e54e8c34bd332dc64ffb5319b53bbd84ddbb0ee0d3ac3c53f5fa3ca3880033a",
      "target_id": "ru-fr81-u141-r0106",
      "tag": "prose",
      "target_sha256": "208de0cf5728d8fd05ee6f744691358dc1651977bc367de33b31372e65d6c720"
    },
    {
      "source_id": "fr81-u141-r0107",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u141-r0107",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u141-r0108",
      "target": "— А погребальный гроб от похоронной конторы мы оставим в стороне?",
      "source_sha256": "cdcc2086ca7cfc445c8df739e317fcd9faa7e22053f08836ce039e1fd67014e6",
      "target_id": "ru-fr81-u141-r0108",
      "tag": "prose",
      "target_sha256": "1a9cf071af835b334013dd108222e25e9e91e8f74b7195f694276a7573c4098a"
    },
    {
      "source_id": "fr81-u141-r0109",
      "target": "— Именно так.",
      "source_sha256": "b9ca50b7f44ae317e5d2322a6c1142f83937b04307183c595fabb5817a7143b4",
      "target_id": "ru-fr81-u141-r0109",
      "tag": "prose",
      "target_sha256": "d9ebed989f2d0490b6179976ee8a45219cf75364dbf36a9799b8a77f2cc59c1d"
    },
    {
      "source_id": "fr81-u141-r0110",
      "target": "— Я к услугам досточтимой общины.",
      "source_sha256": "83f0e5402c68126931af745465014fa0a55c0a1a79b1a2be969b1e796ac87e29",
      "target_id": "ru-fr81-u141-r0110",
      "tag": "prose",
      "target_sha256": "958c6d9e8c824bcabccd3aa141c885283b392ea35af4ea49c6b6bf03afcb0961"
    },
    {
      "source_id": "fr81-u141-r0111",
      "target": "— Четыре матери-певчие помогут вам.",
      "source_sha256": "b8f92f5214d5b7185087ef01000c0a094e8b4bbbd5a464f67fc6c6114b191079",
      "target_id": "ru-fr81-u141-r0111",
      "tag": "prose",
      "target_sha256": "312d80c9cb44d7509833be34f3e59e4a28b998e26e9ead1e1c7bbe995eefdc66"
    },
    {
      "source_id": "fr81-u141-r0112",
      "target": "— Заколачивать гроб? Они мне не нужны.",
      "source_sha256": "d3df83b00a5753a27e6c563ab14d9abd1e5b3d3ed5dd0d7b8764c3322f3a14be",
      "target_id": "ru-fr81-u141-r0112",
      "tag": "prose",
      "target_sha256": "5a26c88e7faa33c32200c32edd36839bc013b484fa785afe65481379a975b883"
    },
    {
      "source_id": "fr81-u141-r0113",
      "target": "— Нет. Опускать его.",
      "source_sha256": "901e7d4c1730d3d3685c53993bb476558fddcbf2d2f7093f734924dc5fd8123d",
      "target_id": "ru-fr81-u141-r0113",
      "tag": "prose",
      "target_sha256": "5e6257134e867a98c143feda3b2fb8261d80bad1d14342f358b8de3e6c68f649"
    },
    {
      "source_id": "fr81-u141-r0114",
      "target": "— Куда?",
      "source_sha256": "cd52d0ab592d9a47a23e49e5b5a90ad1f2e817e2b2a55b84d97c0e17942dfd1a",
      "target_id": "ru-fr81-u141-r0114",
      "tag": "prose",
      "target_sha256": "c6171b7a9a8206fc2ad0416e8dd7b284cbeee740de1910ffff48cd6240d6f830"
    },
    {
      "source_id": "fr81-u141-r0115",
      "target": "— В склеп.",
      "source_sha256": "d2142ee6f64a4e94aa518b43919c8812c03637df1179de8cb5e1271db4368d1c",
      "target_id": "ru-fr81-u141-r0115",
      "tag": "prose",
      "target_sha256": "c803eeb9f5afaca7b7c7e9a0b7ca331e3005f9adf3fd04adae592459ae829ba1"
    },
    {
      "source_id": "fr81-u141-r0116",
      "target": "— В какой склеп?",
      "source_sha256": "cfec4f694eef18c8f13fdafb534aeb79fb3713d32de1b497d0db2ab4bd030fa7",
      "target_id": "ru-fr81-u141-r0116",
      "tag": "prose",
      "target_sha256": "5dba856290bf47576c61dcd5bc6f24e5e2bb72285b230a701f6d4c43736d9059"
    },
    {
      "source_id": "fr81-u141-r0117",
      "target": "— Под алтарём.",
      "source_sha256": "40f86a9a7f9bdd42e0353ea63beca0a6ba12f7122e795db822afe8f63f1588ef",
      "target_id": "ru-fr81-u141-r0117",
      "tag": "prose",
      "target_sha256": "ace384469fcf9ea23de71e2097ab4659c7cfe0476111bd80e5acf94a3c3896c9"
    },
    {
      "source_id": "fr81-u141-r0118",
      "target": "Фошлеван подскочил.",
      "source_sha256": "18367a17ca1d458050bbd872b4095d891e49f3f3c29cbcbb5fc76e171a13800a",
      "target_id": "ru-fr81-u141-r0118",
      "tag": "prose",
      "target_sha256": "42dbb29a0a6095306d204f1f20fd31bf64254ef350330d0be9750245b04efc58"
    },
    {
      "source_id": "fr81-u141-r0119",
      "target": "— Склеп под алтарём!",
      "source_sha256": "51e6564ff9a60a2bfd0bac58e773894e4e65763e626cb4d31af61bf10ff340da",
      "target_id": "ru-fr81-u141-r0119",
      "tag": "prose",
      "target_sha256": "f1567df4099d973ee46aeaacfe162011a66e24047f23e1c8e61ef08147190c3c"
    },
    {
      "source_id": "fr81-u141-r0120",
      "target": "— Под алтарём.",
      "source_sha256": "40f86a9a7f9bdd42e0353ea63beca0a6ba12f7122e795db822afe8f63f1588ef",
      "target_id": "ru-fr81-u141-r0120",
      "tag": "prose",
      "target_sha256": "ace384469fcf9ea23de71e2097ab4659c7cfe0476111bd80e5acf94a3c3896c9"
    },
    {
      "source_id": "fr81-u141-r0121",
      "target": "— Но…",
      "source_sha256": "9edf441aa03d051871a4163b4210ad9fb3920f6edddf5d9bef2b4a229a829a80",
      "target_id": "ru-fr81-u141-r0121",
      "tag": "prose",
      "target_sha256": "bcf90575bf4af1e4812efb7f6eff663cfc2516e80fe082d857d77a618b2090a6"
    },
    {
      "source_id": "fr81-u141-r0122",
      "target": "— У вас будет железный лом.",
      "source_sha256": "1a74ecb6cc9650b401c214d0349cc41a96adb5b41e23097c7d3c21a0cde00bc6",
      "target_id": "ru-fr81-u141-r0122",
      "tag": "prose",
      "target_sha256": "a82a70d40ec6fd59781f7a2a2049884ac95795bdc8480407462eeaa9c71530d4"
    },
    {
      "source_id": "fr81-u141-r0123",
      "target": "— Да, но…",
      "source_sha256": "04ac56538ec6ded40651fca9c3ab4794041cef0701effec3ec7636d6644ab3c7",
      "target_id": "ru-fr81-u141-r0123",
      "tag": "prose",
      "target_sha256": "5cc54d1f20fcff960f2bcdf3b200354b6cd63a856991c1cf96e21a03a4cd2a67"
    },
    {
      "source_id": "fr81-u141-r0124",
      "target": "— Вы приподнимете плиту ломом, поддев её за кольцо.",
      "source_sha256": "8e28e0b2575e8be3b33fbe955c4e80f493e399287efa49b2e1935b9dea4c5394",
      "target_id": "ru-fr81-u141-r0124",
      "tag": "prose",
      "target_sha256": "28c94c8c162fb628291b0b0cd83d848276d95619fa5bbe3c19a50540e6470b4d"
    },
    {
      "source_id": "fr81-u141-r0125",
      "target": "— Но…",
      "source_sha256": "9edf441aa03d051871a4163b4210ad9fb3920f6edddf5d9bef2b4a229a829a80",
      "target_id": "ru-fr81-u141-r0125",
      "tag": "prose",
      "target_sha256": "bcf90575bf4af1e4812efb7f6eff663cfc2516e80fe082d857d77a618b2090a6"
    },
    {
      "source_id": "fr81-u141-r0126",
      "target": "— Мёртвым надо повиноваться. Быть погребённой в склепе под алтарём часовни, не уходить в землю непосвящённую, остаться мёртвой там, где она молилась живой, — такова была последняя воля матушки Распятие. Она просила нас об этом, то есть повелела.",
      "source_sha256": "1ec8850b2c893a0eb395736b3ea7abe9985950ba4379ed6ae9a259ae23aacee2",
      "target_id": "ru-fr81-u141-r0126",
      "tag": "prose",
      "target_sha256": "6d16e57d67e32d778d2f9295ac6a5e163a1957c2564fff99d81551e86b7afa48"
    },
    {
      "source_id": "fr81-u141-r0127",
      "target": "— Но это запрещено.",
      "source_sha256": "359999bc021cd28b7b849300677bacce584672cdad1d92e1b88134870b516f2d",
      "target_id": "ru-fr81-u141-r0127",
      "tag": "prose",
      "target_sha256": "7c61605f428fe8c4a19c95a065a457c834f5c517b3534eda8d2cff534ea6cd5f"
    }
  ],
