{
  "unit": 141,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u141-r0032",
      "target": "— Отдайте мне ваши приказания, преподобнейшая матушка.",
      "source_sha256": "ec0851238053e84ca827d443c7f1c321c4ac22a732a22b312c8d45c1367d4aad",
      "target_id": "ru-fr81-u141-r0032",
      "tag": "prose",
      "target_sha256": "8802b2599bbbf582a10effba8720e8d588902e67ee4cb92a8202d28b83ea0e7c"
    },
    {
      "source_id": "fr81-u141-r0033",
      "target": "— Фовен, мы вам доверяем.",
      "source_sha256": "0f3d95ca2455c3d3dde16494ddb442decdf8a1cc6f63c33d9759c9282e2584fc",
      "target_id": "ru-fr81-u141-r0033",
      "tag": "prose",
      "target_sha256": "87ec2aa11e8d15ee5597ea3cfbc4c3108ca3ecb8c3f3c8a47d7973ac53375e18"
    },
    {
      "source_id": "fr81-u141-r0034",
      "target": "— Я здесь затем, чтобы всё делать.",
      "source_sha256": "11322586b24f3c9d1cd4538d2e1a616c30441e56bce123d1786fb9da3aa4d152",
      "target_id": "ru-fr81-u141-r0034",
      "tag": "prose",
      "target_sha256": "00b9ff19457059ebfdd00a0fb3fc292996b2cb80f91c839b5d0287187b570e06"
    },
    {
      "source_id": "fr81-u141-r0035",
      "target": "— И обо всём молчать.",
      "source_sha256": "d5d5bd660a716e9982a650171e0d236de462e5bdfe6ba91d18c464de274b7e0f",
      "target_id": "ru-fr81-u141-r0035",
      "tag": "prose",
      "target_sha256": "b9c22e04e1ff43b772646aea3c1bf301d9670d4a8de46f8445a0b230534c1fd6"
    },
    {
      "source_id": "fr81-u141-r0036",
      "target": "— Да, преподобная матушка.",
      "source_sha256": "93a8c97ab452f878a8ecae79d6f9682801ff41d0c4e401f5cdeefca57652c687",
      "target_id": "ru-fr81-u141-r0036",
      "tag": "prose",
      "target_sha256": "f93c8761ca2c23b372fe72197c1d574628308403df018e907c418c63798d6078"
    },
    {
      "source_id": "fr81-u141-r0037",
      "target": "— Когда склеп будет открыт…",
      "source_sha256": "4d17c6ce9e2a92eddbc148b5741e4c4cd7f2de4ea74f3954ac9ad07290fb1419",
      "target_id": "ru-fr81-u141-r0037",
      "tag": "prose",
      "target_sha256": "de081d3000c39a35630b5bf8ed72cddd26bf1d8ca9ca6b8d3fec09c80717255e"
    },
    {
      "source_id": "fr81-u141-r0038",
      "target": "— Я его снова закрою.",
      "source_sha256": "d9ed8df79aa46b75ba47198e5cb2837a036ac182e1cc188f1ddced0b5b7c6de8",
      "target_id": "ru-fr81-u141-r0038",
      "tag": "prose",
      "target_sha256": "b4745af9e61a21e69a5aef5304451c227135b45bfd361641d9f01759d138e578"
    },
    {
      "source_id": "fr81-u141-r0039",
      "target": "— Но прежде…",
      "source_sha256": "bd8c9274773565a35552e383d53c4abf6b3a7cca63c0704460b83a07d599c45d",
      "target_id": "ru-fr81-u141-r0039",
      "tag": "prose",
      "target_sha256": "a0393c9262553e8a994dd4e62b48923f0ef47733ff0837d676d968366feb16e1"
    },
    {
      "source_id": "fr81-u141-r0040",
      "target": "— Что, преподобная матушка?",
      "source_sha256": "2d3a25185515a2fdb67d6e313ca98f9f01f274b4b77c9727d8ad2fbd009beffc",
      "target_id": "ru-fr81-u141-r0040",
      "tag": "prose",
      "target_sha256": "41e8cefb1232e8b54ae2ed1d547e07405d3663ba6176c92c0257c56b5e4baa47"
    },
    {
      "source_id": "fr81-u141-r0041",
      "target": "— Надо будет опустить туда кое-что.",
      "source_sha256": "91c0f73452ad0d6452343690313d0a33a275f27e5530f16c2b115c6190a114da",
      "target_id": "ru-fr81-u141-r0041",
      "tag": "prose",
      "target_sha256": "418e8fdf3624f18d4745cf99c4b314b8f72382f2d9a269b3561adf0f3601b816"
    },
    {
      "source_id": "fr81-u141-r0042",
      "target": "Наступило молчание. Настоятельница, оттопырив нижнюю губу, что походило на колебание, нарушила его.",
      "source_sha256": "64a5a8952bf972f59959f767f55fcc7469723c52d59d483f37b0f4ac196adc7c",
      "target_id": "ru-fr81-u141-r0042",
      "tag": "prose",
      "target_sha256": "4175ae3aeefcd3392577bb146896826fc00624f1ac34c3e552eac6f468d48f37"
    },
    {
      "source_id": "fr81-u141-r0043",
      "target": "— Отец Фовен?",
      "source_sha256": "ef876e3b0db43f30be3291a19499ad6f422f7a11ce87a01c58ec5cc66e65befc",
      "target_id": "ru-fr81-u141-r0043",
      "tag": "prose",
      "target_sha256": "6793aa33aaaae0b0b4ee95ddc144d70d688aa3d4aee3352d5b10bd4c5cb8b39d"
    },
    {
      "source_id": "fr81-u141-r0044",
      "target": "— Преподобная матушка?",
      "source_sha256": "4f8717cde34eb9fc4ae1dede759586e0113b4b82498701bc688428ecdb412e46",
      "target_id": "ru-fr81-u141-r0044",
      "tag": "prose",
      "target_sha256": "75e55653627a358694fe9f8acc257137984b1ca359b40b439dacfb6d7977e559"
    },
    {
      "source_id": "fr81-u141-r0045",
      "target": "— Вы знаете, что нынче утром умерла одна из матерей.",
      "source_sha256": "7602baacb2377a4f39427071c332579c60121db70649b88543ad4fe4a8439e66",
      "target_id": "ru-fr81-u141-r0045",
      "tag": "prose",
      "target_sha256": "3fbd8af8090d77f1c5e82dec9920aec7c80b2c6e390d43486159ed1eff0f1fe8"
    },
    {
      "source_id": "fr81-u141-r0046",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u141-r0046",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u141-r0047",
      "target": "— Значит, вы не слышали колокола?",
      "source_sha256": "174d97c78b26931a8856d37ec8240e9b6b113ff375e31200604d4d54d71668b5",
      "target_id": "ru-fr81-u141-r0047",
      "tag": "prose",
      "target_sha256": "b673ffbabb55dfff6f76181335655033dcaa46240c92713831a03897577df53f"
    },
    {
      "source_id": "fr81-u141-r0048",
      "target": "— В глубине сада ничего не слышно.",
      "source_sha256": "f50bfb9543d9230c5b01ae2da72dce2812b6e849a48ace8d956e7d8e801c10c0",
      "target_id": "ru-fr81-u141-r0048",
      "tag": "prose",
      "target_sha256": "9c3870904569ab85456b2eaf1918edfa90fb9aa335ea96f3662328d2516b813d"
    },
    {
      "source_id": "fr81-u141-r0049",
      "target": "— В самом деле?",
      "source_sha256": "2b850e0f76effc841a4f7785ac285ef63c3fa625e89a43968ff352089c8bc3c9",
      "target_id": "ru-fr81-u141-r0049",
      "tag": "prose",
      "target_sha256": "520400e5250b09c04cf965f348f0fab60e000c1611ebefaee3dc1bb7ae55985f"
    },
    {
      "source_id": "fr81-u141-r0050",
      "target": "— Я едва различаю собственный звонок.",
      "source_sha256": "2e11b1c9df386d00791d3aa8e3c7f2cdec75c8d1529696c28a87eabd6fe7cef7",
      "target_id": "ru-fr81-u141-r0050",
      "tag": "prose",
      "target_sha256": "4edd120f3be4d4a16a200031385d791c6093d854a987e5613cb13e63438e68e3"
    },
    {
      "source_id": "fr81-u141-r0051",
      "target": "— Она скончалась на рассвете.",
      "source_sha256": "ef2466042ce7905ec876d9a936981ca35eb4ea6ecf246232e60f7dc604dfa968",
      "target_id": "ru-fr81-u141-r0051",
      "tag": "prose",
      "target_sha256": "2630b533c3aad668e90bf0f9afed272c57a63469352ac5a4c61cb14abcc8b372"
    },
    {
      "source_id": "fr81-u141-r0052",
      "target": "— А к тому же нынче утром ветер дул не в мою сторону.",
      "source_sha256": "a166faf6643ede5c3d8005c95a0673725ea926fc0688a161ed1c60be32e671e1",
      "target_id": "ru-fr81-u141-r0052",
      "tag": "prose",
      "target_sha256": "6f5412ad8e4df7f29e61481f92c2a240c77a089d173ed9bfc6596f6a9971d74d"
    },
    {
      "source_id": "fr81-u141-r0053",
      "target": "— Это матушка Распятие. Блаженная.",
      "source_sha256": "02069c5c861e7b2df67e6b1a8a89e6bc68ce9a73daab48f3832c9c0ae3e8d1a9",
      "target_id": "ru-fr81-u141-r0053",
      "tag": "prose",
      "target_sha256": "66c1ebd5df69bff4dd32df217c48917d93a10f462289c317d71f7101e40535d0"
    },
    {
      "source_id": "fr81-u141-r0054",
      "target": "Настоятельница умолкла, с минуту шевелила губами, словно творя безмолвную молитву, и продолжала:",
      "source_sha256": "4a75732c8d5c4c4a6cf8a5dc3404d8b2225e67f25904d3952e59bad08c3f59fa",
      "target_id": "ru-fr81-u141-r0054",
      "tag": "prose",
      "target_sha256": "8977cf9f6c317635ca4ae8650ae18bf73219fe491e78d68f56be014019947cbb"
    },
    {
      "source_id": "fr81-u141-r0055",
      "target": "— Три года назад одна янсенистка, госпожа де Бетюн, лишь оттого, что увидела молящуюся матушку Распятие, обратилась в правоверную.",
      "source_sha256": "9094610d95f8acaec5566732422e000338d26958a0b9f97ad62f2a24f6cfe627",
      "target_id": "ru-fr81-u141-r0055",
      "tag": "prose",
      "target_sha256": "cb566c93331fbe7dec7dfcbb05886981222ac66c40c7b396a954fc733f6b1db8"
    },
    {
      "source_id": "fr81-u141-r0056",
      "target": "— Ах да, теперь я слышу похоронный звон, преподобная матушка.",
      "source_sha256": "7194766c1b70da2a34512b67b128bcb49732bc5da5faedf6364c04658ae26e8a",
      "target_id": "ru-fr81-u141-r0056",
      "tag": "prose",
      "target_sha256": "5f4835a9d1d254dcbdd9c8c8fdc342d93f7642a0452b340c1018bd42146bf82f"
    },
    {
      "source_id": "fr81-u141-r0057",
      "target": "— Матери перенесли её в комнату покойниц, что выходит в церковь.",
      "source_sha256": "7099a66f53939a7dbb0c7d902636275182fa7f936efd9522115a3b39301f172e",
      "target_id": "ru-fr81-u141-r0057",
      "tag": "prose",
      "target_sha256": "88adb2f85de5b7525d4e99f7fa1748a9e9b3f17a9dc6b939b87d7e4b3c3c54c7"
    },
    {
      "source_id": "fr81-u141-r0058",
      "target": "— Знаю.",
      "source_sha256": "9afd0f5fd145624efbe43171685fddbd08c2829ba35edcea2ab3ff8fd394171b",
      "target_id": "ru-fr81-u141-r0058",
      "tag": "prose",
      "target_sha256": "3a2702d40f5db907f6b67aa9cf199dd288808ef729b56862e96d9b7510247e81"
    },
    {
      "source_id": "fr81-u141-r0059",
      "target": "— Никакой другой мужчина, кроме вас, не может и не должен входить в эту комнату. Смотрите же за этим хорошенько. Хороша была бы картина, если бы мужчина вошёл в комнату покойниц!",
      "source_sha256": "c8f944b37b389848091cbd5040de29829b87da8eff50f9f28d9cad9ec45e717e",
      "target_id": "ru-fr81-u141-r0059",
      "tag": "prose",
      "target_sha256": "839d49c4e8e777ddc395e2c4aa02598d6786f115f9d28ae13fddf37f43cc48e7"
    },
    {
      "source_id": "fr81-u141-r0060",
      "target": "— Как бы не так!",
      "source_sha256": "c27ca058e946d65c1e1c4190d27a9850ae479eb67f326d51044d7e2523528e15",
      "target_id": "ru-fr81-u141-r0060",
      "tag": "prose",
      "target_sha256": "692d7a869412bafe5f55b364ae61d68197cc17ccbe94f6f097cef55eaaf74b82"
    },
    {
      "source_id": "fr81-u141-r0061",
      "target": "— Что?",
      "source_sha256": "6f4905b437b6948a18583e0d14b52d7f2dd428bf5712d1870e5426b63921de17",
      "target_id": "ru-fr81-u141-r0061",
      "tag": "prose",
      "target_sha256": "517f3ff122eb546ca36332ec960df6083fe4c7e2f428e22ee5ca0183ce22e859"
    },
    {
      "source_id": "fr81-u141-r0062",
      "target": "— Как бы не так!",
      "source_sha256": "c27ca058e946d65c1e1c4190d27a9850ae479eb67f326d51044d7e2523528e15",
      "target_id": "ru-fr81-u141-r0062",
      "tag": "prose",
      "target_sha256": "692d7a869412bafe5f55b364ae61d68197cc17ccbe94f6f097cef55eaaf74b82"
    },
    {
      "source_id": "fr81-u141-r0063",
      "target": "— Что вы говорите?",
      "source_sha256": "d2c2f2d794c52e00130081a51a79c13c62fe48a35befffe865662c7522916245",
      "target_id": "ru-fr81-u141-r0063",
      "tag": "prose",
      "target_sha256": "40f69e3a0b18275e0c9e4657ad46600eb21dbebf6ca7fdb31dceddb174e13056"
    }
  ],
