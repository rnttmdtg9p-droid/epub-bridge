{
  "unit": 141,
  "batch": 5,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u141-r0160",
      "target": "— Врач по умершим уже приходил?",
      "source_sha256": "7f306b8d90df49c5c3c9d6b810286a3c3d57f7f3dedc8a6adb00dba08a94a524",
      "target_id": "ru-fr81-u141-r0160",
      "tag": "prose",
      "target_sha256": "b139de30195eee0d88b4bc514c2c1001a31256a285aa0830b2063332ec2534ee"
    },
    {
      "source_id": "fr81-u141-r0161",
      "target": "— Он придёт сегодня в четыре часа. Уже звонили тем звонком, что вызывает врача по умершим. Да неужто вы не слышите никакого звонка?",
      "source_sha256": "bbbe6c65df3b1402aeee5627223e66c7605b9429c3f1852674bce2cdc92090f8",
      "target_id": "ru-fr81-u141-r0161",
      "tag": "prose",
      "target_sha256": "e0d0a562df85ce7efb9a8707db6adf027b3a48cdccf8233894b1a9147feb3158"
    },
    {
      "source_id": "fr81-u141-r0162",
      "target": "— Я слушаю только свой.",
      "source_sha256": "29ab59f517fb47d51d06df3930dcc920c4277f14b0716a9d92ee4b175ab431ce",
      "target_id": "ru-fr81-u141-r0162",
      "tag": "prose",
      "target_sha256": "db9a2c77d6b8e1f0ebbaaf74a7da0485a8cd383f9a857a88649607eda93610e8"
    },
    {
      "source_id": "fr81-u141-r0163",
      "target": "— Это хорошо, отец Фовен.",
      "source_sha256": "935b272c2bf23ff943d6c335f1724b90ea55fd8c3e89da0f09cb003ec32b8402",
      "target_id": "ru-fr81-u141-r0163",
      "tag": "prose",
      "target_sha256": "09f6ea6325371c83bfc27f1a503a67b28ad5ec56026ab22731d5c55cbc6d4ef6"
    },
    {
      "source_id": "fr81-u141-r0164",
      "target": "— Преподобная матушка, понадобится рычаг не меньше шести футов.",
      "source_sha256": "6fdb600e712d8d713b52eaa79322d2478f47ab0b8a81e2aff52c525c3a083c7b",
      "target_id": "ru-fr81-u141-r0164",
      "tag": "prose",
      "target_sha256": "c74a71c8953e17947e08418878ef40d024ac792ea13b9d7f0961555213ed7e45"
    },
    {
      "source_id": "fr81-u141-r0165",
      "target": "— Где вы его возьмёте?",
      "source_sha256": "ed92637d8e36a8c5e1051cb595b8772d4798a3fb173aab41771bcf459cac7960",
      "target_id": "ru-fr81-u141-r0165",
      "tag": "prose",
      "target_sha256": "f1af642de6c9a7a4216e69c9d30bea0a83fff97e997e504f2e13bfc0f27f0630"
    },
    {
      "source_id": "fr81-u141-r0166",
      "target": "— Где нет недостатка в решётках, там нет недостатка и в железных прутьях. У меня в глубине сада лежит куча железного лома.",
      "source_sha256": "5e8a8dafb0d06f6cf427b9519689b07fd4980f624a4e8ca046b39762f6e119a0",
      "target_id": "ru-fr81-u141-r0166",
      "tag": "prose",
      "target_sha256": "6f169c84a2e70d7f3de02e55d1a8685c943349c0e4b506c1b6a34fb9ecc7d952"
    },
    {
      "source_id": "fr81-u141-r0167",
      "target": "— Примерно за три четверти часа до полуночи; не забудьте.",
      "source_sha256": "bc4814d6cb7667883768668870cac957d35f7d83c8d9589db11242c659fd9da8",
      "target_id": "ru-fr81-u141-r0167",
      "tag": "prose",
      "target_sha256": "9974149c94ff70f33760ef1cf4ec9a25a5f1c997af7619ee855b592ae476f3fd"
    },
    {
      "source_id": "fr81-u141-r0168",
      "target": "— Преподобная матушка?",
      "source_sha256": "4f8717cde34eb9fc4ae1dede759586e0113b4b82498701bc688428ecdb412e46",
      "target_id": "ru-fr81-u141-r0168",
      "tag": "prose",
      "target_sha256": "75e55653627a358694fe9f8acc257137984b1ca359b40b439dacfb6d7977e559"
    },
    {
      "source_id": "fr81-u141-r0169",
      "target": "— Что?",
      "source_sha256": "61a0fac8ae488c6bc653f1215cdda5ca31b778598be9273b7ab3b579855004d9",
      "target_id": "ru-fr81-u141-r0169",
      "tag": "prose",
      "target_sha256": "517f3ff122eb546ca36332ec960df6083fe4c7e2f428e22ee5ca0183ce22e859"
    },
    {
      "source_id": "fr81-u141-r0170",
      "target": "— Если у вас когда-нибудь будут другие такие работы, так вот мой брат — он сильный. Настоящий турок!",
      "source_sha256": "d3cc02020dd27e82033f6f8728c2f343ab832f938dc471e50802ef40c865e82d",
      "target_id": "ru-fr81-u141-r0170",
      "tag": "prose",
      "target_sha256": "f2537110eeda7823c90b3589c017c41730f233f4ad0d101dcbea239e32e02470"
    },
    {
      "source_id": "fr81-u141-r0171",
      "target": "— Вы сделаете это как можно скорее.",
      "source_sha256": "317e6a2af702316dc8f4256693adbdf9cef2c00dc7c367d490ba47b5d606e6f0",
      "target_id": "ru-fr81-u141-r0171",
      "tag": "prose",
      "target_sha256": "791ae3383210f533169f84f1b3c4576c5c72099eb96c37d35d5f0794ab72ed89"
    },
    {
      "source_id": "fr81-u141-r0172",
      "target": "— Я не больно прытко хожу. Я увечный; оттого мне и нужен был бы помощник. Я хромой.",
      "source_sha256": "822dcf3452ea7db9e8062c2209ecede45707b23b15265e9ea82e1c70eebd1aa7",
      "target_id": "ru-fr81-u141-r0172",
      "tag": "prose",
      "target_sha256": "cbfb32b921a5b13f66360a6deaf0221880b7130f81dca228103cdefab1210792"
    },
    {
      "source_id": "fr81-u141-r0173",
      "target": "— Хромота — не порок и может оказаться благословением. У императора Генриха II, который боролся с антипапой Григорием и восстановил Бенедикта VIII, два прозвания: Святой и Хромой.",
      "source_sha256": "d3bf1ac6f735392ec44ed19764daa6507f4e96ee0d033d180878dea6972f4817",
      "target_id": "ru-fr81-u141-r0173",
      "tag": "prose",
      "target_sha256": "f62a300cd910b2d3d73f013cee09289e2ad7eb687967ba81ffbcf869f93ab820"
    },
    {
      "source_id": "fr81-u141-r0174",
      "target": "— Оно хорошо, а особливо — два, — пробормотал Фошлеван, который на деле был немного туг на ухо.",
      "source_sha256": "255a10af7f6f2266904856b141ba6f51fad7030ff6b10a4111fb773e6d18f7f3",
      "target_id": "ru-fr81-u141-r0174",
      "tag": "prose",
      "target_sha256": "8838208cd7aac67afcad8596aba9e72df2650b55e1889e0ae9fcdfdb461775a6"
    },
    {
      "source_id": "fr81-u141-r0175",
      "target": "— Отец Фовен, я тут подумала: возьмём целый час. Это не слишком много. Будьте у главного алтаря со своим железным прутом в одиннадцать часов. Служба начинается в полночь. Нужно, чтобы всё было кончено добрую четверть часа раньше.",
      "source_sha256": "f6a7728d44c297213e689eb3cb86583542cd9880e450fd7a389d9d5dc00356ba",
      "target_id": "ru-fr81-u141-r0175",
      "tag": "prose",
      "target_sha256": "e3e8b4d06133d7c903ebd5474717e4dd3c56460dd8568fd9c00df2d9ff734bb1"
    },
    {
      "source_id": "fr81-u141-r0176",
      "target": "— Я всё сделаю, чтобы доказать свою преданность общине. Так и порешим. Я заколочу гроб. Ровно в одиннадцать я буду в часовне. Матери-певчие там будут, матушка Вознесение там будет. Два человека — это было бы лучше. Ну, да всё равно! У меня будет рычаг. Мы откроем склеп, опустим гроб и снова закроем склеп. После чего не останется и следа. Правительство ничего не заподозрит. Преподобная матушка, всё так и устроено?",
      "source_sha256": "760c2b6878fa589c312265c5a3cf128142be0385888f76aafb7bee5d514c3195",
      "target_id": "ru-fr81-u141-r0176",
      "tag": "prose",
      "target_sha256": "56d5ce7ee3eab5f07515194fcc3e60a4b15924bd25f73fdbc2d3e74d2c768569"
    },
    {
      "source_id": "fr81-u141-r0177",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u141-r0177",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u141-r0178",
      "target": "— Что же ещё?",
      "source_sha256": "e4e5d3371ec153de8cbc57cbba0e722be8f8a29f709316d5a2d5861f8bb34cdd",
      "target_id": "ru-fr81-u141-r0178",
      "tag": "prose",
      "target_sha256": "26b6a077069bc902f8e65b54984f0ac18244e53183c8d09139cdf1f98e167f78"
    },
    {
      "source_id": "fr81-u141-r0179",
      "target": "— Остаётся пустой гроб.",
      "source_sha256": "cd0c2ed68aa3547283ad3fbf0c52b542714349a0056b94e5500bdb435812513c",
      "target_id": "ru-fr81-u141-r0179",
      "tag": "prose",
      "target_sha256": "135d79bc3753a49bf06fed488e0130609f9e244405137d06abdbc0e534e6ae4a"
    },
    {
      "source_id": "fr81-u141-r0180",
      "target": "Это вызвало остановку. Фошлеван думал. Настоятельница думала.",
      "source_sha256": "c59d01f5533f57134211ae16de01ea3fe879c3ffcc83577e6b8e8ef8560c2642",
      "target_id": "ru-fr81-u141-r0180",
      "tag": "prose",
      "target_sha256": "8ebb91519c4616e62187c95a0997764fb53fb0233912c3618f5d481a3c079184"
    },
    {
      "source_id": "fr81-u141-r0181",
      "target": "— Отец Фовен, что же делать с гробом?",
      "source_sha256": "0daf70af3bbf7030893b8a9b53ae041a4b0e729814b13f502de94cbf5ce71cdd",
      "target_id": "ru-fr81-u141-r0181",
      "tag": "prose",
      "target_sha256": "307e48476be7f8b8598d269b96cac3bc2a59aa11f7c7e5d4dff1d231943cf225"
    },
    {
      "source_id": "fr81-u141-r0182",
      "target": "— Его предадут земле.",
      "source_sha256": "12951fde7159cfe846b57d6f3082bcfbaa73939f9f54329182ecfd8626d9d591",
      "target_id": "ru-fr81-u141-r0182",
      "tag": "prose",
      "target_sha256": "f70deba5e7eea31a17aea5763c119b1643c9b7809130a59e792f0894ec006597"
    },
    {
      "source_id": "fr81-u141-r0183",
      "target": "— Пустой?",
      "source_sha256": "ad2db7b5e89a2913a03f6f82c36da9682c045eaefe43cb3b49bd83117153907f",
      "target_id": "ru-fr81-u141-r0183",
      "tag": "prose",
      "target_sha256": "46d756e30c5767c2e1a51bc1097f9ebd037720f4acbc34e84ac6a6c54c1b7ec8"
    },
    {
      "source_id": "fr81-u141-r0184",
      "target": "Снова молчание. Фошлеван сделал левой рукой тот жест, каким отмахиваются от тревожного вопроса.",
      "source_sha256": "f6ff07c0cf6d6c03079308dcdf52e2c408a5160c4284d26f078d69a79a102ec4",
      "target_id": "ru-fr81-u141-r0184",
      "tag": "prose",
      "target_sha256": "a26086bbe57682a3cfcc2662867f5e3ea68821f4ffd8bb89d0022f7301375cdb"
    },
    {
      "source_id": "fr81-u141-r0185",
      "target": "— Преподобная матушка, это я заколачиваю гроб в нижней комнате церкви, и никто, кроме меня, туда войти не может, а гроб я накрою погребальным покровом.",
      "source_sha256": "377f93f3b312d585801e3253f9f56aeb1f644c9c5ad3c6ecfd822c45e5c614e1",
      "target_id": "ru-fr81-u141-r0185",
      "tag": "prose",
      "target_sha256": "99b1b9d7639c579e8959bad3a8f4a494d3975b0b72515cd9d218141d8b1b8908"
    },
    {
      "source_id": "fr81-u141-r0186",
      "target": "— Да, но носильщики, когда будут класть его на катафалк и опускать в могилу, непременно почувствуют, что внутри ничего нет.",
      "source_sha256": "9a94155239f7b9f6afbffeaef5e7c3ebd598bccf1d7829fbc6a35b6f30f69cb1",
      "target_id": "ru-fr81-u141-r0186",
      "tag": "prose",
      "target_sha256": "2e7609e245e691c64b7b857fc91d0d84555c16a070851e48952c64c2fbc12530"
    },
    {
      "source_id": "fr81-u141-r0187",
      "target": "— Ах, дья…! — воскликнул Фошлеван.",
      "source_sha256": "86bba89981235b051d4af01a55b57121320aabd34fcce4182fe135de79fb12f9",
      "target_id": "ru-fr81-u141-r0187",
      "tag": "prose",
      "target_sha256": "4134bde1063234b8dfebb0cbb6caf3200ef50b8dccb0ea00214c67f9f4407f43"
    },
    {
      "source_id": "fr81-u141-r0188",
      "target": "Настоятельница начала было креститься и пристально посмотрела на садовника. [[I]]Вол[[/I]] застрял у него в горле.",
      "source_sha256": "be688168c89c5e9b0b3f024dd40a01cec57cf790f15c1ca4c2a84e892e811e57",
      "target_id": "ru-fr81-u141-r0188",
      "tag": "prose",
      "target_sha256": "64194d1d7de3f1d9c739d67585b46725dc50a8d53ac3166c9971237176d8c4c9"
    },
    {
      "source_id": "fr81-u141-r0189",
      "target": "Он поспешил придумать на ходу какую-нибудь уловку, чтобы заставить забыть о богохульстве.",
      "source_sha256": "c17ea3e432157fcaeb25c02c15a76665cbba396d44d9bc121773a7931a626b4a",
      "target_id": "ru-fr81-u141-r0189",
      "tag": "prose",
      "target_sha256": "b0a9f6fdd2f9647af0ba768cf37d0f711c11948542a71ff44bfaf0ce7a7c64ee"
    },
    {
      "source_id": "fr81-u141-r0190",
      "target": "— Преподобная матушка, я насыплю в гроб земли. Будет так, как будто там кто-то есть.",
      "source_sha256": "491f7750b8d6f295bdb43be98452ac66e9676232352f0714b7110bbf45a35efc",
      "target_id": "ru-fr81-u141-r0190",
      "tag": "prose",
      "target_sha256": "1ec3c18902071cfaded4f1f0592cc149df6c5df2f52baed268e78f9a13ecb9ea"
    },
    {
      "source_id": "fr81-u141-r0191",
      "target": "— Вы правы. Земля — это то же, что человек. Итак, вы уладите дело с пустым гробом?",
      "source_sha256": "b30596f24ba06450d4a149747157515153a35ee66623862b973e610656d3e6e6",
      "target_id": "ru-fr81-u141-r0191",
      "tag": "prose",
      "target_sha256": "6e271548460be644a6d97b5184f0d058d130444c2da49d55b230686365fc14ad"
    }
  ],
