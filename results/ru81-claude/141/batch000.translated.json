{
  "unit": 141,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u141-h",
      "target": "III. Мать Иннокентия",
      "source_sha256": "9001419c5f5ada0819a1c9b1b8ad9328500d118b60100346c52859cb709f2410",
      "target_id": "ru-fr81-u141-h",
      "tag": "heading",
      "target_sha256": "97cf339ce00a84ed4fd8b7fef22f7bb0b11442e0c1b02b07c861fd79a503e6f8"
    },
    {
      "source_id": "fr81-u141-r0001",
      "target": "Прошло около четверти часа. Настоятельница вернулась и снова села на стул.",
      "source_sha256": "628ef760a6bae717c43986cf9722171586e35a0a3de5ee6d9a2751f22400f03f",
      "target_id": "ru-fr81-u141-r0001",
      "tag": "prose",
      "target_sha256": "a5244e78896fca11229d7435d73437c0277aca000c55beebad3c03415c6548bb"
    },
    {
      "source_id": "fr81-u141-r0002",
      "target": "Оба собеседника казались озабоченными. Мы стенографируем, как умеем, завязавшийся между ними разговор.",
      "source_sha256": "6237bc120fd05abaaf0ac273619515313fc448b7bdee28d1222bc810d2cd5396",
      "target_id": "ru-fr81-u141-r0002",
      "tag": "prose",
      "target_sha256": "7d558d015704d049a7bb13f27424fc50875e07a76e7077a583026497a4ccdd7b"
    },
    {
      "source_id": "fr81-u141-r0003",
      "target": "— Отец Фовен?",
      "source_sha256": "ef876e3b0db43f30be3291a19499ad6f422f7a11ce87a01c58ec5cc66e65befc",
      "target_id": "ru-fr81-u141-r0003",
      "tag": "prose",
      "target_sha256": "6793aa33aaaae0b0b4ee95ddc144d70d688aa3d4aee3352d5b10bd4c5cb8b39d"
    },
    {
      "source_id": "fr81-u141-r0004",
      "target": "— Преподобная матушка?",
      "source_sha256": "4f8717cde34eb9fc4ae1dede759586e0113b4b82498701bc688428ecdb412e46",
      "target_id": "ru-fr81-u141-r0004",
      "tag": "prose",
      "target_sha256": "75e55653627a358694fe9f8acc257137984b1ca359b40b439dacfb6d7977e559"
    },
    {
      "source_id": "fr81-u141-r0005",
      "target": "— Вы знаете часовню?",
      "source_sha256": "46092ad3755a6d7d79a4e0d7c887305202816a6d96bb79bfb3af93e683e06f71",
      "target_id": "ru-fr81-u141-r0005",
      "tag": "prose",
      "target_sha256": "c9323b7dba34e60a9ab4cd8a5182d198d121983fcd93df131eadd1aaa3fce192"
    },
    {
      "source_id": "fr81-u141-r0006",
      "target": "— У меня там есть небольшая клетушка, откуда я слушаю мессу и службы.",
      "source_sha256": "a5aa5a2ec1ff7651047cf48f90af03af0c1bc3d2cf5123405dcf72def2a4a42f",
      "target_id": "ru-fr81-u141-r0006",
      "tag": "prose",
      "target_sha256": "0e23e6ceb66bca3fb546836ec4689b849696c5fa0aa2f32735395967b810e4e3"
    },
    {
      "source_id": "fr81-u141-r0007",
      "target": "— И вы входили на клирос по своей работе?",
      "source_sha256": "d2b410a3b7471fa31638b3116bad8801c397ad380527d10b745aea831d2c1ae9",
      "target_id": "ru-fr81-u141-r0007",
      "tag": "prose",
      "target_sha256": "9efa591e56cab37e84b88d3c023bee57a6d07cafea52b8b7171f0f3a41c484db"
    },
    {
      "source_id": "fr81-u141-r0008",
      "target": "— Два или три раза.",
      "source_sha256": "0ae9ece7a7294dfb90d5a5f8993535782a471e9ace58bb9cd51896b7b85dd463",
      "target_id": "ru-fr81-u141-r0008",
      "tag": "prose",
      "target_sha256": "384d7ee1b52220b93d93ef16837ed9ae24cfdddbb2e5af76842ea9da435e951a"
    },
    {
      "source_id": "fr81-u141-r0009",
      "target": "— Нужно поднять камень.",
      "source_sha256": "b428a941242e732b30fa66076d34ab6391976ba9529754326f15f154ffc0381b",
      "target_id": "ru-fr81-u141-r0009",
      "tag": "prose",
      "target_sha256": "52cd4925a137396510412ba8ae494a2d20661d545de4111d238b39eedcdbd40f"
    },
    {
      "source_id": "fr81-u141-r0010",
      "target": "— Тяжёлый?",
      "source_sha256": "6beb701bd8281a6dce479c42b1005e76950e075cd74a0fbb3c71b29583146fa4",
      "target_id": "ru-fr81-u141-r0010",
      "tag": "prose",
      "target_sha256": "ce6b85cf2906bf61bc14869ae1be334b0af58138beaba831e5156ffb7c9ad14a"
    },
    {
      "source_id": "fr81-u141-r0011",
      "target": "— Плиту в полу, рядом с алтарём.",
      "source_sha256": "458899e3e0589a1d5eff324832d05552a02f96ad4adddbb04e952817b77be652",
      "target_id": "ru-fr81-u141-r0011",
      "tag": "prose",
      "target_sha256": "c7a6039cd875d186f55e056c1438462b49a91d81a2bb0008f7a4a905a61250d7"
    },
    {
      "source_id": "fr81-u141-r0012",
      "target": "— Камень, что закрывает склеп?",
      "source_sha256": "176747fe8fc22726a1f452124895c59e430ef59cbd2e64b802b22e5b4232b2be",
      "target_id": "ru-fr81-u141-r0012",
      "tag": "prose",
      "target_sha256": "0315cdad859ce1ae8dac981ad316d00fade14a20343584f332c2f79cf42a836b"
    },
    {
      "source_id": "fr81-u141-r0013",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u141-r0013",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u141-r0014",
      "target": "— Тут бы хорошо иметь двух мужчин.",
      "source_sha256": "35a50143dca6e087c75da827dec1d7e014e87b664727e867cafbfc5f108dd10b",
      "target_id": "ru-fr81-u141-r0014",
      "tag": "prose",
      "target_sha256": "af87c367d7aca707cc2984f932719cda95e759508842dbb684d40401e2b5b5a3"
    },
    {
      "source_id": "fr81-u141-r0015",
      "target": "— Мать Вознесение, она сильна, как мужчина, вам поможет.",
      "source_sha256": "eb01b5d60942298c6a79e91eb3d9ebd1799d561c709bc176101d8488e8f1bbab",
      "target_id": "ru-fr81-u141-r0015",
      "tag": "prose",
      "target_sha256": "65511748564f31194c603e7728bd793c377bd2dd5705a9b7e2644e0fc257bf1c"
    },
    {
      "source_id": "fr81-u141-r0016",
      "target": "— Женщина никогда не бывает мужчиной.",
      "source_sha256": "35d2ab169b6d9c48c9cf296fc7f6d062929a95be79e1549b2f0de1c57b7c9907",
      "target_id": "ru-fr81-u141-r0016",
      "tag": "prose",
      "target_sha256": "8d76f8689d293fa8668f0365c88b448377a57142184201f8b4c82c710f9d75e2"
    },
    {
      "source_id": "fr81-u141-r0017",
      "target": "— У нас есть только одна женщина, чтобы вам помогать. Каждый делает что может. Если дом Мабийон приводит четыреста семнадцать посланий святого Бернара, а Мерлоний Хорстий всего триста шестьдесят семь, я нисколько не презираю Мерлония Хорстия.",
      "source_sha256": "b7f9d5db185630cf4eb5fe7159adcf61b2fa56fa71a9394e72cfec62b482cb81",
      "target_id": "ru-fr81-u141-r0017",
      "tag": "prose",
      "target_sha256": "74e0c57ce23dbe5bd8e07662cdabe9e90d3cc643a909c4373da7445c1c3450f4"
    },
    {
      "source_id": "fr81-u141-r0018",
      "target": "— И я тоже.",
      "source_sha256": "ed2a220637575ce6477eeafe73aff7d0db531d5afff2fca3e7bb6d9470a19fea",
      "target_id": "ru-fr81-u141-r0018",
      "tag": "prose",
      "target_sha256": "416dba07d63caf6a09a8cac7251f8a386d3ae88541ec84766481fde4cc8e3abe"
    },
    {
      "source_id": "fr81-u141-r0019",
      "target": "— Заслуга в том, чтобы трудиться по своим силам. Обитель — не строительная площадка.",
      "source_sha256": "5bbb6af829318b0f151c54ab84ac6d2e979e81675572727ffca3ae8c8857e72f",
      "target_id": "ru-fr81-u141-r0019",
      "tag": "prose",
      "target_sha256": "e6000a99fcaf360c0435d82bc6a49acd8650ca6f191471623f78096dce0321b9"
    },
    {
      "source_id": "fr81-u141-r0020",
      "target": "— А женщина — не мужчина. Вот мой брат — тот силён!",
      "source_sha256": "8ecb3ab827e536debf4ab5fee1926aea6c31c103f66579c6f36c0b9cb0a49ec9",
      "target_id": "ru-fr81-u141-r0020",
      "tag": "prose",
      "target_sha256": "ce7e97fe37938376a40f4871415266b160fb04ec04d5ffc3d1a71e7fb922ca1f"
    },
    {
      "source_id": "fr81-u141-r0021",
      "target": "— И потом у вас будет рычаг.",
      "source_sha256": "5a14bf6b503c03ad785781fa41d8e6a82234cfc2e793a3e44ea9b3dc2ea1913f",
      "target_id": "ru-fr81-u141-r0021",
      "tag": "prose",
      "target_sha256": "44669973a55ca5ea7be13d39d10219da36be4909fbb541b2a6ecc745eaffbe05"
    },
    {
      "source_id": "fr81-u141-r0022",
      "target": "— Это единственный ключ, который подходит к таким дверям.",
      "source_sha256": "ba918f894ce68738053361545432062a5bf9301f72b8928561bbd0e93a8d7d0a",
      "target_id": "ru-fr81-u141-r0022",
      "tag": "prose",
      "target_sha256": "b8ce048acb75b633d64c410ed57984954da809faf774516b18f50b00364985fc"
    },
    {
      "source_id": "fr81-u141-r0023",
      "target": "— В камне есть кольцо.",
      "source_sha256": "7a61abb9de30171d98ea0629548715c3c6142686deabcf6c26450d27d6ce3488",
      "target_id": "ru-fr81-u141-r0023",
      "tag": "prose",
      "target_sha256": "2d37c30d5a083b8c46a88dc8d53656ab34320d1d4fa757a6207477d11a2852ce"
    },
    {
      "source_id": "fr81-u141-r0024",
      "target": "— Я продену в него рычаг.",
      "source_sha256": "cfe09f76e6c8e2762c6adc00a89e666e7da1a5477c07172203af98c744feca5f",
      "target_id": "ru-fr81-u141-r0024",
      "tag": "prose",
      "target_sha256": "2c1b8b3db21ca253e9d1a372d8e3f4841db114b150416f9357a6ab21f611249f"
    },
    {
      "source_id": "fr81-u141-r0025",
      "target": "— И камень устроен так, что поворачивается.",
      "source_sha256": "2ac6c51fda11473524a156da1a925575834c165292097093231fe52a3b087e6c",
      "target_id": "ru-fr81-u141-r0025",
      "tag": "prose",
      "target_sha256": "7b50622209c81f224c6bb217710e506303b42e245d2d2e8aed08d4ac282b019b"
    },
    {
      "source_id": "fr81-u141-r0026",
      "target": "— Хорошо, преподобная матушка. Я открою склеп.",
      "source_sha256": "e0c6f4bc29ab9625db1d3a69873a525b9234a75f4deebbbaa337bda2de164733",
      "target_id": "ru-fr81-u141-r0026",
      "tag": "prose",
      "target_sha256": "4e929d68435be7d9cbdc177054b62b319fe9b3987b4b5cf2d8f793c46ac45b51"
    },
    {
      "source_id": "fr81-u141-r0027",
      "target": "— И вам помогут четыре матери-певчие.",
      "source_sha256": "e004d729fbf5e04777568b7ba5f4b9dc817b173492822841331db4239e834834",
      "target_id": "ru-fr81-u141-r0027",
      "tag": "prose",
      "target_sha256": "5866bfa58bbe94391419e860a40a565d1b9102bd598d02473cd1f4fd03560382"
    },
    {
      "source_id": "fr81-u141-r0028",
      "target": "— А когда склеп будет открыт?",
      "source_sha256": "9013356f3558368667a44db1fe3d4d2b62846136d652d601e31ec8787497524b",
      "target_id": "ru-fr81-u141-r0028",
      "tag": "prose",
      "target_sha256": "429d51a4048d2192ed3b35bcbde314e54ec0f263e73b254726fcb7c5b9168128"
    },
    {
      "source_id": "fr81-u141-r0029",
      "target": "— Его нужно будет закрыть снова.",
      "source_sha256": "e9787c5cfdfbc762ed66530e33bd95a22faeb595564b357c9ca5f2fe1611e6cc",
      "target_id": "ru-fr81-u141-r0029",
      "tag": "prose",
      "target_sha256": "ab3cbd5da50eb5923b893d0bfe45ed53c2072aee6b5b2b90a1c6dfbbe7a11a42"
    },
    {
      "source_id": "fr81-u141-r0030",
      "target": "— И это всё?",
      "source_sha256": "e45efba26400cacba76b7d56dcb543ff61651be10132ef2d5d833f5c33915caf",
      "target_id": "ru-fr81-u141-r0030",
      "tag": "prose",
      "target_sha256": "62677d134425435697ccb24c2fb164fbe02e3bbde3c9e9b7e83f29b5d84703c9"
    },
    {
      "source_id": "fr81-u141-r0031",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u141-r0031",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    }
  ],
