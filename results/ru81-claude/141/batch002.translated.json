{
  "unit": 141,
  "batch": 2,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u141-r0064",
      "target": "— Я говорю: куда там.",
      "source_sha256": "382e156abfba78f997468eb54d1222689af407607a58697937bb77e86f6de7dc",
      "target_id": "ru-fr81-u141-r0064",
      "tag": "prose",
      "target_sha256": "c31fc8a7b08f046a19c125e5e8e81cb9a1bebdd08c9c4055720d6f5ab4dab59d"
    },
    {
      "source_id": "fr81-u141-r0065",
      "target": "— Куда там — куда?",
      "source_sha256": "d3dd3468b78828262fd8fcbfe1d5bb869d6053d1b3e2942c267957eb1bc19db0",
      "target_id": "ru-fr81-u141-r0065",
      "tag": "prose",
      "target_sha256": "68ac6054600f51fdb721ac8b1fe402a597bbf4a9743035a8c3827d5cb9270864"
    },
    {
      "source_id": "fr81-u141-r0066",
      "target": "— Преподобная матушка, я не говорю «куда», я говорю «куда там».",
      "source_sha256": "c57f73e24be2063d296ad587d14a332f32beec99f1accd452db45a09eb94ce0d",
      "target_id": "ru-fr81-u141-r0066",
      "tag": "prose",
      "target_sha256": "84c3c5bf2501725c02f00e267b4a2300b01cd0618d0f8c400c9ea1c3a3962816"
    },
    {
      "source_id": "fr81-u141-r0067",
      "target": "— Я вас не понимаю. Почему вы говорите «куда там»?",
      "source_sha256": "2d419027606845ade62759455bcee89eb3c1c9b048194abe908581743ef35db7",
      "target_id": "ru-fr81-u141-r0067",
      "tag": "prose",
      "target_sha256": "270fe077e070a6c3ab722b1114203e6950cde7833f18ba1f0953d59ab938631b"
    },
    {
      "source_id": "fr81-u141-r0068",
      "target": "— Чтобы сказать, как вы, преподобная матушка.",
      "source_sha256": "31e0f17730b7e03c9ddaacef55e0eb9f0470c82b70ece6ece11b0dd459c72ddc",
      "target_id": "ru-fr81-u141-r0068",
      "tag": "prose",
      "target_sha256": "54a51c21b3b8d9c6f104e8961f29af779e51993812f6756bd26b078311c1d96b"
    },
    {
      "source_id": "fr81-u141-r0069",
      "target": "— Но я не говорила «куда там».",
      "source_sha256": "8b5dfd122e3c3e048fe88969c0813c2b94e2891f7a99426d1abff1e7618dfdb8",
      "target_id": "ru-fr81-u141-r0069",
      "tag": "prose",
      "target_sha256": "a7ab08b1f1ee2998eb809fb426c0fd57f5cdf39f680637a13d5747fb95e2b87f"
    },
    {
      "source_id": "fr81-u141-r0070",
      "target": "— Вы не говорили, а я сказал, чтобы сказать, как вы.",
      "source_sha256": "40d8a3be0078cf7b462a55ec4eac7f67feaf0204e4fa35de80554401e61b5ec6",
      "target_id": "ru-fr81-u141-r0070",
      "tag": "prose",
      "target_sha256": "6708c373ca011728968548bf78165f49255716692421665f1359ddcadfdbe6da"
    },
    {
      "source_id": "fr81-u141-r0071",
      "target": "В этот миг пробило девять часов.",
      "source_sha256": "69db73c10c9c8eb59e69ad83e4a6818f1ace5f2d77d0ea3b459fd076f9f6eb62",
      "target_id": "ru-fr81-u141-r0071",
      "tag": "prose",
      "target_sha256": "19e0e11cc96685e79e6f4b1f750f5aa390c65ddd903d10ca78b5d52add1583df"
    },
    {
      "source_id": "fr81-u141-r0072",
      "target": "— В девять часов утра и в любой час да будет хвалимо и обожаемо пресвятое Таинство алтаря, — сказала настоятельница.",
      "source_sha256": "041fe9d54e3677a7336ffb610db88454a0037ed64f38edd813298e3a46233bd6",
      "target_id": "ru-fr81-u141-r0072",
      "tag": "prose",
      "target_sha256": "75bf45c23586bf8ad3adfe7ab1d4ce4ec3f20bb139a479d4dbed5f8a059cd3a7"
    },
    {
      "source_id": "fr81-u141-r0073",
      "target": "— Аминь, — сказал Фошлеван.",
      "source_sha256": "c6b7ae11c2ffdcbfa548ee0e6696c384a7c2319f40fe76630dc7d452ccc80398",
      "target_id": "ru-fr81-u141-r0073",
      "tag": "prose",
      "target_sha256": "68328a01b7a29666f5b495816a90d05e0fbc9f71f6bbc07497174d9cfc05f876"
    },
    {
      "source_id": "fr81-u141-r0074",
      "target": "Бой часов пришёлся кстати. Он оборвал это «Куда там». Вероятно, без него настоятельница и Фошлеван никогда бы не выпутались из этого клубка.",
      "source_sha256": "f937d214f491fa31977a48f79a53eb40ccf57c21b3e6ae85648a0013be719c5d",
      "target_id": "ru-fr81-u141-r0074",
      "tag": "prose",
      "target_sha256": "9a8229b4968283fe1e8d8931879db41d0da1afaa1ee6e56a6027848f5e52ae2f"
    },
    {
      "source_id": "fr81-u141-r0075",
      "target": "Фошлеван вытер лоб.",
      "source_sha256": "4512f4650f6e915770eba06f5ff274c203ee775039ee418504588bf16dffcd5d",
      "target_id": "ru-fr81-u141-r0075",
      "tag": "prose",
      "target_sha256": "c28e54cdd88462d5db8c0522260f12b4c318d55798f412302e813fe906363086"
    },
    {
      "source_id": "fr81-u141-r0076",
      "target": "Настоятельница снова тихо прошептала что-то про себя, вероятно священное, затем повысила голос.",
      "source_sha256": "742bbaec98ba83acb64636726c5df7f7102dbb93e9135892c142f1f14924b448",
      "target_id": "ru-fr81-u141-r0076",
      "tag": "prose",
      "target_sha256": "dc23008afd716c2f4fa2e3a1c68504c99a31403838c4f8e9f3ee2868e0cb0505"
    },
    {
      "source_id": "fr81-u141-r0077",
      "target": "— При жизни мать Распятие обращала грешников; после смерти она будет творить чудеса.",
      "source_sha256": "033b9eebac90cc13f14074f2465e9cf4d3792b081d54218f0f709c6e0657d144",
      "target_id": "ru-fr81-u141-r0077",
      "tag": "prose",
      "target_sha256": "21f7b9a1479e055df7b73d01a7e229f72cf9cde8183b515c7a40bd7dc7e325e9"
    },
    {
      "source_id": "fr81-u141-r0078",
      "target": "— Будет творить! — отозвался Фошлеван, подхватив в тон и стараясь отныне больше не сбиваться.",
      "source_sha256": "5755056bde7624e4fe6fe66454e8204056ad72c3991a7caf4396114c5c2da1bb",
      "target_id": "ru-fr81-u141-r0078",
      "tag": "prose",
      "target_sha256": "bcdaa6d3423ff822b2617c919f96d0a463e8c9d9ff857b415a62452c32422511"
    },
    {
      "source_id": "fr81-u141-r0079",
      "target": "— Отец Фовен, обитель была благословена в лице матери Распятие. Конечно, не всякому дано умереть, как кардинал де Берюль, во время святой мессы, испустив душу к Богу на словах: [[I]]Hanc igitur oblationem[[/I]]. Но, не достигнув такого счастья, мать Распятие имела кончину многоценную. Она сохраняла сознание до последнего мгновения. Она говорила с нами, потом говорила с ангелами. Она дала нам свои последние наставления. Будь у вас чуть больше веры и окажись вы в её келье, она исцелила бы вашу ногу одним прикосновением. Она улыбалась. Чувствовалось, что она воскресает в Боге. В этой кончине было нечто от рая.",
      "source_sha256": "d00894dd9d30086bc312a81392c03e3f02908b99635e0c2685289c1657c42214",
      "target_id": "ru-fr81-u141-r0079",
      "tag": "prose",
      "target_sha256": "ac4602c045b1381db1896ac1c4689c2bb3fb292b955a22b51cc95e0bc02cfa3f"
    },
    {
      "source_id": "fr81-u141-r0080",
      "target": "Фошлеван решил, что это кончается молитва.",
      "source_sha256": "c76c31559976eedd456315e4ec055d3b657e94c4e5a61698c6511df063dc5f26",
      "target_id": "ru-fr81-u141-r0080",
      "tag": "prose",
      "target_sha256": "19685bd4c530eb57d266fef7243122e453c1923cb21391b388d389468cc2eb68"
    },
    {
      "source_id": "fr81-u141-r0081",
      "target": "— Аминь, — сказал он.",
      "source_sha256": "b4c1f008bd19449618bd5e46d75e28f68753f577ae89ce84629d47cbc6a52c0f",
      "target_id": "ru-fr81-u141-r0081",
      "tag": "prose",
      "target_sha256": "ca48e7308c812ae0ec18cc8f23ae2f190583586a996606cf86997b583128d5a1"
    },
    {
      "source_id": "fr81-u141-r0082",
      "target": "— Отец Фовен, надо делать то, чего хотят умершие.",
      "source_sha256": "94903df19747d1c0d30a91206bc3e4101b20e606e1f7a08a3e2e831982c5f860",
      "target_id": "ru-fr81-u141-r0082",
      "tag": "prose",
      "target_sha256": "d84c9891aa105279108e3dd2b908250bddae519237cf502da49ec528f45dfdab"
    },
    {
      "source_id": "fr81-u141-r0083",
      "target": "Настоятельница перебрала несколько зёрен чёток. Фошлеван молчал. Она продолжала:",
      "source_sha256": "70d0cbf19c3fc6d4c44f3759ffcc513a724d21d4f9c224cacd282fb7555953f2",
      "target_id": "ru-fr81-u141-r0083",
      "tag": "prose",
      "target_sha256": "7c23b320f1291e42fd657d54075a9ee85e3f387fbf6b9311048761c562bef056"
    },
    {
      "source_id": "fr81-u141-r0084",
      "target": "— Я советовалась по этому вопросу с несколькими духовными лицами, трудящимися о Господе нашем, которые заняты упражнением в жизни клирика и приносят удивительный плод.",
      "source_sha256": "02894d3a0e100aad2d419750217d3336c1a9e02d46b2c77fff827b46618fea44",
      "target_id": "ru-fr81-u141-r0084",
      "tag": "prose",
      "target_sha256": "e068b9c3023f10c0a026e71b8be9f67b470d0f1b262bd6161000b7ec2b5e08fc"
    },
    {
      "source_id": "fr81-u141-r0085",
      "target": "— Преподобная матушка, отсюда погребальный звон слышен куда лучше, чем из сада.",
      "source_sha256": "a9b0794093fb1b36fdf05b3824aeb1616e6df91803b9dec0166e1485cca218fe",
      "target_id": "ru-fr81-u141-r0085",
      "tag": "prose",
      "target_sha256": "f707a1cd8f65eeaedf4183048c3490182ae2d6779041ec3067ff5c0a00a97283"
    },
    {
      "source_id": "fr81-u141-r0086",
      "target": "— К тому же это больше чем покойница, это святая.",
      "source_sha256": "8a8bdb5b39a8c0a93b85ba547f915ac7bfe7dde619133a7f3b1cf5429bbcb96c",
      "target_id": "ru-fr81-u141-r0086",
      "tag": "prose",
      "target_sha256": "02701afc2dc88f67e5ed7ec7c30a8e75bcbe5c66118c2bbeacc2e100f24c95a7"
    },
    {
      "source_id": "fr81-u141-r0087",
      "target": "— Как и вы, преподобная матушка.",
      "source_sha256": "3404f6e9b81b4c40930d9c9335d4b332b0e91e82326b85b46f8ab2322d1d0410",
      "target_id": "ru-fr81-u141-r0087",
      "tag": "prose",
      "target_sha256": "3076b69ff6ce93e77bf22510cb824e77188c9f57b0f31c23190e5dff7b455734"
    },
    {
      "source_id": "fr81-u141-r0088",
      "target": "— Она спала в своём гробу уже двадцать лет, по особому дозволению нашего святого отца Пия Седьмого.",
      "source_sha256": "bd09f940b133de7ad31109dbc72eb45519c25b2dfe69b9a891c12d438696bb6f",
      "target_id": "ru-fr81-u141-r0088",
      "tag": "prose",
      "target_sha256": "f3d0ae72b558f76a3ba38558eaedfb137ba64eca2c4f4d0fbafc1171cae085fd"
    },
    {
      "source_id": "fr81-u141-r0089",
      "target": "— Того, что короновал импер… Буонапарта.",
      "source_sha256": "1c2b9d8c37881df8b02845da546eac93bd6229ede068f1496f6e886dea19d244",
      "target_id": "ru-fr81-u141-r0089",
      "tag": "prose",
      "target_sha256": "3f0e749129a77bbac139749877918fc1a481eb339d34d21a28fdb5fcff2a1bf1"
    },
    {
      "source_id": "fr81-u141-r0090",
      "target": "Для такого ловкого человека, как Фошлеван, это воспоминание было некстати. К счастью, настоятельница, всецело занятая своей мыслью, его не услышала. Она продолжала:",
      "source_sha256": "8490cc5cb9c15c2ea1f2f291e121e807aaa2164c6620d8fd72bfa3cd2929c0e9",
      "target_id": "ru-fr81-u141-r0090",
      "tag": "prose",
      "target_sha256": "abfa0cca9d6505b9bafe972127be4e656ac8c2ef4a4e3665151d366ef35bcc17"
    },
    {
      "source_id": "fr81-u141-r0091",
      "target": "— Отец Фовен?",
      "source_sha256": "ef876e3b0db43f30be3291a19499ad6f422f7a11ce87a01c58ec5cc66e65befc",
      "target_id": "ru-fr81-u141-r0091",
      "tag": "prose",
      "target_sha256": "6793aa33aaaae0b0b4ee95ddc144d70d688aa3d4aee3352d5b10bd4c5cb8b39d"
    },
    {
      "source_id": "fr81-u141-r0092",
      "target": "— Преподобная матушка?",
      "source_sha256": "4f8717cde34eb9fc4ae1dede759586e0113b4b82498701bc688428ecdb412e46",
      "target_id": "ru-fr81-u141-r0092",
      "tag": "prose",
      "target_sha256": "75e55653627a358694fe9f8acc257137984b1ca359b40b439dacfb6d7977e559"
    },
    {
      "source_id": "fr81-u141-r0093",
      "target": "— Святой Диодор, архиепископ Каппадокийский, пожелал, чтобы на его гробнице написали одно лишь слово: [[I]]Acarus[[/I]], что означает земляной червь; так и было сделано. Правда ли это?",
      "source_sha256": "0cba3dbda1577a38eb9a961605e5d1db2139b5d8c9a88f351dea696884a6d8e0",
      "target_id": "ru-fr81-u141-r0093",
      "tag": "prose",
      "target_sha256": "08d4c8b4a1bdeda0a779b7e7c54c33017545ce3b3e18c151898ed92f8fec89c3"
    },
    {
      "source_id": "fr81-u141-r0094",
      "target": "— Да, преподобная матушка.",
      "source_sha256": "93a8c97ab452f878a8ecae79d6f9682801ff41d0c4e401f5cdeefca57652c687",
      "target_id": "ru-fr81-u141-r0094",
      "tag": "prose",
      "target_sha256": "f93c8761ca2c23b372fe72197c1d574628308403df018e907c418c63798d6078"
    },
    {
      "source_id": "fr81-u141-r0095",
      "target": "— Блаженный Меццокане, аббат Аквилы, пожелал быть погребённым под виселицей; так и было сделано.",
      "source_sha256": "27def6ca9d6e86a81e9d67d5e4b5c982d7b432030db251328899ae2a390041ea",
      "target_id": "ru-fr81-u141-r0095",
      "tag": "prose",
      "target_sha256": "eff272126879887044d242ccb662ce80bf05bc8b249f0c06d2e59fdd4e46b5cc"
    }
  ],
