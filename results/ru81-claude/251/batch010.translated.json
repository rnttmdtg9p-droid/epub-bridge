{
  "unit": 251,
  "batch": 10,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u251-r0320",
      "target": "— А?",
      "source_sha256": "6f4905b437b6948a18583e0d14b52d7f2dd428bf5712d1870e5426b63921de17",
      "target_id": "ru-fr81-u251-r0320",
      "tag": "prose",
      "target_sha256": "702f65e6471f4f65b06df563044e31cd888b7815a47c06635e592d62a7f45332"
    },
    {
      "source_id": "fr81-u251-r0321",
      "target": "— Это кого ж съели?",
      "source_sha256": "bdef5f3755ebb502d4961dfe86f144ace7d93c83cfc7df1bd54325bd02fc78a2",
      "target_id": "ru-fr81-u251-r0321",
      "tag": "prose",
      "target_sha256": "e2da9d52abad30f59aeb73f14970683cb72e9216f278a44614c2c522e2d797a6"
    },
    {
      "source_id": "fr81-u251-r0322",
      "target": "— Кота.",
      "source_sha256": "9addeb0d6540c1c164f3d019bd41ab57534b02fe107ac1045022c72dcd1d0b52",
      "target_id": "ru-fr81-u251-r0322",
      "tag": "prose",
      "target_sha256": "4a0ca1e5a955f9796e132db0364f7358b664bf846228dae90fcd8061b0562551"
    },
    {
      "source_id": "fr81-u251-r0323",
      "target": "— А кто ж это кота съел?",
      "source_sha256": "e6ca179602274192c4796073d99a8724e069a05f38797ac7b17f8fcc92e6f4bd",
      "target_id": "ru-fr81-u251-r0323",
      "tag": "prose",
      "target_sha256": "b1706758695a2a14e86b462c858a02e68eb056809ae9e28a92dc45e5139c52f7"
    },
    {
      "source_id": "fr81-u251-r0324",
      "target": "— Крысы.",
      "source_sha256": "94ca004fa06ea4bf4546edc3c5705c94ee484741162d62335414bd3be421103a",
      "target_id": "ru-fr81-u251-r0324",
      "tag": "prose",
      "target_sha256": "e508792a0f0e241b368bcf5e590ba39cb279c7c1076ee61f84475f34840e5a55"
    },
    {
      "source_id": "fr81-u251-r0325",
      "target": "— Мыши?",
      "source_sha256": "a8b8dbeb42bbc8afb41151e27a29f8fe04690323593ec76b1fd00c42423dbfb1",
      "target_id": "ru-fr81-u251-r0325",
      "tag": "prose",
      "target_sha256": "ebb844ba9f175f7420abcbb34f53d69b7623ff5d920e30d0c9e02caf7c9e2cc8"
    },
    {
      "source_id": "fr81-u251-r0326",
      "target": "— Да нет, крысы.",
      "source_sha256": "db60dcc8cde257d419b3bbd730def8a2127d9109d9e1077b8e205be17e650f06",
      "target_id": "ru-fr81-u251-r0326",
      "tag": "prose",
      "target_sha256": "1aa367bbbdc47050feeb25978667159ed4d65d42a6be9342321101233142ed70"
    },
    {
      "source_id": "fr81-u251-r0327",
      "target": "Мальчуган, потрясённый этими мышами, которые едят кошек, продолжал:",
      "source_sha256": "b8aeb01c22c89f6ea4540085537e0ee8767f9bdb175c7e851108fb634a0b78ae",
      "target_id": "ru-fr81-u251-r0327",
      "tag": "prose",
      "target_sha256": "973e1da446a8e0f45a0b2de8cad330a77b0027083783361d7565c6a104f083f9"
    },
    {
      "source_id": "fr81-u251-r0328",
      "target": "— Господин, а они нас съедят, эти мыши?",
      "source_sha256": "7fa5f8979307cf07741010ba7cb4948246d0e46177fe3a4d9489069141bce18d",
      "target_id": "ru-fr81-u251-r0328",
      "tag": "prose",
      "target_sha256": "c29cb54d74463cde1cb3e6b02b2a2a4f2f0e7a4673375477ae88499bccac89f5"
    },
    {
      "source_id": "fr81-u251-r0329",
      "target": "— Ещё бы! — сказал Гаврош.",
      "source_sha256": "26f5cd49e6893aa5608e63973a39f68934fcb5b595766360857870371a5977d5",
      "target_id": "ru-fr81-u251-r0329",
      "tag": "prose",
      "target_sha256": "b811d7c2bf75a84add038ae710faba076be55025aabd5e3aeb79a6ef33386adb"
    },
    {
      "source_id": "fr81-u251-r0330",
      "target": "Ужас ребёнка дошёл до предела. Но Гаврош добавил:",
      "source_sha256": "a7afe1b997f97bcd088a15328945b81c6db3cae29c3c0a742a6e0997b366252a",
      "target_id": "ru-fr81-u251-r0330",
      "tag": "prose",
      "target_sha256": "42ac8642db66164c4a1bfe602471492f9ccffd632aff9f64e1e279724ca4f87c"
    },
    {
      "source_id": "fr81-u251-r0331",
      "target": "— Не бойсь! Они сюда не влезут. А потом, я ведь тут! На, держи мою руку. Заткнись и дрыхни!",
      "source_sha256": "d26d68a048a3a7509a6fa5ef2e4785712c39da73d4c9bf46b239062357379595",
      "target_id": "ru-fr81-u251-r0331",
      "tag": "prose",
      "target_sha256": "29573e20d4ab7cfc708c32426a51852bf5f19b14ef0352ce86f75719e2b401d7"
    },
    {
      "source_id": "fr81-u251-r0332",
      "target": "Гаврош в то же время взял руку малыша поверх его брата. Ребёнок прижал эту руку к себе и почувствовал себя спокойнее. У мужества и силы бывают такие таинственные способы передаваться. Вокруг них опять стало тихо; шум голосов испугал и прогнал крыс; прошло несколько минут, и сколько бы они теперь ни возвращались и ни свирепствовали, трое мальчишек, погружённые в сон, уже ничего не слышали.",
      "source_sha256": "717c84f4a4046ab8c2bd94672f666d7d3a3f76f6969b79f9e42dca46558a92d3",
      "target_id": "ru-fr81-u251-r0332",
      "tag": "prose",
      "target_sha256": "34023a82d8de05d2822b4a9c2afe56f9a5d2548291cf338cc7bd7c01be21f58d"
    },
    {
      "source_id": "fr81-u251-r0333",
      "target": "Ночные часы текли один за другим. Мрак покрывал огромную Бастильскую площадь, зимний ветер, смешанный с дождём, налетал порывами, патрули обшаривали двери, проходы, ограды, тёмные углы и, высматривая ночных бродяг, молча проходили мимо слона; чудовище, стоя неподвижно, с открытыми в темноте глазами, словно грезило, довольное своим добрым делом, и укрывало от неба и от людей трёх бедных спящих детей.",
      "source_sha256": "14551bc569601f418b3fe38e12718a1d8fcbf8bb80fa9ff34a5ba5a7bd769aff",
      "target_id": "ru-fr81-u251-r0333",
      "tag": "prose",
      "target_sha256": "6146520faf540839e87845ca3fcfdb9af2281f0001666f4cb71ad2916dcea380"
    },
    {
      "source_id": "fr81-u251-r0334",
      "target": "Чтобы понять, что последует дальше, нужно помнить, что в ту пору караульное помещение Бастилии находилось на другом краю площади и что часовой не мог ни увидеть, ни услышать того, что происходило возле слона.",
      "source_sha256": "cadc8e403fe329c3892acfb80aa6e40d9f570fbc35b87bbc711e92f3c4a0d9e0",
      "target_id": "ru-fr81-u251-r0334",
      "tag": "prose",
      "target_sha256": "b14bf4d8b0a3c3ce33f03f7c5ca13096a25f215d449ed059249cdbcb08dff111"
    },
    {
      "source_id": "fr81-u251-r0335",
      "target": "К концу того часа, что непосредственно предшествует рассвету, какой-то человек выбежал из улицы Сент-Антуан, пересёк площадь, обогнул большую ограду Июльской колонны и проскользнул между палисадами прямо под брюхо слона. Если бы какой-нибудь свет озарил этого человека, то по тому, как основательно он промок, можно было бы догадаться, что он провёл ночь под дождём. Добравшись до слона, он издал странный крик, не принадлежащий ни одному человеческому языку и который мог бы воспроизвести только попугай. Он повторил дважды этот крик, о котором приводимое здесь написание даёт лишь самое слабое представление:",
      "source_sha256": "c6cd39ee68dc0bc495cdfd328140041c512c34a9e78507e0b49de7d0ac09124a",
      "target_id": "ru-fr81-u251-r0335",
      "tag": "prose",
      "target_sha256": "f286197a3fb3b9c6a2eee8458c6be048b8e83257a4ec436a9246f9b8c3ae3c92"
    },
    {
      "source_id": "fr81-u251-r0336",
      "target": "— Кирикикиу!",
      "source_sha256": "3933e422654863c92a15e3d8feba3058095da4c6cc671a17aae659ebdc5515e3",
      "target_id": "ru-fr81-u251-r0336",
      "tag": "prose",
      "target_sha256": "fb7b7ca056d580ed1f46d154b4d3a451da1832ab435e8649414fa7465e698222"
    },
    {
      "source_id": "fr81-u251-r0337",
      "target": "На второй крик из брюха слона ответил звонкий, весёлый, молодой голос:",
      "source_sha256": "2b0868183042667664fd7df7355e7e3315aa18680c5077036a8db4bd317ac2a3",
      "target_id": "ru-fr81-u251-r0337",
      "tag": "prose",
      "target_sha256": "9da059a5122c49d61cd58b5e5591a4a0bb9883dd3bcb83103aac35db86a762be"
    },
    {
      "source_id": "fr81-u251-r0338",
      "target": "— Есть.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u251-r0338",
      "tag": "prose",
      "target_sha256": "aa0045b76334dc59e30160d443ecd7b743719fae4e916f03ffbfd49f6932e9ca"
    },
    {
      "source_id": "fr81-u251-r0339",
      "target": "Почти тотчас же доска, закрывавшая отверстие, сдвинулась и пропустила мальчика, который спустился вдоль ноги слона и проворно спрыгнул рядом с человеком. Это был Гаврош. Человеком был Монпарнас.",
      "source_sha256": "44525c291582443994a87662448827bcc9518888a5b35ca9e6ba46ee6ff290ec",
      "target_id": "ru-fr81-u251-r0339",
      "tag": "prose",
      "target_sha256": "63b69d9485dd9236e0a1ba012edf34af827fe09d1f80ad6003974ae28e98c567"
    },
    {
      "source_id": "fr81-u251-r0340",
      "target": "Что до этого крика, [[I]]кирикикиу[[/I]], то именно его, без сомнения, ребёнок и имел в виду, когда говорил: [[I]]Спросишь господина Гавроша.[[/I]]",
      "source_sha256": "971ce31a680a6bed008f5154204c2cde429bd0fea2036ff5dc10fc300b968c8c",
      "target_id": "ru-fr81-u251-r0340",
      "tag": "prose",
      "target_sha256": "aa94ac7fe2df34e81601787f7b21708951161216204dc18d4dbd543aa574516a"
    },
    {
      "source_id": "fr81-u251-r0341",
      "target": "Услышав его, он вскочил спросонок, выполз из своей «спальни», слегка раздвинув решётку, которую затем тщательно закрыл, потом открыл люк и спустился.",
      "source_sha256": "f6fb47b0856f77399efa74a95454f2a137fbb2d96c17a7af60e6dbfa9935de75",
      "target_id": "ru-fr81-u251-r0341",
      "tag": "prose",
      "target_sha256": "48c3a96b5dfe988a1d356612ea88f1d2a3cf9b5ff21587083e5534887d083fe3"
    },
    {
      "source_id": "fr81-u251-r0342",
      "target": "Человек и мальчик молча узнали друг друга в темноте; Монпарнас ограничился тем, что сказал:",
      "source_sha256": "e33a9811312ee42549d88843f6556cc3e402f77c20a0b95c7e11a99d3f2d483e",
      "target_id": "ru-fr81-u251-r0342",
      "tag": "prose",
      "target_sha256": "09596b3d8aaef9ae71245211447b9c57354037b7bdee189194c7327f39dc64d9"
    },
    {
      "source_id": "fr81-u251-r0343",
      "target": "— Ты нам нужен. Пойдём, подсобишь нам.",
      "source_sha256": "fedf833b733ee25d8f438d510be2c4bc95812e0adec3b5bd95069093614d9873",
      "target_id": "ru-fr81-u251-r0343",
      "tag": "prose",
      "target_sha256": "857a38f8c4d3c9afb18dc248c47b5104230ffc2952bf9264e4c3cedf43c52e3b"
    },
    {
      "source_id": "fr81-u251-r0344",
      "target": "Мальчишка не потребовал никаких других объяснений.",
      "source_sha256": "ae9222aae96e3ac6d6332ddf0d71d670c7a2cdce256def30d9eeb69addf16c64",
      "target_id": "ru-fr81-u251-r0344",
      "tag": "prose",
      "target_sha256": "255100b551773a5921a0492cd8156a36f85feed761a84c3a5be2e3fe8c7a2d8f"
    },
    {
      "source_id": "fr81-u251-r0345",
      "target": "— Я тут, — сказал он.",
      "source_sha256": "9e68bf8437cbb0b2619866aa7139bc730e70f1b01cb3e9baaed03636d69891e6",
      "target_id": "ru-fr81-u251-r0345",
      "tag": "prose",
      "target_sha256": "abf9ef4d701cbb85a0f348d9955ab4aa5790f6aad33c5b4eeddb769e0ba64878"
    },
    {
      "source_id": "fr81-u251-r0346",
      "target": "И оба направились к улице Сент-Антуан, откуда явился Монпарнас, быстро извиваясь между длинной вереницей огородницких телег, которые в этот час спускаются к рынку.",
      "source_sha256": "3cc630850085b82f472a25a8f2b705bb0cf55d7dcf8c0b8352d88ac5fa77c601",
      "target_id": "ru-fr81-u251-r0346",
      "tag": "prose",
      "target_sha256": "008b6b2bdc903874aec398f27c8b922946c2c4fc989f040db64cd8d737bf2b13"
    },
    {
      "source_id": "fr81-u251-r0347",
      "target": "Огородники, скорчившись в своих повозках среди салата и овощей, полусонные, зарывшись до самых глаз в свои плащи из-за хлеставшего дождя, даже не смотрели на этих странных прохожих.",
      "source_sha256": "4e5a7fae4b8179fece3cac79a16ea8a9faee2c327fbd6678e6b7ef3d7410d2a9",
      "target_id": "ru-fr81-u251-r0347",
      "tag": "prose",
      "target_sha256": "c123f755a0b01afcc6945dfdd2984a5efa0fdea8d9d2100e23a6d79ee3989739"
    },
    {
      "source_id": "fr81-u251-r0348",
      "target": "Чёрный хлеб.",
      "source_sha256": "1683ad4c0f865813711a6c772bbf74cb066b1adc2644dfd978bdd6cf3bd4cd8f",
      "target_id": "ru-fr81-u251-r0348",
      "tag": "footnote",
      "target_sha256": "3b6c9bc9b64a11f03f469c5f741462e742b8540a2e7fec2b809a5ea385acd51b"
    },
    {
      "source_id": "fr81-u251-r0349",
      "target": "На эшафот.",
      "source_sha256": "77389b95995d3ba33fb0a2b4ea6510809965402d2eac5eaf10a7ae8f8482f55a",
      "target_id": "ru-fr81-u251-r0349",
      "tag": "footnote",
      "target_sha256": "716a320ee3499f0a577c54106d6e796ce33143af71beab7ffa29ad1defbbcbfa"
    },
    {
      "source_id": "fr81-u251-r0350",
      "target": "Шпики, полицейские.",
      "source_sha256": "db4da56bf724aa95828ef1e1943d9ecf03d88e091c5adada9dcabb3a59edcf26",
      "target_id": "ru-fr81-u251-r0350",
      "tag": "footnote",
      "target_sha256": "26f20a4aa452c7b7c9174bdc6d05a5ad6075f3b08e3bcffebc735ceb30beb45e"
    },
    {
      "source_id": "fr81-u251-r0351",
      "target": "Работать.",
      "source_sha256": "d92a92ec5be6b50f020393c9914baac137f0769a3b28dd5638d9f1e0a1bd00de",
      "target_id": "ru-fr81-u251-r0351",
      "tag": "footnote",
      "target_sha256": "beed5f9c5c13a035c28e2312500ac7a31a8d948d509f107d1f5557f71011ad6c"
    }
  ],
