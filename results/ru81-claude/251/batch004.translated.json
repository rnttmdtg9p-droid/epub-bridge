{
  "unit": 251,
  "batch": 4,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u251-r0128",
      "target": "Гаврош не отставал:",
      "source_sha256": "0fee05c3841d697f16a97d0fb1ff25c91696da9e8a1a9f0975eb135797eb49e3",
      "target_id": "ru-fr81-u251-r0128",
      "tag": "prose",
      "target_sha256": "58789fb21fbab221a580e1add428e2f9360832b8bc6bcf9f32a4fb1916013b2e"
    },
    {
      "source_id": "fr81-u251-r0129",
      "target": "— Так что же ты собираешься делать этой ночью?",
      "source_sha256": "3313878131fd66cf008d659f4b07a96411a858a6cc07a73ab3eb351e80931632",
      "target_id": "ru-fr81-u251-r0129",
      "tag": "prose",
      "target_sha256": "b2e918c1c6ae13f8b5a0e30a28744ab569ee1781fedadffc58e47ca1080736b7"
    },
    {
      "source_id": "fr81-u251-r0130",
      "target": "Монпарнас снова взял низкую, серьёзную ноту и сказал, глотая слоги:",
      "source_sha256": "d738644e7ce7f74ca49130ca6a2e8e144fd3538fc775ea0c9b3623e9121e2687",
      "target_id": "ru-fr81-u251-r0130",
      "tag": "prose",
      "target_sha256": "68b8c7bb954505f10077e3aaf383e0754902e0a62cfcb363c571ecd58843e4ff"
    },
    {
      "source_id": "fr81-u251-r0131",
      "target": "— Дела.",
      "source_sha256": "ae8e3e147e93435efbfaf28251f03bdba86a1fbfc2f5618939e69aeb730cd2f0",
      "target_id": "ru-fr81-u251-r0131",
      "tag": "prose",
      "target_sha256": "b2d0eb7dea42b807249f21d0ea5fba6611e85cc2e483a0e07a0fbaafe468d3b8"
    },
    {
      "source_id": "fr81-u251-r0132",
      "target": "И, круто меняя разговор, добавил:",
      "source_sha256": "f4256702f7c9d0d0847ad683c5c33b15a0976ba564c497a289e787598869c83d",
      "target_id": "ru-fr81-u251-r0132",
      "tag": "prose",
      "target_sha256": "d01f897e92447ff51bae45941792bd477d12f04f05af2300b50126b1e370c6cf"
    },
    {
      "source_id": "fr81-u251-r0133",
      "target": "— Кстати!",
      "source_sha256": "bbbb5f264acfdd495e13285721a0966e9d49455fe2cf3a3aee0461cbf24a00ee",
      "target_id": "ru-fr81-u251-r0133",
      "tag": "prose",
      "target_sha256": "2f2e01fe06e563f37e097abc1706891f652260bc1cfa85bf66781601c1157fdd"
    },
    {
      "source_id": "fr81-u251-r0134",
      "target": "— Что?",
      "source_sha256": "61a0fac8ae488c6bc653f1215cdda5ca31b778598be9273b7ab3b579855004d9",
      "target_id": "ru-fr81-u251-r0134",
      "tag": "prose",
      "target_sha256": "517f3ff122eb546ca36332ec960df6083fe4c7e2f428e22ee5ca0183ce22e859"
    },
    {
      "source_id": "fr81-u251-r0135",
      "target": "— Была тут на днях одна история. Представь себе. Встречаю я буржуа. Он дарит мне проповедь и свой кошелёк. Я кладу это в карман. Минуту спустя лезу в карман. А там уже ничего нет.",
      "source_sha256": "6eec845864578c2a6b781d82e0b2bed472886bb2d24ec94942aad036899ebe1d",
      "target_id": "ru-fr81-u251-r0135",
      "tag": "prose",
      "target_sha256": "7054850e8d1a40fd54e60d9ce6d65c015d5f2ae8c51d6ac185992aa11ac20b21"
    },
    {
      "source_id": "fr81-u251-r0136",
      "target": "— Кроме проповеди, — сказал Гаврош.",
      "source_sha256": "039da2da274cf2169fd23ef7d225065b5d0437b97f712f5098caa9d45edcb84e",
      "target_id": "ru-fr81-u251-r0136",
      "tag": "prose",
      "target_sha256": "5d475a1ba5a0653a4e55273a26dc70e463108e195cd36b6d26cfa46fa8c9d76c"
    },
    {
      "source_id": "fr81-u251-r0137",
      "target": "— А ты-то, — продолжал Монпарнас, — куда теперь направляешься?",
      "source_sha256": "4fcc2ce4f2323222517578df82233d3f71d21003475f0b3d3251b21ff32436e2",
      "target_id": "ru-fr81-u251-r0137",
      "tag": "prose",
      "target_sha256": "5cff80ff2fb25f6d94598dd9042b9cc1cdc520efa0db01db5d7adaf4c67c270c"
    },
    {
      "source_id": "fr81-u251-r0138",
      "target": "Гаврош показал на двух своих питомцев и сказал:",
      "source_sha256": "939e1875e42aa724eaee367b589273021d1aba960c1da98e054a6d317b23e844",
      "target_id": "ru-fr81-u251-r0138",
      "tag": "prose",
      "target_sha256": "cc39c354383f27f6e5e556b96080550cd20c6c6826a7ace6e16e2ca900f0277f"
    },
    {
      "source_id": "fr81-u251-r0139",
      "target": "— Иду укладывать спать этих ребят.",
      "source_sha256": "51f00b27f3e0b51cac7fd09c6c353ad824021d00d8c97a5c0e11e460f4f74ab3",
      "target_id": "ru-fr81-u251-r0139",
      "tag": "prose",
      "target_sha256": "696f9d11f654552eb54ccd9007b731fb39c8c51712641007b9eec841241cef27"
    },
    {
      "source_id": "fr81-u251-r0140",
      "target": "— Куда это укладывать?",
      "source_sha256": "b5a4ee51b3658f7cebaf729342838bc85ee9786d512d81d576047ea326e9931e",
      "target_id": "ru-fr81-u251-r0140",
      "tag": "prose",
      "target_sha256": "8e759af53c24ea61a1f30abc2e3ba952b9703427ce1867e079fa45de6a36cab1"
    },
    {
      "source_id": "fr81-u251-r0141",
      "target": "— Ко мне.",
      "source_sha256": "aba557381b890c205fde658246bfbe7f4a8459218c2cade6da85485e5be2458f",
      "target_id": "ru-fr81-u251-r0141",
      "tag": "prose",
      "target_sha256": "6e45cce26d1369e190776b38d517779e76930b089fd4cae32c0718e2984ca123"
    },
    {
      "source_id": "fr81-u251-r0142",
      "target": "— Это куда — ко мне?",
      "source_sha256": "4ff7881507be24699a7e80859c2f7972020e7993ba73471f63f8bb44a1e12e93",
      "target_id": "ru-fr81-u251-r0142",
      "tag": "prose",
      "target_sha256": "dc933a551340eff7e84a5d50362a5ceeb73f1b3d75d35a82f40a1b02cb4e9485"
    },
    {
      "source_id": "fr81-u251-r0143",
      "target": "— Ко мне.",
      "source_sha256": "aba557381b890c205fde658246bfbe7f4a8459218c2cade6da85485e5be2458f",
      "target_id": "ru-fr81-u251-r0143",
      "tag": "prose",
      "target_sha256": "6e45cce26d1369e190776b38d517779e76930b089fd4cae32c0718e2984ca123"
    },
    {
      "source_id": "fr81-u251-r0144",
      "target": "— Так ты, выходит, где-то живёшь?",
      "source_sha256": "b7a2b6ac06d6a07b7752f328ee81641a50116b52e98e113b697324a898969c6f",
      "target_id": "ru-fr81-u251-r0144",
      "tag": "prose",
      "target_sha256": "2a81eb633bded1cef55e7106ab085d7fa9deb7eeab4d13622340d88432d4ee7f"
    },
    {
      "source_id": "fr81-u251-r0145",
      "target": "— Да, живу.",
      "source_sha256": "a27e6c2eccac81f41f3b965e7c6b0c516be654abcdfccd39c834ed47fc887b22",
      "target_id": "ru-fr81-u251-r0145",
      "tag": "prose",
      "target_sha256": "72e37df7ed07be32b7379a345e65d98f7de7bd5a209c5bbe53b8f847915fbf70"
    },
    {
      "source_id": "fr81-u251-r0146",
      "target": "— И где же ты живёшь?",
      "source_sha256": "5ab35f58f5e079ff2f92f98d92a2c13459cd48f3830fada166f0aa9ec89f4bf5",
      "target_id": "ru-fr81-u251-r0146",
      "tag": "prose",
      "target_sha256": "6bce058c0781029ef0153d3349f666e24f9009c241663b5ebd2a00238b7bfaaf"
    },
    {
      "source_id": "fr81-u251-r0147",
      "target": "— В слоне, — сказал Гаврош.",
      "source_sha256": "64a5d205afd8968526a2194f8be6c3800afd44607d895015d4bbc5f2395456d2",
      "target_id": "ru-fr81-u251-r0147",
      "tag": "prose",
      "target_sha256": "078251fa635ed4beb0a5d48c79f771d6611586f30169ff44d033413f964f9f87"
    },
    {
      "source_id": "fr81-u251-r0148",
      "target": "Монпарнас, хотя по натуре его удивить было трудно, не удержался от восклицания:",
      "source_sha256": "116659cd240f8a3a16a8bab69d714193fb8e7beca2d3935abd94e6ddb1caf04c",
      "target_id": "ru-fr81-u251-r0148",
      "tag": "prose",
      "target_sha256": "d4fb7fcd82b96ef037581dfeb2d71ac7a15e6a81fe7fe0da6f2179f5328065dd"
    },
    {
      "source_id": "fr81-u251-r0149",
      "target": "— В слоне!",
      "source_sha256": "f15622ac2f1501f7a9a55497ee6cbb67565a6b8b5709eaef991b06caaaf8b6ff",
      "target_id": "ru-fr81-u251-r0149",
      "tag": "prose",
      "target_sha256": "be01cf45ade2d8d5cd4817bcde11221b6b2961c2cad091a0db74ad495dcd0f2e"
    },
    {
      "source_id": "fr81-u251-r0150",
      "target": "— Ну да, в слоне! — отозвался Гаврош. — Чегож тако?",
      "source_sha256": "10e79060e99af7e133e8e0fc725819f05488d7d80ea8bd4dd402e45a102dfb14",
      "target_id": "ru-fr81-u251-r0150",
      "tag": "prose",
      "target_sha256": "bfa08d894fe429a8d0d318720e512684a756e61f3475cdce6f0e16f1df8bb715"
    },
    {
      "source_id": "fr81-u251-r0151",
      "target": "Это опять слово из того языка, на котором никто не пишет и на котором все говорят. «Чегож тако» значит: что же в этом такого?",
      "source_sha256": "f0f8000906a2e83b694eed8a70fb4ff565d8e0e0ce3b6be97edf3324d6918987",
      "target_id": "ru-fr81-u251-r0151",
      "tag": "prose",
      "target_sha256": "bfa67f4e44ddb2464765a9396b22b219d637840311feef630961f92c974b9f63"
    },
    {
      "source_id": "fr81-u251-r0152",
      "target": "Глубокое замечание мальчишки вернуло Монпарнаса к спокойствию и здравому смыслу. Он, казалось, проникся лучшими чувствами к жилищу Гавроша.",
      "source_sha256": "8a90c719ca062200a25a0092d83ba2acfea608060f30e9748c9d2769a8cab7bd",
      "target_id": "ru-fr81-u251-r0152",
      "tag": "prose",
      "target_sha256": "e887d9322a3c6f4c6a6d33d2b6c28ce8c8b0ba1b5b8b840194a91fd2c9197bcc"
    },
    {
      "source_id": "fr81-u251-r0153",
      "target": "— В самом деле! — сказал он. — Да, слон. Там хорошо?",
      "source_sha256": "fba842de5017d110238616a402daa754209f942b25745378a251aea48bcbdbe5",
      "target_id": "ru-fr81-u251-r0153",
      "tag": "prose",
      "target_sha256": "4c7422ec37999ab3107496cf7fd0b21f956047bab4c788c627815aeb66e2cc91"
    },
    {
      "source_id": "fr81-u251-r0154",
      "target": "— Отлично, — ответил Гаврош. — Право, шикарно. Там нет таких сквозняков, как под мостами.",
      "source_sha256": "f1ba41bf8fc536e56b1d82eacfc7de01a9eb041b96b1ec6f4c823e3b4bae2f18",
      "target_id": "ru-fr81-u251-r0154",
      "tag": "prose",
      "target_sha256": "3205e61b95046739d8ea193828806a2b14ecfab5afd980a230426c349662f0d3"
    },
    {
      "source_id": "fr81-u251-r0155",
      "target": "— А как ты туда попадаешь?",
      "source_sha256": "51be2fee2f59f85bf1f1d1c08cf2e64ee38371ff9979cd1274b1ba8f79c1d3c5",
      "target_id": "ru-fr81-u251-r0155",
      "tag": "prose",
      "target_sha256": "5d49683a68f07fc364e87bf51a871ba04330e31639e19e48140c33f74a2fd0d0"
    },
    {
      "source_id": "fr81-u251-r0156",
      "target": "— Захожу.",
      "source_sha256": "bd70f3457f066209a408766b43042fe0ad5f7f3c29fd254f1496e923c72ccbe3",
      "target_id": "ru-fr81-u251-r0156",
      "tag": "prose",
      "target_sha256": "58f58b69ded77a072d118460d40f757aaca20bd513e9d0a76139d690c10263ae"
    },
    {
      "source_id": "fr81-u251-r0157",
      "target": "— Значит, там есть дыра? — спросил Монпарнас.",
      "source_sha256": "88ff5b21ef1468a9fb46d700f566f8c31916c286d686e75a77a1b91a4919b2e7",
      "target_id": "ru-fr81-u251-r0157",
      "tag": "prose",
      "target_sha256": "e4696f0deeebc54864a599c47cbfc1e6ffff7e158ee95d0cf4e9beeecc933a06"
    },
    {
      "source_id": "fr81-u251-r0158",
      "target": "— Ещё бы! Только об этом болтать не надо. Она между передними ногами. Легавые[[N3]] её не заметили.",
      "source_sha256": "7e8fc665fb7193729189e67748a24d24d9ce89104e05ed249e5a1070ab0787d3",
      "target_id": "ru-fr81-u251-r0158",
      "tag": "prose",
      "target_sha256": "25a8236189c9217cc68120810a5c779a6833477e73a4695bcbcc9bf03179bfe3"
    },
    {
      "source_id": "fr81-u251-r0159",
      "target": "— И ты карабкаешься? Да, понимаю.",
      "source_sha256": "f34f51bf114baf634b34ae0c0121181de17ac0cb2d18f802fbd9bb5f5cd00d65",
      "target_id": "ru-fr81-u251-r0159",
      "tag": "prose",
      "target_sha256": "605cfd59821b7b436e3b5a8c0b2821e74a24f3f691ac210927d69f83de5bfd3a"
    }
  ],
