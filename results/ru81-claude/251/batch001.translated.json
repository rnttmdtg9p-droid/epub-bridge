{
  "unit": 251,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u251-r0032",
      "target": "— На тебя! — ответил прохожий.",
      "source_sha256": "09a674f28d04cdb020eac3c5639bd4b003f278859036dfaebfedfc7e587edef1",
      "target_id": "ru-fr81-u251-r0032",
      "tag": "prose",
      "target_sha256": "33b63bb9f2e7a1adbaaa65071849a8f6ff1724dc743cd95e81008ab554cddbdc"
    },
    {
      "source_id": "fr81-u251-r0033",
      "target": "— Контора закрыта, — сказал Гаврош, — жалоб я больше не принимаю.",
      "source_sha256": "089f1cdd4bafab60ec759d9b5da7e4fe8f18bb31ea871d45aea1b14627d59ba7",
      "target_id": "ru-fr81-u251-r0033",
      "tag": "prose",
      "target_sha256": "f26be45d16e814fa5a9f1d65fc347aa5da9f83fcbcc70be3650fab2f0cac05de"
    },
    {
      "source_id": "fr81-u251-r0034",
      "target": "Между тем, продолжая подниматься по улице, он заметил под воротами дома нищенку лет тринадцати или четырнадцати, совсем окоченевшую, в такой короткой юбчонке, что видны были колени. Девочка уже становилась слишком взрослой для такого наряда. Рост играет с нами такие шутки: юбка делается короткой как раз тогда, когда нагота становится непристойной.",
      "source_sha256": "b0d8acb182871d15f86af83ca43668e9872cda1d2902f91a1ab62ae155cde5b3",
      "target_id": "ru-fr81-u251-r0034",
      "tag": "prose",
      "target_sha256": "7e94a1f9937590fe0d1152ffb5a547a11e36063c54678cb27780b09cb73187c3"
    },
    {
      "source_id": "fr81-u251-r0035",
      "target": "— Бедная девчонка! — сказал Гаврош. — У неё даже штанов нет. На-ка, возьми хоть это.",
      "source_sha256": "893e1730a9cafc871f1c02d365346d34923679de5b34ed8b5b590c72f719c6cf",
      "target_id": "ru-fr81-u251-r0035",
      "tag": "prose",
      "target_sha256": "4743afa4b860d9c603e79d04dcc13007a3910df9bd8b5e68dd32a3b4c5d3160f"
    },
    {
      "source_id": "fr81-u251-r0036",
      "target": "И, размотав всю эту добрую шерсть, которая была у него на шее, он набросил её на худые лиловые плечи нищенки, где шарф снова стал шалью.",
      "source_sha256": "8ea0cb4d2ae065a12d8c36523d5db944e0c7d0cba6db874e9ff03358fff6f027",
      "target_id": "ru-fr81-u251-r0036",
      "tag": "prose",
      "target_sha256": "3ef04c9c5a7578ae766993125eed4a275c731f5903269cdc349e98a8717fcb7e"
    },
    {
      "source_id": "fr81-u251-r0037",
      "target": "Девочка поглядела на него с удивлением и молча приняла шаль. Когда нужда доходит до известной степени, бедняк в своём оцепенении уже не жалуется на зло и не благодарит за добро.",
      "source_sha256": "4f6a5cd77f0f078d357e712a7733c023f36a238a4a60537b9e510ac640f93fe3",
      "target_id": "ru-fr81-u251-r0037",
      "tag": "prose",
      "target_sha256": "5e2abf95d77d2042dda911508cf79bd8523912dedb66ea97a780e123c7946298"
    },
    {
      "source_id": "fr81-u251-r0038",
      "target": "В итоге вышло вот что:",
      "source_sha256": "563dfef024aa4e4359ed65c7783cb94112ef7699a2130939258d2e7d8f97fa85",
      "target_id": "ru-fr81-u251-r0038",
      "tag": "prose",
      "target_sha256": "4dc2037ed179f77ab8d59b3d41e77fad19e6e3c10b3adfb4ef7013bc6986cccd"
    },
    {
      "source_id": "fr81-u251-r0039",
      "target": "— Брр! — сказал Гаврош, дрожа сильнее святого Мартина, который, по крайности, сохранил себе половину плаща.",
      "source_sha256": "e24f6990ad5bbeff08dae3af8955dd4a5ffe109efdde8cfc434870d1a234de64",
      "target_id": "ru-fr81-u251-r0039",
      "tag": "prose",
      "target_sha256": "5e438658bff651db03c931adc3e4e7546a209b0da04a4116f03cbf8aa586891c"
    },
    {
      "source_id": "fr81-u251-r0040",
      "target": "При этом «брр!» ливень, удвоив свою злобу, разбушевался вовсю. Такие дурные небеса наказывают за добрые дела.",
      "source_sha256": "7e950bf5b9ec2f753c8ad5dbc25e96ed80ed47c90f8f7ddd63c2fbebe8797020",
      "target_id": "ru-fr81-u251-r0040",
      "tag": "prose",
      "target_sha256": "b09d140bafbedd9e4bee02138d84053d744f662079dfcda916c917b98b8457e8"
    },
    {
      "source_id": "fr81-u251-r0041",
      "target": "— Это ещё что такое? — воскликнул Гаврош. — Что это значит? Опять льёт! Боже милостивый, если так пойдёт дальше, я отказываюсь от подписки. — И он снова двинулся в путь.",
      "source_sha256": "784a8734c49e6f718491b9563a76d9af0f15384e26105d202a779a86b5f721c9",
      "target_id": "ru-fr81-u251-r0041",
      "tag": "prose",
      "target_sha256": "9d2861d42a52f860f22421378134037ef5a67539458b39b831481fc963658866"
    },
    {
      "source_id": "fr81-u251-r0042",
      "target": "— Всё равно, — продолжал он, бросив взгляд на нищенку, которая сжималась в комок под шалью, — вот у этой теперь знатная одёжка.",
      "source_sha256": "9210e48573758c6087362cc58c9b56e71caa4c3e36b97b52822e848013ef8278",
      "target_id": "ru-fr81-u251-r0042",
      "tag": "prose",
      "target_sha256": "058f51bbe426d43803190c70e9aef52bb15579379e2757e550eca0876d2970ba"
    },
    {
      "source_id": "fr81-u251-r0043",
      "target": "И, глядя на тучу, он крикнул:",
      "source_sha256": "c58b1e7a24d8559f2df4d6e7df114deb1dfb7292e3c3493a7eccff6b2bee84f7",
      "target_id": "ru-fr81-u251-r0043",
      "tag": "prose",
      "target_sha256": "1a3c6968eb42a14ddb8bd2148465a0465fec6872f3cec377935ca5e953ae25a6"
    },
    {
      "source_id": "fr81-u251-r0044",
      "target": "— Выкусила!",
      "source_sha256": "6e53986d826365c2fe368a29fc9f3f10ba9f07d67ad1dec0f69740de82e94af5",
      "target_id": "ru-fr81-u251-r0044",
      "tag": "prose",
      "target_sha256": "238d5ef617e5ad58bbd8d1f5e54f613a48885b6b8a2a64de519ca148fab271e7"
    },
    {
      "source_id": "fr81-u251-r0045",
      "target": "Двое ребятишек шли за ним по пятам.",
      "source_sha256": "de02595af7ae5595e64ba31dcda889ba6a4d5b566ac52233c4fd2e6fa082c527",
      "target_id": "ru-fr81-u251-r0045",
      "tag": "prose",
      "target_sha256": "adf25b963088a72d49554998aa325ed6278a538214a11851b729a8cbd93e69e8"
    },
    {
      "source_id": "fr81-u251-r0046",
      "target": "Когда они проходили мимо одной из тех толстых решёток, которые указывают на лавку булочника, — ведь хлеб, как и золото, держат за железными решётками, — Гаврош обернулся:",
      "source_sha256": "f5276e8fafef10a9013919e286dad90567fd969f45322b58ab6bca31211718d4",
      "target_id": "ru-fr81-u251-r0046",
      "tag": "prose",
      "target_sha256": "2cb3e3536a85ac84b11692d3e0304502ea8eb67b6a070f3002c5cba3ce51a14c"
    },
    {
      "source_id": "fr81-u251-r0047",
      "target": "— Эй, мелюзга, а мы обедали?",
      "source_sha256": "a6b1948abbcec0891a829dac84b762810f0bc311a606b6701a2986b05ac509a6",
      "target_id": "ru-fr81-u251-r0047",
      "tag": "prose",
      "target_sha256": "333e7d0f1acd3d816c3345934afbe60b6e059254135b4eb984e40b1cb2c012b4"
    },
    {
      "source_id": "fr81-u251-r0048",
      "target": "— Сударь, — ответил старший, — мы ничего не ели с самого утра, почитай.",
      "source_sha256": "4b9b9618e727f1273a2988bf090773f239adf6f16b577908b57b9cd1f9cb9dfd",
      "target_id": "ru-fr81-u251-r0048",
      "tag": "prose",
      "target_sha256": "0b85140e24fcf219782d649a4c95eea3e6dcf94ad59eb6fe7377abdebf50e601"
    },
    {
      "source_id": "fr81-u251-r0049",
      "target": "— Так вы, стало быть, без отца и матери? — величественно продолжал Гаврош.",
      "source_sha256": "6e48e7573fdb4741017c186e4f07791324242cb47c7005acbee81caa07851700",
      "target_id": "ru-fr81-u251-r0049",
      "tag": "prose",
      "target_sha256": "458278cf214a73269ac715dca13d69bda4489cfb85c5d9be8efbb0234a030bce"
    },
    {
      "source_id": "fr81-u251-r0050",
      "target": "— Прощенья просим, сударь, папа с мамой у нас есть, только мы не знаем, где они.",
      "source_sha256": "10a54367af2b955828794fa3a5882d18db81767e9a6b46bd54c06f6ee537d174",
      "target_id": "ru-fr81-u251-r0050",
      "tag": "prose",
      "target_sha256": "ec2aa63346deacffab08366da938e7f7a83fce7b98d43b3afd63457d1cc87bc1"
    },
    {
      "source_id": "fr81-u251-r0051",
      "target": "— Иной раз это лучше, чем знать, — сказал Гаврош, который был мыслителем.",
      "source_sha256": "f9965f2d59c013b92e4013339b364580e832b90fe22f0458421720b6702328f3",
      "target_id": "ru-fr81-u251-r0051",
      "tag": "prose",
      "target_sha256": "297899dd2315b2d7367be2c56b1614b542027ba6196842c9c7662111cd52838e"
    },
    {
      "source_id": "fr81-u251-r0052",
      "target": "— Вот, — продолжал старший, — уже два часа мы ходим, искали чего-нибудь на углах, у тумб, да ничего не находим.",
      "source_sha256": "388931abe3b3847411885ed0da32e17da82966fbc812e654645669bddf7a41dd",
      "target_id": "ru-fr81-u251-r0052",
      "tag": "prose",
      "target_sha256": "7c89e9ff2b4f6564f6745e27b77aae1182520dd80e39edebcd763eef7fc758a3"
    },
    {
      "source_id": "fr81-u251-r0053",
      "target": "— Знаю, — сказал Гаврош. — Это собаки всё съедают.",
      "source_sha256": "28c06278f178bdc677be613e7a482ce02d42677858b91e13edb019bc969f6214",
      "target_id": "ru-fr81-u251-r0053",
      "tag": "prose",
      "target_sha256": "2555521f935bdba32cc0b0afdf859f89a6c19fc2351288caa48c680dc77fdd29"
    },
    {
      "source_id": "fr81-u251-r0054",
      "target": "После молчания он продолжал:",
      "source_sha256": "8f10f9856f305aa5f44ec4cae7903ec451805ddf5ce189a0bfc7aa72a4dd89ea",
      "target_id": "ru-fr81-u251-r0054",
      "tag": "prose",
      "target_sha256": "79c2d1071dc44eaf691224f97d8228c5be4446b78f44dd1a75b253248e725c24"
    },
    {
      "source_id": "fr81-u251-r0055",
      "target": "— Ах, мы потеряли своих авторов! Сами не знаем, куда их девали. Так не годится, ребята. Глупо терять таких людей в годах. Ну да ладно! А пожрать-то всё равно надо.",
      "source_sha256": "2db81b9dd2a8d8ffdd00c7c7c9787a27cb8820fa9b8bd2978b72df0f69ed3f43",
      "target_id": "ru-fr81-u251-r0055",
      "tag": "prose",
      "target_sha256": "c8076975b9b51a9eb6ec5bb45149f1f39131c40b5e328a56ca8b743f4ab0410c"
    },
    {
      "source_id": "fr81-u251-r0056",
      "target": "Впрочем, он не стал их ни о чём расспрашивать. Быть без крова — что может быть проще?",
      "source_sha256": "090247c2e21b54314c5eed2ed6f9e15130082394111e46e64dde07e4b221acfb",
      "target_id": "ru-fr81-u251-r0056",
      "tag": "prose",
      "target_sha256": "259320c53bb47546963c76fd68b35046ea3b92b133bcf04d54d2bd3dd7e144f3"
    },
    {
      "source_id": "fr81-u251-r0057",
      "target": "Старший из двух малышей, почти совсем вернувшийся к быстрой беззаботности детства, воскликнул:",
      "source_sha256": "c1f27d1863c5a1751fdd0a27ee1ebb5c491ce4f2c47f148646d3a2c02974d59a",
      "target_id": "ru-fr81-u251-r0057",
      "tag": "prose",
      "target_sha256": "559270728dd130fdaccf444345cda1e8b00aae4c743bef017de1bf094f43de21"
    },
    {
      "source_id": "fr81-u251-r0058",
      "target": "— А всё-таки чудно. Мама ведь говорила, что поведёт нас за освящённым самшитом в Вербное воскресенье.",
      "source_sha256": "e17885d123f8694ef163f7a946b24292cb8156a3fa470408b5cc4f5d3d9c7424",
      "target_id": "ru-fr81-u251-r0058",
      "tag": "prose",
      "target_sha256": "badbb908faf340c84d32c470fdd1b1d1b39da4acceaf2539c52aa12a4249d3f3"
    },
    {
      "source_id": "fr81-u251-r0059",
      "target": "— Как же, как же, — ответил Гаврош.",
      "source_sha256": "4d3edc61989d7e973b12935c3659996cc96eb7e35602e4095094551d9cfeaf4f",
      "target_id": "ru-fr81-u251-r0059",
      "tag": "prose",
      "target_sha256": "737663b3bf19c1467bce24b081959a8bc2d8bda835d823dfc8c4eaf945e985cd"
    },
    {
      "source_id": "fr81-u251-r0060",
      "target": "— Мама, — продолжал старший, — это дама, которая живёт с мамзель Мисс.",
      "source_sha256": "877c6d3ee5d208e95cf7367b926e76e6afda2192a18a9fe27e5f1dcdf777fef0",
      "target_id": "ru-fr81-u251-r0060",
      "tag": "prose",
      "target_sha256": "06328fbd2fc85d28ae7869aa614ef01f46d56505e708b5a12fa5111d8c038655"
    },
    {
      "source_id": "fr81-u251-r0061",
      "target": "— Ну-ну, свистульки, — отозвался Гаврош.",
      "source_sha256": "af9056b54108d0c7bb7a79825bda93ab9039ccef02fdac01decc70cdefb82f6c",
      "target_id": "ru-fr81-u251-r0061",
      "tag": "prose",
      "target_sha256": "9ee2dbdc4fba88b5a5613143cf7dc93c46fb1395171fb800a953cc0df1a9dc1e"
    },
    {
      "source_id": "fr81-u251-r0062",
      "target": "Между тем он остановился и уже несколько минут ощупывал и обшаривал всевозможные закоулки в своих лохмотьях.",
      "source_sha256": "8ef41221da6062cc2738a9b1c9fe85beb66114abb2e20837606d573712282d8d",
      "target_id": "ru-fr81-u251-r0062",
      "tag": "prose",
      "target_sha256": "e147ff397a59af83236bace604924cb8cf3303b412c624ee90c42c5d9bbff5f9"
    },
    {
      "source_id": "fr81-u251-r0063",
      "target": "Наконец он поднял голову с видом, который хотел быть всего лишь довольным, но на деле был торжествующим.",
      "source_sha256": "bcce52066db389c820a906c47428f3948db1f2f012532e51ead7f637e1065fb8",
      "target_id": "ru-fr81-u251-r0063",
      "tag": "prose",
      "target_sha256": "fbcc9694b44c47ea5659dced4a7416f40eb2e6e957930362446d06823011c788"
    }
  ],
