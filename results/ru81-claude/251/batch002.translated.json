{
  "unit": 251,
  "batch": 2,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u251-r0064",
      "target": "— Успокойтесь, ребятня. Вот на что поужинать втроём.",
      "source_sha256": "aa4ffd4abea320f746da345f3ad673842c5e3c89c7dc7900c3d091703e1c3f82",
      "target_id": "ru-fr81-u251-r0064",
      "tag": "prose",
      "target_sha256": "8e0e00b08512fb2cda8f96561c94310b717315620d715b035ed6cd2f06138320"
    },
    {
      "source_id": "fr81-u251-r0065",
      "target": "И он вытащил из одного кармана су.",
      "source_sha256": "ff3df8947193f18b888fe50db7a0dbd7962c40c5b7192525342c35a3b4317055",
      "target_id": "ru-fr81-u251-r0065",
      "tag": "prose",
      "target_sha256": "ff5364b81f5c145015ba0ad610e0a377f89216a74e403ac383aae769e060f4d5"
    },
    {
      "source_id": "fr81-u251-r0066",
      "target": "Не дав малышам времени опомниться от изумления, он втолкнул обоих перед собой в булочную и, положив су на прилавок, крикнул:",
      "source_sha256": "47caf13e0349195b65a50a409a0e7604d71041085bbc7ea379575ac8df250715",
      "target_id": "ru-fr81-u251-r0066",
      "tag": "prose",
      "target_sha256": "cdbfb97da7f9061dacdf875a3da21d075dadd14886a14e1f3a6fc913b32e41a1"
    },
    {
      "source_id": "fr81-u251-r0067",
      "target": "— Малый! На пять сантимов хлеба.",
      "source_sha256": "4a2b46433725c22f34c41bd55046d47d48accf173818a69af290300520e3dbaf",
      "target_id": "ru-fr81-u251-r0067",
      "tag": "prose",
      "target_sha256": "3897f205f2a29a70872566ffc0b305e3f0576f655b1904cb9bea12badd9dbb9b"
    },
    {
      "source_id": "fr81-u251-r0068",
      "target": "Булочник, бывший самим хозяином, взял хлеб и нож.",
      "source_sha256": "130a5617f126032b051a3a747d163d443e1aed89c6aeb3717bd4d645b48987f7",
      "target_id": "ru-fr81-u251-r0068",
      "tag": "prose",
      "target_sha256": "fe496d73bee1f5148cbe089cd71d5ed294cbbadb94d18bc3cfaf57217293d3ca"
    },
    {
      "source_id": "fr81-u251-r0069",
      "target": "— На три куска, малый! — повторил Гаврош и с достоинством добавил:",
      "source_sha256": "9ec455b1fc566dad914342659ec8f3352a61ae48ecf99145e2b4911ca2e99ef0",
      "target_id": "ru-fr81-u251-r0069",
      "tag": "prose",
      "target_sha256": "500a860c619ec4e0a3d6101e38a82c5d658309c8fd18009483a0d0ba3894038e"
    },
    {
      "source_id": "fr81-u251-r0070",
      "target": "— Нас трое.",
      "source_sha256": "e3bc271ccd0fd20c8158294192ac90874fb05ad23d056221cd4db827f9af1e24",
      "target_id": "ru-fr81-u251-r0070",
      "tag": "prose",
      "target_sha256": "a0065dfccea9781301fd89713a75f8e602497f74f56ea94035fd9979012df44d"
    },
    {
      "source_id": "fr81-u251-r0071",
      "target": "И, видя, что булочник, оглядев троих ужинающих, взял чёрный хлеб, он глубоко засунул палец в нос и втянул воздух так властно, словно на кончике большого пальца у него была понюшка табаку великого Фридриха, и бросил булочнику прямо в лицо это негодующее восклицание:",
      "source_sha256": "27172d77ea7110567d8c51bc40fd4de43ba65923b13b3fca73fc9eef5ada8793",
      "target_id": "ru-fr81-u251-r0071",
      "tag": "prose",
      "target_sha256": "1a62ad2c747aaaa91bfd2b71607413bebba0a30291cd5463fc3cfbbf3d3486f8"
    },
    {
      "source_id": "fr81-u251-r0072",
      "target": "— Кекскса?",
      "source_sha256": "3f70eb59562c5a42a9ade4c2b917b129ad09fce815d074d67e23fe5643a0235b",
      "target_id": "ru-fr81-u251-r0072",
      "tag": "prose",
      "target_sha256": "335a192637cd04c92e8a8d39a31ab9abf25925a9815a255535376e4a6cbe3c3b"
    },
    {
      "source_id": "fr81-u251-r0073",
      "target": "Те из наших читателей, кого соблазнило бы увидеть в этом обращении Гавроша к булочнику русское или польское слово или один из тех диких криков, которыми йоуэи и ботокуды перекликаются с одного берега реки на другой сквозь безлюдные пространства, предупреждены: это слово, которое они (то есть наши читатели) произносят каждый день и которое заменяет фразу: «что это такое?» Булочник прекрасно понял и ответил:",
      "source_sha256": "5d3dc4c9df5966331c8d1f6bec65c374d863dfb2e140f5bbc964c34ec2cce402",
      "target_id": "ru-fr81-u251-r0073",
      "tag": "prose",
      "target_sha256": "2452fcdc60dc0c07f362b273a92b7fb5a8578f7358c8b0367ea1762b97d92cba"
    },
    {
      "source_id": "fr81-u251-r0074",
      "target": "— Да ведь это хлеб, очень хороший хлеб второго сорта.",
      "source_sha256": "6a8d3d580d5584789302ee590013008c26c0ed32fe166fef686bfb4b0c5caaad",
      "target_id": "ru-fr81-u251-r0074",
      "tag": "prose",
      "target_sha256": "102bbd73f4cdb1cf21e3767410056d86be1ccac59f9255921e05c1ecd3869399"
    },
    {
      "source_id": "fr81-u251-r0075",
      "target": "— Вы хотите сказать — грубый хлебец[[N1]], — возразил Гаврош, спокойно и холодно-презрительно. — Белого хлеба, малый! Мыленого хлебца! Я угощаю.",
      "source_sha256": "e89dfaad73a121e05c74bbaf7e457c346781cb98f00691a2a18b266b7f4112f7",
      "target_id": "ru-fr81-u251-r0075",
      "tag": "prose",
      "target_sha256": "6f2378680b49467b0ce1d31ff0020b99b4e16da90406fb684a5a2e99e4a365d6"
    },
    {
      "source_id": "fr81-u251-r0076",
      "target": "Булочник не удержался от улыбки и, нарезая белый хлеб, смотрел на них с сочувствием, которое задело Гавроша.",
      "source_sha256": "b7a091c223f85acc53a7ef0a9b028447f4751a29bb5a43cd19a3a6070b821eaa",
      "target_id": "ru-fr81-u251-r0076",
      "tag": "prose",
      "target_sha256": "05d45ecb049a9a2094c63c42bb3df1a1195f63357499f2e3dc6d8c407bd6e62b"
    },
    {
      "source_id": "fr81-u251-r0077",
      "target": "— Эй, пекарёнок! — сказал он. — Чего это вы нас так вымеряете взглядом?",
      "source_sha256": "3c3bd23c0d64ad420fde32f4f5d2376c7665566d415bea3483426273ba2d5c6d",
      "target_id": "ru-fr81-u251-r0077",
      "tag": "prose",
      "target_sha256": "537857cad17551b83cc6ce1c74e86d3690aee4e8dad95c5f524474bc93fec4f0"
    },
    {
      "source_id": "fr81-u251-r0078",
      "target": "Если бы приставить всех троих друг к другу, едва ли набралась бы сажень.",
      "source_sha256": "e3d50ae261c490914c5533482fe6d8189a3afb7d35ab2f7c327be65c99e64fa6",
      "target_id": "ru-fr81-u251-r0078",
      "tag": "prose",
      "target_sha256": "ba95afa4da7b26bc903e54f50ea0cbe2bbbec7bf58bcfeb040823d54b7d02e56"
    },
    {
      "source_id": "fr81-u251-r0079",
      "target": "Когда хлеб был нарезан, булочник сгрёб су в кассу, и Гаврош сказал обоим детям:",
      "source_sha256": "06bd5ba49392b26d45b5d1ca237e9c7a30b17b3a9a9a35d87f14206887180230",
      "target_id": "ru-fr81-u251-r0079",
      "tag": "prose",
      "target_sha256": "2b9723217fac97ad71d3acb115abb81f3fa0b89d0171e7a0c66feb3376c4b2f1"
    },
    {
      "source_id": "fr81-u251-r0080",
      "target": "— Лопайте.",
      "source_sha256": "35585278cd05e117602f479d095ea294b07f4e31bfc4c31b5b5ac3c1ad4d5df1",
      "target_id": "ru-fr81-u251-r0080",
      "tag": "prose",
      "target_sha256": "4304d72fb30e501817d1733e5a7064a0f6aed55030ceb4cd75cb25cd61879661"
    },
    {
      "source_id": "fr81-u251-r0081",
      "target": "Мальчуганы смотрели на него в замешательстве.",
      "source_sha256": "40c8bf2375bdb992da6e260dbe9123beb3a2f4f16439a04627f1f134b81cd164",
      "target_id": "ru-fr81-u251-r0081",
      "tag": "prose",
      "target_sha256": "132e66ff874480d6873f214b54953f3b0fb139a75deedee7e4bccdb8fac411aa"
    },
    {
      "source_id": "fr81-u251-r0082",
      "target": "Гаврош рассмеялся:",
      "source_sha256": "8cee7539301525727ffbd4f279f12194264a21974fc062ea7a0fac27ff6bc51f",
      "target_id": "ru-fr81-u251-r0082",
      "tag": "prose",
      "target_sha256": "63045c7b6d147fd19be07ec9fba19bdb2341e2e5ffcea30cf7cce0e1dce8e23e"
    },
    {
      "source_id": "fr81-u251-r0083",
      "target": "— А, ну да, правда, они ещё не знают, такие маленькие.",
      "source_sha256": "3b435a235e168cc0eda32051c2de368009d5db761fac58e63fce382bab675998",
      "target_id": "ru-fr81-u251-r0083",
      "tag": "prose",
      "target_sha256": "793189ec225c1e26f2cb8c2c9588cfa710545e65d0a8fcc440be1ceb5ec4f419"
    },
    {
      "source_id": "fr81-u251-r0084",
      "target": "И продолжил:",
      "source_sha256": "7494db6c43db8d3ece154f0e7674f72fa4068a3b27c183d3503c37faa5bf57aa",
      "target_id": "ru-fr81-u251-r0084",
      "tag": "prose",
      "target_sha256": "9a421f6e678253c9fd293aa09e5b69a2346a89d039edf8f6a4e1a61d9056fc4a"
    },
    {
      "source_id": "fr81-u251-r0085",
      "target": "— Ешьте.",
      "source_sha256": "0090b708e23cacacc7db5793c01881a5a3553cffe079f5ee6cbb96e4866dd7f5",
      "target_id": "ru-fr81-u251-r0085",
      "tag": "prose",
      "target_sha256": "e98303463e81eb27f65a1ff19ee3dc5a045f8c88efd52d1779a17d632d2408ad"
    },
    {
      "source_id": "fr81-u251-r0086",
      "target": "В то же время он протянул каждому по куску хлеба.",
      "source_sha256": "d134513df1a175bd85ac9c49e96944e48ff6df5986071784702ebd850200cd0c",
      "target_id": "ru-fr81-u251-r0086",
      "tag": "prose",
      "target_sha256": "4b30df0de187bbb095386f29de307a43ef4ba7453082501642672824a81c0ff4"
    },
    {
      "source_id": "fr81-u251-r0087",
      "target": "И, полагая, что старший, казавшийся ему более достойным беседы, заслуживает особого поощрения и должен быть избавлен от всякого колебания в удовлетворении аппетита, он добавил, отдавая ему самую большую долю:",
      "source_sha256": "2637c702258edbb6c99e38051647c4e61a73df6d98675fe71f65d58960252de1",
      "target_id": "ru-fr81-u251-r0087",
      "tag": "prose",
      "target_sha256": "1225a08f5deb99fb9cac4074adbc37bfbed4e751096381f02969364da52a4dbc"
    },
    {
      "source_id": "fr81-u251-r0088",
      "target": "— Забей-ка это себе в ствол.",
      "source_sha256": "fb67847190ec82a1b683524dd61a0da61a40861d58809987cdafa40ce4d8f39b",
      "target_id": "ru-fr81-u251-r0088",
      "tag": "prose",
      "target_sha256": "1e2f82263eb39e4c01f38720974fd98c014897daba66eb1179f1c4a712e3105a"
    },
    {
      "source_id": "fr81-u251-r0089",
      "target": "Один кусок был меньше двух других; его он взял себе.",
      "source_sha256": "80a81a1ad8d1d93ce2b0cd2dbddc72c4bef13aed9ad16081738c0201f0438c0a",
      "target_id": "ru-fr81-u251-r0089",
      "tag": "prose",
      "target_sha256": "6837722aaf4a00497740fa15bb66ee2d34dfbe9eed1c4f6e714b6f095efa1140"
    },
    {
      "source_id": "fr81-u251-r0090",
      "target": "Бедные дети были голодны, и Гаврош не меньше их. Вгрызаясь в хлеб крепкими зубами, они загромождали лавку булочника, который теперь, когда ему заплатили, поглядывал на них с неудовольствием.",
      "source_sha256": "c1cf5dccd75efe26f6995ffff177bdf80a50eb7ed228eedc885d5f305ad3c2f9",
      "target_id": "ru-fr81-u251-r0090",
      "tag": "prose",
      "target_sha256": "62f1b0cbb84013da13b8fbf36d37ce8bfd8c8bcc119ca1ac245f22532fba65a0"
    },
    {
      "source_id": "fr81-u251-r0091",
      "target": "— Вернёмся на улицу, — сказал Гаврош.",
      "source_sha256": "c7cf237bce81da26483fa605c7560c724bc1ec77fb7284a60a5504f4c5d079c3",
      "target_id": "ru-fr81-u251-r0091",
      "tag": "prose",
      "target_sha256": "57061b81bd78f060c02196e746e5c9789e4d4e3d9c69f04bfe35bf11917e61d2"
    },
    {
      "source_id": "fr81-u251-r0092",
      "target": "Они снова направились к Бастилии.",
      "source_sha256": "c1072e0f2d4248797b7846259b55494f29fcefdf0792e56c38e12a61681db2aa",
      "target_id": "ru-fr81-u251-r0092",
      "tag": "prose",
      "target_sha256": "b363e38666ea6a73eb4ccd8ace97d3b134bfe7cafeb307369b6a0f75a42b5fec"
    },
    {
      "source_id": "fr81-u251-r0093",
      "target": "Время от времени, когда они проходили мимо освещённых витрин, самый маленький останавливался, чтобы посмотреть, который час, на свинцовых часах, висевших у него на шее на бечёвке.",
      "source_sha256": "7cc1e80df42a0ee3a386c3bb077ed8076bd470f19517ace03a5ddc1416dda64b",
      "target_id": "ru-fr81-u251-r0093",
      "tag": "prose",
      "target_sha256": "b5cfd2701ae622f7d5a48db198be293295e0778f80c786f020feeb5c20572fda"
    },
    {
      "source_id": "fr81-u251-r0094",
      "target": "— Вот уж, право, отменный простофиля, — говорил Гаврош.",
      "source_sha256": "8168201d1d82ebd273a1a50c854d342b2714fde286cf5e9ee690e9245d7dd5a5",
      "target_id": "ru-fr81-u251-r0094",
      "tag": "prose",
      "target_sha256": "b53380d2f4994c95e6059e79a6963f01d955ef30c425f5bc11b2d30c59744427"
    },
    {
      "source_id": "fr81-u251-r0095",
      "target": "Потом, задумчивый, он бормотал сквозь зубы:",
      "source_sha256": "c5e13d37695f46e90532094a7c419082e2ec5a47b0f6167051d22dd1fec63cac",
      "target_id": "ru-fr81-u251-r0095",
      "tag": "prose",
      "target_sha256": "9c134f01373054cd80ca1e93dc149ca1c7c82dac0ac5b7859c3460b33f566734"
    }
  ],
