{
  "unit": 251,
  "batch": 3,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u251-r0096",
      "target": "— А всё-таки, будь у меня свои мальцы, я бы их держал покрепче.",
      "source_sha256": "0d97bdd377d0a075552cd97312a99e6c68d43b6bcd50c1697deefec58a597437",
      "target_id": "ru-fr81-u251-r0096",
      "tag": "prose",
      "target_sha256": "c969dfadaf51c798e764ea516ca93ea3e9da934a857494eaac04698e57cfefdd"
    },
    {
      "source_id": "fr81-u251-r0097",
      "target": "Когда они доедали свой кусок хлеба и дошли до угла унылой улицы Балле, в глубине которой виднеется низкая, недружелюбная калитка Форс:",
      "source_sha256": "98b7a0b4f94ba571bc49498bc933dbb93bd331d446156279f94014341e601453",
      "target_id": "ru-fr81-u251-r0097",
      "tag": "prose",
      "target_sha256": "a615e32a3e6abe96b924ddd26a17750d430baee9ad068c4003d930cc84cf28c2"
    },
    {
      "source_id": "fr81-u251-r0098",
      "target": "— Смотри-ка, это ты, Гаврош? — сказал кто-то.",
      "source_sha256": "3f3ac1977c2ff61dcad12ff2980bd15a8c4128f8030b580e6a2ab56e278b5163",
      "target_id": "ru-fr81-u251-r0098",
      "tag": "prose",
      "target_sha256": "4e4ca37647ba22768bc2c72557c0a8088d773f44143a19000e70fa996050f05c"
    },
    {
      "source_id": "fr81-u251-r0099",
      "target": "— Смотри-ка, это ты, Монпарнас? — сказал Гаврош.",
      "source_sha256": "41a18ae4d48529d6a518a6f5e9f542ba6804ddc0eb85a45f0115fd918ba817a6",
      "target_id": "ru-fr81-u251-r0099",
      "tag": "prose",
      "target_sha256": "0858e43026f0e5fd00e504a33669de05027ec56fcadaf1b372bf1d04e1f08385"
    },
    {
      "source_id": "fr81-u251-r0100",
      "target": "Это был человек, только что окликнувший мальчишку, и человек этот был не кто иной, как Монпарнас, переодетый, в синих очках, но для Гавроша всё же узнаваемый.",
      "source_sha256": "43d159bf45eb5fd1b2f0fcb0291c4827f9599a328e6b78953aec940d3a79345a",
      "target_id": "ru-fr81-u251-r0100",
      "tag": "prose",
      "target_sha256": "1b3bf20f1b400b4ee8db59672a579896db5cc9b17a10ecc27b92c0a366894126"
    },
    {
      "source_id": "fr81-u251-r0101",
      "target": "— Чёрт возьми! — продолжал Гаврош. — На тебе шкурка цвета льняной припарки и синие очки, как у лекаря. Шик у тебя есть, честное слово, старина!",
      "source_sha256": "f4a73961eb1d913bd793fee94b733b1c5841d96a6e86a5b424de94473c2bacaf",
      "target_id": "ru-fr81-u251-r0101",
      "tag": "prose",
      "target_sha256": "c8489f3ea4fd22c1453c7ce9e1c0ca9fcfe698fd304ab490d31249ddb0d77f2f"
    },
    {
      "source_id": "fr81-u251-r0102",
      "target": "— Тсс, — сказал Монпарнас, — не так громко!",
      "source_sha256": "d497ad55c6969408d28fc25458dc47813cd5ee9eb0b62d92c42ccb1d2a2a6d34",
      "target_id": "ru-fr81-u251-r0102",
      "tag": "prose",
      "target_sha256": "c67a9e50639aad4da70978c871f451d25450fc7ee03d2a1566aeb53510769fdc"
    },
    {
      "source_id": "fr81-u251-r0103",
      "target": "И он поспешно увлёк Гавроша прочь от света лавок.",
      "source_sha256": "46349d2fdf431a10c968421cf07632572ec8a2b3df93ebba09ad98351d9ec7a3",
      "target_id": "ru-fr81-u251-r0103",
      "tag": "prose",
      "target_sha256": "a10c9fe6bdea3dabd8929ae42309488f5fec4810c6857dee6e71c02e8c6c07ff"
    },
    {
      "source_id": "fr81-u251-r0104",
      "target": "Двое малышей машинально шли следом, держась за руки.",
      "source_sha256": "641b32445d73797bfe888ce4dcce11535f2cda03d653e8cca0c8b1ed9a384128",
      "target_id": "ru-fr81-u251-r0104",
      "tag": "prose",
      "target_sha256": "35851ce94683406bf97ff59385e18efcaa372f226db7525882468c643e173c88"
    },
    {
      "source_id": "fr81-u251-r0105",
      "target": "Когда они очутились под чёрным сводом ворот, укрытые от чужих взглядов и от дождя:",
      "source_sha256": "a6bc9832cb95cf00ab5fc48795595637b648d0013ee4dddcb0d8c8ee99e4f75f",
      "target_id": "ru-fr81-u251-r0105",
      "tag": "prose",
      "target_sha256": "e398c98ab7ef45b0f83f45ac4b691bf53403177417d478585ea11fda4052531e"
    },
    {
      "source_id": "fr81-u251-r0106",
      "target": "— Знаешь, куда я иду? — спросил Монпарнас.",
      "source_sha256": "d24d9a630257da978b5891b4bbfa4fc83efae1a821b498999604e1e28754db2a",
      "target_id": "ru-fr81-u251-r0106",
      "tag": "prose",
      "target_sha256": "8ff48c8eec35ad0b8c00e668a3320ce997f0db9e73ccfd46442b5004f35ba8b8"
    },
    {
      "source_id": "fr81-u251-r0107",
      "target": "— В аббатство Монт-а-Репре[[N2]], — сказал Гаврош.",
      "source_sha256": "2bd76d57b41743d1f45a263aaa6458fba93c7bc4b6253afa6fe2a3313915f8e5",
      "target_id": "ru-fr81-u251-r0107",
      "tag": "prose",
      "target_sha256": "f8d492809f069439880ded66b8ca597792936e1021d8e51447398a322e10d158"
    },
    {
      "source_id": "fr81-u251-r0108",
      "target": "— Шутник!",
      "source_sha256": "2656c389ea831094caf2d3e2853d6871c8bd0531477496daef3d1c105cd303db",
      "target_id": "ru-fr81-u251-r0108",
      "tag": "prose",
      "target_sha256": "ef37c0579ada8a01431492c658079a6b12429fe75caf578478a53bf06bf572cc"
    },
    {
      "source_id": "fr81-u251-r0109",
      "target": "И Монпарнас продолжал:",
      "source_sha256": "174c501e1e086986f0d15bf5ecf064642b42bb2e7ee6d1ce0ba2b22b13227149",
      "target_id": "ru-fr81-u251-r0109",
      "tag": "prose",
      "target_sha256": "d82c1f07b00a4ee047fa78f4f1a7a43da7ef6b5e8bd0879f5017d491b1fec120"
    },
    {
      "source_id": "fr81-u251-r0110",
      "target": "— Иду искать Бабета.",
      "source_sha256": "1780063aecef818df0fcbc66365465bd6d9b2420b1ed5a38d7a3cf4e939829fe",
      "target_id": "ru-fr81-u251-r0110",
      "tag": "prose",
      "target_sha256": "2f7531660474ac466569202977d9d16807020d84e5cd687bb779d246ca1934d0"
    },
    {
      "source_id": "fr81-u251-r0111",
      "target": "— А! — сказал Гаврош. — Её зовут Бабет.",
      "source_sha256": "ed69a73e99a877850002b5c8accd822707c8c90ed5183baf1d40fdfe242685d0",
      "target_id": "ru-fr81-u251-r0111",
      "tag": "prose",
      "target_sha256": "fe2ba725656c8304bcfcd858b1c92d8f544d76e4eaff969a52b51429ffbb58ee"
    },
    {
      "source_id": "fr81-u251-r0112",
      "target": "Монпарнас понизил голос.",
      "source_sha256": "426b71cbd238e5ac9cb86249dcb5ff25f172e24ca50d8008954b250fa48eeae1",
      "target_id": "ru-fr81-u251-r0112",
      "tag": "prose",
      "target_sha256": "591f8b6a366faf81cca78eece92404dad5f6fefebd8e157ab9d6ccd0d4a0a369"
    },
    {
      "source_id": "fr81-u251-r0113",
      "target": "— Не её, а его.",
      "source_sha256": "abc3e4f8c975b93591555ed2d69e76fff72df00fb6015061dce1a8c0c9c5399b",
      "target_id": "ru-fr81-u251-r0113",
      "tag": "prose",
      "target_sha256": "d4a8a4205e9be9ad4a8cf7fb1fd17ba3cf717441e731d70d975706bce7653bf3"
    },
    {
      "source_id": "fr81-u251-r0114",
      "target": "— А, Бабет!",
      "source_sha256": "7d91e120c03c39876f55d44793f3920365ea8e8446535d9c3c52d51c2199ba2d",
      "target_id": "ru-fr81-u251-r0114",
      "tag": "prose",
      "target_sha256": "23620b13c2967d1e809f4deb5961d5b88a0874c779df9c6251f8dccd726d8acd"
    },
    {
      "source_id": "fr81-u251-r0115",
      "target": "— Да, Бабет.",
      "source_sha256": "6ad8d26322c119fe6626f61e2b9778d8b7298fcc8b753edaacc1e60c80485f42",
      "target_id": "ru-fr81-u251-r0115",
      "tag": "prose",
      "target_sha256": "0af68dbb6f8645a66e24df11ff34145529c4222920a86dbc5cba8f454d1aeb4b"
    },
    {
      "source_id": "fr81-u251-r0116",
      "target": "— Я думал, он под замком.",
      "source_sha256": "47401dc7f58274a8e31eebd87d9d4d7b0447bdde21143b50543d66c487b22740",
      "target_id": "ru-fr81-u251-r0116",
      "tag": "prose",
      "target_sha256": "fc83a27b784829a3cef1a3f013b2cc3467d497b349308c67a3d315b28855508a"
    },
    {
      "source_id": "fr81-u251-r0117",
      "target": "— Он расстегнул замок, — ответил Монпарнас.",
      "source_sha256": "7705eba40dd725a4bc08a3eff7807012881453346d23d073efa1dcbd63c38cf7",
      "target_id": "ru-fr81-u251-r0117",
      "tag": "prose",
      "target_sha256": "4bbf7244adeaa42f3e53125364d0003a260f2597b0c11f8569aec3ad0e5b23b5"
    },
    {
      "source_id": "fr81-u251-r0118",
      "target": "И он быстро рассказал мальчишке, что утром того самого дня, который они сейчас доживали, Бабета перевели в Консьержери, и он бежал, свернув налево вместо того, чтобы свернуть направо, в «следственном коридоре».",
      "source_sha256": "89ed37d2565949b054c54f2b6be1f4406206151d7cd38c8e194d90d790fc5d7b",
      "target_id": "ru-fr81-u251-r0118",
      "tag": "prose",
      "target_sha256": "653cd4737eadc79b4793d7b0a2394a987b617e88836d6f44b41a418199fb3aeb"
    },
    {
      "source_id": "fr81-u251-r0119",
      "target": "Гаврош восхитился ловкостью.",
      "source_sha256": "e51cfcde73e1bcfe00bea8554316750bededad2c0c22ee3b35a81fb5b036707b",
      "target_id": "ru-fr81-u251-r0119",
      "tag": "prose",
      "target_sha256": "f84fa185478fc4f9c4a68d4c12f7c7f21e6cca8cfe13556d7354da7b5b4f1ff7"
    },
    {
      "source_id": "fr81-u251-r0120",
      "target": "— Вот это зубодёр! — сказал он.",
      "source_sha256": "85d1438793f38d3dd9d13a28d166d8490f53338c1378780214e25418c55212e3",
      "target_id": "ru-fr81-u251-r0120",
      "tag": "prose",
      "target_sha256": "98726a2441c8563f51ec44723b8ee13fdfe630977b0605132a9e7146eab14932"
    },
    {
      "source_id": "fr81-u251-r0121",
      "target": "Монпарнас добавил кое-какие подробности о побеге Бабета и закончил так:",
      "source_sha256": "a885aeb7d3d51eed04e745ad3644b90b23d4afd0fd26d02f3245354edeb9865f",
      "target_id": "ru-fr81-u251-r0121",
      "tag": "prose",
      "target_sha256": "4085886edddd2a9ddee8f0f1e9956353e795307fd5487270be69881b71331d3c"
    },
    {
      "source_id": "fr81-u251-r0122",
      "target": "— О! Это ещё не всё.",
      "source_sha256": "378fc7e68877de73d1d94796a3834adc7741660484c6aed3b6a97e758d262fd6",
      "target_id": "ru-fr81-u251-r0122",
      "tag": "prose",
      "target_sha256": "08cecb61f0ee131638a7dff373cc86813191a47f3a49c523182457691a91986c"
    },
    {
      "source_id": "fr81-u251-r0123",
      "target": "Гаврош, слушая, завладел тростью, которую Монпарнас держал в руке, машинально вытянул её верхнюю часть, и показалось лезвие кинжала.",
      "source_sha256": "5a681ff167896d97e2913bc4230e00162198149aaa7688fa14e1273d4782b5c9",
      "target_id": "ru-fr81-u251-r0123",
      "tag": "prose",
      "target_sha256": "91b2d507e36e05950af0039a55113bed0c64421074ab4c92aadee2c355bab4ef"
    },
    {
      "source_id": "fr81-u251-r0124",
      "target": "— А! — сказал он, поспешно задвигая кинжал обратно. — Ты прихватил с собой своего жандарма, переодетого в буржуа.",
      "source_sha256": "219ff30d75dbd09181985628ed9296785895c65a860cce69c7de9c170c4375a2",
      "target_id": "ru-fr81-u251-r0124",
      "tag": "prose",
      "target_sha256": "c606e2e216ea92711c953d0877a1df4ad4918a6aa16a9121ee5407ddd357c4b0"
    },
    {
      "source_id": "fr81-u251-r0125",
      "target": "Монпарнас подмигнул.",
      "source_sha256": "61b3a5b28ace0446e2da2c2befb5d2d12547798460f553bf4fb6f2d57e99d61c",
      "target_id": "ru-fr81-u251-r0125",
      "tag": "prose",
      "target_sha256": "fd4fb1f26c953b91849cb16d552066e2d6135c897b19d86a3130c0a98ce2e44b"
    },
    {
      "source_id": "fr81-u251-r0126",
      "target": "— Ого! — продолжал Гаврош. — Стало быть, ты собираешься схватиться с фараонами?",
      "source_sha256": "920bf13a04a27042718b4cc74cd11122cc034ec71c3440dc76a8eb678a231a0d",
      "target_id": "ru-fr81-u251-r0126",
      "tag": "prose",
      "target_sha256": "ddf07b85e49ad9a6489b6ae737cc564d83eb2f018227bc5635a2cd2559a4486a"
    },
    {
      "source_id": "fr81-u251-r0127",
      "target": "— Кто его знает, — ответил Монпарнас с безразличным видом. — Булавку при себе иметь всегда не вредно.",
      "source_sha256": "44935413d3507c9cf74e9bf603360e8906127511b6c03f5c11a5afb0a150622f",
      "target_id": "ru-fr81-u251-r0127",
      "tag": "prose",
      "target_sha256": "71c3d1a29bca51d50daaff46d61882f531b4d3a2f80fa1c0340e44099c25c79c"
    }
  ],
