{
  "unit": 116,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u116-h",
      "target": "VII Продолжение загадки",
      "source_sha256": "b199be79748823352ed9615691ff308eb3d17e6d2f8a4632e4345c88b845a5c9",
      "target_id": "ru-fr81-u116-h",
      "tag": "heading",
      "target_sha256": "18723cfe1a1a67031eb441227c0d9480a23603e95185b6c042b10b1270663674"
    },
    {
      "source_id": "fr81-u116-r0001",
      "target": "Поднялся ночной северный ветер; это означало, что было, должно быть, between час и два часа ночи. Бедная Козетта молчала. Она сидела на земле рядом с ним, склонив голову к его боку, и Жан Вальжан подумал, что она уснула. Он наклонился и посмотрел на неё. Глаза Козетты были широко открыты, и вид у неё был задумчивый, от которого Жану Вальжану стало больно.",
      "source_sha256": "fc7b28373847f2db673b33218118d787e5a9ccf1975bc43f80be5a0473450034",
      "target_id": "ru-fr81-u116-r0001",
      "tag": "prose",
      "target_sha256": "0858554759eca4f393aa973834cb3872ce0863e3b7f15b2ecbe091c1552f5ce1"
    },
    {
      "source_id": "fr81-u116-r0002",
      "target": "Она всё ещё дрожала.",
      "source_sha256": "2930e41098d5996ad6a8cad63cfb91ef1fde745c749efa162e8668ed6ff57254",
      "target_id": "ru-fr81-u116-r0002",
      "tag": "prose",
      "target_sha256": "30c1e065cae865e788e9f8d523734d20515ecc8157ea9be41de2a4cee34a139f"
    },
    {
      "source_id": "fr81-u116-r0003",
      "target": "— Тебе хочется спать? — спросил Жан Вальжан.",
      "source_sha256": "596572c2d83c54147fcdb47b00888162bcd7f28874a36752b3c7adde632122ec",
      "target_id": "ru-fr81-u116-r0003",
      "tag": "prose",
      "target_sha256": "9b34141ed6c8ccba82f91dfb52f784a6201afcce667e4731f3d204f2cceb515c"
    },
    {
      "source_id": "fr81-u116-r0004",
      "target": "— Мне очень холодно, — ответила она.",
      "source_sha256": "305011fa7e639eda6aad69f5112bef35f307bd51b3461f704214b983f71f30eb",
      "target_id": "ru-fr81-u116-r0004",
      "tag": "prose",
      "target_sha256": "09e3561093633826614e5059de92dd8668f7daca28f2b678c2d1e03606fe1be5"
    },
    {
      "source_id": "fr81-u116-r0005",
      "target": "Немного погодя она заговорила снова:",
      "source_sha256": "8bc9f3b41cef43a4c9f5bb2a6f3443fc34dfc1aaf0f031fe3dd372b2cd198bf2",
      "target_id": "ru-fr81-u116-r0005",
      "tag": "prose",
      "target_sha256": "ac42877b4fc5a6ede5b5504cd6995ca2f4ac3fe1890b061daa3aa5433e704105"
    },
    {
      "source_id": "fr81-u116-r0006",
      "target": "— Она всё ещё там?",
      "source_sha256": "a3d4ac4fe281955def5ce035b316721403752af71cab4fe20085785d93536397",
      "target_id": "ru-fr81-u116-r0006",
      "tag": "prose",
      "target_sha256": "f6fbf88e8a5e885f2600e6eadb22fdaee43060a7d0026df51cec101cda54e107"
    },
    {
      "source_id": "fr81-u116-r0007",
      "target": "— Кто? — спросил Жан Вальжан.",
      "source_sha256": "ed0fab842f93bde6ce112e57eb760166e08d209b3b1eb4ed95a6019c9e537aa4",
      "target_id": "ru-fr81-u116-r0007",
      "tag": "prose",
      "target_sha256": "46104bd75964eeac72d046101453dd0a65a3f810ed3215d3bcaf631ef5fd7dcf"
    },
    {
      "source_id": "fr81-u116-r0008",
      "target": "— Госпожа Тенардье.",
      "source_sha256": "197af569f2e3f16be625024caa236b229b3b63ac25fcaa41ca8eb5cb9b03cf43",
      "target_id": "ru-fr81-u116-r0008",
      "tag": "prose",
      "target_sha256": "596ab39c57b87eda34a01c6a22df96260f48a7725dd1a54fc5a95d127cc89c01"
    },
    {
      "source_id": "fr81-u116-r0009",
      "target": "Жан Вальжан уже забыл, чем он воспользовался, чтобы заставить Козетту молчать.",
      "source_sha256": "e1818d472e814938cb16b86d2f037d6bbb6100cb4a33df8606bd66100726ea50",
      "target_id": "ru-fr81-u116-r0009",
      "tag": "prose",
      "target_sha256": "b10c51af9f91fea548812b5ef9624a3323f7353a94059d02650b396932219661"
    },
    {
      "source_id": "fr81-u116-r0010",
      "target": "— А! — сказал он. — Она ушла. Больше нечего бояться.",
      "source_sha256": "72c5285aa13faecbd65deddfab50a5929589f44ea6156feff9f8f2e16eb04b64",
      "target_id": "ru-fr81-u116-r0010",
      "tag": "prose",
      "target_sha256": "42f59a075691897096a99b6026f92f93db30267498dde7118a683cebcc9b3bfd"
    },
    {
      "source_id": "fr81-u116-r0011",
      "target": "Ребёнок вздохнул, словно с груди у него свалилась тяжесть.",
      "source_sha256": "e706090cce7b7bb52cb2bc30ee493e4304cc1ea5224fc327e89cf7d0ed62bbd9",
      "target_id": "ru-fr81-u116-r0011",
      "tag": "prose",
      "target_sha256": "226777cc7678ed328d846f20b25400ecb5d950199eccf19654e04be4a11b6f34"
    },
    {
      "source_id": "fr81-u116-r0012",
      "target": "Земля была сырая, навес open со всех сторон, ветер с каждой минутой становился свежее. Старик снял редингот и закутал в него Козетту.",
      "source_sha256": "cfdae25aee616057f8b49f228403efd8f63112b2c47af9e17d931c09f0864c4b",
      "target_id": "ru-fr81-u116-r0012",
      "tag": "prose",
      "target_sha256": "b45bdc8363190c06b8b1359d17a0ba48992b79d688ffc0d384d8fca938022399"
    },
    {
      "source_id": "fr81-u116-r0013",
      "target": "— Так тебе теплее? — спросил он.",
      "source_sha256": "0f91b6a0546c2d6c9a295d368d25bd83f933473230a333fae2a4b71f56bce6e1",
      "target_id": "ru-fr81-u116-r0013",
      "tag": "prose",
      "target_sha256": "cfa84f87f57de7403108178284c1d5ff09ecd113b570f9f8ea9208dbfc182ffe"
    },
    {
      "source_id": "fr81-u116-r0014",
      "target": "— О да, отец!",
      "source_sha256": "057014159c9e63ab2f2e339c90319385583b93599f96caef1bd9eb71ed97de7a",
      "target_id": "ru-fr81-u116-r0014",
      "tag": "prose",
      "target_sha256": "c6f7af889f82e6d0221757a1109f7ddbda1dbbbb071cd8ff65d2395c97169887"
    },
    {
      "source_id": "fr81-u116-r0015",
      "target": "— Ну так подожди меня минутку. Я вернусь.",
      "source_sha256": "1e594aea84486fd0a740e626f1e530b64222f2316d51981c61d6b9e4d3f0b445",
      "target_id": "ru-fr81-u116-r0015",
      "tag": "prose",
      "target_sha256": "52243659ec08224d469b946461cda7a375642d64182f02cc099549a5ce5a46ea"
    },
    {
      "source_id": "fr81-u116-r0016",
      "target": "Он вышел из развалины и пошёл вдоль большого здания, ища какое-нибудь укрытие получше. Ему попадались двери, но все они были заперты. На всех окнах нижнего этажа были решётки.",
      "source_sha256": "c1d63cb118de2e52b4aff6c0f9d92c88977a8a28d78e326926c82cdeedc5a479",
      "target_id": "ru-fr81-u116-r0016",
      "tag": "prose",
      "target_sha256": "96c77211ee5277e2b7d98676d1bd6a4384985f33326d86cf0d63096c8ebb3a3c"
    },
    {
      "source_id": "fr81-u116-r0017",
      "target": "Едва он миновал внутренний угол здания, как заметил, что подходит к окнам со сводчатым верхом, и увидел в них какой-то свет. Он приподнялся на цыпочки и заглянул в одно из этих окон. Все они выходили в довольно обширный зал, вымощенный широкими плитами, разделённый арками и столбами; в нём нельзя было различить ничего, кроме слабого свечения и больших теней. Свет исходил от ночника, зажжённого в углу. Зал был пуст, и ничто в нём не шевелилось. Однако, вглядываясь, он решил, что видит на полу, на плитах, что-то, покрытое как будто саваном и напоминающее человеческую фигуру. Она лежала ничком, лицом к камню, раскинув руки крестом, в неподвижности смерти. По чему-то вроде змеи, тянувшейся по плитам, можно было подумать, что на шее у этой зловещей фигуры верёвка.",
      "source_sha256": "7fb59bc48a58023040639cb7ba648ae50e5ce1e41aaae6f3bd29231539042f53",
      "target_id": "ru-fr81-u116-r0017",
      "tag": "prose",
      "target_sha256": "3929b481251f2ec2ed8c5a8dbe0614215a3583b9f8ee415653757c291f20931a"
    },
    {
      "source_id": "fr81-u116-r0018",
      "target": "Весь зал тонул в том тумане плохо освещённых мест, который усугубляет ужас.",
      "source_sha256": "a9213d59df1c1aa0d268a02c2523b85e2414260a442ef39967e8bce081b76d3e",
      "target_id": "ru-fr81-u116-r0018",
      "tag": "prose",
      "target_sha256": "b507654ac4138f132f4c01e744f3f8304304746bc90dd1bac25c06935ab19ee3"
    },
    {
      "source_id": "fr81-u116-r0019",
      "target": "Жан Вальжан часто говорил впоследствии, что, хотя в его жизни ему довелось видеть много погребальных зрелищ, никогда он не видел ничего более леденящего и страшного, чем эта загадочная фигура, совершающая неведомо какое непостижимое таинство в этом мрачном месте и так мельком увиденная ночью. Страшно было предположить, что это, быть может, мёртвое, и ещё страшнее — подумать, что это, быть может, живое.",
      "source_sha256": "a5d0a4ecff422f6d8355182fc059443dfb979b28a842d8852e7b4b04484019b5",
      "target_id": "ru-fr81-u116-r0019",
      "tag": "prose",
      "target_sha256": "04ed861a61634453901d3490493a84f44d44677f7197d970148b375d72bd9768"
    },
    {
      "source_id": "fr81-u116-r0020",
      "target": "У него хватило мужества прижаться лбом к стеклу и подстеречь, не шевельнётся ли эта вещь. Сколько он ни оставался там, а время показалось ему очень долгим, распростёртая фигура не сделала ни одного движения. Вдруг он почувствовал неописуемый ужас и бросился бежать. Он помчался к навесу, не смея оглянуться назад. Ему казалось, что, если он повернёт голову, то увидит, как эта фигура широкими шагами идёт за ним, размахивая руками.",
      "source_sha256": "eb251206535ac771ae672bf24a32758644a2c2fb664e0e6e6a06743651631d77",
      "target_id": "ru-fr81-u116-r0020",
      "tag": "prose",
      "target_sha256": "7e2770f7840baa49b348c54091456d53acaaabcafed34addbabd428f6381f2cd"
    },
    {
      "source_id": "fr81-u116-r0021",
      "target": "Он добежал до развалины, задыхаясь. Колени у него подгибались; пот стекал по пояснице.",
      "source_sha256": "7bd58ee106f20ab05982a41ba4718b51f6667d0c50b6aefca3bbc6acae73969e",
      "target_id": "ru-fr81-u116-r0021",
      "tag": "prose",
      "target_sha256": "6b12e798c065ecabc8e3f2c2253a8bbe3eaab4af889e55adea29d64fdc991133"
    },
    {
      "source_id": "fr81-u116-r0022",
      "target": "Где он был? Кто мог бы вообразить что-либо подобное этому подобию склепа посреди Парижа? Что это за странный дом? Здание, полное ночной тайны, которое зовёт души во мраке голосами ангелов и, когда они приходят, внезапно являет им это страшное видение, обещает отворить сияющие врата неба и отворяет ужасные врата гроба! И это в самом деле было здание, дом, имевший свой номер на улице! Это не было сном! Ему нужно было потрогать камни, чтобы поверить.",
      "source_sha256": "a2d508eb155e1da2fcc08dacd25fff30062a4dbf87c6cd8c7cfca7f33e5b50f6",
      "target_id": "ru-fr81-u116-r0022",
      "tag": "prose",
      "target_sha256": "17691121d03809fc990723feee3d8a040c8ea99614420334d071a9c32ce06b17"
    },
    {
      "source_id": "fr81-u116-r0023",
      "target": "Холод, тревога, беспокойство, волнения вечера вызвали у него настоящую лихорадку, и все эти мысли сталкивались у него в голове.",
      "source_sha256": "6ad8dea6b2f2fc9162104d1c52be5658076feeea3911365427585249ccecf161",
      "target_id": "ru-fr81-u116-r0023",
      "tag": "prose",
      "target_sha256": "5c801ac9fee752b263e508176810d2592b125323919ce7b244499c7f76222c19"
    },
    {
      "source_id": "fr81-u116-r0024",
      "target": "Он подошёл к Козетте. Она спала.",
      "source_sha256": "fd80d3763ea5e543a6cb05ca4f681aea0daa57710e7d5ac10c3d473cb511fb31",
      "target_id": "ru-fr81-u116-r0024",
      "tag": "prose",
      "target_sha256": "933e0a09f60e8c26f287fb9413e93196452322ed6a372de5db1034de5d285ed9"
    }
  ],
