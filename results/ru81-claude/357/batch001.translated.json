{
  "unit": 357,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u357-r0031",
      "target": "Козетта всплеснула своими маленькими ручками.",
      "source_sha256": "4f55a5d6b40f10b98ad2fda4909dfbcb6ee8a4ab80604a7fe78e8ad6fe359016",
      "target_id": "ru-fr81-u357-r0031",
      "tag": "prose",
      "target_sha256": "f3b7860c7513c17ed30a7172dd2549b8e6761d21b52af429a0030c5ede03d14f"
    },
    {
      "source_id": "fr81-u357-r0032",
      "target": "— Сударыня!.. Вот как!.. Опять новости! Что всё это значит?",
      "source_sha256": "029a5e4e6552989c75474454feaf3cae6bf19812c753030ce57a34f51c4344cd",
      "target_id": "ru-fr81-u357-r0032",
      "tag": "prose",
      "target_sha256": "083dd264dc2f6e914bd31ba48479e10472a17914977f8d1fd979181f37184606"
    },
    {
      "source_id": "fr81-u357-r0033",
      "target": "Жан Вальжан устремил на неё ту скорбную улыбку, к которой порой прибегал.",
      "source_sha256": "572630273462a025f42891afacb447ceecae074dc68af9c923b61ebe0b1bdc35",
      "target_id": "ru-fr81-u357-r0033",
      "tag": "prose",
      "target_sha256": "8d60869773af885587e3938ce5f1c6a322387a2c7fc1940c51aaa798e43bb772"
    },
    {
      "source_id": "fr81-u357-r0034",
      "target": "— Вы хотели быть сударыней. Вы ею и стали.",
      "source_sha256": "1d8472b9d39d101d4d6b59e483e3f46da57b62b73f3c03597a65aaedcb6c7a6c",
      "target_id": "ru-fr81-u357-r0034",
      "tag": "prose",
      "target_sha256": "8753f57c457ab360163495c74c2a78a070a0d4b15a1fd01efebad1e4f59aa433"
    },
    {
      "source_id": "fr81-u357-r0035",
      "target": "— Но не для вас, отец.",
      "source_sha256": "172b7790fd1c3f9172b574e18180c1a7b974b9ff5df6c6326c4e60ac222d8062",
      "target_id": "ru-fr81-u357-r0035",
      "tag": "prose",
      "target_sha256": "30c4c7ae53e593f3120c9fdffa92e1e19ae9da14dca8f4931e3418e65f68a065"
    },
    {
      "source_id": "fr81-u357-r0036",
      "target": "— Не называйте меня больше отцом.",
      "source_sha256": "62d4f0b30f3801da3c069bc27915e514cb5abf7f0e1b0c3bf1cde70f315f85eb",
      "target_id": "ru-fr81-u357-r0036",
      "tag": "prose",
      "target_sha256": "93fa23a821a8323a50db122f9d241242fdd4a0f6525180eecab873d9b00ac756"
    },
    {
      "source_id": "fr81-u357-r0037",
      "target": "— Как?",
      "source_sha256": "0f226dc3e018c3d3d03e159286e9ede469218d3f385d118e445a9dc5e22cd2fc",
      "target_id": "ru-fr81-u357-r0037",
      "tag": "prose",
      "target_sha256": "7e3c2541e268ce7cf1cf69ef6e86c0359bf83e6b8ce4040f8859797cbd459d8f"
    },
    {
      "source_id": "fr81-u357-r0038",
      "target": "— Называйте меня господином Жаном. Или просто Жаном, если хотите.",
      "source_sha256": "72a4fe6effb5d52f1569c410de0dbef0f9d18acce6d95dc46d8d026255239f2a",
      "target_id": "ru-fr81-u357-r0038",
      "tag": "prose",
      "target_sha256": "d2352ee510f29c1c74fbbf030a26401be6892935120b4e030bdc271ef159d0d0"
    },
    {
      "source_id": "fr81-u357-r0039",
      "target": "— Вы мне больше не отец? Я больше не Козетта? Господин Жан? Что это значит? Да это же революция какая-то! Что же случилось? Посмотрите-ка мне прямо в лицо. И вы не хотите жить с нами! И вам не нужна моя комната! Что я вам сделала? Что я вам сделала? Значит, что-то всё-таки было?",
      "source_sha256": "d83d8a6a8c10b6a9f7e0b7f468b167e099fb957306768636807f343f36974703",
      "target_id": "ru-fr81-u357-r0039",
      "tag": "prose",
      "target_sha256": "7f1ca9b6f9543632789cc8d724852b8c0e9f8bb1458d6bfe473995add7b7947b"
    },
    {
      "source_id": "fr81-u357-r0040",
      "target": "— Ничего.",
      "source_sha256": "b4dec4a3bdd364779d049eeafa00a836ee8029b5e7fd03b66c993f103d88a8d3",
      "target_id": "ru-fr81-u357-r0040",
      "tag": "prose",
      "target_sha256": "e3f85c1871f46242f187941d0f81f1c56fd3606d90062b2bf53412b1fd13d61d"
    },
    {
      "source_id": "fr81-u357-r0041",
      "target": "— Так в чём же дело?",
      "source_sha256": "40136a85391ddc63b60218bc733333938f3de1aec5ae086055d95174ddc2dbca",
      "target_id": "ru-fr81-u357-r0041",
      "tag": "prose",
      "target_sha256": "999e782ab20f88dee91c4898c9d1e1d8a9b46d3783636ba0b3eabce032c6c2ef"
    },
    {
      "source_id": "fr81-u357-r0042",
      "target": "— Всё как обычно.",
      "source_sha256": "d3faa0b77334e3448f547851aa4cf2bc70b63ee55779c538fbd785de68bfff53",
      "target_id": "ru-fr81-u357-r0042",
      "tag": "prose",
      "target_sha256": "d4e3492407ddf87a07ecc8588895ab9d334058596f87ea8183419a35eec96b54"
    },
    {
      "source_id": "fr81-u357-r0043",
      "target": "— Зачем вы меняете имя?",
      "source_sha256": "d27d5a1d844f71fe5d095fe50b1954f9fb7dd8e080a99f43c8959026950d96a7",
      "target_id": "ru-fr81-u357-r0043",
      "tag": "prose",
      "target_sha256": "05f48d78f8ac5be3c2c576a9f9c52b135f2a8c858086da1797cd6ebc038da2c8"
    },
    {
      "source_id": "fr81-u357-r0044",
      "target": "— Вы-то ведь тоже сменили своё.",
      "source_sha256": "71d58c6c5d59194c3cba4a4da3464d8fef16ef50c187dc3daa72568fd5f5cd5c",
      "target_id": "ru-fr81-u357-r0044",
      "tag": "prose",
      "target_sha256": "1f53810b42127bbfae2532aa2059f3fc135f48846f692599a63552a3c0704043"
    },
    {
      "source_id": "fr81-u357-r0045",
      "target": "Он снова улыбнулся той же улыбкой и добавил:",
      "source_sha256": "0e9f805d83c5f93d3d78290cc7efad6dd840bc595ac28e99cf25960ad9df928d",
      "target_id": "ru-fr81-u357-r0045",
      "tag": "prose",
      "target_sha256": "80fb7e5786e4b23364b05345f2400f645335b18e10c841bc42b37ac457ef4801"
    },
    {
      "source_id": "fr81-u357-r0046",
      "target": "— Раз вы госпожа Понмерси, я вполне могу быть господином Жаном.",
      "source_sha256": "1457dfb66a5c1079a7b9e8bfd12dad0e389d1a48815310ac6d301ebcdd94f8a9",
      "target_id": "ru-fr81-u357-r0046",
      "tag": "prose",
      "target_sha256": "6a4d7a62beb5e511d92d0ea1e89416ff1281bdd628f26fef7e39d397b9db6116"
    },
    {
      "source_id": "fr81-u357-r0047",
      "target": "— Я ничего не понимаю. Всё это глупо. Я спрошу у мужа разрешения, чтобы вы были господином Жаном. Надеюсь, он на это не согласится. Вы причиняете мне большую боль. У всех бывают причуды, но огорчать свою маленькую Козетту нельзя. Это нехорошо. У вас нет права быть злым, когда вы добрый.",
      "source_sha256": "0764127c3d80163cd520f92033be9de771ce7caec558761b6b90268e0ba45bbb",
      "target_id": "ru-fr81-u357-r0047",
      "tag": "prose",
      "target_sha256": "619f309ac22d394d84b257cf64b1b21231d90ea90ca7e2bc17ab71f2d4b2b771"
    },
    {
      "source_id": "fr81-u357-r0048",
      "target": "Он не ответил.",
      "source_sha256": "1700499d1af0d668eeb11f7470318f5c485ca8cfb83a6208b98f11ac13132c64",
      "target_id": "ru-fr81-u357-r0048",
      "tag": "prose",
      "target_sha256": "7ce3a8e810e08028a6697da1a79841ecc0ea7bf933eb35cdc75a4134f258ef23"
    },
    {
      "source_id": "fr81-u357-r0049",
      "target": "Она живо схватила обе его руки и непреодолимым движением, поднеся их к лицу, прижала к шее под подбородком, а это жест глубокой нежности.",
      "source_sha256": "1d12c0bb12792759247e9ccb6bc2f8ce9dbb45d18404f2797830138fedcd9ba7",
      "target_id": "ru-fr81-u357-r0049",
      "tag": "prose",
      "target_sha256": "21f4cf21c87b659bf5ca96503039b32948c23e6c118ffcb65c9523ef6e4ed602"
    },
    {
      "source_id": "fr81-u357-r0050",
      "target": "— О! — сказала она ему. — Будьте добрым!",
      "source_sha256": "75a40bd1dc6a359dda4b490bc9f8c487b01ebef3e76344ae7aba71db4c9da06a",
      "target_id": "ru-fr81-u357-r0050",
      "tag": "prose",
      "target_sha256": "aac44c03e6d79b61bd8bd4e23aaafb60b1550590b226dd024240dca57bf54fda"
    },
    {
      "source_id": "fr81-u357-r0051",
      "target": "И продолжала:",
      "source_sha256": "714bd553dfcc0b1cb4836bea4d0399b8dc8423c78bcf69d1fb6b407350a20c11",
      "target_id": "ru-fr81-u357-r0051",
      "tag": "prose",
      "target_sha256": "48b296b1b00c99316a732b48729c84a50fff63a81f63fa94e3eada3edacea86c"
    },
    {
      "source_id": "fr81-u357-r0052",
      "target": "— Вот что я называю быть добрым: быть милым, переехать сюда, здесь есть птицы, как на улице Плюме, жить с нами, оставить эту дыру на улице Вооружённого Человека, не задавать нам шарады, быть как все, обедать с нами, завтракать с нами, быть моим отцом.",
      "source_sha256": "1f14aab77f9d19c6f5f17bd31973d950d754d45d7fea86fa734ca3b9c304c448",
      "target_id": "ru-fr81-u357-r0052",
      "tag": "prose",
      "target_sha256": "bd7df4a6a36b01bef1228dd5bb8b114c80c514768e732555e18e4c6af18bb2cc"
    },
    {
      "source_id": "fr81-u357-r0053",
      "target": "Он высвободил руки.",
      "source_sha256": "0e3f451d2346f307fa1a714330ea4369d07cea92a77cd7d7ec2e14c7f0deef53",
      "target_id": "ru-fr81-u357-r0053",
      "tag": "prose",
      "target_sha256": "5baee616d024fb37f1cd0b979b06f8a301e2681093bebb7004688b208b9790ba"
    },
    {
      "source_id": "fr81-u357-r0054",
      "target": "— Вам больше не нужен отец, у вас есть муж.",
      "source_sha256": "0365bc1d175a4fd62f4dca23ea8027252ccc72778175f14840c51c753f154c71",
      "target_id": "ru-fr81-u357-r0054",
      "tag": "prose",
      "target_sha256": "418fc67834509f47ddb8ad8d972a40326e7a4ce157a64c05f44c32c34a324192"
    },
    {
      "source_id": "fr81-u357-r0055",
      "target": "Козетта вспылила.",
      "source_sha256": "642b5c6b4d089cb3d11e0e3105325c128a91920349299fb959d8020391a13bf0",
      "target_id": "ru-fr81-u357-r0055",
      "tag": "prose",
      "target_sha256": "21e5cb1de87ab9064a41b76cead26a4a33e073c42dade3f3939afe836718c000"
    },
    {
      "source_id": "fr81-u357-r0056",
      "target": "— Мне больше не нужен отец! Такие вещи, в которых нет ни капли здравого смысла, — право, даже не знаешь, что сказать!",
      "source_sha256": "e1e48d61e0de4d58c9e548bc84288d238a8faf46731fa860b5edec04e5d427dd",
      "target_id": "ru-fr81-u357-r0056",
      "tag": "prose",
      "target_sha256": "513443bf7ce00cae529642505938a41a386d31dc3313a40d355622d720b7404b"
    },
    {
      "source_id": "fr81-u357-r0057",
      "target": "— Будь здесь Туссен, — продолжал Жан Вальжан, как человек, который ищет поддержки и цепляется за любую ветку, — она первая признала бы, что у меня и вправду всегда были свои привычки. Ничего нового нет. Я всегда любил свой тёмный уголок.",
      "source_sha256": "75c3c19a0c83c7a3e3f5909ce343374e522ac53d1446e922aa5db1c4027acabc",
      "target_id": "ru-fr81-u357-r0057",
      "tag": "prose",
      "target_sha256": "e640c142acdede084438a4d07efde380f83a2727a6e8084bef391e15ed96d474"
    },
    {
      "source_id": "fr81-u357-r0058",
      "target": "— Но здесь холодно. И ничего не видно. Это просто отвратительно — хотеть быть господином Жаном. Я не хочу, чтобы вы говорили мне «вы».",
      "source_sha256": "8592124459c1ef063680ddfad83050f9efe3e2dbbbe8f9fed77eb2ab38ddfaf3",
      "target_id": "ru-fr81-u357-r0058",
      "tag": "prose",
      "target_sha256": "e451eb3a658c894fac03d10ee244f6a751671b9e2a1885f3537fb113f90211f4"
    },
    {
      "source_id": "fr81-u357-r0059",
      "target": "— Только что, по дороге сюда, — ответил Жан Вальжан, — я видел на улице Сен-Луи одну вещь. У столяра-краснодеревщика. Будь я хорошенькой женщиной, я бы купил себе этот предмет. Туалетный столик, очень хороший, нынешнего фасона. Из того, что вы называете розовым деревом, кажется. С инкрустацией. Довольно большое зеркало. Есть ящики. Красиво.",
      "source_sha256": "855568a6afcdf46885f3ca19f5ef588d28b4529d47aa75ad5d11e49347825e77",
      "target_id": "ru-fr81-u357-r0059",
      "tag": "prose",
      "target_sha256": "7a5677a92f21edf14f9186add832f7b433cbf881854badec69c6275490fd8ffc"
    },
    {
      "source_id": "fr81-u357-r0060",
      "target": "— Ух! Противный медведь! — возразила Козетта.",
      "source_sha256": "8c2f7208bc90be7df07516f45a6491bcd9fb0157ad4bb6e6211a5f201f7827a5",
      "target_id": "ru-fr81-u357-r0060",
      "tag": "prose",
      "target_sha256": "3d55e477e7668e61b030c3d3fc6820c25fe163d1d40274f5621a0976fe70573d"
    },
    {
      "source_id": "fr81-u357-r0061",
      "target": "И с высшей прелестью, стиснув зубы и раздвинув губы, она фыркнула на Жана Вальжана. Это была Грация, подражающая кошечке.",
      "source_sha256": "6eba4e36d02bed3dce0022c8ccea63386a950b92134bc15724d0db45f14ee4ea",
      "target_id": "ru-fr81-u357-r0061",
      "tag": "prose",
      "target_sha256": "1aa1909207de5a175ecb1f9e1d91cd6747d447f05fda76405730caa4bc029b33"
    },
    {
      "source_id": "fr81-u357-r0062",
      "target": "— Я в ярости, — продолжала она. — Со вчерашнего дня вы все выводите меня из себя. Я очень сержусь. Я не понимаю. Вы не защищаете меня от Мариуса. Мариус не поддерживает меня против вас. Я совсем одна. Я мило устраиваю комнату. Если бы я могла поселить туда доброго Бога, я бы его поселила. И вот моя комната остаётся у меня на руках. Мой жилец объявляет себя банкротом. Я заказываю Николетте славный маленький обед. «Не нужен ваш обед, сударыня». А мой отец Фошлеван хочет, чтобы я звала его господином Жаном и принимала в ужасном старом уродливом заплесневелом погребе, где стены обросли бородой, где вместо хрусталя пустые бутылки, а вместо занавесок паутина! Вы чудак, согласна, такой уж у вас нрав, но людям, которые женятся, дают передышку. Вам не следовало сразу же снова становиться чудаком. Вот и будете очень довольны в своей мерзкой улице Вооружённого Человека. Мне-то там было так горько! Что вы имеете против меня? Вы причиняете мне большую боль. Фи!",
      "source_sha256": "c182bb9c1ad8ba0cb58cf636a7479e72b3a9ec2a79f3d3d062ad51bf3c55ed84",
      "target_id": "ru-fr81-u357-r0062",
      "tag": "prose",
      "target_sha256": "7e2aa42504221a9580c3925cce2117d2fd4170f8d51bf5ce338c4540f65ac8af"
    }
  ],
