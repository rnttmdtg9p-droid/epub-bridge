{
  "unit": 299,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u299-r0032",
      "target": "— Куда идёшь, шалопай? — крикнул сержант.",
      "source_sha256": "a94b917f3396b5910fa2fc46c26842edff2d56344f3a26ce4542640afe265de4",
      "target_id": "ru-fr81-u299-r0032",
      "tag": "prose",
      "target_sha256": "9c10259c1314d5c3fc9014aca14c2b4a13665765c67f57aa6e8b3df13a50f5c1"
    },
    {
      "source_id": "fr81-u299-r0033",
      "target": "— Гражданин, — сказал Гаврош, — я вас ещё не называл буржуа. Почему вы меня оскорбляете?",
      "source_sha256": "446c083d9c8d8b1abdd331fb48fd693a3049194d27e5dd2cc1420c18f21c1b29",
      "target_id": "ru-fr81-u299-r0033",
      "tag": "prose",
      "target_sha256": "a9207376e22a8102884e96a024c0a45d6aa8ce8e580a891c6a0059ddf9b10ba8"
    },
    {
      "source_id": "fr81-u299-r0034",
      "target": "— Куда идёшь, пострел?",
      "source_sha256": "f7a0eb09e1f64369e6be8155a7423dc6dfaad01a5cba44658d9dd2fc940148c3",
      "target_id": "ru-fr81-u299-r0034",
      "tag": "prose",
      "target_sha256": "bcb878b8fbd435d8cf4b82bccc3a459d2465c1327689e895330a8156c6ad07bd"
    },
    {
      "source_id": "fr81-u299-r0035",
      "target": "— Милостивый государь, — продолжал Гаврош, — вчера вы, быть может, были человеком остроумным, но сегодня утром вас сместили.",
      "source_sha256": "3fddfd1202e503342cc3e3c907437fc1bf464e374c03c5b7a6c2e1cc09d7a37c",
      "target_id": "ru-fr81-u299-r0035",
      "tag": "prose",
      "target_sha256": "d183bfa46ef822283228d8ec78db4cd272c8fda4f26fc3b1b7d88eccd76388d7"
    },
    {
      "source_id": "fr81-u299-r0036",
      "target": "— Я спрашиваю, куда ты идёшь, негодяй?",
      "source_sha256": "ecc5c8f5a13a368e8205ecdaaa14b0122101590c7c822bc62308a38d37d7d0b3",
      "target_id": "ru-fr81-u299-r0036",
      "tag": "prose",
      "target_sha256": "e8588b849cfb507be3b7d7f3370ea940cb7306ce6410b4f5d931ef98adf71438"
    },
    {
      "source_id": "fr81-u299-r0037",
      "target": "Гаврош ответил:",
      "source_sha256": "dce98b36c27a493e0f79b60ba75e7b7608a76c74932c7332e3ff0b47f390fbd3",
      "target_id": "ru-fr81-u299-r0037",
      "tag": "prose",
      "target_sha256": "c70e122567519513993fc39e53fd8fab1f086bfd0abd669643cd9fd76dd24df3"
    },
    {
      "source_id": "fr81-u299-r0038",
      "target": "— Вы любезно выражаетесь. Право, на вид вам не дашь ваших лет. Вам бы продать все ваши волосы по сто франков за штуку. Вышло бы пятьсот франков.",
      "source_sha256": "22b36dffd69ddb5b3a82368b607a9c5bd018a253af68b06a033d639f7839a37d",
      "target_id": "ru-fr81-u299-r0038",
      "tag": "prose",
      "target_sha256": "658e77075dab23a44ea1ae14a02b03af6575cff110f5df8b32771814ddf016dc"
    },
    {
      "source_id": "fr81-u299-r0039",
      "target": "— Куда идёшь? куда идёшь? куда идёшь, разбойник?",
      "source_sha256": "bf95cc752f2fcdf84b2718f6c22d76348a9dc13f787cca64b955042aaa7bd6d9",
      "target_id": "ru-fr81-u299-r0039",
      "tag": "prose",
      "target_sha256": "74439b630ed7b730b88c72a1e054372e84c79296e0e44e0b2bf1ae9bbcdcd94b"
    },
    {
      "source_id": "fr81-u299-r0040",
      "target": "Гаврош отпарировал:",
      "source_sha256": "6edce17297198e211a175186feea2e559575575f76278abcf2f5e0281feb8c54",
      "target_id": "ru-fr81-u299-r0040",
      "tag": "prose",
      "target_sha256": "1239674003afe0df044e9ea393e00c2924e7db77ed257868e6c2c038196666c3"
    },
    {
      "source_id": "fr81-u299-r0041",
      "target": "— Скверные слова. Когда вам в первый раз дадут пососать, придётся получше вытереть вам рот.",
      "source_sha256": "a93c0d4631ba9cd8050add8b3ccd0f0b2cfce84e6c1579acad8ec0cd2dee5eb1",
      "target_id": "ru-fr81-u299-r0041",
      "tag": "prose",
      "target_sha256": "1ea10ceb0eaca036cfd712d667e93b0b1ea83be3421f4dca4c0d72dde4d5c86e"
    },
    {
      "source_id": "fr81-u299-r0042",
      "target": "Сержант взял штык наперевес.",
      "source_sha256": "67fd72c2010dcf06e8a1e2bed40eb4f46a27c2b653825fd6ff1f2da018eb275b",
      "target_id": "ru-fr81-u299-r0042",
      "tag": "prose",
      "target_sha256": "8db48167eb194b71aecfe69f45246b3aa67416040acb0cf314dc7031e409a4ab"
    },
    {
      "source_id": "fr81-u299-r0043",
      "target": "— Скажешь ты наконец, куда идёшь, мерзавец?",
      "source_sha256": "af61d182a6d1c291fea2c50710274bf0da6cb5c511d6f7dd437a55a0fc41e85e",
      "target_id": "ru-fr81-u299-r0043",
      "tag": "prose",
      "target_sha256": "90f8a41eee8fd09732021137bdc38885d16cfcfde79d542621760d5bdfb4ec8e"
    },
    {
      "source_id": "fr81-u299-r0044",
      "target": "— Мой генерал, — сказал Гаврош, — я иду за лекарем для моей хозяйки, у неё роды.",
      "source_sha256": "e973299dafb5d568153320a30794dda109d8289e9cc3f2cb27ab4443611b9819",
      "target_id": "ru-fr81-u299-r0044",
      "tag": "prose",
      "target_sha256": "ed4a7e9306c9f995c8eea9740a411b06e731663a0585ba74373409fac3936552"
    },
    {
      "source_id": "fr81-u299-r0045",
      "target": "— К оружию! — крикнул сержант.",
      "source_sha256": "7bdb59b507c36716e524e62c06fb42f2cc9b21361c6a03164a08ddd47c0c4ce7",
      "target_id": "ru-fr81-u299-r0045",
      "tag": "prose",
      "target_sha256": "154ec7d1ef031ba7e77bce6ca61ac801e5b91d44389a856a962e40a25c01d224"
    },
    {
      "source_id": "fr81-u299-r0046",
      "target": "Спастись тем, что тебя погубило, — вот шедевр сильных людей; Гаврош одним взглядом оценил всё положение. Тележка его скомпрометировала — тележке и надлежало его защитить.",
      "source_sha256": "5c532a357ff651cd7ed21793a602de56769c75ab50ecb1069b57abc403fe4c10",
      "target_id": "ru-fr81-u299-r0046",
      "tag": "prose",
      "target_sha256": "e39c52b61c63661028c56200844f8829570db8c9ad0412240a4499d7df76c380"
    },
    {
      "source_id": "fr81-u299-r0047",
      "target": "В тот миг, когда сержант готов был броситься на Гавроша, тележка, ставшая снарядом и пущенная во всю силу рук, с яростью покатилась на него, и сержант, пораженный прямо в живот, упал навзничь в канаву, а его ружьё выстрелило в воздух.",
      "source_sha256": "0476959aa5e7230f026ad008eecc2f131b0bb63f0f100b502670b56725a08951",
      "target_id": "ru-fr81-u299-r0047",
      "tag": "prose",
      "target_sha256": "6b4b42738749fcf35e604694e608083625e5b245dba9f487449fed3b9f1b3611"
    },
    {
      "source_id": "fr81-u299-r0048",
      "target": "На крик сержанта люди из караула выскочили вперемешку; ружейный выстрел вызвал всеобщий беспорядочный залп наугад, после которого ружья перезарядили и принялись палить снова.",
      "source_sha256": "478186acf3443c34e4e7b448d03f528ee055ca7e88ed96cc1c53bacdcbafe006",
      "target_id": "ru-fr81-u299-r0048",
      "tag": "prose",
      "target_sha256": "9b56e10e423b9d63960d25b633d68e6fddf803b47622b68c84e492c5653af416"
    },
    {
      "source_id": "fr81-u299-r0049",
      "target": "Эта мушкетная жмурка длилась добрую четверть часа и убила несколько оконных стёкол.",
      "source_sha256": "e8f58b0a8317e6b038ac74379c77dc6e3606c19b8c05a6ce88c99751ccb33148",
      "target_id": "ru-fr81-u299-r0049",
      "tag": "prose",
      "target_sha256": "705eb370ad0003e998c2ac14c786df1f03ce9e8320b7eef83f7b45ba48c70d11"
    },
    {
      "source_id": "fr81-u299-r0050",
      "target": "Между тем Гаврош, опрометью повернувший назад, остановился в пяти-шести улицах оттуда и, задыхаясь, сел на тумбу на углу Анфан-Руж.",
      "source_sha256": "91f9eee6cab9eb8b98860db33f3aa35cfb934fafcdeb000433dda1a0dcdd328c",
      "target_id": "ru-fr81-u299-r0050",
      "tag": "prose",
      "target_sha256": "50b7a6c7dce97eac12916e7769205b0d170343303e81e263bbf8062893e86006"
    },
    {
      "source_id": "fr81-u299-r0051",
      "target": "Он прислушивался.",
      "source_sha256": "6d4eb9fe8513de136097fc122856c04bf2fc1ff80463462833ac056b0b2435de",
      "target_id": "ru-fr81-u299-r0051",
      "tag": "prose",
      "target_sha256": "bf404d99cfde0590a4951ea257f0faddf0239646aa4eb1ccd3f0d0011e6a82e5"
    },
    {
      "source_id": "fr81-u299-r0052",
      "target": "Отдышавшись несколько мгновений, он повернулся в ту сторону, где неистовствовала пальба, поднёс левую руку на уровень носа и трижды выбросил её вперёд, ударяя правой рукой себя по затылку; державный жест, в котором парижское мальчишество сгустило французскую иронию и который, очевидно, действен, раз длится уже полвека.",
      "source_sha256": "200e3e6c98e0251c3ba59c0affb94377f9038a7a350e46ca77b527e718b37ae7",
      "target_id": "ru-fr81-u299-r0052",
      "tag": "prose",
      "target_sha256": "cd09e154b403eda358fb49edb05f38283187c5a5bb3d8cbdf2997af06a9b69cb"
    },
    {
      "source_id": "fr81-u299-r0053",
      "target": "Эту весёлость омрачило горькое размышление.",
      "source_sha256": "50cdd213b56a1b6ea5ee7dfca83f6a00ac4bdcec44722362408cb035a27d435a",
      "target_id": "ru-fr81-u299-r0053",
      "tag": "prose",
      "target_sha256": "6acbe2756147a218b050e2d4552b9ce46cf2cbab3120651dd3224885c7480472"
    },
    {
      "source_id": "fr81-u299-r0054",
      "target": "— Да, — сказал он, — я хохочу, я корчусь, я купаюсь в радости, но сбиваюсь с дороги, придётся делать крюк. Лишь бы поспеть к баррикаде!",
      "source_sha256": "fd554be6846b0b15b2f2bc66d990604a44bd9a3809de782beb347bcd62b8e776",
      "target_id": "ru-fr81-u299-r0054",
      "tag": "prose",
      "target_sha256": "6d795c6510764b1edbdb33a4d16cd29ba6098f1f9ced02e897d18abc57f5cf05"
    },
    {
      "source_id": "fr81-u299-r0055",
      "target": "С этими словами он снова пустился бежать.",
      "source_sha256": "ffb4eaf0468f3802d5ecf11be151a9c6a437f3a8e20c810def307c879ff5814f",
      "target_id": "ru-fr81-u299-r0055",
      "tag": "prose",
      "target_sha256": "c28efec0fd33bfb81e23507b05d82b2a6ccb82f56354ef6cfd8ae332455a4ced"
    },
    {
      "source_id": "fr81-u299-r0056",
      "target": "И на бегу:",
      "source_sha256": "249e909697501ac2ed4a812fa1e5ad8544e75eebb6756dfe3cea9b2beef153ec",
      "target_id": "ru-fr81-u299-r0056",
      "tag": "prose",
      "target_sha256": "f0e3ed026739cc606e9eac79619bde7c350339b62221ff69311a2f59c8923608"
    },
    {
      "source_id": "fr81-u299-r0057",
      "target": "— А ну-ка, на чём же я остановился? — сказал он.",
      "source_sha256": "634baeffdc56b36f4b381bb547ae0a024dce4553e107a58240bac9ed51c747d1",
      "target_id": "ru-fr81-u299-r0057",
      "tag": "prose",
      "target_sha256": "a40ac623289f050ecbe17dadf0fa25c7c29de4fdc5c6f8007a15436761e75121"
    },
    {
      "source_id": "fr81-u299-r0058",
      "target": "Он опять запел свою песню, быстро углубляясь в улицы, и вот что затихло во мраке:",
      "source_sha256": "25840f2f87087f469d6c911d70c8232a7156ed9b34d461045e189c9b2fa4e1fb",
      "target_id": "ru-fr81-u299-r0058",
      "tag": "prose",
      "target_sha256": "031d9ad7e9897f60624ff2e6eb8cfd9d7dd55a3bfeaa0193a2777a549b19f876"
    },
    {
      "source_id": "fr81-u299-r0059",
      "target": "Но есть ещё немало бастилий,\n\nИ я положу конец\n\nВот этому общественному порядку.\n\nКуда идут красотки,\n\nЛон ла.\n\n\n\nКто хочет сыграть в кегли?\n\nВесь старый мир рухнул,\n\nКогда покатился тяжёлый шар.\n\nКуда идут красотки,\n\nЛон ла.\n\n\n\nСтарый добрый народ, костылями\n\nРазнесём этот Лувр, где красовалась\n\nМонархия в оборках.\n\nКуда идут красотки,\n\nЛон ла.\n\n\n\nМы выломали его решётки;\n\nКороль Карл Десятый в тот день\n\nДержался худо и отклеился.\n\nКуда идут красотки,\n\nЛон ла.",
      "source_sha256": "66025ebc033cd2ffe5d2bd4acbb08143555aa0ac3ac53ab513a3d2766fad8f15",
      "target_id": "ru-fr81-u299-r0059",
      "tag": "table_cell",
      "target_sha256": "56166122dd7c069ef4dac2554b2864e61aafa12f39f16575a9ee80e11560afb6"
    },
    {
      "source_id": "fr81-u299-r0060",
      "target": "Тревога в карауле не осталась без последствий. Тележка была захвачена, пьяница взят в плен. Первую отвели на полицейский двор; второго позднее слегка преследовали перед военными советами как соучастника. Тогдашняя прокуратура явила в этом случае своё неутомимое рвение в защите общества.",
      "source_sha256": "f85cbdd13fa1339016d0bdd1b6ee5f684ecaf47ae779ccc77ae2a5c24641084d",
      "target_id": "ru-fr81-u299-r0060",
      "tag": "prose",
      "target_sha256": "8312313680e0d1cc2458be577fa1f7298ee4146203f36e15488b378720088efe"
    },
    {
      "source_id": "fr81-u299-r0061",
      "target": "Приключение Гавроша, сохранившееся в преданиях квартала Тампль, — одно из самых страшных воспоминаний старых буржуа Марэ и озаглавлено в их памяти так: Ночное нападение на караул Королевской типографии.",
      "source_sha256": "0aca0ee5551b93c4eac369e96615a0270ab4ca0f6f404b87d0d8cb81df1785ce",
      "target_id": "ru-fr81-u299-r0061",
      "tag": "prose",
      "target_sha256": "aef258ccffda1fce655b52edd2815a225bb684f9cd55ac4c273527f6cc213462"
    }
  ],
