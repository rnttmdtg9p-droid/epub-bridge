    },
    {
      "source_id": "fr81-u101-r0225",
      "target": "В этом сабо ничего не было.",
      "source_sha256": "bd5cc239fd173d38b988d22466caf7a59fd3f8208365897d7cba59938e3157b0",
      "target_id": "ru-fr81-u101-r0225",
