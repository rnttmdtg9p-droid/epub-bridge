    },
    {
      "source_id": "fr81-u101-r0226",
      "target": "Незнакомец пошарил в жилете, нагнулся и положил в сабо Козетты золотой луидор.",
      "source_sha256": "4f7622c8bcec20d3171c411ae7339e98f7048f69e9b19e2a11ccc78b3b6b6f1e",
      "target_id": "ru-fr81-u101-r0226",
      "tag": "prose",
      "target_sha256": "7c958592b9129148ac486c8a6968edef5c6e9a4bdde6b9d25aa346de51544df5"
    },
    {
      "source_id": "fr81-u101-r0227",
      "target": "Затем он крадучись, неслышными шагами вернулся в свою комнату.",
      "source_sha256": "87bd8dfee00743aa37525979a3282840231a4c64b00b65501bbe80351a96a64b",
      "target_id": "ru-fr81-u101-r0227",
