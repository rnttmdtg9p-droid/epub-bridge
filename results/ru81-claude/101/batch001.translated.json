{
  "unit": 101,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u101-r0032",
      "target": "— Я стучала, сударыня.",
      "source_sha256": "642abaaeb551fd1b4753915716c8c1a90940375fa092efd70126448078ef55b3",
      "target_id": "ru-fr81-u101-r0032",
      "tag": "prose",
      "target_sha256": "2e207b944611559f39c315dc80719c2ada5d0a1581ba7cd8abe09fd7f8947b1f"
    },
    {
      "source_id": "fr81-u101-r0033",
      "target": "— Ну и что?",
      "source_sha256": "4950a516c968f0619fb8b95afe126297c80c72d6fe6348e65ea081818635e18f",
      "target_id": "ru-fr81-u101-r0033",
      "tag": "prose",
      "target_sha256": "c3c7c847be433d2b02af850bdfcfd0e3734a843506123820fd38a33c0d05ab04"
    },
    {
      "source_id": "fr81-u101-r0034",
      "target": "— Он не открыл.",
      "source_sha256": "dd0c8b0f49fb3a1a7bfb07a47413ddec006016a66f19e2682f35a0d4dd88e919",
      "target_id": "ru-fr81-u101-r0034",
      "tag": "prose",
      "target_sha256": "303fde6b110f676c2bf3cb74aa871cb13606f2d975a5c32b2eea33db6c1dfc2d"
    },
    {
      "source_id": "fr81-u101-r0035",
      "target": "— Завтра узнаю, правда ли это, — сказала Тенардье, — и если ты лжёшь, тебе зададут славную трёпку. А пока верни мне монету в пятнадцать су.",
      "source_sha256": "fd4199518861ce48ae154f4d1a0bca057a4d52d64f919abc80c0b358f51ac3a8",
      "target_id": "ru-fr81-u101-r0035",
      "tag": "prose",
      "target_sha256": "b6c6c5d764cb520b07b737323155ae2d150d4952c255e8f8d42de06d5804e302"
    },
    {
      "source_id": "fr81-u101-r0036",
      "target": "Козетта сунула руку в карман передника и позеленела. Монеты в пятнадцать су там не было.",
      "source_sha256": "27ef49f83970212512c6524c50c56c21df72de8f5ddd4a8633e1503c87fc7388",
      "target_id": "ru-fr81-u101-r0036",
      "tag": "prose",
      "target_sha256": "ac112c3567c0267b171f4e118934ce7b63d2c7e7cd193bd1503fd79bda60cc0f"
    },
    {
      "source_id": "fr81-u101-r0037",
      "target": "— Ах ты! — сказала Тенардье. — Ты слышала меня?",
      "source_sha256": "5aae3dc57dec33d627985b35340b42d5cdc4b7de797142c6e5320aa71ca531ff",
      "target_id": "ru-fr81-u101-r0037",
      "tag": "prose",
      "target_sha256": "85dc8e178d1579a5806a96ed50587549fbb82280c8aa475590004d2a877474b5"
    },
    {
      "source_id": "fr81-u101-r0038",
      "target": "Козетта вывернула карман. Там ничего не было. Куда могли деться эти деньги? Несчастная малютка не нашла ни слова. Она окаменела.",
      "source_sha256": "0650c687d00ce2a9b3eda5941f9bbd4fd627b8db5add5dfbd5814d050375f3cd",
      "target_id": "ru-fr81-u101-r0038",
      "tag": "prose",
      "target_sha256": "74e400184b48375337f5448145ff4f2d42e2952339a3cb9b572e1bb9639b2c26"
    },
    {
      "source_id": "fr81-u101-r0039",
      "target": "— Ты её потеряла, эту монету в пятнадцать су? — прохрипела Тенардье. — Или хочешь меня обокрасть?",
      "source_sha256": "14164027ffa13bfcbfd573a02e967569188a29526067a5bf1b3f29fbf95a1ff2",
      "target_id": "ru-fr81-u101-r0039",
      "tag": "prose",
      "target_sha256": "f3d9d46372967c605da8e747b746fc0e8c533ed813110595fdfd0f47343a760c"
    },
    {
      "source_id": "fr81-u101-r0040",
      "target": "В то же время она протянула руку к плётке, висевшей в углу у камина.",
      "source_sha256": "74e5658cba81f39e5484d45dcb7f6978ae3a396a4fa4997290a83503f596db4a",
      "target_id": "ru-fr81-u101-r0040",
      "tag": "prose",
      "target_sha256": "1f0bd1c0fd96761f03970a01f0f2056bc26fb3ab0e84618a8213905b1ea13e42"
    },
    {
      "source_id": "fr81-u101-r0041",
      "target": "Этот грозный жест вернул Козетте силу кричать:",
      "source_sha256": "1f22178a18ac007031a93da38894a53e4c6815c332c70761ff05c85988a81833",
      "target_id": "ru-fr81-u101-r0041",
      "tag": "prose",
      "target_sha256": "2e8d8b5e099d2049e7eca63c5c7ee00b5f09bfbb5613f23cd0ace83046f08f17"
    },
    {
      "source_id": "fr81-u101-r0042",
      "target": "— Пощадите! Сударыня! Сударыня! Я больше не буду!",
      "source_sha256": "7d797127569c0dae1bfff7c1c3510011ea71c4775cd33675488fcd47a748c30f",
      "target_id": "ru-fr81-u101-r0042",
      "tag": "prose",
      "target_sha256": "38439217a6f0125e131ed8801bfdcb6dfa662143ff8ce65068257ac52550d07a"
    },
    {
      "source_id": "fr81-u101-r0043",
      "target": "Тенардье сняла плётку.",
      "source_sha256": "b3cff8f8de7cccb5b848dc469cf12106c962d92ca0095f45af2f237733254fc8",
      "target_id": "ru-fr81-u101-r0043",
      "tag": "prose",
      "target_sha256": "46261f8920d8ed7cc544844b48d620f4fc9ffe3751eab66b1e4fbb522c3ebeb9"
    },
    {
      "source_id": "fr81-u101-r0044",
      "target": "Между тем человек в жёлтом сюртуке пошарил в жилетном кармане, и никто не заметил этого движения. Впрочем, остальные проезжие пили или играли в карты и ни на что не обращали внимания.",
      "source_sha256": "6ff6a1819ef10c3ca9b2e2c3eecc740ee9e485e43e1fb01c776a50af32618baa",
      "target_id": "ru-fr81-u101-r0044",
      "tag": "prose",
      "target_sha256": "1b565df1df8effe6632a07255f9e83981348b1642ad04d625d0e310f37bd15dc"
    },
    {
      "source_id": "fr81-u101-r0045",
      "target": "Козетта с тоской съёжилась в углу у камина, стараясь собрать и спрятать свои бедные полуобнажённые члены. Тенардье подняла руку.",
      "source_sha256": "be20dc47ddb477d2cb71fd1fb22e1b9eb5bea42f12e836ed71be9fa6bc7e92d8",
      "target_id": "ru-fr81-u101-r0045",
      "tag": "prose",
      "target_sha256": "44ffe74ab080b6f59c29c3dd7472d089676b9a9ce5facb27e6568b88eae85b47"
    },
    {
      "source_id": "fr81-u101-r0046",
      "target": "— Простите, сударыня, — сказал человек, — но только что я видел, как из кармана передника этой девочки что-то выпало и покатилось. Может быть, это оно.",
      "source_sha256": "3b3f1f8de46d966593bf06e793cc63b2498fe96634401ce1d4d41cf70acb802f",
      "target_id": "ru-fr81-u101-r0046",
      "tag": "prose",
      "target_sha256": "a43922a608f70dcd9cddedd55abc139b02c051f44bd0517003634486b1ff454c"
    },
    {
      "source_id": "fr81-u101-r0047",
      "target": "Одновременно он наклонился и некоторое время как будто искал на полу.",
      "source_sha256": "f8ad956125530047f46a82d05ef33350ca859fd8ed57330cf1951b9c0e39c739",
      "target_id": "ru-fr81-u101-r0047",
      "tag": "prose",
      "target_sha256": "e1fb2bcae7a3ee0073d24f4fa5c236eb1974b8c1d28549e93e77e26829f18fd5"
    },
    {
      "source_id": "fr81-u101-r0048",
      "target": "— Так и есть, вот, — продолжал он, выпрямляясь.",
      "source_sha256": "668c76d5543d62aa80a8951b5d442a51e069267ab840e913cd384a11d920fce3",
      "target_id": "ru-fr81-u101-r0048",
      "tag": "prose",
      "target_sha256": "cb7cc638546e5d974b68a626ed46136cd8a4bdae3b0bb43455a7a3aefa460e0f"
    },
    {
      "source_id": "fr81-u101-r0049",
      "target": "И он протянул Тенардье серебряную монету.",
      "source_sha256": "5b34a34a9f48c7a6c9fce525150c100b75e24c2e485de587bcd46dc53f763f0c",
      "target_id": "ru-fr81-u101-r0049",
      "tag": "prose",
      "target_sha256": "01ce8a8c22f5863916322cb5cf8fc673224184e5e7753b681d4f25c08f8ad528"
    },
    {
      "source_id": "fr81-u101-r0050",
      "target": "— Да, она самая, — сказала та.",
      "source_sha256": "4321952d2eba050bb4634e053d719fbe765358cb43cb92820ffc9b70e84b33f4",
      "target_id": "ru-fr81-u101-r0050",
      "tag": "prose",
      "target_sha256": "0b867418aab7a10e88199a3fa4e70d3382996fcdbf08d3fa8fcd604b77278c94"
    },
    {
      "source_id": "fr81-u101-r0051",
      "target": "Это была не она, потому что это была монета в двадцать су, но Тенардье видела в этом выгоду. Она положила монету в карман и ограничилась тем, что бросила на ребёнка свирепый взгляд, сказав: — Смотри, чтоб это больше не повторялось!",
      "source_sha256": "a5c512946b13692e094504ad5ae0b509198a2f11734d84627e536ca039867cf1",
      "target_id": "ru-fr81-u101-r0051",
      "tag": "prose",
      "target_sha256": "4a7da207866b49fe463e2529399e8f6b80cde2ca36d43bc7745ced62cde36580"
    },
    {
      "source_id": "fr81-u101-r0052",
      "target": "Козетта вернулась в то, что Тенардье называла «её конурой», и её большие глаза, устремлённые на незнакомого путника, стали принимать выражение, какого у них никогда не бывало. Это было пока лишь простодушное удивление, но к нему примешивалось своего рода изумлённое доверие.",
      "source_sha256": "9d5e0c1a8e8179e7dc6ea56195e438360bd19120f6ded30e1a7ef5ea3fff35b0",
      "target_id": "ru-fr81-u101-r0052",
      "tag": "prose",
      "target_sha256": "bd47bed38a3695b45bbf0949947a7af8a861c6eced5aff9aa907a717f6a3837b"
    },
    {
      "source_id": "fr81-u101-r0053",
      "target": "— Кстати, не желаете ли поужинать? — спросила Тенардье путника.",
      "source_sha256": "dd6bd62a4f1ed7c7476183b1c319cb12ad4703abcc751a58d56c127b2afa4e9f",
      "target_id": "ru-fr81-u101-r0053",
      "tag": "prose",
      "target_sha256": "b77fea7e541becdd87e1f57a02bf3c3c8b1597596c24e75e313a6ced1cc1a343"
    },
    {
      "source_id": "fr81-u101-r0054",
      "target": "Он не ответил. Казалось, он глубоко задумался.",
      "source_sha256": "0ed2a2111844aa23f5008f84c90be2ce8f03eb06b0e6c14d63ac2b07a6625e16",
      "target_id": "ru-fr81-u101-r0054",
      "tag": "prose",
      "target_sha256": "061f5e6fafe90e35c9c7717bcda489de5505facf3dc86371dd42cf46172a2ff9"
    },
    {
      "source_id": "fr81-u101-r0055",
      "target": "— Что это за человек? — проворчала она сквозь зубы. — Какой-то жалкий нищий. У него нет ни гроша на ужин. Заплатит ли он хоть за ночлег? Ему и то повезло, что он не придумал украсть деньги, которые лежали на полу.",
      "source_sha256": "88e13575d412f83f04b455e9abc816e212b94eb6b980a39a9768c83d7c9cab83",
      "target_id": "ru-fr81-u101-r0055",
      "tag": "prose",
      "target_sha256": "123cb4d96c051b4ac6c6722e9079578e2dec18cd5d0b3c39446b1154b12c11f6"
    },
    {
      "source_id": "fr81-u101-r0056",
      "target": "Между тем дверь отворилась, и вошли Эпонина и Азельма.",
      "source_sha256": "694458a7d65cd33ac278c2142d3a8d50a01282f7a7267597ab0f03236e0d3e8e",
      "target_id": "ru-fr81-u101-r0056",
      "tag": "prose",
      "target_sha256": "cf9609384ffa485e1c594b679ffd51725fb15e32e69ffcb7b4bd2c3ca4aef07f"
    },
    {
      "source_id": "fr81-u101-r0057",
      "target": "Это были в самом деле две хорошенькие девочки, скорее городского, чем деревенского вида, очень милые: одна с лоснящимися каштановыми косами, другая с длинными чёрными косами, падавшими на спину; обе живые, опрятные, пухленькие, свежие и здоровые на радость глазу. Они были тепло одеты, но с такой материнской искусностью, что плотность тканей ничуть не вредила щегольству наряда. Зима была предусмотрена, но весна не стёрта. От этих двух малышек исходил свет. Кроме того, они царствовали. В их нарядах, в их веселье, в шуме, который они производили, было что-то державное. Когда они вошли, Тенардье сказала им ворчливым тоном, полным обожания: — А, вот и вы, негодницы!",
      "source_sha256": "58263d43f7d7c21e56eef084015b6c49a406db2c618781a174b308d80b4a599d",
      "target_id": "ru-fr81-u101-r0057",
      "tag": "prose",
      "target_sha256": "57b732b4312064fbc2ffdacecfa34aeb2d1c8d329fc66b3f1d8d1e4968a65f63"
    },
    {
      "source_id": "fr81-u101-r0058",
      "target": "Потом, притягивая их к себе на колени одну за другой, приглаживая им волосы, перевязывая ленты и затем отпуская их с той мягкой встряской, какая свойственна матерям, она воскликнула: — До чего разряжены!",
      "source_sha256": "97d0e646d39bd681a49f23a1a68f0e28d5a267961d43f28ddf27357a97a13718",
      "target_id": "ru-fr81-u101-r0058",
      "tag": "prose",
      "target_sha256": "10965671de63d42c7eb36d33f7b8ca851b997533c9eb784f60d88d304e922686"
    },
    {
      "source_id": "fr81-u101-r0059",
      "target": "Они уселись у огня. У них была кукла, которую они вертели и переворачивали на коленях с разнообразным радостным лепетом. Время от времени Козетта поднимала глаза от вязанья и мрачно смотрела на их игру.",
      "source_sha256": "54c1f2dac90dd55dbf97fe2bf8cce924df6dd4ec357d34889f14304f66ca2206",
      "target_id": "ru-fr81-u101-r0059",
      "tag": "prose",
      "target_sha256": "6e69ee504870aa54b681998a0b1475814e3fc7ec743d64552613c74b6c5787ed"
    },
    {
      "source_id": "fr81-u101-r0060",
      "target": "Эпонина и Азельма не смотрели на Козетту. Для них она была как собака. Этим трём девочкам не было и двадцати четырёх лет на всех, а они уже воплощали всё человеческое общество: с одной стороны зависть, с другой презрение.",
      "source_sha256": "642f99e2b5ef2cc72bdbee64a144ddda5fc77e5e5cfedb15a3612ec0be5788a1",
      "target_id": "ru-fr81-u101-r0060",
      "tag": "prose",
      "target_sha256": "a784964593610eb3218d170f37ab847575301f7197993cd5552657a290629c84"
    },
    {
      "source_id": "fr81-u101-r0061",
      "target": "Кукла сестёр Тенардье была очень выцветшая, очень старая и вся поломанная, но тем не менее казалась Козетте восхитительной: она за всю свою жизнь не имела куклы, [[I]]настоящей куклы[[/I]], чтобы воспользоваться выражением, которое поймут все дети.",
      "source_sha256": "7d4ac63de079892fed72a8918140ddc5c603f8628875e09ce2d0088c8fea2179",
      "target_id": "ru-fr81-u101-r0061",
      "tag": "prose",
      "target_sha256": "598cb74010634bc7b2642d2dd60e2619a06a9f9361a2755cfc41643f1897a4e2"
    },
    {
      "source_id": "fr81-u101-r0062",
      "target": "Вдруг Тенардье, продолжавшая ходить взад и вперёд по зале, заметила, что Козетта рассеянна и что вместо работы она занята играющими малышками.",
      "source_sha256": "578892eb4084393ce26858f21cd4b6d2f25d37aa569d768d1403006f769ae20f",
      "target_id": "ru-fr81-u101-r0062",
      "tag": "prose",
      "target_sha256": "540174ecb2160bf9e71f95b32b8c6f1c71218e55e024e3e1fb91639169bec2a7"
    },
    {
      "source_id": "fr81-u101-r0063",
      "target": "— А, вот я тебя и поймала! — закричала она. — Так-то ты работаешь! Я заставлю тебя работать плёткой!",
      "source_sha256": "ff10d6effcebceaf34c0fb32b55a3c35080a939b26545283332410993a78115e",
      "target_id": "ru-fr81-u101-r0063",
      "tag": "prose",
      "target_sha256": "80aa91ed9950c52c34fe5d01e5730e6d6baa16439e5e594c29bbe6daccdf3c7d"
    }
  ],
