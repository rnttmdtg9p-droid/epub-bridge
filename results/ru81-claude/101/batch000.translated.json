{
  "unit": 101,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u101-h",
      "target": "VIII Неудобство принимать у себя бедняка, который, быть может, богач",
      "source_sha256": "6fff53e3ec182d4ec0a7b27c8e8ffbac1c62de6e207b97ac835d810f34aa5d93",
      "target_id": "ru-fr81-u101-h",
      "tag": "heading",
      "target_sha256": "d6b24a7b485c40f01b86476ea899d9094cc3206ac6a4487d1b8d61af84e2e35b"
    },
    {
      "source_id": "fr81-u101-r0001",
      "target": "Козетта не удержалась и бросила косой взгляд на большую куклу, всё так же выставленную напоказ у торговца игрушками, потом постучала. Дверь отворилась. Появилась Тенардье со свечой в руке.",
      "source_sha256": "c0748403e8e1cd63942cd98adf9a5b93d986983b750143112ba78ef30b31ea28",
      "target_id": "ru-fr81-u101-r0001",
      "tag": "prose",
      "target_sha256": "e9531e6e49da202eeceed041fb96497c571681d6412ea53f9606a5a382a4ce1a"
    },
    {
      "source_id": "fr81-u101-r0002",
      "target": "— А, это ты, дрянная девчонка! Слава богу, не торопилась! Небось развлекалась, мерзавка!",
      "source_sha256": "1675c0cd207e0b67a2deff5533a7c6fd04e7c803363354fff5c497abd7ff4de5",
      "target_id": "ru-fr81-u101-r0002",
      "tag": "prose",
      "target_sha256": "509dedcdb8815a35acc34bcf1ac5071bfaf3a7ce78dff4dc14ebb8e90e5988c2"
    },
    {
      "source_id": "fr81-u101-r0003",
      "target": "— Сударыня, — сказала Козетта, вся дрожа, — вот господин, он хочет у нас остановиться.",
      "source_sha256": "eb03429fdb413b2dec8ff5558578ee3fd34521d1895a3fc3d3ea86ac83711d7f",
      "target_id": "ru-fr81-u101-r0003",
      "tag": "prose",
      "target_sha256": "39be1d7f7cbb0c654be54009009703ed164ce7fa8f5eca64eec1ac24f690a0a5"
    },
    {
      "source_id": "fr81-u101-r0004",
      "target": "Тенардье поспешно заменила свою угрюмую мину любезной гримасой — эта мгновенная перемена свойственна всем трактирщикам — и жадно поискала глазами новоприбывшего.",
      "source_sha256": "4fc1b04932df910e38f177d42aab5b8fee241bc94bd52f68197f3db41df8984e",
      "target_id": "ru-fr81-u101-r0004",
      "tag": "prose",
      "target_sha256": "69e261ce2edc6431157d39144e7b922871cb30fe1288a9f026db4e915c61f24f"
    },
    {
      "source_id": "fr81-u101-r0005",
      "target": "— Этот господин? — спросила она.",
      "source_sha256": "76f7d92bf548793608e6b4accdb6e078b7972386de8971425fe025e5c2bab6fb",
      "target_id": "ru-fr81-u101-r0005",
      "tag": "prose",
      "target_sha256": "a92eb824a316416b79b8d5ad07793b9290aa244d741ad92f083fa421bcb1ec38"
    },
    {
      "source_id": "fr81-u101-r0006",
      "target": "— Да, сударыня, — ответил человек, поднося руку к шляпе.",
      "source_sha256": "c01a4f99d0ace11704d9d8c7d84ad59102d7a0c9520916b771f546e9fdee4616",
      "target_id": "ru-fr81-u101-r0006",
      "tag": "prose",
      "target_sha256": "66fe9ec9852d968f8c997f513b70820dd12609b13829f06d7e78bfa87599e95b"
    },
    {
      "source_id": "fr81-u101-r0007",
      "target": "Богатые путешественники не бывают так вежливы. Этот жест, а затем осмотр одежды и поклажи незнакомца, который Тенардье окинула одним взглядом, согнали любезную гримасу и вернули угрюмую мину. Она сухо продолжала:",
      "source_sha256": "71113ab13cc304f821c916182f176345436a8d8cdbf8989ee107ad2f44abef48",
      "target_id": "ru-fr81-u101-r0007",
      "tag": "prose",
      "target_sha256": "4515bc8ae0324798549ac96378f5483d088650b219732006babcce74eb74a917"
    },
    {
      "source_id": "fr81-u101-r0008",
      "target": "— Входите, любезный.",
      "source_sha256": "ad176ef14f12e0bf8fd4cb9b97ab1116b36c6f063950b648dff4f8580bd34c2b",
      "target_id": "ru-fr81-u101-r0008",
      "tag": "prose",
      "target_sha256": "30668deca7696cd2222e6738af68f4779b6e537a54e111c8e0aabb25da2a7d3a"
    },
    {
      "source_id": "fr81-u101-r0009",
      "target": "«Любезный» вошёл. Тенардье бросила на него второй взгляд, особенно внимательно оглядела его сюртук, совершенно истёртый, и шляпу, слегка помятую, и посоветовалась с мужем, который всё ещё пил с возчиками, — кивком головы, морщиной на носу и подмигиванием. Муж ответил едва заметным движением указательного пальца, которое, подкреплённое оттопыренными губами, означает в таких случаях: полная нищета. После этого Тенардье воскликнула:",
      "source_sha256": "e919bddf3277c6833c91f9a198e5f241fe92c4ce01755e39eda61ccf04bcab74",
      "target_id": "ru-fr81-u101-r0009",
      "tag": "prose",
      "target_sha256": "e668cb94cb16bf603e1cdedf758be9bd6d2d2083d7099b8c6300a527f4cdcca1"
    },
    {
      "source_id": "fr81-u101-r0010",
      "target": "— Послушайте, добрый человек, мне очень жаль, но у меня больше нет места.",
      "source_sha256": "459fb0eb8e66a81f79af58f8c6ef08b2fc5511458cce01e1c0697ffc97690711",
      "target_id": "ru-fr81-u101-r0010",
      "tag": "prose",
      "target_sha256": "b5bed0cd1f3594eda45e1c70dcb5ca6ccd7c3c4f9b851b8d7b0ceb5ed689e2a3"
    },
    {
      "source_id": "fr81-u101-r0011",
      "target": "— Положите меня где хотите, — сказал человек, — на чердаке, в конюшне. Я заплачу, как за комнату.",
      "source_sha256": "d378dbc150064e7d4af3d3518ea7f8cb081bfc20ccf6e1d2905f0e48af64546b",
      "target_id": "ru-fr81-u101-r0011",
      "tag": "prose",
      "target_sha256": "75c52b099b77fc4c3b2026e1c8575fc0bda826067c0e91091a915251a434b356"
    },
    {
      "source_id": "fr81-u101-r0012",
      "target": "— Сорок су.",
      "source_sha256": "04e3027e061952bc14956d9a6953e90ae64b84bbb82a57f6e1a16133266252c1",
      "target_id": "ru-fr81-u101-r0012",
      "tag": "prose",
      "target_sha256": "5b1d4fdd0bc0790016446ce380b38bb17cd0a277a425610d5d4deb066b130faf"
    },
    {
      "source_id": "fr81-u101-r0013",
      "target": "— Сорок су. Хорошо.",
      "source_sha256": "5727644a43f085b88bc654ba9ef8d04f467e94b978241bd6d4813ff5a01727f9",
      "target_id": "ru-fr81-u101-r0013",
      "tag": "prose",
      "target_sha256": "41682d667604c6308bdbfcfa865f2b97e16bcce1ed80b05fac752325f541f071"
    },
    {
      "source_id": "fr81-u101-r0014",
      "target": "— Вот это другое дело.",
      "source_sha256": "87b137ef9385094ba7b024c12f2d1238cb37ae8eec9c19d763a9e08e3e2b461e",
      "target_id": "ru-fr81-u101-r0014",
      "tag": "prose",
      "target_sha256": "4eeacdb4dc4d7e0a26cc4b7e9ca98938671609a442717d0ca65d4c0b28546dcb"
    },
    {
      "source_id": "fr81-u101-r0015",
      "target": "— Сорок су! — тихо сказал Тенардье один из возчиков. — Да это ведь всего двадцать су.",
      "source_sha256": "2525014987c14b48c36d124b31fa157a311a97b236fd6308ecd3a93696402edd",
      "target_id": "ru-fr81-u101-r0015",
      "tag": "prose",
      "target_sha256": "00563e16805a575d5f5b04f9b7c05956da2ff8952eb0ad07b7034ade1d5037b3"
    },
    {
      "source_id": "fr81-u101-r0016",
      "target": "— С него — сорок су, — возразила Тенардье тем же тоном. — Бедняков я дешевле не пускаю.",
      "source_sha256": "a1fa337fd020aca2bee7016f17576a160f3fc04127753cd0378d16d4397bce33",
      "target_id": "ru-fr81-u101-r0016",
      "tag": "prose",
      "target_sha256": "58dc0061a2f02cb6bbd36597feca5c88b23519d21bed51204abdcca6121359d3"
    },
    {
      "source_id": "fr81-u101-r0017",
      "target": "— Это верно, — мягко добавил муж, — дому вред, когда в нём живёт такой народ.",
      "source_sha256": "e9dee20e3e55396a2e0cdb19a9ff97879e8627c3b63338442c78b0d3266f945e",
      "target_id": "ru-fr81-u101-r0017",
      "tag": "prose",
      "target_sha256": "f7004b274c3781859a97b7dfdd8de2aae77c69f64a9066a7c28d6610f984027b"
    },
    {
      "source_id": "fr81-u101-r0018",
      "target": "Между тем человек, оставив на лавке свой узел и палку, сел за стол, на который Козетта поспешила поставить бутылку вина и стакан. Торговец, спрашивавший ведро воды, сам пошёл отнести его своей лошади. Козетта вернулась на своё место под кухонным столом, к своему вязанью.",
      "source_sha256": "2e8407181761339c828fb9be5aee3be1dace2c3bf225737c6e37b31ffca5284b",
      "target_id": "ru-fr81-u101-r0018",
      "tag": "prose",
      "target_sha256": "d87e04e92dfa3473002f7ce02318567fb00c16d243d157f3d1d3922dd0715287"
    },
    {
      "source_id": "fr81-u101-r0019",
      "target": "Человек, едва омочивший губы в стакане налитого себе вина, смотрел на ребёнка с каким-то странным вниманием.",
      "source_sha256": "cd702f019f9ed673bf54aaba1d97d0f2668e449683d7198ecf2538d95f895a75",
      "target_id": "ru-fr81-u101-r0019",
      "tag": "prose",
      "target_sha256": "f9c5e5a1f11566ea9c1e46d9613b1ad50f636d3fcf2ff7f049393dd922edfcbb"
    },
    {
      "source_id": "fr81-u101-r0020",
      "target": "Козетта была некрасива. Будь она счастлива, она, быть может, была бы миловидна. Мы уже набросали этот маленький мрачный облик. Козетта была худа и бледна; ей было около восьми лет, но ей едва дали бы шесть. Её большие глаза, запавшие в какую-то тень, почти погасли оттого, что она так много плакала. Уголки её рта изгибались так, как изгибаются они от постоянной муки у приговорённых и у безнадёжно больных. Руки её, как угадала мать, были «сплошь в ознобышах». Огонь, освещавший её в эту минуту, выставлял напоказ углы её костей и делал её худобу ужасающе заметной. Так как она вечно дрожала от холода, у неё вошло в привычку плотно сжимать колени. Всё её одеяние было лишь лохмотьем, которое вызвало бы жалость летом, а зимою внушало ужас. На ней была одна дырявая холстина, ни клочка шерсти. Кое-где виднелась её кожа, и повсюду на ней различались синие или чёрные пятна, указывавшие места, где её касалась рука Тенардье. Голые ноги были красны и тонки. Ямки над ключицами вызывали слёзы. Всё существо этого ребёнка, её повадка, осанка, звук голоса, промежутки между словами, взгляд, молчание, малейший жест выражали и передавали одну-единственную мысль: страх.",
      "source_sha256": "79eeadf15382b89bce2b92528e86dbb35a6aca2772810132b9588da5a31e6c2a",
      "target_id": "ru-fr81-u101-r0020",
      "tag": "prose",
      "target_sha256": "caf29035d995dbff49a1d7936461e5b48bcd06b2f764ee10bc7d12d4eec4ab5f"
    },
    {
      "source_id": "fr81-u101-r0021",
      "target": "Страх был разлит по ней; она была, так сказать, покрыта им; страх прижимал её локти к бёдрам, прятал пятки под юбки, заставлял её занимать как можно меньше места, оставлял ей лишь самое необходимое дыхание и стал тем, что можно назвать привычкой её тела, не способной меняться иначе, как только возрастая. В глубине её зрачка был изумлённый уголок, где обитал ужас.",
      "source_sha256": "dcd3d42d0ed158db79e382ed09be153ad61dcf5a24b78145693d223186d277b8",
      "target_id": "ru-fr81-u101-r0021",
      "tag": "prose",
      "target_sha256": "c0420bd665f7601751d442733c97a73cf133a3f9cce15a4fd7eb67025e8ae55a"
    },
    {
      "source_id": "fr81-u101-r0022",
      "target": "Страх этот был таков, что, придя, вся мокрая, как была, Козетта не посмела пойти обсушиться у огня и молча принялась за свою работу.",
      "source_sha256": "0c1e891aa48e203e9ac416d3ed823cebb5c779efc2d25caea9b9aefc521ca6a2",
      "target_id": "ru-fr81-u101-r0022",
      "tag": "prose",
      "target_sha256": "e06472ca192e9e75ced05da3339a8cbd56deae6df03b98faa28b4f8e973d773b"
    },
    {
      "source_id": "fr81-u101-r0023",
      "target": "Выражение взгляда этой восьмилетней девочки было обычно так мрачно, а порой так трагично, что в иные минуты казалось, будто она вот-вот станет идиоткой или демоном.",
      "source_sha256": "12bd4fa9a46f6a7c7ce3a57a7a4eac940185d66b67323bfc717aac192d3c35a4",
      "target_id": "ru-fr81-u101-r0023",
      "tag": "prose",
      "target_sha256": "3df628a116e3aad5023ffc34172c08d95d9ed0ea15059eb61a583cd5c9f3316c"
    },
    {
      "source_id": "fr81-u101-r0024",
      "target": "Никогда, как мы сказали, она не знала, что такое молиться, никогда не ступала ногой в церковь. — Разве у меня есть время? — говорила Тенардье.",
      "source_sha256": "f0c6fccba777546b12f6bbaad45ddc61451bb5645bd96281b1505a81609a300a",
      "target_id": "ru-fr81-u101-r0024",
      "tag": "prose",
      "target_sha256": "ae057e3034906c098005203f065abd3108fd11c8e8d671f386a931ab71771706"
    },
    {
      "source_id": "fr81-u101-r0025",
      "target": "Человек в жёлтом сюртуке не спускал глаз с Козетты.",
      "source_sha256": "290fa7cec013223209b6d0b029e50c2ed5651b76bfb3641f307e9ec6392d21d3",
      "target_id": "ru-fr81-u101-r0025",
      "tag": "prose",
      "target_sha256": "b1471d7dbf42c2b2a4274bdac5d10650d961e6c5738773ccb537a1b04a29def9"
    },
    {
      "source_id": "fr81-u101-r0026",
      "target": "Вдруг Тенардье вскричала:",
      "source_sha256": "7d020294a9192bceb7fe5f066b956075ee42ac116af413620015ac9a572743c5",
      "target_id": "ru-fr81-u101-r0026",
      "tag": "prose",
      "target_sha256": "bbd727fb245a374c15970384ffd3e606fd59c039cb9d208cb615a0985e59a033"
    },
    {
      "source_id": "fr81-u101-r0027",
      "target": "— Кстати! А хлеб?",
      "source_sha256": "a84ddbcfd8d5090d85f11ecf129c1351dfcf6485d257d50193afc99b69313d1e",
      "target_id": "ru-fr81-u101-r0027",
      "tag": "prose",
      "target_sha256": "0d6a4c70d15d49bccbcf68fa29a46ec5e3f3ac9328e085b333723a24230ce612"
    },
    {
      "source_id": "fr81-u101-r0028",
      "target": "Козетта, по своему обыкновению всякий раз, когда Тенардье повышала голос, тотчас выскочила из-под стола.",
      "source_sha256": "2efdf3777b84ddb82f9b5af40462367fd33e88539274e1875558fc75e66b349b",
      "target_id": "ru-fr81-u101-r0028",
      "tag": "prose",
      "target_sha256": "17031a83260e86a3d924832aa5d3cf1e93e7c496c4e842f3cef49bc32920f60e"
    },
    {
      "source_id": "fr81-u101-r0029",
      "target": "Она совершенно забыла про этот хлеб. Она прибегла к уловке вечно запуганных детей. Она солгала.",
      "source_sha256": "17812ca25fb2a0892bbe0ef78799beffa37a5d9effed5c75d35292037731c69f",
      "target_id": "ru-fr81-u101-r0029",
      "tag": "prose",
      "target_sha256": "85dfdbec9b05a64a482dd651ffdda93a714754876a951c62f4677df62dc7386b"
    },
    {
      "source_id": "fr81-u101-r0030",
      "target": "— Сударыня, булочная была закрыта.",
      "source_sha256": "7f8110fdd62af025834f20ff238d8b49dc8722f2312f82d614a72317bca3a40d",
      "target_id": "ru-fr81-u101-r0030",
      "tag": "prose",
      "target_sha256": "862f93eae847a1bf33f7ab31343fbdf93165c2a4540a0014ba2b72f9d98b6cb5"
    },
    {
      "source_id": "fr81-u101-r0031",
      "target": "— Надо было постучать.",
      "source_sha256": "110694faa7aed6cfee8d5034f088e096482677179926efa922aa4894b3946c5c",
      "target_id": "ru-fr81-u101-r0031",
      "tag": "prose",
      "target_sha256": "8686522485bb42979c15b4202c6030b6bfb93c45470973c016f64d5d33d627ab"
    }
  ],
