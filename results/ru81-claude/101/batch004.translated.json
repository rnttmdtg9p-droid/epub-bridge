{
  "unit": 101,
  "batch": 4,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u101-r0128",
      "target": "Эпонина встала и, не выпуская кошку, подошла к матери и принялась дёргать её за юбку.",
      "source_sha256": "fdec06266e47365d4d32a792047695e56b95fbf294e28618018969d6f8b615b5",
      "target_id": "ru-fr81-u101-r0128",
      "tag": "prose",
      "target_sha256": "ae4f56b55a3efbcbf609114611f9429c5137c8a3f0b1917904f217d1f8f453ba"
    },
    {
      "source_id": "fr81-u101-r0129",
      "target": "— Да оставь ты меня! — сказала мать. — Чего тебе?",
      "source_sha256": "3c8a035820b1f1e78e044a462d079417458d3d91baa1c5b8c7acb7008b71a0b6",
      "target_id": "ru-fr81-u101-r0129",
      "tag": "prose",
      "target_sha256": "bb92d4d3afd286efa66293455bbb72cdb9d71eb20b820d7d79bad431aaca5ddc"
    },
    {
      "source_id": "fr81-u101-r0130",
      "target": "— Мама, — сказала девочка, — да посмотри же!",
      "source_sha256": "b8329c7d072dc794d8c06379a1f8800b75875b1f9552ba8975e463eaff7c28b6",
      "target_id": "ru-fr81-u101-r0130",
      "tag": "prose",
      "target_sha256": "440b2e9d3cf6494614b1e58b0c0dd1b831e9cafbfdbfd070b7f6b082a35f3a00"
    },
    {
      "source_id": "fr81-u101-r0131",
      "target": "И она указала пальцем на Козетту.",
      "source_sha256": "077b6f46bd9f6f0be84abe6f2754c46c2642efd3afad8f337d9d3e3de23b3e7a",
      "target_id": "ru-fr81-u101-r0131",
      "tag": "prose",
      "target_sha256": "fc6f33d01fecd01bf8c3d0d97e54ba295d8b7843dabbce7262b96f18e7b7935e"
    },
    {
      "source_id": "fr81-u101-r0132",
      "target": "Козетта же, целиком отдавшись восторгам обладания, уже ничего не видела и не слышала.",
      "source_sha256": "99f02a658078b867484d159362d1c17de954c2e4184126bc8548531a00ef6b07",
      "target_id": "ru-fr81-u101-r0132",
      "tag": "prose",
      "target_sha256": "6c3d420f26efe3d113817836e8baee9fed16d331d7a63632ba79eaef5014c5cd"
    },
    {
      "source_id": "fr81-u101-r0133",
      "target": "Лицо Тенардье приняло то особенное выражение, которое составляется из ужасного, смешанного с мелочами жизни, и за которое женщин такого рода прозвали мегерами.",
      "source_sha256": "41c1752fd93983691d3492dce4c5871cc3eda5245199ee21155c3c9134892092",
      "target_id": "ru-fr81-u101-r0133",
      "tag": "prose",
      "target_sha256": "90f449fe1c25eda9ea4dc931f6481d47dbe86896de7f1b1769da3200ff4f6d01"
    },
    {
      "source_id": "fr81-u101-r0134",
      "target": "На этот раз уязвлённая гордость ещё сильнее разжигала её гнев. Козетта перешагнула все расстояния, Козетта посягнула на куклу «барышень».",
      "source_sha256": "678f00845eb2796ba252fa8ff89c7e068f1f17b22cf80f442d0b63dcfc6aeff7",
      "target_id": "ru-fr81-u101-r0134",
      "tag": "prose",
      "target_sha256": "88350c7d4e12e9120df74e4a3a0744a51077ca5096eb2f3c250f859f3fb91037"
    },
    {
      "source_id": "fr81-u101-r0135",
      "target": "Царица, увидев, как мужик примеривает большую голубую ленту её державного сына, не приняла бы иного вида.",
      "source_sha256": "7759707cea9f69220876b8484496d98fbeedb3caa0e35b46daec1047f98aaa69",
      "target_id": "ru-fr81-u101-r0135",
      "tag": "prose",
      "target_sha256": "0ea1bae43eaebb09408edc7802611e30040a0f610f77c634779865909cfe75bf"
    },
    {
      "source_id": "fr81-u101-r0136",
      "target": "Она закричала голосом, охрипшим от негодования:",
      "source_sha256": "d135afdbd0d73c77ab55b8076e86c8cefeea39da3c785bc0c58c4dc0a38a8bd2",
      "target_id": "ru-fr81-u101-r0136",
      "tag": "prose",
      "target_sha256": "707123cfdf878296be0cfbdee2926df59454b9bbee1477e0d167dac000f49ed0"
    },
    {
      "source_id": "fr81-u101-r0137",
      "target": "— Козетта!",
      "source_sha256": "54354a7d4db8e4a783dc12f91446b4252569fbf94d27d2ef5b5b83c4a19efeaf",
      "target_id": "ru-fr81-u101-r0137",
      "tag": "prose",
      "target_sha256": "3335eef8c81e1151516d1b6f52656cdc7cac3100ac9573c438292fa54a797174"
    },
    {
      "source_id": "fr81-u101-r0138",
      "target": "Козетта вздрогнула, словно земля заколебалась у неё под ногами. Она обернулась.",
      "source_sha256": "78fba3bb63ed2ddc808eecaa92fbbe54bad219b33d39a212062e566f72b5b767",
      "target_id": "ru-fr81-u101-r0138",
      "tag": "prose",
      "target_sha256": "561436ddd1c9ced10afb3ad1d16212297c749ad95ff2e0aaef61029cbfa255a8"
    },
    {
      "source_id": "fr81-u101-r0139",
      "target": "— Козетта! — повторила Тенардье.",
      "source_sha256": "012b769efe4147bef3b2c3923f92a516b631ab9436740f8b5e12b0945ac7148d",
      "target_id": "ru-fr81-u101-r0139",
      "tag": "prose",
      "target_sha256": "3c8ce73deb4d57a733ce4433ea6f388f040ce5d255979c9a5259e10202a6ce06"
    },
    {
      "source_id": "fr81-u101-r0140",
      "target": "Козетта взяла куклу и осторожно положила её на пол с каким-то благоговением, смешанным с отчаянием. Затем, не спуская с неё глаз, она сложила руки и — что страшно говорить о ребёнке такого возраста — стала их заламывать; и тогда, чего не смогло вырвать у неё ни одно из волнений этого дня, ни бег по лесу, ни тяжесть ведра с водой, ни потеря денег, ни вид плети, ни даже мрачные слова, которые она слышала от Тенардье, — она заплакала. Она разразилась рыданиями.",
      "source_sha256": "f5914c4fd62dd5114bec140a6f6b1ff336974d56ac922176b70fe236df2014ff",
      "target_id": "ru-fr81-u101-r0140",
      "tag": "prose",
      "target_sha256": "71ce52dfc63756a20baeeb37854e53737fc2f5fbbda8e16254e5ce0bca361bab"
    },
    {
      "source_id": "fr81-u101-r0141",
      "target": "Между тем путник встал.",
      "source_sha256": "9bf71c59a39c06da7cb9e0014211d7d0af99193f275b8b9c0763bc66fe27f3fd",
      "target_id": "ru-fr81-u101-r0141",
      "tag": "prose",
      "target_sha256": "6752e6919a758dfef4598487ad51b4a8f068e3a17abe64d2745a9788493fe720"
    },
    {
      "source_id": "fr81-u101-r0142",
      "target": "— Что это такое? — спросил он Тенардье.",
      "source_sha256": "d944e74086c2d769f8318026ed31a4bd2ad7e8213fcba10d4876225c94a78aaf",
      "target_id": "ru-fr81-u101-r0142",
      "tag": "prose",
      "target_sha256": "d80d337732f8f484eb8dd2b524436f77cd4ab388f29c478122460cc0bb1ebc73"
    },
    {
      "source_id": "fr81-u101-r0143",
      "target": "— Разве вы не видите? — сказала Тенардье, указывая пальцем на вещественное доказательство, лежавшее у ног Козетты.",
      "source_sha256": "1de8f988833357cdc65519ca6f74cae43f5a84b0f085db4968086d9c099c544f",
      "target_id": "ru-fr81-u101-r0143",
      "tag": "prose",
      "target_sha256": "b158839aea0b5c24dd531ff3169a26144f4f0ad0c27422c1091c1ee010d80048"
    },
    {
      "source_id": "fr81-u101-r0144",
      "target": "— Ну и что же? — продолжал мужчина.",
      "source_sha256": "8731d1e53593395b9a6bf6cf42e7e35c1066e4afc54d56ecaa91d7707bb04418",
      "target_id": "ru-fr81-u101-r0144",
      "tag": "prose",
      "target_sha256": "5d46c790751c5df4c576122ae857bcec7c23f2f88b2b7390fa03c38304742e09"
    },
    {
      "source_id": "fr81-u101-r0145",
      "target": "— Эта дрянь, — ответила Тенардье, — позволила себе дотронуться до куклы моих детей!",
      "source_sha256": "2a9c3c3a75e1c6b4743c73bab7563c3c180fe54fc3c52a82f97bee6aa836ed24",
      "target_id": "ru-fr81-u101-r0145",
      "tag": "prose",
      "target_sha256": "63d1b789a37c92426f9b31a2a51dbe3f851a7069459fc59935f4304cf78c21f1"
    },
    {
      "source_id": "fr81-u101-r0146",
      "target": "— Столько шума из-за этого! — сказал мужчина. — Ну так что же, если бы она и поиграла этой куклой?",
      "source_sha256": "4750c23a8eb9653d0b82743a4858f00bc1a49275578f6c1f84495808b1cff47f",
      "target_id": "ru-fr81-u101-r0146",
      "tag": "prose",
      "target_sha256": "a058b9489c09c7cc7410f860d38800ca984e9467e33f8e68dbd7127850a1b69a"
    },
    {
      "source_id": "fr81-u101-r0147",
      "target": "— Она трогала её своими грязными руками! — продолжала Тенардье. — Своими мерзкими руками!",
      "source_sha256": "1bea99a854009cc64106029873fea2296c636913c0cb93590039e94470db5e83",
      "target_id": "ru-fr81-u101-r0147",
      "tag": "prose",
      "target_sha256": "f6a78d2af191b0017ea4740a85d9e8c6a5b79e057c7daee05ca673647876f53c"
    },
    {
      "source_id": "fr81-u101-r0148",
      "target": "Тут Козетта зарыдала ещё сильнее.",
      "source_sha256": "93fbbb0d8e56c69e30aac32939bfb7b8646e556e63dc4e212004a9ca0ef007ba",
      "target_id": "ru-fr81-u101-r0148",
      "tag": "prose",
      "target_sha256": "b1fcae5e3693a634fdfcb99c95f5fc18a6a75114175570f251f4ab0c63e46d72"
    },
    {
      "source_id": "fr81-u101-r0149",
      "target": "— Замолчишь ты или нет! — крикнула Тенардье.",
      "source_sha256": "41465b07b828d359c9f8f299732a2ecb3f631ff25bbe0f8c2cecf509a69e3652",
      "target_id": "ru-fr81-u101-r0149",
      "tag": "prose",
      "target_sha256": "f373efe79f08e2b311f02026bc8df95af0e82ba3f1a5f17bbeaebc5884fc87a5"
    },
    {
      "source_id": "fr81-u101-r0150",
      "target": "Мужчина прямо направился к уличной двери, открыл её и вышел.",
      "source_sha256": "29f717453c0d2bfa3cc60439630f9dea6b3494295507d0f8e760376348e9f76e",
      "target_id": "ru-fr81-u101-r0150",
      "tag": "prose",
      "target_sha256": "1e8414f883156db83dd582608f80499e269b7b604c7ad9db3edea116a61bee9d"
    },
    {
      "source_id": "fr81-u101-r0151",
      "target": "Как только он вышел, Тенардье воспользовалась его отсутствием и под столом отвесила Козетте такой сильный пинок, что ребёнок закричал во весь голос.",
      "source_sha256": "efca96c9a8f15038a5b8b2911952a09476df1faecb7a59805f4efd70fb1f3619",
      "target_id": "ru-fr81-u101-r0151",
      "tag": "prose",
      "target_sha256": "7334c17cf8ccd08fac388be920198ba90637913124165fccb36da194a0ebd155"
    },
    {
      "source_id": "fr81-u101-r0152",
      "target": "Дверь отворилась, мужчина появился снова; он нёс в обеих руках ту сказочную куклу, о которой мы говорили и на которую с самого утра глазели все ребятишки деревни, и поставил её перед Козеттой, говоря:",
      "source_sha256": "983a311c39b9f8e7ac8fb06dc00334ee48195cde257da47970575a4146a78d3c",
      "target_id": "ru-fr81-u101-r0152",
      "tag": "prose",
      "target_sha256": "cd60d09beb5621f23b2c8cdfb31d6afa186511aff9ce7efc1d9fd65668e8788d"
    },
    {
      "source_id": "fr81-u101-r0153",
      "target": "— Вот, это тебе.",
      "source_sha256": "acdda907d7ce2dc7501ee5d6ec95ccf074bd7b3c100bd1fdbe82eac44faafab2",
      "target_id": "ru-fr81-u101-r0153",
      "tag": "prose",
      "target_sha256": "25ef36b773ebe814e9d56a13a02d3943038047a52668d899198e3d39cdfc22c9"
    },
    {
      "source_id": "fr81-u101-r0154",
      "target": "Надо полагать, что за тот час с лишним, который он провёл здесь, посреди своей задумчивости, он смутно заметил эту лавку безделушек, освещённую фонарями и свечами так великолепно, что она виднелась сквозь стекло трактира, как иллюминация.",
      "source_sha256": "836b76b3158be44b04a2521ceba3c9c80f002bc58307e849938e3b602d6fece0",
      "target_id": "ru-fr81-u101-r0154",
      "tag": "prose",
      "target_sha256": "11474a81002e8cf0de2cffeb5d5a121e910678ffbfdaba3c7c554d0070d75156"
    },
    {
      "source_id": "fr81-u101-r0155",
      "target": "Козетта подняла глаза; она видела, как этот человек шёл к ней с куклой, так, как увидела бы шествие солнца; она услышала неслыханные слова: [[I]]это тебе[[/I]]; она посмотрела на него, посмотрела на куклу, потом медленно отступила и забилась в самую глубину под столом, в угол у стены.",
      "source_sha256": "1530cafc6794b18ca113d164aab9b54655ba11bd77670f35f3140328bb39bdc6",
      "target_id": "ru-fr81-u101-r0155",
      "tag": "prose",
      "target_sha256": "ecb4627c82962870304d6415f292b75bcef2875afe17292b5663b58a6306285d"
    },
    {
      "source_id": "fr81-u101-r0156",
      "target": "Она больше не плакала, больше не кричала; казалось, она больше не смела дышать.",
      "source_sha256": "b88c829f1b96cb12e08d478d2af703b8d7a7c81c6b17a04e4cd0468225d0ed42",
      "target_id": "ru-fr81-u101-r0156",
      "tag": "prose",
      "target_sha256": "34999d2922a403aef4c79d25959af2caf2e21bf7f649959cae482c2604267f7b"
    },
    {
      "source_id": "fr81-u101-r0157",
      "target": "Тенардье, Эпонина, Азельма были точно статуи. Даже пьяницы остановились. Во всём трактире наступила торжественная тишина.",
      "source_sha256": "5660c4afc798db68c6ccb2bf79b1a6a42a741a7a258888a43f5314c82f256aa3",
      "target_id": "ru-fr81-u101-r0157",
      "tag": "prose",
      "target_sha256": "25a27fa019ae7c6c544096066e41c9086aabbc08176f6ed63f82fde89529576b"
    },
    {
      "source_id": "fr81-u101-r0158",
      "target": "Тенардье, окаменевшая и немая, принялась снова строить догадки: «Что это за старик? Бедняк он или миллионер? Может быть, и то и другое, то есть вор».",
      "source_sha256": "03391a32cf78f6772b23e05479c13aa3c187c0eefa80f422493ae5f10461d5c2",
      "target_id": "ru-fr81-u101-r0158",
      "tag": "prose",
      "target_sha256": "222349896a777868fdab50676665483f683d9c5f6031226934c231b24187c2e1"
    },
    {
      "source_id": "fr81-u101-r0159",
      "target": "На лице мужа Тенардье обозначилась та выразительная складка, которая подчёркивает человеческое лицо всякий раз, когда господствующий инстинкт проступает в нём со всей своей звериной силой. Трактирщик поочерёдно оглядывал куклу и путника; он как будто вынюхивал этого человека, как вынюхивал бы мешок с деньгами. Это длилось лишь миг. Он подошёл к жене и тихо сказал:",
      "source_sha256": "f557fe052fa032f9b21fbcde37d39764e64099c254529aee0ce1cccef18b0191",
      "target_id": "ru-fr81-u101-r0159",
      "tag": "prose",
      "target_sha256": "4cfaff5025cbd931493b1321076ebd4167de347751b24a3ee6b51530cc6c15d7"
    }
  ],
