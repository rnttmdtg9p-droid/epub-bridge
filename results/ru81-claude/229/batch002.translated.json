{
  "unit": 229,
  "batch": 2,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u229-r0064",
      "target": "— И ещё семь.",
      "source_sha256": "c93ddb92217afe83c56a5f6f4e65a1bdde1bd21f1e66818e966e3ada9369af46",
      "target_id": "ru-fr81-u229-r0064",
      "tag": "prose",
      "target_sha256": "89102eee57afd7cdb2db619d78161dfed2b1f704f6216b3320ed11dbb8224001"
    },
    {
      "source_id": "fr81-u229-r0065",
      "target": "— Это у меня двадцать два. (Задумчиво.) Двадцать два!",
      "source_sha256": "1b698a1f080c00f5b04711b4ff71b3bcaed882f0f56140c1c5b6195c16c4d9c2",
      "target_id": "ru-fr81-u229-r0065",
      "tag": "prose",
      "target_sha256": "5086759d7fc44433b02d64a7f233dbb7f446360ed0c288c343e30b9844a049ab"
    },
    {
      "source_id": "fr81-u229-r0066",
      "target": "— Ты не ждал дубль-шесть. Выложи я его в начале, вся игра пошла бы иначе.",
      "source_sha256": "a764c7540f8ea9ff855b2f58638deae111cbf3354b479732cc6e17f3c0766231",
      "target_id": "ru-fr81-u229-r0066",
      "tag": "prose",
      "target_sha256": "712f1f14829dbf8c0dba9ebc8f3205ff1acfd09b7f320642d12f5729a235b8ec"
    },
    {
      "source_id": "fr81-u229-r0067",
      "target": "— Тогда двойку.",
      "source_sha256": "ad4054cc9dca6a45dcf1d8547e791b3d170d9de6af631db3798cd6ddd9b6d9dc",
      "target_id": "ru-fr81-u229-r0067",
      "tag": "prose",
      "target_sha256": "49267a4f824d5ce9a318a01dea41ccdcfd41487d19f3ff342e81249a9aafbc41"
    },
    {
      "source_id": "fr81-u229-r0068",
      "target": "— Единицу.",
      "source_sha256": "78a9f9d21a4ab0481ebe53d30844442f127649d55bfa4b1afe70f62057645880",
      "target_id": "ru-fr81-u229-r0068",
      "tag": "prose",
      "target_sha256": "67073e92c11719871bf091977b47808d6cf7cbc9c4a8adf6797067432fb93c19"
    },
    {
      "source_id": "fr81-u229-r0069",
      "target": "— Единицу! Ну, тогда пятёрку.",
      "source_sha256": "bad9bf0061149e0eea26d12b522aaf42ed8be86828b337fda97ecb2459f259a9",
      "target_id": "ru-fr81-u229-r0069",
      "tag": "prose",
      "target_sha256": "b332175914a6937174e14f22eef0d9a8eaaabc263a871bff4db2a58a003674df"
    },
    {
      "source_id": "fr81-u229-r0070",
      "target": "— У меня нет.",
      "source_sha256": "6c7aa457c784d790575e00a9d8101d259e9bf42b3d96e4bd313ebb0de75c37b9",
      "target_id": "ru-fr81-u229-r0070",
      "tag": "prose",
      "target_sha256": "dfd0b98899828712e4289416670dcdac777bc294b469fbed689d8ae4ef8e15cf"
    },
    {
      "source_id": "fr81-u229-r0071",
      "target": "— Кажется, ты ходил первым?",
      "source_sha256": "68d4ac4d4f2f49655828a7a04fbae391b25cc02f48be403c4dc7813892a272ae",
      "target_id": "ru-fr81-u229-r0071",
      "tag": "prose",
      "target_sha256": "15958c32cddea388f0291bb2b0d06b34d867f300dcce1f7978d9198abe520179"
    },
    {
      "source_id": "fr81-u229-r0072",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u229-r0072",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u229-r0073",
      "target": "— Пусто.",
      "source_sha256": "f4166d185bdf979da54923f35f84fc660c7e55bba1de511d47636cde8464db34",
      "target_id": "ru-fr81-u229-r0073",
      "tag": "prose",
      "target_sha256": "50428f892f7bda4b576bf0d37535723fc8865991a8c87a121c6441ae3506e83d"
    },
    {
      "source_id": "fr81-u229-r0074",
      "target": "— Ну и везёт ему! Ах, до чего тебе везёт! (Долго раздумывает.) Двойка.",
      "source_sha256": "8f5c3cbb03a0a877c9ff47318de3fcda17742f2a5ba97d45d343db7d5ede9816",
      "target_id": "ru-fr81-u229-r0074",
      "tag": "prose",
      "target_sha256": "bf0120315707c73b87b621323b6756090a3d813eb5234ece7226a5eba737ceda"
    },
    {
      "source_id": "fr81-u229-r0075",
      "target": "— Единица.",
      "source_sha256": "78a9f9d21a4ab0481ebe53d30844442f127649d55bfa4b1afe70f62057645880",
      "target_id": "ru-fr81-u229-r0075",
      "tag": "prose",
      "target_sha256": "13836d00793fb20ca3e0559516446c3c351acb002f69d85a3dbcba521311860a"
    },
    {
      "source_id": "fr81-u229-r0076",
      "target": "— Ни пятёрки, ни единицы. Досадно тебе.",
      "source_sha256": "982bbb488e42ac77e422df60f8dcaea867e18fa7125ffe2bb5e5f9de81c74937",
      "target_id": "ru-fr81-u229-r0076",
      "tag": "prose",
      "target_sha256": "68a93558dd516587e8e99f0d8ecd2093c0e96c4cffac409154547643c4eecee9"
    },
    {
      "source_id": "fr81-u229-r0077",
      "target": "— Домино.",
      "source_sha256": "3cd8bb3a8ce8eb862fa3ca1658ba1e7db4ff9fbbff1625d3683a6a735151ceab",
      "target_id": "ru-fr81-u229-r0077",
      "tag": "prose",
      "target_sha256": "ee3c6baaa1ba512afd8e94d52ef29ad5984a94e995ed727f1cf0ca70be754989"
    },
    {
      "source_id": "fr81-u229-r0078",
      "target": "— Тысяча чертей!",
      "source_sha256": "7832afcd4343f8b2a5f547797e258ec43a22026668b89febe8a37350ef1563f7",
      "target_id": "ru-fr81-u229-r0078",
      "tag": "prose",
      "target_sha256": "1db7c269e9c09681073eab70ec528dcfa202ffd68381d9faf0f293ac5a4601d7"
    }
  ],
