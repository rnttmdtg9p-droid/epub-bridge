{
  "unit": 229,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u229-r0032",
      "target": "— Ты!",
      "source_sha256": "673afd7097ebbe9ee118a676e4c3b171f7bd9ec9162cc8dd30b4b99ba160dae8",
      "target_id": "ru-fr81-u229-r0032",
      "tag": "prose",
      "target_sha256": "ee9986a00d287952638f785efad944b875a924951083c20bba8a1dbcf47d6a1e"
    },
    {
      "source_id": "fr81-u229-r0033",
      "target": "— Я. Но мне не отдают должного. Когда я берусь за дело, я страшен. Я читал Прюдома, знаю «Общественный договор», знаю наизусть мою конституцию II года. «Свобода гражданина кончается там, где начинается свобода другого гражданина». Неужели ты принимаешь меня за скота? У меня в ящике лежит старый ассигнат. Права человека, суверенитет народа, черт возьми! Я даже немного эбертист. Я могу шесть часов кряду, по часам, пережёвывать великолепные вещи.",
      "source_sha256": "61f802129b58b06bf7a0540fb489854333d11ea93dcc3adeb377c8ed8e77b547",
      "target_id": "ru-fr81-u229-r0033",
      "tag": "prose",
      "target_sha256": "762e334b2c9be8b9343d00acfad6b832f70f54bba7cd785a9627aa87468ee40e"
    },
    {
      "source_id": "fr81-u229-r0034",
      "target": "— Будь серьёзен, — сказал Анжольрас.",
      "source_sha256": "9077009941f9cfc0e1561918b716ec57d79528909c0d2b38591b83bbdd6f6216",
      "target_id": "ru-fr81-u229-r0034",
      "tag": "prose",
      "target_sha256": "0fe01d7497ebfd57e83a07919258731b9c126223aa430e95955647f0473ce025"
    },
    {
      "source_id": "fr81-u229-r0035",
      "target": "— Я свиреп, — ответил Грантер.",
      "source_sha256": "b6d3cc58871468f91cd86fc1f83f06db7d3b059107c92d5c9e11132f16e4a762",
      "target_id": "ru-fr81-u229-r0035",
      "tag": "prose",
      "target_sha256": "6f0a2e4da18cda166d43e94766c7494cc554b09d879dd0defa3a1592cd76babd"
    },
    {
      "source_id": "fr81-u229-r0036",
      "target": "Анжольрас подумал несколько секунд и сделал жест человека, принявшего решение.",
      "source_sha256": "c44def66b93a1329875d0c7dbdfce4f998c89c30ef06738df11fde538ad52766",
      "target_id": "ru-fr81-u229-r0036",
      "tag": "prose",
      "target_sha256": "dbb92dbafa0d513fa764838fc82672f359861494cba4ad1ad4cd645800721a40"
    },
    {
      "source_id": "fr81-u229-r0037",
      "target": "— Грантер, — сказал он серьёзно, — я согласен тебя испытать. Ты пойдёшь на заставу Мен.",
      "source_sha256": "3e70065bbb0bac506bb180c114ed46d22f77415bee554f404abe4d1da621e2a4",
      "target_id": "ru-fr81-u229-r0037",
      "tag": "prose",
      "target_sha256": "3f82550e334e0b38cf269a1d12ff76720105a5ebce70b4a4f55521a3b9685ddf"
    },
    {
      "source_id": "fr81-u229-r0038",
      "target": "Грантер жил в меблированных комнатах совсем рядом с кафе Мюзен. Он вышел и вернулся минут через пять. Он ходил к себе надеть жилет à la Робеспьер.",
      "source_sha256": "95edd0987ac9e1a64f2061127d5954cc5225423343489b4c1aa89b6c764ef625",
      "target_id": "ru-fr81-u229-r0038",
      "tag": "prose",
      "target_sha256": "4b2cbfede35d73e22609ed478c4ac74cc06c2bb79b67a3dc15fc30bdc7980b94"
    },
    {
      "source_id": "fr81-u229-r0039",
      "target": "— Красный, — сказал он, входя и пристально глядя на Анжольраса.",
      "source_sha256": "66a8c6da2be193b694221a7e2e4cabc73dfb403a149f8fa39047a392fe7f51d5",
      "target_id": "ru-fr81-u229-r0039",
      "tag": "prose",
      "target_sha256": "4ddd9e09efee6ec29ac693019b0cf78c77b5656f0479b7085e7d455bf4bc199f"
    },
    {
      "source_id": "fr81-u229-r0040",
      "target": "Затем энергичным ударом ладони он прижал к груди два алых отворота жилета.",
      "source_sha256": "89a47e8d03bdf8139d32a92192df33ef9b6e81bbfc99187a19865873e2b207fc",
      "target_id": "ru-fr81-u229-r0040",
      "tag": "prose",
      "target_sha256": "56d1b82232231c9663c0badae1064483d3b3f431ec9bd9adc04da01a0daa9f10"
    },
    {
      "source_id": "fr81-u229-r0041",
      "target": "И, подойдя к Анжольрасу, сказал ему на ухо:",
      "source_sha256": "0cb23ae5a8805c9b874bdab631407e078aa82ce482aff016e26507955de705f7",
      "target_id": "ru-fr81-u229-r0041",
      "tag": "prose",
      "target_sha256": "cb75965705974ad243876aa9957513ca90bb57726d905c6b14ce0b32729e8bb2"
    },
    {
      "source_id": "fr81-u229-r0042",
      "target": "— Будь спокоен.",
      "source_sha256": "9bba93c6f342dead230f998638c20d8279d1a3e6c12536b7575d8612341a8c9f",
      "target_id": "ru-fr81-u229-r0042",
      "tag": "prose",
      "target_sha256": "acbf3a0a25056007851232a2f7d59d4072c25a64d94a46b9f6c545c5a02ecb19"
    },
    {
      "source_id": "fr81-u229-r0043",
      "target": "Он решительно нахлобучил шляпу и ушёл.",
      "source_sha256": "f35c7d8f5a1b4ecffd1d29f8f937989d2409b9e2dca1b172f52b2c7e97571bf6",
      "target_id": "ru-fr81-u229-r0043",
      "tag": "prose",
      "target_sha256": "d517a92b7514ab666ce5bfd8f6c3fa8dd3f32d2d22b7a80a86c0e8ae79b6e991"
    },
    {
      "source_id": "fr81-u229-r0044",
      "target": "Четверть часа спустя задняя зала кафе Мюзен опустела. Все Друзья азбуки разошлись, каждый в свою сторону, по своим делам. Анжольрас, оставивший за собой Кугурду, вышел последним.",
      "source_sha256": "1c8956e20512a0a6c951d37bd34abc10c099537269afb80e1895b0aa4e2a0923",
      "target_id": "ru-fr81-u229-r0044",
      "tag": "prose",
      "target_sha256": "e847d6d9e9e969a3f67cc459b0b844d0bebd890009c936b4cd714cfb76a15d52"
    },
    {
      "source_id": "fr81-u229-r0045",
      "target": "Те из Кугурды Экской, кто был в Париже, собирались тогда на равнине Исси, в одной из заброшенных каменоломен, которых так много с этой стороны Парижа.",
      "source_sha256": "77175e6fa078c3e0b9fdbdba049b0e464a8bd15fd9d948eaf1cabe2e23e4c58f",
      "target_id": "ru-fr81-u229-r0045",
      "tag": "prose",
      "target_sha256": "b0e34233d2ee8a5362015c5f34fe1e63f0308297f455a1bce8ddbc9fdb22145a"
    },
    {
      "source_id": "fr81-u229-r0046",
      "target": "Шагая к месту свидания, Анжольрас мысленно обозревал положение. Серьёзность событий была очевидна. Когда факты, предвестники некоей скрытой общественной болезни, движутся тяжело, малейшее осложнение останавливает их и запутывает. Из этого явления рождаются и обвалы, и возрождения. Анжольрас различал сияющее восстание под мрачными завесами будущего. Кто знает? Быть может, миг приближался. Народ, вновь овладевающий своим правом, — какое прекрасное зрелище! Революция, величественно вступающая снова во владение Францией и говорящая миру: «Продолжение завтра!» Анжольрас был доволен. Горнило разгоралось. В этот самый час у него была по Парижу рассыпана дорожка пороха из друзей. Он составлял в своей мысли — из философского и проницательного красноречия Комбефера, космополитического воодушевления Фейи, пыла Курфейрака, смеха Баореля, меланхолии Жана Прувера, учёности Жоли, сарказмов Боссюэ — некое электрическое потрескивание, которое вспыхнет сразу почти повсюду. Все были за работой. Несомненно, результат ответит усилию. Это было хорошо. Это навело его на мысль о Грантере. «Постой, — сказал он себе, — застава Мен почти не уводит меня с дороги. Что, если дойти до Ришфё? Посмотрим-ка, что делает Грантер и как у него дела».",
      "source_sha256": "001b398b9f5ecd1c67de8fe6243fdb5bb519ff7797cb82527c4c5781c2951b24",
      "target_id": "ru-fr81-u229-r0046",
      "tag": "prose",
      "target_sha256": "827d3a4f32c322481f98c909c509048287419b4b19bff8ec69e90393f11bec44"
    },
    {
      "source_id": "fr81-u229-r0047",
      "target": "На колокольне Вожирара пробило час, когда Анжольрас пришёл в табачный кабачок Ришфё. Он толкнул дверь, вошёл, скрестил руки, пустив дверь захлопнуться, так что она ударила его по плечам, и оглядел залу, полную столов, людей и дыма.",
      "source_sha256": "33c5c74b6963e01d673f667c0e72c0922890e32c2700f0dcf389b4ee9abcf492",
      "target_id": "ru-fr81-u229-r0047",
      "tag": "prose",
      "target_sha256": "4acc9752f247663f27cf1ac3c9eb67136cee7f34e8cd45a94ca557577b36543b"
    },
    {
      "source_id": "fr81-u229-r0048",
      "target": "В этом тумане гремел один голос, резко прерываемый другим. Это Грантер вёл диалог с противником, которого у него нашлось.",
      "source_sha256": "cc4fc7c3640485a03e72c91beb59ab3fb30f04fd4b1e55d62cdc1ba43e49e3e4",
      "target_id": "ru-fr81-u229-r0048",
      "tag": "prose",
      "target_sha256": "e01f623390b3e0e193b4dd9b11273fbf93be4ca751008daf9b6c02010840f1d2"
    },
    {
      "source_id": "fr81-u229-r0049",
      "target": "Грантер сидел напротив другой фигуры за столом из сент-аннского мрамора, усыпанным крупинками отрубей и усеянным, словно звёздами, костяшками домино; он бил кулаком по этому мрамору, и вот что услышал Анжольрас:",
      "source_sha256": "4da68cf89236a1dc037393f0d0746d9d99b65fa7ea975c87bd347596113bbb75",
      "target_id": "ru-fr81-u229-r0049",
      "tag": "prose",
      "target_sha256": "510ae9bcb0d84e0e960c7b212654a989d354b2ee4d29ba0f053f392ec7ba4c22"
    },
    {
      "source_id": "fr81-u229-r0050",
      "target": "— Дубль-шесть.",
      "source_sha256": "aa8c5df15e37cae9142486976d71d9525b91058a6351f7cb932949db85bd6a33",
      "target_id": "ru-fr81-u229-r0050",
      "tag": "prose",
      "target_sha256": "5632559e4a8572529f156dc2a1b66ed13ba071359a99e6d82e003ba8be3d09f5"
    },
    {
      "source_id": "fr81-u229-r0051",
      "target": "— Четвёрку.",
      "source_sha256": "6c5a3c059314c9332a142fd23b56b6d48c13302f5d2034029513c8f0df2412d2",
      "target_id": "ru-fr81-u229-r0051",
      "tag": "prose",
      "target_sha256": "d30764e105912c72a8ced3b145c337952bdfd1d15bae5e7d6f4cc5ea6a8fd047"
    },
    {
      "source_id": "fr81-u229-r0052",
      "target": "— Вот свинья! У меня больше нет.",
      "source_sha256": "e9fe9d53c4a3c0f098bfd2f482fd1438df228b039783f1ff590c9b22f6b6b416",
      "target_id": "ru-fr81-u229-r0052",
      "tag": "prose",
      "target_sha256": "e79569919408d49e4e3d490f9cc4fccce205cb584557940822ca633aaf59b6a4"
    },
    {
      "source_id": "fr81-u229-r0053",
      "target": "— Ты убит. Двойку.",
      "source_sha256": "c3fafb71e429eb9c9b6df8c90d97e42f8b1d981d0e2dcf09f652d2f718290891",
      "target_id": "ru-fr81-u229-r0053",
      "tag": "prose",
      "target_sha256": "7f15b10374776617b2530d40f2b72bf2622efb88954e1e48342363243fd4aff4"
    },
    {
      "source_id": "fr81-u229-r0054",
      "target": "— Шестёрку.",
      "source_sha256": "7a39494a8cdb19ad9cdf585251b4c833aa62732c11ad0fa301fa4c05da5f4be9",
      "target_id": "ru-fr81-u229-r0054",
      "tag": "prose",
      "target_sha256": "04c438550494b64166b432aed6784203ce8a9fc60458e18fa039e3757597d566"
    },
    {
      "source_id": "fr81-u229-r0055",
      "target": "— Тройку.",
      "source_sha256": "73490cb069cc8c2bd2576b41b199162424a98307f497444d3af6d2bf7d36a895",
      "target_id": "ru-fr81-u229-r0055",
      "tag": "prose",
      "target_sha256": "db2bbef5169d64544f1a742f87837bb759e81b123bd25215d9e333f8d11cdcfa"
    },
    {
      "source_id": "fr81-u229-r0056",
      "target": "— Единицу.",
      "source_sha256": "78a9f9d21a4ab0481ebe53d30844442f127649d55bfa4b1afe70f62057645880",
      "target_id": "ru-fr81-u229-r0056",
      "tag": "prose",
      "target_sha256": "67073e92c11719871bf091977b47808d6cf7cbc9c4a8adf6797067432fb93c19"
    },
    {
      "source_id": "fr81-u229-r0057",
      "target": "— Мне ставить.",
      "source_sha256": "db18dd1d3b50a4718ab52c3dd8e2598814273707fd6ad5149d18c62c55c07405",
      "target_id": "ru-fr81-u229-r0057",
      "tag": "prose",
      "target_sha256": "f81859e2b96cdc39ce6144ee5a99a51500d1f15b4a3b79e96ac91263c8cfc42d"
    },
    {
      "source_id": "fr81-u229-r0058",
      "target": "— Четыре очка.",
      "source_sha256": "c8aa999c9009a57babe7a35ee0e0081eaa8d89a4711b7903b21d260fb80902f6",
      "target_id": "ru-fr81-u229-r0058",
      "tag": "prose",
      "target_sha256": "c60361c1370ac1131a82b6536f4a4840f2c8516df95d4ee52c1dd6fac61c2931"
    },
    {
      "source_id": "fr81-u229-r0059",
      "target": "— С трудом.",
      "source_sha256": "8b07dc3941a7a9120bafa37d366d18b2416e1d902eb110a53937ad5d38304523",
      "target_id": "ru-fr81-u229-r0059",
      "tag": "prose",
      "target_sha256": "7348ffd41f99570d76119fac3f41ac0d25bf271e77eb5b741e99c93ac77b0539"
    },
    {
      "source_id": "fr81-u229-r0060",
      "target": "— Твой ход.",
      "source_sha256": "9095d601e5811a2cf4fe2904c9b0c3bab656f25951b2cd152062435f4df9e756",
      "target_id": "ru-fr81-u229-r0060",
      "tag": "prose",
      "target_sha256": "25f1db0330dcfb7f279c6106aa65be06e4703f74c24e2b657e233428e4d30ffc"
    },
    {
      "source_id": "fr81-u229-r0061",
      "target": "— Я сделал чудовищную ошибку.",
      "source_sha256": "e10420f04bbcff6da48f5b2a93e9728412d95432bff4a61dbd30e08548f44f5b",
      "target_id": "ru-fr81-u229-r0061",
      "tag": "prose",
      "target_sha256": "cae572bfb446ea597595bb52770f702c935979a9c0e46019be4056840d2192b7"
    },
    {
      "source_id": "fr81-u229-r0062",
      "target": "— Ты хорошо идёшь.",
      "source_sha256": "41e04cdd941cd0434b99fc880a2036b912231ab50c97f680d82daf89da85aab0",
      "target_id": "ru-fr81-u229-r0062",
      "tag": "prose",
      "target_sha256": "080e836a437af92dee3ca9e6748987d34a1ee2154059f7c55aea5310e904f7c6"
    },
    {
      "source_id": "fr81-u229-r0063",
      "target": "— Пятнадцать.",
      "source_sha256": "868ee1499401ece44857c30cfde9bc29e291e2eeb0936007f2a7704e59bfa845",
      "target_id": "ru-fr81-u229-r0063",
      "tag": "prose",
      "target_sha256": "a4b0066d0228bdcce27cd6f1470047bd9e0948996365f0425a3e945c897cb4a6"
    }
  ],
