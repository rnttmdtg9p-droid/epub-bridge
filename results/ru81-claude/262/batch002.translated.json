{
  "unit": 262,
  "batch": 2,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u262-r0064",
      "target": "— Не плачь. Скажи, ты сделаешь это для меня — не будешь плакать?",
      "source_sha256": "90790a52cb72d3a7abeb4e64fd1b8ddb2e5a3049d70713718aebbde555d8468f",
      "target_id": "ru-fr81-u262-r0064",
      "tag": "prose",
      "target_sha256": "51f2d4c536d82629ea6c39e0f2df8c4db96d333fb2799520221eed174a9a5c36"
    },
    {
      "source_id": "fr81-u262-r0065",
      "target": "— А ты любишь меня? — спросила она.",
      "source_sha256": "0bcb5c26db4be4365cb0f107054092036c4b4b3e24b07790a3dcafecba6bc79f",
      "target_id": "ru-fr81-u262-r0065",
      "tag": "prose",
      "target_sha256": "14be94da745db88ff6678c59c09f804e4b659f99baea8375bd1d29defa56a8d4"
    },
    {
      "source_id": "fr81-u262-r0066",
      "target": "Он взял её за руку.",
      "source_sha256": "00b00bb0cb307ac528dac4492eed418ed1449c26710cf1dd9af11150eda9f17c",
      "target_id": "ru-fr81-u262-r0066",
      "tag": "prose",
      "target_sha256": "c5234fac545c4e02691237e42abdf529d34fb04229ffe9bdc1c61db5e8bb5965"
    },
    {
      "source_id": "fr81-u262-r0067",
      "target": "— Козетта, я никому никогда не давал честного слова, потому что моё честное слово внушает мне страх. Я чувствую, что отец рядом. Так вот, я даю тебе самое священное честное слово, что, если ты уедешь, я умру.",
      "source_sha256": "ed5bea07265125cdf83d8830b1e16146ca8571cf5a79e03fc7784154c996a3fb",
      "target_id": "ru-fr81-u262-r0067",
      "tag": "prose",
      "target_sha256": "61688877a117bc7e4bbc374721a2f2c1478f870278faaeebb467a783c8351cf5"
    },
    {
      "source_id": "fr81-u262-r0068",
      "target": "В тоне, каким он произнёс эти слова, была такая торжественная и спокойная печаль, что Козетта задрожала. Она ощутила тот холод, какой несёт с собой мимолётное дыхание чего-то мрачного и истинного. От потрясения она перестала плакать.",
      "source_sha256": "1a568268e9bfad36832c4e7ecdd745d8933be4a87f52201f70b647ce6f67d721",
      "target_id": "ru-fr81-u262-r0068",
      "tag": "prose",
      "target_sha256": "74e6f7fa09ca6e9e14f23001c04169ccbe03c52bc40e48fc5e8cb4ad607d4380"
    },
    {
      "source_id": "fr81-u262-r0069",
      "target": "— А теперь слушай, — сказал он. — Не жди меня завтра.",
      "source_sha256": "c1a764be920eeacadc5d8b50b79159872e0e9a33365e4bba3b8a0b777b044492",
      "target_id": "ru-fr81-u262-r0069",
      "tag": "prose",
      "target_sha256": "d02a0657ebfae13cd7426f09fc8861e613c2d2e29adc3c633bb433b7bc0daafc"
    },
    {
      "source_id": "fr81-u262-r0070",
      "target": "— Почему?",
      "source_sha256": "4b5154ea331b0a88da96b0d95a9812f8ce55fa954dcfa4511479082dd555da57",
      "target_id": "ru-fr81-u262-r0070",
      "tag": "prose",
      "target_sha256": "5a7f49277ce4099a8cda575751c41cbe2652b4e11515588f5af4642c420fb08d"
    },
    {
      "source_id": "fr81-u262-r0071",
      "target": "— Жди меня только послезавтра.",
      "source_sha256": "284cbba3802c3f59195d22d661926a239c26fd17834735541edeb9ecd05b2691",
      "target_id": "ru-fr81-u262-r0071",
      "tag": "prose",
      "target_sha256": "b45dd2cc5e3fbc317a359ddd6a0923fa20b0c5e70cfe23e4a6eb83552a109d8b"
    },
    {
      "source_id": "fr81-u262-r0072",
      "target": "— О! Почему?",
      "source_sha256": "1d32da57823a6e984e4816491e33e4efb80bfeecaff0ce26889efdb3cdd2c85b",
      "target_id": "ru-fr81-u262-r0072",
      "tag": "prose",
      "target_sha256": "6be3f881e2d13f37ee118dd49cc53e3c0676caf3f041fd35d96532cda25c33f6"
    },
    {
      "source_id": "fr81-u262-r0073",
      "target": "— Ты увидишь.",
      "source_sha256": "a3a397d9da6c3ab4bee0c6fee8e47b8da558232be70b178df9c94f3d4a320afb",
      "target_id": "ru-fr81-u262-r0073",
      "tag": "prose",
      "target_sha256": "294f3ec85d28f6febd6b2bf247b2bde8df97e9f0e4cecb985ec94c04ce39327e"
    },
    {
      "source_id": "fr81-u262-r0074",
      "target": "— Целый день не видеть тебя! Но это невозможно.",
      "source_sha256": "d1bf7ed709c0b9ff609c05378ebc46a35cd5d0aaf301bed521e9acf05527c58f",
      "target_id": "ru-fr81-u262-r0074",
      "tag": "prose",
      "target_sha256": "042aee0e7a212fc7930775a2066177d2c87afae1e877e7f8d2878fefa5a59cf4"
    },
    {
      "source_id": "fr81-u262-r0075",
      "target": "— Пожертвуем одним днём, чтобы, быть может, получить всю жизнь.",
      "source_sha256": "16c59fc6fea609e5f7a39298864b82e6a05850a1dafecfe04117fe95b5100e9a",
      "target_id": "ru-fr81-u262-r0075",
      "tag": "prose",
      "target_sha256": "0f84d13fd1ed825f14d97ea8b163d88e43f298d470dc6e088e52748e58fdf226"
    },
    {
      "source_id": "fr81-u262-r0076",
      "target": "И Мариус добавил вполголоса, про себя:",
      "source_sha256": "ce52a6c6a169ef0835c67410a8c5adeb99f69bddb326b26e85965db367868756",
      "target_id": "ru-fr81-u262-r0076",
      "tag": "prose",
      "target_sha256": "f729178a4925416494c27fb1f18539875ff2e49cda7fbcca281f12f8a73eb0ac"
    },
    {
      "source_id": "fr81-u262-r0077",
      "target": "— Это человек, который ничего не меняет в своих привычках и никогда никого не принимал иначе как вечером.",
      "source_sha256": "4bd086d179fb59504dc037b26846740e732cdfe344ee215fb3c3839981c6e848",
      "target_id": "ru-fr81-u262-r0077",
      "tag": "prose",
      "target_sha256": "d5494c836ea1e0debe5beba58cb49ed7eee391346ae679d4315f73663fb2be0b"
    },
    {
      "source_id": "fr81-u262-r0078",
      "target": "— О каком человеке ты говоришь? — спросила Козетта.",
      "source_sha256": "19fac78b772d8744ff30e961570e56dcb625b7e3909e28d5c8c1d168b6aa6683",
      "target_id": "ru-fr81-u262-r0078",
      "tag": "prose",
      "target_sha256": "3cdc61409164ea152c168ffc512af3fd10451c3c3721d44abd162c883f0a3ce2"
    },
    {
      "source_id": "fr81-u262-r0079",
      "target": "— Я? Я ничего не говорил.",
      "source_sha256": "12b99da79e505b26e4caf20a18edbf94ddd1e5d6f35326d06523cea7d183b7c5",
      "target_id": "ru-fr81-u262-r0079",
      "tag": "prose",
      "target_sha256": "991b85ee2a14c852f84dce057abc8faf4ebb9b7ed2f31786628772b5c2c37f9f"
    },
    {
      "source_id": "fr81-u262-r0080",
      "target": "— На что же ты тогда надеешься?",
      "source_sha256": "738ab4ebcb9fefe669954f4942455d333b1be9e48d83e2cf1394d618b5e31283",
      "target_id": "ru-fr81-u262-r0080",
      "tag": "prose",
      "target_sha256": "72c4b355404045d221d0882603e9d639b3d62f6912f1d0cf571113a0337fc2ad"
    },
    {
      "source_id": "fr81-u262-r0081",
      "target": "— Подожди до послезавтра.",
      "source_sha256": "df984aa8cad5fab291c7ef1083d6e2c9f5a1e0cfaceb5837dcd1e3a3ae41fde1",
      "target_id": "ru-fr81-u262-r0081",
      "tag": "prose",
      "target_sha256": "1c73ea1975881b2dd87cc04c1df7a03447b979a70870d03834b13d99be890ace"
    },
    {
      "source_id": "fr81-u262-r0082",
      "target": "— Ты этого хочешь?",
      "source_sha256": "4b1b2a78f166460e46e01b0f2750ecec089d430af28141aceec38b35af7cb340",
      "target_id": "ru-fr81-u262-r0082",
      "tag": "prose",
      "target_sha256": "0614f2d3612d91d2a80e424f9348de15f641d3709cc33b377f8e167753b47324"
    },
    {
      "source_id": "fr81-u262-r0083",
      "target": "— Да, Козетта.",
      "source_sha256": "169f87558c81b746790d96e4f4d27c7d88f86e006c3a0135ca86677726b03ba1",
      "target_id": "ru-fr81-u262-r0083",
      "tag": "prose",
      "target_sha256": "6769b7e483209fbd4fd0e041781308cdd58053f7cd2257ec41841856cc771602"
    },
    {
      "source_id": "fr81-u262-r0084",
      "target": "Она обхватила его голову обеими руками, приподнялась на цыпочки, чтобы сравняться с ним ростом, и попыталась прочесть в его глазах его надежду.",
      "source_sha256": "6275cabcbbde6f1a2e5cda6d4ce2776cf64f72de42dcfd3f586a2dd65d64a508",
      "target_id": "ru-fr81-u262-r0084",
      "tag": "prose",
      "target_sha256": "40d66d39e600832ff85d18eb8a8089b87c3e23ecb34ca222f2fa2e3b55270a71"
    },
    {
      "source_id": "fr81-u262-r0085",
      "target": "Мариус продолжал:",
      "source_sha256": "6d3c95e83d3ed577078a7c565e8ce71ad61add5e03604b89184c6d599ddf14e0",
      "target_id": "ru-fr81-u262-r0085",
      "tag": "prose",
      "target_sha256": "8f42abe0882095b6a53b30dd306d6878a294c4dbaca53379be1acdd016288c97"
    },
    {
      "source_id": "fr81-u262-r0086",
      "target": "— Я вот о чём подумал: тебе надо знать мой адрес, всякое может случиться, мало ли что. Я живу у того друга, которого зовут Курфейрак, на улице Веррери, дом шестнадцать.",
      "source_sha256": "d2585f38d8a0f1d5f45f1f504d6aedb1ef54c38ed79589c143365ca4b771808f",
      "target_id": "ru-fr81-u262-r0086",
      "tag": "prose",
      "target_sha256": "2ecbf36091c52e920f414bff505fcaaa26b6dad46609b7e192f839b310f910e0"
    },
    {
      "source_id": "fr81-u262-r0087",
      "target": "Он пошарил в кармане, достал перочинный нож и лезвием написал на штукатурке стены:",
      "source_sha256": "a7a4377514d83a1205bf81bd0fa2b826276d4968ed50f656d254cb43bb2feabd",
      "target_id": "ru-fr81-u262-r0087",
      "tag": "prose",
      "target_sha256": "6bb5c2f7bd7b254170c5087b40d6426aa817dfbf9675d21b625569d4fa82c928"
    },
    {
      "source_id": "fr81-u262-r0088",
      "target": "[[I]]Улица Веррери, 16.[[/I]]",
      "source_sha256": "2f6a5990cc52472ec67b82eb2f24d5ae4b8637c9479237d394e3c77216f7013e",
      "target_id": "ru-fr81-u262-r0088",
      "tag": "prose",
      "target_sha256": "aeda8b7ee262b1e3d773c1e1ac287fd18373b84aca099e4403b33a874e9e5a83"
    },
    {
      "source_id": "fr81-u262-r0089",
      "target": "Козетта тем временем снова стала смотреть ему в глаза.",
      "source_sha256": "d035e489d5a65110e4d5b655a451979080c54c0860b4100ce76d06a8a7841e4c",
      "target_id": "ru-fr81-u262-r0089",
      "tag": "prose",
      "target_sha256": "09bf27041c478a4f92f814bce2dd775c50c7723b5cba29ca3db05d60cea26067"
    },
    {
      "source_id": "fr81-u262-r0090",
      "target": "— Скажи мне, о чём ты думаешь. Мариус, у тебя есть мысль. Скажи мне её. О, скажи, чтобы я провела хорошую ночь!",
      "source_sha256": "a14f9a12c582593c9f837be5c6cb946b57fdab36ffad914003b1eb23fc7b7932",
      "target_id": "ru-fr81-u262-r0090",
      "tag": "prose",
      "target_sha256": "5ee99a981181b4ab5909731184ba514f445526295914b15c27e8bd58eb2da87e"
    },
    {
      "source_id": "fr81-u262-r0091",
      "target": "— Моя мысль вот какая: невозможно, чтобы Бог захотел нас разлучить. Жди меня послезавтра.",
      "source_sha256": "4ef0a9eaf7d90912621d77a85fab8a293db71e4832f5d7f8f338d2c16225e07d",
      "target_id": "ru-fr81-u262-r0091",
      "tag": "prose",
      "target_sha256": "55fe655788f3eb612bcd91c17499b10864bcd883a4fd6ed2cc40e87f46296317"
    },
    {
      "source_id": "fr81-u262-r0092",
      "target": "— Что же я буду делать до тех пор? — сказала Козетта. — Ты на воле, ты уходишь, приходишь. Как счастливы мужчины! А я останусь совсем одна. О, как мне будет грустно! А что ты будешь делать завтра вечером, скажи?",
      "source_sha256": "74ffa7cd4a5e7de3eeb7f313ff65abd787ae03fa059d66b2332b75333b83e6bf",
      "target_id": "ru-fr81-u262-r0092",
      "tag": "prose",
      "target_sha256": "258e12e9fec3e92a3000098890d7cce1e96039752a07552ffa4f39b4c5b8d526"
    },
    {
      "source_id": "fr81-u262-r0093",
      "target": "— Я попробую одно дело.",
      "source_sha256": "4febb39c916cf834017380157f5d844cc01e5dda6d8593b3e4d517b3f3b6d0e3",
      "target_id": "ru-fr81-u262-r0093",
      "tag": "prose",
      "target_sha256": "c97fa013a84e08e0851169798d5c2a4c24980698f8d895901d56f6acdaff8e65"
    },
    {
      "source_id": "fr81-u262-r0094",
      "target": "— Тогда я буду молить Бога и до тех пор буду думать о тебе, чтобы тебе повезло. Я больше не расспрашиваю тебя, раз ты не хочешь. Ты мой господин. Завтра вечером я буду петь ту музыку из [[I]]Эврианты[[/I]], которую ты любишь и которую однажды вечером пришёл послушать за моим ставнем. Но послезавтра ты придёшь пораньше. Я буду ждать тебя с наступлением ночи, ровно в девять, предупреждаю тебя. Боже мой! Как печально, что дни так длинны! Слышишь, когда пробьёт девять, я буду в саду.",
      "source_sha256": "be6f85b16b9a4c7f31e3dff27990b4b35b1a80b426dea4c88c7ac36578645ab2",
      "target_id": "ru-fr81-u262-r0094",
      "tag": "prose",
      "target_sha256": "753db74c68c0cc61f86c571f4ada6bf7bcb479348356f6318c06ee07f2254f41"
    },
    {
      "source_id": "fr81-u262-r0095",
      "target": "— И я тоже.",
      "source_sha256": "7d0a3b863fb9e2e866c087e9cbbc9a5547d46a5e27365b2d83ee1c81970a4fe5",
      "target_id": "ru-fr81-u262-r0095",
      "tag": "prose",
      "target_sha256": "416dba07d63caf6a09a8cac7251f8a386d3ae88541ec84766481fde4cc8e3abe"
    }
  ],
