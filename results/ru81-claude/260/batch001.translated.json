{
  "unit": 260,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u260-r0032",
      "target": "— А это ещё что? Что ты тут делаешь? Что тебе от нас надо? Ты с ума сошла? — воскликнул Тенардье, насколько можно воскликнуть, говоря шёпотом. — С чего это ты явилась мешать нам работать?",
      "source_sha256": "eecd2426efc30bd592fd13bb7ff52150205ee0a91203d2dd1e07607f69256b48",
      "target_id": "ru-fr81-u260-r0032",
      "tag": "prose",
      "target_sha256": "f3fbb0fa82dabf56a69cdfc62a94c82b936dcafb4ea2ca10153011b9980e5800"
    },
    {
      "source_id": "fr81-u260-r0033",
      "target": "Эпонина рассмеялась и повисла у него на шее.",
      "source_sha256": "41dba3a6965bbf0463a8c9fe7946abf81c89cbbea4bc7225f97635bcdc9efa80",
      "target_id": "ru-fr81-u260-r0033",
      "tag": "prose",
      "target_sha256": "9933055d5926f9524ccc9916b5cbaf6694dce26f5a994c132f8c5363be079419"
    },
    {
      "source_id": "fr81-u260-r0034",
      "target": "— Я здесь, папочка, потому что я здесь. Разве нынче нельзя посидеть на камнях? Это вам тут не следовало бы быть. Что вам тут делать, раз это осечка? Я же говорила Маньон. Тут нечего делать. Да поцелуйте же меня, мой добрый папочка! Как давно я вас не видела! Значит, вы на воле?",
      "source_sha256": "4587419a87debab3bb32918665932170db387a25904d494a797e44dc7e3313a5",
      "target_id": "ru-fr81-u260-r0034",
      "tag": "prose",
      "target_sha256": "5b00007d265620ac51d1ae1228fe45dc7d78a66002463c4fabbf2dd777ac8da1"
    },
    {
      "source_id": "fr81-u260-r0035",
      "target": "Тенардье попытался высвободиться из объятий Эпонины и проворчал:",
      "source_sha256": "58507c2cd2bf6d9ac2a0b008597ad13e84c0fb9834b8394f61d2d9692419f06f",
      "target_id": "ru-fr81-u260-r0035",
      "tag": "prose",
      "target_sha256": "0862870fc01476c9591b888e71af67a8cb5c07fea5fde6b3294602a39b089f79"
    },
    {
      "source_id": "fr81-u260-r0036",
      "target": "— Ладно. Ты меня поцеловала. Да, я на воле. Не внутри. А теперь убирайся.",
      "source_sha256": "05d5bcb043e14989ba2a54fe4dce9834c28e289c41c6e91f83ac8de8f062cc06",
      "target_id": "ru-fr81-u260-r0036",
      "tag": "prose",
      "target_sha256": "ccc4da9b9bd9312343c9ec573402ebddba8e45e311aa9e093b485e6689cd5599"
    },
    {
      "source_id": "fr81-u260-r0037",
      "target": "Но Эпонина не отпускала его и удваивала ласки.",
      "source_sha256": "833ec46bf7aa9d0d2893687f555bdf20ca52578a24571d6cf5b8ae0447da4d13",
      "target_id": "ru-fr81-u260-r0037",
      "tag": "prose",
      "target_sha256": "770e187d66ae215a528b79ac8f40bf5801eb0ffbb56b6565efd5b9d2c65fcaaf"
    },
    {
      "source_id": "fr81-u260-r0038",
      "target": "— Папочка, как же вам это удалось? Надо иметь большую голову, чтобы выбраться оттуда. Расскажите мне! А мама? Где моя мать? Дайте же мне вести о маме.",
      "source_sha256": "a08266480c151cfcca19e7b75745fbe504c3e1825c98cb8969e36d504795508c",
      "target_id": "ru-fr81-u260-r0038",
      "tag": "prose",
      "target_sha256": "d2573090cfbe7761753d1c87615090ee3b0099c92bf5c88a16effb8b0a20f7e0"
    },
    {
      "source_id": "fr81-u260-r0039",
      "target": "Тенардье ответил:",
      "source_sha256": "38c6c604b9458c81d213150f1b24ff924d670731d4152e62fcd30675b1691efa",
      "target_id": "ru-fr81-u260-r0039",
      "tag": "prose",
      "target_sha256": "328c9dfebe5582fb3bd6a37a876e0505ca4aa50e3c2959aac2ddde448f461cfc"
    },
    {
      "source_id": "fr81-u260-r0040",
      "target": "— Она здорова, не знаю, оставь меня, говорю тебе, убирайся.",
      "source_sha256": "854a8ada1c91e4bce4d83d93b199c12977a95f6d74306e843dae379377499751",
      "target_id": "ru-fr81-u260-r0040",
      "tag": "prose",
      "target_sha256": "2baf7e1d6563567e1f5db1f763a3f706ce08713e3cea7e631d05a6288e2c2abe"
    },
    {
      "source_id": "fr81-u260-r0041",
      "target": "— А я как раз не хочу уходить, — сказала Эпонина с ужимкой балованного ребёнка. — Вы меня гоните, а ведь вот уже четыре месяца, как я вас не видела, и я едва успела вас обнять.",
      "source_sha256": "84369e6311e92f3f50740199fc5b6c3a62912b69e6a4e874f4343d23d24a55ec",
      "target_id": "ru-fr81-u260-r0041",
      "tag": "prose",
      "target_sha256": "aab1ba39a59b30e79d59d563f968ad178118233b437ab30e9d3e29138301e3ca"
    },
    {
      "source_id": "fr81-u260-r0042",
      "target": "И она снова обхватила отца за шею.",
      "source_sha256": "7692096ef81eafbf76f169fb790f791acd2e75b2494a0fb1f808a8de01ee3f0e",
      "target_id": "ru-fr81-u260-r0042",
      "tag": "prose",
      "target_sha256": "2abe60f82f4269af9d912636f67b1958ba1e6a04baed461d8666b06895d31fce"
    },
    {
      "source_id": "fr81-u260-r0043",
      "target": "— Ну и глупо же! — сказал Бабе.",
      "source_sha256": "c5ac4944bab6202ecb8990afe2d1448e08e604b2205a6d1732602b912c2a34c2",
      "target_id": "ru-fr81-u260-r0043",
      "tag": "prose",
      "target_sha256": "7590ab1b57121f84dcbcbef81bc062d45e1d9300fbec3ae90de7e76ae53fc2ce"
    },
    {
      "source_id": "fr81-u260-r0044",
      "target": "— Живей! — сказал Гёлемер. — Легавые могут пройти.",
      "source_sha256": "ffef22f75e127a68b60af52e1634680d0c9c76cd26e51272da096764059b22a0",
      "target_id": "ru-fr81-u260-r0044",
      "tag": "prose",
      "target_sha256": "e0a3c5c414a4813609660072e16c535703a696b053f18c10ae02bc3a606348ca"
    },
    {
      "source_id": "fr81-u260-r0045",
      "target": "Голос чревовещателя отчеканил двустишие:",
      "source_sha256": "695ddd169a95bd7db87e079df4e71835e7ae5e5fe3ec2b5b051ddc1f5a152e06",
      "target_id": "ru-fr81-u260-r0045",
      "tag": "prose",
      "target_sha256": "c0b3f71bf184e13fff2e784b1f4e6f2069783d4912507e3c28f88e1b68eea180"
    },
    {
      "source_id": "fr81-u260-r0046",
      "target": "Нынче, чай, не Новый год —\n\nЦеловать папу с мамой не черёд.",
      "source_sha256": "aee50b933e05beeaeb5bbcfa930a86f0cfaf5a9f71ed430a9fc52e4dd5f71bd3",
      "target_id": "ru-fr81-u260-r0046",
      "tag": "verse_group",
      "target_sha256": "732e72564c84d81d1a3fe5619cabeff91301d24b486a311827f4e04f90802d27"
    },
    {
      "source_id": "fr81-u260-r0047",
      "target": "Эпонина повернулась к пяти бандитам.",
      "source_sha256": "9e316db142ceadd7f7491731cf51288f294e95439760b0da74ce0e35b7776731",
      "target_id": "ru-fr81-u260-r0047",
      "tag": "prose",
      "target_sha256": "9b51cc4d82944ee6b58e5389acac636aa980baf58c66d58ffcead21aeb679236"
    },
    {
      "source_id": "fr81-u260-r0048",
      "target": "— Гляди-ка, это господин Брюжон. — Здравствуйте, господин Бабе. Здравствуйте, господин Клакзу. — Вы что же, не узнаёте меня, господин Гёлемер? — Как поживаешь, Монпарнас?",
      "source_sha256": "da736a5fa63952aa59dd2fe4c4683ddf16807f74647ab992ea49762481262755",
      "target_id": "ru-fr81-u260-r0048",
      "tag": "prose",
      "target_sha256": "d66ac3c5bd71a3a09c35d9346894df49ddc1e18d2e9dbf7b356b1fa2869d552e"
    },
    {
      "source_id": "fr81-u260-r0049",
      "target": "— Как не узнать, узнаём! — сказал Тенардье. — Ну, здравствуй, прощай, проваливай! Оставь нас в покое.",
      "source_sha256": "f145106831de1c0d0928fd04e514830cebb411c96e141b322622d9fbff132560",
      "target_id": "ru-fr81-u260-r0049",
      "tag": "prose",
      "target_sha256": "960583c1b8f4d0b9958afc3d6426943528193ef16928f6481784c1a03dfa99c7"
    },
    {
      "source_id": "fr81-u260-r0050",
      "target": "— Сейчас час лисиц, а не кур, — сказал Монпарнас.",
      "source_sha256": "e65d08b5234840bec587e05371ca0d0a3af06c8006b2c3ac93614155429b0fb5",
      "target_id": "ru-fr81-u260-r0050",
      "tag": "prose",
      "target_sha256": "7041d2b2a22ab842e0b1fa72e13256d9da99f8c6360e04baf51ab523e56470f3"
    },
    {
      "source_id": "fr81-u260-r0051",
      "target": "— Сама видишь, нам надо поработать тут, в исиго[[N8]], — добавил Бабе.",
      "source_sha256": "6c81620be859d7539d798bbe720fec197cc6820f0dcfdd43206cda9de93cda5a",
      "target_id": "ru-fr81-u260-r0051",
      "tag": "prose",
      "target_sha256": "005556d6ec4de26766e78606858df35827138418da6cb6785caeca2bf64520fb"
    },
    {
      "source_id": "fr81-u260-r0052",
      "target": "Эпонина взяла Монпарнаса за руку.",
      "source_sha256": "3bb48eae37509e3557a3db8b4ba8b2d715337419590555d926e1ec8a9f47ef78",
      "target_id": "ru-fr81-u260-r0052",
      "tag": "prose",
      "target_sha256": "9abaceb82119504d0294fc471ba60d7d353dbbb7e3569abc492c0a47d528a043"
    },
    {
      "source_id": "fr81-u260-r0053",
      "target": "— Осторожно! — сказал он. — Порежешься, у меня нож раскрыт[[N9]].",
      "source_sha256": "805f05ef21d9dfafbe14c98031cee576d28cfc5ee6caab0dceb2521a81bf803a",
      "target_id": "ru-fr81-u260-r0053",
      "tag": "prose",
      "target_sha256": "0c1eba70c346bbb579cae15441da00571486dbd89e9abfb734b4c79bd1a813ae"
    },
    {
      "source_id": "fr81-u260-r0054",
      "target": "— Мой маленький Монпарнас, — очень мягко ответила Эпонина, — людям надо доверять. Может быть, я как-никак дочь своего отца. Господин Бабе, господин Гёлемер, это меня поручили разведать дело.",
      "source_sha256": "a77a40c2f13c86e117f326437efe6a9b61d1e2760011a54856178eb9883acef8",
      "target_id": "ru-fr81-u260-r0054",
      "tag": "prose",
      "target_sha256": "de82bcba9a02febd88d39d6d4f048b479c7b32a378005498b9dbaec32e2e5192"
    },
    {
      "source_id": "fr81-u260-r0055",
      "target": "Примечательно, что Эпонина не говорила на жаргоне. С тех пор как она узнала Мариуса, этот ужасный язык стал для неё невозможен.",
      "source_sha256": "0bf902f089f312b1b2954b6dc599590065fb3bd797c350e07cf43da81a594744",
      "target_id": "ru-fr81-u260-r0055",
      "tag": "prose",
      "target_sha256": "59259ef3655f3486b687b1b2fadf6825dbfed2c333c3bce92de5c6965cc2589a"
    },
    {
      "source_id": "fr81-u260-r0056",
      "target": "Она сжала в своей маленькой костлявой руке, слабой, как рука скелета, толстые грубые пальцы Гёлемера и продолжала:",
      "source_sha256": "c7f8851a12a9705fe56deb4331c5f1e5b799a5443438948e5f3627eac4feac0d",
      "target_id": "ru-fr81-u260-r0056",
      "tag": "prose",
      "target_sha256": "95f400ab6b18bad798c8900e1b49dee8174092cd6d8f50cacde9b97f8426bc17"
    },
    {
      "source_id": "fr81-u260-r0057",
      "target": "— Вы же знаете, я не дура. Обычно мне верят. Я при случае оказывала вам услуги. Так вот, я навела справки: вы подвергнете себя опасности понапрасну, поверьте. Клянусь вам, в этом доме делать нечего.",
      "source_sha256": "0c39b54c9fb04d5ba83b007c98330042b0902b038849e15c5bc4088e777c7ae3",
      "target_id": "ru-fr81-u260-r0057",
      "tag": "prose",
      "target_sha256": "adaf2bed0ea48fb5cca5d8c843bd0e31af871d1411f3513ff6bb1cd7e92542aa"
    },
    {
      "source_id": "fr81-u260-r0058",
      "target": "— Там одинокие женщины, — сказал Гёлемер.",
      "source_sha256": "7ace6e498624aabcb9f876bf03113ca1e04b4ceddb0cf0d083d9fc03f27b2a94",
      "target_id": "ru-fr81-u260-r0058",
      "tag": "prose",
      "target_sha256": "05fa6c67e1f192e0602c44d6e03827b99dd4f3ae14ed6dfd2b9a42132d5ffda7"
    },
    {
      "source_id": "fr81-u260-r0059",
      "target": "— Нет. Жильцы съехали.",
      "source_sha256": "76fab7775597fe844ceec5bb0401a16021d5891ff939d5204b517dc428420773",
      "target_id": "ru-fr81-u260-r0059",
      "tag": "prose",
      "target_sha256": "99351046021a8e0c263ba70fd87ecdcce85f415648c1a6964da398022722aadf"
    },
    {
      "source_id": "fr81-u260-r0060",
      "target": "— А свечи-то не съехали! — сказал Бабе.",
      "source_sha256": "d5c19e145d2df6bc978da081c852afbccf9600831312b57af09acc2be3ed14ee",
      "target_id": "ru-fr81-u260-r0060",
      "tag": "prose",
      "target_sha256": "4673b8b5b3af76cb84508a448b3312cf91b537f1c7c6c90a77c1e7fecac27011"
    },
    {
      "source_id": "fr81-u260-r0061",
      "target": "И он показал Эпонине сквозь верхушки деревьев свет, ходивший по мансарде флигеля. Это Туссен не спала, чтобы развесить бельё сушиться.",
      "source_sha256": "25dcc8552c19a13c8457035e57b4b635d6e1a05ae62860125c34cc311d23d57c",
      "target_id": "ru-fr81-u260-r0061",
      "tag": "prose",
      "target_sha256": "347ec884cca055e0df429ec15a92760d3ae9f4bf2271946eabf493d7d6ed42ce"
    },
    {
      "source_id": "fr81-u260-r0062",
      "target": "Эпонина предприняла последнюю попытку.",
      "source_sha256": "4e630095e9e5d364dfc6f444a3d378b9afb7923ca79a4fb787114099b4550531",
      "target_id": "ru-fr81-u260-r0062",
      "tag": "prose",
      "target_sha256": "795a53eb819032c80888e18ebe46c3e3b7d1fd48391184a1029494d61fb17a45"
    },
    {
      "source_id": "fr81-u260-r0063",
      "target": "— Ну так вот, — сказала она, — это очень бедный народ, а дом — лачуга, где у них нет ни гроша.",
      "source_sha256": "8558711fe492fd5f4259fdbf91e1f26fd4f16aac798384d1aa92891e52ef7fb5",
      "target_id": "ru-fr81-u260-r0063",
      "tag": "prose",
      "target_sha256": "5f1d216b4c8f84c6decb17d70533e252ac9553e1a913619e3e4bbfbcdffd1f84"
    }
  ],
