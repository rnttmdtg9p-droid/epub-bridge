  "rows": [
    {
      "source_id": "fr81-u260-r0128",
      "target": "[[B]]Кэб катит по-английски и тявкает по-воровски[[/B]]",
      "source_sha256": "70c2c17e47594ea1d9de609c96cd2778657f90338b00620a82366c859005f6f3",
      "target_id": "ru-fr81-u260-r0128",
      "tag": "display_group",
      "target_sha256": "210a165cb010cd28914bcca3621525e23e8ffb406d91e131097f32ff3bc7022c"
    },
    {
      "source_id": "fr81-u260-r0129",
      "target": "Тогда она прислонилась спиной к решётке, повернулась лицом к шестерым разбойникам, вооружённым до зубов, которым ночь придавала обличье демонов, и сказала твёрдым, тихим голосом:",
      "source_sha256": "6312a8f524678335b17820234f303308213b9198000309dc8630e88abd1ae24a",
      "target_id": "ru-fr81-u260-r0129",
      "tag": "prose",
      "target_sha256": "25cbb81e530f9e7707a2c77657a8d9e42ef22f1c81a99cd26fd69cc411f920c9"
    },
    {
      "source_id": "fr81-u260-r0130",
      "target": "— Ну так вот, а я не хочу.",
      "source_sha256": "ea54cf1ae2fbb5d08711eb7c5450fac6d6d73d21dd5394cf60c3ff1368c38709",
      "target_id": "ru-fr81-u260-r0130",
      "tag": "prose",
      "target_sha256": "34c0f54d4a0ec41b9d72d23ac1d6f9a3e038490d4eddb7526eb84d6da73b79b7"
    },
    {
      "source_id": "fr81-u260-r0131",
      "target": "Они остановились в изумлении.",
      "source_sha256": "e57b5575e0f047fcb4d830cf010abad4d0673f69c5466f7b8047d9b8a6a897ef",
      "target_id": "ru-fr81-u260-r0131",
      "tag": "prose",
      "target_sha256": "a8b1a1787815287cfaabbdeec10ad562cc6b36270121de92d1ca1d09c7e0c1bd"
    },
    {
      "source_id": "fr81-u260-r0132",
      "target": "Собака.",
      "source_sha256": "de30a75e934ff3a0713d075ae5a95d5aa78e9e58fdf2a708ee37f71b7851d10b",
      "target_id": "ru-fr81-u260-r0132",
      "tag": "footnote",
      "target_sha256": "8f1326b5c21e58bd9e417bb9a52d4c8bfaff75966e89c82e6bc0cbf46d4f8ae4"
    },
    {
      "source_id": "fr81-u260-r0133",
      "target": "Принесённый. От испанского [[I]]llevar[[/I]].",
      "source_sha256": "ce20d7d1d0a954f89c82bbbc0660721c8ed87f7230c3a6b58b05938e676ddf9c",
      "target_id": "ru-fr81-u260-r0133",
      "tag": "footnote",
      "target_sha256": "d76750e2cceb28c56d21f0a2c61bdd56dfd964e94fe7555c3fb78d446dd5d780"
    },
    {
      "source_id": "fr81-u260-r0134",
      "target": "Есть.",
      "source_sha256": "5f6b0e430ea93e393d78e59e9936ef45d3c21f982411280bd088bc878f801e4f",
      "target_id": "ru-fr81-u260-r0134",
      "tag": "footnote",
      "target_sha256": "e0351f1aa3124b9236df98f02130caf43638116b72f1ef5af5fc1d723de15a23"
    },
    {
      "source_id": "fr81-u260-r0135",
      "target": "[[I]]Выбить стекло[[/I]] с помощью пластыря из замазки, который, приложенный к стеклу, удерживает осколки и не даёт шуму раздаться.",
      "source_sha256": "20a9c8647a3d56b91898fc6215cb306d9d76b868fc9ad397d72842ff463f1d03",
      "target_id": "ru-fr81-u260-r0135",
      "tag": "footnote",
      "target_sha256": "59a89b6c57d4c7eed13ba73e4db8aaf1f748affce3c6689e80d35511b58d238a"
    },
    {
      "source_id": "fr81-u260-r0136",
      "target": "Закричит.",
      "source_sha256": "18d744c6a6fcad853c62b410e63c7ec402a92b4a3a7d5b962bee2cb46525121d",
      "target_id": "ru-fr81-u260-r0136",
      "tag": "footnote",
