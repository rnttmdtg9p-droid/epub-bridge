    },
    {
      "source_id": "fr81-u260-r0140",
      "target": "Нож.",
      "source_sha256": "950b18069916ad0a6f4131098a32657ee8f2cc0333925769a12017d9fbee278d",
      "target_id": "ru-fr81-u260-r0140",
