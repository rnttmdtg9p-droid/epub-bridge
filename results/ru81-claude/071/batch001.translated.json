{
  "unit": 71,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u071-r0032",
      "target": "Бумага была развёрнута. Она бросила на неё взгляд.",
      "source_sha256": "e1153504fe165dbc5b9bb94931d31ecbd6b1175349927deba839d8fe9f2ca63b",
      "target_id": "ru-fr81-u071-r0032",
      "tag": "prose",
      "target_sha256": "6e055fc439b3b7dcec8d72fa705d9c8f264c3c405801043b18f54834855acea3"
    },
    {
      "source_id": "fr81-u071-r0033",
      "target": "— Можете прочесть, — сказал он.",
      "source_sha256": "911eb010550960ff02552b73fa991a5363e92bc47560e007015c62b871797126",
      "target_id": "ru-fr81-u071-r0033",
      "tag": "prose",
      "target_sha256": "b5a8fa2bd31a929620df48a03a29d7d719b9792b73162a46c759022f0585cc1d"
    },
    {
      "source_id": "fr81-u071-r0034",
      "target": "Она прочла: — «Прошу господина кюре присмотреть за всем, что я оставляю здесь. Пусть он соблаговолит уплатить из этого расходы по моему процессу и похороны женщины, умершей сегодня. Остальное пусть достанется бедным».",
      "source_sha256": "16902414749cbc74163fa28c48371c0428fd73b6ea1fd5d0d9ed3d989efcdac4",
      "target_id": "ru-fr81-u071-r0034",
      "tag": "prose",
      "target_sha256": "cc0d4751a54777fabce23d27b847d8ff20114be8c6617233e7d253f3d118ca93"
    },
    {
      "source_id": "fr81-u071-r0035",
      "target": "Сестра хотела заговорить, но едва смогла пролепетать несколько нечленораздельных звуков. Однако ей удалось сказать:",
      "source_sha256": "d75889144974a5a570b5cd82537d39f965d23602548288d44d9065eb259a76c7",
      "target_id": "ru-fr81-u071-r0035",
      "tag": "prose",
      "target_sha256": "b8d5c88c7523cc9b458319a32c0d266b0093ce66be8f4506eacee43dad03a889"
    },
    {
      "source_id": "fr81-u071-r0036",
      "target": "— Разве господин мэр не желает в последний раз взглянуть на эту бедную несчастную?",
      "source_sha256": "a1db36d933cfc827d62532e71a4bf787f8d529af9301c8ac4ac1b8be1218e3b0",
      "target_id": "ru-fr81-u071-r0036",
      "tag": "prose",
      "target_sha256": "2aef2c27a4f9621c4046e5675825e52114d9395d6dc5d5d966d93892f31d1725"
    },
    {
      "source_id": "fr81-u071-r0037",
      "target": "— Нет, — сказал он, — за мной гонятся; стоит им арестовать меня в её комнате — это потревожило бы её.",
      "source_sha256": "d4f1d29b5c0dee314079e0af9b59b5b002cfbd5e79f7877f8796aae940461393",
      "target_id": "ru-fr81-u071-r0037",
      "tag": "prose",
      "target_sha256": "1d4aacfa2b26169eafc17a2076c7439f0f5bb6e3611d82095464446582d2f5d2"
    },
    {
      "source_id": "fr81-u071-r0038",
      "target": "Едва он договорил, как на лестнице поднялся сильный шум. Они услышали топот множества поднимавшихся ног и голос старой привратницы, говорившей самым громким и самым пронзительным голосом:",
      "source_sha256": "5109e162e2a23664c9971cc607a58ef07ead7278c8bfb84ee64568e75ba79d78",
      "target_id": "ru-fr81-u071-r0038",
      "tag": "prose",
      "target_sha256": "be41c8d05b3f705ba024e0a1c3b8e8f1a2bf3d5649bb6224063214191686b4f9"
    },
    {
      "source_id": "fr81-u071-r0039",
      "target": "— Добрый господин, клянусь вам Господом Богом, что сюда никто не входил ни за весь день, ни за весь вечер, да я и от двери-то своей не отходила!",
      "source_sha256": "65b5c65778b669b2de0981bd84217465217b0928823d444f688d5bd091340405",
      "target_id": "ru-fr81-u071-r0039",
      "tag": "prose",
      "target_sha256": "cf54465ed775e35f31d00aff4857d7f69c4a523d93eb3ae76516ed8466c1f276"
    },
    {
      "source_id": "fr81-u071-r0040",
      "target": "Мужской голос ответил:",
      "source_sha256": "34de8d2364660f8f90e2ebd00861366e54bc5255b31b8df0522d8d712fc32437",
      "target_id": "ru-fr81-u071-r0040",
      "tag": "prose",
      "target_sha256": "b0ac6b1046cd2f246dd35a55a352cd978591271704334361021819314d811f15"
    },
    {
      "source_id": "fr81-u071-r0041",
      "target": "— Однако в этой комнате горит свет.",
      "source_sha256": "34dbbdb72b65c1d4f0d9d816a12a0b18a18d15b20514f2f72d70f9a99aa45314",
      "target_id": "ru-fr81-u071-r0041",
      "tag": "prose",
      "target_sha256": "1865b88595c6178fafbd9cd91863914ee9f54c9185551139ed19731e4d4cc0da"
    },
    {
      "source_id": "fr81-u071-r0042",
      "target": "Они узнали голос Жавера.",
      "source_sha256": "e0263948f45ac66f7dd33830d62ac94d55e8690aa00d6cf8b852dc5ab3240387",
      "target_id": "ru-fr81-u071-r0042",
      "tag": "prose",
      "target_sha256": "f48e4b675b70f99cbbef01b797aab78d3406e07ce1edee73bd0a354fb03100f6"
    },
    {
      "source_id": "fr81-u071-r0043",
      "target": "Комната была устроена так, что дверь, отворяясь, закрывала угол стены справа. Жан Вальжан задул свечу и стал в этом углу.",
      "source_sha256": "ad74a764791718e2f1db252f1cd960313af54061aac65a1fd35b1e2a191bf715",
      "target_id": "ru-fr81-u071-r0043",
      "tag": "prose",
      "target_sha256": "86eb6147c7555aeceeb15345303b0e5a16e6360813589ba280592ae59290dbec"
    },
    {
      "source_id": "fr81-u071-r0044",
      "target": "Сестра Симплиция упала на колени возле стола.",
      "source_sha256": "563bbcf87aa33dc6505379af8f517b8ae2a06d6daef87a0cb05aa31cd9c87827",
      "target_id": "ru-fr81-u071-r0044",
      "tag": "prose",
      "target_sha256": "aa0262f1f996f33fd9d8dcf9dd6c908b5fb881818d8dbac1fdddadc9b9ab8bcb"
    },
    {
      "source_id": "fr81-u071-r0045",
      "target": "Дверь отворилась.",
      "source_sha256": "31eb01277d5d13961d9415c2872009dc1c5c8c94ede889c2a1b7691380cd6e28",
      "target_id": "ru-fr81-u071-r0045",
      "tag": "prose",
      "target_sha256": "d677586618d98dae48a831d69d63037a3711444aa47e083474becdfe6a90bdfc"
    },
    {
      "source_id": "fr81-u071-r0046",
      "target": "Вошёл Жавер.",
      "source_sha256": "0b3251b053f7b53278459161b6e6e400be33c36143c23ecc989b1222aae48c05",
      "target_id": "ru-fr81-u071-r0046",
      "tag": "prose",
      "target_sha256": "dbd82e6231cf6ddf48a995d7b3971204751229f3bae1ad1a76a510f443e54c38"
    },
    {
      "source_id": "fr81-u071-r0047",
      "target": "В коридоре слышался шёпот нескольких мужчин и протесты привратницы. Монахиня не подняла глаз. Она молилась.",
      "source_sha256": "0e4568bb4c8c0cf1fddfd0e3b5669ec9389f2aa440d1cb4e5f7d9fb890f19ae3",
      "target_id": "ru-fr81-u071-r0047",
      "tag": "prose",
      "target_sha256": "319c06da82fe29e3d3df2d509411192740fe206c25854190db918db568e93267"
    },
    {
      "source_id": "fr81-u071-r0048",
      "target": "Свеча стояла на камине и давала лишь немного света.",
      "source_sha256": "d528b9c7fbc2f074eeeaa1bdc0ea231d335f3d3fec91b58693db387effbe5f44",
      "target_id": "ru-fr81-u071-r0048",
      "tag": "display_group",
      "target_sha256": "b6afce6c861ad14d5d54ab8c5ae5b4cb7605702fd406df7cbbb39a32de96e054"
    },
    {
      "source_id": "fr81-u071-r0049",
      "target": "Жавер заметил сестру и остановился в замешательстве.",
      "source_sha256": "c201be1410530aff7aef810c4ecbf055e60ac0a6675561fa9fe5bfe2ad3da820",
      "target_id": "ru-fr81-u071-r0049",
      "tag": "prose",
      "target_sha256": "d9a6d565260be39413a0c2ae38761bb1789fd7f8c0d9cc963b94905ce824d17a"
    },
    {
      "source_id": "fr81-u071-r0050",
      "target": "Помнится, самой основой Жавера, его стихией, воздухом, которым он дышал, было благоговение перед всякой властью. Он был цельным куском и не допускал ни возражений, ни ограничений. Для него, разумеется, власть церковная стояла выше всех прочих; он был религиозен, поверхностен и безупречен в этом, как и во всём. В его глазах священник был умом, который не ошибается, монахиня — существом, которое не грешит. Это были души, замурованные для этого мира, с единственной дверью, которая отворялась лишь затем, чтобы выпустить истину.",
      "source_sha256": "26b97b74753680f1279ecd9657eca58c69babd0868a55a757e369937760e8a15",
      "target_id": "ru-fr81-u071-r0050",
      "tag": "prose",
      "target_sha256": "a47f1752e6c42af92ed896c5e391c13460214a9e93b979ff69b6b327b9ad60dd"
    },
    {
      "source_id": "fr81-u071-r0051",
      "target": "Увидев сестру, он первым движением хотел удалиться.",
      "source_sha256": "da508c0829032fb557998367d5a8e2c924c1fcbee57b3ce086b3d259feb2379b",
      "target_id": "ru-fr81-u071-r0051",
      "tag": "prose",
      "target_sha256": "41ffa4533983de14265ed6046291c92b03eb5a59f5c742bd59e81e02181de95b"
    },
    {
      "source_id": "fr81-u071-r0052",
      "target": "Но был и другой долг, который удерживал его и властно толкал в обратную сторону. Вторым его движением было остаться и рискнуть хотя бы одним вопросом.",
      "source_sha256": "f93136798bd95d969ef5ca0c4fe12a42c84ece60bbae50106acfadde3ec8872f",
      "target_id": "ru-fr81-u071-r0052",
      "tag": "prose",
      "target_sha256": "532a7155f8f1261a66e63f9844924f7fb87c29a39dcdf7de81987fc761ed526b"
    },
    {
      "source_id": "fr81-u071-r0053",
      "target": "Это была та самая сестра Симплиция, которая за всю свою жизнь ни разу не солгала. Жавер знал это и особенно почитал её за это.",
      "source_sha256": "d7e41559e5ebcd7764183bbfb6944b9fadf20b77a8ce8014a13f72a8c1b61295",
      "target_id": "ru-fr81-u071-r0053",
      "tag": "prose",
      "target_sha256": "cea8457210e1c789d6982a2c106aa3f783103fb244fa8a1406b80f94ca15601e"
    },
    {
      "source_id": "fr81-u071-r0054",
      "target": "— Сестра, — сказал он, — вы одни в этой комнате?",
      "source_sha256": "439d481a1130980f4ce47da70a8f69cc26a5dc5a2607eaaaa104ff38d5a7906c",
      "target_id": "ru-fr81-u071-r0054",
      "tag": "prose",
      "target_sha256": "dd6d412f56372a94cce25e97e4789a543a3d7ca2698494fa498f82d4ad18db1b"
    },
    {
      "source_id": "fr81-u071-r0055",
      "target": "Наступила страшная минута, во время которой бедная привратница почувствовала, что теряет силы.",
      "source_sha256": "f90492cd773f3d7eb888d23c5df6f8cdaa0d77b995c1e1d1f7ccd28472b5fff5",
      "target_id": "ru-fr81-u071-r0055",
      "tag": "prose",
      "target_sha256": "a3772144813ba90c90fbebada8b563246aac01325272c22e5eac514f1124aefc"
    },
    {
      "source_id": "fr81-u071-r0056",
      "target": "Сестра подняла глаза и ответила:",
      "source_sha256": "88eb6973cbe1a99cc494dc020b757e3b3036165978fc6cca56dfd35e66a7b7ee",
      "target_id": "ru-fr81-u071-r0056",
      "tag": "prose",
      "target_sha256": "e39877b754b1904041db5c2fc83e8db590c246e1ce0cf4fd797a6d8becc5b4d4"
    },
    {
      "source_id": "fr81-u071-r0057",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u071-r0057",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u071-r0058",
      "target": "— Итак, — продолжал Жавер, — простите, что настаиваю, это мой долг, — вы не видели сегодня вечером никого, никакого человека? Он бежал, мы его ищем — некоего Жана Вальжана; вы его не видели?",
      "source_sha256": "b7e7c2fc0f3a63b268b5596663cd3b9ba10a1ca46c89e1a95af675e83f6da15c",
      "target_id": "ru-fr81-u071-r0058",
      "tag": "prose",
      "target_sha256": "6a5bc24a80e668bea830f73cf4f81765fd3f6f29c64575d86f17ba9a165703b1"
    },
    {
      "source_id": "fr81-u071-r0059",
      "target": "Сестра ответила: — Нет.",
      "source_sha256": "8273cd14f47b83292f7a3cf468b774a3c861b89ac0b66f964b0071ee6649120c",
      "target_id": "ru-fr81-u071-r0059",
      "tag": "prose",
      "target_sha256": "055cb30c495c1799a4c2ac89114248b4e3636cc7e09b4e67df757a6fe9b64ddf"
    },
    {
      "source_id": "fr81-u071-r0060",
      "target": "Она солгала дважды подряд, один раз вслед за другим, не колеблясь, быстро, как жертвуют собой.",
      "source_sha256": "31777891fa933ee2e8fc7359315ec5d5fe4fde170e9d298996d60c84c45a7acb",
      "target_id": "ru-fr81-u071-r0060",
      "tag": "prose",
      "target_sha256": "dcdafa91141c7a3e50d65f56e72ae13c654e647cd534cdd68dfb7556eed3da01"
    },
    {
      "source_id": "fr81-u071-r0061",
      "target": "— Прошу прощения, — сказал Жавер; и удалился, глубоко поклонившись.",
      "source_sha256": "d760821afbce61f4fd3463f8bd57eaca3238efa477d28c786f03eecae436ea82",
      "target_id": "ru-fr81-u071-r0061",
      "tag": "prose",
      "target_sha256": "b13aa897807127b4642d5db4e11a0fd97c50333f22f34de43bacd474d6a5f8c8"
    },
    {
      "source_id": "fr81-u071-r0062",
      "target": "О святая дева! Вы уже много лет как не принадлежите этому миру; вы соединились в свете с вашими сёстрами-девами и вашими братьями-ангелами; да зачтётся вам эта ложь в раю!",
      "source_sha256": "ea928b2e944fbdd859cc2a518eae01a31a2dd46507a921d992abc5935b2c074b",
      "target_id": "ru-fr81-u071-r0062",
      "tag": "prose",
      "target_sha256": "331cce293848d81d446f3937fd4badd4673683c43b03441aed51117a8217260d"
    },
    {
      "source_id": "fr81-u071-r0063",
      "target": "Утверждение сестры было для Жавера чем-то столь решающим, что он даже не заметил странности свечи, которую только что задули и которая дымилась на столе.",
      "source_sha256": "f3d3689ff0f65a67d213a20d85d1b8f7379cf1347fc76cf58765968d104e7db3",
      "target_id": "ru-fr81-u071-r0063",
      "tag": "prose",
      "target_sha256": "a01a469c9a578d14ca5464b01d182201e96a9f34ee5c84e5ce6051a4d7945e9f"
    }
  ],
