{
  "unit": 175,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u175-r0032",
      "target": "— Как и я.",
      "source_sha256": "75b2906367f579daf68e2d36ec230757585398e5c10d32198584a2fab0c9f506",
      "target_id": "ru-fr81-u175-r0032",
      "tag": "prose",
      "target_sha256": "26fd6690ac8484e0ec89edd4f10fa84009419790194b532e58580f00439002ac"
    },
    {
      "source_id": "fr81-u175-r0033",
      "target": "— Но ты — по долгу службы, а он — по беспорядочности.",
      "source_sha256": "060c1e69eb609a9d2d30ce14c19dc1f5ecf4be4bce4d73875ec67212897eccfb",
      "target_id": "ru-fr81-u175-r0033",
      "tag": "prose",
      "target_sha256": "f3ba02c549677995ad7f579c307d6aa56181fc104a09b2af132d13663bbc9d73"
    },
    {
      "source_id": "fr81-u175-r0034",
      "target": "— Чёрт возьми! — протянул Теодюль.",
      "source_sha256": "387b0bc7a8c01c09b812dc2f398858bcd481ff0fdbb557bb5b82b1ea9080e9da",
      "target_id": "ru-fr81-u175-r0034",
      "tag": "prose",
      "target_sha256": "79dc75f600d9fb66f30c8c5e05bb451c147ad165f59008cd8cc83b7854322206"
    },
    {
      "source_id": "fr81-u175-r0035",
      "target": "Тут с мадемуазель Жильнорман-старшей приключилось событие: ей пришла мысль. Будь она мужчиной, она бы хлопнула себя по лбу. Она обратилась к Теодюлю:",
      "source_sha256": "1075fbe8c0c20a61d8ed86e87d101c1c86e03d65dee933751fefe4bf2ec8ecff",
      "target_id": "ru-fr81-u175-r0035",
      "tag": "prose",
      "target_sha256": "d844860f2b57b51c1cf6db981771639be8fb87070977f5ea3c36d36699587889"
    },
    {
      "source_id": "fr81-u175-r0036",
      "target": "— Знаешь ли ты, что твой кузен тебя не знает?",
      "source_sha256": "b69d0bddb553fca9fa09cd34a587eb7b7e479d84c4313691c01ff443d1d1814a",
      "target_id": "ru-fr81-u175-r0036",
      "tag": "prose",
      "target_sha256": "6628d5a428a854b59c636c89d13e2dc45d50457b7b7953dfd27ee799f443cde3"
    },
    {
      "source_id": "fr81-u175-r0037",
      "target": "— Нет, не знаю. Я-то его видел, а он никогда не удостаивал меня внимания.",
      "source_sha256": "739bfd8b58749e3c73389e6857cee97d5ca87adfe1404ed8ec6125392b20c6bf",
      "target_id": "ru-fr81-u175-r0037",
      "tag": "prose",
      "target_sha256": "f4c2ce1b4c4d5040790969fc76f122413e47845df125a16667d5c97c963d41af"
    },
    {
      "source_id": "fr81-u175-r0038",
      "target": "— Так вы, значит, поедете вместе, и он не будет знать, кто вы?",
      "source_sha256": "990b4fd02296876b9be73f9d8c967667531cb6554d850b459e000c379fd874ff",
      "target_id": "ru-fr81-u175-r0038",
      "tag": "prose",
      "target_sha256": "83cf20afc9f98184ee89596c9e918705244b620e38b74cb49b3701a237046095"
    },
    {
      "source_id": "fr81-u175-r0039",
      "target": "— Он на империале, я в купе.",
      "source_sha256": "3d94365a0acdfe3fa3773802ea86bb9bf1c428d77942cc49efd9cf49f7e6aeba",
      "target_id": "ru-fr81-u175-r0039",
      "tag": "prose",
      "target_sha256": "817c5d18e161a94df4b7c6bc170f025e69e1b6f95c9745152428d839ddbf1655"
    },
    {
      "source_id": "fr81-u175-r0040",
      "target": "— Куда идёт этот дилижанс?",
      "source_sha256": "5070c57b926cb15f02339a58adaf17d859030256cc0b4298f9efaecfbda1f43a",
      "target_id": "ru-fr81-u175-r0040",
      "tag": "prose",
      "target_sha256": "f017f1b3dcc83352f40a9a38e7d0024c37c2300333630a1d421246ea2101359d"
    },
    {
      "source_id": "fr81-u175-r0041",
      "target": "— В Лез-Андели.",
      "source_sha256": "725c84905a8305958a93853c6cba4ae91dcc41699b9f9d3bb86e11a6b8fe3047",
      "target_id": "ru-fr81-u175-r0041",
      "tag": "prose",
      "target_sha256": "23a371ab6fc96c83d361e26ea9b520a22e5bdf8d5e5cd284561261a172e87a7e"
    },
    {
      "source_id": "fr81-u175-r0042",
      "target": "— Так, значит, Мариус едет туда?",
      "source_sha256": "0c5a4fd00fc9b70c39641b274af5f1b0fdef62cfa6ee2d958bea5a8853c75599",
      "target_id": "ru-fr81-u175-r0042",
      "tag": "prose",
      "target_sha256": "b9f2c9f1db8330e31657a771c9fded9aa5a43bb1a106b7e15e35f0298f64740b"
    },
    {
      "source_id": "fr81-u175-r0043",
      "target": "— Если только он, как и я, не сойдёт по дороге. Я схожу в Верноне, чтобы пересесть на гайонский дилижанс. О маршруте Мариуса мне ничего не известно.",
      "source_sha256": "fa1cc9c5db5e38ccc07f2e44322a69a6bbb2d8503eddf74e49b048d604e360ab",
      "target_id": "ru-fr81-u175-r0043",
      "tag": "prose",
      "target_sha256": "b8400585a32cb3f5799867eb6a64131518d1e5317089fc422a5bd5d6d04a6e4a"
    },
    {
      "source_id": "fr81-u175-r0044",
      "target": "— Мариус! Что за гадкое имя! Что за мысль была — назвать его Мариусом! Тогда как ты, по крайней мере, зовёшься Теодюлем!",
      "source_sha256": "3b6f45262130e7f51bf7521c565bd093795db8fe82c1a0388fae4fd52df531af",
      "target_id": "ru-fr81-u175-r0044",
      "tag": "prose",
      "target_sha256": "d9012e9fb46140925fe88ab4218390ef742773488c717d963753517293b3edc5"
    },
    {
      "source_id": "fr81-u175-r0045",
      "target": "— Я предпочёл бы зваться Альфредом, — сказал офицер.",
      "source_sha256": "fa44faa08dcada776755e35528b6485b42419bac803946a207bba23b0faa9028",
      "target_id": "ru-fr81-u175-r0045",
      "tag": "prose",
      "target_sha256": "8169996e065cb6103d49477792ab8ac37a5c0da75a2ba436be16cd6883980f81"
    },
    {
      "source_id": "fr81-u175-r0046",
      "target": "— Послушай, Теодюль.",
      "source_sha256": "50091822f9a2b06950f80f2c62172096514db8da04d99758645ebbb3d76e4188",
      "target_id": "ru-fr81-u175-r0046",
      "tag": "prose",
      "target_sha256": "8e61ad4b8285fd5083dbc7f8dfda4ee5891bd664b5c88e2b9a64d482fb618743"
    },
    {
      "source_id": "fr81-u175-r0047",
      "target": "— Слушаю, тётушка.",
      "source_sha256": "e0aacb8fc32141ec919093c6e1a340cd270ff4946e3f5ec280497dba7dd96f90",
      "target_id": "ru-fr81-u175-r0047",
      "tag": "prose",
      "target_sha256": "f514151322c3cf21ab72af821d9af6497f471e99b30cf0518d923cb454a49293"
    },
    {
      "source_id": "fr81-u175-r0048",
      "target": "— Будь внимателен.",
      "source_sha256": "b46258e74a84e839df43d11d7c962e8880a0aa0d6928ded0dd43e86957e82032",
      "target_id": "ru-fr81-u175-r0048",
      "tag": "prose",
      "target_sha256": "7fa8fe74e620f026317df73a9a961201d8f19573449e913c3f8e99bf8412915f"
    },
    {
      "source_id": "fr81-u175-r0049",
      "target": "— Я внимателен.",
      "source_sha256": "abd3bbb8778bc376084c29ad3d079503fc630078ee6a093a72bf21955f52c5f1",
      "target_id": "ru-fr81-u175-r0049",
      "tag": "prose",
      "target_sha256": "bbf23e22c76535cda3dcf0fcfa308c61e04dd4bc6be2fe8390d2ef18e242c7bf"
    },
    {
      "source_id": "fr81-u175-r0050",
      "target": "— Готов?",
      "source_sha256": "5e48964f823d7a4b3b63a7f629873597ae5fed4d87f96beea6c720607dcf188a",
      "target_id": "ru-fr81-u175-r0050",
      "tag": "prose",
      "target_sha256": "65d8b614efe27b4cef5c199bf03a5e4e770eef4feba01bde5ea6ada667dab344"
    },
    {
      "source_id": "fr81-u175-r0051",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u175-r0051",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u175-r0052",
      "target": "— Так вот, Мариус стал отлучаться.",
      "source_sha256": "eee35b50f3b6dc5b0ad4e22b6fb52f723c80f5f7cb786db8ead409e6f30c8401",
      "target_id": "ru-fr81-u175-r0052",
      "tag": "prose",
      "target_sha256": "d18228b048515f1fe0eab2d5041a4d808ebedd431d684ca68887877e9b777b2a"
    },
    {
      "source_id": "fr81-u175-r0053",
      "target": "— Э-э!",
      "source_sha256": "e2e9270cef431de0fcf490e29d1720bcc3a7360881308269ea1909a8b15e4180",
      "target_id": "ru-fr81-u175-r0053",
      "tag": "prose",
      "target_sha256": "9af1bfb9bfba91cc5ac8cde389b4206b590db1e058a5108c7a5a47ea580cf054"
    },
    {
      "source_id": "fr81-u175-r0054",
      "target": "— Он путешествует.",
      "source_sha256": "0c23ccf6c150b2369a82725119cb16909cbb9542729b31f03f1a8af98e1a5882",
      "target_id": "ru-fr81-u175-r0054",
      "tag": "prose",
      "target_sha256": "8819a69fc1e44a9c2e8d666bc41001b77ff90c8085257540e2cc4c61c66a1db6"
    },
    {
      "source_id": "fr81-u175-r0055",
      "target": "— А-а!",
      "source_sha256": "cb944953a25ad94ff22fbb97aba250f76be54141b421fd6a3711c7e051e13925",
      "target_id": "ru-fr81-u175-r0055",
      "tag": "prose",
      "target_sha256": "045950c128a407c06993065164f7827c28969e4faf4228f5a30cb5de02ec50ef"
    },
    {
      "source_id": "fr81-u175-r0056",
      "target": "— Он не ночует дома.",
      "source_sha256": "20c990700d14a4265f77239a8981b6fc812031ba0bab0eef35ac50479b58ace2",
      "target_id": "ru-fr81-u175-r0056",
      "tag": "prose",
      "target_sha256": "f86e1aaf3525da52a3fbef69e62663d992979ac4a99388ed60763e7206e35a85"
    },
    {
      "source_id": "fr81-u175-r0057",
      "target": "— О-о!",
      "source_sha256": "642f9889c7af94ef96a61b2d028a2ccfaf44b42db18b573d9b3103a87433b915",
      "target_id": "ru-fr81-u175-r0057",
      "tag": "prose",
      "target_sha256": "016cb0ca9133316462a2174c5da64844700999be1aa85f4531b08b539882b57c"
    },
    {
      "source_id": "fr81-u175-r0058",
      "target": "— Нам бы хотелось знать, что за всем этим кроется.",
      "source_sha256": "d26b00e7a2963e7d7558e1d4b88d4206de35131d644c13a97ab23febdc058a30",
      "target_id": "ru-fr81-u175-r0058",
      "tag": "prose",
      "target_sha256": "8203a458917ec366c55740e566746c2f933044fb4a559e65656bb009d2013479"
    },
    {
      "source_id": "fr81-u175-r0059",
      "target": "Теодюль ответил со спокойствием человека, дублёного жизнью:",
      "source_sha256": "e751279d390e97ae463b9833f82fe7f430b1d516598b3fb412ff906a88b4a079",
      "target_id": "ru-fr81-u175-r0059",
      "tag": "prose",
      "target_sha256": "15da60f0df07ad47be190fd7f48dafdf4e8636ded5bb81c4152c7909a5541a05"
    },
    {
      "source_id": "fr81-u175-r0060",
      "target": "— Какая-нибудь юбка.",
      "source_sha256": "f645b1628572bfbbd613c82d3399e21077f0ab4b56518fce4de71cc74d1b7d6c",
      "target_id": "ru-fr81-u175-r0060",
      "tag": "prose",
      "target_sha256": "231bd26ad4e9d3a3301219074332f919051a121ab99b40d70cb868b312bd35e1"
    },
    {
      "source_id": "fr81-u175-r0061",
      "target": "И с тем смешком сквозь зубы, что выдаёт уверенность, он добавил:",
      "source_sha256": "a0cf9684e58e9bdf98cbdae2a7c5e30596d37452e0d626c4604cac03de9733be",
      "target_id": "ru-fr81-u175-r0061",
      "tag": "prose",
      "target_sha256": "7664f937d06be2c90efef633fc32af7542a32b5aea2af43eb99acb0dd74af53e"
    },
    {
      "source_id": "fr81-u175-r0062",
      "target": "— Девчонка.",
      "source_sha256": "a10bb64267f846cec7d94eddd8d8813c98affcd628ac7af52fa5caa185088595",
      "target_id": "ru-fr81-u175-r0062",
      "tag": "prose",
      "target_sha256": "770a32615f696f6b69fe1d296dc7fedf710fc218802e1bb932598436cb989394"
    },
    {
      "source_id": "fr81-u175-r0063",
      "target": "— Это очевидно, — воскликнула тётка, которой почудилось, будто говорит сам г-н Жильнорман, и которая почувствовала, как её убеждённость неудержимо рождается из этого слова [[I]]девчонка[[/I]], произнесённого почти одинаково и двоюродным дедом, и внучатым племянником. Она продолжала:",
      "source_sha256": "76c8bba6840a5205d78462b564ea19db95793b480077869ed0b2af513f3ceeff",
      "target_id": "ru-fr81-u175-r0063",
      "tag": "prose",
      "target_sha256": "891f5326af08b18e15bd98b3efd06dae778956b0e97308867ea17ffbf7f8bc07"
    }
  ],
