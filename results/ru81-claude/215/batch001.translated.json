{
  "unit": 215,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u215-r0032",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u215-r0032",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u215-r0033",
      "target": "— И не видели такого здоровенного, толстого, грузного детину, похожего на слона из Ботанического сада?",
      "source_sha256": "2390fbc366b0eca8cc4b7ddfa9105fc8611c8c35e3bd143ea7faf97dafd52df8",
      "target_id": "ru-fr81-u215-r0033",
      "tag": "prose",
      "target_sha256": "9fd20a8a474bf3e84b252c73ee9501c92591a9138be20f0c0afee39771f67b92"
    },
    {
      "source_id": "fr81-u215-r0034",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u215-r0034",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u215-r0035",
      "target": "— И такого хитреца, у которого вид старого «краснохвоста»?",
      "source_sha256": "1dfa9c7860fa67cbe72a3e4855f297f92152d94100a2a9733156073c07736b49",
      "target_id": "ru-fr81-u215-r0035",
      "tag": "prose",
      "target_sha256": "d9435870f1981e1cf38b317a15ff9e9417d7fe6b7fa279b097906cb33c3d2046"
    },
    {
      "source_id": "fr81-u215-r0036",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u215-r0036",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u215-r0037",
      "target": "— Что до четвёртого, его не видит никто, даже его помощники, приказчики и служащие. Неудивительно, что вы его не заметили.",
      "source_sha256": "5d894b612d898bfd1777f25d0ae714b61acc1257380604e4abaff28e8db2ebf4",
      "target_id": "ru-fr81-u215-r0037",
      "tag": "prose",
      "target_sha256": "7c35a4afe1d0d5a526f7e35628a9df5c248f63ac297525e362264666743d68e0"
    },
    {
      "source_id": "fr81-u215-r0038",
      "target": "— Нет. Кто они такие, — спросил Мариус, — все эти люди?",
      "source_sha256": "f9bf671d739cf036592ecb377aae05dd7c4a2383c55cf51917e3a6909d0d2c50",
      "target_id": "ru-fr81-u215-r0038",
      "tag": "prose",
      "target_sha256": "12e9d051d739c0fa687fd3ddbfd5c89010eab63b8090870c933b60099e81dd29"
    },
    {
      "source_id": "fr81-u215-r0039",
      "target": "Инспектор ответил:",
      "source_sha256": "43896744185facd309699c4663a93b6efb7fe9f9a49c7181f3dd45adfe578f4d",
      "target_id": "ru-fr81-u215-r0039",
      "tag": "prose",
      "target_sha256": "13bf0028d27d2f5e470585075c0aee08735274d5782a1331baa62f0e153644ab"
    },
    {
      "source_id": "fr81-u215-r0040",
      "target": "— Впрочем, сейчас не их время.",
      "source_sha256": "365d4a80ec623cd53f2c4c795198d307c97a13c9748cf74e067f61fe8d4cbc49",
      "target_id": "ru-fr81-u215-r0040",
      "tag": "prose",
      "target_sha256": "e4cb90fcb4cfc81714df9e227eac53bfcae9ca503211417e5168a2ecb59fb611"
    },
    {
      "source_id": "fr81-u215-r0041",
      "target": "Он снова замолчал, потом продолжал:",
      "source_sha256": "c8bf3220a3b89d410020a3875e3f6d3e49fe5772aa23a943fc92f24dabd4b08f",
      "target_id": "ru-fr81-u215-r0041",
      "tag": "prose",
      "target_sha256": "2d24dc1a2e2341b215d16efb8f6f2a5b9acb3bbd391e19a7ac2e254d23095896"
    },
    {
      "source_id": "fr81-u215-r0042",
      "target": "— 50–52. Я знаю эту лачугу. Спрятаться внутри так, чтобы артисты этого не заметили, невозможно. Тогда им останется только отменить водевиль. Они так скромны! Публика их стесняет. Нет уж, нет уж. Я хочу послушать, как они поют, и заставить их потанцевать.",
      "source_sha256": "0dad816224bdc713dac71bb1ba9847094dfea42b6a99cf178ce3ad159745075a",
      "target_id": "ru-fr81-u215-r0042",
      "tag": "prose",
      "target_sha256": "373af5b9e959a1c3291f017c26e5d2021f5de15903e906f13f45af5e75a5a171"
    },
    {
      "source_id": "fr81-u215-r0043",
      "target": "Закончив этот монолог, он повернулся к Мариусу и спросил, пристально глядя на него:",
      "source_sha256": "9886a87cd34f3b1548fe8249ab47f95897d1850d2dd4bf26daf1e1566096fac6",
      "target_id": "ru-fr81-u215-r0043",
      "tag": "prose",
      "target_sha256": "bdb3ce3ed5bb4deb2ea8e7bb6a568cf9f9a4fe1ec85fabfb8910bf7057031150"
    },
    {
      "source_id": "fr81-u215-r0044",
      "target": "— Вам не будет страшно?",
      "source_sha256": "5430902bd65adc4443830244bd7b1ec92086bc6e6f63a848be9effd7af9e00e5",
      "target_id": "ru-fr81-u215-r0044",
      "tag": "prose",
      "target_sha256": "ff750de0b6674f59533d5f51632de0d3a35f2ae88c50665dc5b4441226c3fa60"
    },
    {
      "source_id": "fr81-u215-r0045",
      "target": "— Чего? — сказал Мариус.",
      "source_sha256": "653f11f29ab8798817d047f033ff05124842b4cb6f90c2c2af46a14430d3fc59",
      "target_id": "ru-fr81-u215-r0045",
      "tag": "prose",
      "target_sha256": "d46a021607adfa5b8fb38cd67a6ab26ec2034ceccf8eb60e200adb34679b276d"
    },
    {
      "source_id": "fr81-u215-r0046",
      "target": "— Этих людей?",
      "source_sha256": "eb7eeb4eb57eba210ff4ccd52f1c5d0b55def0781902cd03690a162ea560539d",
      "target_id": "ru-fr81-u215-r0046",
      "tag": "prose",
      "target_sha256": "c4ed7518f827fd98cc04e06880b96ec7443db7040e3ae0a175e31d468d67e913"
    },
    {
      "source_id": "fr81-u215-r0047",
      "target": "— Не больше, чем вас! — резко возразил Мариус, начинавший замечать, что этот шпик ни разу ещё не назвал его «сударь».",
      "source_sha256": "3a3d0fdb02c72457d44f4945163976d8eb026278e9881b726e54efa5450b09c1",
      "target_id": "ru-fr81-u215-r0047",
      "tag": "prose",
      "target_sha256": "078efeeaea1bce8a741bad031b69eb6c163b727229b6d527091765157ec19a38"
    },
    {
      "source_id": "fr81-u215-r0048",
      "target": "Инспектор посмотрел на Мариуса ещё пристальнее и продолжал с какой-то назидательной торжественностью:",
      "source_sha256": "97344f4c6d61344dcc7258fc5f5828079645cdc607ce7ec62608dc54137f16e6",
      "target_id": "ru-fr81-u215-r0048",
      "tag": "prose",
      "target_sha256": "1d595d731aa7cf7a283637f098245436727bdcaaf3b5fe800dff3e6a3ec6a4b8"
    },
    {
      "source_id": "fr81-u215-r0049",
      "target": "— Вы говорите как человек храбрый и как человек честный. Мужество не боится преступления, а честность не боится власти.",
      "source_sha256": "fe01677572f5112096d6e6c9174d586b400cff8340ee01e4e9d0610630d9c66d",
      "target_id": "ru-fr81-u215-r0049",
      "tag": "prose",
      "target_sha256": "5066da25d2eb5fdd466cd6b7f61f6cd97f1d193eb67fecfb22111bd8bd4a57c8"
    },
    {
      "source_id": "fr81-u215-r0050",
      "target": "Мариус прервал его:",
      "source_sha256": "90904d79a30e7981ad870c0d6f5694436ca5c654f6d708a99c4593d06f48d07e",
      "target_id": "ru-fr81-u215-r0050",
      "tag": "prose",
      "target_sha256": "c01629170b4e8e8c4f572dad5d9a9b4ed2be0c5002a9a74f61b1f6900371b343"
    },
    {
      "source_id": "fr81-u215-r0051",
      "target": "— Хорошо; но что вы намерены делать?",
      "source_sha256": "e4bee3dd948db947db7a141af5429dd26355907daf1b2cd33d89873211ade288",
      "target_id": "ru-fr81-u215-r0051",
      "tag": "prose",
      "target_sha256": "4a1fe90809c7b8b6be887d4f04dfc708849410a4d1458b7cc2aec3e5f3270a1d"
    },
    {
      "source_id": "fr81-u215-r0052",
      "target": "Инспектор ограничился ответом:",
      "source_sha256": "965b6d1219b3f6fc4dd339391deeed24143bdd0b8b52b3c6af8edb9044976f83",
      "target_id": "ru-fr81-u215-r0052",
      "tag": "prose",
      "target_sha256": "f3959c853b4cca558348418ab55b396164dea04c5b330cc3a118474e384609f9"
    },
    {
      "source_id": "fr81-u215-r0053",
      "target": "— У жильцов этого дома есть ключи, чтобы возвращаться к себе ночью. Такой ключ должен быть и у вас?",
      "source_sha256": "63a0b2eaa32c7a2df9416ee1d2948dba8dba6b13e0ce3e64db694d173f41e548",
      "target_id": "ru-fr81-u215-r0053",
      "tag": "prose",
      "target_sha256": "644233bb0957a956b61992d4831fb85b0204fa1e1a45bfeebec7d972dae1f648"
    },
    {
      "source_id": "fr81-u215-r0054",
      "target": "— Да, — сказал Мариус.",
      "source_sha256": "4f6a41d3d0b70858dbb75d25c731f832157d7b802b1123379ef3a49c574c53e5",
      "target_id": "ru-fr81-u215-r0054",
      "tag": "prose",
      "target_sha256": "677a3131e4d1719bfbf32afb515a9b3fa7a72812e228df663bd3b7fde0021fbb"
    },
    {
      "source_id": "fr81-u215-r0055",
      "target": "— Он при вас?",
      "source_sha256": "f1daa795330d897aefeafdeb020712defe378b0a320b83893e200ce08682d16a",
      "target_id": "ru-fr81-u215-r0055",
      "tag": "prose",
      "target_sha256": "ac1dcca4354ae78b673af8364cd883bc603df3f2efc308698304d1ce09dcf44f"
    },
    {
      "source_id": "fr81-u215-r0056",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u215-r0056",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u215-r0057",
      "target": "— Дайте его мне, — сказал инспектор.",
      "source_sha256": "c2b1b9a0edcd5cd8e862778c64888698c0eb87688837212b92e89bf5a2b34f3c",
      "target_id": "ru-fr81-u215-r0057",
      "tag": "prose",
      "target_sha256": "a6379704ec7d732dad40195837b91eda2d1d4f0ccd36fc4d6afad7fa19e710d4"
    },
    {
      "source_id": "fr81-u215-r0058",
      "target": "Мариус достал ключ из жилета, отдал его инспектору и добавил:",
      "source_sha256": "61fcb8b0d745e64ea42e2c4c0264a9abfc5bfb728110ab1b1051c829b31c73f1",
      "target_id": "ru-fr81-u215-r0058",
      "tag": "prose",
      "target_sha256": "20292bf3f13c6f26aa36af0007bd6324142b5abdffa183e908059e3b0ff14c7b"
    },
    {
      "source_id": "fr81-u215-r0059",
      "target": "— Если вы мне поверите, вы придёте с большими силами.",
      "source_sha256": "3b1b539c8c96e6ab2b74a50d788542efb56ac6c55a3b98d7375bc5fc01bad546",
      "target_id": "ru-fr81-u215-r0059",
      "tag": "prose",
      "target_sha256": "3729379362149b2dc577aa78a31235fc820c947f8e0220211a6380d70250f4bb"
    },
    {
      "source_id": "fr81-u215-r0060",
      "target": "Инспектор бросил на Мариуса взгляд, каким Вольтер окинул бы провинциального академика, предложившего ему рифму; одним движением он погрузил обе свои огромные руки в два кармана карика и вытащил оттуда два маленьких стальных пистолета, из тех, что называют «кулачными». Протянув их Мариусу, он сказал быстро и отрывисто:",
      "source_sha256": "cbe85ebe032327325f54f8dcfd5f64343ba9fcc5d17c8049154a5dd5e77e6e7c",
      "target_id": "ru-fr81-u215-r0060",
      "tag": "prose",
      "target_sha256": "d69fc83e366372011f604b468b84a41c44dfb0adc7f3e8238864fd2890fa3bbc"
    },
    {
      "source_id": "fr81-u215-r0061",
      "target": "— Возьмите. Идите к себе. Спрячьтесь в своей комнате. Пусть думают, что вы ушли. Они заряжены. В каждом по две пули. Вы будете наблюдать: в стене есть дыра, как вы мне сказали. Люди придут. Дайте им немного разойтись. Когда сочтёте, что дело дошло до нужной точки и пора его остановить, выстрелите из пистолета. Не слишком рано. Остальное — моя забота. Один выстрел в воздух, в потолок, куда угодно. Главное — не слишком рано. Дождитесь, пока начнётся приступ к исполнению; вы же адвокат, вы знаете, что это такое.",
      "source_sha256": "968847cb8e43e7d1fd9321b8493910beb18136e40f2f7f96b6594295d1915c21",
      "target_id": "ru-fr81-u215-r0061",
      "tag": "prose",
      "target_sha256": "c18c14d778ae4f6fe6a3a3594b53b91d621d05c278d990b36cc62dbada96dcae"
    },
    {
      "source_id": "fr81-u215-r0062",
      "target": "Мариус взял пистолеты и положил их в боковой карман сюртука.",
      "source_sha256": "05c51d78dd9c8196971ccb3fb8b75542c71c263faf728b53171f50d867f91544",
      "target_id": "ru-fr81-u215-r0062",
      "tag": "prose",
      "target_sha256": "e3b56e2d6937bfee98d4ce6e3656bf6bad7f40f6c9800f9ca4a71ad495c4136b"
    },
    {
      "source_id": "fr81-u215-r0063",
      "target": "— Так получается бугор, это заметно, — сказал инспектор. — Положите их лучше в карманчики.",
      "source_sha256": "2bd71df43bb07c375b8e4c639822a1af7b46c5080e0f6a0a8f2c6141bb08e66e",
      "target_id": "ru-fr81-u215-r0063",
      "tag": "prose",
      "target_sha256": "fc77a18d02b38344565a82415d33d2204730a74bea3698379f3d6acb9766caef"
    }
  ],
