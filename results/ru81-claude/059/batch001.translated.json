{
  "unit": 59,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u059-r0032",
      "target": "Кто-то ответил:",
      "source_sha256": "f447fa79b50b69f851962bc94942e7a63337d27d20bfdb9aaae5004c3c319bfe",
      "target_id": "ru-fr81-u059-r0032",
      "tag": "prose",
      "target_sha256": "b54ab271b5680aee6f256225dd027438e653fc23943d1030db2b84c1baaca8a6"
    },
    {
      "source_id": "fr81-u059-r0033",
      "target": "— Это я, господин мэр.",
      "source_sha256": "91c3434db02734d7e5c7da818c30b7e1abf680ffcab12a2cf5bc1103f7a8f07b",
      "target_id": "ru-fr81-u059-r0033",
      "tag": "prose",
      "target_sha256": "02995c24b0b23de3ab1e4522e45a54f15a2065534eee049e78bf01c7ead64ba7"
    },
    {
      "source_id": "fr81-u059-r0034",
      "target": "Он узнал голос старухи, своей привратницы.",
      "source_sha256": "710acd0e555f2f2583bd227e6f3a8c430220c29806f842dc398f452b7563d489",
      "target_id": "ru-fr81-u059-r0034",
      "tag": "prose",
      "target_sha256": "de6ddd9ed443b32b7e9eaaff9f98b5472cc0ef0608ff59279c51a6f8cee6238a"
    },
    {
      "source_id": "fr81-u059-r0035",
      "target": "— Ну, что там? — спросил он.",
      "source_sha256": "29cbd7060d8ed2c340928bc2b201b0503c9e2343883b69d37fff51c7f987ada1",
      "target_id": "ru-fr81-u059-r0035",
      "tag": "prose",
      "target_sha256": "3d33d2ffc89bed6ade8f6cc759ea3244b0236dca86f41a6081b3e9f4bc94fb3c"
    },
    {
      "source_id": "fr81-u059-r0036",
      "target": "— Господин мэр, сейчас пять часов утра.",
      "source_sha256": "1bb3feb8ffe151561672f005bc264e7b75514da1483a2588836b7c5fbae8b912",
      "target_id": "ru-fr81-u059-r0036",
      "tag": "prose",
      "target_sha256": "7c61f36dce71160bd6dd76d2678d6962fd14dff4de6f197b1f52a9f669a1716e"
    },
    {
      "source_id": "fr81-u059-r0037",
      "target": "— Какое мне до этого дело?",
      "source_sha256": "437b67df715d6a5fd6293c2b2928e8b4cbf2025e136f13636c7b64993f3d609d",
      "target_id": "ru-fr81-u059-r0037",
      "tag": "prose",
      "target_sha256": "218693d650f96c5d8fbf60636c5d55c720264630718bc13f767feab158c2c6e2"
    },
    {
      "source_id": "fr81-u059-r0038",
      "target": "— Господин мэр, это кабриолет.",
      "source_sha256": "9753bccffe11ceae15002f280df78c621af2222424b5977347ac64f65287a4bc",
      "target_id": "ru-fr81-u059-r0038",
      "tag": "prose",
      "target_sha256": "91db820420e1aef1eb738ca3a15932d7d8e96e6d1a7383076753cb6381559ffb"
    },
    {
      "source_id": "fr81-u059-r0039",
      "target": "— Какой кабриолет?",
      "source_sha256": "2c38b7bed8572c691d9d61ef9f3de100f200351d5bdcac36d269b99e2acef40f",
      "target_id": "ru-fr81-u059-r0039",
      "tag": "prose",
      "target_sha256": "ab1722ad911074fafb0bb2f1f4cad36837780298e22384dfdb6b3342310378be"
    },
    {
      "source_id": "fr81-u059-r0040",
      "target": "— Тильбюри.",
      "source_sha256": "eabf99d48bd146783b0034645a679aeb1af464600d539917cf01c821860a2099",
      "target_id": "ru-fr81-u059-r0040",
      "tag": "prose",
      "target_sha256": "108617e0bd7b37a7fc823182c3ca7a4577f9b3666ad15616365183206c172db9"
    },
    {
      "source_id": "fr81-u059-r0041",
      "target": "— Какой тильбюри?",
      "source_sha256": "0b28adccca77c14fdc41779be99fc915f20c5dd71941dbcb8bd5830364b0d866",
      "target_id": "ru-fr81-u059-r0041",
      "tag": "prose",
      "target_sha256": "030a26b306f721626fcd031e06266b9d2005db9329dadc0dddb39362d4c3004f"
    },
    {
      "source_id": "fr81-u059-r0042",
      "target": "— Разве господин мэр не посылал за тильбюри?",
      "source_sha256": "f19e74fce8e5189cd72b152368fa90ab8b9f8fa990dd8adfbab9b532770b6a13",
      "target_id": "ru-fr81-u059-r0042",
      "tag": "prose",
      "target_sha256": "30eaea3457ed4f91bd51a44cbd78094a3daea101b568cfbfcba388f78ad979c5"
    },
    {
      "source_id": "fr81-u059-r0043",
      "target": "— Нет, — сказал он.",
      "source_sha256": "92ad0e5165db35e33ec5b0a5d99367ef760f74082ea4dacd854d1797f56c8c4c",
      "target_id": "ru-fr81-u059-r0043",
      "tag": "prose",
      "target_sha256": "86cbacd525c540b3da4ba3920c3ead487e677fd78b76af24030fc62c96108f2e"
    },
    {
      "source_id": "fr81-u059-r0044",
      "target": "— Кучер говорит, что приехал за господином мэром.",
      "source_sha256": "e3798fdbc7445100400b48cf0d66e9b53ed61151607683b62e49561e9cd50291",
      "target_id": "ru-fr81-u059-r0044",
      "tag": "prose",
      "target_sha256": "6fb9a7ac302d11c05fd0ff3cf0444efe04f19419970817261d994edfbebdf0d9"
    },
    {
      "source_id": "fr81-u059-r0045",
      "target": "— Какой кучер?",
      "source_sha256": "c00a2be41b05b7b806fb35264a7152f384abf75ef5c7ab114b8754bdd3e0508d",
      "target_id": "ru-fr81-u059-r0045",
      "tag": "prose",
      "target_sha256": "e5cc8f4f977e21769aea1347bf4d32ab223cc6f100f597de25807d7139f36749"
    },
    {
      "source_id": "fr81-u059-r0046",
      "target": "— Кучер господина Скофлера.",
      "source_sha256": "5de23b5ce92818ab86efd0c06655f476518f4b62fe79df1c5a18bdb57a30188e",
      "target_id": "ru-fr81-u059-r0046",
      "tag": "prose",
      "target_sha256": "f19bd70e0e17c0d6cd8acbe70805d65dd4fa12759dd52817959498ab0b348920"
    },
    {
      "source_id": "fr81-u059-r0047",
      "target": "— Господина Скофлера?",
      "source_sha256": "7f0ae50737ed71c4b5308059868ac938d501c1b67311f477b364e574ee92c09e",
      "target_id": "ru-fr81-u059-r0047",
      "tag": "prose",
      "target_sha256": "9f3b9ad8ba7db0bf7cc81d3beee00536ecf64cbc5284207cff8b632bb19ffeb5"
    },
    {
      "source_id": "fr81-u059-r0048",
      "target": "Это имя заставило его вздрогнуть, словно молния пронеслась у него перед лицом.",
      "source_sha256": "489dfb88c6333249788ded8953339262bee55134d5cb038e3daa2ea2c15443bf",
      "target_id": "ru-fr81-u059-r0048",
      "tag": "prose",
      "target_sha256": "b8323197525c5a9e15db77607e86d782578e4986d919cf84a40f123934a7aa69"
    },
    {
      "source_id": "fr81-u059-r0049",
      "target": "— Ах да! — сказал он. — Господина Скофлера.",
      "source_sha256": "47dd56f86616402c8816d68622db25f4f3e850798f0955678895ab6e75917a60",
      "target_id": "ru-fr81-u059-r0049",
      "tag": "prose",
      "target_sha256": "039528caf0ccd1ef83eb3c7d3c1df7bc4b2251c12b6ae88155e3924b7a4b43ef"
    },
    {
      "source_id": "fr81-u059-r0050",
      "target": "Если бы старуха могла видеть его в эту минуту, она пришла бы в ужас.",
      "source_sha256": "5eee57714a6dc277f5330606ae957804057f966bbfd6108b4bb4e24df24f9734",
      "target_id": "ru-fr81-u059-r0050",
      "tag": "prose",
      "target_sha256": "198627ff317649b23dd8842ffb77dd71c3b4c6fa1c79ef5b3c8ba119b252c80a"
    },
    {
      "source_id": "fr81-u059-r0051",
      "target": "Наступило довольно долгое молчание. Он с тупым видом разглядывал пламя свечи и собирал вокруг фитиля горячий воск, скатывая его в пальцах. Старуха ждала. Всё же она отважилась снова возвысить голос:",
      "source_sha256": "398ae093dfb71bf63735ef8a50ee46719ee81e221eaeba5ea384d6a6388e500b",
      "target_id": "ru-fr81-u059-r0051",
      "tag": "prose",
      "target_sha256": "b9ca8d080f1a75d083ec36d10bf0704d69f7ae3a05e23b9e0cec32ca2e794121"
    },
    {
      "source_id": "fr81-u059-r0052",
      "target": "— Господин мэр, что мне ответить?",
      "source_sha256": "4b5d6a4225e264de2839dceafe17a37a30a170b0ef4e7c9a82d3f9c931e7fca2",
      "target_id": "ru-fr81-u059-r0052",
      "tag": "prose",
      "target_sha256": "0fadcdcf6589911f9ad040d4e080e21c6febfaba1221096550b8f513cb28cb16"
    },
    {
      "source_id": "fr81-u059-r0053",
      "target": "— Скажите, что хорошо и что я сейчас спущусь.",
      "source_sha256": "529f8fa2dba492069cda773c073f0d1a985501b0959bda5135430a2e6a3d9ca0",
      "target_id": "ru-fr81-u059-r0053",
      "tag": "prose",
      "target_sha256": "59cdc5387e4cef7fd76c419e8608d758b0bac1c9ec71114d89a467b08382f391"
    },
    {
      "source_id": "fr81-u059-r0054",
      "target": "Эта скобка написана рукой Жана Вальжана.",
      "source_sha256": "922bfa4259e2b14f25373d6c9436bb04f7751b7c7cab530ebf9516f27195e697",
      "target_id": "ru-fr81-u059-r0054",
      "tag": "footnote",
      "target_sha256": "5ab28ff89d245d089a60460d437c29422a7a60cac3db9731de3e2b6bd09dc6ac"
    }
  ],
