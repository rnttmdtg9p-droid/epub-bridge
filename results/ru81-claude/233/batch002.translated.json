{
  "unit": 233,
  "batch": 2,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u233-r0064",
      "target": "— Сию минуту.",
      "source_sha256": "186a6ae0f62b956b5c54a308e0f7dd69c633bed88ea9c2ec557783157d2a0e5e",
      "target_id": "ru-fr81-u233-r0064",
      "tag": "prose",
      "target_sha256": "d2645319e8991bde2c41949c5707e6edfcbb76d23eb0e5b6bfc9ed9d1088247f"
    },
    {
      "source_id": "fr81-u233-r0065",
      "target": "— Идёмте. — Ох, до чего же он рад! — сказала она.",
      "source_sha256": "c78f7cade7779854638c29474dc7664844a73d68a593a229187e5f8957608e02",
      "target_id": "ru-fr81-u233-r0065",
      "tag": "prose",
      "target_sha256": "be1923c9bc13216744e5e01706e38091e79df8fd1db79f8f67962d8290ee0784"
    },
    {
      "source_id": "fr81-u233-r0066",
      "target": "Сделав несколько шагов, она остановилась.",
      "source_sha256": "bc47233be61d7521cd8ce97a161ab4fda892d93ebfa43119988a1b9b936b1fa2",
      "target_id": "ru-fr81-u233-r0066",
      "tag": "prose",
      "target_sha256": "a1f266cb4404928d5cc7a8748f8078b1e526410a00033124334a785c618ce1f7"
    },
    {
      "source_id": "fr81-u233-r0067",
      "target": "— Вы идёте слишком близко, господин Мариус. Пустите меня вперёд, а сами идите за мной вот так, как будто вы тут ни при чём. Не надо, чтобы видели, как приличный молодой человек, вроде вас, идёт с такой женщиной, как я.",
      "source_sha256": "8fb7d0afceaea2e5387ee03adf414d320c33ad29a17ad4eed3620c3b88d8ad39",
      "target_id": "ru-fr81-u233-r0067",
      "tag": "prose",
      "target_sha256": "4ca9ef3ba6fa943dc6be1af6f2b7b4ea86bd7f84b7906819388e0bd3c097f419"
    },
    {
      "source_id": "fr81-u233-r0068",
      "target": "Никакой язык не сумел бы выразить всё, что заключалось в этом слове «женщина», произнесённом этим ребёнком.",
      "source_sha256": "b7f690b288c1046b2bb16dfde37e19e89f294a48dc551e408476efe561f5cb80",
      "target_id": "ru-fr81-u233-r0068",
      "tag": "prose",
      "target_sha256": "dc6e7e74495d51e18672a17d0aa3f1ab6f5d29db134787a4b98a903bb625b9fa"
    },
    {
      "source_id": "fr81-u233-r0069",
      "target": "Она прошла шагов десять и снова остановилась; Мариус нагнал её. Она заговорила с ним, обращаясь в сторону и не поворачиваясь к нему:",
      "source_sha256": "a28fd52c2480ddfe293abd2783dc430d2472d82b8f92d8a9db84c51d418f61db",
      "target_id": "ru-fr81-u233-r0069",
      "tag": "prose",
      "target_sha256": "0f812f9a9cbd1b869996cf7a43133b06e89ecdf16c37e9a14f298869feac38e1"
    },
    {
      "source_id": "fr81-u233-r0070",
      "target": "— Кстати, вы ведь помните, что кое-что мне обещали?",
      "source_sha256": "85253be4da214e9768eb71d02164060c1d27db15a61c45bd0a10f58189dc5129",
      "target_id": "ru-fr81-u233-r0070",
      "tag": "prose",
      "target_sha256": "2276ea635e5570ed5874f961d7e4d14c225356faa9ea8f64eca8d75f73279d77"
    },
    {
      "source_id": "fr81-u233-r0071",
      "target": "Мариус порылся в кармане. У него не было на свете ничего, кроме пяти франков, предназначенных папаше Тенардье. Он вынул их и вложил в руку Эпонине.",
      "source_sha256": "ffab29bb5b064339c3fdc1887562734a89341ee381ad60ae6c4f07bf4dc25558",
      "target_id": "ru-fr81-u233-r0071",
      "tag": "prose",
      "target_sha256": "0c7a1f10d8df5378d24f7da2ada9ce5a305a47a7407ec14da0a5593b848504c3"
    },
    {
      "source_id": "fr81-u233-r0072",
      "target": "Она разжала пальцы, уронила монету на землю и, мрачно глядя на него, сказала:",
      "source_sha256": "62f5717809d2df92215f910200591d6bc01af06c85d9f2279f85118ba211dfa9",
      "target_id": "ru-fr81-u233-r0072",
      "tag": "prose",
      "target_sha256": "0cdcd0f08370e27a0758b732024019310d25ac97723fb3ea0d1c2c6fef335323"
    },
    {
      "source_id": "fr81-u233-r0073",
      "target": "— Мне не нужны ваши деньги, — сказала она.",
      "source_sha256": "25d28131e559f9b877da99796888c2b6b76950997fa75406c1492be32794082b",
      "target_id": "ru-fr81-u233-r0073",
      "tag": "prose",
      "target_sha256": "a7652c3c2206822050698f09992fd54a63def5cdc3353378330d0a30fd8fa8a8"
    }
  ],
