{
  "unit": 221,
  "batch": 4,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u221-r0128",
      "target": "— «Приезжай немедленно…»",
      "source_sha256": "e4591d19ff96a35877acbe98efbd30907ddc9b7af9dea09c4dc185804812fde6",
      "target_id": "ru-fr81-u221-r0128",
      "tag": "prose",
      "target_sha256": "483a953ac05bace424d901456c847d0b699eb5edb6f8ae7d64faf748a2349f8f"
    },
    {
      "source_id": "fr81-u221-r0129",
      "target": "Он прервался.",
      "source_sha256": "cf92c287169b307508a0c937b6c70e728dbdf1818f8a99978d89c42942415a29",
      "target_id": "ru-fr81-u221-r0129",
      "tag": "prose",
      "target_sha256": "2583d483204e9a38a64e841220e143f13c944251d607eef176e5eada4ed8fbce"
    },
    {
      "source_id": "fr81-u221-r0130",
      "target": "— Вы ведь говорите ей «ты», не так ли?",
      "source_sha256": "6626d885225ca2fd0de72307c8d0ea2ed98c4cac7a1156ad0f338196303eefc6",
      "target_id": "ru-fr81-u221-r0130",
      "tag": "prose",
      "target_sha256": "4788642508dcc940d92908856b6c8760da821657d7da20151bdfa89ff3f5ae2e"
    },
    {
      "source_id": "fr81-u221-r0131",
      "target": "— Кому? — спросил господин Леблан.",
      "source_sha256": "0aa815e83be5f78e03b368949651dd10659634ffebd6be4f5daffaaf13048463",
      "target_id": "ru-fr81-u221-r0131",
      "tag": "prose",
      "target_sha256": "dcec3763059ae8eff32d180b25e6960b7919e596cd96d51d02c26bcc2f32dbf0"
    },
    {
      "source_id": "fr81-u221-r0132",
      "target": "— Черт возьми! — сказал Тенардье. — Малышке, Жаворонку.",
      "source_sha256": "2bad1898998666db303f65125ed5427d38770e10df171c673f66bf9d70672afe",
      "target_id": "ru-fr81-u221-r0132",
      "tag": "prose",
      "target_sha256": "7c95d35c4d98167ee7bfa2a9dc6cf5a2cdd46363f7f8fa3f5ebab5be52069ab3"
    },
    {
      "source_id": "fr81-u221-r0133",
      "target": "Господин Леблан ответил без малейшего видимого волнения:",
      "source_sha256": "6387ed3fd5ce983e5a2358d2e80fcdfe23b6b4225e76bd1cd6875892ba40f2df",
      "target_id": "ru-fr81-u221-r0133",
      "tag": "prose",
      "target_sha256": "2ff96b919838ae9035b230e16f45f78ee51484e4ca3abf8521191fa0709dd323"
    },
    {
      "source_id": "fr81-u221-r0134",
      "target": "— Я не понимаю, что вы хотите сказать.",
      "source_sha256": "45155fbd55ab42b2a909941b380b556f27bd228a76790e577a66ec6ee37952e0",
      "target_id": "ru-fr81-u221-r0134",
      "tag": "prose",
      "target_sha256": "e682f98d28341860fd06425ab4fd712172b8ecb3edc6ae7edb8119f375e97d2b"
    },
    {
      "source_id": "fr81-u221-r0135",
      "target": "— Пишите дальше, — бросил Тенардье и снова принялся диктовать.",
      "source_sha256": "9214fd6badb48735d820e6b4cff497beeace8954eb618057f52b6a7ff3f1e8d2",
      "target_id": "ru-fr81-u221-r0135",
      "tag": "prose",
      "target_sha256": "1fd33d6d8ffd62a76c18180847ae90a90dbc0fa286935f044f33cddf4bf227d0"
    },
    {
      "source_id": "fr81-u221-r0136",
      "target": "— «Приезжай немедленно. Ты мне совершенно необходима. Особа, которая передаст тебе эту записку, должна привезти тебя ко мне. Я жду тебя. Приезжай с доверием.»",
      "source_sha256": "68aa0b5d1945da769bfc1afa3f834ddfcc316e573faf754c6810601e4f2c9389",
      "target_id": "ru-fr81-u221-r0136",
      "tag": "prose",
      "target_sha256": "ca88b3ac248b9eadc9731c4f458debf56230c38d7d5b91621eae9c902310cea5"
    },
    {
      "source_id": "fr81-u221-r0137",
      "target": "Господин Леблан всё написал. Тенардье продолжал:",
      "source_sha256": "ed7284bee75682043ee353dd87edf48611238d8893eb92ace96f05a11c298c29",
      "target_id": "ru-fr81-u221-r0137",
      "tag": "prose",
      "target_sha256": "7a341911c0fd84c1ba712df2843fedceb8ec46c742d039261a61d474c07e237f"
    },
    {
      "source_id": "fr81-u221-r0138",
      "target": "— Ах да! Зачеркните [[I]]приезжай с доверием[[/I]]: это могло бы навести на мысль, что дело не так просто и что недоверие возможно.",
      "source_sha256": "9ed05d19e3b5735df5af250ca9a420abfb1afca2b5e94f3e7d833c84d5ffd6f6",
      "target_id": "ru-fr81-u221-r0138",
      "tag": "prose",
      "target_sha256": "432914a204333c4fc63ec1a85eb160cc40b4920ffbb69275890066b0cead35fb"
    },
    {
      "source_id": "fr81-u221-r0139",
      "target": "Господин Леблан вычеркнул эти три слова.",
      "source_sha256": "df21cd8c3b7c10dcc6daa85ae48e7aa106e64f39a75d23a0e4658c63c93b6cc9",
      "target_id": "ru-fr81-u221-r0139",
      "tag": "prose",
      "target_sha256": "1e83b646dc681e3b0404f75298b624ef7013237e314204051345685dfc3b424a"
    },
    {
      "source_id": "fr81-u221-r0140",
      "target": "— А теперь, — продолжал Тенардье, — подпишитесь. Как вас зовут?",
      "source_sha256": "b32c8933ca534b947866b79b49f67e369a3fde5f1efa987c5094a9ebe265f094",
      "target_id": "ru-fr81-u221-r0140",
      "tag": "prose",
      "target_sha256": "c7cf7a22c8bb083650351bd6ecbb602bb9fc353be4022f32f18742c37c884a95"
    },
    {
      "source_id": "fr81-u221-r0141",
      "target": "Пленник положил перо и спросил:",
      "source_sha256": "6c3866a9fcce53a8ff1d9d000d291e3cf2e0096f7599ffd2741e09bd816343cf",
      "target_id": "ru-fr81-u221-r0141",
      "tag": "prose",
      "target_sha256": "f1355a60e2fed8399852d9ad4454d012cada1f4cb2caae01ded6ea84b8c87e7e"
    },
    {
      "source_id": "fr81-u221-r0142",
      "target": "— Кому это письмо?",
      "source_sha256": "a8e06337915d12f66c9132a4c9f0cd0f94aa6882f0e96480c157dab26aed5f06",
      "target_id": "ru-fr81-u221-r0142",
      "tag": "prose",
      "target_sha256": "e97aa89adb103ec97787d935e920d596ba80d7fa38b6f906df4c1b26dccaee26"
    },
    {
      "source_id": "fr81-u221-r0143",
      "target": "— Вы прекрасно знаете, — ответил Тенардье. — Малышке. Я же только что вам сказал.",
      "source_sha256": "f586a61188a448329f7c5aa83e154650e71c355ebd7d436faa001ee6c6146a6a",
      "target_id": "ru-fr81-u221-r0143",
      "tag": "prose",
      "target_sha256": "bebd533b2d560d0e8a4be1f480c62a5bc843ee7e969a5b9ba17a852b557073a5"
    },
    {
      "source_id": "fr81-u221-r0144",
      "target": "Было очевидно, что Тенардье избегает называть девушку, о которой шла речь. Он говорил «Жаворонок», говорил «малышка», но имени не произносил. Предосторожность ловкого человека, который хранит свою тайну от сообщников. Назвать имя значило выдать им всё «дело» и сообщить им больше, чем им нужно было знать.",
      "source_sha256": "0faaa038bcba9c85d9ee913eeb7d022030690175b28bd4ebff1a2bc90389f378",
      "target_id": "ru-fr81-u221-r0144",
      "tag": "prose",
      "target_sha256": "4c88f9af713aa5e5c8d9a8e797a3efe3b8238127219db1c3918661a47e9b1187"
    },
    {
      "source_id": "fr81-u221-r0145",
      "target": "Он продолжал:",
      "source_sha256": "120e08ee0bf97237ab06d70a2481790418e0487166aa04486f548b5cde0cc203",
      "target_id": "ru-fr81-u221-r0145",
      "tag": "prose",
      "target_sha256": "76563787f6be1a79b0f9d3f62e84871340ccbb8866d75889247de9f5344f6e81"
    },
    {
      "source_id": "fr81-u221-r0146",
      "target": "— Подписывайтесь. Как ваше имя?",
      "source_sha256": "4de869ee81d8a0367a096cbb088d54dfcdd46a64e98168d228e67f2184934a99",
      "target_id": "ru-fr81-u221-r0146",
      "tag": "prose",
      "target_sha256": "a1213be6740e6a9cb0bc076835dd793be98d0d3c65009d10375300b359c8e15c"
    },
    {
      "source_id": "fr81-u221-r0147",
      "target": "— Урбен Фабр, — сказал пленник.",
      "source_sha256": "b40582a4fd5a1b1020341048a78f111b5c101a4bf8485fa685618d44cb5f2e40",
      "target_id": "ru-fr81-u221-r0147",
      "tag": "prose",
      "target_sha256": "450f88e4d15f8879ce4bd66dc908d6bf027ce3f2d776629991e2fe9e960cf253"
    },
    {
      "source_id": "fr81-u221-r0148",
      "target": "Тенардье с кошачьей быстротой сунул руку в карман и вытащил носовой платок, отобранный у господина Леблана. Он поискал метку и поднёс платок к свече.",
      "source_sha256": "a8fb4ebdd3746b4e1c7eb7c92dbd56da36b07d7e11e38d57f5f87f558212a66f",
      "target_id": "ru-fr81-u221-r0148",
      "tag": "prose",
      "target_sha256": "8a6130e07f462cec3515faf80ee21a82f97511ab3a4caca93931e769564bffc6"
    },
    {
      "source_id": "fr81-u221-r0149",
      "target": "— У. Ф. Так и есть. Урбен Фабр. Ну что же, подпишите: У. Ф. Пленник подписал.",
      "source_sha256": "6835a3c8b173a1a313a71ea8466ba0436deeb42116b8031f8e1d7443a6bbb007",
      "target_id": "ru-fr81-u221-r0149",
      "tag": "prose",
      "target_sha256": "88fa466174941bf9d21ce2a16befd930d1f55e5501f355729ca5d92d0d99be10"
    },
    {
      "source_id": "fr81-u221-r0150",
      "target": "— Так как для складывания письма нужны обе руки, давайте, я сам его сложу.",
      "source_sha256": "56bfa4c15524d67dfc87c4d75d9e97bc78ce97eda14a910fce8f0ee66f81d357",
      "target_id": "ru-fr81-u221-r0150",
      "tag": "prose",
      "target_sha256": "aaa5fc0f5c33f7da02f50d2e1d6f254714a891eb3c2047f8fd91a3e46ea7cf7d"
    },
    {
      "source_id": "fr81-u221-r0151",
      "target": "Когда это было сделано, Тенардье продолжал:",
      "source_sha256": "2df911f0de64007ccfeec1ea7ccde8ec35f89aefedf8921e7a2bdcec57a395a1",
      "target_id": "ru-fr81-u221-r0151",
      "tag": "prose",
      "target_sha256": "b35728448a97a784977467bf47ece81586eedbaa2d153a7cc9fbd2e145e95e43"
    },
    {
      "source_id": "fr81-u221-r0152",
      "target": "— Напишите адрес. [[I]]Мадемуазель Фабр[[/I]], у вас дома. Я знаю, что вы живёте недалеко отсюда, где-то в окрестностях Сен-Жак-дю-О-Па, раз вы ходите туда к обедне каждый день, но на какой улице — не знаю. Вижу, что вы понимаете своё положение. Раз вы не солгали насчёт имени, вы не солжёте и насчёт адреса. Пишите его сами.",
      "source_sha256": "451b3f0616e1b0c9a92eca1ab3e722b88be077479677f812bf2c1e0c8cd9c60e",
      "target_id": "ru-fr81-u221-r0152",
      "tag": "prose",
      "target_sha256": "0d53c207fbf1021663e6ff08cff7082369487cbc03e73e9853a745aaf53a76f6"
    },
    {
      "source_id": "fr81-u221-r0153",
      "target": "Пленник с минуту оставался в раздумье, потом взял перо и написал:",
      "source_sha256": "587991a5ed774e9efdbab8cb05fe1ff036ff19567a816c95ffa9ac3d7a7652a1",
      "target_id": "ru-fr81-u221-r0153",
      "tag": "prose",
      "target_sha256": "5de0eecb7558db9ff1cbf66e0e739fec03c848435defa43083a7839fd3b0d505"
    },
    {
      "source_id": "fr81-u221-r0154",
      "target": "— Мадемуазель Фабр, у господина Урбена Фабра, улица Сен-Доминик-д’Анфер, № 17.",
      "source_sha256": "ade3100a8e0ea1015eed53390c7987343b37bfec195fea0a91e994fa95190e28",
      "target_id": "ru-fr81-u221-r0154",
      "tag": "prose",
      "target_sha256": "60561f72bc8e26fb6cb29e65b4cc80f795055ffbf44646dde8e6f2f52f844776"
    },
    {
      "source_id": "fr81-u221-r0155",
      "target": "Тенардье схватил письмо с каким-то лихорадочным содроганием.",
      "source_sha256": "f6ca573fd8f0304b3b59cd312ceb3dd74fc122143d82cd0d53b141822fb74ac1",
      "target_id": "ru-fr81-u221-r0155",
      "tag": "prose",
      "target_sha256": "2469ccc0a5daa791970a4f9e1a85c3caeeaf6da32ff11fbfc3ff5e5357faa39d"
    },
    {
      "source_id": "fr81-u221-r0156",
      "target": "— Жена! — крикнул он.",
      "source_sha256": "2a187cdbd94c5833661fa5dac99eb4708cc925030c0769e76fa586a734336621",
      "target_id": "ru-fr81-u221-r0156",
      "tag": "prose",
      "target_sha256": "3387539c2e00b8640a217d9b80e9c765a32ebe2ec34fca9ba6b2b731762e14e7"
    },
    {
      "source_id": "fr81-u221-r0157",
      "target": "Тенардьерша подбежала.",
      "source_sha256": "4bfdd58bea4d26af591e7b4aceb332a0a5576feba107928da61e4aa61d099f2a",
      "target_id": "ru-fr81-u221-r0157",
      "tag": "prose",
      "target_sha256": "239a403a7e408703a708b0f539a31b33d15b0c67fd25993e4753dc0263a50d24"
    },
    {
      "source_id": "fr81-u221-r0158",
      "target": "— Вот письмо. Ты знаешь, что тебе делать. Внизу фиакр. Поезжай сейчас же и возвращайся так же.",
      "source_sha256": "8a095dda2ef311864bbd7ed198c8db06c6f214f5d5732b9e728c724d331bcbbc",
      "target_id": "ru-fr81-u221-r0158",
      "tag": "prose",
      "target_sha256": "2967181d5b13d5b6855c10116dd2049191295420ea38a9bdc28f18ec5c8ac2a1"
    },
    {
      "source_id": "fr81-u221-r0159",
      "target": "И, обратившись к человеку с кувалдой, он сказал:",
      "source_sha256": "57547c91238fcd71d9eb7f11f74a3b579e23f21afe2bbc7acd6402e73e5ba7d9",
      "target_id": "ru-fr81-u221-r0159",
      "tag": "prose",
      "target_sha256": "d7df1c45f530000679e5908a0ac609d7beb7ec58ba4701e175057724d312fe88"
    }
  ],
