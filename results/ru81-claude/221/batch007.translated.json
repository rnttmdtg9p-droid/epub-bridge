{
  "unit": 221,
  "batch": 7,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u221-r0224",
      "target": "В то же время Мариус услышал под собой, внизу у перегородки, но так близко, что не мог увидеть говоривших, этот приглушённый разговор:",
      "source_sha256": "99c49f6f98ffdcd43ca4bc7b6cb9aaac654a356fd9a1de7109f44874fd94078c",
      "target_id": "ru-fr81-u221-r0224",
      "tag": "prose",
      "target_sha256": "b4f026044b4729fcad157e5f6c6044468e6ea1475529716495866be6aee73269"
    },
    {
      "source_id": "fr81-u221-r0225",
      "target": "— Остаётся только одно.",
      "source_sha256": "0fc8c1045ae0f6e45daf8432dc221e724e029631b387802aa422665a0619fb8c",
      "target_id": "ru-fr81-u221-r0225",
      "tag": "prose",
      "target_sha256": "389b4721ff8c9bef7d48337cedc420bd0d51fc31d78f5dadde8be7e83040b9db"
    },
    {
      "source_id": "fr81-u221-r0226",
      "target": "— Прикончить его!",
      "source_sha256": "b54a19c07cb0dba1269207ad8b5f18454b70792adada2b55d1c7c00176382ead",
      "target_id": "ru-fr81-u221-r0226",
      "tag": "prose",
      "target_sha256": "afe1def31068aae519d0407108284e118c22a8cbf080199f3604eae53a5284ad"
    },
    {
      "source_id": "fr81-u221-r0227",
      "target": "— Вот именно.",
      "source_sha256": "08b0f83fa6bec4d2e219c732496c9527fec2d3fa29d99347fcfe17adfb0c0083",
      "target_id": "ru-fr81-u221-r0227",
      "tag": "prose",
      "target_sha256": "7526799da4dd42c74019ffde78d9326074fe2d1de2b61e9379a56e6c6ff23723"
    },
    {
      "source_id": "fr81-u221-r0228",
      "target": "Это муж с женой держали совет.",
      "source_sha256": "891a31f41780309eb9a5c6c084732d4b5a4809a311d423099d5cbd932597e57b",
      "target_id": "ru-fr81-u221-r0228",
      "tag": "prose",
      "target_sha256": "9af0bf4a3777da71263d964d99cf4f0ffcee1d92f1581ae9b70c7ce81f4fdb30"
    },
    {
      "source_id": "fr81-u221-r0229",
      "target": "Тенардье медленными шагами подошёл к столу, открыл ящик и достал оттуда нож.",
      "source_sha256": "3c52d15b88b5df030b3b6b458af8adefa798cca017a292c27b235b830d5adfb8",
      "target_id": "ru-fr81-u221-r0229",
      "tag": "prose",
      "target_sha256": "c7e7e305b9946d1907c0853ee9c0f462754978e73c3b29f5e415f76c4081f207"
    },
    {
      "source_id": "fr81-u221-r0230",
      "target": "Мариус теребил рукоятку пистолета. Неслыханное замешательство. Уже час в его совести звучали два голоса: один говорил ему чтить завещание отца, другой кричал, что надо спасти пленника. Эти два голоса непрерывно продолжали свою борьбу, доводившую его до агонии. Он смутно надеялся до этой минуты найти способ примирить оба долга, но ничего возможного не явилось. Меж тем опасность была неотложной, последний предел ожидания был пройден: в нескольких шагах от пленника Тенардье размышлял, держа нож в руке. Потерянный Мариус блуждал глазами вокруг — последнее механическое прибежище отчаяния.",
      "source_sha256": "3332ce9e638e595b7ee4d85789cb915a896d2b729d2e950907a121c43d71552e",
      "target_id": "ru-fr81-u221-r0230",
      "tag": "prose",
      "target_sha256": "1c814d20d7c02b913943c6aa7f843d684d56512680eb6ecda1868f0fda99d8da"
    },
    {
      "source_id": "fr81-u221-r0231",
      "target": "Вдруг он вздрогнул.",
      "source_sha256": "7511e3c89c619c1abcbacfc852a49b3aba5a75d10baed66acd933303ea15f68f",
      "target_id": "ru-fr81-u221-r0231",
      "tag": "prose",
      "target_sha256": "f3db9a37d9747ab9af517e1889e7c1f6b8d970adbc2f713b369450fab8e2747a"
    },
    {
      "source_id": "fr81-u221-r0232",
      "target": "У его ног, на столе, яркий луч полной луны освещал и словно показывал ему лист бумаги. На этом листе он прочёл строку, написанную крупными буквами в то же утро старшей из дочерей Тенардье:",
      "source_sha256": "3513fa9d8fa7587a5406f50837fb15a784eee9b46fc6897424f86ca7280564b1",
      "target_id": "ru-fr81-u221-r0232",
      "tag": "prose",
      "target_sha256": "233b37fef9c56d11fb0e1eb317ad598c2ccb21d975a552252b3208dec207ebdd"
    },
    {
      "source_id": "fr81-u221-r0233",
      "target": "— [[SC]]Легавые здесь[[/SC]].",
      "source_sha256": "4712ea50faada380ce534f6b1a5ca46163fdf55e337c1d6e7833bf8cc4b66b88",
      "target_id": "ru-fr81-u221-r0233",
      "tag": "prose",
      "target_sha256": "3f66d35cee50c8677c8372e12c1048c781d10c78371d671cc0cd51962f75c7ba"
    },
    {
      "source_id": "fr81-u221-r0234",
      "target": "Мысль, просвет пронзил ум Мариуса: это было то средство, которое он искал, разрешение страшной задачи, терзавшей его, — пощадить убийцу и спасти жертву. Он встал на колени на комоде, протянул руку, схватил лист бумаги, тихонько отколол от перегородки кусок штукатурки, завернул его в бумагу и бросил всё это через щель в самую середину притона.",
      "source_sha256": "46e804202c0bbf741e89eab86b2c4e0cf4f7893ccd0a9f51c47053d3985a3cff",
      "target_id": "ru-fr81-u221-r0234",
      "tag": "prose",
      "target_sha256": "c19161310ec815858d05df64ebff63089761b644b41afd8c42d05a2a7f297d26"
    },
    {
      "source_id": "fr81-u221-r0235",
      "target": "Это было вовремя. Тенардье справился с последними страхами или последними сомнениями и направлялся к пленнику.",
      "source_sha256": "d4462260cee8ee5bdd0dfbf6e250d69e7aca2269a487523a40f89272d596a83c",
      "target_id": "ru-fr81-u221-r0235",
      "tag": "prose",
      "target_sha256": "ae40f0242aba03aeb4cd581e9b288bda622af59e023568ec08a64fc999ed533e"
    },
    {
      "source_id": "fr81-u221-r0236",
      "target": "— Что-то упало! — крикнула Тенардье.",
      "source_sha256": "e6be12eaa8c092b1596630daf23a134a61be3b1f5b96da9966650e10dbd3487c",
      "target_id": "ru-fr81-u221-r0236",
      "tag": "prose",
      "target_sha256": "ad18fd22ac52c4f8e5fb43b3b21c76832d83d75ecbe2971ecd78eaaada17587f"
    },
    {
      "source_id": "fr81-u221-r0237",
      "target": "— Что там? — спросил муж.",
      "source_sha256": "9a8490b027b88e655fe3c4a1b9029af04633a72e1c36eea5d86776866d6fedff",
      "target_id": "ru-fr81-u221-r0237",
      "tag": "prose",
      "target_sha256": "825839d021d4460e783c13be1a28a7f7dd15fdb3b5a8f39f78286107d3048a27"
    },
    {
      "source_id": "fr81-u221-r0238",
      "target": "Жена бросилась вперёд и подняла кусок штукатурки, завёрнутый в бумагу. Она отдала его мужу.",
      "source_sha256": "358db26199b51df554f10fdd2d1429024647cae89aea3c376034fad1c3823a39",
      "target_id": "ru-fr81-u221-r0238",
      "tag": "prose",
      "target_sha256": "dec91ffc3309c10144335f17b6571041c78704db489cf0e0eba8c518f4853075"
    },
    {
      "source_id": "fr81-u221-r0239",
      "target": "— Откуда это прилетело? — спросил Тенардье.",
      "source_sha256": "f1299e18a3bf7655b6b2706ccfce227c4943b6d35544897850c1c45ce8700e21",
      "target_id": "ru-fr81-u221-r0239",
      "tag": "prose",
      "target_sha256": "012af27383ae943febd9dd30914e16dbec5d32586c655420268ec796796f740c"
    },
    {
      "source_id": "fr81-u221-r0240",
      "target": "— Чёрт возьми! — сказала жена. — А откуда ему быть? Из окна.",
      "source_sha256": "9a1c4b8da26312321514db3c8d440e6826f499be279c65da8d954de9258fecf0",
      "target_id": "ru-fr81-u221-r0240",
      "tag": "prose",
      "target_sha256": "fd5afcccae3f7eac3a886709750926b10bc2a7f13916198c18584fe2b7beb49a"
    },
    {
      "source_id": "fr81-u221-r0241",
      "target": "— Я видел, как оно пролетело, — сказал Бигренайль.",
      "source_sha256": "f5c6da158f47316e6799e9dc632d9412e71c32286229273a2473d71ac218d490",
      "target_id": "ru-fr81-u221-r0241",
      "tag": "prose",
      "target_sha256": "82f16de6790ff39f57ee82fb92fb7304716789e67addb65094c72fb78c053d41"
    },
    {
      "source_id": "fr81-u221-r0242",
      "target": "Тенардье быстро развернул бумагу и поднёс её к свече.",
      "source_sha256": "d5949344dbead40a2e435e95dfd3200e55c99ed4a40afb323a2dbe8e293e0a07",
      "target_id": "ru-fr81-u221-r0242",
      "tag": "prose",
      "target_sha256": "21be3b3ef5decba2b93069d0457f7ed56874932bb1bad84721f0b597f4a9e964"
    },
    {
      "source_id": "fr81-u221-r0243",
      "target": "— Это почерк Эпонины. Чёрт!",
      "source_sha256": "9e583f255f54a4257197edf39d4d7f6a0ae0dd3a82b3679c41c6418112e2f29a",
      "target_id": "ru-fr81-u221-r0243",
      "tag": "prose",
      "target_sha256": "a0e67a4259843065a769a21a42a2f59c10bc3a0f6a19ea3be79577342d4d73d6"
    },
    {
      "source_id": "fr81-u221-r0244",
      "target": "Он подал знак жене, та живо подошла, и он показал ей строку, написанную на листе, а потом добавил глухим голосом:",
      "source_sha256": "a8138ea16e2eecff0f6cf74a3d0c16309deb9bd803a155ffcd4ec1cda71fc44d",
      "target_id": "ru-fr81-u221-r0244",
      "tag": "prose",
      "target_sha256": "1778ebb86655edc9c87591a48f9e85265694f9e65017e519fe8b0f95b4c9c4ea"
    },
    {
      "source_id": "fr81-u221-r0245",
      "target": "— Скорее! Лестницу! Оставим сало в мышеловке и удирай��м!",
      "source_sha256": "31df36a2937a457db555ddee849c767f501029857dbd5abf66745bae4120a524",
      "target_id": "ru-fr81-u221-r0245",
      "tag": "prose",
      "target_sha256": "c470bbb2aba3718f2f858984338e4332e02b953fef664864d9f9a84778c4d828"
    },
    {
      "source_id": "fr81-u221-r0246",
      "target": "— Не перерезав горло этому человеку? — спросила Тенардье.",
      "source_sha256": "1b517e0270c2b17126fe2b51389d9f3fb051a840ae282069e154c06335a2b037",
      "target_id": "ru-fr81-u221-r0246",
      "tag": "prose",
      "target_sha256": "5fb73393662d11157f02a322feeea6a800e8a347739b47dc60f967d88d9c1a1b"
    },
    {
      "source_id": "fr81-u221-r0247",
      "target": "— У нас нет времени.",
      "source_sha256": "8ac791ae6ef90381afbd82b96a18554c8f9257bf94f4ccbb66908b44bc7a6c3a",
      "target_id": "ru-fr81-u221-r0247",
      "tag": "prose",
      "target_sha256": "ff437a2ed2548792659106d21e6d1656ca8139eff240f45c372ebb708981080b"
    },
    {
      "source_id": "fr81-u221-r0248",
      "target": "— Куда? — спросил Бигренайль.",
      "source_sha256": "7bee5e33e0ba06dbf3da77ad995bbc88baec9354d81c5b70d82d44dbc51c7d69",
      "target_id": "ru-fr81-u221-r0248",
      "tag": "prose",
      "target_sha256": "e32d0a950185f3147fa14d51a6c823ba463be9a1a9fa16e21117e0ebc7ad84f9"
    },
    {
      "source_id": "fr81-u221-r0249",
      "target": "— В окно, — ответил Тенардье. — Раз Понина бросила камень в окно, значит, с этой стороны дом не оцеплен.",
      "source_sha256": "b88f6cf862e8c1d476acf0bacc64facfdebbc302cc0e6aabd56e9ebdd0a266b3",
      "target_id": "ru-fr81-u221-r0249",
      "tag": "prose",
      "target_sha256": "fdbb91b3e49c6c30c780e71c40ddfd7db03e873efe2e0f9f876a6614ff00f6b9"
    },
    {
      "source_id": "fr81-u221-r0250",
      "target": "Человек в маске с голосом чревовещателя положил на пол свой большой ключ, поднял обе руки вверх и трижды быстро сжал кулаки, не говоря ни слова. Это было словно сигнал аврала на корабле. Разбойники, державшие пленника, выпустили его; в мгновение ока верёвочная лестница была спущена за окно и крепко прицеплена к подоконнику двумя железными крючьями. Пленник не обращал внимания на происходившее вокруг. Он словно грезил или молился. Как только лестница была закреплена, Тенардье крикнул:",
      "source_sha256": "ea0e5dccb65c605666d83f7b52593e2312867bcba89020d30c2b8f29b679da5a",
      "target_id": "ru-fr81-u221-r0250",
      "tag": "prose",
      "target_sha256": "c1e528b6e3dad4a22a7900c36a8e590c2e967d39193546b3d980d812ee8f5e25"
    },
    {
      "source_id": "fr81-u221-r0251",
      "target": "— Иди сюда, хозяйка!",
      "source_sha256": "dc0a48ed72577632b32ccae99f5242fe36ce66ebd46af10c63ced96980524501",
      "target_id": "ru-fr81-u221-r0251",
      "tag": "prose",
      "target_sha256": "2fe5eef3856211906ebc6ffe90d86aa5f5a68620816365e98ea0f6e85596e7ae"
    },
    {
      "source_id": "fr81-u221-r0252",
      "target": "И он бросился к окну.",
      "source_sha256": "21a62a5e67caf7023b583a0c13bc28fca626429b82c0aabd0e2570097b0abe66",
      "target_id": "ru-fr81-u221-r0252",
      "tag": "prose",
      "target_sha256": "dcc50537216c8e5531a8e3d2dd64ce19fd3994f88247c4fc4e7cfd9d9304d9ee"
    },
    {
      "source_id": "fr81-u221-r0253",
      "target": "Но когда он уже собирался перекинуть ногу, Бигренайль грубо схватил его за шиворот.",
      "source_sha256": "70a678ee6e3767e3ae7480e4c5a32edc1dc26adb5f8288a09320cdcba3a87037",
      "target_id": "ru-fr81-u221-r0253",
      "tag": "prose",
      "target_sha256": "f0772643ec3f4bab4197e6f3a239ee22188b42d94eb76bd14644165fa7594618"
    },
    {
      "source_id": "fr81-u221-r0254",
      "target": "— Не так, старый шутник! После нас!",
      "source_sha256": "32d1646d5870ee23d78ef315fbd309dc8f298f0b4161d548d1a34169ad85d8a0",
      "target_id": "ru-fr81-u221-r0254",
      "tag": "prose",
      "target_sha256": "ac9cd64034962abb6c8b414050900858fa4e412c34bb107d2044418fac5a4922"
    },
    {
      "source_id": "fr81-u221-r0255",
      "target": "— После нас! — взвыли бандиты.",
      "source_sha256": "02d07a62145a74f6ef6a03c49240ca9bd80f4ed2ed25f000508fbb944dfcef3b",
      "target_id": "ru-fr81-u221-r0255",
      "tag": "prose",
      "target_sha256": "1282256ab7d70e4a4c43329068a9400d3d2c4ff8c4e9a5b3d4433f8fa9b0f77e"
    }
  ],
