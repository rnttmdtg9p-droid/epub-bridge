{
  "unit": 182,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u182-r0032",
      "target": "— Нет, это не годится. Что вы станете делать потом?",
      "source_sha256": "f2b9214cae54e76541ee6358b5350d4d45cbbc87f4ea46302a5667213d46a0de",
      "target_id": "ru-fr81-u182-r0032",
      "tag": "prose",
      "target_sha256": "120ed8987eb6454192ea0dce9704b48aaa693be2dd9f96d50558a9d18847e21b"
    },
    {
      "source_id": "fr81-u182-r0033",
      "target": "— Всё, что придётся. Всё честное, по крайней мере.",
      "source_sha256": "b2dc424dd178595399465dff450ef768c87145ae058bdc31e25337622768de14",
      "target_id": "ru-fr81-u182-r0033",
      "tag": "prose",
      "target_sha256": "16727b154f25712176c6a925c83ddb40e53940b0c20ff4362d10b3175d987572"
    },
    {
      "source_id": "fr81-u182-r0034",
      "target": "— Вы знаете английский?",
      "source_sha256": "6161515f330cc7eef32b045a1b94a721b0cf06c44b76e17145a2450e8ed7d54d",
      "target_id": "ru-fr81-u182-r0034",
      "tag": "prose",
      "target_sha256": "9459e726348ef0385c2097a92b124452703a89a8d331214be8c2a6c7830b1894"
    },
    {
      "source_id": "fr81-u182-r0035",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u182-r0035",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u182-r0036",
      "target": "— А немецкий?",
      "source_sha256": "77e728f6e1c6b9c4422f3d1a51392dffad00957c99e19b0fbae361924d61a581",
      "target_id": "ru-fr81-u182-r0036",
      "tag": "prose",
      "target_sha256": "437f8a61638f6094d7f8b86fe871d68750fa959125c080dade9b1ed44abb82e4"
    },
    {
      "source_id": "fr81-u182-r0037",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u182-r0037",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u182-r0038",
      "target": "— Тем хуже.",
      "source_sha256": "fe421edacbf1864cd14bbb4f1fc59e03647ace06a47fafbe6f94097c611a9e17",
      "target_id": "ru-fr81-u182-r0038",
      "tag": "prose",
      "target_sha256": "d3bdf45618e4691ea73f9d73c31e921dc971e4784406033e915729e53bccb361"
    },
    {
      "source_id": "fr81-u182-r0039",
      "target": "— Почему?",
      "source_sha256": "4b5154ea331b0a88da96b0d95a9812f8ce55fa954dcfa4511479082dd555da57",
      "target_id": "ru-fr81-u182-r0039",
      "tag": "prose",
      "target_sha256": "5a7f49277ce4099a8cda575751c41cbe2652b4e11515588f5af4642c420fb08d"
    },
    {
      "source_id": "fr81-u182-r0040",
      "target": "— Дело в том, что один мой приятель, книгопродавец, затевает нечто вроде энциклопедии, для которой вы могли бы переводить немецкие или английские статьи. Платят плохо, но жить можно.",
      "source_sha256": "8254cd0eb694b775862ebf7d1b0c39844aed3568fc94c2bb8faec43e161de3f0",
      "target_id": "ru-fr81-u182-r0040",
      "tag": "prose",
      "target_sha256": "a533edcd2844a9ac0098d0ec0788f97ae167800240436d670758280874bb34bd"
    },
    {
      "source_id": "fr81-u182-r0041",
      "target": "— Я выучу английский и немецкий.",
      "source_sha256": "7e529624b87560f73cdd49d3320ea3da7ac2521fee09fdd484e5328086e4f0ef",
      "target_id": "ru-fr81-u182-r0041",
      "tag": "prose",
      "target_sha256": "be28fdb5287a6de64999b10492401f85cf5ab8958a0344bfb4b1d3136df034ba"
    },
    {
      "source_id": "fr81-u182-r0042",
      "target": "— А пока?",
      "source_sha256": "ec61c4bcd9ad1e0c4893a8002133b6c74f4f9f13062cc4024e80dcce63bc41f2",
      "target_id": "ru-fr81-u182-r0042",
      "tag": "prose",
      "target_sha256": "70a3021cc57ee3b7e8777c5aa40db1775a10a64a91d908564a55ab4e60c1ccc4"
    },
    {
      "source_id": "fr81-u182-r0043",
      "target": "— А пока я буду есть свою одежду и свои часы.",
      "source_sha256": "ea9d8598ec17ca3abb101ea9ad03618cf88e29474e6aa982eb3b18373c815fcc",
      "target_id": "ru-fr81-u182-r0043",
      "tag": "prose",
      "target_sha256": "aba0372b2d39c93b4d655ded0bc7304d9231115a3cdb9437a9807aa4ccfbec3d"
    },
    {
      "source_id": "fr81-u182-r0044",
      "target": "Позвали старьёвщика. Он купил обноски за двадцать франков. Пошли к часовщику. Он купил часы за сорок пять франков.",
      "source_sha256": "783779fda8471827ca30d8d6c84dce75733b9ad129b7bb4b9652b6cdff176702",
      "target_id": "ru-fr81-u182-r0044",
      "tag": "prose",
      "target_sha256": "5f6e666bb2c1c53ffcd177e40fd85cf443af0af8a374a30031c3d56c221692a7"
    },
    {
      "source_id": "fr81-u182-r0045",
      "target": "— Совсем недурно, — говорил Мариус Курфейраку, возвращаясь в гостиницу, — с моими пятнадцатью франками выходит восемьдесят франков.",
      "source_sha256": "51c8c202f449a134b7c3224e0fa03e730c700e95388fb41e393aac38472d764e",
      "target_id": "ru-fr81-u182-r0045",
      "tag": "prose",
      "target_sha256": "ad81a087eaead8be15d204b72ca929680b7e75fb1518e8f7fd3954ff8ed2ff54"
    },
    {
      "source_id": "fr81-u182-r0046",
      "target": "— А счёт за гостиницу? — заметил Курфейрак.",
      "source_sha256": "dd3301e6df48156e277170139c740e38242fb6987d0f30b1555fdb1cd954b2cd",
      "target_id": "ru-fr81-u182-r0046",
      "tag": "prose",
      "target_sha256": "d060afd38cab0d9e090b491641368a70a48466b29e100144576f404c212873cc"
    },
    {
      "source_id": "fr81-u182-r0047",
      "target": "— Ах да, я забыл, — сказал Мариус.",
      "source_sha256": "836fbbb122c994f0ce5ee167c6577740841b1709a71a53c1c2f0206d46ebffc7",
      "target_id": "ru-fr81-u182-r0047",
      "tag": "prose",
      "target_sha256": "3bbf6687e549d6816efd44429ef52d027ceedc607e2cc445bfafdd5c39ad231e"
    },
    {
      "source_id": "fr81-u182-r0048",
      "target": "Хозяин предъявил счёт, который пришлось оплатить тотчас же. Он составил семьдесят франков.",
      "source_sha256": "d4dfaf27f806b1ac1228c4b6b2fdbd63d3a77c98d063ca3bb3149f20d1618b38",
      "target_id": "ru-fr81-u182-r0048",
      "tag": "prose",
      "target_sha256": "76eb4d2f5ca6b456aaa0308593c8fc7462c4607dc8471b1f0dd92282476d91e5"
    },
    {
      "source_id": "fr81-u182-r0049",
      "target": "— У меня остаётся десять франков, — сказал Мариус.",
      "source_sha256": "8eb4c7a6a235b983b9c7283eebfc71d03f8cbdca6abf1386057935848117c0fb",
      "target_id": "ru-fr81-u182-r0049",
      "tag": "prose",
      "target_sha256": "a1a64f3a617d859b1b1b2aa3ca8049cd4741db6a39f743a0cd7a596c13492009"
    },
    {
      "source_id": "fr81-u182-r0050",
      "target": "— Чёрт возьми, — сказал Курфейрак, — пять франков вы съедите, пока будете учить английский, и пять, пока будете учить немецкий. Это значит проглотить язык очень быстро или монету в сто су очень медленно.",
      "source_sha256": "a88905b5c627170bbd3b99ce517817ed4b0fb09f4a433ef089b25f0b149d7f01",
      "target_id": "ru-fr81-u182-r0050",
      "tag": "prose",
      "target_sha256": "019230187026f359d9b5f88d73a07ae483a6788babe5a05d7bafa083c17d97ef"
    },
    {
      "source_id": "fr81-u182-r0051",
      "target": "Между тем тётка Жильнорман, в сущности довольно добрая особа в печальных обстоятельствах, всё же сумела разузнать, где живёт Мариус. Однажды утром, когда Мариус возвращался из школы, он нашёл письмо от тётки и [[I]]шестьдесят пистолей[[/I]], то есть шестьсот франков золотом, в запечатанной коробке.",
      "source_sha256": "b74c746185dd5a196c702313d1b83b3e20c94980152bb346841b0ed0be9479ad",
      "target_id": "ru-fr81-u182-r0051",
      "tag": "prose",
      "target_sha256": "03f2ef141d361a076cf95d9f93070489c8e834f3d73f881a6e409e52993fc3fe"
    },
    {
      "source_id": "fr81-u182-r0052",
      "target": "Мариус отослал тридцать луидоров обратно тётке с почтительным письмом, в котором заявлял, что имеет средства к существованию и что отныне в состоянии удовлетворять все свои нужды. В ту минуту у него оставалось три франка.",
      "source_sha256": "fe513e651560fa5e57ebec9881d40323952bd6852af87e3f147c2af20c7ba163",
      "target_id": "ru-fr81-u182-r0052",
      "tag": "prose",
      "target_sha256": "69847664fa264f08eeecf0d6fbddc56b6189d65382ed7f94921a031a61daaa17"
    },
    {
      "source_id": "fr81-u182-r0053",
      "target": "Тётка не известила деда об этом отказе, боясь окончательно его разъярить. К тому же не сказал ли он: «Чтобы мне никогда не говорили об этом кровопийце!»",
      "source_sha256": "f8017b379e22f1c68abb68461802c81f86b10453b1ea5e8ab916b7adce9035b5",
      "target_id": "ru-fr81-u182-r0053",
      "tag": "prose",
      "target_sha256": "4b8db339bb0093c4d18cf62a9e50d040bcc93cc5e94976fe77c1a10137082f6d"
    },
    {
      "source_id": "fr81-u182-r0054",
      "target": "Мариус покинул гостиницу у заставы Сен-Жак, не желая задолжать в ней.",
      "source_sha256": "ffc9b0fe7e983ad068a51f237d2ca89d4b29fdbf4ece23fb7ba5356fa7aa0849",
      "target_id": "ru-fr81-u182-r0054",
      "tag": "prose",
      "target_sha256": "f5c85f49028ec0b5477bc9611bb677a3f170954ec32d4dd36e6fe5947837c283"
    }
  ],
