{
  "unit": 62,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u062-r0032",
      "target": "— Кончено!",
      "source_sha256": "38e6b64cf9ca3771f9937e5844ecf280b5880d7e331707506b5255d8ad18fd8c",
      "target_id": "ru-fr81-u062-r0032",
      "tag": "prose",
      "target_sha256": "1e9c4cd41a434de5119dbbd20bff6c27673f2c0693aae820fea447b496246c53"
    },
    {
      "source_id": "fr81-u062-r0033",
      "target": "Это слово было повторено с таким выражением, что адвокат обернулся.",
      "source_sha256": "a1c2d6d0d572296619393a8d699bbbb24ae2e76f884f75ee084e0135368e24b9",
      "target_id": "ru-fr81-u062-r0033",
      "tag": "prose",
      "target_sha256": "a15c746efe4a5d41f4bf2191d6626ed2bc7beac94858724b2139db264e1d42a6"
    },
    {
      "source_id": "fr81-u062-r0034",
      "target": "— Простите, сударь, вы, может быть, родственник?",
      "source_sha256": "8dc3e79ae91165124d8001f404c1ca0989d066e1aac20683eafdd3a985e65f56",
      "target_id": "ru-fr81-u062-r0034",
      "tag": "prose",
      "target_sha256": "383da6f82dfabc90b4a209e83c015551585f71bd482b7d103c372e3c081a0db2"
    },
    {
      "source_id": "fr81-u062-r0035",
      "target": "— Нет. Я здесь никого не знаю. А был ли вынесен приговор?",
      "source_sha256": "2db04d220bc7fabc0a18b187c2f8bb9d52833015678f7ba0e8ce807e67c60fcf",
      "target_id": "ru-fr81-u062-r0035",
      "tag": "prose",
      "target_sha256": "58c3561974d3a73cd1e8e949eae47d46a0edaf0fd3cb1f24e37c715488aa230b"
    },
    {
      "source_id": "fr81-u062-r0036",
      "target": "— Без сомнения. Иначе едва ли могло и быть.",
      "source_sha256": "14bdc19c6e4dae2c080dcf19faa8da0cdbddb513fc44dd59f2fdd0582775827e",
      "target_id": "ru-fr81-u062-r0036",
      "tag": "prose",
      "target_sha256": "42c666491736b35b6e633e4683ae306e26d9aa338f2e5d51e04f51e1af2e751b"
    },
    {
      "source_id": "fr81-u062-r0037",
      "target": "— К каторжным работам?..",
      "source_sha256": "56654b234b453ed30b23fe25cefe2865cb8b72c921c2a505ebd8c4fcc17a0bd9",
      "target_id": "ru-fr81-u062-r0037",
      "tag": "prose",
      "target_sha256": "765b3748310c5c7fadc96e8dc18c4e17a4ee863cd012ee383a6b7371bc5209ad"
    },
    {
      "source_id": "fr81-u062-r0038",
      "target": "— Пожизненно.",
      "source_sha256": "24baee7aa061c2f39e4518b63340b5d0353398e9bdb6a194cae8ff3d1fe0f169",
      "target_id": "ru-fr81-u062-r0038",
      "tag": "prose",
      "target_sha256": "709662715668e0847870541723f9645305890a7d2c57555e788605b9c572d1e0"
    },
    {
      "source_id": "fr81-u062-r0039",
      "target": "Он продолжал таким слабым голосом, что его едва было слышно:",
      "source_sha256": "1bafd9635fa817f13b253a7121869bf238e02b47fd03fca50e5b320956de12e5",
      "target_id": "ru-fr81-u062-r0039",
      "tag": "prose",
      "target_sha256": "7ea020e8962e010c940ac396ff10b01f7a69e1599b55fb637d23882877473e05"
    },
    {
      "source_id": "fr81-u062-r0040",
      "target": "— Значит, личность была установлена?",
      "source_sha256": "738943b8f4d6cfc7e5e8106df5d9d5a20c6fd5bc5f5554bebfadd461fa0fcb7b",
      "target_id": "ru-fr81-u062-r0040",
      "tag": "prose",
      "target_sha256": "5d5f614a87a6ce199d6484c61aa9ee23389efb9ea06b081516af21bdd1aacf55"
    },
    {
      "source_id": "fr81-u062-r0041",
      "target": "— Какая личность? — ответил адвокат. — Нечего было устанавливать. Дело простое. Эта женщина убила своего ребёнка, детоубийство доказано, присяжные отвергли умысел, и её приговорили пожизненно.",
      "source_sha256": "503b03079c334bbfbf67a7939cccaeab65ef2deed815eb2f1698dd9e81ec9a3a",
      "target_id": "ru-fr81-u062-r0041",
      "tag": "prose",
      "target_sha256": "b2e09973b1b21284096603f5616d2e3485547b67de8dbbcbac8cea1de8066ef4"
    },
    {
      "source_id": "fr81-u062-r0042",
      "target": "— Так это женщина? — сказал он.",
      "source_sha256": "aae5a4865792727d263767f034418e00bef0209ecff06a229f8cbd4f92bd6ca4",
      "target_id": "ru-fr81-u062-r0042",
      "tag": "prose",
      "target_sha256": "85b93c5c3356aed049b0020cb6b887709e644a61f0994cb5860904b42ae1c710"
    },
    {
      "source_id": "fr81-u062-r0043",
      "target": "— Ну конечно. Девица Лимозен. О чём же вы тогда спрашиваете?",
      "source_sha256": "81a33188cb2e51c98abb35f22dd0e1d6d5f764bc148d111060ae248821a10f6f",
      "target_id": "ru-fr81-u062-r0043",
      "tag": "prose",
      "target_sha256": "24f249f39125d3b263bae2a62b5b8c8e5362c81c7377ab9391109fe61c991aa9"
    },
    {
      "source_id": "fr81-u062-r0044",
      "target": "— Ни о чём. Но если всё кончено, отчего зал ещё освещён?",
      "source_sha256": "76ef27db2bde54d1cf35f2c380d9f5f757ed3f232171a86012d0be8547d25603",
      "target_id": "ru-fr81-u062-r0044",
      "tag": "prose",
      "target_sha256": "2f4c7c8d139abdf05b0dd6d68b1a94049c19a1c0110ce0a38ce42a2d958fd761"
    },
    {
      "source_id": "fr81-u062-r0045",
      "target": "— Это из-за другого дела, которое началось часа два назад.",
      "source_sha256": "1229214834e29678092a29ae0eba7f7bf8471b7fa95869f3981c596040a5dc37",
      "target_id": "ru-fr81-u062-r0045",
      "tag": "prose",
      "target_sha256": "76cf383c46b4ca2c3ef5cacda759425e96036d2eb17480d482fda34c9f63d21d"
    },
    {
      "source_id": "fr81-u062-r0046",
      "target": "— Какого другого дела?",
      "source_sha256": "e8d7f119fdf7acaea63d5793a3d38755def9ffc464d0263f48a4d3938bd7b927",
      "target_id": "ru-fr81-u062-r0046",
      "tag": "prose",
      "target_sha256": "18d2a1dddecf2513e6bc74a42fb3389c40c05784528f893fc5425f3095f6a821"
    },
    {
      "source_id": "fr81-u062-r0047",
      "target": "— О! Это тоже ясное. Какой-то оборванец, рецидивист, бывший каторжник, который украл. Имени его уже толком не помню. Физиономия у него разбойничья. За одну такую рожу я отправил бы его на галеры.",
      "source_sha256": "e4754554aebfc179575813651709641c42c41139a29400de0466b88513171537",
      "target_id": "ru-fr81-u062-r0047",
      "tag": "prose",
      "target_sha256": "def5a5ce8894076799f87e3c241eaf9e0403f7a47a10d2ca637091c58fb64580"
    },
    {
      "source_id": "fr81-u062-r0048",
      "target": "— Сударь, — спросил он, — нет ли способа пройти в зал?",
      "source_sha256": "38312d3bef21e9e04fca27d83096c0d7d2f043a062370b9519187873bc7c74a8",
      "target_id": "ru-fr81-u062-r0048",
      "tag": "prose",
      "target_sha256": "822c5f364b4a0e87a47f6f3ba664d542f8bd14e7d7842d01d01b4f5bd546c13d"
    },
    {
      "source_id": "fr81-u062-r0049",
      "target": "— Право, не думаю. Там очень много народу. Впрочем, заседание приостановлено. Кое-кто вышел, и когда заседание возобновится, вы можете попытаться.",
      "source_sha256": "c46118d11fc929c1d616c84fe2af7c4ea67e0db1d77bf9c24cbca3e1f4302875",
      "target_id": "ru-fr81-u062-r0049",
      "tag": "prose",
      "target_sha256": "19f523a952bbb150ee24b3b6343b3fb9826027efc8c35c9191fd6d2c29bbaf54"
    },
    {
      "source_id": "fr81-u062-r0050",
      "target": "— Где входят?",
      "source_sha256": "693589e5527d111df439980289f66ffefc9827f70b7e13f9293597f0e64158c2",
      "target_id": "ru-fr81-u062-r0050",
      "tag": "prose",
      "target_sha256": "e9ad779e9528925d4969a718933e64cebcba5abf9622502189995e6d51558fbb"
    },
    {
      "source_id": "fr81-u062-r0051",
      "target": "— Вот в эту большую дверь.",
      "source_sha256": "e86fac9c28cbee899054cdceb6ff983c5c54bd4ef685ab2839d266b0206dd18d",
      "target_id": "ru-fr81-u062-r0051",
      "tag": "prose",
      "target_sha256": "d8322bf998596d48a3472bc5415624a7ecf2b9b8542902482f9ab24cd6953801"
    },
    {
      "source_id": "fr81-u062-r0052",
      "target": "Адвокат оставил его. За несколько мгновений он испытал почти одновременно, почти смешавшись, все возможные чувства. Слова этого равнодушного человека пронзали ему сердце то как ледяные иглы, то как огненные клинки. Когда он увидел, что ничто ещё не кончено, он вздохнул свободно; но не мог бы сказать, было ли то, что он чувствовал, удовлетворением или болью.",
      "source_sha256": "ec828faaab6ca446b4d460f07af4b27bbe7e7053d9537bd433d996db006ba021",
      "target_id": "ru-fr81-u062-r0052",
      "tag": "prose",
      "target_sha256": "4782c4e4f2e61cdead7ebd11ac86df53e288e23d06947b2201c205a1c88d2596"
    },
    {
      "source_id": "fr81-u062-r0053",
      "target": "Он подходил к нескольким группам и прислушивался к тому, что говорили. Так как список дел сессии был очень обширен, председатель назначил на этот же день два простых и коротких дела. Начали с детоубийства, а теперь дошли до каторжника, до рецидивиста, до «вернувшейся лошади». Этот человек крал яблоки, но это, кажется, было доказано не очень твёрдо; доказано же было то, что он уже побывал на галерах в Тулоне. Это и делало его дело плохим. Впрочем, допрос подсудимого и показания свидетелей были закончены; но оставались ещё речь защитника и обвинительная речь прокуратуры; всё это едва ли должно было кончиться раньше полуночи. Человека, вероятно, осудят; товарищ прокурора был очень хорош — и не [[I]]упускал[[/I]] своих подсудимых; это был остроумный малый, пишущий стихи.",
      "source_sha256": "e5a2684e188fbe78ea24f695b24c64234fc130f57f829b1eaa5a4db55837eca5",
      "target_id": "ru-fr81-u062-r0053",
      "tag": "prose",
      "target_sha256": "20cf6d7795ffbeb57449073e09c484571862616dcb8256bfc7a3a0082b640764"
    },
    {
      "source_id": "fr81-u062-r0054",
      "target": "Судебный пристав стоял у двери, ведущей в зал заседаний присяжных. Он спросил этого пристава:",
      "source_sha256": "f448c9b73a85ad69d0832f087ad0e54ef0c888a247a015731c0543d28d135932",
      "target_id": "ru-fr81-u062-r0054",
      "tag": "prose",
      "target_sha256": "12e4119ad276e5bc9cb3834e6684df8c2e0de4b40572c54602c0f9d5709f4d98"
    },
    {
      "source_id": "fr81-u062-r0055",
      "target": "— Сударь, эта дверь скоро откроется?",
      "source_sha256": "ff5c4eece65712518e0aac26e866e3b122a748bdb800fe30d58fec2dec9522e8",
      "target_id": "ru-fr81-u062-r0055",
      "tag": "prose",
      "target_sha256": "f5bdb3cb5755c15ead1c99a1b97a8ecb96caa9bb05e9e68f2a84eb87a1a12307"
    },
    {
      "source_id": "fr81-u062-r0056",
      "target": "— Она не откроется, — сказал пристав.",
      "source_sha256": "ae2703f3434828a9274f37a4036ff7b4b2efb46786f935141430d7863ad91ad8",
      "target_id": "ru-fr81-u062-r0056",
      "tag": "prose",
      "target_sha256": "a55af899e5a408f8806867d060967c2d16c0062e56fae07bc79310b6305842b0"
    },
    {
      "source_id": "fr81-u062-r0057",
      "target": "— Как! Её не откроют, когда возобновится заседание? Разве заседание не приостановлено?",
      "source_sha256": "777140438c00671fe39be3efb3a33ee3ca73510b57ce41506981616838be7124",
      "target_id": "ru-fr81-u062-r0057",
      "tag": "prose",
      "target_sha256": "b281f32cb581856ad9cfcc00c18239478cae56701cc1e9fcf3ff7062ee1312fd"
    },
    {
      "source_id": "fr81-u062-r0058",
      "target": "— Заседание только что возобновилось, — ответил пристав, — но дверь больше не откроется.",
      "source_sha256": "f98d29de5493aafdccb9902fda30067e64d1059c67472ba3e0c2fe950ee4604e",
      "target_id": "ru-fr81-u062-r0058",
      "tag": "prose",
      "target_sha256": "83444af849a745ec1b1d134ebbc3109ba180fe4924da61d7a3991334f6caa088"
    },
    {
      "source_id": "fr81-u062-r0059",
      "target": "— Почему?",
      "source_sha256": "4b5154ea331b0a88da96b0d95a9812f8ce55fa954dcfa4511479082dd555da57",
      "target_id": "ru-fr81-u062-r0059",
      "tag": "prose",
      "target_sha256": "5a7f49277ce4099a8cda575751c41cbe2652b4e11515588f5af4642c420fb08d"
    },
    {
      "source_id": "fr81-u062-r0060",
      "target": "— Потому что зал полон.",
      "source_sha256": "e59a5c10380366d9c1179be1e638e9f1117a571a98933b7cfbf155a74fef9160",
      "target_id": "ru-fr81-u062-r0060",
      "tag": "prose",
      "target_sha256": "5fce33a3c4db63091cc798edab69e95b3f58fd54900ebd830d3ec63b9bce59a1"
    },
    {
      "source_id": "fr81-u062-r0061",
      "target": "— Как! Нет больше ни одного места?",
      "source_sha256": "a3ea6e992c5e85dd9109100bd86b5557c6610ed3f4e9e7ea431ea47c51a172bd",
      "target_id": "ru-fr81-u062-r0061",
      "tag": "prose",
      "target_sha256": "ad6a066682644c53a2466ea4538aa4cfb73248079033b7382e53b6de32686839"
    },
    {
      "source_id": "fr81-u062-r0062",
      "target": "— Ни одного. Дверь закрыта. Больше никто войти не может.",
      "source_sha256": "e9cbc29f3ba933f6df4eba5eb3ca50855494e4da7c66776684a259b96c4b3e00",
      "target_id": "ru-fr81-u062-r0062",
      "tag": "prose",
      "target_sha256": "09a66d0283ee3ddd230c90bee3689043967183735730524a77114274b4846449"
    },
    {
      "source_id": "fr81-u062-r0063",
      "target": "Помолчав, пристав добавил: — Правда, есть ещё два-три места позади господина председателя, но господин председатель допускает туда только должностных лиц.",
      "source_sha256": "6dad88ca57f12795af45759e8356b560d6f56629fdacec00506857763896a617",
      "target_id": "ru-fr81-u062-r0063",
      "tag": "prose",
      "target_sha256": "9443996a7cffb00387319f55598855a19197115d3275c652f30dfc68ca7e3faf"
    }
  ],
