{
  "unit": 62,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u062-h",
      "target": "VII Приезжий принимает меры, чтобы уехать обратно",
      "source_sha256": "8529658c9825ba604cd003b44c5d7a7551f3c6748b6693b598da01b1f9894cd0",
      "target_id": "ru-fr81-u062-h",
      "tag": "heading",
      "target_sha256": "2fb0445fd3f00290803f05377311f178e5e45a10649ef3bcb802e3f5f2075415"
    },
    {
      "source_id": "fr81-u062-r0001",
      "target": "Было около восьми часов вечера, когда тележка, которую мы оставили в пути, въехала под ворота почтовой гостиницы в Аррасе. Человек, за которым мы следили до этой минуты, вышел из неё, рассеянно ответил на услужливую суету трактирных людей, отослал подручную лошадь и сам отвёл в конюшню маленькую белую лошадку; затем он толкнул дверь бильярдной, что была в нижнем этаже, сел там и облокотился на стол. На дорогу, которую он рассчитывал проехать за шесть часов, ушло четырнадцать. Он отдавал себе справедливость в том, что вины его тут не было; но в глубине души не слишком досадовал.",
      "source_sha256": "86da16ddbfb5028437955526ef1e737304397503193ab8526e5b4401a3518616",
      "target_id": "ru-fr81-u062-r0001",
      "tag": "prose",
      "target_sha256": "d37d40da1626c044d8ef731d14ea275fddfcefbfff809100f6f4ecb6d063c417"
    },
    {
      "source_id": "fr81-u062-r0002",
      "target": "Вошла хозяйка гостиницы.",
      "source_sha256": "207dbd4af10435b942cbf4da70c4626250e36778b80a0d845f2d983e9421460c",
      "target_id": "ru-fr81-u062-r0002",
      "tag": "prose",
      "target_sha256": "0097cf1fb2e6288b3c49f5f2e0cae6226d5156ee0306416f00b15a9c531e8631"
    },
    {
      "source_id": "fr81-u062-r0003",
      "target": "— Господин будет ночевать? Господин будет ужинать?",
      "source_sha256": "7ca26689095cd93998f2c348179754400a6fc2102fa171571820be77e54273e8",
      "target_id": "ru-fr81-u062-r0003",
      "tag": "prose",
      "target_sha256": "d0e03261b5a86a5283827f2ec0e19338295a9101f6ffe14fb3c521d4eddaf61e"
    },
    {
      "source_id": "fr81-u062-r0004",
      "target": "Он отрицательно покачал головой.",
      "source_sha256": "2de277fc982b55a8e632d05a2bf3d66178e5bd45092c85d08222dd18adc00ff1",
      "target_id": "ru-fr81-u062-r0004",
      "tag": "prose",
      "target_sha256": "5b07be3c55fa0248f08b418b440f9292cb6240f6c347771fe88256b1f8f92db4"
    },
    {
      "source_id": "fr81-u062-r0005",
      "target": "— Конюх говорит, что лошадь господина очень утомилась!",
      "source_sha256": "fcbb07f2570cef3d512b85fa82743380ebd3e23fdc06032e279250fb249ee97a",
      "target_id": "ru-fr81-u062-r0005",
      "tag": "prose",
      "target_sha256": "44918bed94befa357d3daa9b21aa1188531f774ac06c2eeced519496850ccbd3"
    },
    {
      "source_id": "fr81-u062-r0006",
      "target": "Тут он нарушил молчание.",
      "source_sha256": "a2402079ad5cfdaf98268760d814ad0aa50d17f2a18587fca422c0b025ec5562",
      "target_id": "ru-fr81-u062-r0006",
      "tag": "prose",
      "target_sha256": "fe3be5a9bfcfa980634733fee4d2fff6a0899576f56a348a6ece4f6d5da4fd74"
    },
    {
      "source_id": "fr81-u062-r0007",
      "target": "— А разве лошадь не сможет выехать завтра утром?",
      "source_sha256": "0fbf44db46ad576bdde8615a664d2627c77f7b0c63200cf44b8542d1c9e19ef4",
      "target_id": "ru-fr81-u062-r0007",
      "tag": "prose",
      "target_sha256": "66822089648fcd961319d1d126122f3413bca2fb62313206d63bbacca7547269"
    },
    {
      "source_id": "fr81-u062-r0008",
      "target": "— О, сударь! Ей нужно по меньшей мере два дня отдыха.",
      "source_sha256": "f35265dc474c5ad365fe0e914b2d4d1dc0b19c99117dfacf2f30133d5aa183f4",
      "target_id": "ru-fr81-u062-r0008",
      "tag": "prose",
      "target_sha256": "279bbae922957da6da32546bb2f72c547ab45bf4ea537c30fc2ff7e4181f6251"
    },
    {
      "source_id": "fr81-u062-r0009",
      "target": "Он спросил:",
      "source_sha256": "fd14578316972d9a1fbcc2be77b1006ec7180a4525ead16a5589276e17ae0e82",
      "target_id": "ru-fr81-u062-r0009",
      "tag": "prose",
      "target_sha256": "95056e6f2002884a074fb73d21984afab96eff5ee479652658fa39da426b42bc"
    },
    {
      "source_id": "fr81-u062-r0010",
      "target": "— Ведь здесь почтовая контора?",
      "source_sha256": "fddb6069ac02e1625f40dd686b7907d327f974394f5f5ae644fddeed92755a9e",
      "target_id": "ru-fr81-u062-r0010",
      "tag": "prose",
      "target_sha256": "32b5c9a8495e5405ff205a2f4f4b4670c327784ac512c7c820ef56c7a5d8da8b"
    },
    {
      "source_id": "fr81-u062-r0011",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u062-r0011",
      "tag": "prose",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "fr81-u062-r0012",
      "target": "Хозяйка проводила его в контору; он показал паспорт и осведомился, нельзя ли в эту же ночь вернуться в Монтрейль-сюр-Мер с почтовой каретой; место рядом с курьером оказалось как раз свободным; он занял его и заплатил. — Сударь, — сказал конторщик, — не опоздайте явиться сюда к отправлению ровно в час ночи.",
      "source_sha256": "54ec0d4a058c9aaff01abd55c2f7744cc30d76b1d739fbfe7b0014613955dcac",
      "target_id": "ru-fr81-u062-r0012",
      "tag": "prose",
      "target_sha256": "344701c36a79614136b43c1857bfa228a83abfda9f7ca6228cc66864d118fb53"
    },
    {
      "source_id": "fr81-u062-r0013",
      "target": "Сделав это, он вышел из гостиницы и стал бродить по городу.",
      "source_sha256": "d88e956922d67a14962bef66256856ac139b2ce59ac5f2eb4bdb9dcdef340cf8",
      "target_id": "ru-fr81-u062-r0013",
      "tag": "prose",
      "target_sha256": "344aaed8e1511bc7c74e072a1abd9d843f09426e732819943ed8463680dca35b"
    },
    {
      "source_id": "fr81-u062-r0014",
      "target": "Он не знал Арраса, улицы были тёмные, и он шёл наугад. Однако он, казалось, упорно не желал спрашивать дорогу у прохожих. Он перешёл через речку Кринчон и оказался в лабиринте узких переулков, где заблудился. Навстречу шёл горожанин с фонарём. После некоторого колебания он решил обратиться к этому горожанину, предварительно оглядевшись вперёд и назад, словно боялся, как бы кто-нибудь не услышал вопроса, который он собирался задать.",
      "source_sha256": "73d0af1abefb355c2e5739f65f9b9293001d8499ab88bcf810037a2149b76746",
      "target_id": "ru-fr81-u062-r0014",
      "tag": "prose",
      "target_sha256": "80e5726881721ee4d85fc155300644c780ff34adf5fe2d3ea094b92c5669fdc0"
    },
    {
      "source_id": "fr81-u062-r0015",
      "target": "— Сударь, — сказал он, — не будете ли вы так добры указать, где здание суда?",
      "source_sha256": "7328187715bb7be31b3443d95c387912cc09a66cdac05c378f83ed15dbe7acfb",
      "target_id": "ru-fr81-u062-r0015",
      "tag": "prose",
      "target_sha256": "ef98a57787d3093913d030db28dd5b673336ce8d64b4b15561949db40865595f"
    },
    {
      "source_id": "fr81-u062-r0016",
      "target": "— Вы нездешний, сударь? — отвечал горожанин, человек довольно пожилой. — Ну что же, идёмте за мной. Мне как раз по пути к зданию суда, то есть к зданию префектуры. Дело в том, что сейчас Дворец правосудия ремонтируют, и суды временно заседают в префектуре.",
      "source_sha256": "8896235e6981c0b678413664628ce7532570a5ba221997a37f2a974ad888c6a4",
      "target_id": "ru-fr81-u062-r0016",
      "tag": "prose",
      "target_sha256": "2949c5ac35b79e19c84e10c5a8385a8b58cf9ecbd054031fec01cab7fb137e4a"
    },
    {
      "source_id": "fr81-u062-r0017",
      "target": "— Там ли, — спросил он, — заседает суд присяжных?",
      "source_sha256": "d75e858c01ec58c2c624f596ccca31783b162fea0f7f594f8ba99911fef2c058",
      "target_id": "ru-fr81-u062-r0017",
      "tag": "prose",
      "target_sha256": "ee8a36a038f2579d60dbd12217787f4fc08d686f53706bbb3c2f29846bfdc1bc"
    },
    {
      "source_id": "fr81-u062-r0018",
      "target": "— Конечно, сударь. Видите ли, нынешняя префектура до революции была епископским дворцом. Господин де Консье, бывший епископом в восемьдесят втором году, велел там выстроить большую залу. Вот в этой большой зале и судят.",
      "source_sha256": "fce2743d4eab120e157d8c9221cc7207d4a0e0e0fc93375b0302b973de3a70c1",
      "target_id": "ru-fr81-u062-r0018",
      "tag": "prose",
      "target_sha256": "f3d3e43c295095ff00b94b49fb6cd8820948b0f304f791f2cc488d59a2673dc4"
    },
    {
      "source_id": "fr81-u062-r0019",
      "target": "Дорогой горожанин сказал ему:",
      "source_sha256": "f50058451bb6b91b9000d076835800ad1ee377f0159da453eadeaa87709b7726",
      "target_id": "ru-fr81-u062-r0019",
      "tag": "prose",
      "target_sha256": "e963c60c05f973cf435e850650ee896a3588b90ffd0ade30bc153af0b2f325a1"
    },
    {
      "source_id": "fr81-u062-r0020",
      "target": "— Если господин хочет посмотреть какой-нибудь процесс, то немного поздно. Обычно заседания кончаются в шесть часов.",
      "source_sha256": "268ee8a7c69633efd9144912a7e806b5a51ec34d6ab814d36d6c29e1b8bb75f6",
      "target_id": "ru-fr81-u062-r0020",
      "tag": "prose",
      "target_sha256": "568da095ed30fab0201b1d2d04221b7f4b8601df26cd3f61383b8c688f96b204"
    },
    {
      "source_id": "fr81-u062-r0021",
      "target": "Однако, когда они вышли на большую площадь, горожанин показал ему четыре длинных освещённых окна на фасаде обширного мрачного здания.",
      "source_sha256": "27d1f10f9df64991005ce2c1344e3b41b57d7068faa010ada9b8764a2e5f183e",
      "target_id": "ru-fr81-u062-r0021",
      "tag": "prose",
      "target_sha256": "106aa57a6458bca713eaf1836b56a4fb93f92ab969000927ed3a9a722326de81"
    },
    {
      "source_id": "fr81-u062-r0022",
      "target": "— Право, сударь, вы подоспели вовремя, вам повезло. Видите эти четыре окна? Это суд присяжных. Там свет. Значит, ещё не кончено. Верно, дело затянулось, и назначили вечернее заседание. Вас интересует это дело? Это уголовный процесс? Вы свидетель?",
      "source_sha256": "a01c394800f99fb91dd75e1ef064b320f69123a0790ed54b6eab6826bb7d8a59",
      "target_id": "ru-fr81-u062-r0022",
      "tag": "prose",
      "target_sha256": "16ceb59ac043a88682e3461da2f0e64fca38f52073418dd8d58d93820528fff1"
    },
    {
      "source_id": "fr81-u062-r0023",
      "target": "Он ответил:",
      "source_sha256": "199b619971afb212faa834f5669870844e27393d8deb51451f462df160009be2",
      "target_id": "ru-fr81-u062-r0023",
      "tag": "prose",
      "target_sha256": "b3eb94c304e72356e90b009354a82a871486deb46ab63968ffdf02f95cff5dfe"
    },
    {
      "source_id": "fr81-u062-r0024",
      "target": "— Я приехал не по делу, мне только нужно поговорить с одним адвокатом.",
      "source_sha256": "c20a6104419bd6a5455b47e94067a52e9497787510fd2102a988a69e64c653fe",
      "target_id": "ru-fr81-u062-r0024",
      "tag": "prose",
      "target_sha256": "e518a49f3b2624c4a754b655aead32d222aa426767183aa38d88804a6cf20c7d"
    },
    {
      "source_id": "fr81-u062-r0025",
      "target": "— Это другое дело, — сказал горожанин. — Вот, сударь, вход. Там, где часовой. Вам стоит только подняться по большой лестнице.",
      "source_sha256": "6bdac853c388fab71ddc4e47aeb7988acb5e6a9b80acde4488593aee1a2ea18d",
      "target_id": "ru-fr81-u062-r0025",
      "tag": "prose",
      "target_sha256": "840e3caeb2506ff290908ef3c0abbf58f4ba406c22f20bd3a9266945d28e8dc2"
    },
    {
      "source_id": "fr81-u062-r0026",
      "target": "Он последовал указаниям горожанина, и несколько минут спустя уже был в зале, где было много народа и где то здесь, то там перешёптывались разрозненные группы, в которых мелькали адвокаты в мантиях.",
      "source_sha256": "6c84b40cfd9388e641995968c7a0feaa2601f25e546daf84b465f55111d0ef25",
      "target_id": "ru-fr81-u062-r0026",
      "tag": "prose",
      "target_sha256": "02d79b054504893386b0e1ea48192f5f8a15455d78f761ea032870bb36a16bbf"
    },
    {
      "source_id": "fr81-u062-r0027",
      "target": "Всегда сжимается сердце при виде этих сборищ людей в чёрном, которые тихо переговариваются на пороге судебных палат. Редко из всех этих речей рождаются милосердие и сострадание. Чаще всего рождаются приговоры, вынесенные заранее. Все эти группы кажутся наблюдателю, который проходит мимо и задумывается, множеством мрачных ульев, где жужжащие умы сообща возводят всевозможные тёмные здания.",
      "source_sha256": "164fc0037896adf8a514ef0c094db01d011e4001ee15516f62c39021a58ad51c",
      "target_id": "ru-fr81-u062-r0027",
      "tag": "prose",
      "target_sha256": "37c10b2b6d2687023162761b28241567d097182198dbcf2c2e1b81d81a76bc74"
    },
    {
      "source_id": "fr81-u062-r0028",
      "target": "Эта зала, просторная и освещённая единственной лампой, была прежней залой епископского дворца и служила залом ожидания. Двустворчатая дверь, в эту минуту закрытая, отделяла её от большой палаты, где заседал суд присяжных.",
      "source_sha256": "185137649ddc04508dc6276fed02006dc95cd23e14829506d2d1b468a99499c0",
      "target_id": "ru-fr81-u062-r0028",
      "tag": "prose",
      "target_sha256": "89be8326a74c64318d159d512cc8c90e4504f57a64e3ea8036c35b6e4949bb5f"
    },
    {
      "source_id": "fr81-u062-r0029",
      "target": "Темнота была такова, что он без опаски обратился к первому встреченному адвокату.",
      "source_sha256": "c28b8ca180fa6a9a434bff86424999c83ee1539b6da41846869875c6b2d2c32d",
      "target_id": "ru-fr81-u062-r0029",
      "tag": "prose",
      "target_sha256": "2eead6e4b200bac0678ea3d8c2cff90dc9d57d07eed7a3c6872cf7333597a0d3"
    },
    {
      "source_id": "fr81-u062-r0030",
      "target": "— Сударь, — сказал он, — на чём остановились?",
      "source_sha256": "19024a509fa67cbca60ae08e1d351feeb59b876435c2d4385288682254a21c66",
      "target_id": "ru-fr81-u062-r0030",
      "tag": "prose",
      "target_sha256": "713bf254d278a9b14ca6608fae258173bf95cd910b0001ab243f870b12c6e971"
    },
    {
      "source_id": "fr81-u062-r0031",
      "target": "— Всё кончено, — сказал адвокат.",
      "source_sha256": "87af72193a8b613b030d2f67d3bd990fc79f02aa4ccc33a1c28696e7841f106a",
      "target_id": "ru-fr81-u062-r0031",
      "tag": "prose",
      "target_sha256": "fef39f61486b1d9e16cc8bed93eb9a7f8cd46d6f3c1915a934bebfa9b3b49221"
    }
  ],
