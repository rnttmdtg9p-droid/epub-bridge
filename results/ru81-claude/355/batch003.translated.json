{
  "unit": 355,
  "batch": 3,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u355-r0095",
      "target": "— Козетта!.. — пробормотал Мариус. И замолчал. Они были похожи на двух преступников.",
      "source_sha256": "ce62f038ea8584f805cf42ab3f8436b4168f3fc84e2f24669c6beb7795e3dbc9",
      "target_id": "ru-fr81-u355-r0095",
      "tag": "prose",
      "target_sha256": "bbf24351f4da443dcb980acde3380d505895b19d54d844fe6c74f00827d70104"
    },
    {
      "source_id": "fr81-u355-r0096",
      "target": "Козетта, сияющая, продолжала смотреть на них обоих. В её глазах словно проглядывал рай.",
      "source_sha256": "9ed70653602826054317325582d215c0cbca6d8aa831834aab64b0897f404e4d",
      "target_id": "ru-fr81-u355-r0096",
      "tag": "prose",
      "target_sha256": "78bd4c32d25f500a4ad0718dd01c439b61aeeb8fad7ff20827d72dabbe219173"
    },
    {
      "source_id": "fr81-u355-r0097",
      "target": "— Я поймала вас с поличным, — сказала Козетта. — Я только что слышала сквозь дверь, как мой отец Фошлеван говорил: «Совесть…» — «Исполнить свой долг…» Это политика. Не хочу! Нельзя говорить о политике на другой же день. Это несправедливо.",
      "source_sha256": "34361a4b3dea39722a2014e9586622ccd65c33ff151737b543460be1f30ba140",
      "target_id": "ru-fr81-u355-r0097",
      "tag": "prose",
      "target_sha256": "d5827fab6d320b1e6a1b0e4f9a40794a87230658bc3bed1a6c503998e66da499"
    },
    {
      "source_id": "fr81-u355-r0098",
      "target": "— Ты ошибаешься, Козетта, — ответил Мариус. — Мы говорим о делах. Мы говорим о том, как лучше поместить твои шестьсот тысяч франков…",
      "source_sha256": "e9846dacc494edb918dfd00215950d232742b5d4b3ee6eb0f8cf410b49f0d0a7",
      "target_id": "ru-fr81-u355-r0098",
      "tag": "prose",
      "target_sha256": "6d3bca79f3ae18598e7a309ecbf85640331b3138f46a59edd90e4c2a6c8bbef8"
    },
    {
      "source_id": "fr81-u355-r0099",
      "target": "— Дело не в этом, — перебила Козетта. — Я пришла. Хотят ли меня здесь?",
      "source_sha256": "61406d799eb2ea84c4464c899f0cf9b3987e707ba79d821affed48ddc3ba0251",
      "target_id": "ru-fr81-u355-r0099",
      "tag": "prose",
      "target_sha256": "757b369e4d5aa47822167754631680852bbedffb7d67868927c9f6fa6827ca2f"
    },
    {
      "source_id": "fr81-u355-r0100",
      "target": "И, решительно переступив порог, она вошла в гостиную. На ней был широкий белый пеньюар с тысячью складок и большими рукавами, спускавшийся от самой шеи до пят. В золотых небесах старых готических картин встречаются такие очаровательные мешки, в которые одет ангел.",
      "source_sha256": "3cb86d626218ad508ec4898b10e74baceaced74edc0930e1c3f0ffbdbc846710",
      "target_id": "ru-fr81-u355-r0100",
      "tag": "prose",
      "target_sha256": "823fe73d45e94769d3f3e2cf63106d02d1b1c774f3ea91cc9cb7b1277a1475b5"
    },
    {
      "source_id": "fr81-u355-r0101",
      "target": "Она оглядела себя с головы до ног в большом зеркале, затем воскликнула в порыве несказанного восторга:",
      "source_sha256": "d119400943f28158e9b36a936594decbdf135ff01d83f18badeb8cab2d70d70a",
      "target_id": "ru-fr81-u355-r0101",
      "tag": "prose",
      "target_sha256": "c2185c3e0592d4e6aa65679db674adfd10476898f7472aa8904a1a2b690deb27"
    },
    {
      "source_id": "fr81-u355-r0102",
      "target": "— Жили-были король и королева. Ах, как я довольна!",
      "source_sha256": "a33c500d0a4a45af5abdb0a450ff382c45606b9db514475a380053556abeb2ab",
      "target_id": "ru-fr81-u355-r0102",
      "tag": "prose",
      "target_sha256": "4f3fabfdd0437c5f7f05d866c7d70fd3693524f9b996a789817cd10028ed6fa3"
    },
    {
      "source_id": "fr81-u355-r0103",
      "target": "Сказав это, она сделала реверанс Мариусу и Жану Вальжану.",
      "source_sha256": "847bc94c81f1fe7b0841e1421cf28f8ce94f7a651ac3e3c958ac1bf406625554",
      "target_id": "ru-fr81-u355-r0103",
      "tag": "prose",
      "target_sha256": "24cfeae75ef4ba84ceb78e63fe78ad0605647262473a00c820c0a67b0069b2fb"
    },
    {
      "source_id": "fr81-u355-r0104",
      "target": "— Вот, — сказала она, — я усядусь рядом с вами в кресло, завтрак через полчаса, говорите всё, что хотите, я хорошо знаю, что мужчинам нужно поговорить, я буду очень умницей.",
      "source_sha256": "3ec415115e359a6085eb085e39e1fc80a892a57cc2a80393d946ca0f785a4dce",
      "target_id": "ru-fr81-u355-r0104",
      "tag": "prose",
      "target_sha256": "d7edc4bf30e1f4d13e5b208596c857effa21866439cb049acf1ab1861573a690"
    },
    {
      "source_id": "fr81-u355-r0105",
      "target": "Мариус взял её под руку и сказал ей с нежностью:",
      "source_sha256": "b8551dffffbd8d187d29d2375b235516ca14683ec41432c32d6c13594bf56165",
      "target_id": "ru-fr81-u355-r0105",
      "tag": "prose",
      "target_sha256": "d670ea4c797ff37c6388e076ea452e6c27c22376fe403f340ba95cec48aaac55"
    },
    {
      "source_id": "fr81-u355-r0106",
      "target": "— Мы говорим о делах.",
      "source_sha256": "832eadeb3bbce73b6ebe3c7f56f854699e1c76aa0115137ba4af0c2a862111b2",
      "target_id": "ru-fr81-u355-r0106",
      "tag": "prose",
      "target_sha256": "470a3af4b62ae4b780e301ff7281a0524a5828247beb8b1bc2b3d65865029887"
    },
    {
      "source_id": "fr81-u355-r0107",
      "target": "— Кстати, — ответила Козетта, — я открыла окно, и в сад только что прилетела целая стая пьеро. Птиц, а не масок. Сегодня пепельная среда; но не для птиц.",
      "source_sha256": "67e005afec95aa7d315e2b8a95bf858b892094249731626bd910d6cab08268d7",
      "target_id": "ru-fr81-u355-r0107",
      "tag": "prose",
      "target_sha256": "7f5e965a00d5dfc148f3ff2d9b5bd85806d12c78011073da71a2d330b9b01918"
    },
    {
      "source_id": "fr81-u355-r0108",
      "target": "— Говорю тебе, мы говорим о делах, ступай, моя маленькая Козетта, оставь нас на минуту. Мы говорим о цифрах. Тебе будет скучно.",
      "source_sha256": "e75acb4b8b21e5a6502ef2fe5d47cd2afe6fc73a2606927998e9ceaa71a54a9a",
      "target_id": "ru-fr81-u355-r0108",
      "tag": "prose",
      "target_sha256": "62ea77d580ff505d8b4398c38b0d87f64767339f99ccd42b85a5d52a3059dfa5"
    },
    {
      "source_id": "fr81-u355-r0109",
      "target": "— Ты сегодня утром надел очаровательный галстук, Мариус. Вы большой щёголь, монсеньор. Нет, мне не будет скучно.",
      "source_sha256": "2c07f633f8af2916b9351ea9f7b20d52fe886938f457e99e1c1202a73fd19878",
      "target_id": "ru-fr81-u355-r0109",
      "tag": "prose",
      "target_sha256": "3ed3d4b5b1a9afd7cc52ee8e7e88915a871c9ed6c3f90521fa33a2c1ded43258"
    },
    {
      "source_id": "fr81-u355-r0110",
      "target": "— Уверяю тебя, тебе будет скучно.",
      "source_sha256": "2888d59d12c416e48966dbc5c3e2a941648b6d5f9c183ed1e2c11e81696f64a5",
      "target_id": "ru-fr81-u355-r0110",
      "tag": "prose",
      "target_sha256": "de6674c44dd4999a01003435551ef9495466b57e3ec5cbe8c9f2d827cf495be3"
    },
    {
      "source_id": "fr81-u355-r0111",
      "target": "— Нет. Раз это вы. Я вас не пойму, но буду слушать. Когда слышишь любимые голоса, не нужно понимать слова, которые они произносят. Быть здесь вместе — вот всё, чего я хочу. Я остаюсь с вами, вот ещё!",
      "source_sha256": "ea979cc04ee40958cb5d832a395cd75affd5a46341f0f498377eb339e10329de",
      "target_id": "ru-fr81-u355-r0111",
      "tag": "prose",
      "target_sha256": "96c01ef41f619adc1091f883976c99ccedacc657fbfaf96f36b311c2ef26ea5b"
    },
    {
      "source_id": "fr81-u355-r0112",
      "target": "— Ты моя возлюбленная Козетта! Это невозможно.",
      "source_sha256": "6c4e0701b5c73b7f13c7de7cef77e37acf0f778d65a130d9ebe8b870285fb115",
      "target_id": "ru-fr81-u355-r0112",
      "tag": "prose",
      "target_sha256": "e3c1afea4ac70421ce8d62a6edee3f260c6b1032794ee99e9a5b9722bddc8e89"
    },
    {
      "source_id": "fr81-u355-r0113",
      "target": "— Невозможно!",
      "source_sha256": "a63a8ea405d74d4c7ee5762e33ab385ed8c6c05a6c10dae054cf458f7b7795a0",
      "target_id": "ru-fr81-u355-r0113",
      "tag": "prose",
      "target_sha256": "699dae64363d99ebe667678c15fc9300f26e8d6488aba537fdb24287b187d0da"
    },
    {
      "source_id": "fr81-u355-r0114",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u355-r0114",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u355-r0115",
      "target": "— Хорошо, — продолжала Козетта. — Я бы рассказала вам новости. Я бы сказала вам, что мой дедушка ещё спит, что ваша тётка на обедне, что в комнате моего отца Фошлевана дымит камин, что Николетта позвала трубочиста, что Туссен и Николетта уже успели поссориться, что Николетта смеётся над заиканием Туссен. Ну так вы ничего не узнаете! Ах, это невозможно? Теперь и я, в свой черёд, вот увидите, сударь, скажу: это невозможно. Кто тогда окажется в дураках? Прошу тебя, мой маленький Мариус, оставь меня здесь с вами обоими.",
      "source_sha256": "fa78f94856f61ac4a1fce0c2c29524ab72fc58a2065ff7d171783afa6bf05d11",
      "target_id": "ru-fr81-u355-r0115",
      "tag": "prose",
      "target_sha256": "ac071c15f0fda86205dfd6a5808fcccf17b84325d8fdd1aedc21c3326b9746cd"
    },
    {
      "source_id": "fr81-u355-r0116",
      "target": "— Клянусь тебе, нам нужно остаться одним.",
      "source_sha256": "af510575cebe5dc5449e6d4ffbc5c74713b9b3386666f3a6446241cadf731940",
      "target_id": "ru-fr81-u355-r0116",
      "tag": "prose",
      "target_sha256": "cf9d6a7b77a2f737eaff01d892eedece4d95dee3f2cf99854cebf5e7cf85470f"
    },
    {
      "source_id": "fr81-u355-r0117",
      "target": "— Ну а я что же, никто?",
      "source_sha256": "d49944029a90066c13585b109d76c05d6d1c0d504071db17d0b2bc0807743c81",
      "target_id": "ru-fr81-u355-r0117",
      "tag": "prose",
      "target_sha256": "647fbd281765111533a926bca600748c782c85549ea92d71452a118c0a374ecf"
    },
    {
      "source_id": "fr81-u355-r0118",
      "target": "Жан Вальжан не произносил ни слова. Козетта повернулась к нему:",
      "source_sha256": "d65de561f9b1d8093984b932229b3ec596d0904c6199c6c015ffcbcfef551bda",
      "target_id": "ru-fr81-u355-r0118",
      "tag": "prose",
      "target_sha256": "04061e6479f17a42692f7e552a366b0eb397bf84319d3ee120cbd1502de4d2e7"
    },
    {
      "source_id": "fr81-u355-r0119",
      "target": "— Прежде всего, отец, вы: я хочу, чтобы вы подошли поцеловать меня. Что вы там делаете, молчите, вместо того чтобы стать на мою сторону? Кто дал мне такого отца? Вы же видите, что я очень несчастна в замужестве. Муж меня бьёт. Ну же, поцелуйте меня сейчас же.",
      "source_sha256": "d673e9a39cfbdff2786a71fca1761cb2c472455bd8c10f1889b280e36dffc618",
      "target_id": "ru-fr81-u355-r0119",
      "tag": "prose",
      "target_sha256": "cc9bd5cdc7c2242b9959daa898b94fae5aea3e233642dcceaf5323ea2c55dd16"
    },
    {
      "source_id": "fr81-u355-r0120",
      "target": "Жан Вальжан подошёл.",
      "source_sha256": "727e94e2fdedf7b0ed3373836a39d205cb8ef545c3c49c3e19466a44540b3837",
      "target_id": "ru-fr81-u355-r0120",
      "tag": "prose",
      "target_sha256": "921064c390cb673db822c0966240cba665bd7f3999e5da6ed743175bca46e450"
    },
    {
      "source_id": "fr81-u355-r0121",
      "target": "Козетта повернулась к Мариусу.",
      "source_sha256": "ca022a2a5a9aecba539895880372855ec1825513db257c50c556195ab2d0dcb3",
      "target_id": "ru-fr81-u355-r0121",
      "tag": "prose",
      "target_sha256": "18c2e117f3528f06f1832ef839b9ea4b808546e27b688932ff21c66aa1b812d1"
    },
    {
      "source_id": "fr81-u355-r0122",
      "target": "— А вам я скорчу гримасу.",
      "source_sha256": "8c2d321ea6180750586a1f04531f2a10afb7e14b121f00e64b1392576e7a9076",
      "target_id": "ru-fr81-u355-r0122",
      "tag": "prose",
      "target_sha256": "7ea4508c6e0a0674df430d98d65ab07b984432ee2058be3d1e75343e1f92837f"
    },
    {
      "source_id": "fr81-u355-r0123",
      "target": "Потом она подставила лоб Жану Вальжану.",
      "source_sha256": "91d2c31be6570efdad7d4de029ab1e51521d7608ea963ca5c30aae6da027fbfa",
      "target_id": "ru-fr81-u355-r0123",
      "tag": "prose",
      "target_sha256": "9ad0dfe531345c05346bc597d92feedfa51b4f203808122ba4b8cc6a212ce137"
    },
    {
      "source_id": "fr81-u355-r0124",
      "target": "Жан Вальжан сделал шаг к ней.",
      "source_sha256": "64dcbc4e2068f799be28edfacbd7583f1490ee0fdf19aead0211facf2422d1a7",
      "target_id": "ru-fr81-u355-r0124",
      "tag": "prose",
      "target_sha256": "9da0b4a02f53f9225b4733425c429180279d573d9c67c95d9bb274c41396d74a"
    },
    {
      "source_id": "fr81-u355-r0125",
      "target": "Козетта отступила.",
      "source_sha256": "ee9e3ab8716ddcee2a771ef7680056ad682fcbfe1439c7da01b7b963d06a4f8d",
      "target_id": "ru-fr81-u355-r0125",
      "tag": "prose",
      "target_sha256": "4c1402f1f6262af18d45c8a413b36aac34d6b6aeb749923c2c1f55d4bf931207"
    },
    {
      "source_id": "fr81-u355-r0126",
      "target": "— Отец, вы бледны. У вас болит рука?",
      "source_sha256": "2a1591fcda79420cb61c5636661e24f21724e007ecb76b34543b3fa59db7bf93",
      "target_id": "ru-fr81-u355-r0126",
      "tag": "prose",
      "target_sha256": "85cff2f474ce3690aa83c031c23efc4e945e4058dcb013a67027d32f05f5ddf1"
    }
  ],
