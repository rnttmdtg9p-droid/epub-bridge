{
  "unit": 355,
  "batch": 4,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u355-r0127",
      "target": "— Она зажила, — сказал Жан Вальжан.",
      "source_sha256": "df1a846319dfb2563ebe2ac989737928fa76ed30978a6813375802dfecfff93b",
      "target_id": "ru-fr81-u355-r0127",
      "tag": "prose",
      "target_sha256": "638da149a667873c486282f4ccf1d245f7e643d7a9373d758b0e488484a41a9a"
    },
    {
      "source_id": "fr81-u355-r0128",
      "target": "— Вы плохо спали?",
      "source_sha256": "677035fe18b29692eb5af7eb4bc2790f8657f403e2bcad2c2d43e59c517cad51",
      "target_id": "ru-fr81-u355-r0128",
      "tag": "prose",
      "target_sha256": "3ff53d885b6c558dd1cd03802bb6d84f4c3c3680dd663e007bcff4407e33f85d"
    },
    {
      "source_id": "fr81-u355-r0129",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u355-r0129",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u355-r0130",
      "target": "— Вам грустно?",
      "source_sha256": "20adb97c747e54481e652044bb938ac0b1846fae63b8107afdab75132cd48a9a",
      "target_id": "ru-fr81-u355-r0130",
      "tag": "prose",
      "target_sha256": "c68e6b992ba12b949408c41a7bdfe25e33ce0f0fce594415f7b6954d592bb572"
    },
    {
      "source_id": "fr81-u355-r0131",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u355-r0131",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u355-r0132",
      "target": "— Поцелуйте меня. Если вы здоровы, если вы хорошо спите, если вы довольны, я не стану вас бранить.",
      "source_sha256": "b256af18d7a48af2f1c01f9a2f77beffa8b40c45f06da24f9ed852694048ec98",
      "target_id": "ru-fr81-u355-r0132",
      "tag": "prose",
      "target_sha256": "baac7885b155cf46741a4e4abc9cf626a5bc7bc2965f62a4a3b86d8d2f6ff4af"
    },
    {
      "source_id": "fr81-u355-r0133",
      "target": "И она снова подставила ему лоб.",
      "source_sha256": "30eb6da21c3cbd740dba539e7e84216e013480b6865089e96f541a8f21ee2d96",
      "target_id": "ru-fr81-u355-r0133",
      "tag": "prose",
      "target_sha256": "d810549fee466bd31c1ebf350c5404a4ec0b35a0770ad6b565d4adebca950fe6"
    },
    {
      "source_id": "fr81-u355-r0134",
      "target": "Жан Вальжан поцеловал этот лоб, на котором лежал небесный отблеск.",
      "source_sha256": "368ee8a0e0484e29fa84ea1b037d49d466c671cec5a8caf762252424069eccaf",
      "target_id": "ru-fr81-u355-r0134",
      "tag": "prose",
      "target_sha256": "793d2e658a4fc09b30804b74eb107585197fb10585e6b87ab71e40c53c7b78be"
    },
    {
      "source_id": "fr81-u355-r0135",
      "target": "— Улыбнитесь.",
      "source_sha256": "980b7f788fa7f71c31e56a1e191453200a35ecac02b6308fc0e91e8d95d1480c",
      "target_id": "ru-fr81-u355-r0135",
      "tag": "prose",
      "target_sha256": "912618b8a2dea30557acb6b74f16f6e7dbdf447fdcb58a876bbbb79ae3d2c923"
    },
    {
      "source_id": "fr81-u355-r0136",
      "target": "Жан Вальжан повиновался. Это была улыбка призрака.",
      "source_sha256": "cd1f5712febc946e73280ffeb2865e2dec96f253e09d9ee155eea37cddd5af2c",
      "target_id": "ru-fr81-u355-r0136",
      "tag": "prose",
      "target_sha256": "8cbf6f711fe4d5cd02c41068d037c8dafa97ba7d1b7cd23411bb94e3753e898f"
    },
    {
      "source_id": "fr81-u355-r0137",
      "target": "— А теперь защитите меня от моего мужа.",
      "source_sha256": "4e2d8474104cac00cdbfdb15ef48b7973bcb21a5f73f25dec3c4141311b6440c",
      "target_id": "ru-fr81-u355-r0137",
      "tag": "prose",
      "target_sha256": "0d58784018aa1258086ea5f3f595adfcf93ba1a9bb75508ca385bcff2251fe6e"
    },
    {
      "source_id": "fr81-u355-r0138",
      "target": "— Козетта!.. — сказал Мариус.",
      "source_sha256": "db54ae506964c838b3eb5c21dc7a59b6cd1e39b5e5064cbf9fa30978bb94f041",
      "target_id": "ru-fr81-u355-r0138",
      "tag": "prose",
      "target_sha256": "1f2fd22a281ea38d798ec952b8fcccd17a53095c0cf7caae34f0a9ec0182f925"
    },
    {
      "source_id": "fr81-u355-r0139",
      "target": "— Рассердитесь, отец. Скажите ему, что я должна остаться. При мне вполне можно разговаривать. Вы, значит, считаете меня очень глупенькой. Неужели то, о чём вы говорите, так уж удивительно! Дела, вложить деньги в банк — подумаешь, важность. Мужчины напускают на себя таинственность из-за пустяков. Я хочу остаться. Сегодня утром я очень хороша. Посмотри на меня, Мариус.",
      "source_sha256": "13587a000e948401744c5c3e2befc570a199065a9f42d6f2f84a14486b78b424",
      "target_id": "ru-fr81-u355-r0139",
      "tag": "prose",
      "target_sha256": "a21501f84d8c18dfe670489442c9435c74d774fc5a515d4aea4bfc7157867ad5"
    },
    {
      "source_id": "fr81-u355-r0140",
      "target": "И с очаровательным движением плеч и с какой-то восхитительной обидой она посмотрела на Мариуса. Между этими двумя существами словно сверкнула молния. Что при этом был кто-то третий — не имело значения.",
      "source_sha256": "262d94367dff8851aaecb50ce76dc2b512d70a30133b911c430ae609cda3701b",
      "target_id": "ru-fr81-u355-r0140",
      "tag": "prose",
      "target_sha256": "e67da00f4f9af7ac3f43f0b73810f30e5091303687ab4ca7cdf43a253bd572c0"
    },
    {
      "source_id": "fr81-u355-r0141",
      "target": "— Я люблю тебя! — сказал Мариус.",
      "source_sha256": "fe964dd91323d129749942380e8c4a7290237d29c95f9378232154eb724578fc",
      "target_id": "ru-fr81-u355-r0141",
      "tag": "prose",
      "target_sha256": "a2a390522e88fa01a5d35ff41ea68e8cc6a9ea3fa009e928425ff8cfaae7341d"
    },
    {
      "source_id": "fr81-u355-r0142",
      "target": "— Я обожаю тебя! — сказала Козетта.",
      "source_sha256": "a61c8275a4b2695b637f50e839038467a0ab58199be9459af5eee8e91d8b443a",
      "target_id": "ru-fr81-u355-r0142",
      "tag": "prose",
      "target_sha256": "8b59f3dade866006b5e4872d240b4938b1446f1ff5133e61294bf9be5d37b3e3"
    },
    {
      "source_id": "fr81-u355-r0143",
      "target": "И они неудержимо упали друг другу в объятия.",
      "source_sha256": "387fbcb55378be5bbda1e6000236ac278a67a0a74da628f7c328c599275e00d2",
      "target_id": "ru-fr81-u355-r0143",
      "tag": "prose",
      "target_sha256": "2f86fbab31c3e2be340ed5efa5158953afc5b9a41ee42482fbc85bcd8d1e701f"
    },
    {
      "source_id": "fr81-u355-r0144",
      "target": "— А теперь, — продолжала Козетта, поправляя складку своего пеньюара и торжествующе надув губки, — я остаюсь.",
      "source_sha256": "c776f5142312845390ccd74a63754a52ab147f43dae3ac8b49d27066aae4ddef",
      "target_id": "ru-fr81-u355-r0144",
      "tag": "prose",
      "target_sha256": "21e83daff907a062933f8631aaa8921e88a67d1ba35cb553d3ec362cca9ae352"
    },
    {
      "source_id": "fr81-u355-r0145",
      "target": "— Нет, этого нельзя, — умоляющим тоном ответил Мариус. — Нам надо кое-что закончить.",
      "source_sha256": "d757cd76f3fcea17243e2a4fecece8a3a1707f7cd70f36a5ddc59c90978f291c",
      "target_id": "ru-fr81-u355-r0145",
      "tag": "prose",
      "target_sha256": "c6ba84f0bfa823e03371dc01531cf41ee9ea60962e54d8dc888b15ee11fc3956"
    },
    {
      "source_id": "fr81-u355-r0146",
      "target": "— Опять нет?",
      "source_sha256": "55b5af80bf5d37f329a09a371053357a97547553f0899652d1e9861b8780f57f",
      "target_id": "ru-fr81-u355-r0146",
      "tag": "prose",
      "target_sha256": "dc522d2c2b8384ebbb8801bcf7108f912c25fdaad4d0c7cc770cb1403a4b4679"
    },
    {
      "source_id": "fr81-u355-r0147",
      "target": "Мариус заговорил серьёзным голосом:",
      "source_sha256": "be5d50d8fcfa4e19eace719306f830b782987e625fa81318819c269d47c9488f",
      "target_id": "ru-fr81-u355-r0147",
      "tag": "prose",
      "target_sha256": "545127a76001eb225a459e3abe67c6ae11b62316c8b559e7a92ed891158c09dd"
    },
    {
      "source_id": "fr81-u355-r0148",
      "target": "— Уверяю тебя, Козетта, это невозможно.",
      "source_sha256": "43186745ddd57238a2fd5c0ee7d928658226b74292dd60ba1b23a276e31e33f5",
      "target_id": "ru-fr81-u355-r0148",
      "tag": "prose",
      "target_sha256": "0024f22df0926cca6ad3a49af05d1f3c4110605dfc7e1323af8fe1af955ef6b0"
    },
    {
      "source_id": "fr81-u355-r0149",
      "target": "— Ах! Вы заговорили мужским голосом, сударь. Хорошо, я ухожу. Вы, отец, меня не поддержали. Господин мой муж, господин мой папенька, вы тираны. Я пожалуюсь дедушке. Если вы думаете, что я вернусь и стану перед вами рассыпаться в любезностях, вы ошибаетесь. Я горда. Теперь это я вас жду. Вот увидите, это вам без меня станет скучно. Ухожу, так вам и надо.",
      "source_sha256": "b1175761c8743242ca34f8166cbcc00f9eaec25a157850c4c85c4281f9773d0d",
      "target_id": "ru-fr81-u355-r0149",
      "tag": "prose",
      "target_sha256": "82fd28728d28c5c239309c96a71155e13cfc503a1e6813c0dbcba29b26988f15"
    },
    {
      "source_id": "fr81-u355-r0150",
      "target": "И она вышла.",
      "source_sha256": "008b0762e188cca7b33b342e78447c10b6439d6ad229cf48514947c12bd98d26",
      "target_id": "ru-fr81-u355-r0150",
      "tag": "prose",
      "target_sha256": "c05741b28556c73f87403919a635cefb1d4f21b7f45603ac8bb03dfd282282c7"
    },
    {
      "source_id": "fr81-u355-r0151",
      "target": "Через две секунды дверь снова отворилась, её свежая румяная головка ещё раз показалась между створками, и она крикнула им:",
      "source_sha256": "04305ada0ff0db8224c9f8c5dd321ef237b3e426edc4cff0a2e2c2a67cac9b13",
      "target_id": "ru-fr81-u355-r0151",
      "tag": "prose",
      "target_sha256": "d9ed1fbddeddebf62ea07aeb88af8a2b1ab73a35c51eaec1e5c82acb6d504edc"
    },
    {
      "source_id": "fr81-u355-r0152",
      "target": "— Я очень сердита.",
      "source_sha256": "fae32897019140c2a2b0482358e968fd7af95640a0b1e810a944695377ce2260",
      "target_id": "ru-fr81-u355-r0152",
      "tag": "prose",
      "target_sha256": "81638f2d24e905511aff7fe24b90332b1c1e1e0e7761a52d964e175880863517"
    },
    {
      "source_id": "fr81-u355-r0153",
      "target": "Дверь затворилась, и тьма сомкнулась вновь.",
      "source_sha256": "89f0b5660040fde4203c70ba8a178fb097fc29573117fd0cff2a6a7798963cb6",
      "target_id": "ru-fr81-u355-r0153",
      "tag": "prose",
      "target_sha256": "6b34b9e7a2ce9db654e3760fcb1c66bdb9c5e6f7cfa8b267a3961a02760ec905"
    },
    {
      "source_id": "fr81-u355-r0154",
      "target": "Это было словно заблудившийся луч солнца, который, сам того не подозревая, внезапно пронзил ночную тьму.",
      "source_sha256": "a47f722ca96fe131a074e6613ae31570f29fc6fe2142379039adec807e3bca60",
      "target_id": "ru-fr81-u355-r0154",
      "tag": "prose",
      "target_sha256": "1919d9e598d0943fe196744a5bca695f6cc9d1c67312a0735ea54fde46b842ea"
    },
    {
      "source_id": "fr81-u355-r0155",
      "target": "Мариус удостоверился, что дверь плотно закрыта.",
      "source_sha256": "270807958125654d6549757a24424100c3c8c7269dc3353c7aaf53340261adc8",
      "target_id": "ru-fr81-u355-r0155",
      "tag": "prose",
      "target_sha256": "b69249aad1d9fa8a12568968c5d2ddae30c4d33108ca529637c451e22f9e55f2"
    },
    {
      "source_id": "fr81-u355-r0156",
      "target": "— Бедная Козетта! — прошептал он. — Когда она узнает…",
      "source_sha256": "5b8b85133a9301fd99948a64b140a05937d8e8587f2d7b6fa20a77ec0a076064",
      "target_id": "ru-fr81-u355-r0156",
      "tag": "prose",
      "target_sha256": "2146be8925962a3ccc5946edae32b37d79c8f87ff2329393729df42b4386f22f"
    },
    {
      "source_id": "fr81-u355-r0157",
      "target": "При этих словах Жан Вальжан затрепетал всем телом. Он устремил на Мариуса растерянный взгляд.",
      "source_sha256": "59c710de8e1661532911b70b2b1ce8575b114c34b09a8ea58e7975ac244b8466",
      "target_id": "ru-fr81-u355-r0157",
      "tag": "prose",
      "target_sha256": "f8afdf4228c7f1f213478b8bdd02d97003d81be49cc7106ff00497488b4e68ac"
    },
    {
      "source_id": "fr81-u355-r0158",
      "target": "— Козетта! О да, это правда, вы скажете об этом Козетте. Это справедливо. Подумать только, я об этом не подумал. На одно у человека хватает сил, на другое не хватает. Сударь, заклинаю вас, умоляю вас, сударь, дайте мне ваше самое священное слово, не говорите ей. Разве не довольно, что знаете вы? Я смог сказать сам, по собственной воле, никто меня не принуждал, я сказал бы это всему свету, всем на свете, мне было всё равно. Но она, она не знает, что это такое, это её ужаснуло бы. Каторжник, подумайте! Пришлось бы ей объяснять, говорить ей: это человек, который побывал на галерах. Она однажды видела, как проходила цепь. О Боже мой!",
      "source_sha256": "639f8b1051b0e7852334ac711d368169e62cebf438d9501cb34e7026a949c8f0",
      "target_id": "ru-fr81-u355-r0158",
      "tag": "prose",
      "target_sha256": "7d2926ab40c1679513bde434e3228a137593d36127abe6145626e85b76755d33"
    }
  ],
