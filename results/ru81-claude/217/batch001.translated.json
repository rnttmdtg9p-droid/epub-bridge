{
  "unit": 217,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u217-r0032",
      "target": "— Бургон ушла?",
      "source_sha256": "23260927534cf7c7df3b081bf5c8d5c07d7ea058f2f7a0993bd19f6758380308",
      "target_id": "ru-fr81-u217-r0032",
      "tag": "prose",
      "target_sha256": "033fe74fe9a9c8d98e320de9a812223b87fb64aeb58111d3ec1782cd8d0506de"
    },
    {
      "source_id": "fr81-u217-r0033",
      "target": "— Да, — сказала мать.",
      "source_sha256": "f4fff6e9564295391acddeb54984e3411fc24196fafe9e6b3d75b1525a008618",
      "target_id": "ru-fr81-u217-r0033",
      "tag": "prose",
      "target_sha256": "ddb14858b3e009669504a187d6923ae71d0a9390b4974de2e7d7e399aba10f3a"
    },
    {
      "source_id": "fr81-u217-r0034",
      "target": "— Ты уверена, что у соседа никого нет?",
      "source_sha256": "05a6ff3ca96aed7be3f15f4326548083ebc49477b8f9629529e2a772e552913f",
      "target_id": "ru-fr81-u217-r0034",
      "tag": "prose",
      "target_sha256": "06ebb659f365da150290f2674b3458653b874f23bd1a6536c737be936c069cb8"
    },
    {
      "source_id": "fr81-u217-r0035",
      "target": "— Он весь день не возвращался, а ты прекрасно знаешь, что сейчас время его обеда.",
      "source_sha256": "854ccde125055653439e2d22f31fde60dfe330f307da0cee1ccdbb345ea9a5df",
      "target_id": "ru-fr81-u217-r0035",
      "tag": "prose",
      "target_sha256": "7b1d9c5904500b1cebbaf94b4027a2b284cc225d79ab9c007a7b278134224376"
    },
    {
      "source_id": "fr81-u217-r0036",
      "target": "— Ты уверена?",
      "source_sha256": "e6dae2ca624c5bdbe2ed26a32bb46f1e97909f793c387a7926aaabb6e2b4a595",
      "target_id": "ru-fr81-u217-r0036",
      "tag": "prose",
      "target_sha256": "d1810e0b68faef1eefb1ea4144a283dcd3a3912bff221fb05acfcb382859ddb2"
    },
    {
      "source_id": "fr81-u217-r0037",
      "target": "— Уверена.",
      "source_sha256": "f33f90a20b7e246fbde450495971467bb3201fc9b703d8a89d7c5693b8e6ef23",
      "target_id": "ru-fr81-u217-r0037",
      "tag": "prose",
      "target_sha256": "c2f35741807bdb452db5161ab8af8c7bdf23844d56f94fbffb2f74c71499af3d"
    },
    {
      "source_id": "fr81-u217-r0038",
      "target": "— Всё равно, — продолжал Жондрет, — не худо сходить посмотреть, у себя ли он. Дочка, возьми свечу и сходи.",
      "source_sha256": "43bb697e7db03a93af347b4b9cec6ee658700a72a4aebde866b88ae60247e019",
      "target_id": "ru-fr81-u217-r0038",
      "tag": "prose",
      "target_sha256": "55a013d01220f2e4e3c939ef2c583f9fac777b57e2b394fdad561824d3ea2d43"
    },
    {
      "source_id": "fr81-u217-r0039",
      "target": "Мариус опустился на руки и колени и бесшумно заполз под кровать.",
      "source_sha256": "3829a77ebf0681017f651f45a6e9ab7db3824c934244b789e94d83d080bd6c7d",
      "target_id": "ru-fr81-u217-r0039",
      "tag": "prose",
      "target_sha256": "eb560e1a0bec87e48e5199443ed080ed3ae8a2f30dc70c083e55c9cb52d0010c"
    },
    {
      "source_id": "fr81-u217-r0040",
      "target": "Едва он там притаился, как увидел свет в щелях своей двери.",
      "source_sha256": "59f48464e8205e14c54ca763dc6ae6eb3bc77ea6be41cf42ec030500485da95f",
      "target_id": "ru-fr81-u217-r0040",
      "tag": "prose",
      "target_sha256": "f4a8e0bcaff18c0a5eb0f8b2b1b040a81b1d8ce7182a80257b194d330dfd0a2d"
    },
    {
      "source_id": "fr81-u217-r0041",
      "target": "— Пап! — крикнул голос. — Его нет.",
      "source_sha256": "ef2f6b9c5ae705cbc40e76538b340275c1d7334cd69e767411d15d4b6fa44867",
      "target_id": "ru-fr81-u217-r0041",
      "tag": "prose",
      "target_sha256": "87d9d40a0829ebc0a884af0dfaf4b064cf89b9eb49fdfe0d333a962552192a24"
    },
    {
      "source_id": "fr81-u217-r0042",
      "target": "Он узнал голос старшей дочери.",
      "source_sha256": "3acf5d5c7ca1798ac9c8e552aa237a106827c57ca1caec4f5e894a6c5020bec8",
      "target_id": "ru-fr81-u217-r0042",
      "tag": "prose",
      "target_sha256": "d10d791958ab22554bd6b70ad3769c53bbfb4c47f9f33bba68b42e7a667fc4b7"
    },
    {
      "source_id": "fr81-u217-r0043",
      "target": "— Ты входила? — спросил отец.",
      "source_sha256": "1e62bf199b2380180d4e938c2f83862585e509d6c23a97a39eae7a588f46f1f7",
      "target_id": "ru-fr81-u217-r0043",
      "tag": "prose",
      "target_sha256": "594571483786d57823355b7803d4a6cc08a93d527ea7db5f0dcb1a91dccd49c6"
    },
    {
      "source_id": "fr81-u217-r0044",
      "target": "— Нет, — ответила дочь, — но раз ключ торчит в двери, значит, он ушёл.",
      "source_sha256": "86e1642de64118e34da10aa64918b565c49516de008fd194c854a6e0d72ab1de",
      "target_id": "ru-fr81-u217-r0044",
      "tag": "prose",
      "target_sha256": "40a30e1ae64865eb6de892680d2f44c10680c6dd4e4afd3dc55f2fa2335d627f"
    },
    {
      "source_id": "fr81-u217-r0045",
      "target": "Отец крикнул:",
      "source_sha256": "8740c197c7409ba3a230eb8301b841e24f71dfa9e7faedbda24a77f734ab80cc",
      "target_id": "ru-fr81-u217-r0045",
      "tag": "prose",
      "target_sha256": "0945a1f898c1ac1e6fe795ea81d10615f106818b761ee13a060373bc13326804"
    },
    {
      "source_id": "fr81-u217-r0046",
      "target": "— Всё равно войди.",
      "source_sha256": "764d4dc189ccdbf997de3ae6177261f34813bc42db28ab0617a1adbc8ed8b5d7",
      "target_id": "ru-fr81-u217-r0046",
      "tag": "prose",
      "target_sha256": "72a0613156b72e13eed54f9ca6cb2e797fe08a39a569e6cad1ef135855556d17"
    },
    {
      "source_id": "fr81-u217-r0047",
      "target": "Дверь отворилась, и Мариус увидел, как вошла рослая Жондрет со свечой в руке. Она была такая же, как утром, но при этом свете ещё страшнее.",
      "source_sha256": "4f15dc6d9804ca22f06193dc0de17d835183384d8b8f4b5bfc5f59735e4d9a56",
      "target_id": "ru-fr81-u217-r0047",
      "tag": "prose",
      "target_sha256": "28b33e4011a9bd43b6aa5c913405a813dead43e90d769cfc490d723fea5c040f"
    },
    {
      "source_id": "fr81-u217-r0048",
      "target": "Она направилась прямо к кровати. Мариус пережил миг невыразимой тревоги, но возле кровати к стене было прибито зеркало — вот куда она шла. Она приподнялась на цыпочки и посмотрела на себя. В соседней комнате слышался лязг переставляемого железа.",
      "source_sha256": "a34a20fae5f34ee6206b77eeac95c6a9bfea0051b25ff8f505c3bcf95c18bc62",
      "target_id": "ru-fr81-u217-r0048",
      "tag": "prose",
      "target_sha256": "fa17388c4ac4702063918f8bc7c12ce967330acdcaf5d8dc543507e22af191a8"
    },
    {
      "source_id": "fr81-u217-r0049",
      "target": "Она пригладила волосы ладонью и стала улыбаться зеркалу, напевая своим надтреснутым, замогильным голосом:",
      "source_sha256": "fe38316b542d7255cc0912bffc071c3d1755390d34dbf0dc6378c2bd835fc6f0",
      "target_id": "ru-fr81-u217-r0049",
      "tag": "prose",
      "target_sha256": "6567b0f59682fb08ef769b8f1303864181b6552f2be3296c8ed1232b59e1a1b4"
    },
    {
      "source_id": "fr81-u217-r0050",
      "target": "Наша любовь продлилась целую неделю.\n\nАх, как коротки мгновенья счастья!\n\nСтоило ли обожать друг друга восемь дней!\n\nПора любви должна бы длиться вечно!\n\nДолжна бы длиться вечно! должна бы длиться вечно!",
      "source_sha256": "7fc15f6df38a9379358100c58d54bca8ddd462e037f5ac32f974eddc85de1f16",
      "target_id": "ru-fr81-u217-r0050",
      "tag": "verse_group",
      "target_sha256": "9451696bdbdd7f6e1320b0f5cc3cc1e4773a57054f6872760a68b6b585a7b6b8"
    },
    {
      "source_id": "fr81-u217-r0051",
      "target": "Между тем Мариус дрожал. Ему казалось невозможным, чтобы она не слышала его дыхания.",
      "source_sha256": "07b2b45cea1dd945d0fc938825ff2f61b91e2e8ac6aab3142da878e07685845f",
      "target_id": "ru-fr81-u217-r0051",
      "tag": "prose",
      "target_sha256": "8db6dc8daa07f8157139f7dd6dbc9360ae076e0b7a0a347caee983a783f5d70f"
    },
    {
      "source_id": "fr81-u217-r0052",
      "target": "Она подошла к окну и выглянула наружу, громко говоря с тем полубезумным видом, который был ей свойствен.",
      "source_sha256": "375bb9a8a5b1256db3ec7073b9a329657863fb6aad11ec7fe615734683db0c57",
      "target_id": "ru-fr81-u217-r0052",
      "tag": "prose",
      "target_sha256": "58a6fcfb61d363f7f3b8fb0ac309dd60f9b804d0d6b3e7da02b02b930219caa5"
    },
    {
      "source_id": "fr81-u217-r0053",
      "target": "— Какой Париж безобразный, когда он надевает белую рубашку! — сказала она.",
      "source_sha256": "9a96d01ca8c2d649ec3bb736534451df1c848225069664d09d11dfb08609d4f6",
      "target_id": "ru-fr81-u217-r0053",
      "tag": "prose",
      "target_sha256": "e3f447d9737684f14621fb23dae3bda1d33cf5507a902a56bc766d3cf3481ba4"
    },
    {
      "source_id": "fr81-u217-r0054",
      "target": "Она вернулась к зеркалу и снова стала строить гримасы, рассматривая себя то анфас, то в три четверти.",
      "source_sha256": "18c60443d9c192c5bf17d0f8865ceb9991f2a16f9ca47d840eab83d8f60f3b49",
      "target_id": "ru-fr81-u217-r0054",
      "tag": "prose",
      "target_sha256": "5d52ae2369e92eec3ca92c5af0eba1dbee165d851c9f08610cda705578148ad3"
    },
    {
      "source_id": "fr81-u217-r0055",
      "target": "— Ну! — крикнул отец. — Что ты там делаешь?",
      "source_sha256": "b37a380f5f9b45a3648ad83aff5a636cf4abc399f6ffb847912da1e00922cc46",
      "target_id": "ru-fr81-u217-r0055",
      "tag": "prose",
      "target_sha256": "bf128b86f45ed58390786f3f556939afa330bd25a4eedf43061ee3df299a898f"
    },
    {
      "source_id": "fr81-u217-r0056",
      "target": "— Гляжу под кровать и под мебель, — ответила она, продолжая поправлять волосы. — Никого нет.",
      "source_sha256": "dd17fe76eb40ca1cdb52f830f464a54ec743a401774998bb1c3055f685f7978e",
      "target_id": "ru-fr81-u217-r0056",
      "tag": "prose",
      "target_sha256": "a980ee7f9181cea02ec94def1b0ef7fed2e640d5b84e67e831c496d125ba6f02"
    },
    {
      "source_id": "fr81-u217-r0057",
      "target": "— Дура! — взревел отец. — Сюда сейчас же! И не будем терять времени.",
      "source_sha256": "6f33d06e0731b82d6fe77c733af2a6a6727c5232bc27ea812db878fbe94129a0",
      "target_id": "ru-fr81-u217-r0057",
      "tag": "prose",
      "target_sha256": "5e1b3a5f68106107b850df7169660190b1373a77a79939dc06aaace64295e085"
    },
    {
      "source_id": "fr81-u217-r0058",
      "target": "— Иду! Иду! — сказала она. — В этой их конуре ни на что нет времени!",
      "source_sha256": "55f800362ae17997509e75eefc0a86c3bd0e74b77b6a1e02d715e0730b07cb9d",
      "target_id": "ru-fr81-u217-r0058",
      "tag": "prose",
      "target_sha256": "f0abd257cb8fe9b78f7c75e3520e71612e0faf6113112bc108690fd0afe84a95"
    },
    {
      "source_id": "fr81-u217-r0059",
      "target": "Она замурлыкала:",
      "source_sha256": "45659944f1211f77426b4a2b9f5e6c33d438d833497a2ae780c14498936961b6",
      "target_id": "ru-fr81-u217-r0059",
      "tag": "prose",
      "target_sha256": "4b9781c2be1bc0ab613d87c0f1e477ce5c1e8521637feea18d7c4c0eb6b3dc08"
    },
    {
      "source_id": "fr81-u217-r0060",
      "target": "Вы покидаете меня ради славы,\n\nМоё печальное сердце всюду последует за вами.",
      "source_sha256": "aa7af617679e896834cee7c4edeadd88f45595395c9b04fd4cde5dd46425d201",
      "target_id": "ru-fr81-u217-r0060",
      "tag": "verse_group",
      "target_sha256": "d30bdf14269fde280f7dce5e2e30651f2807f9fd2a69ef1fe4f96bb5d35dd86b"
    },
    {
      "source_id": "fr81-u217-r0061",
      "target": "Она бросила последний взгляд в зеркало и вышла, затворив за собой дверь.",
      "source_sha256": "9e23f205d4c72215aefb11cf3bf0d017ad37236cf5345a7431cb3bfef496c70b",
      "target_id": "ru-fr81-u217-r0061",
      "tag": "prose",
      "target_sha256": "f0b8fd529245021ab67938afc9bd34932236a7a3dfcc3ffcba74acb559f9c58a"
    },
    {
      "source_id": "fr81-u217-r0062",
      "target": "Спустя минуту Мариус услышал в коридоре шлёпанье босых ног обеих девушек и голос Жондрета, кричавшего им:",
      "source_sha256": "986a7abf0893e1699a526753afab9447573ba27880093b9381e4073df6e518e0",
      "target_id": "ru-fr81-u217-r0062",
      "tag": "prose",
      "target_sha256": "81cbb9bad3b829c2029ee2f1d947d60c9c7ebe5085483bc6a3484d317ff9fb7f"
    },
    {
      "source_id": "fr81-u217-r0063",
      "target": "— Смотрите в оба! Одна — со стороны заставы, другая — на углу улицы Пти-Банкье. Ни на минуту не упускайте из виду дверь дома, и если заметите что-нибудь, сейчас же сюда! Стремглав! Ключ, чтобы войти, у вас есть.",
      "source_sha256": "b1890a7715bda41c88995c0c2c1c59c2858d962d35c4194b05b258d302637012",
      "target_id": "ru-fr81-u217-r0063",
      "tag": "prose",
      "target_sha256": "2c75eb4fa451c5761be95666e12c3c084adf7e961d37ef7998a6bd927b6f1d77"
    }
  ],
