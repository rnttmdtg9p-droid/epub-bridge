{
  "unit": 28,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u028-r0032",
      "target": "Спустя несколько мгновений мальчик скрылся из виду.",
      "source_sha256": "d44e293bae24ac37142c6dff5888cb532c31464c13a7a7bd535d4f0c781a5c48",
      "target_id": "ru-fr81-u028-r0032",
      "tag": "prose",
      "target_sha256": "48a8ce14dcc72c9c36a96c6241cc1c9bc9762672244627e6068b854355c779a6"
    },
    {
      "source_id": "fr81-u028-r0033",
      "target": "Солнце село.",
      "source_sha256": "8fbbf35fe1671842d1d84f16d3cf3b23c05e74d9a3677a22e24c8b3142dfce43",
      "target_id": "ru-fr81-u028-r0033",
      "tag": "prose",
      "target_sha256": "4e489132e9c30b8df2afa18d098ee58e38c2f443173541be167bdd6da67cf8b2"
    },
    {
      "source_id": "fr81-u028-r0034",
      "target": "Вокруг Жана Вальжана сгущалась тень. Он не ел весь день; вероятно, у него был жар.",
      "source_sha256": "8f07850ec5d7b3cb51077fd801b4c8ebb940c5f239b52ba26ba329e80528036a",
      "target_id": "ru-fr81-u028-r0034",
      "tag": "prose",
      "target_sha256": "50692d75d73832a5bde73b48d0843bed16381a8590a43d33294520f4c3b2ecf1"
    },
    {
      "source_id": "fr81-u028-r0035",
      "target": "Он так и стоял, не изменив позы с тех пор, как убежал ребёнок. Грудь его поднималась от дыхания через долгие, неровные промежутки. Взгляд, остановившийся шагах в десяти или двенадцати перед ним, казалось, с глубоким вниманием изучал форму старого осколка синего фаянса, упавшего в траву. Вдруг он вздрогнул: он почувствовал вечерний холод.",
      "source_sha256": "14faed0a5be78fde1dd0e585c1359e5dbec1dcf71910044aa5904901f5a259bf",
      "target_id": "ru-fr81-u028-r0035",
      "tag": "prose",
      "target_sha256": "a66ef5114ea2b44fa4c7014cbac6aff95c7dcdbf7c8f8e71b9b2851a5cbd1a06"
    },
    {
      "source_id": "fr81-u028-r0036",
      "target": "Он плотнее надвинул на лоб фуражку, машинально попытался запахнуть и застегнуть блузу, сделал шаг и наклонился, чтобы подобрать с земли свою палку.",
      "source_sha256": "359ae725dec42b1fab272058555e5ef3e6bdce1b4f2e52ce14e5b080ac30e5c5",
      "target_id": "ru-fr81-u028-r0036",
      "tag": "prose",
      "target_sha256": "6a9674e971d38df9df4e2914b40d4154af2e538b23a3366899543710287e069a"
    },
    {
      "source_id": "fr81-u028-r0037",
      "target": "В этот миг он заметил монету в сорок су, которую его нога наполовину вдавила в землю и которая блестела среди камешков.",
      "source_sha256": "21f153df695c552b351b48a537f9c907409d1d950bd0bd1ff044546731d486f8",
      "target_id": "ru-fr81-u028-r0037",
      "tag": "prose",
      "target_sha256": "9b0b0c372f51276d84fbd719683ff486677b420f1bef0ebb4d77f93985a21bce"
    },
    {
      "source_id": "fr81-u028-r0038",
      "target": "Это было как гальванический удар. — Что это такое? — процедил он сквозь зубы. Он отступил на три шага, затем остановился, не в силах оторвать взгляд от того места, которое только что попирала его нога, как будто эта вещь, блестевшая там в темноте, была открытым глазом, устремлённым на него.",
      "source_sha256": "cc55e59678fa16f64fb90fe59434577dead772d48e6883ceb3a1ba93fd1d84ae",
      "target_id": "ru-fr81-u028-r0038",
      "tag": "prose",
      "target_sha256": "1514490019590ba09ac6015436b3cc024e2072c0c7990070b6a968b146245693"
    },
    {
      "source_id": "fr81-u028-r0039",
      "target": "Спустя несколько минут он судорожно бросился к серебряной монете, схватил её и, выпрямившись, стал смотреть вдаль, на равнину, обводя глазами сразу все точки горизонта, стоя и содрогаясь, как перепуганный дикий зверь, ищущий убежища.",
      "source_sha256": "3a27e4e20a8b7c9e6add49e848cbca37ee9b63a4942680ef784275bcf2966934",
      "target_id": "ru-fr81-u028-r0039",
      "tag": "prose",
      "target_sha256": "f0e6629379203c7f43a8ba7a33eda0274d210581bdbd152d9c34995a50f98cc0"
    },
    {
      "source_id": "fr81-u028-r0040",
      "target": "Он ничего не увидел. Падала ночь, равнина была холодна и неясна, в сумеречном свете поднимались большие лиловые туманы.",
      "source_sha256": "6558f0bf4a8ae936e857788252fc899356aca376329e2e54504f8057f2e0e675",
      "target_id": "ru-fr81-u028-r0040",
      "tag": "prose",
      "target_sha256": "32903ea093286206db8abe550fb053f6ac0931c3af96167d4a6c01684e76eb61"
    },
    {
      "source_id": "fr81-u028-r0041",
      "target": "Он сказал: «А!» — и быстро зашагал в определённом направлении, туда, где скрылся ребёнок. Пройдя шагов тридцать, он остановился, посмотрел и ничего не увидел.",
      "source_sha256": "0553c141c77a6e83ff4d190893d9152bb948053e8e0b3e62266acb091abd1146",
      "target_id": "ru-fr81-u028-r0041",
      "tag": "prose",
      "target_sha256": "21643beba5fb056038ab111fe37da53486fca5f5f5a03ba8159119ba5b639296"
    },
    {
      "source_id": "fr81-u028-r0042",
      "target": "Тогда он закричал изо всех сил: «Малыш Жерве! Малыш Жерве!»",
      "source_sha256": "086076ac54236f6738ca18d0316f9bb6ed53ffbfed9898268c3bfe7102ad5ac7",
      "target_id": "ru-fr81-u028-r0042",
      "tag": "prose",
      "target_sha256": "caefa63b16ee8cfd92ca5fc552be0c922abaa54bbedd4d007116aafa4273bd81"
    },
    {
      "source_id": "fr81-u028-r0043",
      "target": "Он замолчал и стал ждать.",
      "source_sha256": "07ca3742adaa443f6cad65585cd08b26c1ff8e2e4bed9c0114822e30fb7f1692",
      "target_id": "ru-fr81-u028-r0043",
      "tag": "prose",
      "target_sha256": "1217bf0f5a7b74097bfbc9ee9d72aef30217563c30e52d954daab25d92ff8156"
    },
    {
      "source_id": "fr81-u028-r0044",
      "target": "Никто не ответил.",
      "source_sha256": "e63807163dd11f057672c731e306cbe55f7362ae4fca4ad8c21db044ca7c077a",
      "target_id": "ru-fr81-u028-r0044",
      "tag": "prose",
      "target_sha256": "e9561bb64b3e2123aaf5632eabd67f20c5125650a8f90e98a6fbb619ca2d14e4"
    },
    {
      "source_id": "fr81-u028-r0045",
      "target": "Местность была пустынна и уныния полна. Его окружал простор. Вокруг не было ничего, кроме некоей мрачной жизни. Кустики с невероятной яростью трясли своими маленькими тощими руками. Казалось, они грозят кому-то и гонятся за кем-то.",
      "source_sha256": "b8720e40a5cee106c17d9f296e5b226e06e330360fb4c236938e806223fe6e50",
      "target_id": "ru-fr81-u028-r0045",
      "tag": "prose",
      "target_sha256": "0a376976f9da46369a99fdd8e23d7d58e57a728752f2dced7c06fd9b1459b1d8"
    },
    {
      "source_id": "fr81-u028-r0046",
      "target": "Он снова пошёл, потом побежал, и время от времени останавливался и кричал в этом безлюдье голосом, более грозным и более безутешным, чем можно себе представить: «Малыш Жерве! Малыш Жерве!»",
      "source_sha256": "44a8b38840708321f04433bcfd9ffd13ddc65f7ba7046d46ad081f195f048cba",
      "target_id": "ru-fr81-u028-r0046",
      "tag": "prose",
      "target_sha256": "23f278bd30974c3381626b656dc3d9701c256968aa445ed6eded6498072af58c"
    },
    {
      "source_id": "fr81-u028-r0047",
      "target": "Разумеется, если бы ребёнок услышал его, он испугался бы и остерёгся бы показываться. Но ребёнок, без сомнения, был уже очень далеко.",
      "source_sha256": "e6ef60615d5d785747f366e53d92f821074e93923567243aeb19ebb844f3c563",
      "target_id": "ru-fr81-u028-r0047",
      "tag": "prose",
      "target_sha256": "69704e2e5b7a6735633880c85b406f003b04dd6ea17d3a76e2a11a3e1e16d4f3"
    },
    {
      "source_id": "fr81-u028-r0048",
      "target": "Ему встретился священник верхом на лошади. Он подошёл к нему и сказал:",
      "source_sha256": "2ac765cad8b0e346efde7d715327bf2866865e42c9330511d08fc08c4ca419a6",
      "target_id": "ru-fr81-u028-r0048",
      "tag": "prose",
      "target_sha256": "814b4033ae486574369fefec1892d4f77ca774c8dc8cded5f7fec38c1e8e58b3"
    },
    {
      "source_id": "fr81-u028-r0049",
      "target": "— Господин кюре, не проходил ли тут ребёнок?",
      "source_sha256": "39ebf9fc6ecd88205844602861ae8271a212b207549790b75e33a07276a3e66e",
      "target_id": "ru-fr81-u028-r0049",
      "tag": "prose",
      "target_sha256": "66f5f6b89018f6de340885425275b0efe71d3468fa91da0ef8497c2330853150"
    },
    {
      "source_id": "fr81-u028-r0050",
      "target": "— Нет, — сказал священник.",
      "source_sha256": "30d36bef7bde12e60384bee18576cdcb4f3e3ae9dbcef47ee73f923ef5837b44",
      "target_id": "ru-fr81-u028-r0050",
      "tag": "prose",
      "target_sha256": "3dbf50db8335f1ec8a4c4e3a2f55e2ea6277e4a5f965a72bbd8ec58de05a0f2c"
    },
    {
      "source_id": "fr81-u028-r0051",
      "target": "— Некий малыш Жерве?",
      "source_sha256": "9909df623bfaa049b3843962678e4e3a95aa9387c77fcc8da5f6309f27e92880",
      "target_id": "ru-fr81-u028-r0051",
      "tag": "prose",
      "target_sha256": "1b78337dc78dab4d4bb5703d2414d6fa529128eccdf6f14d9fdf9fc8d8b9a51c"
    },
    {
      "source_id": "fr81-u028-r0052",
      "target": "— Я никого не видел.",
      "source_sha256": "1ab6ca3cd0b7ca1e30b0acb54efc5005ebcca5a0bc2571e6201299fd6c9df208",
      "target_id": "ru-fr81-u028-r0052",
      "tag": "prose",
      "target_sha256": "66fbd1a1592c2c7cbd95faae4a0644123e72133e76f257d401f53bd61b1fd182"
    },
    {
      "source_id": "fr81-u028-r0053",
      "target": "Он вынул из сумки две монеты по пять франков и отдал их священнику.",
      "source_sha256": "c4a410de1e8ba9bd663cc1bc04834aea31621d90972f32baef9beaeb1c233566",
      "target_id": "ru-fr81-u028-r0053",
      "tag": "prose",
      "target_sha256": "13ea2e0329987815769864dd97a99d7462e170326df46f7d64e8656e95713c93"
    },
    {
      "source_id": "fr81-u028-r0054",
      "target": "— Господин кюре, это для ваших бедных. — Господин кюре, это мальчик лет десяти, у него, кажется, сурок и шарманка. Он шёл вот так. Из этих савояров, знаете?",
      "source_sha256": "7babb8eb17c20a46eaf15268c2a83af66185320d42a8b096cdd65beb6d3b883a",
      "target_id": "ru-fr81-u028-r0054",
      "tag": "prose",
      "target_sha256": "3159b08b8bdc04185763d09559872ab1c95f29876df301888b0ded5807786649"
    },
    {
      "source_id": "fr81-u028-r0055",
      "target": "— Я его не видел.",
      "source_sha256": "a2a4076146de5e27e5aeb48ede5ea29e0e8b1a8775b155d91aacf3a01a8e7e8d",
      "target_id": "ru-fr81-u028-r0055",
      "tag": "prose",
      "target_sha256": "c49f27de86e385b493028a3a7ee1bd716e3ca8bec25c4b90b4f9ca2ef68a0adf"
    },
    {
      "source_id": "fr81-u028-r0056",
      "target": "— Малыш Жерве? Он ведь не из здешних деревень? Не можете ли вы мне сказать?",
      "source_sha256": "3d6476b9f426bb302384aceaea74232c83ac507cd93bc34efd1e0fdb778586de",
      "target_id": "ru-fr81-u028-r0056",
      "tag": "prose",
      "target_sha256": "18ade1e4546d5aa66f56f092ab44a0181b81d6d49a480f67d67e2ad178a2dd7b"
    },
    {
      "source_id": "fr81-u028-r0057",
      "target": "— Если всё так, как вы говорите, друг мой, то это маленький чужой ребёнок. Такие бродят по краю. Их никто не знает.",
      "source_sha256": "6a21593f991033f654f719ffbb4ca34b812602878c38653a320faefae33fbbeb",
      "target_id": "ru-fr81-u028-r0057",
      "tag": "prose",
      "target_sha256": "5f19529de1c5ccde48e2dfc49d8901d0120dd88a6faa62fe8ada32a6d6157211"
    },
    {
      "source_id": "fr81-u028-r0058",
      "target": "Жан Вальжан резко достал ещё два экю по пять франков и отдал священнику.",
      "source_sha256": "33cf00193fa288d53e41b3adb54700f61c201cb77ac46c4e9f2b15deb1edffe0",
      "target_id": "ru-fr81-u028-r0058",
      "tag": "prose",
      "target_sha256": "3e7b32c50c911c312ae369c818bef6109d3da9df88152a952dbf245377cd4404"
    },
    {
      "source_id": "fr81-u028-r0059",
      "target": "— Для ваших бедных, — сказал он.",
      "source_sha256": "b5ee41c732d536041c8ce2a4d9e5548d2d976e794da0161f8b7d30a51a1277d1",
      "target_id": "ru-fr81-u028-r0059",
      "tag": "prose",
      "target_sha256": "6dab87d7fd6b4b82a5516584f9e3ea0af5c0d19604856b2e86d8460aea3aa9a0"
    },
    {
      "source_id": "fr81-u028-r0060",
      "target": "Потом добавил в исступлении:",
      "source_sha256": "23778d594a0cfc435e4fb20e019a56bd3b229468f996871c2036808aa3b40350",
      "target_id": "ru-fr81-u028-r0060",
      "tag": "prose",
      "target_sha256": "c216d6f9847e0d62adaa91f76e025a1e2021bd45c2a5ef17fd8729484ad67ae2"
    },
    {
      "source_id": "fr81-u028-r0061",
      "target": "— Господин аббат, прикажите меня арестовать. Я вор.",
      "source_sha256": "5e87b4e8928e2f182cb24cdc38c2099daf0cd4639d4e7647f4179382956b25ba",
      "target_id": "ru-fr81-u028-r0061",
      "tag": "prose",
      "target_sha256": "5b9184fad2743b6295c5ddf13c80b2359a9ec272562c36a7353fd4f120ac3404"
    },
    {
      "source_id": "fr81-u028-r0062",
      "target": "Священник пришпорил коня и в сильном испуге ускакал.",
      "source_sha256": "30d98d11bb88ea3d8e6a05afde2951ac2c3aa64ae3f82cd95dd0469d04c376ce",
      "target_id": "ru-fr81-u028-r0062",
      "tag": "prose",
      "target_sha256": "25893ce074e051b820cf5633005ca34182ec361d753a062630252bb3a1109a9e"
    },
    {
      "source_id": "fr81-u028-r0063",
      "target": "Жан Вальжан снова побежал в том направлении, которое избрал сначала.",
      "source_sha256": "2e248be352915a0c9a05221339e3ea6392271a802f1b064904ea83ead515ba00",
      "target_id": "ru-fr81-u028-r0063",
      "tag": "prose",
      "target_sha256": "b316cb908f4cf5a630dbca50a4773526bb73ed39c3f8ded1b70086e64f78ec98"
    }
  ],
