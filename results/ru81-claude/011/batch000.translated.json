{
  "unit": 11,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u011-h",
      "target": "X. Епископ перед лицом неведомого света",
      "source_sha256": "540885b3ed8a1e1d8be994588e78e79a4dd51dc83e2499192aaf8dd6fb257325",
      "target_id": "ru-fr81-u011-h",
      "tag": "heading",
      "target_sha256": "dab73a277e552a44a2511c0651d0340d43bd4503e80f71e8f96e361c788a2a7e"
    },
    {
      "source_id": "fr81-u011-r0001",
      "target": "Спустя некоторое время после даты письма, приведённого на предыдущих страницах, он совершил поступок, который, по мнению всего города, был ещё рискованнее его прогулки по горам, где укрывались разбойники.",
      "source_sha256": "bfebaf67f4f40631dcff70bac3c1354c05b32d0f4dd6cab7c838503e8bbd7b99",
      "target_id": "ru-fr81-u011-r0001",
      "tag": "prose",
      "target_sha256": "d24df9e5296534b88226a13b17e1da5bc9024dc8932f5c6f7691db720dda2c5a"
    },
    {
      "source_id": "fr81-u011-r0002",
      "target": "Близ Диня, в поле, жил один человек, державшийся уединённо. Этот человек — скажем сразу это грубое слово — был бывшим членом Конвента. Звали его Ж.",
      "source_sha256": "008ff93aa9e94cd1df35c89013f1ea028ed8a33041b866d546cfe2279dbce222",
      "target_id": "ru-fr81-u011-r0002",
      "tag": "prose",
      "target_sha256": "7320c6d022854a8fe8a3fd62d49a74664481e3385c40b0324f6deae3a7378cb5"
    },
    {
      "source_id": "fr81-u011-r0003",
      "target": "О конвентионере Ж. в маленьком мирке Диня говорили с каким-то ужасом. Конвентионер — вы только подумайте! Такие существовали в те времена, когда все говорили друг другу «ты» и называли друг друга: гражданин. Этот человек был почти чудовище. Он не голосовал за казнь короля, но почти. Это был квазицареубийца. Он был ужасен. Как это так, что при возвращении законных принцев этого человека не предали предварительному суду? Ему, если угодно, не отрубили бы голову — нужна же милость, пусть так, — но хорошее пожизненное изгнание! Пример, наконец! И так далее, и так далее. Притом он был атеист, как все эти люди. — Пересуды гусей о коршуне.",
      "source_sha256": "209fc58a063814a710ff4f93833467f41f976e6f9c29c67d43a2ed6e844d9be1",
      "target_id": "ru-fr81-u011-r0003",
      "tag": "prose",
      "target_sha256": "df7eb6ebd9ec9d83737110761392c137212a41035f942d2b778836ea6aa10c58"
    },
    {
      "source_id": "fr81-u011-r0004",
      "target": "Впрочем, был ли он коршуном, этот Ж.? Да, если судить по тому дикому, что было в его уединении. Не голосовавший за смерть короля, он не попал под указы об изгнании и мог остаться во Франции.",
      "source_sha256": "a824a857e19679463141df634923876d9abfa4691c39aaa9716de42ec12d4fee",
      "target_id": "ru-fr81-u011-r0004",
      "tag": "prose",
      "target_sha256": "46cd9aeb1903377c2e259a8fb6821795c1f1cafa69b5d8a113567c7ec6ac995d"
    },
    {
      "source_id": "fr81-u011-r0005",
      "target": "Он жил в трёх четвертях часа ходьбы от города, вдали от всякой деревни, вдали от всякой дороги, в каком-то глухом, забытом изгибе очень дикой долины. Там у него, говорили, был некий клочок земли, нора, логово. Ни соседей, ни даже прохожих. С тех пор как он поселился в этой долине, тропа, что вела туда, исчезла под травой. Об этом месте говорили как о доме палача.",
      "source_sha256": "40dca4ed956664a229cf3ae83662d4c4de4aa7470c3150fac78c09097ad3cf61",
      "target_id": "ru-fr81-u011-r0005",
      "tag": "prose",
      "target_sha256": "4a8a53c1a959433ad357fcdaef6a93af3fd6718aa6d926b8914e8e2af68f5049"
    },
    {
      "source_id": "fr81-u011-r0006",
      "target": "И всё же епископ задумывался и время от времени смотрел на горизонт, туда, где купа деревьев обозначала долину старого конвентионера, и говорил: «Там есть душа, которая одинока».",
      "source_sha256": "c8ce8b1eb6ea3d6e05eee667829d88f0306df02d0ec3f58bc035b14c9ae57807",
      "target_id": "ru-fr81-u011-r0006",
      "tag": "prose",
      "target_sha256": "b98dafa4b7f3291e49908df36d26ecd7eb22fe2a667e8d355e493484696cdcfe"
    },
    {
      "source_id": "fr81-u011-r0007",
      "target": "И в глубине мысли он добавлял: «Я обязан ему визитом».",
      "source_sha256": "7abd6f6868b5c84111cfb3185036b1968a311a280373912d39e39faa64d10ef9",
      "target_id": "ru-fr81-u011-r0007",
      "tag": "prose",
      "target_sha256": "e81d7c53eb250c94b19f656dd2c5a1a10c336196ce7cf742f86fed588da5a579"
    },
    {
      "source_id": "fr81-u011-r0008",
      "target": "Но, признаемся, эта мысль, поначалу естественная, после минутного размышления казалась ему странной и невозможной и почти отталкивающей. Ибо в глубине души он разделял общее впечатление, и конвентионер внушал ему, хотя он и не отдавал себе в том ясного отчёта, то чувство, которое служит как бы границей ненависти и которое так хорошо выражается словом «отчуждение».",
      "source_sha256": "31d0e9577ce730f8bf48c70d2d80f2e2d5f1aec4bfc9e2ecae1f7c923f0f52cb",
      "target_id": "ru-fr81-u011-r0008",
      "tag": "prose",
      "target_sha256": "bc0676d6b2cd13a2f518d567e4eb981094d28bb32e6027f7bedb102f87759e9b"
    },
    {
      "source_id": "fr81-u011-r0009",
      "target": "Однако должна ли короста овцы заставлять пастыря отступать? Нет. Но что за овца!",
      "source_sha256": "bb49dac9c9b84b6046b3fb129f8c6cc0c640c3013d590885c703973f1bae12bb",
      "target_id": "ru-fr81-u011-r0009",
      "tag": "prose",
      "target_sha256": "21f5c39ff41de222942c8905c5fac087fb339f9f5f6265b701bea6ae03312dbb"
    },
    {
      "source_id": "fr81-u011-r0010",
      "target": "Добрый епископ был в нерешительности. Порой он шёл в ту сторону, затем возвращался.",
      "source_sha256": "0456d602f6b887c48d652211ccdd5d9314565d025d7168a299dc5d38ced67f94",
      "target_id": "ru-fr81-u011-r0010",
      "tag": "prose",
      "target_sha256": "1b1af44eb8ed5e96b4f8e983a6e76820990c52c66572478943308fcb4949b426"
    },
    {
      "source_id": "fr81-u011-r0011",
      "target": "Наконец однажды по городу разнеслась молва, что некий молодой пастушок, прислуживавший конвентионеру Ж. в его берлоге, приходил за врачом; что старый злодей умирает, что его одолевает паралич и что ночи он не переживёт. — Слава Богу! — добавляли некоторые.",
      "source_sha256": "c4aad15f83180cbb320375b6158d6e1a13750d263e72957b50ce132fca6a23ab",
      "target_id": "ru-fr81-u011-r0011",
      "tag": "prose",
      "target_sha256": "206a17350df9980f457e4e0d43471504f2a9f468ab9ad31ca2cd3a1ee8207a22"
    },
    {
      "source_id": "fr81-u011-r0012",
      "target": "Епископ взял свой посох, надел верхнюю одежду — из-за сутаны, несколько слишком поношенной, как мы уже говорили, и ещё из-за вечернего ветра, который вот-вот должен был подуть, — и отправился в путь.",
      "source_sha256": "33bc563860efcf94e4cb760aa47c9ccb5aa32a8d3e4a5aa024071f955593eba9",
      "target_id": "ru-fr81-u011-r0012",
      "tag": "prose",
      "target_sha256": "61ba7fc4875913c7bb6ec8b7f7a1e42cca3d9a42ac8a95a3a012a03bea9a883b"
    },
    {
      "source_id": "fr81-u011-r0013",
      "target": "Солнце клонилось и почти касалось горизонта, когда епископ пришёл на это отлучённое от церкви место. Он с некоторым биением сердца понял, что находится близ логова. Он перешагнул через канаву, перелез через изгородь, поднял жердь заграждения, вошёл в разрушенный дворик, сделал несколько шагов довольно смело и вдруг в глубине пустоши, за высоким кустарником, увидел пещеру.",
      "source_sha256": "88594886e670e63fc9dab4f79fe00f88d23c3635edac9645678d6132760a611f",
      "target_id": "ru-fr81-u011-r0013",
      "tag": "prose",
      "target_sha256": "6a68c4a0da70e559e87d269449f5016847a15650ca1cd7f013f6c36ec7ef8f4d"
    },
    {
      "source_id": "fr81-u011-r0014",
      "target": "Это была совсем низкая хижина, убогая, маленькая и чистая, с лозой винограда, прибитой к фасаду.",
      "source_sha256": "0e4bd34105c6223520f3ba5237f165fd0c8c876bb303a3b349b187e88cea9171",
      "target_id": "ru-fr81-u011-r0014",
      "tag": "prose",
      "target_sha256": "f7c9b9f2d0fc903eab858c3c32ab196cb1cd72df7ad64176547c27cdf7c4a753"
    },
    {
      "source_id": "fr81-u011-r0015",
      "target": "Перед дверью, в старом кресле на колёсиках, крестьянском кресле, сидел седовласый человек и улыбался солнцу.",
      "source_sha256": "9b5806ef498181c9fa0def3e124440409e6719c484f733b644fa58393a6398f1",
      "target_id": "ru-fr81-u011-r0015",
      "tag": "prose",
      "target_sha256": "f1113d6ebfa9d4cd1218d25ac15993ee585e2d7a0bfbe811d9b4db70526030ee"
    },
    {
      "source_id": "fr81-u011-r0016",
      "target": "Возле сидящего старика стоял юноша, маленький пастух. Он протягивал старику чашку молока.",
      "source_sha256": "200b3964b5b0871aecc8c47ec21e4be129512c1aa9756c830274f8bcac43b5da",
      "target_id": "ru-fr81-u011-r0016",
      "tag": "prose",
      "target_sha256": "564937ecd9b0c7532b5bfe35e376c05ee8880409aea690bc214d49ef7906a75b"
    },
    {
      "source_id": "fr81-u011-r0017",
      "target": "Пока епископ смотрел, старик возвысил голос: — Спасибо, — сказал он, — мне больше ничего не нужно. И улыбка его покинула солнце и остановилась на ребёнке.",
      "source_sha256": "c87649852b96bdb2fd1829a990c879e23099ef10a4ae05c5cf5f66f6bcefe9a1",
      "target_id": "ru-fr81-u011-r0017",
      "tag": "prose",
      "target_sha256": "0d4f57503bfcbeea70aabb37e79fb6e7e98c3132ca8954b82e96c890be692a1e"
    },
    {
      "source_id": "fr81-u011-r0018",
      "target": "Епископ подошёл. На шум его шагов старик, сидевший в кресле, повернул голову, и лицо его выразило всё то удивление, какое только можно испытать после долгой жизни.",
      "source_sha256": "455b891b7c90fb4b6823599ea3c56aeea6d3d3964ef7b142c8fd01d9925b35fb",
      "target_id": "ru-fr81-u011-r0018",
      "tag": "prose",
      "target_sha256": "cc91aa7751ee5469d8b27fe20841f9e50873b6f797873a5ff14ffe1f1016c9cb"
    },
    {
      "source_id": "fr81-u011-r0019",
      "target": "— С тех пор как я здесь, — сказал он, — это первый раз, что кто-то входит ко мне. Кто вы, сударь?",
      "source_sha256": "10f262aa9512ba1518ca72b3dae9c5c9428abfb61e4659ff2d7097c94edce0d7",
      "target_id": "ru-fr81-u011-r0019",
      "tag": "prose",
      "target_sha256": "e63aba75a3b715da0a7851f5f76dc707ecc7f4fc222e827efba2ce375f0c7b19"
    },
    {
      "source_id": "fr81-u011-r0020",
      "target": "Епископ ответил:",
      "source_sha256": "e7f1f2be13aae8fb10647a7ac67bf99cacd41724c6e50a938a5c86c400ccf1d5",
      "target_id": "ru-fr81-u011-r0020",
      "tag": "prose",
      "target_sha256": "8fd942b9c6a18eeb392c5a97dcdf84e33e00bec5911997f4b48cf0789ba756f7"
    },
    {
      "source_id": "fr81-u011-r0021",
      "target": "— Меня зовут Бьенвеню Мириель.",
      "source_sha256": "0e3dbfe2af80313bdbe425cac671d71d924cf38bf51f936b0ed5159d15ee548e",
      "target_id": "ru-fr81-u011-r0021",
      "tag": "prose",
      "target_sha256": "965d889cda551271439ef203ef7d0de8d30d053ff382f4d3f024077d865e2fcd"
    },
    {
      "source_id": "fr81-u011-r0022",
      "target": "— Бьенвеню Мириель! Я слышал это имя. Это вас народ называет монсеньор Бьенвеню?",
      "source_sha256": "0d3fbadb6022ee7d21daba2aba6855409892149a82754edccc72aba841a925aa",
      "target_id": "ru-fr81-u011-r0022",
      "tag": "prose",
      "target_sha256": "3ec8e5285707e478883d7df3b8b93e88ce9b4196d14532e0ccbd7c8db72413fc"
    },
    {
      "source_id": "fr81-u011-r0023",
      "target": "— Это я.",
      "source_sha256": "a3fe176cfaff386e600cfbbff42c5cbc67d97552602b479fdf8f33a9cc3d0487",
      "target_id": "ru-fr81-u011-r0023",
      "tag": "prose",
      "target_sha256": "addbb03d1e401ac2f507fad22de778b1cbae9b4bc0724d34ee633778a717cdcb"
    },
    {
      "source_id": "fr81-u011-r0024",
      "target": "Старик продолжал с полуулыбкой:",
      "source_sha256": "a53f51794cc57ca31303afee2b01b6a4366ff8ef82006bcca8be730dcb80f55f",
      "target_id": "ru-fr81-u011-r0024",
      "tag": "prose",
      "target_sha256": "0457b05b624267851932a475c1d3878f15529bbaa8af1cb3e54775ce96010d4b"
    },
    {
      "source_id": "fr81-u011-r0025",
      "target": "— В таком случае вы мой епископ?",
      "source_sha256": "dd9f94be986a9080483ea68351b24d5b97172c87d9de1499fbc7502af2c9dbd0",
      "target_id": "ru-fr81-u011-r0025",
      "tag": "prose",
      "target_sha256": "06d399ec760626a7d4723203af040d77266856d1b975562fe2c189d8ae73c714"
    },
    {
      "source_id": "fr81-u011-r0026",
      "target": "— Отчасти.",
      "source_sha256": "486bc23b22ca8abb28e1a76a931bda83c8ba452e92972cf14a8b0b1d7e7d197a",
      "target_id": "ru-fr81-u011-r0026",
      "tag": "prose",
      "target_sha256": "1ebcc67b0d81c28cafd4e2b7b955176b7e4dd9519e1105169d7802ebad20471d"
    },
    {
      "source_id": "fr81-u011-r0027",
      "target": "— Входите, сударь.",
      "source_sha256": "f789b85e0a2af367081616f7f4eec63b3870243d6d861f87ba9f7ab4603d1ea3",
      "target_id": "ru-fr81-u011-r0027",
      "tag": "prose",
      "target_sha256": "01717cbd7632e60c7e9e26ab71221b774c47610275b60bf7e9a7228496b9fbfe"
    },
    {
      "source_id": "fr81-u011-r0028",
      "target": "Конвентионер протянул епископу руку, но епископ её не взял. Епископ ограничился тем, что сказал:",
      "source_sha256": "1d071e3494d647226f6d28105865a29d164718281417a8588274b0db9eb4541f",
      "target_id": "ru-fr81-u011-r0028",
      "tag": "prose",
      "target_sha256": "947740b3e8162088835a645a8a504a34806364960f2c0c0c1ec7c520d17a5a79"
    },
    {
      "source_id": "fr81-u011-r0029",
      "target": "— Я доволен, видя, что меня обманули. Вы, конечно, не кажетесь мне больным.",
      "source_sha256": "eb37b8a647cb5216c7b5bf46b1ea917e9b85678ab8d61801d163e54cabc92018",
      "target_id": "ru-fr81-u011-r0029",
      "tag": "prose",
      "target_sha256": "38323e8233897c883679674fd0f416a6d774e26e36c5c87025cf654c144684ff"
    },
    {
      "source_id": "fr81-u011-r0030",
      "target": "— Сударь, — ответил старик, — я скоро исцелюсь.",
      "source_sha256": "047472abbe3963ef0a737e8c874fb04df4be4c6dbce75912100570936aec7e22",
      "target_id": "ru-fr81-u011-r0030",
      "tag": "prose",
      "target_sha256": "1a0eaf06af70ac9515e35c7a48cdbbe2953b543ea13e9cdd26ff997d848c8988"
    },
    {
      "source_id": "fr81-u011-r0031",
      "target": "Он сделал паузу и сказал:",
      "source_sha256": "a429a6f707ce6d647f77fa505ee9ee4b2387608c27350f6d5769600998919865",
      "target_id": "ru-fr81-u011-r0031",
      "tag": "prose",
      "target_sha256": "bd31bcfad53ed4031aa22431d9adcac7720f7ab7289fe19ecdf3015b8a0e75ae"
    }
  ],
