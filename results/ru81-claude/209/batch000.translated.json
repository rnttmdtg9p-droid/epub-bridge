{
  "unit": 209,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u209-h",
      "target": "VIII Луч в логове",
      "source_sha256": "c64d2d6bcc6e3cebfe02bd3cb556d75f6aadc441606fc510d600ae0476475308",
      "target_id": "ru-fr81-u209-h",
      "tag": "heading",
      "target_sha256": "77d6f22f448d77994e2be78ee4eecbf732bfc049ad13fe7fc82d7fdaa2afbcfe"
    },
    {
      "source_id": "fr81-u209-r0001",
      "target": "Старшая дочь подошла и положила свою руку на руку отца.",
      "source_sha256": "dd9b09be33f56cbf8454244af18f41b8901c2037b655a74f25f36a50e6e7216c",
      "target_id": "ru-fr81-u209-r0001",
      "tag": "prose",
      "target_sha256": "1ddb5867acfbb1b8a4c6b0a2bfe8ea652e95acb32a5f9dca4c5a41a27164aa68"
    },
    {
      "source_id": "fr81-u209-r0002",
      "target": "— Пощупай, как я замёрзла, — сказала она.",
      "source_sha256": "bff897b75869ad9340b14b8503cd2264a83046a372800db6d363afc314eb2606",
      "target_id": "ru-fr81-u209-r0002",
      "tag": "prose",
      "target_sha256": "43d782a27845575a55bbf3468ead78f25628102a3e206157b77905aeb9ffc6fa"
    },
    {
      "source_id": "fr81-u209-r0003",
      "target": "— Ба! — отозвался отец. — Я замёрз куда сильнее.",
      "source_sha256": "6375021a42bc939ebd16875b5f6afbb4cf17867d64265f3f6d0bc014b7cd5b74",
      "target_id": "ru-fr81-u209-r0003",
      "tag": "prose",
      "target_sha256": "1b4e9d7b35bf81247ced015b227cfebf9c21faa4c77df0671bbd800a19b97250"
    },
    {
      "source_id": "fr81-u209-r0004",
      "target": "Мать запальчиво закричала:",
      "source_sha256": "132c909b5f4469c3c2a0cac3ce946c5c1831f30afb20467232faf9810c52db65",
      "target_id": "ru-fr81-u209-r0004",
      "tag": "prose",
      "target_sha256": "52eac314b6c777c5c9fef15473a0b1de69297c1e726f7b09a2f263537839a9bb"
    },
    {
      "source_id": "fr81-u209-r0005",
      "target": "— У тебя всегда всё лучше, чем у других, у тебя! Даже беда!",
      "source_sha256": "37d96d3c131e1fbc333d1fece167b283791f4789ba176f8519940afec56a0509",
      "target_id": "ru-fr81-u209-r0005",
      "tag": "prose",
      "target_sha256": "fc5c25c60567b1b26aa643cad5bd700481cab65342586620ffa68c90fa0f5b82"
    },
    {
      "source_id": "fr81-u209-r0006",
      "target": "— Цыц! — сказал мужчина.",
      "source_sha256": "4815a38dbadf76264f50aea7611cb7b021de6c0ab405c7a802bae4da939afb31",
      "target_id": "ru-fr81-u209-r0006",
      "tag": "prose",
      "target_sha256": "332eaaaa566398b9ef8c17d533e23e8d5a18ae923dd403a465ec5a869203fb33"
    },
    {
      "source_id": "fr81-u209-r0007",
      "target": "Мать, на которую посмотрели особым образом, умолкла.",
      "source_sha256": "8a4cdade1a1e81d85f252b1dce0a161976bfab13bb4b9876fc8c9bc4d420742a",
      "target_id": "ru-fr81-u209-r0007",
      "tag": "prose",
      "target_sha256": "9c59dc74b087f19692e9c50d9f436c553914dae20c72630577d0c390177cd3b1"
    },
    {
      "source_id": "fr81-u209-r0008",
      "target": "В логове на миг наступила тишина. Старшая дочь с беззаботным видом счищала грязь с подола своей накидки, младшая сестра по-прежнему всхлипывала; мать взяла её голову в обе ладони и осыпала поцелуями, шепча ей:",
      "source_sha256": "d844638a9b8e35201ac7a1c41532e46218246c360b2029f230e359caa8c52170",
      "target_id": "ru-fr81-u209-r0008",
      "tag": "prose",
      "target_sha256": "6b02a09d29f395a975a31a0f95c58a548978ca58151e7c123e36900523a66193"
    },
    {
      "source_id": "fr81-u209-r0009",
      "target": "— Сокровище моё, прошу тебя, это пустяки, не плачь, ты рассердишь отца.",
      "source_sha256": "8752e896fa0c32814633241117b210240409f8757ab3dc208ba8caefa5748e3e",
      "target_id": "ru-fr81-u209-r0009",
      "tag": "prose",
      "target_sha256": "394dd8b7e3ec8c6cea3bca77f49c6e3931f4773d684d063acaf2f716f0668fcb"
    },
    {
      "source_id": "fr81-u209-r0010",
      "target": "— Нет! — закричал отец. — Наоборот! Плачь! Плачь! Это хорошо получается.",
      "source_sha256": "a0c9a74a4aeb1f75472193b2335eda06fc87104ceb17f820c43bf69ac29f7f3a",
      "target_id": "ru-fr81-u209-r0010",
      "tag": "prose",
      "target_sha256": "76b5968bc70a986a6e1f240414023e472460b9d04d98226b6c6f1f37280f3199"
    },
    {
      "source_id": "fr81-u209-r0011",
      "target": "Потом, снова оборотившись к старшей:",
      "source_sha256": "62844e92e5520be1da4518ca12486fc8df2af43a22ac151fb3b8326e70333378",
      "target_id": "ru-fr81-u209-r0011",
      "tag": "prose",
      "target_sha256": "5a1e9adb6203bc7d72f856a083f7dc14507e6c71b1fe7632f5abb54621ff986f"
    },
    {
      "source_id": "fr81-u209-r0012",
      "target": "— Ну и ну! Да он не идёт! А если он и вовсе не придёт! Выходит, я зря загасил огонь, продавил стул, изорвал рубашку и разбил стекло!",
      "source_sha256": "0d319bf60c850d35f3037f3d5ca8e05308a4d3f638e4930f125774c99db4ae30",
      "target_id": "ru-fr81-u209-r0012",
      "tag": "prose",
      "target_sha256": "063d44429bd1f91a8a1d2e4ae7a4b1e61d43932cc0f8aadffd6e6a18a42ceb4c"
    },
    {
      "source_id": "fr81-u209-r0013",
      "target": "— И поранил малышку! — пробормотала мать.",
      "source_sha256": "263b8af82a63330d1bab847525819b3aff6ea8e9d59e388fc12e66b9e919e687",
      "target_id": "ru-fr81-u209-r0013",
      "tag": "prose",
      "target_sha256": "d519e90aae838ef51d04d9b5e9d52b01b33390f805bb7593aca9534297df3c8a"
    },
    {
      "source_id": "fr81-u209-r0014",
      "target": "— Знаете ли вы, — продолжал отец, — что в этой чёртовой конуре собачий холод? А если этот человек не придёт! О, вот оно что! Заставляет себя ждать! Он говорит себе: ну что ж! подождут! они для того и здесь! — О, как я их ненавижу и как бы я их задушил — с наслаждением, с радостью, с восторгом, с удовлетворением, этих богачей! всех этих богачей! Этих так называемых благотворителей, которые разыгрывают святош, которые ходят к обедне, которые падки на поповскую братию, на проповеди-болтовню, на скуфейки, и которые мнят себя выше нас, и приходят нас унижать, и приносят нам одёжу! как они выражаются! тряпьё, которому цена четыре су, и хлеб! Не этого я хочу, сборище мерзавцев! а денег! Ах! денег! Никогда! Потому что, говорят они, мы их пропьём, потому что мы пьяницы и лентяи! А они сами! Что же они такое, и чем они были в своё время? Ворами! Без этого они бы не разбогатели! О, надо бы взять общество за четыре угла скатерти и подбросить всё вверх! Всё разбилось бы — это возможно, но зато ни у кого ничего бы не было, и это уже было бы выигрышем! — Да что же он делает, твоя скотина, твой господин благодетель? Придёт ли он? Животное, может быть, забыло адрес! Об заклад бьюсь, что эта старая дура…",
      "source_sha256": "62b66c7d9af010bd74a67c0f33d910c8c18c915051bf948d146d9cbec1b93262",
      "target_id": "ru-fr81-u209-r0014",
      "tag": "prose",
      "target_sha256": "bfd18da5c07b4c7f5f0749fcc3a95187506095238fa7f20b12b520f241c11b5c"
    },
    {
      "source_id": "fr81-u209-r0015",
      "target": "В этот миг тихонько стукнули в дверь; мужчина бросился к ней и отворил, восклицая, с глубокими поклонами и улыбками обожания:",
      "source_sha256": "27459dbbbe5ca6bcaf95052819a0c1bd7e9960220a4e73bfae7635c93edd80f5",
      "target_id": "ru-fr81-u209-r0015",
      "tag": "prose",
      "target_sha256": "27a5152fc03e4116fa5548e4e77eab3c3f923d2f5f5a2547bd9e9fda790613e5"
    },
    {
      "source_id": "fr81-u209-r0016",
      "target": "— Войдите, сударь! Соблаговолите войти, мой достопочтенный благодетель, а также ваша очаровательная барышня.",
      "source_sha256": "63ac15c31ec307cf44ff22bac2b08740872d608cf93cc35eacdda4bcf9595fd6",
      "target_id": "ru-fr81-u209-r0016",
      "tag": "prose",
      "target_sha256": "178920e711bf783e8b9d16cf4c09ee835bd4a7f6a4e01f1c9c0d291368b30dea"
    },
    {
      "source_id": "fr81-u209-r0017",
      "target": "Мужчина зрелых лет и молодая девушка показались на пороге конуры.",
      "source_sha256": "a254616768706e246757053e49be25a7eba7357e321e2e5f0c1af72ce4fe52da",
      "target_id": "ru-fr81-u209-r0017",
      "tag": "prose",
      "target_sha256": "bec2d302b7beeee086f52ceb634f0b862d5cdada13259b39a73ed34086954210"
    },
    {
      "source_id": "fr81-u209-r0018",
      "target": "Мариус не покидал своего места. То, что он испытал в эту минуту, не поддаётся человеческому языку.",
      "source_sha256": "10ae983ac258d111a238677fead431d4792ff2b54a7b46650f46584aad8fc652",
      "target_id": "ru-fr81-u209-r0018",
      "tag": "prose",
      "target_sha256": "6e8fa23c1ad8d11d3df5269c7d861c45e9677d0bd0a57dd987d75fc483015b2e"
    },
    {
      "source_id": "fr81-u209-r0019",
      "target": "Это была Она.",
      "source_sha256": "acf3a77f7594abec4570e28b6c3c8311e4437c1505be2d219c1467932fed4b71",
      "target_id": "ru-fr81-u209-r0019",
      "tag": "prose",
      "target_sha256": "8e75134a6a5e4f6c5e74be094c6d52d4ac716c898ca5cc8b716103bb10489bab"
    },
    {
      "source_id": "fr81-u209-r0020",
      "target": "Всякий, кто любил, знает все лучезарные смыслы, заключённые в трёх буквах этого слова: Она.",
      "source_sha256": "19852207e5af14106a17f31ffc68c4c55d903d58c001ad6ae86286430fcd8cb6",
      "target_id": "ru-fr81-u209-r0020",
      "tag": "prose",
      "target_sha256": "b5dc3dad3a858ef2684e0304570918155809fd1ae839c4d5f8d5e3c71ba8c860"
    },
    {
      "source_id": "fr81-u209-r0021",
      "target": "Это была она, несомненно. Мариус едва различал её сквозь светлый туман, внезапно разлившийся перед его глазами. Это было то нежное отсутствующее существо, та звезда, что светила ему шесть месяцев, это были те зрачки, тот лоб, те уста, то прекрасное исчезнувшее лицо, которое, уходя, оставило после себя ночь. Видение померкло — и вот оно появилось вновь!",
      "source_sha256": "c0fe0ff10696cd40e6a5e1c8ef3f8e696c56b22fa3020ab36ebf957cf4993ebe",
      "target_id": "ru-fr81-u209-r0021",
      "tag": "prose",
      "target_sha256": "3d433f465bfa7d39942e1ed79f734435ef3221a903bec77eaa23205f9f44f5d3"
    },
    {
      "source_id": "fr81-u209-r0022",
      "target": "Оно появилось вновь — в этой тьме, в этой конуре, в этом уродливом логове, среди этого ужаса!",
      "source_sha256": "a39ff8abddd759600dacd233f73ca887051333e551ae751ab3bf111d75f4bebf",
      "target_id": "ru-fr81-u209-r0022",
      "tag": "prose",
      "target_sha256": "bb42408ce1ecc6730bd5ad85e12f97978feb06447dab581ffd4914da8dd4d4c0"
    },
    {
      "source_id": "fr81-u209-r0023",
      "target": "Мариус исступлённо трепетал. Как! Это она! Биение сердца туманило ему взор. Он чувствовал, что готов разрыдаться. Как! Он видит её наконец снова, после того как так долго искал её! Ему казалось, что он потерял свою душу и вот обрёл её вновь.",
      "source_sha256": "90d1de22b49c69f84754d1dbdedb9a4bca08dc2751107f05c408675fe48b8621",
      "target_id": "ru-fr81-u209-r0023",
      "tag": "prose",
      "target_sha256": "ea95abae2cc8f4696adbf04985a93f890b79fdfb221d1befc3f84d1d7246af66"
    },
    {
      "source_id": "fr81-u209-r0024",
      "target": "Она была всё та же, лишь немного бледнее; её нежное лицо обрамляла шляпка из фиолетового бархата, стан скрывался под шубкой из чёрного атласа. Из-под длинного платья виднелась маленькая ножка, обутая в шёлковый башмачок.",
      "source_sha256": "5de6ef61b59c23c093f61ee607142d3c88bfa2ea442f136440800ed43401b764",
      "target_id": "ru-fr81-u209-r0024",
      "tag": "prose",
      "target_sha256": "cb1cce47d740762bbfd1ddefc0b15f80e1b9d088e0486e0a75ca2631ca647e96"
    },
    {
      "source_id": "fr81-u209-r0025",
      "target": "Её по-прежнему сопровождал г-н Леблан.",
      "source_sha256": "ad32fac711116a0ffca3708760c670a84a2967c42b1286e8a52f9dd7aa0cfff5",
      "target_id": "ru-fr81-u209-r0025",
      "tag": "prose",
      "target_sha256": "7c9b1a0258b26abe9d20d25eaba4d404e991522eadc2a67ddbc51115b2ecc630"
    },
    {
      "source_id": "fr81-u209-r0026",
      "target": "Она сделала несколько шагов по комнате и положила на стол довольно большой свёрток.",
      "source_sha256": "840cbfadf4b7a7f12ca9ec26883d411252cb3b211d68d401d54694433a91c724",
      "target_id": "ru-fr81-u209-r0026",
      "tag": "prose",
      "target_sha256": "7208cfb3d9ef517b72605e3b277c93d0c1615440050bf7a1879f343db26244e9"
    },
    {
      "source_id": "fr81-u209-r0027",
      "target": "Старшая из дочерей Жондрета отступила за дверь и мрачным взглядом смотрела на эту бархатную шляпку, на эту шёлковую накидку и на это прелестное счастливое лицо.",
      "source_sha256": "e99710cf1ef7aa3bab52de76cfcb2fd65060c35abb54bf101660c439dddd1bf5",
      "target_id": "ru-fr81-u209-r0027",
      "tag": "prose",
      "target_sha256": "192874711065d82646f6a42407f497b2fc378c1bae5b124cfb10b7f8f6c06b56"
    }
  ],
