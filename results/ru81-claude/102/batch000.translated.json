      "tag": "table_cell",
      "target_sha256": "5875cf9da56c3a5a16e527195676cdc0b1141b055dbed9cc0da79f4d1812eab0"
    },
    {
      "source_id": "fr81-u102-r0015",
      "target": "[[SC]]Итого[[/SC]]",
      "source_sha256": "e02d4d16a7207f639fa48c11d1548923e3378e7e80f699ed32a96e653e9a6dfd",
      "target_id": "ru-fr81-u102-r0015",
      "tag": "table_cell",
      "target_sha256": "28bac7f203ab95d28b813e25a45fdbda4231bcfb310fc477fd06f0c7c90f6ef1"
    },
    {
      "source_id": "fr81-u102-r0016",
      "target": "23 фр.",
      "source_sha256": "8e4110396757240f131dcdfab4e7c6c1d5521a535c1f493d4b134821b6c12d91",
      "target_id": "ru-fr81-u102-r0016",
      "tag": "table_cell",
      "target_sha256": "b1bbf7d930cd8ad9207f500d473fd71af1ce8e265c08c2db7685b4205f050395"
    },
    {
      "source_id": "fr81-u102-r0017",
      "target": "«Обслуживание» было написано [[I]]обслужыванье[[/I]].",
      "source_sha256": "7671b0a7b9fb576f0feb6ce5355e8a34a36fc3060e81105f09b8c3a1e58241f1",
      "target_id": "ru-fr81-u102-r0017",
      "tag": "prose",
      "target_sha256": "26a36510fe4362fa26f8b14fb1cf7f9983bb40211fc1d8bbef3c07a169543d2b"
    },
    {
      "source_id": "fr81-u102-r0018",
      "target": "— Двадцать три франка! — воскликнула жена с восторгом, к которому примешивалось некоторое колебание.",
      "source_sha256": "7774d263f4e87969e421e89df3beb157a738d6554b229f16c68cbb995439f590",
      "target_id": "ru-fr81-u102-r0018",
      "tag": "prose",
      "target_sha256": "c82a790970e6447e69a6bdd6261a75f185d095bc20f3b110d0fc3c1aa9adbb96"
    },
    {
      "source_id": "fr81-u102-r0019",
      "target": "Как все великие художники, Тенардье остался недоволен.",
      "source_sha256": "3d93aa2926ca3d1be04af0b9e2e7a58d78081b63925b1e03c84af6b06cb5dd60",
      "target_id": "ru-fr81-u102-r0019",
      "tag": "prose",
      "target_sha256": "a795532733c4ebd84a63f43fe325096cec4d150bb25d2e9225b4d63a805a2b7c"
    },
    {
      "source_id": "fr81-u102-r0020",
      "target": "— Пф! — произнёс он.",
      "source_sha256": "e6a317d63bbca7a66468cf5d35da3535d416723bc8d52960a55d3cb25b8d144b",
      "target_id": "ru-fr81-u102-r0020",
      "tag": "prose",
      "target_sha256": "37c6c87de449a271bbea67bd9531faf837b6fa2aa5197cde969f549005db9c8a"
    },
    {
      "source_id": "fr81-u102-r0021",
      "target": "Таков был тон Кастлеро, когда он на Венском конгрессе составлял счёт, подлежавший уплате Францией.",
      "source_sha256": "f4e6d873fab1330370b63be11720baceba676d67a432511aabaad796a39936f9",
      "target_id": "ru-fr81-u102-r0021",
      "tag": "prose",
      "target_sha256": "d8661a7054b6d11cde68eca0caf213480cc2b4b7fcb9e8e8180380ca28540253"
    },
    {
      "source_id": "fr81-u102-r0022",
      "target": "— Господин Тенардье, ты прав, он и вправду должен столько, — пробормотала жена, думая о кукле, подаренной Козетте на глазах у её дочерей, — это справедливо, но это слишком много. Платить он не захочет.",
      "source_sha256": "858a5d7856e1cffbb22fa05d2f2319779ca075e95a2e8d0affe04b943edc636c",
      "target_id": "ru-fr81-u102-r0022",
      "tag": "prose",
      "target_sha256": "6e94b6c6b203d7914892f4119ab248c4aabff8b439aed25658a1779df841dd63"
    },
    {
      "source_id": "fr81-u102-r0023",
      "target": "Тенардье холодно рассмеялся и сказал:",
      "source_sha256": "90af7329b08faa6e80a87c18d86b3380b54f4003670ea19544b1a2f18bd0c3f2",
      "target_id": "ru-fr81-u102-r0023",
      "tag": "prose",
      "target_sha256": "46ead19f730db0bd7414a522419e3f62bd70885d28bf8dcff9edbf3f03d50085"
    },
    {
      "source_id": "fr81-u102-r0024",
      "target": "— Заплатит.",
      "source_sha256": "388eae729e6497bc30fe41eac90f4ba4d8bae58094b57a83d291a4cd822295bc",
      "target_id": "ru-fr81-u102-r0024",
      "tag": "prose",
      "target_sha256": "3893314eef17c9ae118d45d1017cb437c758d18cb1c2686156424772e501da85"
    },
    {
      "source_id": "fr81-u102-r0025",
      "target": "Этот смех был высшим выражением уверенности и власти. Что было сказано так, то должно было сбыться. Жена не настаивала. Она принялась расставлять столы; муж ходил взад и вперёд по зале. Немного погодя он добавил:",
      "source_sha256": "fc826f6fa17554d4c239cf26492aab4eaff57168798467ebb00fb67052a6881a",
      "target_id": "ru-fr81-u102-r0025",
      "tag": "prose",
      "target_sha256": "22f7e106ac4ba10c218be96765261d6f51b7aaddd62bc4cc496753acad42fe85"
    },
    {
      "source_id": "fr81-u102-r0026",
      "target": "— А я вот должен целых полторы тысячи франков!",
      "source_sha256": "4256ee34e9af6e53243295e46e519683dbbd178d1c4ca9d8fba1ca79d887697d",
      "target_id": "ru-fr81-u102-r0026",
      "tag": "prose",
      "target_sha256": "2c6812d708e6b5710fd4a671fec783ffa16a28bf2028dd8c356131a7003cd624"
    },
    {
      "source_id": "fr81-u102-r0027",
      "target": "Он пошёл сесть в углу у камина и задумался, держа ноги на горячей золе.",
      "source_sha256": "9761ea7d6f96582438640f2a159cbecba79d15eccf0440bafb7258a52d5c0509",
      "target_id": "ru-fr81-u102-r0027",
      "tag": "prose",
      "target_sha256": "13ff402d0cb4fa062d1c91af66752a9610b0eadab49df0d841c2387b9e4f829d"
    },
    {
      "source_id": "fr81-u102-r0028",
      "target": "— Ну так вот! — снова заговорила жена. — Ты не забыл, что сегодня я вышвыриваю Козетту за дверь? Это чудовище! Она вытягивает из меня сердце своей куклой! Я бы лучше вышла замуж за Людовика Восемнадцатого, чем продержала её в доме лишний день!",
      "source_sha256": "2ca8edfc677acd31f420eb2aba77f185f1005ffddbe82ada00733752d65ba1a0",
      "target_id": "ru-fr81-u102-r0028",
      "tag": "prose",
      "target_sha256": "c4a7ec224157e5b36ad7dd2fc70db33569e61da983b550d461caf994d8a99d15"
    },
    {
      "source_id": "fr81-u102-r0029",
      "target": "Тенардье раскурил трубку и ответил между двумя затяжками:",
      "source_sha256": "00373d866b4288889bafeff05423ef0cab6ba1169c165061c0d89de9cef0673a",
      "target_id": "ru-fr81-u102-r0029",
      "tag": "prose",
      "target_sha256": "b4f04538bdebd41f88064c7e73c229d74c6f3309310aed0cf13827a8671899af"
    },
    {
      "source_id": "fr81-u102-r0030",
      "target": "— Счёт отдашь тому человеку.",
      "source_sha256": "4c8ba3686236750b91015dcb5695f397c4b8e63512b39434e93c7af742b2f7e8",
      "target_id": "ru-fr81-u102-r0030",
      "tag": "prose",
      "target_sha256": "8f3efe08b628d16a484a8a57ef252fd8ef022626016c1d3c5703c1cc5dd81caa"
    },
    {
      "source_id": "fr81-u102-r0031",
      "target": "Затем он вышел.",
      "source_sha256": "dbe98660fe60537e946f732c5e9ed4d23c942c8dabc18315b71a1065e2263124",
      "target_id": "ru-fr81-u102-r0031",
      "tag": "prose",
      "target_sha256": "8afba4a880a7aec46690551fc6f379e4e636d7b122cf651ae606495d7736aa05"
    }
  ],
