  "rows": [
    {
      "source_id": "fr81-u102-h",
      "target": "IX Тенардье маневрирует",
      "source_sha256": "e7a1f8f0771879fd638a3207ec58cb03993e34fad9d6ffbc5b72806cfc74e167",
      "target_id": "ru-fr81-u102-h",
      "tag": "heading",
      "target_sha256": "2a75832fae8c5d42f9ba7df3bcb9d8b4b88c98d8deb62a11c25d87c9764daf13"
    },
    {
      "source_id": "fr81-u102-r0001",
      "target": "На следующее утро, по меньшей мере за два часа до рассвета, муж Тенардье сидел за столом при свече в нижней зале трактира, с пером в руке, и составлял счёт для проезжего в жёлтом сюртуке.",
      "source_sha256": "8d7a39d47f039802112b39bb9a4c2c33a1896733a43c12b516fed2aabd6c4261",
      "target_id": "ru-fr81-u102-r0001",
      "tag": "prose",
      "target_sha256": "522ef907e11131a3445e5f790c9f0d58446a1b1f61e3ba404c437b39a9b6135c"
    },
    {
      "source_id": "fr81-u102-r0002",
      "target": "Жена стояла рядом, наполовину склонившись над ним, и следила за пером глазами. Они не обменялись ни словом. С одной стороны была глубокая задумчивость, с другой — то благоговейное восхищение, с каким смотрят, как рождается и расцветает чудо человеческого ума. В доме слышался шум: это Жаворонок подметала лестницу.",
      "source_sha256": "a8fc7bae61417fcd992bed1253787c00cfcc9cbcec6413a6a16452c7e0bc1178",
      "target_id": "ru-fr81-u102-r0002",
      "tag": "prose",
      "target_sha256": "d643e87d919db555163ff4c3b36e57127e8ab52fe234418a76fb9ecce8dc1258"
    },
    {
      "source_id": "fr81-u102-r0003",
      "target": "Спустя добрых четверть часа и несколько помарок Тенардье произвёл на свет этот шедевр:",
      "source_sha256": "6f6890ff20f3b426d9e2e5f8af906f29c15d1ea6a6e2187fcf57a8565472211f",
      "target_id": "ru-fr81-u102-r0003",
      "tag": "prose",
      "target_sha256": "cf13970b7d9919e797b4b976699109f95ef535626a3cd39e280623ccb6af22b3"
    },
    {
      "source_id": "fr81-u102-r0004",
      "target": "Счёт господина из № 1",
      "source_sha256": "c404ba05706bdd024a25ee04f1913c896cdaad96a3ba195135797e2318b5580a",
      "target_id": "ru-fr81-u102-r0004",
