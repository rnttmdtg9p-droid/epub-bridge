{
  "unit": 102,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u102-r0032",
      "target": "Едва он вышел из залы, как в неё вошёл путешественник.",
      "source_sha256": "26cfe3ea38de245ae55aad72a95f7bd8911317bb964d259a8f4f130df7117bc8",
      "target_id": "ru-fr81-u102-r0032",
      "tag": "prose",
      "target_sha256": "6429d98861a5e67aed7ebdce4a2ac451a5825b4b898e7140cf25d5a7a5ce75c8"
    },
    {
      "source_id": "fr81-u102-r0033",
      "target": "Тенардье тотчас же вновь появился позади него и замер в приотворённой двери, видимый одной лишь своей жене.",
      "source_sha256": "7f1feee621ca2c0a2fc510db643d973ef50cfe16a7a069ab0f14de41567bdef7",
      "target_id": "ru-fr81-u102-r0033",
      "tag": "prose",
      "target_sha256": "766a4df09265c2e5e257b2f5d116ee43dd2c5dbb11dd3d561d3fc94b49214634"
    },
    {
      "source_id": "fr81-u102-r0034",
      "target": "Жёлтый человек держал в руке свою палку и свой узелок.",
      "source_sha256": "8ca5a8e173a49c17c59e1190e2fae862434c8f1f4b317a0f3dbf3066ae06e6a5",
      "target_id": "ru-fr81-u102-r0034",
      "tag": "prose",
      "target_sha256": "863609c8d7119920899bdffa82b71c34eb8ebd3f10a4f58513f45ad8b296f966"
    },
    {
      "source_id": "fr81-u102-r0035",
      "target": "— Так рано поднялись! — сказала Тенардье. — Неужто сударь уже покидает нас?",
      "source_sha256": "3728ddbd200985580abb4a6463c0040c321b7cfd858a09c86a3c0202d47c3294",
      "target_id": "ru-fr81-u102-r0035",
      "tag": "prose",
      "target_sha256": "c5325bbf3e619f124d6e07f0c2959e280006e317d37956cedf7824790b070213"
    },
    {
      "source_id": "fr81-u102-r0036",
      "target": "Говоря так, она с смущённым видом вертела в руках счёт и ногтями проводила на нём складки. Её жёсткое лицо выражало нечто для неё непривычное — робость и совестливость.",
      "source_sha256": "82649ed210e3dfff210d9ab257b813133e852967aa890f76bd94285a1a69c3f7",
      "target_id": "ru-fr81-u102-r0036",
      "tag": "prose",
      "target_sha256": "e35ef8b224e915cc80284904c063854b6bf7531d52497098dcdcc3bc251f6782"
    },
    {
      "source_id": "fr81-u102-r0037",
      "target": "Подать такой счёт человеку, который так совершенно походил на «бедняка», казалось ей делом нелёгким.",
      "source_sha256": "76533d62477c11c5eac20eac3b6a9377aeab0bce85158dc306bd785ad8a8cd55",
      "target_id": "ru-fr81-u102-r0037",
      "tag": "prose",
      "target_sha256": "b17058ec2a7727de0dbd28a9e9623dfc05a055231f15eff40e26bdbb48a070aa"
    },
    {
      "source_id": "fr81-u102-r0038",
      "target": "Путешественник казался озабоченным и рассеянным. Он ответил:",
      "source_sha256": "4989fd9a97e6444023c4e2108b26ec366c5e801af4edd6c46b8df0c2016afb25",
      "target_id": "ru-fr81-u102-r0038",
      "tag": "prose",
      "target_sha256": "ab15b324fddceee0165f4938f9069795b92a3942307b7c9beb611b79337f67d8"
    },
    {
      "source_id": "fr81-u102-r0039",
      "target": "— Да, сударыня, я ухожу.",
      "source_sha256": "82a108737841f005edfe9731efd2f7aeca0bd19a8fcd8e922fe6f2b8146fbfbf",
      "target_id": "ru-fr81-u102-r0039",
      "tag": "prose",
      "target_sha256": "87ddb2a161f02330a25c32a10fee8af1a4c8d9351cebeac78217db5f5d86e109"
    },
    {
      "source_id": "fr81-u102-r0040",
      "target": "— Стало быть, у сударя не было дел в Монфермейле? — продолжала она.",
      "source_sha256": "096575749ffc6689d14c6406133067f7636654a5518f62ffeb38f06cf3fb05c1",
      "target_id": "ru-fr81-u102-r0040",
      "tag": "prose",
      "target_sha256": "36825b0722c4fd4c078b16c933698768162536c8d2abb57df31fb0cf36041858"
    },
    {
      "source_id": "fr81-u102-r0041",
      "target": "— Нет. Я просто прохожу здесь. Вот и всё. — Сударыня, — прибавил он, — сколько я должен?",
      "source_sha256": "cd93f99c678fb1672aa3dd9be9b9076138bf5c66f86997246117f3a22a3f7c2c",
      "target_id": "ru-fr81-u102-r0041",
      "tag": "prose",
      "target_sha256": "013ac6f515662e902b212ecd18b43cafe7335659fe9e974721828e61fa0e41e3"
    },
    {
      "source_id": "fr81-u102-r0042",
      "target": "Тенардье, не отвечая, протянула ему сложенный счёт. Человек развернул бумагу и взглянул на неё, но внимание его, видимо, было далеко.",
      "source_sha256": "f356acf4868761f546ec592349dd012b51b28c1853001b12f21dd1ae60cb795a",
      "target_id": "ru-fr81-u102-r0042",
      "tag": "prose",
      "target_sha256": "371ce4404dd270859dff51e0a4dd91ca2f4d8d9890e94c5010fd898796afc5f9"
    },
    {
      "source_id": "fr81-u102-r0043",
      "target": "— Сударыня, — снова заговорил он, — хорошо ли идут у вас дела в этом Монфермейле?",
      "source_sha256": "ab4997d295a383c84fbe1372d23038cddcba4a272b157972802686b88df9f2ad",
      "target_id": "ru-fr81-u102-r0043",
      "tag": "prose",
      "target_sha256": "47b826b9cc665badc06535ea11325034a39b8bc313e3cc72253f5210370406ac"
    },
    {
      "source_id": "fr81-u102-r0044",
      "target": "— Так себе, сударь, — ответила Тенардье, изумлённая тем, что не последовало никакого нового взрыва.",
      "source_sha256": "e2d22a536543cdbe41f2206534df0025903be0c3b4f688c1cd269b17961f2bb6",
      "target_id": "ru-fr81-u102-r0044",
      "tag": "prose",
      "target_sha256": "7ac50a594b3243ab9efb610561d2c4a972b680a14705e159c8e83cb036238aa5"
    },
    {
      "source_id": "fr81-u102-r0045",
      "target": "Она продолжала жалобным, горестным тоном:",
      "source_sha256": "0bf203e1b4d49b2f87450f91542b976bb0e8d0cf4740f8b1dc2fa3bae930145d",
      "target_id": "ru-fr81-u102-r0045",
      "tag": "prose",
      "target_sha256": "125e2543b7fc96a248ffc0ebe61d5cc2cea40381e68d3550199db148bef5d666"
    },
    {
      "source_id": "fr81-u102-r0046",
      "target": "— Ох, сударь, времена очень тяжёлые! А тут ещё у нас в этих местах так мало приличной публики! Народ всё мелкий, сами видите. Если бы не попадались нам там и сям путешественники, щедрые и богатые, как сударь! Столько у нас расходов. Вот хоть бы эта малютка — она нам влетает в копеечку.",
      "source_sha256": "fbf486bccb200c547265e0e158d99259d49348d6f23f067d113aa45a99717018",
      "target_id": "ru-fr81-u102-r0046",
      "tag": "prose",
      "target_sha256": "d2ead41dd1eb9755fd0a497d79314280221b516ffb50a70bcaf50ab826df1d9d"
    },
    {
      "source_id": "fr81-u102-r0047",
      "target": "— Какая малютка?",
      "source_sha256": "1641d92957e14ba6e43eb6ebb36739a1e4578647edcec5bfaff83faa09368f32",
      "target_id": "ru-fr81-u102-r0047",
      "tag": "prose",
      "target_sha256": "a171da4215c3d30dec6ff3fab91b5ab07583f31667083466fb3258b2aec3c4f7"
    },
    {
      "source_id": "fr81-u102-r0048",
      "target": "— Ну как же, малютка, вы знаете! Козетта! Жаворонок, как её зовут в наших краях!",
      "source_sha256": "006b899a25ef79805c8ea9addbcebc57b1c27f07ee153a56dc983a6e3252b7af",
      "target_id": "ru-fr81-u102-r0048",
      "tag": "prose",
      "target_sha256": "9583ecacef3c0d94a3647ea882113bc58136c1279676386ef2f2751a96160aae"
    },
    {
      "source_id": "fr81-u102-r0049",
      "target": "— А! — сказал человек.",
      "source_sha256": "32470c92c97f2baab9c54b6360b1ddd2b503279dec0d0800a12856aa3b9d6815",
      "target_id": "ru-fr81-u102-r0049",
      "tag": "prose",
      "target_sha256": "8bb617ace9d69638c72fdabc599c460a3bb962653d9e5e7d52a59ff48d1860fa"
    },
    {
      "source_id": "fr81-u102-r0050",
      "target": "Она продолжала:",
      "source_sha256": "d15e8f8db7df2049fdc3f693084cae7227e20dfe45e408f92d2693abe4c2e1e1",
      "target_id": "ru-fr81-u102-r0050",
      "tag": "prose",
      "target_sha256": "fc5c21cca3654f0c554200f4ed54be307c77a8c6b4e8c12ca804c3e10e4d5743"
    },
    {
      "source_id": "fr81-u102-r0051",
      "target": "— Какие они глупые, эти крестьяне, со своими прозвищами! Она скорее похожа на летучую мышь, чем на жаворонка. Видите ли, сударь, мы не просим милостыни, но и сами подавать её не можем. Мы ничего не зарабатываем, а платить нам приходится много. Патент, налоги, подать с дверей и окон, добавочные сборы! Сударь знает, что правительство требует ужасных денег. А кроме того, у меня есть свои дочери. Мне незачем кормить чужого ребёнка.",
      "source_sha256": "db95ee910f096d7b9c797b4e2459de214623b42e22a7da42905de9798b939e1a",
      "target_id": "ru-fr81-u102-r0051",
      "tag": "prose",
      "target_sha256": "376ac4e0244d3cc36ebdefc5e86735368a97563432dfb4cdbd403bc4d7dae7e4"
    },
    {
      "source_id": "fr81-u102-r0052",
      "target": "Человек заговорил снова тем голосом, который он старался сделать безразличным и в котором всё же слышалась дрожь:",
      "source_sha256": "7cab5132e9d7df9da3472293a30af703ce52050053db9c4240fad9305ee41085",
      "target_id": "ru-fr81-u102-r0052",
      "tag": "prose",
      "target_sha256": "6344fe0d03aac5aceaa42a4aabad2a573511ce0fe9ad23dbcd6a2f681df902c8"
    },
    {
      "source_id": "fr81-u102-r0053",
      "target": "— А если бы вас от неё избавили?",
      "source_sha256": "6ad458bbba5c1262c65c03dc64ee77d19b3f8910c589d8f3423ddfb4051b41c1",
      "target_id": "ru-fr81-u102-r0053",
      "tag": "prose",
      "target_sha256": "d4ed26068fd7ef289c3587a1f2175a7cfc012c6adf74c61309a7dcba55c47866"
    },
    {
      "source_id": "fr81-u102-r0054",
      "target": "— От кого? От Козетты?",
      "source_sha256": "29d0ac247adeaf4ca7726d4e8768a6097b37a600ab01ae181fd33cd7f29ce85b",
      "target_id": "ru-fr81-u102-r0054",
      "tag": "prose",
      "target_sha256": "a1da5a9a3fd3bc88ca1bf87253ace65f787ef6b182c44521686edcac6fe5bae9"
    },
    {
      "source_id": "fr81-u102-r0055",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u102-r0055",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u102-r0056",
      "target": "Красное, свирепое лицо трактирщицы озарилось отвратительным расцветом радости.",
      "source_sha256": "57812532d350dd1bb426635e7e154c755f324bb63b7bc7d906af7ad147684074",
      "target_id": "ru-fr81-u102-r0056",
      "tag": "prose",
      "target_sha256": "ce0a606061b811dfb8b3fa9011d815a4ea5b1ebed780a6aff8beee08b4fab543"
    },
    {
      "source_id": "fr81-u102-r0057",
      "target": "— Ах, сударь! Добрый мой сударь! Берите её, держите у себя, уводите, уносите, подслащайте её, начиняйте трюфелями, пейте её, ешьте её, и да благословит вас пресвятая Дева и все святые рая!",
      "source_sha256": "c5c4f0ee0ee3378893dcf0f1d72e5dde8cf9c511304e8831d280669c5c85ca08",
      "target_id": "ru-fr81-u102-r0057",
      "tag": "prose",
      "target_sha256": "f650459366cff8feceed7c8118afd3f35e1f736d741f9df7add96e2481929077"
    },
    {
      "source_id": "fr81-u102-r0058",
      "target": "— Решено.",
      "source_sha256": "f3b369249b11615ceb373dfa5e68566fd669f334ed72a4fda0f33a7f857cd33f",
      "target_id": "ru-fr81-u102-r0058",
      "tag": "prose",
      "target_sha256": "e89518c7f8bd2912caef96aba6f124946bb55436dfc2b29568a51f14e107fe5c"
    },
    {
      "source_id": "fr81-u102-r0059",
      "target": "— Правда? Вы её уводите?",
      "source_sha256": "74d1509863dcd6530790c12eb6db9ad10ad74941c3040bbe2c504bfe3e723b49",
      "target_id": "ru-fr81-u102-r0059",
      "tag": "prose",
      "target_sha256": "874420bd9b76f6cb2fc2deb12f4948e5809315453898e3a53f6d1990a29f1667"
    },
    {
      "source_id": "fr81-u102-r0060",
      "target": "— Я её уведу.",
      "source_sha256": "1d73994ec73b821d3aa623a2578008e84c99042a3421b7cb90d5e6c4ffbf1584",
      "target_id": "ru-fr81-u102-r0060",
      "tag": "prose",
      "target_sha256": "c38db492d6771542df077916cfc75d5e2faa35fa267afd4de31ba447fdcca3fd"
    },
    {
      "source_id": "fr81-u102-r0061",
      "target": "— Сейчас же?",
      "source_sha256": "a1162624d33b223baba538c3397309fbb4152a8bd27c1583e1e8b67f64cfd8c7",
      "target_id": "ru-fr81-u102-r0061",
      "tag": "prose",
      "target_sha256": "1bff5897c99ac865210560b33f7e4592e413b30a8e44a3b912f6def5bafa6e52"
    },
    {
      "source_id": "fr81-u102-r0062",
      "target": "— Сейчас же. Позовите ребёнка.",
      "source_sha256": "a1204a72274969e26ffe3c1f0f6fcc774fa1c1b798c22b7a7665806a52eca42f",
      "target_id": "ru-fr81-u102-r0062",
      "tag": "prose",
      "target_sha256": "4de79dc7459b15efd1dbc1837b844f2c6cab834199bb02e07902a20c60e8781f"
    },
    {
      "source_id": "fr81-u102-r0063",
      "target": "— Козетта! — крикнула Тенардье.",
      "source_sha256": "8ce0fbcad6b82095fbad71da2ba13f14192277d4a34c972bd21aeead5ae412e7",
      "target_id": "ru-fr81-u102-r0063",
      "tag": "prose",
      "target_sha256": "fabc293742dd8732e500c901182c21757e67b276a83bc415d65448385567fef5"
    }
  ],
