      "target_sha256": "70495e0ce46539ec52f2431c48a4774d1002716dc2bb35e3219dcaae1d8e8398"
    },
    {
      "source_id": "fr81-u230-r0031",
      "target": "Это было нелепо, но неодолимо.",
