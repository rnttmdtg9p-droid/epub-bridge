{
  "unit": 297,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u297-r0032",
      "target": "— Правда? — сказал он. — И вы не станете мне мешать бить фонари?",
      "source_sha256": "10fef1925126930157d8280db94cf88271c917939001a09b828264b1ec10a31e",
      "target_id": "ru-fr81-u297-r0032",
      "tag": "prose",
      "target_sha256": "66470a57d33b18d6551021d83e6032590e73616283140d0a9edb5de0d0605d23"
    },
    {
      "source_id": "fr81-u297-r0033",
      "target": "— Бей всё, что захочешь.",
      "source_sha256": "8e7bf6b07f9c9f439ea6d362f2c186f4afcb9b6c26dffe689efc756dcae29414",
      "target_id": "ru-fr81-u297-r0033",
      "tag": "prose",
      "target_sha256": "e51b680c0fbdfc7af62bda7ac29c01b07a7cb45102f438c137cdba632bb619e2"
    },
    {
      "source_id": "fr81-u297-r0034",
      "target": "— Вы славный человек, — сказал Гаврош.",
      "source_sha256": "61ee7e16a8ced81635c87bb749c257912eac67a110f6a818e2bf41ad25b8a237",
      "target_id": "ru-fr81-u297-r0034",
      "tag": "prose",
      "target_sha256": "366de01753fe3fa523812e00b2c44abb708c283406f05d7ddfb3e81566db3462"
    },
    {
      "source_id": "fr81-u297-r0035",
      "target": "И он положил пятифранковую монету в один из своих карманов.",
      "source_sha256": "4ecc52d6ebf8ae95566858a3c9fe1fee2dcb15bd9032dd078b9018edad0f4a2c",
      "target_id": "ru-fr81-u297-r0035",
      "tag": "prose",
      "target_sha256": "688a81928856ff7b34aa3f9b5a7e430a82828e78e763cd29d3456f6e48946dd0"
    },
    {
      "source_id": "fr81-u297-r0036",
      "target": "Доверие его росло, и он прибавил:",
      "source_sha256": "5c85c358415625cd0cefa2218fda3b09f385a1632cd2d20b8ada3b7054bff41a",
      "target_id": "ru-fr81-u297-r0036",
      "tag": "prose",
      "target_sha256": "70a16cbfc2f780527644df7af4304440bbbe3940708be5e71bb489a164d21382"
    },
    {
      "source_id": "fr81-u297-r0037",
      "target": "— Вы с улицы?",
      "source_sha256": "3788545d0c03259dfaf26ea2425a0b84178e854c8d7cab9206b8f8672262bfb8",
      "target_id": "ru-fr81-u297-r0037",
      "tag": "prose",
      "target_sha256": "45c180a32444227c4cf7dc2048fd2c23b702b5ade5b07212c6e6ae0487c35a5a"
    },
    {
      "source_id": "fr81-u297-r0038",
      "target": "— Да, а что?",
      "source_sha256": "55c6d5a0b1e6ed0447952a32b029509123e48452e2b76f36bbc58d3ce20c0db2",
      "target_id": "ru-fr81-u297-r0038",
      "tag": "prose",
      "target_sha256": "009fae9f29ca20b6ccf3fcb329bf87898786210819034bf166263db62f75a1ac"
    },
    {
      "source_id": "fr81-u297-r0039",
      "target": "— Не могли бы вы показать мне номер седьмой?",
      "source_sha256": "41e458f467a2539ed791a602478dad96e281d48bd66c0cbfc4930f3632195907",
      "target_id": "ru-fr81-u297-r0039",
      "tag": "prose",
      "target_sha256": "788b830fdcf39d76445136387e11d8d084135c6f675137d28a32e2011c807ca6"
    },
    {
      "source_id": "fr81-u297-r0040",
      "target": "— А зачем вам номер седьмой?",
      "source_sha256": "68d2143540b7bd4844db6e45bca5ba0ece08245bf8720bce6fd2f450881fb85d",
      "target_id": "ru-fr81-u297-r0040",
      "tag": "prose",
      "target_sha256": "0f2c4e2c874bddf084462608b4b5b9f7eff8a26e4aaa1cde94e265a93b95f62c"
    },
    {
      "source_id": "fr81-u297-r0041",
      "target": "Тут мальчик осёкся: он испугался, что сказал слишком много, яростно запустил ногти в волосы и ограничился ответом:",
      "source_sha256": "bb1ce40602a08baeb3b0645207e09687232e5d2f2d9c2a8f473c44bbbd694f82",
      "target_id": "ru-fr81-u297-r0041",
      "tag": "prose",
      "target_sha256": "944a653de595bc4c56181120dbb8686fc9367676994d0fe5d9d145926ec6472b"
    },
    {
      "source_id": "fr81-u297-r0042",
      "target": "— Ах! Вот в чём дело.",
      "source_sha256": "ecba654bb90e700f6b2d75ac4072b950160c5c8167fbbf30ee2e245aba9abe5b",
      "target_id": "ru-fr81-u297-r0042",
      "tag": "prose",
      "target_sha256": "c7ef4f9692ea9fb552725a0b4e6ddaab6ec013aad4e6e2d6edfedcafcd1a0c7b"
    },
    {
      "source_id": "fr81-u297-r0043",
      "target": "Одна мысль мелькнула в уме Жана Вальжана. Тоска знает такие озарения. Он сказал мальчику:",
      "source_sha256": "51ecf2ebf80713ee3aee9c8ca33971356a22f47a6ba8c5f124d26e4da5251d6e",
      "target_id": "ru-fr81-u297-r0043",
      "tag": "prose",
      "target_sha256": "dc5f3d8813499ae5b48007992b482f5375c4ba8314bf20a6e1faf33e103b5ad7"
    },
    {
      "source_id": "fr81-u297-r0044",
      "target": "— Не ты ли принёс мне письмо, которого я жду?",
      "source_sha256": "3639f2a9b5e957ee16e6a3594a2edd5a7e637a6fe4a3df6700a5904bf4ff27b5",
      "target_id": "ru-fr81-u297-r0044",
      "tag": "prose",
      "target_sha256": "84b1b1c744b949d5870c36a31a31d81a245087fc6c64d48381f5035264582c45"
    },
    {
      "source_id": "fr81-u297-r0045",
      "target": "— Вы? — сказал Гаврош. — Вы же не женщина.",
      "source_sha256": "06692e66319547b2f8d592b1c1764501cecd32c63261d4867084b9b29e9e9502",
      "target_id": "ru-fr81-u297-r0045",
      "tag": "prose",
      "target_sha256": "3e740c04fd7c9c6757923ade202c082689cba5912673621fe82ca4e5122cb4b0"
    },
    {
      "source_id": "fr81-u297-r0046",
      "target": "— Письмо ведь для мадемуазель Козетты, не так ли?",
      "source_sha256": "0c29d2139676e8ebb336d6c3dd6564a7a10a1a690cac73345026946cee20c764",
      "target_id": "ru-fr81-u297-r0046",
      "tag": "prose",
      "target_sha256": "7cc21856bc1653140f41e2ccb4ed4fc07d8a819cb839e4706858d6db3364385f"
    },
    {
      "source_id": "fr81-u297-r0047",
      "target": "— Козетты? — проворчал Гаврош. — Да, кажется, это то самое чудное имя.",
      "source_sha256": "b4c84474dd5034dad430ccac5db7a7d93433ee188cc3d75b9a02d14f001714c9",
      "target_id": "ru-fr81-u297-r0047",
      "tag": "prose",
      "target_sha256": "a5ed445b81d9e80fbefc5a6fdfd7b7942755c9e4d3decde27c141be6ca407179"
    },
    {
      "source_id": "fr81-u297-r0048",
      "target": "— Так вот, — продолжал Жан Вальжан, — письмо должен передать ей я. Давай.",
      "source_sha256": "8b96e4a0b83a4206d4c866e84080f5e8202c5c1d2640cc501ed554e5f25c7d1f",
      "target_id": "ru-fr81-u297-r0048",
      "tag": "prose",
      "target_sha256": "ff4d7ddab3a8b7cfe8782a429fa85dbc019b0b54d8e44a05f4a637acbcf6ed84"
    },
    {
      "source_id": "fr81-u297-r0049",
      "target": "— В таком случае вы должны знать, что я послан с баррикады?",
      "source_sha256": "4c223344b8694344b85d2fd4e549a48e33b7f3ca7046ba494b854aa63653cc85",
      "target_id": "ru-fr81-u297-r0049",
      "tag": "prose",
      "target_sha256": "1fee832dd8bd88b2639a0df3587597ff9c56f1e7956542dfc7b410e6f6282bdd"
    },
    {
      "source_id": "fr81-u297-r0050",
      "target": "— Разумеется, — сказал Жан Вальжан.",
      "source_sha256": "8b6ca65ef29a4d0febb9e912c70afa7ef639873c45e753860a924e2b30c713fd",
      "target_id": "ru-fr81-u297-r0050",
      "tag": "prose",
      "target_sha256": "63587b3c309ba42ccdb3883e8a7948fdb06ad3bc4f78f42a47463bea3c287541"
    },
    {
      "source_id": "fr81-u297-r0051",
      "target": "Гаврош засунул кулак в другой карман и вытащил оттуда бумагу, сложенную вчетверо.",
      "source_sha256": "fbf700fa84ae04dd9743e11340a4de00526596814fe379e4a37acc35d0055d49",
      "target_id": "ru-fr81-u297-r0051",
      "tag": "prose",
      "target_sha256": "b2a7811a531198412b8df8e016d8c6690bcdb1061e710ae09b91defa5841268a"
    },
    {
      "source_id": "fr81-u297-r0052",
      "target": "Потом он отдал честь по-военному.",
      "source_sha256": "25cdea1c9fc97c8d74bce73e7a4b0c84a48c22cbca8bf323d54ad3e9a39f4068",
      "target_id": "ru-fr81-u297-r0052",
      "tag": "prose",
      "target_sha256": "d1c2a14b7204c75f658f918582168118a0a46860b6f96603ba3985e4d3d0e98c"
    },
    {
      "source_id": "fr81-u297-r0053",
      "target": "— Почтение депеше, — сказал он. — Она от Временного правительства.",
      "source_sha256": "841848664745385c95d4e5cfee2d62f3981c6dc5dfc4c92a3c91f86d3f71f362",
      "target_id": "ru-fr81-u297-r0053",
      "tag": "prose",
      "target_sha256": "0d83ccb34f5b08d9b681242286a6cea7729f2b43e867df0259e69f4963c4ba92"
    },
    {
      "source_id": "fr81-u297-r0054",
      "target": "— Давай, — сказал Жан Вальжан.",
      "source_sha256": "87baaf4748269abf38a3f010d7c455fc4398950dd0d8a3526149ad5bbdd52aca",
      "target_id": "ru-fr81-u297-r0054",
      "tag": "prose",
      "target_sha256": "2c070b3aad9814a051c12e6fbb638531a26ed93d8cd9afdfbb941febb71fc77a"
    },
    {
      "source_id": "fr81-u297-r0055",
      "target": "Гаврош держал бумагу высоко над головой.",
      "source_sha256": "6047dec1e4ab66a70e8ec302a98e1965829ed370260cefa8da36bec7b0820c89",
      "target_id": "ru-fr81-u297-r0055",
      "tag": "prose",
      "target_sha256": "52326d9c6b4046d4e16867773f00ed87e7ee1d0b9aa976aa5819247238e1e7c3"
    },
    {
      "source_id": "fr81-u297-r0056",
      "target": "— Не воображайте, будто это любовная записочка. Она для женщины, но она для народа. Мы, которые дерёмся, уважаем прекрасный пол. Мы не такие, как в большом свете, где львы посылают цыплят верблюдицам.",
      "source_sha256": "dc7f56c5bafc88074a251d2e6498a41e59d4d5b7e0f554a48597a9f8630618a4",
      "target_id": "ru-fr81-u297-r0056",
      "tag": "prose",
      "target_sha256": "c48747cb4c15fbb3fed674a836e33fef965cb48ca7b36623179cb2f511e4c054"
    },
    {
      "source_id": "fr81-u297-r0057",
      "target": "— Давай.",
      "source_sha256": "42126d52db69eb4ada8d544eefa104f4bcb7d7b032aa6f5a01f78029e8241cdb",
      "target_id": "ru-fr81-u297-r0057",
      "tag": "prose",
      "target_sha256": "8c9c8fdd7012aa54d33e02532bbb50a24fdc236b0f8269c4513cf343cb05d6e9"
    },
    {
      "source_id": "fr81-u297-r0058",
      "target": "— Впрочем, — продолжал Гаврош, — вы, по-моему, славный человек.",
      "source_sha256": "162e5d8b9e3ed9c4fce8acc8ffbf7209c7b73220b55d58162ddcbb699c432574",
      "target_id": "ru-fr81-u297-r0058",
      "tag": "prose",
      "target_sha256": "c7bd6bba678dbb57eb9e15d6ce28c085d4cc21db625c4b089efdeaf5800aad3d"
    },
    {
      "source_id": "fr81-u297-r0059",
      "target": "— Давай скорее.",
      "source_sha256": "f8ba4d8fabd9568c36c184375938e2338d38afd43ae6b35b44e9681aeab331fd",
      "target_id": "ru-fr81-u297-r0059",
      "tag": "prose",
      "target_sha256": "a9f7f5101326eef7dace54fe02ce409196148fbed24afb7f603499f4e4754dfd"
    },
    {
      "source_id": "fr81-u297-r0060",
      "target": "— Нате.",
      "source_sha256": "a6cd96de4544238f7961e1b8344ec2f19f4ee15160325ac35fccbfff3bc90041",
      "target_id": "ru-fr81-u297-r0060",
      "tag": "prose",
      "target_sha256": "e49c262e29a3972db9986ae790544f504b3eeafd9a6328dfefdd049c3160f306"
    },
    {
      "source_id": "fr81-u297-r0061",
      "target": "И он отдал бумагу Жану Вальжану.",
      "source_sha256": "5b43f7762735cd752ba472b3ccf87543b6868c916a32d535c34780449686377b",
      "target_id": "ru-fr81-u297-r0061",
      "tag": "prose",
      "target_sha256": "eff2c6e462cd01908c7c28581f7b5030e0e82deca73dc5141aa52d5a60a0b904"
    },
    {
      "source_id": "fr81-u297-r0062",
      "target": "— И поторапливайтесь, господин Как-вас-там, раз мамзель Как-её-там ждёт.",
      "source_sha256": "de30598c9c08442cb4aabe86754331b83aa3d6660f89d585569111cfab9eba31",
      "target_id": "ru-fr81-u297-r0062",
      "tag": "prose",
      "target_sha256": "09f920ba3b6c860035cc9a93aa67844af54556b90cc2eb649ed15c4f500ff715"
    },
    {
      "source_id": "fr81-u297-r0063",
      "target": "Гаврош остался доволен тем, что отпустил такое словцо.",
      "source_sha256": "acb07d97ee7f79c3a4f9b424e7ce40d9f0cbf5bd830fb7ce12ddb1fb63e2bbab",
      "target_id": "ru-fr81-u297-r0063",
      "tag": "prose",
      "target_sha256": "6781dca7850e3e4502cbad9504faaa322be2ed4133c4eba3cf1c9479282ca455"
    }
  ],
