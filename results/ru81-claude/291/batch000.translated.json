{
  "unit": 291,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u291-h",
      "target": "III. Гаврошу лучше было бы принять карабин Анжольраса",
      "source_sha256": "26206e9b1d978f420e8f6fcf0d506e0a0ff8f84d609d8d84f04c09735fdf97c0",
      "target_id": "ru-fr81-u291-h",
      "tag": "heading",
      "target_sha256": "105d2bf122fb3ad34cd398e8d7c2cf257389d23f4c7664b2411a59d83a124e42"
    },
    {
      "source_id": "fr81-u291-r0001",
      "target": "На папашу Мабёфа набросили длинную чёрную шаль вдовы Юшлу. Шестеро мужчин сделали из своих ружей носилки, положили на них тело и понесли его с непокрытыми головами, с торжественной медлительностью, на большой стол нижней залы.",
      "source_sha256": "abe745edd2313fa8ec5859b9ef58b14dac5d68d1c30692660e2fefa810ddb41b",
      "target_id": "ru-fr81-u291-r0001",
      "tag": "prose",
      "target_sha256": "7c86d3d43c833eb62e88cb5e30778dbc48ab3f120146547d7039f764ac9291aa"
    },
    {
      "source_id": "fr81-u291-r0002",
      "target": "Эти люди, целиком поглощённые важным и священным делом, которое они совершали, больше не думали об опасном положении, в каком находились.",
      "source_sha256": "54367334ee4a9d0b40eeb18286edeeb6ee526976c7d61ad80d0b2b3a503fa2c1",
      "target_id": "ru-fr81-u291-r0002",
      "tag": "prose",
      "target_sha256": "efdca953d5f99bc26ed3c0f6b3f25d56d76ee8de17f72b0796ef3978c62b2c7c"
    },
    {
      "source_id": "fr81-u291-r0003",
      "target": "Когда тело проносили мимо Жавера, по-прежнему невозмутимого, Анжольрас сказал шпиону:",
      "source_sha256": "dc4198970c47a88312ea22405eaa200df04595ee24f0945c5cb12bbb54acb20e",
      "target_id": "ru-fr81-u291-r0003",
      "tag": "prose",
      "target_sha256": "5f737a3703909cc48d5fe1876e1f4e639cb5df8d56dc4e84d72831dbe1981b5b"
    },
    {
      "source_id": "fr81-u291-r0004",
      "target": "— С тобой — сейчас же.",
      "source_sha256": "653a80ad856dfecb2313a3fdbddadcaf77647fd889e0f8e707964a2b1705f7c6",
      "target_id": "ru-fr81-u291-r0004",
      "tag": "prose",
      "target_sha256": "fb93f6ba8080889a9d723b39140ee81b43b68017cdba426ff592a19578a3b0ff"
    },
    {
      "source_id": "fr81-u291-r0005",
      "target": "Тем временем маленький Гаврош, единственный, кто не покинул своего поста и остался наблюдать, заметил, как ему показалось, людей, крадущихся к баррикаде. Вдруг он закричал:",
      "source_sha256": "9ec802240b7cd6917dfd993b6a39115d3e774d10ae53fe5dd94a576f35a89f2d",
      "target_id": "ru-fr81-u291-r0005",
      "tag": "prose",
      "target_sha256": "2034e36a457656ea8b82d1a6a4dbf04b964ca1445f4ccb64f7ea0c54b503be40"
    },
    {
      "source_id": "fr81-u291-r0006",
      "target": "— Берегитесь!",
      "source_sha256": "c9a6109be75adf084bd10ef0627075045d8a606702ce5bfaec232eeddfa96f16",
      "target_id": "ru-fr81-u291-r0006",
      "tag": "prose",
      "target_sha256": "e8bfef5e6073caf6b0a1233a190eae113aa455647d568d66bf2b321fd5b96433"
    },
    {
      "source_id": "fr81-u291-r0007",
      "target": "Курфейрак, Анжольрас, Жан Прувер, Комбефер, Жоли, Баорель, Боссюэ — все с шумом выбежали из кабачка. Времени уже почти не оставалось. Над баррикадой виднелась сверкающая густая чаща колеблющихся штыков. Рослые муниципальные гвардейцы вступали на баррикаду: одни перебирались через омнибус, другие шли через проход, оттесняя перед собой мальчишку, который отступал, но не бежал.",
      "source_sha256": "aa1759f96e703aad8ad6fd6786a5cc4ae76600c5d528d0cf589692a9b9adcf50",
      "target_id": "ru-fr81-u291-r0007",
      "tag": "prose",
      "target_sha256": "3aba2872df74c4b8fc445b7f79e6c84cca4731e06baaf091a1add6ad8ad3e5d6"
    },
    {
      "source_id": "fr81-u291-r0008",
      "target": "Миг был критический. Это была та первая грозная минута наводнения, когда река поднимается вровень с насыпью и вода начинает просачиваться сквозь трещины плотины. Ещё секунда — и баррикада была бы взята.",
      "source_sha256": "4043f032d9a259b19242eb11a81daf616884b3185fe776eadb203e4b4cf487ef",
      "target_id": "ru-fr81-u291-r0008",
      "tag": "prose",
      "target_sha256": "a43d23ee79318fec4deebfed50cbf41c1e749a8ff730df0ccab69a7a10692bff"
    },
    {
      "source_id": "fr81-u291-r0009",
      "target": "Баорель бросился на первого входившего муниципального гвардейца и убил его в упор выстрелом из карабина; второй убил Баореля ударом штыка. Другой уже повалил Курфейрака, кричавшего: «Ко мне!» Самый высокий из всех, нечто вроде колосса, шёл на Гавроша со штыком наперевес. Мальчишка взял в свои маленькие руки огромное ружьё Жавера, решительно прицелился в великана и спустил курок. Выстрела не последовало. Жавер не зарядил своего ружья. Муниципальный гвардеец расхохотался и занёс штык над ребёнком.",
      "source_sha256": "1951b6b3bf490fd4695c426fd1e3fedcaf9c76ea3bbf97734877f4c2f6d651bc",
      "target_id": "ru-fr81-u291-r0009",
      "tag": "prose",
      "target_sha256": "8f024a95a759997ffcb265dc32bbf70080834d3cbbdb8e6edf2a1b7289be4658"
    },
    {
      "source_id": "fr81-u291-r0010",
      "target": "Прежде чем штык коснулся Гавроша, ружьё выпало из рук солдата, пуля поразила гвардейца в середину лба, и он упал навзничь. Вторая пуля попала прямо в грудь другому гвардейцу, напавшему на Курфейрака, и бросила его на мостовую.",
      "source_sha256": "e62cfc7506813f757c128a53a09c6c8043a9910c53e4ce4d06fae42e0ce08c58",
      "target_id": "ru-fr81-u291-r0010",
      "tag": "prose",
      "target_sha256": "3f5d002d30c1268f660c0f71626935755d35ccf463028f5deb012167db4d7eac"
    },
    {
      "source_id": "fr81-u291-r0011",
      "target": "Это Мариус только что вошёл на баррикаду.",
      "source_sha256": "60481d810fe2a6452ee94450f369bd618d34497389c83432007d655f107a825f",
      "target_id": "ru-fr81-u291-r0011",
      "tag": "prose",
      "target_sha256": "ca8b53e5112934598331095a60c2fb20d79e5940b2de9974fc5d1a889c21844a"
    }
  ],
