{
  "unit": 100,
  "heading": {
    "source_id": "fr81-u100-h",
    "target": "VII. Козетта бок о бок в темноте с незнакомцем",
    "source_sha256": "e751f7811b281ed5f61e353c4111a00c428af97f76959f5be7d50d7f0ce97c30",
    "target_id": "ru-fr81-u100-h",
    "tag": "heading",
    "target_sha256": "cc5e51ff34e3fce7743273c5b9dee22809578a2d2f54de25a036ec10b41a8adf"
  },
  "rows": [
    {
      "source_id": "fr81-u100-h",
      "target": "VII. Козетта бок о бок в темноте с незнакомцем",
      "source_sha256": "e751f7811b281ed5f61e353c4111a00c428af97f76959f5be7d50d7f0ce97c30",
      "target_id": "ru-fr81-u100-h",
      "tag": "heading",
      "target_sha256": "cc5e51ff34e3fce7743273c5b9dee22809578a2d2f54de25a036ec10b41a8adf"
    },
    {
      "source_id": "fr81-u100-r0001",
      "target": "Козетта, как мы уже сказали, не испугалась.",
      "source_sha256": "f257a26b07e9b4e7edcd5fc087c486fc60059ae2b44b9c96b8cb0ff109c5e0c5",
      "target_id": "ru-fr81-u100-r0001",
      "tag": "prose",
      "target_sha256": "eb40cc1e3026c8e05f54d21d70874d02983f2e3a3febd09cb6ef091c2744bc3c"
    },
    {
      "source_id": "fr81-u100-r0002",
      "target": "Мужчина заговорил с нею. Голос у него был серьёзный, почти приглушённый.",
      "source_sha256": "836d8b7699ebb3940bd3cb789787bf61b19cb3fdf13e09b13c94e31ed4207608",
      "target_id": "ru-fr81-u100-r0002",
      "tag": "prose",
      "target_sha256": "dbf82003a440c6ebb03a85d237b9334b364f35c6f92af7c7d7353ae984185be0"
    },
    {
      "source_id": "fr81-u100-r0003",
      "target": "— Дитя моё, то, что вы несёте, очень тяжело для вас.",
      "source_sha256": "34caa9bed73dd5b2904d659ccfbdcac2ac20d5c80ea1cff36eb178993e1c49bd",
      "target_id": "ru-fr81-u100-r0003",
      "tag": "prose",
      "target_sha256": "7141d88ab8eadafb6c60604ee7e428c21d029c21d682f967a261b5b33a230487"
    },
    {
      "source_id": "fr81-u100-r0004",
      "target": "Козетта подняла голову и ответила:",
      "source_sha256": "14031c1b987a4fbed9d1d9ee28b2e07eadf3261ce109178aeb7c634153757318",
      "target_id": "ru-fr81-u100-r0004",
      "tag": "prose",
      "target_sha256": "b25bcb08dc7a50db6164dcdcebe0f2c10ac3ec42d1e9472782036f1b6e6dea0c"
    },
    {
      "source_id": "fr81-u100-r0005",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u100-r0005",
      "tag": "prose",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "fr81-u100-r0006",
      "target": "— Дайте, — продолжал мужчина, — я понесу его за вас.",
      "source_sha256": "94c3691f60bb61533e19c3e8d6ac21ba997621e7f4c8e18b580cc941ec80463d",
      "target_id": "ru-fr81-u100-r0006",
      "tag": "prose",
      "target_sha256": "84a21c9386918cacd435241d392907c7b18d614dc79057a231b3c0b352dd177d"
    },
    {
      "source_id": "fr81-u100-r0007",
      "target": "Козетта выпустила ведро. Мужчина зашагал рядом с нею.",
      "source_sha256": "e685b944ed5dbdc685fb4c82c40a9f6a8608695c47f6d9b0246ba4d323127878",
      "target_id": "ru-fr81-u100-r0007",
      "tag": "prose",
      "target_sha256": "93882a1192d1df1417c841e80f5ce9fc6e277ddfe02d71c3592e2981e2b6b077"
    },
    {
      "source_id": "fr81-u100-r0008",
      "target": "— Да, и в самом деле очень тяжело, — проговорил он сквозь зубы. Затем добавил:",
      "source_sha256": "866700a9e518222df7e87e729ac36aed9d92df385e673805d71a54ce6b5a2b65",
      "target_id": "ru-fr81-u100-r0008",
      "tag": "prose",
      "target_sha256": "16c2f9369419bb9f065460dec4792c17ad48621b19802615254e17ee8a06a9f7"
    },
    {
      "source_id": "fr81-u100-r0009",
      "target": "— Малышка, сколько тебе лет?",
      "source_sha256": "25ce939ab7a61b2189b69304cf441e667ea114fa8addf4fde3d8be9be6d941a4",
      "target_id": "ru-fr81-u100-r0009",
      "tag": "prose",
      "target_sha256": "8513295e3de884729e35ea6d3591496b2569872df756afb8509e1e25e5784e30"
    },
    {
      "source_id": "fr81-u100-r0010",
      "target": "— Восемь, сударь.",
      "source_sha256": "6abccdaeb0d5bc7128747c5c815302b5baaad16145932b8aa8288d089f4836fd",
      "target_id": "ru-fr81-u100-r0010",
      "tag": "prose",
      "target_sha256": "e44fa7a1aff05f019e03c12f4c7af5963adca4d80dfd99d0b40ac8ce6b5306f9"
    },
    {
      "source_id": "fr81-u100-r0011",
      "target": "— И ты вот так издалека идёшь?",
      "source_sha256": "558b45793404049fe6bff153c56750a9b2703b6dfa3d467e2bbb187658d80fd2",
      "target_id": "ru-fr81-u100-r0011",
      "tag": "prose",
      "target_sha256": "1451ce67cebdf51c950bbff011fc869205b4c5ad61aa0a7c32b7f15f1caddfde"
    },
    {
      "source_id": "fr81-u100-r0012",
      "target": "— От источника, что в лесу.",
      "source_sha256": "9528d99cb006af77fd6a0600ef9d26ca71ad24223878a372a928c8143500c642",
      "target_id": "ru-fr81-u100-r0012",
      "tag": "prose",
      "target_sha256": "7ffd8b372e8f21dbeecf02f50231a2c541228816d5494e12df0f6657a14ede8c"
    },
    {
      "source_id": "fr81-u100-r0013",
      "target": "— А далеко ли то место, куда ты идёшь?",
      "source_sha256": "0d4a800260032e0b46e9a63034f81e780deec0c266434cb4b3c3c99a2aec0f88",
      "target_id": "ru-fr81-u100-r0013",
      "tag": "prose",
      "target_sha256": "51247bde53f09efccaece855eb838fdf7b19cbdb7f0a4f16c1c510bacf5c777a"
    },
    {
      "source_id": "fr81-u100-r0014",
      "target": "— Добрая четверть часа отсюда.",
      "source_sha256": "4bb6c8ff3f4984d0bcb1298d75077b6a01f4e819c6dbf0804cc63b5eccb76b8b",
      "target_id": "ru-fr81-u100-r0014",
      "tag": "prose",
      "target_sha256": "f434f82e3e055e9bc68c4d8e3e8b7e1b041c467ee96d63690c6f70b62d73cff1"
    },
    {
      "source_id": "fr81-u100-r0015",
      "target": "Мужчина некоторое время молчал, потом вдруг сказал:",
      "source_sha256": "0ad7dc301facb7e101fee3c00409ec153077c9edde27ebec538cf92b9ac0f580",
      "target_id": "ru-fr81-u100-r0015",
      "tag": "prose",
      "target_sha256": "69e044fc2bf847992f618934ccb972087af63cb1aed10a48e3b633e05364fc67"
    },
    {
      "source_id": "fr81-u100-r0016",
      "target": "— Так у тебя нет матери?",
      "source_sha256": "ed5f2468fd421f8bbaf01df4d5dcf56579b519619fd0b3b6fbc58b30fa0922c0",
      "target_id": "ru-fr81-u100-r0016",
      "tag": "prose",
      "target_sha256": "65a9acf6ff2bfc307e0fd0ddbdfa1b1fc603d298f882a28a902deeb7f0b1517d"
    },
    {
      "source_id": "fr81-u100-r0017",
      "target": "— Не знаю, — ответила девочка.",
      "source_sha256": "33e845cbeda87936bf218979b2fedd643553114b72e535f6cd66b26cb60ebb00",
      "target_id": "ru-fr81-u100-r0017",
      "tag": "prose",
      "target_sha256": "35677018295793f8b5baf4d44e3e424468131bd85491fb5346a915534612c065"
    },
    {
      "source_id": "fr81-u100-r0018",
      "target": "Прежде чем мужчина успел заговорить снова, она добавила:",
      "source_sha256": "7b73cb3e1efaef2f4fd83f523c8102d058296dc3b1b9b40d9c64bb074fb0e55e",
      "target_id": "ru-fr81-u100-r0018",
      "tag": "prose",
      "target_sha256": "9e7f88946b87f18945f937962a48a3ef670ef50cff7d8490591e9038524d1acc"
    },
    {
      "source_id": "fr81-u100-r0019",
      "target": "— Кажется, нет. У других есть. А у меня нет.",
      "source_sha256": "989c0852858c68355083031e463fa389e5cfa57646d9f1bf502ed4796f91d96f",
      "target_id": "ru-fr81-u100-r0019",
      "tag": "prose",
      "target_sha256": "1e914cddf407621627ca0b574cadf3fbcdbe8af2438f70f1fbc02408cdd6fcaf"
    },
    {
      "source_id": "fr81-u100-r0020",
      "target": "И после молчания продолжала:",
      "source_sha256": "90232dc9a645cab51241f2e88c9cc85304e42204c5010bb6c45ee8dd7cd2c83e",
      "target_id": "ru-fr81-u100-r0020",
      "tag": "prose",
      "target_sha256": "074064d8b2bc79c7121438e1e1916f5eeaeab0d8bcb3b247d22b7345997b4be7"
    },
    {
      "source_id": "fr81-u100-r0021",
      "target": "— Думаю, что у меня её никогда и не было.",
      "source_sha256": "466edf0b8354f14b9849336c83e326b665a05907f3c098c3add75b39723cd31c",
      "target_id": "ru-fr81-u100-r0021",
      "tag": "prose",
      "target_sha256": "2ed669e4767692944ca2dba3deb78ce93c937c11f3f0e002e15b7804dfd8cdd8"
    },
    {
      "source_id": "fr81-u100-r0022",
      "target": "Мужчина остановился, поставил ведро на землю, наклонился и положил обе руки на плечи ребёнка, стараясь разглядеть её и увидеть её лицо в темноте.",
      "source_sha256": "af5d595fe729fea3b6bc44b2f9d84273b82e87da9e69d2bf5b61b15c71e6c35f",
      "target_id": "ru-fr81-u100-r0022",
      "tag": "prose",
      "target_sha256": "d8301e5a87f0bad82a7db86361e2b8fd84fc39c04ae79a6461f293c86cfd1138"
    },
    {
      "source_id": "fr81-u100-r0023",
      "target": "Худое, хилое личико Козетты смутно вырисовывалось в мертвенном свете неба.",
      "source_sha256": "fb422d1e06bdf5487127a6d54b9b07baeadcf9e830fd041fa13f9be3aa6a5d66",
      "target_id": "ru-fr81-u100-r0023",
      "tag": "prose",
      "target_sha256": "1f83239c18e3cc0750c276dceccfd81f504f56427496d76bf1c4df578576148d"
    },
    {
      "source_id": "fr81-u100-r0024",
      "target": "— Как тебя зовут?",
      "source_sha256": "f852aa85ea3496e775461dbf147174dfdf0a4cdfc5faf9b035caeeb6ec123b9e",
      "target_id": "ru-fr81-u100-r0024",
      "tag": "prose",
      "target_sha256": "233319ba9a10b3ee292978d4f56744f35cf78526be8db73a05961494aaab21a8"
    },
    {
      "source_id": "fr81-u100-r0025",
      "target": "— Козетта.",
      "source_sha256": "fac6c5bda5e83ed048bf777d46cbc35133071df9a8cb9e9ac3ac9206f7f4caa7",
      "target_id": "ru-fr81-u100-r0025",
      "tag": "prose",
      "target_sha256": "335c8a6320778ec34c990c718cc0122cc966b9081aa9e6fb52072b5ebd7d2317"
    },
    {
      "source_id": "fr81-u100-r0026",
      "target": "Мужчину будто пронзило электрическим ударом. Он ещё раз взглянул на неё, потом снял руки с плеч Козетты, взял ведро и снова пошёл.",
      "source_sha256": "d62e63b97021f1b618a4bbf016b8d901fb59df9c3e1babc4d54d6ef233e9dd47",
      "target_id": "ru-fr81-u100-r0026",
      "tag": "prose",
      "target_sha256": "c3503975e8075dfb60a88b367004aa7ad6000f63f96ed98597ac7ee46202d3a0"
    },
    {
      "source_id": "fr81-u100-r0027",
      "target": "Спустя мгновение он спросил:",
      "source_sha256": "c6d0c5b6f2fb1a640fb5b8093de2efcd0466bdf60247da0bf1d9b5dd882dc3a4",
      "target_id": "ru-fr81-u100-r0027",
      "tag": "prose",
      "target_sha256": "8431cdf0ca08e4f5ea87dad982dbf62266882bc9cfdd0ce3ae17f7aa3ec42f69"
    },
    {
      "source_id": "fr81-u100-r0028",
      "target": "— Малышка, где ты живёшь?",
      "source_sha256": "5d9dcbaf8052a418d2a8b8ba99a2389f7d84f6386dbdd0bdcbab01aa3791a650",
      "target_id": "ru-fr81-u100-r0028",
      "tag": "prose",
      "target_sha256": "c83f87b449cc97b938d53f30790336c5f107a6324a9b108515ed0a6009c36e2a"
    },
    {
      "source_id": "fr81-u100-r0029",
      "target": "— В Монфермейле, если вы знаете такое место.",
      "source_sha256": "956ea9eb703e6c0693c2857d6c01df22716f7b142591d9394acc22407ad3a0a7",
      "target_id": "ru-fr81-u100-r0029",
      "tag": "prose",
      "target_sha256": "fc90213e4f207c14deb1b4ae4c1cedcc211d702059de261005983239a7566897"
    },
    {
      "source_id": "fr81-u100-r0030",
      "target": "— Мы туда и идём?",
      "source_sha256": "a6392ba940d4506bdc77717ff26a1ebee40c1f0ecf6614dad2ebf793c1e6cd0f",
      "target_id": "ru-fr81-u100-r0030",
      "tag": "prose",
      "target_sha256": "b3666c2d7f87724aa7d78d08bfe31204caf7062934064a41ac99e6165fa05e4c"
    },
    {
      "source_id": "fr81-u100-r0031",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u100-r0031",
      "tag": "prose",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "fr81-u100-r0032",
      "target": "Он помолчал ещё немного, потом начал снова:",
      "source_sha256": "7db3b1629c8e901fcb13c1dce951529c74e654de907b20dcf89099ff22ca7967",
      "target_id": "ru-fr81-u100-r0032",
      "tag": "prose",
      "target_sha256": "282e85d9d6f3da79a0641c026a9e4c89125dfee66660a18f83fd152fccba2f93"
    },
    {
      "source_id": "fr81-u100-r0033",
      "target": "— Кто же это послал тебя в такой час за водой в лес?",
      "source_sha256": "63f4fdc81044157b48975afdadf22a90f52eef2a356cc82d495d8f4c17076371",
      "target_id": "ru-fr81-u100-r0033",
      "tag": "prose",
      "target_sha256": "3aa61a2d956112147fa5c1f10aadda6341cf594ae2f9332471dc379d9257e664"
    },
    {
      "source_id": "fr81-u100-r0034",
      "target": "— Госпожа Тенардье.",
      "source_sha256": "70bc8e8f3f5f5330b458df5ecdaae8a731f71577f9d9eff87ab2992b38e7cdd5",
      "target_id": "ru-fr81-u100-r0034",
      "tag": "prose",
      "target_sha256": "596ab39c57b87eda34a01c6a22df96260f48a7725dd1a54fc5a95d127cc89c01"
    },
    {
      "source_id": "fr81-u100-r0035",
      "target": "Мужчина отозвался голосом, который он старался сделать равнодушным, но в котором всё же слышалась странная дрожь:",
      "source_sha256": "71c42086dfa21c4a0c6831d5c6094f01d1a702f5a5203912fb913bf7e0bc61d3",
      "target_id": "ru-fr81-u100-r0035",
      "tag": "prose",
      "target_sha256": "7824b0b7ce4c80cbf6086a46eca71ec854eb98d8277a5a558d0950dbdba69834"
    },
    {
      "source_id": "fr81-u100-r0036",
      "target": "— А что она делает, твоя госпожа Тенардье?",
      "source_sha256": "ad9266217e10800313ac67d931a1bdb5c79155e00666d3c9d6eff99f15ed695c",
      "target_id": "ru-fr81-u100-r0036",
      "tag": "prose",
      "target_sha256": "96a5de654ce6d25524d3047b3719999ab167c08345c9a3f99c383591d9ec7f0b"
    },
    {
      "source_id": "fr81-u100-r0037",
      "target": "— Она моя хозяйка, — сказал ребёнок. — Она держит трактир.",
      "source_sha256": "04a67907fd8df69b23c646a9b8e56fbe60baea4bf7df63450c1ea3dc0880a9e1",
      "target_id": "ru-fr81-u100-r0037",
      "tag": "prose",
      "target_sha256": "a84a25b18d08974e32f11062f7658ba43d48b0536a97ab805caae84383fcf707"
    },
    {
      "source_id": "fr81-u100-r0038",
      "target": "— Трактир? — переспросил мужчина. — Что ж, я переночую там нынче. Веди меня.",
      "source_sha256": "11fb6dbb51852718bbce160ff0a8b427506c26f386007203196511fa5122a427",
      "target_id": "ru-fr81-u100-r0038",
      "tag": "prose",
      "target_sha256": "4c27f09f6776b0497021d67af7723b36bd5b4e7d8f717521fd37938c0f28236b"
    },
    {
      "source_id": "fr81-u100-r0039",
      "target": "— Мы туда и идём, — сказал ребёнок.",
      "source_sha256": "7335b4e270df6a318b669c34b75ebdcc4f8c08ba1acb6904d5cceec553da4084",
      "target_id": "ru-fr81-u100-r0039",
      "tag": "prose",
      "target_sha256": "c72ca60d6c5f42d09a57e73e40475f6192312bb2f58498b120b433a505fd15d2"
    },
    {
      "source_id": "fr81-u100-r0040",
      "target": "Мужчина шёл довольно быстро. Козетта без труда поспевала за ним. Усталости она больше не чувствовала. Время от времени она поднимала глаза на этого человека с каким-то спокойствием и невыразимой доверчивостью. Её никогда не учили обращаться к провидению и молиться. Однако она ощущала в себе нечто похожее на надежду и радость, и это нечто уходило ввысь, к небу.",
      "source_sha256": "ced684804592f9c5d3b9dd37eb87e680001bfece40661181659dbc8d71edf8db",
      "target_id": "ru-fr81-u100-r0040",
      "tag": "prose",
      "target_sha256": "aea10026f046bef211d9ee473b6cdeace5f7a291a6ac4555b7f1f44b808cbcff"
    },
    {
      "source_id": "fr81-u100-r0041",
      "target": "Прошло несколько минут. Мужчина заговорил опять:",
      "source_sha256": "7534ca5690a60ff1dae6c0f6d7a87252ab6ad2f72abacfbcd3868c00f2560272",
      "target_id": "ru-fr81-u100-r0041",
      "tag": "prose",
      "target_sha256": "8d7fe5d7ede3846944ead6f8aec9f0899c831ddbb25044bbdf147c27eef1044c"
    },
    {
      "source_id": "fr81-u100-r0042",
      "target": "— Разве у госпожи Тенардье нет служанки?",
      "source_sha256": "b33ad60aa943dc16fada956867c43f99979297c3e016ab940fd2987ce24723b7",
      "target_id": "ru-fr81-u100-r0042",
      "tag": "prose",
      "target_sha256": "61097370491500b7569cb8de26119e173114d9978b5dd807dd6ac74b42091857"
    },
    {
      "source_id": "fr81-u100-r0043",
      "target": "— Нет, сударь.",
      "source_sha256": "17ae79b5fe3ff4a7c72562c7e47cad81a393b024ec4f88955f17157b2af5f187",
      "target_id": "ru-fr81-u100-r0043",
      "tag": "prose",
      "target_sha256": "285b832236d3f00bef4837f034431576c8ec0c9d849c8a628903d1d236e208f2"
    },
    {
      "source_id": "fr81-u100-r0044",
      "target": "— Ты там одна?",
      "source_sha256": "7a95ebad0138396979b41d61292facff2993de4985a89c05756ff593ad9ac8b4",
      "target_id": "ru-fr81-u100-r0044",
      "tag": "prose",
      "target_sha256": "c003f6f035a81f4d1a3ea3222f982527b86250dce06248866480ad8c4b8d79f9"
    },
    {
      "source_id": "fr81-u100-r0045",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u100-r0045",
      "tag": "prose",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "fr81-u100-r0046",
      "target": "Снова наступила пауза. Козетта возвысила голос:",
      "source_sha256": "39ee23bdace6fcdff93708863b5d9000aeb46bf789706a3a4a3eeba3d9defc04",
      "target_id": "ru-fr81-u100-r0046",
      "tag": "prose",
      "target_sha256": "f4f62b7291045ab4fa7160b1d4f426c6418acdf0c97566d35e7b7c688a77350e"
    },
    {
      "source_id": "fr81-u100-r0047",
      "target": "— То есть там ещё две девочки.",
      "source_sha256": "f627bc51d0b8273b5839df7acdf5f64dda7fc4ae0b6e3234d530b232aa70f552",
      "target_id": "ru-fr81-u100-r0047",
      "tag": "prose",
      "target_sha256": "530d6821f93f63bab9c8b9d277bb28ba5741b17cb0ccc5cef9b10b01f6443de9"
    },
    {
      "source_id": "fr81-u100-r0048",
      "target": "— Какие девочки?",
      "source_sha256": "17d615bf2be7149af5985a75455f554f43ede4425ddb61d81a30a0ae33e7ab86",
      "target_id": "ru-fr81-u100-r0048",
      "tag": "prose",
      "target_sha256": "0abeb7d1505cd030418b98184ea8149fb3d36a37a21449ef3ce4ad5fd81535ee"
    },
    {
      "source_id": "fr81-u100-r0049",
      "target": "— Понина и Зельма.",
      "source_sha256": "4029fdad2739de792273de40daa57d19cbd9c840146af95705a38ac3a7d2a7f9",
      "target_id": "ru-fr81-u100-r0049",
      "tag": "prose",
      "target_sha256": "61bd34cfe417c31f4533be4026809ff6d8e8d4403ef431508bcebb898a611f48"
    },
    {
      "source_id": "fr81-u100-r0050",
      "target": "Так ребёнок упрощал романтические имена, столь любимые Тенардье.",
      "source_sha256": "512362342592bbbc13d30e846b66b4f8b22f041d55567ce33977aa5d58ec812f",
      "target_id": "ru-fr81-u100-r0050",
      "tag": "prose",
      "target_sha256": "f737d17cb28d54fdd6ca642be462d54913c83c54d858e542fb4cf530d465e24d"
    },
    {
      "source_id": "fr81-u100-r0051",
      "target": "— Кто такие Понина и Зельма?",
      "source_sha256": "e8f0a1da3dd4010139f4421b84aaf9c860d9ce0ef2731821968dfba7263fa3d6",
      "target_id": "ru-fr81-u100-r0051",
      "tag": "prose",
      "target_sha256": "a11eb808f3d6b6a60557d46bcfd5cb77032e37e66cb6497515418d62e1bb253f"
    },
    {
      "source_id": "fr81-u100-r0052",
      "target": "— Это барышни госпожи Тенардье. Вроде как её дочки.",
      "source_sha256": "266a91dbf574406548d3287aefd9087920c140689e246818ac731bb7a211090f",
      "target_id": "ru-fr81-u100-r0052",
      "tag": "prose",
      "target_sha256": "92ab697119d4173a8edfb9eb26b576db598f9c478ddff82189808d33a929751f"
    },
    {
      "source_id": "fr81-u100-r0053",
      "target": "— А что они делают?",
      "source_sha256": "56e06c1087f9bda8f69501f92d2fcceb8ed1f63ee974c033613426cf70712e9b",
      "target_id": "ru-fr81-u100-r0053",
      "tag": "prose",
      "target_sha256": "c2e38c05b64c57aedc4c7187387517dca04cae2bb0c1fb94b1054adc94af4a40"
    },
    {
      "source_id": "fr81-u100-r0054",
      "target": "— Ох! — сказал ребёнок. — У них красивые куклы, вещицы с золотом, всяких игрушек полно. Они играют, развлекаются.",
      "source_sha256": "bff86549baec55ac83410d3f35ca4a6452c3dccdf31635644d1bbcdaf62ba3ca",
      "target_id": "ru-fr81-u100-r0054",
      "tag": "prose",
      "target_sha256": "7f6c8d53aefbec83d77cef69b06411dcac87f894e54cd98865c49b68541bc0df"
    },
    {
      "source_id": "fr81-u100-r0055",
      "target": "— Целый день?",
      "source_sha256": "9ed9a0f4dfd8a873bebbf2ae78da4a000976e595eba3168a2bbd8104d29a4042",
      "target_id": "ru-fr81-u100-r0055",
      "tag": "prose",
      "target_sha256": "0056d6785bfd626cad24af474d5513da64df888d9b4c1a67fd2f037750916eb3"
    },
    {
      "source_id": "fr81-u100-r0056",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u100-r0056",
      "tag": "prose",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "fr81-u100-r0057",
      "target": "— А ты?",
      "source_sha256": "f85507006c5f81ab8ce779049df8a3cb43fa2ce982bb39b1e84f459cc782e19c",
      "target_id": "ru-fr81-u100-r0057",
      "tag": "prose",
      "target_sha256": "a866e239a61f2730f33fb15c035559ba6e2fef194b08a6f1522adff4d6e6e24e"
    },
    {
      "source_id": "fr81-u100-r0058",
      "target": "— Я работаю.",
      "source_sha256": "86f00e998b270e67d506c772f5dfb6a041bd36d88ad486d90b6e4ee5537652ce",
      "target_id": "ru-fr81-u100-r0058",
      "tag": "prose",
      "target_sha256": "ff30d55dcb06b7d60c2bc533feabb11fb7d1fd8a7841a9f8379ae42db69693ef"
    },
    {
      "source_id": "fr81-u100-r0059",
      "target": "— Целый день?",
      "source_sha256": "9ed9a0f4dfd8a873bebbf2ae78da4a000976e595eba3168a2bbd8104d29a4042",
      "target_id": "ru-fr81-u100-r0059",
      "tag": "prose",
      "target_sha256": "0056d6785bfd626cad24af474d5513da64df888d9b4c1a67fd2f037750916eb3"
    },
    {
      "source_id": "fr81-u100-r0060",
      "target": "Ребёнок поднял свои большие глаза, в которых стояла слеза, незаметная из-за ночной темноты, и тихо ответил:",
      "source_sha256": "47b465ad5676885e137ad6fb87fddcafdb2106c2e99079636933770d22c06bf0",
      "target_id": "ru-fr81-u100-r0060",
      "tag": "prose",
      "target_sha256": "d2b1a38e8bf1267f6c097384be4ca765bdeb040b757bc621f7f05f97172e2319"
    },
    {
      "source_id": "fr81-u100-r0061",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u100-r0061",
      "tag": "prose",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "fr81-u100-r0062",
      "target": "После минутного молчания она продолжала:",
      "source_sha256": "9bddfa0e422dff7ec0932712da2a7270f538050c31f97c95d8511eb8e07ef632",
      "target_id": "ru-fr81-u100-r0062",
      "tag": "prose",
      "target_sha256": "673dd8e9f54c1b4cf5dd40ba54f718b22a54c67f48ae6b39bdec807f0feef738"
    },
    {
      "source_id": "fr81-u100-r0063",
      "target": "— Иногда, когда я кончу работу и мне позволят, я тоже играю.",
      "source_sha256": "4f748e69af8b45c665e7645685a8f6f688c48e6ca8b0300d4ceb8a99009daa9b",
      "target_id": "ru-fr81-u100-r0063",
      "tag": "prose",
      "target_sha256": "f15621a4f517b2180b7c44f1131527050f6fd8d9fb753d4105429859a409bb86"
    },
    {
      "source_id": "fr81-u100-r0064",
      "target": "— Как же ты забавляешься?",
      "source_sha256": "a12d9cd5986e60b0b2fd4b2cf5a8ff3e720cb62699fbc244376a2a7b4f8489e3",
      "target_id": "ru-fr81-u100-r0064",
      "tag": "prose",
      "target_sha256": "864370fb63f4814ddfced45e24a221f408972716a2859dfb34f34b692fac1aff"
    },
    {
      "source_id": "fr81-u100-r0065",
      "target": "— Как могу. Мне позволяют. Только игрушек у меня почти нет: Понина и Зельма не хотят, чтобы я играла с их куклами. У меня есть только маленькая свинцовая сабля, вот такая, не длиннее этого.",
      "source_sha256": "b96a17b7bdd9c13669b714f1da3059357cec1dd5029f2378462ad34506de580d",
      "target_id": "ru-fr81-u100-r0065",
      "tag": "prose",
      "target_sha256": "a0b7716d1a29d5332e879b04c5e1d30c4da75b285e86e3a860e56a3cec1e1ba4"
    },
    {
      "source_id": "fr81-u100-r0066",
      "target": "Девочка показала свой мизинец.",
      "source_sha256": "223836f36c24aa1edaa56e39020405c1e2ff4e989ca3e1b15d7c7414523bdf5e",
      "target_id": "ru-fr81-u100-r0066",
      "tag": "prose",
      "target_sha256": "7fb57cae3cea924d54a4de314a819dd74753a259750377d12502c7714d016a89"
    },
    {
      "source_id": "fr81-u100-r0067",
      "target": "— И которая не режет?",
      "source_sha256": "9bb770dd0455855caf5a23a3b08499e2e3dca4455eccf2548de0fa0ebcf5dfc6",
      "target_id": "ru-fr81-u100-r0067",
      "tag": "prose",
      "target_sha256": "a55bf80b29e1ac282cee6fb144d3f12bed5b4955582310637cbf97dedc6f590f"
    },
    {
      "source_id": "fr81-u100-r0068",
      "target": "— Нет, сударь, режет, — сказала девочка, — она режет салат и мушиные головки.",
      "source_sha256": "5215d7764258702cd4ecb81e9d65c7a7135779858038aa34eed910e7b02a9c22",
      "target_id": "ru-fr81-u100-r0068",
      "tag": "prose",
      "target_sha256": "6df06df9ea49b39b2152aeaacb149c59d5d95be87ba56705139a443b32fed1a9"
    },
    {
      "source_id": "fr81-u100-r0069",
      "target": "Они дошли до селения; Козетта повела незнакомца по улицам. Они прошли мимо булочной, но Козетта не вспомнила о хлебе, который ей надо было принести. Мужчина перестал расспрашивать её и теперь угрюмо молчал. Когда церковь осталась позади и он увидел все эти лавчонки под открытым небом, он спросил Козетту:",
      "source_sha256": "f5c771fcb5da29a787a5464a045be7afd7eca90b288ddb0ff47f1e86c3d289e9",
      "target_id": "ru-fr81-u100-r0069",
      "tag": "prose",
      "target_sha256": "a76bc56fefa13ed1539635962a0d79e605b1ef9fb515447e03d5be7c26587942"
    },
    {
      "source_id": "fr81-u100-r0070",
      "target": "— Что же, здесь ярмарка?",
      "source_sha256": "2cbf31eb47266981696253f457da8320c3eb170b88e68e4262f5c5a0b6e7c9b9",
      "target_id": "ru-fr81-u100-r0070",
      "tag": "prose",
      "target_sha256": "4bc834ecda4ba688f8bafbbde2d3d0c4ef0246b146107b8aff4f47a35c33dd9b"
    },
    {
      "source_id": "fr81-u100-r0071",
      "target": "— Нет, сударь, это Рождество.",
      "source_sha256": "9d1d592a544122b8ccc24169be0a9987da71aeb32fca1b71d921bd9e36383b2c",
      "target_id": "ru-fr81-u100-r0071",
      "tag": "prose",
      "target_sha256": "42e9308a7466bb15595942cf3af947fa59afbcda9808ae04442e6287049e0192"
    },
    {
      "source_id": "fr81-u100-r0072",
      "target": "Когда они приблизились к трактиру, Козетта робко коснулась его руки.",
      "source_sha256": "57d3716030298edf30871d47b1d8b539ed7cb36056d4762c50ae9df4b6105141",
      "target_id": "ru-fr81-u100-r0072",
      "tag": "prose",
      "target_sha256": "19258b9f2be54c46b7ad3f980061bc8fc7a1f94c12b2e3ebca41a49130df9bd1"
    },
    {
      "source_id": "fr81-u100-r0073",
      "target": "— Сударь?",
      "source_sha256": "e3e5511369e6d1a45ca409c9befbd68153718ec58380c91d9ec00f455b7fa0ea",
      "target_id": "ru-fr81-u100-r0073",
      "tag": "prose",
      "target_sha256": "57bb9a5293deff03b9b028e3e48b5be52d7ab370d83858306eb749929e174269"
    },
    {
      "source_id": "fr81-u100-r0074",
      "target": "— Что, дитя моё?",
      "source_sha256": "2a491e0c22dadfdff140e44925f05c2df85730313e3e730904efc242a54948dc",
      "target_id": "ru-fr81-u100-r0074",
      "tag": "prose",
      "target_sha256": "3b408f868a41259f405afd783a07c06ecb7c64874ba35d7dbb4976c7c119d282"
    },
    {
      "source_id": "fr81-u100-r0075",
      "target": "— Вот мы уже совсем близко от дома.",
      "source_sha256": "021ed86faa6eb0003daf1c673845d7253b4f2c3536488626db550892fd8a56b7",
      "target_id": "ru-fr81-u100-r0075",
      "tag": "prose",
      "target_sha256": "1f68db775384dde7fa1614a0c31cf655f5d291a8d35eeb83c745e408a7d0d8dc"
    },
    {
      "source_id": "fr81-u100-r0076",
      "target": "— Ну и что же?",
      "source_sha256": "4950a516c968f0619fb8b95afe126297c80c72d6fe6348e65ea081818635e18f",
      "target_id": "ru-fr81-u100-r0076",
      "tag": "prose",
      "target_sha256": "0372d0cc02b30b45ee0906a42a95fdac881a0e83dbb10bc95391cdd6ec02fa01"
    },
    {
      "source_id": "fr81-u100-r0077",
      "target": "— Позвольте мне теперь снова взять ведро.",
      "source_sha256": "e2641771b774a352fac1d778a8b9d071de4a6a8282487e2cf983750e9ccc6b22",
      "target_id": "ru-fr81-u100-r0077",
      "tag": "prose",
      "target_sha256": "f828c8dfc9deabf4a82d8ed3e790972231e772b40953a5f23c7a97a9e1e2279c"
    },
    {
      "source_id": "fr81-u100-r0078",
      "target": "— Почему?",
      "source_sha256": "4b5154ea331b0a88da96b0d95a9812f8ce55fa954dcfa4511479082dd555da57",
      "target_id": "ru-fr81-u100-r0078",
      "tag": "prose",
      "target_sha256": "5a7f49277ce4099a8cda575751c41cbe2652b4e11515588f5af4642c420fb08d"
    },
    {
      "source_id": "fr81-u100-r0079",
      "target": "— Потому что, если хозяйка увидит, что мне его несли, она меня побьёт.",
      "source_sha256": "da705b65b0224bec09dee89472d38827fb1a2c1fb9c699cc898af91d70d0e1ee",
      "target_id": "ru-fr81-u100-r0079",
      "tag": "prose",
      "target_sha256": "0c47576f1ffc78007a532667902c99c13777fec97cf916c9c0a7ac4a9ef57749"
    },
    {
      "source_id": "fr81-u100-r0080",
      "target": "Мужчина отдал ей ведро. Спустя мгновение они были у дверей харчевни.",
      "source_sha256": "fc2810e71300c02cc55cd432f75065fe22c6c1328273053ca59871d64af2287c",
      "target_id": "ru-fr81-u100-r0080",
      "tag": "prose",
      "target_sha256": "24500ac1cb9373496c31f51a6d22ee692a029c2b33a7b756a5851189a8ad0e20"
    }
  ],
