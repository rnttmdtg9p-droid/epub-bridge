{
  "unit": 100,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u100-h",
      "target": "VII. Козетта бок о бок в темноте с незнакомцем",
      "source_sha256": "e751f7811b281ed5f61e353c4111a00c428af97f76959f5be7d50d7f0ce97c30",
      "target_id": "ru-fr81-u100-h",
      "tag": "heading",
      "target_sha256": "cc5e51ff34e3fce7743273c5b9dee22809578a2d2f54de25a036ec10b41a8adf"
    },
    {
      "source_id": "fr81-u100-r0001",
      "target": "Козетта, как мы уже сказали, не испугалась.",
      "source_sha256": "f257a26b07e9b4e7edcd5fc087c486fc60059ae2b44b9c96b8cb0ff109c5e0c5",
      "target_id": "ru-fr81-u100-r0001",
      "tag": "prose",
      "target_sha256": "eb40cc1e3026c8e05f54d21d70874d02983f2e3a3febd09cb6ef091c2744bc3c"
    },
    {
      "source_id": "fr81-u100-r0002",
      "target": "Мужчина заговорил с нею. Голос у него был серьёзный, почти приглушённый.",
      "source_sha256": "836d8b7699ebb3940bd3cb789787bf61b19cb3fdf13e09b13c94e31ed4207608",
      "target_id": "ru-fr81-u100-r0002",
      "tag": "prose",
      "target_sha256": "dbf82003a440c6ebb03a85d237b9334b364f35c6f92af7c7d7353ae984185be0"
    },
    {
      "source_id": "fr81-u100-r0003",
      "target": "— Дитя моё, то, что вы несёте, очень тяжело для вас.",
      "source_sha256": "34caa9bed73dd5b2904d659ccfbdcac2ac20d5c80ea1cff36eb178993e1c49bd",
      "target_id": "ru-fr81-u100-r0003",
      "tag": "prose",
      "target_sha256": "7141d88ab8eadafb6c60604ee7e428c21d029c21d682f967a261b5b33a230487"
    },
    {
      "source_id": "fr81-u100-r0004",
      "target": "Козетта подняла голову и ответила:",
      "source_sha256": "14031c1b987a4fbed9d1d9ee28b2e07eadf3261ce109178aeb7c634153757318",
      "target_id": "ru-fr81-u100-r0004",
      "tag": "prose",
      "target_sha256": "b25bcb08dc7a50db6164dcdcebe0f2c10ac3ec42d1e9472782036f1b6e6dea0c"
    },
    {
      "source_id": "fr81-u100-r0005",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u100-r0005",
      "tag": "prose",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "fr81-u100-r0006",
      "target": "— Дайте, — продолжал мужчина, — я понесу его за вас.",
      "source_sha256": "94c3691f60bb61533e19c3e8d6ac21ba997621e7f4c8e18b580cc941ec80463d",
      "target_id": "ru-fr81-u100-r0006",
      "tag": "prose",
      "target_sha256": "84a21c9386918cacd435241d392907c7b18d614dc79057a231b3c0b352dd177d"
    },
    {
      "source_id": "fr81-u100-r0007",
      "target": "Козетта выпустила ведро. Мужчина зашагал рядом с нею.",
      "source_sha256": "e685b944ed5dbdc685fb4c82c40a9f6a8608695c47f6d9b0246ba4d323127878",
      "target_id": "ru-fr81-u100-r0007",
      "tag": "prose",
      "target_sha256": "93882a1192d1df1417c841e80f5ce9fc6e277ddfe02d71c3592e2981e2b6b077"
    },
    {
      "source_id": "fr81-u100-r0008",
      "target": "— Да, и в самом деле очень тяжело, — проговорил он сквозь зубы. Затем добавил:",
      "source_sha256": "866700a9e518222df7e87e729ac36aed9d92df385e673805d71a54ce6b5a2b65",
      "target_id": "ru-fr81-u100-r0008",
      "tag": "prose",
      "target_sha256": "16c2f9369419bb9f065460dec4792c17ad48621b19802615254e17ee8a06a9f7"
    },
    {
      "source_id": "fr81-u100-r0009",
      "target": "— Малышка, сколько тебе лет?",
      "source_sha256": "25ce939ab7a61b2189b69304cf441e667ea114fa8addf4fde3d8be9be6d941a4",
      "target_id": "ru-fr81-u100-r0009",
      "tag": "prose",
      "target_sha256": "8513295e3de884729e35ea6d3591496b2569872df756afb8509e1e25e5784e30"
    },
    {
      "source_id": "fr81-u100-r0010",
      "target": "— Восемь, сударь.",
      "source_sha256": "6abccdaeb0d5bc7128747c5c815302b5baaad16145932b8aa8288d089f4836fd",
      "target_id": "ru-fr81-u100-r0010",
      "tag": "prose",
      "target_sha256": "e44fa7a1aff05f019e03c12f4c7af5963adca4d80dfd99d0b40ac8ce6b5306f9"
    },
    {
      "source_id": "fr81-u100-r0011",
      "target": "— И ты вот так издалека идёшь?",
      "source_sha256": "558b45793404049fe6bff153c56750a9b2703b6dfa3d467e2bbb187658d80fd2",
      "target_id": "ru-fr81-u100-r0011",
      "tag": "prose",
      "target_sha256": "1451ce67cebdf51c950bbff011fc869205b4c5ad61aa0a7c32b7f15f1caddfde"
    },
    {
      "source_id": "fr81-u100-r0012",
      "target": "— От источника, что в лесу.",
      "source_sha256": "9528d99cb006af77fd6a0600ef9d26ca71ad24223878a372a928c8143500c642",
      "target_id": "ru-fr81-u100-r0012",
      "tag": "prose",
      "target_sha256": "7ffd8b372e8f21dbeecf02f50231a2c541228816d5494e12df0f6657a14ede8c"
    },
    {
      "source_id": "fr81-u100-r0013",
      "target": "— А далеко ли то место, куда ты идёшь?",
      "source_sha256": "0d4a800260032e0b46e9a63034f81e780deec0c266434cb4b3c3c99a2aec0f88",
      "target_id": "ru-fr81-u100-r0013",
      "tag": "prose",
      "target_sha256": "51247bde53f09efccaece855eb838fdf7b19cbdb7f0a4f16c1c510bacf5c777a"
    },
    {
      "source_id": "fr81-u100-r0014",
      "target": "— Добрая четверть часа отсюда.",
      "source_sha256": "4bb6c8ff3f4984d0bcb1298d75077b6a01f4e819c6dbf0804cc63b5eccb76b8b",
      "target_id": "ru-fr81-u100-r0014",
      "tag": "prose",
      "target_sha256": "f434f82e3e055e9bc68c4d8e3e8b7e1b041c467ee96d63690c6f70b62d73cff1"
    },
    {
      "source_id": "fr81-u100-r0015",
      "target": "Мужчина некоторое время молчал, потом вдруг сказал:",
      "source_sha256": "0ad7dc301facb7e101fee3c00409ec153077c9edde27ebec538cf92b9ac0f580",
      "target_id": "ru-fr81-u100-r0015",
      "tag": "prose",
      "target_sha256": "69e044fc2bf847992f618934ccb972087af63cb1aed10a48e3b633e05364fc67"
    },
    {
      "source_id": "fr81-u100-r0016",
      "target": "— Так у тебя нет матери?",
      "source_sha256": "ed5f2468fd421f8bbaf01df4d5dcf56579b519619fd0b3b6fbc58b30fa0922c0",
      "target_id": "ru-fr81-u100-r0016",
      "tag": "prose",
      "target_sha256": "65a9acf6ff2bfc307e0fd0ddbdfa1b1fc603d298f882a28a902deeb7f0b1517d"
    },
    {
      "source_id": "fr81-u100-r0017",
      "target": "— Не знаю, — ответила девочка.",
      "source_sha256": "33e845cbeda87936bf218979b2fedd643553114b72e535f6cd66b26cb60ebb00",
      "target_id": "ru-fr81-u100-r0017",
      "tag": "prose",
      "target_sha256": "35677018295793f8b5baf4d44e3e424468131bd85491fb5346a915534612c065"
    },
    {
      "source_id": "fr81-u100-r0018",
      "target": "Прежде чем мужчина успел заговорить снова, она добавила:",
      "source_sha256": "7b73cb3e1efaef2f4fd83f523c8102d058296dc3b1b9b40d9c64bb074fb0e55e",
      "target_id": "ru-fr81-u100-r0018",
      "tag": "prose",
      "target_sha256": "9e7f88946b87f18945f937962a48a3ef670ef50cff7d8490591e9038524d1acc"
    },
    {
      "source_id": "fr81-u100-r0019",
      "target": "— Кажется, нет. У других есть. А у меня нет.",
      "source_sha256": "989c0852858c68355083031e463fa389e5cfa57646d9f1bf502ed4796f91d96f",
      "target_id": "ru-fr81-u100-r0019",
      "tag": "prose",
      "target_sha256": "1e914cddf407621627ca0b574cadf3fbcdbe8af2438f70f1fbc02408cdd6fcaf"
    },
    {
      "source_id": "fr81-u100-r0020",
      "target": "И после молчания продолжала:",
      "source_sha256": "90232dc9a645cab51241f2e88c9cc85304e42204c5010bb6c45ee8dd7cd2c83e",
      "target_id": "ru-fr81-u100-r0020",
      "tag": "prose",
      "target_sha256": "074064d8b2bc79c7121438e1e1916f5eeaeab0d8bcb3b247d22b7345997b4be7"
    },
    {
      "source_id": "fr81-u100-r0021",
      "target": "— Думаю, что у меня её никогда и не было.",
      "source_sha256": "466edf0b8354f14b9849336c83e326b665a05907f3c098c3add75b39723cd31c",
      "target_id": "ru-fr81-u100-r0021",
      "tag": "prose",
      "target_sha256": "2ed669e4767692944ca2dba3deb78ce93c937c11f3f0e002e15b7804dfd8cdd8"
    },
    {
      "source_id": "fr81-u100-r0022",
      "target": "Мужчина остановился, поставил ведро на землю, наклонился и положил обе руки на плечи ребёнка, стараясь разглядеть её и увидеть её лицо в темноте.",
      "source_sha256": "af5d595fe729fea3b6bc44b2f9d84273b82e87da9e69d2bf5b61b15c71e6c35f",
      "target_id": "ru-fr81-u100-r0022",
      "tag": "prose",
      "target_sha256": "d8301e5a87f0bad82a7db86361e2b8fd84fc39c04ae79a6461f293c86cfd1138"
    },
    {
      "source_id": "fr81-u100-r0023",
      "target": "Худое, хилое личико Козетты смутно вырисовывалось в мертвенном свете неба.",
      "source_sha256": "fb422d1e06bdf5487127a6d54b9b07baeadcf9e830fd041fa13f9be3aa6a5d66",
      "target_id": "ru-fr81-u100-r0023",
      "tag": "prose",
      "target_sha256": "1f83239c18e3cc0750c276dceccfd81f504f56427496d76bf1c4df578576148d"
    },
    {
      "source_id": "fr81-u100-r0024",
      "target": "— Как тебя зовут?",
      "source_sha256": "f852aa85ea3496e775461dbf147174dfdf0a4cdfc5faf9b035caeeb6ec123b9e",
      "target_id": "ru-fr81-u100-r0024",
      "tag": "prose",
      "target_sha256": "233319ba9a10b3ee292978d4f56744f35cf78526be8db73a05961494aaab21a8"
    },
    {
      "source_id": "fr81-u100-r0025",
      "target": "— Козетта.",
      "source_sha256": "fac6c5bda5e83ed048bf777d46cbc35133071df9a8cb9e9ac3ac9206f7f4caa7",
      "target_id": "ru-fr81-u100-r0025",
      "tag": "prose",
      "target_sha256": "335c8a6320778ec34c990c718cc0122cc966b9081aa9e6fb52072b5ebd7d2317"
    },
    {
      "source_id": "fr81-u100-r0026",
      "target": "Мужчину будто пронзило электрическим ударом. Он ещё раз взглянул на неё, потом снял руки с плеч Козетты, взял ведро и снова пошёл.",
      "source_sha256": "d62e63b97021f1b618a4bbf016b8d901fb59df9c3e1babc4d54d6ef233e9dd47",
      "target_id": "ru-fr81-u100-r0026",
      "tag": "prose",
      "target_sha256": "c3503975e8075dfb60a88b367004aa7ad6000f63f96ed98597ac7ee46202d3a0"
    },
    {
      "source_id": "fr81-u100-r0027",
      "target": "Спустя мгновение он спросил:",
      "source_sha256": "c6d0c5b6f2fb1a640fb5b8093de2efcd0466bdf60247da0bf1d9b5dd882dc3a4",
      "target_id": "ru-fr81-u100-r0027",
      "tag": "prose",
      "target_sha256": "8431cdf0ca08e4f5ea87dad982dbf62266882bc9cfdd0ce3ae17f7aa3ec42f69"
    },
    {
      "source_id": "fr81-u100-r0028",
      "target": "— Малышка, где ты живёшь?",
      "source_sha256": "5d9dcbaf8052a418d2a8b8ba99a2389f7d84f6386dbdd0bdcbab01aa3791a650",
      "target_id": "ru-fr81-u100-r0028",
      "tag": "prose",
      "target_sha256": "c83f87b449cc97b938d53f30790336c5f107a6324a9b108515ed0a6009c36e2a"
    },
    {
      "source_id": "fr81-u100-r0029",
      "target": "— В Монфермейле, если вы знаете такое место.",
      "source_sha256": "956ea9eb703e6c0693c2857d6c01df22716f7b142591d9394acc22407ad3a0a7",
      "target_id": "ru-fr81-u100-r0029",
      "tag": "prose",
      "target_sha256": "fc90213e4f207c14deb1b4ae4c1cedcc211d702059de261005983239a7566897"
    },
    {
      "source_id": "fr81-u100-r0030",
      "target": "— Мы туда и идём?",
      "source_sha256": "a6392ba940d4506bdc77717ff26a1ebee40c1f0ecf6614dad2ebf793c1e6cd0f",
      "target_id": "ru-fr81-u100-r0030",
      "tag": "prose",
      "target_sha256": "b3666c2d7f87724aa7d78d08bfe31204caf7062934064a41ac99e6165fa05e4c"
    },
    {
      "source_id": "fr81-u100-r0031",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u100-r0031",
      "tag": "prose",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    }
  ],
