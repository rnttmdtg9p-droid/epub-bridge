{
  "unit": 100,
  "batch": 2,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u100-r0064",
      "target": "— Как же ты забавляешься?",
      "source_sha256": "a12d9cd5986e60b0b2fd4b2cf5a8ff3e720cb62699fbc244376a2a7b4f8489e3",
      "target_id": "ru-fr81-u100-r0064",
      "tag": "prose",
      "target_sha256": "864370fb63f4814ddfced45e24a221f408972716a2859dfb34f34b692fac1aff"
    },
    {
      "source_id": "fr81-u100-r0065",
      "target": "— Как могу. Мне позволяют. Только игрушек у меня почти нет: Понина и Зельма не хотят, чтобы я играла с их куклами. У меня есть только маленькая свинцовая сабля, вот такая, не длиннее этого.",
      "source_sha256": "b96a17b7bdd9c13669b714f1da3059357cec1dd5029f2378462ad34506de580d",
      "target_id": "ru-fr81-u100-r0065",
      "tag": "prose",
      "target_sha256": "a0b7716d1a29d5332e879b04c5e1d30c4da75b285e86e3a860e56a3cec1e1ba4"
    },
    {
      "source_id": "fr81-u100-r0066",
      "target": "Девочка показала свой мизинец.",
      "source_sha256": "223836f36c24aa1edaa56e39020405c1e2ff4e989ca3e1b15d7c7414523bdf5e",
      "target_id": "ru-fr81-u100-r0066",
      "tag": "prose",
      "target_sha256": "7fb57cae3cea924d54a4de314a819dd74753a259750377d12502c7714d016a89"
    },
    {
      "source_id": "fr81-u100-r0067",
      "target": "— И которая не режет?",
      "source_sha256": "9bb770dd0455855caf5a23a3b08499e2e3dca4455eccf2548de0fa0ebcf5dfc6",
      "target_id": "ru-fr81-u100-r0067",
      "tag": "prose",
      "target_sha256": "a55bf80b29e1ac282cee6fb144d3f12bed5b4955582310637cbf97dedc6f590f"
    },
    {
      "source_id": "fr81-u100-r0068",
      "target": "— Нет, сударь, режет, — сказала девочка, — она режет салат и мушиные головки.",
      "source_sha256": "5215d7764258702cd4ecb81e9d65c7a7135779858038aa34eed910e7b02a9c22",
      "target_id": "ru-fr81-u100-r0068",
      "tag": "prose",
      "target_sha256": "6df06df9ea49b39b2152aeaacb149c59d5d95be87ba56705139a443b32fed1a9"
    },
    {
      "source_id": "fr81-u100-r0069",
      "target": "Они дошли до селения; Козетта повела незнакомца по улицам. Они прошли мимо булочной, но Козетта не вспомнила о хлебе, который ей надо было принести. Мужчина перестал расспрашивать её и теперь угрюмо молчал. Когда церковь осталась позади и он увидел все эти лавчонки под открытым небом, он спросил Козетту:",
      "source_sha256": "f5c771fcb5da29a787a5464a045be7afd7eca90b288ddb0ff47f1e86c3d289e9",
      "target_id": "ru-fr81-u100-r0069",
      "tag": "prose",
      "target_sha256": "a76bc56fefa13ed1539635962a0d79e605b1ef9fb515447e03d5be7c26587942"
    },
    {
      "source_id": "fr81-u100-r0070",
      "target": "— Что же, здесь ярмарка?",
      "source_sha256": "2cbf31eb47266981696253f457da8320c3eb170b88e68e4262f5c5a0b6e7c9b9",
      "target_id": "ru-fr81-u100-r0070",
      "tag": "prose",
      "target_sha256": "4bc834ecda4ba688f8bafbbde2d3d0c4ef0246b146107b8aff4f47a35c33dd9b"
    },
    {
      "source_id": "fr81-u100-r0071",
      "target": "— Нет, сударь, это Рождество.",
      "source_sha256": "9d1d592a544122b8ccc24169be0a9987da71aeb32fca1b71d921bd9e36383b2c",
      "target_id": "ru-fr81-u100-r0071",
      "tag": "prose",
      "target_sha256": "42e9308a7466bb15595942cf3af947fa59afbcda9808ae04442e6287049e0192"
    },
    {
      "source_id": "fr81-u100-r0072",
      "target": "Когда они приблизились к трактиру, Козетта робко коснулась его руки.",
      "source_sha256": "57d3716030298edf30871d47b1d8b539ed7cb36056d4762c50ae9df4b6105141",
      "target_id": "ru-fr81-u100-r0072",
      "tag": "prose",
      "target_sha256": "19258b9f2be54c46b7ad3f980061bc8fc7a1f94c12b2e3ebca41a49130df9bd1"
    },
    {
      "source_id": "fr81-u100-r0073",
      "target": "— Сударь?",
      "source_sha256": "e3e5511369e6d1a45ca409c9befbd68153718ec58380c91d9ec00f455b7fa0ea",
      "target_id": "ru-fr81-u100-r0073",
      "tag": "prose",
      "target_sha256": "57bb9a5293deff03b9b028e3e48b5be52d7ab370d83858306eb749929e174269"
    },
    {
      "source_id": "fr81-u100-r0074",
      "target": "— Что, дитя моё?",
      "source_sha256": "2a491e0c22dadfdff140e44925f05c2df85730313e3e730904efc242a54948dc",
      "target_id": "ru-fr81-u100-r0074",
      "tag": "prose",
      "target_sha256": "3b408f868a41259f405afd783a07c06ecb7c64874ba35d7dbb4976c7c119d282"
    },
    {
      "source_id": "fr81-u100-r0075",
      "target": "— Вот мы уже совсем близко от дома.",
      "source_sha256": "021ed86faa6eb0003daf1c673845d7253b4f2c3536488626db550892fd8a56b7",
      "target_id": "ru-fr81-u100-r0075",
      "tag": "prose",
      "target_sha256": "1f68db775384dde7fa1614a0c31cf655f5d291a8d35eeb83c745e408a7d0d8dc"
    },
    {
      "source_id": "fr81-u100-r0076",
      "target": "— Ну и что же?",
      "source_sha256": "4950a516c968f0619fb8b95afe126297c80c72d6fe6348e65ea081818635e18f",
      "target_id": "ru-fr81-u100-r0076",
      "tag": "prose",
      "target_sha256": "0372d0cc02b30b45ee0906a42a95fdac881a0e83dbb10bc95391cdd6ec02fa01"
    },
    {
      "source_id": "fr81-u100-r0077",
      "target": "— Позвольте мне теперь снова взять ведро.",
      "source_sha256": "e2641771b774a352fac1d778a8b9d071de4a6a8282487e2cf983750e9ccc6b22",
      "target_id": "ru-fr81-u100-r0077",
      "tag": "prose",
      "target_sha256": "f828c8dfc9deabf4a82d8ed3e790972231e772b40953a5f23c7a97a9e1e2279c"
    },
    {
      "source_id": "fr81-u100-r0078",
      "target": "— Почему?",
      "source_sha256": "4b5154ea331b0a88da96b0d95a9812f8ce55fa954dcfa4511479082dd555da57",
      "target_id": "ru-fr81-u100-r0078",
      "tag": "prose",
      "target_sha256": "5a7f49277ce4099a8cda575751c41cbe2652b4e11515588f5af4642c420fb08d"
    },
    {
      "source_id": "fr81-u100-r0079",
      "target": "— Потому что, если хозяйка увидит, что мне его несли, она меня побьёт.",
      "source_sha256": "da705b65b0224bec09dee89472d38827fb1a2c1fb9c699cc898af91d70d0e1ee",
      "target_id": "ru-fr81-u100-r0079",
      "tag": "prose",
      "target_sha256": "0c47576f1ffc78007a532667902c99c13777fec97cf916c9c0a7ac4a9ef57749"
    },
    {
      "source_id": "fr81-u100-r0080",
      "target": "Мужчина отдал ей ведро. Спустя мгновение они были у дверей харчевни.",
      "source_sha256": "fc2810e71300c02cc55cd432f75065fe22c6c1328273053ca59871d64af2287c",
      "target_id": "ru-fr81-u100-r0080",
      "tag": "prose",
      "target_sha256": "24500ac1cb9373496c31f51a6d22ee692a029c2b33a7b756a5851189a8ad0e20"
    }
  ],
