{
  "unit": 100,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u100-r0032",
      "target": "Он помолчал ещё немного, потом начал снова:",
      "source_sha256": "7db3b1629c8e901fcb13c1dce951529c74e654de907b20dcf89099ff22ca7967",
      "target_id": "ru-fr81-u100-r0032",
      "tag": "prose",
      "target_sha256": "282e85d9d6f3da79a0641c026a9e4c89125dfee66660a18f83fd152fccba2f93"
    },
    {
      "source_id": "fr81-u100-r0033",
      "target": "— Кто же это послал тебя в такой час за водой в лес?",
      "source_sha256": "63f4fdc81044157b48975afdadf22a90f52eef2a356cc82d495d8f4c17076371",
      "target_id": "ru-fr81-u100-r0033",
      "tag": "prose",
      "target_sha256": "3aa61a2d956112147fa5c1f10aadda6341cf594ae2f9332471dc379d9257e664"
    },
    {
      "source_id": "fr81-u100-r0034",
      "target": "— Госпожа Тенардье.",
      "source_sha256": "70bc8e8f3f5f5330b458df5ecdaae8a731f71577f9d9eff87ab2992b38e7cdd5",
      "target_id": "ru-fr81-u100-r0034",
      "tag": "prose",
      "target_sha256": "596ab39c57b87eda34a01c6a22df96260f48a7725dd1a54fc5a95d127cc89c01"
    },
    {
      "source_id": "fr81-u100-r0035",
      "target": "Мужчина отозвался голосом, который он старался сделать равнодушным, но в котором всё же слышалась странная дрожь:",
      "source_sha256": "71c42086dfa21c4a0c6831d5c6094f01d1a702f5a5203912fb913bf7e0bc61d3",
      "target_id": "ru-fr81-u100-r0035",
      "tag": "prose",
      "target_sha256": "7824b0b7ce4c80cbf6086a46eca71ec854eb98d8277a5a558d0950dbdba69834"
    },
    {
      "source_id": "fr81-u100-r0036",
      "target": "— А что она делает, твоя госпожа Тенардье?",
      "source_sha256": "ad9266217e10800313ac67d931a1bdb5c79155e00666d3c9d6eff99f15ed695c",
      "target_id": "ru-fr81-u100-r0036",
      "tag": "prose",
      "target_sha256": "96a5de654ce6d25524d3047b3719999ab167c08345c9a3f99c383591d9ec7f0b"
    },
    {
      "source_id": "fr81-u100-r0037",
      "target": "— Она моя хозяйка, — сказал ребёнок. — Она держит трактир.",
      "source_sha256": "04a67907fd8df69b23c646a9b8e56fbe60baea4bf7df63450c1ea3dc0880a9e1",
      "target_id": "ru-fr81-u100-r0037",
      "tag": "prose",
      "target_sha256": "a84a25b18d08974e32f11062f7658ba43d48b0536a97ab805caae84383fcf707"
    },
    {
      "source_id": "fr81-u100-r0038",
      "target": "— Трактир? — переспросил мужчина. — Что ж, я переночую там нынче. Веди меня.",
      "source_sha256": "11fb6dbb51852718bbce160ff0a8b427506c26f386007203196511fa5122a427",
      "target_id": "ru-fr81-u100-r0038",
      "tag": "prose",
      "target_sha256": "4c27f09f6776b0497021d67af7723b36bd5b4e7d8f717521fd37938c0f28236b"
    },
    {
      "source_id": "fr81-u100-r0039",
      "target": "— Мы туда и идём, — сказал ребёнок.",
      "source_sha256": "7335b4e270df6a318b669c34b75ebdcc4f8c08ba1acb6904d5cceec553da4084",
      "target_id": "ru-fr81-u100-r0039",
      "tag": "prose",
      "target_sha256": "c72ca60d6c5f42d09a57e73e40475f6192312bb2f58498b120b433a505fd15d2"
    },
    {
      "source_id": "fr81-u100-r0040",
      "target": "Мужчина шёл довольно быстро. Козетта без труда поспевала за ним. Усталости она больше не чувствовала. Время от времени она поднимала глаза на этого человека с каким-то спокойствием и невыразимой доверчивостью. Её никогда не учили обращаться к провидению и молиться. Однако она ощущала в себе нечто похожее на надежду и радость, и это нечто уходило ввысь, к небу.",
      "source_sha256": "ced684804592f9c5d3b9dd37eb87e680001bfece40661181659dbc8d71edf8db",
      "target_id": "ru-fr81-u100-r0040",
      "tag": "prose",
      "target_sha256": "aea10026f046bef211d9ee473b6cdeace5f7a291a6ac4555b7f1f44b808cbcff"
    },
    {
      "source_id": "fr81-u100-r0041",
      "target": "Прошло несколько минут. Мужчина заговорил опять:",
      "source_sha256": "7534ca5690a60ff1dae6c0f6d7a87252ab6ad2f72abacfbcd3868c00f2560272",
      "target_id": "ru-fr81-u100-r0041",
      "tag": "prose",
      "target_sha256": "8d7fe5d7ede3846944ead6f8aec9f0899c831ddbb25044bbdf147c27eef1044c"
    },
    {
      "source_id": "fr81-u100-r0042",
      "target": "— Разве у госпожи Тенардье нет служанки?",
      "source_sha256": "b33ad60aa943dc16fada956867c43f99979297c3e016ab940fd2987ce24723b7",
      "target_id": "ru-fr81-u100-r0042",
      "tag": "prose",
      "target_sha256": "61097370491500b7569cb8de26119e173114d9978b5dd807dd6ac74b42091857"
    },
    {
      "source_id": "fr81-u100-r0043",
      "target": "— Нет, сударь.",
      "source_sha256": "17ae79b5fe3ff4a7c72562c7e47cad81a393b024ec4f88955f17157b2af5f187",
      "target_id": "ru-fr81-u100-r0043",
      "tag": "prose",
      "target_sha256": "285b832236d3f00bef4837f034431576c8ec0c9d849c8a628903d1d236e208f2"
    },
    {
      "source_id": "fr81-u100-r0044",
      "target": "— Ты там одна?",
      "source_sha256": "7a95ebad0138396979b41d61292facff2993de4985a89c05756ff593ad9ac8b4",
      "target_id": "ru-fr81-u100-r0044",
      "tag": "prose",
      "target_sha256": "c003f6f035a81f4d1a3ea3222f982527b86250dce06248866480ad8c4b8d79f9"
    },
    {
      "source_id": "fr81-u100-r0045",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u100-r0045",
      "tag": "prose",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "fr81-u100-r0046",
      "target": "Снова наступила пауза. Козетта возвысила голос:",
      "source_sha256": "39ee23bdace6fcdff93708863b5d9000aeb46bf789706a3a4a3eeba3d9defc04",
      "target_id": "ru-fr81-u100-r0046",
      "tag": "prose",
      "target_sha256": "f4f62b7291045ab4fa7160b1d4f426c6418acdf0c97566d35e7b7c688a77350e"
    },
    {
      "source_id": "fr81-u100-r0047",
      "target": "— То есть там ещё две девочки.",
      "source_sha256": "f627bc51d0b8273b5839df7acdf5f64dda7fc4ae0b6e3234d530b232aa70f552",
      "target_id": "ru-fr81-u100-r0047",
      "tag": "prose",
      "target_sha256": "530d6821f93f63bab9c8b9d277bb28ba5741b17cb0ccc5cef9b10b01f6443de9"
    },
    {
      "source_id": "fr81-u100-r0048",
      "target": "— Какие девочки?",
      "source_sha256": "17d615bf2be7149af5985a75455f554f43ede4425ddb61d81a30a0ae33e7ab86",
      "target_id": "ru-fr81-u100-r0048",
      "tag": "prose",
      "target_sha256": "0abeb7d1505cd030418b98184ea8149fb3d36a37a21449ef3ce4ad5fd81535ee"
    },
    {
      "source_id": "fr81-u100-r0049",
      "target": "— Понина и Зельма.",
      "source_sha256": "4029fdad2739de792273de40daa57d19cbd9c840146af95705a38ac3a7d2a7f9",
      "target_id": "ru-fr81-u100-r0049",
      "tag": "prose",
      "target_sha256": "61bd34cfe417c31f4533be4026809ff6d8e8d4403ef431508bcebb898a611f48"
    },
    {
      "source_id": "fr81-u100-r0050",
      "target": "Так ребёнок упрощал романтические имена, столь любимые Тенардье.",
      "source_sha256": "512362342592bbbc13d30e846b66b4f8b22f041d55567ce33977aa5d58ec812f",
      "target_id": "ru-fr81-u100-r0050",
      "tag": "prose",
      "target_sha256": "f737d17cb28d54fdd6ca642be462d54913c83c54d858e542fb4cf530d465e24d"
    },
    {
      "source_id": "fr81-u100-r0051",
      "target": "— Кто такие Понина и Зельма?",
      "source_sha256": "e8f0a1da3dd4010139f4421b84aaf9c860d9ce0ef2731821968dfba7263fa3d6",
      "target_id": "ru-fr81-u100-r0051",
      "tag": "prose",
      "target_sha256": "a11eb808f3d6b6a60557d46bcfd5cb77032e37e66cb6497515418d62e1bb253f"
    },
    {
      "source_id": "fr81-u100-r0052",
      "target": "— Это барышни госпожи Тенардье. Вроде как её дочки.",
      "source_sha256": "266a91dbf574406548d3287aefd9087920c140689e246818ac731bb7a211090f",
      "target_id": "ru-fr81-u100-r0052",
      "tag": "prose",
      "target_sha256": "92ab697119d4173a8edfb9eb26b576db598f9c478ddff82189808d33a929751f"
    },
    {
      "source_id": "fr81-u100-r0053",
      "target": "— А что они делают?",
      "source_sha256": "56e06c1087f9bda8f69501f92d2fcceb8ed1f63ee974c033613426cf70712e9b",
      "target_id": "ru-fr81-u100-r0053",
      "tag": "prose",
      "target_sha256": "c2e38c05b64c57aedc4c7187387517dca04cae2bb0c1fb94b1054adc94af4a40"
    },
    {
      "source_id": "fr81-u100-r0054",
      "target": "— Ох! — сказал ребёнок. — У них красивые куклы, вещицы с золотом, всяких игрушек полно. Они играют, развлекаются.",
      "source_sha256": "bff86549baec55ac83410d3f35ca4a6452c3dccdf31635644d1bbcdaf62ba3ca",
      "target_id": "ru-fr81-u100-r0054",
      "tag": "prose",
      "target_sha256": "7f6c8d53aefbec83d77cef69b06411dcac87f894e54cd98865c49b68541bc0df"
    },
    {
      "source_id": "fr81-u100-r0055",
      "target": "— Целый день?",
      "source_sha256": "9ed9a0f4dfd8a873bebbf2ae78da4a000976e595eba3168a2bbd8104d29a4042",
      "target_id": "ru-fr81-u100-r0055",
      "tag": "prose",
      "target_sha256": "0056d6785bfd626cad24af474d5513da64df888d9b4c1a67fd2f037750916eb3"
    },
    {
      "source_id": "fr81-u100-r0056",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u100-r0056",
      "tag": "prose",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "fr81-u100-r0057",
      "target": "— А ты?",
      "source_sha256": "f85507006c5f81ab8ce779049df8a3cb43fa2ce982bb39b1e84f459cc782e19c",
      "target_id": "ru-fr81-u100-r0057",
      "tag": "prose",
      "target_sha256": "a866e239a61f2730f33fb15c035559ba6e2fef194b08a6f1522adff4d6e6e24e"
    },
    {
      "source_id": "fr81-u100-r0058",
      "target": "— Я работаю.",
      "source_sha256": "86f00e998b270e67d506c772f5dfb6a041bd36d88ad486d90b6e4ee5537652ce",
      "target_id": "ru-fr81-u100-r0058",
      "tag": "prose",
      "target_sha256": "ff30d55dcb06b7d60c2bc533feabb11fb7d1fd8a7841a9f8379ae42db69693ef"
    },
    {
      "source_id": "fr81-u100-r0059",
      "target": "— Целый день?",
      "source_sha256": "9ed9a0f4dfd8a873bebbf2ae78da4a000976e595eba3168a2bbd8104d29a4042",
      "target_id": "ru-fr81-u100-r0059",
      "tag": "prose",
      "target_sha256": "0056d6785bfd626cad24af474d5513da64df888d9b4c1a67fd2f037750916eb3"
    },
    {
      "source_id": "fr81-u100-r0060",
      "target": "Ребёнок поднял свои большие глаза, в которых стояла слеза, незаметная из-за ночной темноты, и тихо ответил:",
      "source_sha256": "47b465ad5676885e137ad6fb87fddcafdb2106c2e99079636933770d22c06bf0",
      "target_id": "ru-fr81-u100-r0060",
      "tag": "prose",
      "target_sha256": "d2b1a38e8bf1267f6c097384be4ca765bdeb040b757bc621f7f05f97172e2319"
    },
    {
      "source_id": "fr81-u100-r0061",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u100-r0061",
      "tag": "prose",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "fr81-u100-r0062",
      "target": "После минутного молчания она продолжала:",
      "source_sha256": "9bddfa0e422dff7ec0932712da2a7270f538050c31f97c95d8511eb8e07ef632",
      "target_id": "ru-fr81-u100-r0062",
      "tag": "prose",
      "target_sha256": "673dd8e9f54c1b4cf5dd40ba54f718b22a54c67f48ae6b39bdec807f0feef738"
    },
    {
      "source_id": "fr81-u100-r0063",
      "target": "— Иногда, когда я кончу работу и мне позволят, я тоже играю.",
      "source_sha256": "4f748e69af8b45c665e7645685a8f6f688c48e6ca8b0300d4ceb8a99009daa9b",
      "target_id": "ru-fr81-u100-r0063",
      "tag": "prose",
      "target_sha256": "f15621a4f517b2180b7c44f1131527050f6fd8d9fb753d4105429859a409bb86"
    }
  ],
