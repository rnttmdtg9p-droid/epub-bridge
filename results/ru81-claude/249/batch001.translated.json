{
  "unit": 249,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u249-r0032",
      "target": "Время от времени колено Мариуса касалось колена Козетты, и оба вздрагивали.",
      "source_sha256": "595ea6e79ae7a4a569140ca411fe6c55c7856d8c33937b7216f630639398a6f1",
      "target_id": "ru-fr81-u249-r0032",
      "tag": "prose",
      "target_sha256": "a5571fba718cb86ab480e368e5b7542242bf81e22242a9787e84929ad3264f50"
    },
    {
      "source_id": "fr81-u249-r0033",
      "target": "Порою Козетта лепетала какое-нибудь слово. Душа её трепетала на её губах, как капля росы на цветке.",
      "source_sha256": "33b879faa0848f93dd93eb1acf3aa71f034a8298c905e9b0a014c4e99667edee",
      "target_id": "ru-fr81-u249-r0033",
      "tag": "prose",
      "target_sha256": "bf1e881f28f5a6b1fac53b0ab669aadec1439b6e7117c005f191e5f9064fc25b"
    },
    {
      "source_id": "fr81-u249-r0034",
      "target": "Мало-помалу они заговорили. Излияние пришло на смену молчанию, которое есть полнота. Ночь была ясная и великолепная над их головами. Эти два существа, чистые, как духи, рассказали друг другу всё: свои грёзы, свой хмель, свои восторги, свои химеры, свои упадки сил, и как они издали обожали друг друга, как желали друг друга и в каком отчаянии были, когда перестали видеть друг друга. В той идеальной близости, которую уже ничто не могло сделать теснее, они поверили друг другу всё, что было в них самого сокровенного и самого таинственного. Они рассказали, с простодушной верой в свои иллюзии, всё, что вкладывали им в мысли любовь, юность и остаток детства, который в них сохранился. Эти два сердца изливались одно в другое, так что через час юноша обладал душою девушки, а девушка — душою юноши. Они проникли друг в друга, они очаровали друг друга, они ослепили друг друга.",
      "source_sha256": "17e52df8059aed9530950cd7b7c8d153ce2c0afef9cb36d2598d588fd23552b7",
      "target_id": "ru-fr81-u249-r0034",
      "tag": "prose",
      "target_sha256": "626a1612e1e153de7e75bc071a5e1f775fed96dc4a5f51f170030a45b95e3dac"
    },
    {
      "source_id": "fr81-u249-r0035",
      "target": "Когда они кончили, когда они сказали друг другу всё, она положила голову ему на плечо и спросила:",
      "source_sha256": "2b0f4e3eb8c0aaed764f75e277684b0fad0bb1b50e49e7ec99a23db713fa3044",
      "target_id": "ru-fr81-u249-r0035",
      "tag": "prose",
      "target_sha256": "5cd0c127db20a11c7d943361bbb854684d554c2cf282d79f7a0fe90bdb0508f6"
    },
    {
      "source_id": "fr81-u249-r0036",
      "target": "— Как вас зовут?",
      "source_sha256": "0b927e6f778e8c2c0066c9f3108b3992d7d5a8bb76754f4d172b330984b406de",
      "target_id": "ru-fr81-u249-r0036",
      "tag": "prose",
      "target_sha256": "b616f0b60e787110c30baf3937a13010289a663ba8081825b8342951812933d6"
    },
    {
      "source_id": "fr81-u249-r0037",
      "target": "— Меня зовут Мариус, — сказал он. — А вас?",
      "source_sha256": "37ec6e270a804df2e0ef6a6702b02f529891d39bf8e0c049be721452c372f76f",
      "target_id": "ru-fr81-u249-r0037",
      "tag": "prose",
      "target_sha256": "64418aa3f92332c6fcb0bb25b50f84e33cb646f40a9c06e90dd1c87b09cba815"
    },
    {
      "source_id": "fr81-u249-r0038",
      "target": "— Меня зовут Козетта.",
      "source_sha256": "574cdf47fac3ad449d0ecaa4ed9614aab8f863ff15fc1233ca50896a57710096",
      "target_id": "ru-fr81-u249-r0038",
      "tag": "prose",
      "target_sha256": "a0bd51b5871c0967709ad3e71851adf9699115944cbcf9a232e4c1f69d38290d"
    }
  ],
