{
  "unit": 37,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u037-r0032",
      "target": "«Листолье.",
      "source_sha256": "691f00ab9f5c7338eb43baea761715ce46ce1bc2a1f61b5bb8e46c60b2ff39f9",
      "target_id": "ru-fr81-u037-r0032",
      "tag": "display_group",
      "target_sha256": "bbb6c3561da844bdb36cf87108023859cad169e03df96f89b4dc9cf0273df6eb"
    },
    {
      "source_id": "fr81-u037-r0033",
      "target": "«Феликс Толомье.",
      "source_sha256": "2761b98e552ae63a39b72b993800a6df95ad084b8d68d5564bff0aae6fc05d10",
      "target_id": "ru-fr81-u037-r0033",
      "tag": "display_group",
      "target_sha256": "5c27333805feae8099123e77ec762e3d19d5ee86fb0d8136a552cef4ff75d805"
    },
    {
      "source_id": "fr81-u037-r0034",
      "target": "«[[SC]]Постскриптум[[/SC]]. Обед оплачен».",
      "source_sha256": "5754738eeb7b6300fb69b8d49fd10345c84f32ac1c60e104b0abb85b93fb3f27",
      "target_id": "ru-fr81-u037-r0034",
      "tag": "prose",
      "target_sha256": "f6666e71c5c99ee4b30b6be0b038f8b6cbd3527e685b3c963516375ff95640af"
    },
    {
      "source_id": "fr81-u037-r0035",
      "target": "Четыре девушки переглянулись.",
      "source_sha256": "b02a2d11aaed67876af6493b9bbec2a2ac2b39c20e580cb3dcc0ca3537e3419e",
      "target_id": "ru-fr81-u037-r0035",
      "tag": "prose",
      "target_sha256": "f4342351c17bbeb1f69a3302989754ae984646d5f2aa8b59cedc38ab6fb4b09d"
    },
    {
      "source_id": "fr81-u037-r0036",
      "target": "Первой нарушила молчание Фаворита.",
      "source_sha256": "91beaf3e8ac22725e8e5a2623b8f7c078fc4eeaad4d179f73e812eaceb06999c",
      "target_id": "ru-fr81-u037-r0036",
      "tag": "prose",
      "target_sha256": "af00aee2d4cf915c0193480e9be3a46ab6f8a0b231ef8049c439f6618bc17957"
    },
    {
      "source_id": "fr81-u037-r0037",
      "target": "— Ну что ж! — воскликнула она. — Всё равно это славная шутка.",
      "source_sha256": "24d3852b161c3f6f8701e271ee05f61c9a78c07041c68b5ddc97fb9ac5f1ecb5",
      "target_id": "ru-fr81-u037-r0037",
      "tag": "prose",
      "target_sha256": "e08931bc9feb639b43e453dbbec422d9adef1574704a87e881d7e5ac40377721"
    },
    {
      "source_id": "fr81-u037-r0038",
      "target": "— Очень забавно, — сказала Зефина.",
      "source_sha256": "02c68c88daf03c7fd5fe8676fcb9070276b92d055d02bfb2ab7e10365aec366a",
      "target_id": "ru-fr81-u037-r0038",
      "tag": "prose",
      "target_sha256": "8542a5f6ed9a89c72d3083a3d9ba224622b724f330778aa5622f65aa35589514"
    },
    {
      "source_id": "fr81-u037-r0039",
      "target": "— Наверно, эта мысль пришла в голову Блашвелю, — продолжала Фаворита. — Я от этого прямо влюбляюсь в него. С глаз долой — в сердце с лихвой. Вот и вся история.",
      "source_sha256": "317b68f33e6cced87217439816eeec83d9f6bbc65d985fe1e7e58dd640ce3394",
      "target_id": "ru-fr81-u037-r0039",
      "tag": "prose",
      "target_sha256": "e9fcfb309ec76f9497ab0fdee4c61316c70efabde4833f7aac72af807180dfd8"
    },
    {
      "source_id": "fr81-u037-r0040",
      "target": "— Нет, — сказала Далия, — это выдумка Толомье. Сразу видно.",
      "source_sha256": "98c62ef48ca093e18740f2e9daef5de1116980d995fb652f84a14ccfef953720",
      "target_id": "ru-fr81-u037-r0040",
      "tag": "prose",
      "target_sha256": "b4ce5ea294cfb6a25b2ed1cb86c5e4586eb9f4da729c77ea26a128e2a52882b8"
    },
    {
      "source_id": "fr81-u037-r0041",
      "target": "— В таком случае, — отозвалась Фаворита, — смерть Блашвелю и да здравствует Толомье!",
      "source_sha256": "d611aaf7a2dca1ffa2fec00463cb413c4f82cf83aae0a34b5db6c45731bb0f4b",
      "target_id": "ru-fr81-u037-r0041",
      "tag": "prose",
      "target_sha256": "9c909e830840a2c7df508884d088e35ae28e2784313f627158d6da3144ac7885"
    },
    {
      "source_id": "fr81-u037-r0042",
      "target": "— Да здравствует Толомье! — закричали Далия и Зефина.",
      "source_sha256": "7974fe2ce290f6cb1de94eb08da4c7508cb103b476963db4aa144504804daa79",
      "target_id": "ru-fr81-u037-r0042",
      "tag": "prose",
      "target_sha256": "b09c2a010f7bea8157355dbac0a5ea73febd3c1e3472b5114eed2ebe725429ec"
    },
    {
      "source_id": "fr81-u037-r0043",
      "target": "И они расхохотались.",
      "source_sha256": "d36e3aca8aca5b901721ae9646a723ea62ad248405cd5ad5ffa0e9d4f53e5b41",
      "target_id": "ru-fr81-u037-r0043",
      "tag": "prose",
      "target_sha256": "c632e5f56e1b1c6a74cf5e3270ea05af14f063e0ab573b151deea9e62608a6cf"
    },
    {
      "source_id": "fr81-u037-r0044",
      "target": "Фантина засмеялась, как и все.",
      "source_sha256": "6d8013a3b8fe593a5e7e9de160f8185f93171305de75a2b44ed17b51692abc97",
      "target_id": "ru-fr81-u037-r0044",
      "tag": "prose",
      "target_sha256": "06498b0767f009eb4dd0b90eefa068d54d2f3cc874b2eb63128d1338e271a169"
    },
    {
      "source_id": "fr81-u037-r0045",
      "target": "Час спустя, когда она вернулась к себе в комнату, она плакала. Это была, как мы сказали, её первая любовь; она отдалась этому Толомье как мужу, и у бедной девушки был ребёнок.",
      "source_sha256": "3d5b45bb5b1077cb7b58335a8d3a2f4777ed32dd6b575603734cfbe3a9af207b",
      "target_id": "ru-fr81-u037-r0045",
      "tag": "prose",
      "target_sha256": "d35fbe1d20157a8e9518fa813f88a0de2a029dfbf381c1b5a3451107562e78a4"
    }
  ],
