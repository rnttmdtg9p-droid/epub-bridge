{
  "unit": 57,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u057-r0032",
      "target": "— Мне придётся платить тридцать франков в день. Дни отдыха оплачиваются. Ни единого лиара скидки, и корм для животного — за счёт господина мэра.",
      "source_sha256": "6d5d0e383800e3caeaa1858dd198ba5c745cf15fb7319d7376cf69108df07b03",
      "target_id": "ru-fr81-u057-r0032",
      "tag": "prose",
      "target_sha256": "fc264816a804c57c92a030ae707992864cc4e0796372d50e410ee3dc1e48682f"
    },
    {
      "source_id": "fr81-u057-r0033",
      "target": "Господин Мадлен достал из кошелька три наполеондора и положил их на стол.",
      "source_sha256": "c1824a1e15f1941150ebab88b08f652f7ac868d177b7c9f3a1d2e6643a4835bd",
      "target_id": "ru-fr81-u057-r0033",
      "tag": "prose",
      "target_sha256": "381dab1c78145b947d6938004966a5c0692f377798c123206ed5020f36aaa5b8"
    },
    {
      "source_id": "fr81-u057-r0034",
      "target": "— Вот вам плата за два дня вперёд.",
      "source_sha256": "1ed133a00ebfd4b94825e8d8266d3a617adab6caef41d886c7692f6214f70343",
      "target_id": "ru-fr81-u057-r0034",
      "tag": "prose",
      "target_sha256": "eb314fb0b1fc5ef0956418f539aac0e609ede24c8435854fa4c67e8253735ed4"
    },
    {
      "source_id": "fr81-u057-r0035",
      "target": "— В-четвёртых, для такой поездки кабриолет будет слишком тяжёл и утомит лошадь. Господину мэру надо будет согласиться ехать в маленьком тильбюри, которое у меня есть.",
      "source_sha256": "7c6c6b6fe49ae0877dd7d0ad7ca0abe463abf121940f99029bd2b10a21d5014e",
      "target_id": "ru-fr81-u057-r0035",
      "tag": "prose",
      "target_sha256": "db4f54ada1d15f38777a8b85ed5b7c7c3e15877eaf515d4f7bd6817f564b3b30"
    },
    {
      "source_id": "fr81-u057-r0036",
      "target": "— Согласен.",
      "source_sha256": "2bc182eb452611f72223f037ca7b615f2621d71c6d1287b0d1c0a7bec3301a08",
      "target_id": "ru-fr81-u057-r0036",
      "tag": "prose",
      "target_sha256": "fd0e6b4293c133e5e21d997272612a936e5bd96dc23225774550eb321c4ae23e"
    },
    {
      "source_id": "fr81-u057-r0037",
      "target": "— Оно лёгкое, но открытое.",
      "source_sha256": "b1baae95983fa7383beb61d5af53ab6eab2049dc9702d946daa4364c6e38e2fe",
      "target_id": "ru-fr81-u057-r0037",
      "tag": "prose",
      "target_sha256": "6f712289f1ce9d2ca6fc2e114364951f15fb959d09ae647c49897e0373173a7c"
    },
    {
      "source_id": "fr81-u057-r0038",
      "target": "— Мне всё равно.",
      "source_sha256": "a60b5114651ce6f90e07ffe6cc79b59582567b185e752dae7cd953eb0181574f",
      "target_id": "ru-fr81-u057-r0038",
      "tag": "prose",
      "target_sha256": "6790c129d146958068da1d27e222df927e80244ce306d5ea7589129d70baaee0"
    },
    {
      "source_id": "fr81-u057-r0039",
      "target": "— Подумал ли господин мэр, что сейчас зима?..",
      "source_sha256": "76c642b57313f8dc5cc200ae7bfb92b177cf721ed4e13489bafd938554a32b16",
      "target_id": "ru-fr81-u057-r0039",
      "tag": "prose",
      "target_sha256": "1a111f89d4ec0d59b0ff24ec0b0bf563eb2d90030f7552a8c1b28d82d9de5889"
    },
    {
      "source_id": "fr81-u057-r0040",
      "target": "Господин Мадлен не ответил. Фламандец продолжал:",
      "source_sha256": "54c0592e6c9d7b825d1fb96bb040f742117951c26ae382cb0f164db2d5950b5d",
      "target_id": "ru-fr81-u057-r0040",
      "tag": "prose",
      "target_sha256": "632ee18dfcc3e2611e0eb18f5b426fdbbb8f945a2d025ff1cd4af5fb695bac0c"
    },
    {
      "source_id": "fr81-u057-r0041",
      "target": "— Что очень холодно?",
      "source_sha256": "cf59080f1a742dddac9b14832223a47edcc29dcdde42359d25235eb6f8e039b7",
      "target_id": "ru-fr81-u057-r0041",
      "tag": "prose",
      "target_sha256": "2eee0eb0fc6fc275cf018bde1512791273f462875591965b44d626a5b7aec44f"
    },
    {
      "source_id": "fr81-u057-r0042",
      "target": "Господин Мадлен хранил молчание. Мэтр Скауфлер продолжал:",
      "source_sha256": "bf8be855ba25abb0e678a602a25789c42c231dc878928301b471e9619999e1e1",
      "target_id": "ru-fr81-u057-r0042",
      "tag": "prose",
      "target_sha256": "d8af9fcc53e1c5a2b341fb7992f82e7511d179bb67a2fda62e98eb1d5f18c730"
    },
    {
      "source_id": "fr81-u057-r0043",
      "target": "— Что может пойти дождь?",
      "source_sha256": "4f049fd374bd943ca5dd3502ea6d22426c3f2fdf81f8891694cb22a2a5ae04a6",
      "target_id": "ru-fr81-u057-r0043",
      "tag": "prose",
      "target_sha256": "76f7b219b183dc7cf832fd93dd98c427886665af6f2be906b1e73d1ef371adea"
    },
    {
      "source_id": "fr81-u057-r0044",
      "target": "Господин Мадлен поднял голову и сказал:",
      "source_sha256": "4efbdd5aba17aeccb46f7f8d79f4a9a58aff013ccd45e1755625f8beaad45a13",
      "target_id": "ru-fr81-u057-r0044",
      "tag": "prose",
      "target_sha256": "bb855dfac7c5b8e98e7d6feb76151d8bc0592340c6c8ed6a7d8106e10d5e37c4"
    },
    {
      "source_id": "fr81-u057-r0045",
      "target": "— Тильбюри и лошадь будут стоять у моей двери завтра в половине пятого утра.",
      "source_sha256": "98dcac2fc3668714ad8d758f50f52cd7ad178394fd8c4f1ee55652f909d59598",
      "target_id": "ru-fr81-u057-r0045",
      "tag": "prose",
      "target_sha256": "da8ff5163aaf6012401653dd216234e09a6788ac6445c650365a5cfdf17c73f3"
    },
    {
      "source_id": "fr81-u057-r0046",
      "target": "— Понятно, господин мэр, — ответил Скауфлер; потом, поковыряв ногтем большого пальца пятно на дереве стола, он снова заговорил с тем беспечным видом, который фламандцы так умеют сочетать со своей хитрецой:",
      "source_sha256": "1cb1010830218b50851613c643becba3a8147ca878224dffa0d71f6c78e908c1",
      "target_id": "ru-fr81-u057-r0046",
      "tag": "prose",
      "target_sha256": "175351f5147ab36d30ce1dd0d17e9582ccf31802c78f005e0f8f7fb01fbfba0a"
    },
    {
      "source_id": "fr81-u057-r0047",
      "target": "— Но вот ведь что мне теперь пришло в голову! Господин мэр не сказал мне, куда он едет. Куда же едет господин мэр?",
      "source_sha256": "9ba02cd1651e21d38f2317d6ac9e55af25cc67e9b4165a31dbdb6c425c5bce65",
      "target_id": "ru-fr81-u057-r0047",
      "tag": "prose",
      "target_sha256": "53e26ed931761ae9e9cba9e0d964f33cce12b7383daa53d0610f7405816775b0"
    },
    {
      "source_id": "fr81-u057-r0048",
      "target": "Он ни о чём другом не думал с самого начала разговора, но почему-то не решался задать этот вопрос.",
      "source_sha256": "f5e0f7bd784f8507a84edf57bc959b7471914d77144fa756ff22d3a2f8f4ee1b",
      "target_id": "ru-fr81-u057-r0048",
      "tag": "prose",
      "target_sha256": "a13caaa83f93a44696f9895c1598e7be3258f4ebe97fcaa3ed7d13d60b297e3d"
    },
    {
      "source_id": "fr81-u057-r0049",
      "target": "— Крепки ли у вашей лошади передние ноги? — спросил господин Мадлен.",
      "source_sha256": "fcde983288164f1a38f9055cc7f0a447e55f8fa6f48e2f361412f96399ab0cd5",
      "target_id": "ru-fr81-u057-r0049",
      "tag": "prose",
      "target_sha256": "1e3e628b87df112dde3dff9c0f3d6ac43ce6f7a06eaa1db897f7074e00173941"
    },
    {
      "source_id": "fr81-u057-r0050",
      "target": "— Да, господин мэр. Вам придётся немного придерживать её на спусках. Много ли спусков отсюда до того места, куда вы едете?",
      "source_sha256": "47fc3902393abd18c4fb8f458bbd723a9eae73fbc82d776a015922ce19da6e69",
      "target_id": "ru-fr81-u057-r0050",
      "tag": "prose",
      "target_sha256": "d076621833a93ae8e1fec84ae3e50272b734d29f9c4a4e8d7fe77a81d31475ea"
    },
    {
      "source_id": "fr81-u057-r0051",
      "target": "— Не забудьте быть у моей двери в половине пятого утра, ровно, — ответил господин Мадлен и вышел.",
      "source_sha256": "e770c0f0e5bee6612320f1ac71c04687ca0d8a10d11312e62f18558a591b3281",
      "target_id": "ru-fr81-u057-r0051",
      "tag": "prose",
      "target_sha256": "6c9256b1cab9eb809b51f467f9ac2b6be6ef54655744de9232317163a24ac80e"
    },
    {
      "source_id": "fr81-u057-r0052",
      "target": "Фламандец остался «совсем дурак дураком», как он сам говорил некоторое время спустя.",
      "source_sha256": "517c3118232767bdb2e53b6f837a4e3645d9bd7647ff46539286146ebffbbe81",
      "target_id": "ru-fr81-u057-r0052",
      "tag": "prose",
      "target_sha256": "1cfcf78b7861187642bbbf4ca89d6f376dba6645f9ded96acacf0aa5da5b32f4"
    },
    {
      "source_id": "fr81-u057-r0053",
      "target": "Господин мэр вышел минуты две-три назад, когда дверь снова отворилась: это был господин мэр.",
      "source_sha256": "3246e76d1794f1fe48492db667b1ea06368962e3bd1366c64de6c7b138c1be92",
      "target_id": "ru-fr81-u057-r0053",
      "tag": "prose",
      "target_sha256": "5bc7f25d3aeb8adaf18cd2926d7cc7e876cc723fbb5c6a47e9422b326adcc735"
    },
    {
      "source_id": "fr81-u057-r0054",
      "target": "У него был всё тот же невозмутимый и озабоченный вид.",
      "source_sha256": "aae258990fad357e188eff840121e371da4a3997c2722f4f5fcf5bde06c42e98",
      "target_id": "ru-fr81-u057-r0054",
      "tag": "prose",
      "target_sha256": "ce2ba0916026455042be78017d4f5455fb40b542e85742ee1ad453a142077227"
    },
    {
      "source_id": "fr81-u057-r0055",
      "target": "— Господин Скауфлер, — сказал он, — во сколько вы оцениваете лошадь и тильбюри, которые вы мне сдадите, одно с другим?",
      "source_sha256": "4187a1307bcdd702d047279381f5a958e1aefe0583518026e6ac7f774cf2e780",
      "target_id": "ru-fr81-u057-r0055",
      "tag": "prose",
      "target_sha256": "9431db7a456071be57ddaefde14d663db6479a7e16e35bc15098bed25fae3bae"
    },
    {
      "source_id": "fr81-u057-r0056",
      "target": "— Одно за другим, господин мэр, — сказал фламандец, грубо засмеявшись.",
      "source_sha256": "e799450793be1614c55756c52fb6ceb2efa984c39b61aa8ebd9bc5b3a7716070",
      "target_id": "ru-fr81-u057-r0056",
      "tag": "prose",
      "target_sha256": "a00de44c643b68da18d3825cb112b74093580f405f01956f7e022b98a214adb3"
    },
    {
      "source_id": "fr81-u057-r0057",
      "target": "— Пусть так. Ну и что же?",
      "source_sha256": "3bc8c119dbc52da54e782f032cfe47f0d383674c564231ae3e7538bde71af0a5",
      "target_id": "ru-fr81-u057-r0057",
      "tag": "prose",
      "target_sha256": "d087b8fcd072f12b9fba9cae6988553c58f8969e5a8ed158448eed7776a18fc4"
    },
    {
      "source_id": "fr81-u057-r0058",
      "target": "— Уж не хочет ли господин мэр купить их у меня?",
      "source_sha256": "5651073d21b570ba8a2d8961653b0f0710f9e78300dfdb798343c5ae6b940456",
      "target_id": "ru-fr81-u057-r0058",
      "tag": "prose",
      "target_sha256": "108b43a6e32c727070a1cc6ffc808092a73d07aa63dd814aaa2cefdb99de156a"
    },
    {
      "source_id": "fr81-u057-r0059",
      "target": "— Нет; но на всякий случай я хочу обеспечить вам их стоимость. По возвращении вы вернёте мне эту сумму. Во сколько вы оцениваете кабриолет и лошадь?",
      "source_sha256": "a82f50ef4540ab6e40d90e4a325561fc9424e62de0f157b657ac1922acd24147",
      "target_id": "ru-fr81-u057-r0059",
      "tag": "prose",
      "target_sha256": "d8e3089b199893e1c38563261b869dd3d8586b1d98dd288c20deb58ca5391566"
    },
    {
      "source_id": "fr81-u057-r0060",
      "target": "— В пятьсот франков, господин мэр.",
      "source_sha256": "8461fa00df3b697caddcf945fa73cbbca4094460b50cad7188c43fa6acbadb2e",
      "target_id": "ru-fr81-u057-r0060",
      "tag": "prose",
      "target_sha256": "83a7dcc276e701bde2331d316ec702a41aea14a567eeb1aec02318364bd40c53"
    },
    {
      "source_id": "fr81-u057-r0061",
      "target": "— Вот они.",
      "source_sha256": "4c1eb06273bba30d9700fe2987cf1ac15cb47126c6dc0a0ca8cffb23f339b795",
      "target_id": "ru-fr81-u057-r0061",
      "tag": "prose",
      "target_sha256": "a5f72542007343d4a0e3894fdb3ea093d956a7e7f6c4558ebcbdf4d06aa42fa6"
    },
    {
      "source_id": "fr81-u057-r0062",
      "target": "Господин Мадлен положил на стол банковский билет, затем вышел и на этот раз уже не возвращался.",
      "source_sha256": "d2cb11e6db97ed7e26be55ad8b873594712d58f727ac2cf3d7b979f515422a89",
      "target_id": "ru-fr81-u057-r0062",
      "tag": "prose",
      "target_sha256": "720813c5f170efcdaf1fa9b2d019945770c74e8c39ff0e6a8ae4ebf3eebded90"
    },
    {
      "source_id": "fr81-u057-r0063",
      "target": "Мэтр Скауфлер ужасно пожалел, что не назвал тысячу франков. Впрочем, лошадь и тильбюри вместе стоили сто экю.",
      "source_sha256": "849c3634706395c7ca8d8477292ae0157b4a4a0a216b4f064ac27ac05d4ca179",
      "target_id": "ru-fr81-u057-r0063",
      "tag": "prose",
      "target_sha256": "6b95e1e2dc25f4a18e62ed73b4fec58649068be9c4ef5d84fb0cdeeeebacb731"
    }
  ],
