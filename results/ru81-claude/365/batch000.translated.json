{
  "unit": 365,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u365-h",
      "target": "V. Ночь, за которой брезжит день",
      "source_sha256": "acb05c581585329f047d2b117425fb5f2543321a9d8ce552598c7d84e79a8e7d",
      "target_id": "ru-fr81-u365-h",
      "tag": "heading",
      "target_sha256": "8a0acf9700727b1bc1afbd231dd16847d4af0459b0d8a325f268761e4a296e60"
    },
    {
      "source_id": "fr81-u365-r0001",
      "target": "Услышав стук в дверь, Жан Вальжан обернулся.",
      "source_sha256": "6f8c82ed6eea25107c8f855019137f9d82be42e1399cbceffda07bb290aba372",
      "target_id": "ru-fr81-u365-r0001",
      "tag": "prose",
      "target_sha256": "146ad2e7633433ccd150e6d7f280d317bcb98e47b9e4350791ec7b84c82f7df1"
    },
    {
      "source_id": "fr81-u365-r0002",
      "target": "— Войдите, — слабо сказал он.",
      "source_sha256": "a2f698247e922836ac58a67141ee882f474f17fc67ebcd2b016de41f8523eb4d",
      "target_id": "ru-fr81-u365-r0002",
      "tag": "prose",
      "target_sha256": "4f24c46741aa9691c2f52fcdb9f1f45e13b2a610caed71f27213e8048f022c9e"
    },
    {
      "source_id": "fr81-u365-r0003",
      "target": "Дверь отворилась. Вошли Козетта и Мариус.",
      "source_sha256": "b464a657a6a5b402c096678a4ce4f0c1d1552cd92e0cf62a02830cd6522167fb",
      "target_id": "ru-fr81-u365-r0003",
      "tag": "prose",
      "target_sha256": "507363754b121f2df54f3ea1b6187812a5fe0d4986176f4d83beb142e4eb104f"
    },
    {
      "source_id": "fr81-u365-r0004",
      "target": "Козетта бросилась в комнату.",
      "source_sha256": "41aec41c4018cf5f470dfb3efe9cbc743c17b94fd03fc9806aeb2c4134598b23",
      "target_id": "ru-fr81-u365-r0004",
      "tag": "prose",
      "target_sha256": "00ab0fbd3610032f354725ed31a345be8c91804066771b17b749ad4d39b73c4b"
    },
    {
      "source_id": "fr81-u365-r0005",
      "target": "Мариус остался на пороге, прислонившись к косяку двери.",
      "source_sha256": "3563b1ccf96edf468be4a2f2ca52d2b9210a5c7525cbae2addd5f2e7519512b6",
      "target_id": "ru-fr81-u365-r0005",
      "tag": "prose",
      "target_sha256": "eb08cf35d80dc3bb99f4dcee0f330bec9312f11233b796716e7500916314321c"
    },
    {
      "source_id": "fr81-u365-r0006",
      "target": "— Козетта! — сказал Жан Вальжан и поднялся со стула, раскрыв дрожащие руки, изможденный, мертвенно-бледный, зловещий, с огромной радостью в глазах.",
      "source_sha256": "276ff815db61fc62bef34f001ffbad9c5a331e5c717879365b2d70a4a2e6b196",
      "target_id": "ru-fr81-u365-r0006",
      "tag": "prose",
      "target_sha256": "224a5fb72ef2d60b1596f838c4e8faad71afdc3677095b6323594ddc9b2e3091"
    },
    {
      "source_id": "fr81-u365-r0007",
      "target": "Козетта, задохнувшись от волнения, упала на грудь Жана Вальжана.",
      "source_sha256": "a8d1d3872301863d1c9fc78d970d4dff11b5f53bb3bcdd16fdb3365668873447",
      "target_id": "ru-fr81-u365-r0007",
      "tag": "prose",
      "target_sha256": "89de8b9f4223d590a7fae79b607d2885d65816917ae5b0c94e84aa969a3e4c92"
    },
    {
      "source_id": "fr81-u365-r0008",
      "target": "— Отец! — сказала она.",
      "source_sha256": "417d5d5afa8a0304a9665e4cb1142fa33ca27a9bca4d8f7cbe83d9318177bb2b",
      "target_id": "ru-fr81-u365-r0008",
      "tag": "prose",
      "target_sha256": "04bf5601976b803bec12d3c08ff83cd73af4aa46ce703e7ad1ce5aa1759fe49a"
    },
    {
      "source_id": "fr81-u365-r0009",
      "target": "Потрясенный Жан Вальжан лепетал:",
      "source_sha256": "742ce24ec2cac7671ad28fcc2b5d0a89175f10e15cf0c0b70a8f49749f41dd38",
      "target_id": "ru-fr81-u365-r0009",
      "tag": "prose",
      "target_sha256": "180fe96b15c756f67ed4befd6f3f1dc1597a4966e811fd063d94c96153ce18b6"
    },
    {
      "source_id": "fr81-u365-r0010",
      "target": "— Козетта! Она! Вы, сударыня! Это ты! Ах, боже мой!",
      "source_sha256": "3cb528a8833767458b146550af0502c07eb244189c9ead545d3946c3f5d339c3",
      "target_id": "ru-fr81-u365-r0010",
      "tag": "prose",
      "target_sha256": "a233e8154def7c7e2a3972c05c9c95ad3ecf961283e6cf14a2df9f56112fe95c"
    },
    {
      "source_id": "fr81-u365-r0011",
      "target": "И, сжатый в объятиях Козетты, он воскликнул:",
      "source_sha256": "635a9d986793c9ec9539af3fefce1e02d5a4aac034fb5a562786cc05d83defb4",
      "target_id": "ru-fr81-u365-r0011",
      "tag": "prose",
      "target_sha256": "4a310121665981cd240a281dd9bc32fe573ead11e3911d6b459d693959959788"
    },
    {
      "source_id": "fr81-u365-r0012",
      "target": "— Это ты! Ты здесь! Значит, ты меня прощаешь!",
      "source_sha256": "f2c84d1a828096cfcba75fb098211063ab21a720b27aabd9e7328cc8a71589ee",
      "target_id": "ru-fr81-u365-r0012",
      "tag": "prose",
      "target_sha256": "b92d2dd6ca1bd3b3a7c6766c80fc2391ee947c4913d4b6c153018cc9488dab3b"
    },
    {
      "source_id": "fr81-u365-r0013",
      "target": "Мариус, опустив веки, чтобы удержать слезы, сделал шаг и прошептал сквозь губы, судорожно сжатые, чтобы подавить рыдания:",
      "source_sha256": "0a9938aba4effdd5e767560b36d028c536a301b6dc7f4f12bde047ca765d6d24",
      "target_id": "ru-fr81-u365-r0013",
      "tag": "prose",
      "target_sha256": "aebeeeefb425ff9b8b132ae2005bbf67bab7f60c8a54acf5e5084d65a126be49"
    },
    {
      "source_id": "fr81-u365-r0014",
      "target": "— Отец мой!",
      "source_sha256": "0265a58303b0d86c8b84864f6cd348e063db6fc2f639ee57224e29b9e954c9f4",
      "target_id": "ru-fr81-u365-r0014",
      "tag": "prose",
      "target_sha256": "1e0f09fff85749a261c42a96513bbd41f1b62e4407a7e047fbd0a6c314701fda"
    },
    {
      "source_id": "fr81-u365-r0015",
      "target": "— И вы тоже, вы меня прощаете! — сказал Жан Вальжан.",
      "source_sha256": "8844652c93c402978dc9d230092c86d1ff8c56b3eac3d7a633eb4eeb1ab3223d",
      "target_id": "ru-fr81-u365-r0015",
      "tag": "prose",
      "target_sha256": "2846a869d1f88296061d25f22d8aeb8271f4332f3435c4385f7312de476ac26e"
    },
    {
      "source_id": "fr81-u365-r0016",
      "target": "Мариус не нашел ни слова, а Жан Вальжан прибавил: — Благодарю.",
      "source_sha256": "ce20defa3c2e0fde58c3f0ee29e6a90e3539afbd74d50b59f7b124bcfbd47ff8",
      "target_id": "ru-fr81-u365-r0016",
      "tag": "prose",
      "target_sha256": "ca5c753eab93be91f8706f9ba48959cfbf0a216536d4b76e3b8b422e6d577f5a"
    },
    {
      "source_id": "fr81-u365-r0017",
      "target": "Козетта сорвала с себя шаль и бросила шляпу на кровать.",
      "source_sha256": "ed21d893841125bae874671bbf366176cc5df74598e65e95cd622199b63e6310",
      "target_id": "ru-fr81-u365-r0017",
      "tag": "prose",
      "target_sha256": "014f5daa14e0ef727834801288e498e372e7533acde08800995544ffb79b3b44"
    },
    {
      "source_id": "fr81-u365-r0018",
      "target": "— Это мне мешает, — сказала она.",
      "source_sha256": "8d288e27566e623240011cc806887e464ddad72e76ffc3536aea784dca03356e",
      "target_id": "ru-fr81-u365-r0018",
      "tag": "prose",
      "target_sha256": "ebb039dd2a121498d75492f56b684a5e74051de908d054ae64b3b10a42a8337e"
    },
    {
      "source_id": "fr81-u365-r0019",
      "target": "И, усевшись на колени старика, она с чудесной нежностью отвела его белые волосы и поцеловала его в лоб.",
      "source_sha256": "427f059e256fde5ef4171839aa1cd4d1f1cd578c4f134b6bba7653fa3e1f8d42",
      "target_id": "ru-fr81-u365-r0019",
      "tag": "prose",
      "target_sha256": "c3fb8b5fc5cd59232e536bcfeacaebd078015533a8aed1ac70791875aa671e4c"
    },
    {
      "source_id": "fr81-u365-r0020",
      "target": "Жан Вальжан безвольно подчинялся, потерянный.",
      "source_sha256": "0f466eff29d3bb8a9bc73cbfa5b784dc755fb82db3be1ada4dc6732c0a233992",
      "target_id": "ru-fr81-u365-r0020",
      "tag": "prose",
      "target_sha256": "348e70f4439f955675c590515c9bca2012892741f0d2e006b02bee4f1e8968e4"
    },
    {
      "source_id": "fr81-u365-r0021",
      "target": "Козетта, понимавшая лишь очень смутно, удваивала ласки, словно хотела уплатить долг Мариуса.",
      "source_sha256": "ec80e1e9cf76e3d2f715539e5f18b424c5531ba3a397ed52e756af38b70986b3",
      "target_id": "ru-fr81-u365-r0021",
      "tag": "prose",
      "target_sha256": "13971d85afb0c113fb54141b2da26b85cf3c41ad1d5d8add33c839c5eeacd26a"
    },
    {
      "source_id": "fr81-u365-r0022",
      "target": "Жан Вальжан бормотал:",
      "source_sha256": "4f49d2e307deadadfc91c78e089e94915062dcf519ba81ef2c4d638fadd2bc67",
      "target_id": "ru-fr81-u365-r0022",
      "tag": "prose",
      "target_sha256": "6cf96c0aae7b73e1053e7c41cd6b66571ffe1007e4ac6dcc2cca79ce4d79d9aa"
    },
    {
      "source_id": "fr81-u365-r0023",
      "target": "— До чего же глупы люди! Я думал, что больше не увижу ее. Представьте себе, господин Понмерси, что в ту минуту, когда вы вошли, я говорил себе: всё кончено. Вот ее платьице, я несчастный человек, я больше не увижу Козетту, — я говорил это в тот самый миг, когда вы поднимались по лестнице. Каким же я был глупцом! Вот как глупы люди! Но они забывают о милосердном Боге. Милосердный Бог говорит: ты воображаешь, что тебя оставят, дурачок! Нет, нет, так не будет. Ну-ка, там есть бедный старик, которому нужен ангел. И ангел приходит; и вот опять видишь свою Козетту! и вот опять видишь свою маленькую Козетту! Ах, как я был несчастен!",
      "source_sha256": "ecba0697976f40264370092369519a3a45f9497e6c041d19b24601dfaea59d50",
      "target_id": "ru-fr81-u365-r0023",
      "tag": "prose",
      "target_sha256": "0d68bb6629d4aa014af7c2d80ebb931badfc2bd3d17b38149fdc38351f428379"
    },
    {
      "source_id": "fr81-u365-r0024",
      "target": "С минуту он не мог говорить, потом продолжал:",
      "source_sha256": "18671940e93188901cde989315c4d15b639a30a3cc96d4fb3b695ecb427d2ae9",
      "target_id": "ru-fr81-u365-r0024",
      "tag": "prose",
      "target_sha256": "c20047d7570ce8a33a84ad3b93480641d7f90d4c9b89882b03c16784e75b70f8"
    },
    {
      "source_id": "fr81-u365-r0025",
      "target": "— Мне и вправду было нужно видеть Козетту хоть изредка, хоть чуточку. Сердцу нужна кость, чтобы грызть. А все-таки я хорошо чувствовал, что я лишний. Я приводил себе доводы: ты им не нужен, сиди в своем углу, нет права навязываться навсегда. Ах! Благословенный Бог, я вижу ее снова! Знаешь ли, Козетта, что твой муж очень красив? Ах! у тебя красивый вышитый воротничок, вот и прекрасно. Мне нравится этот узор. Ведь его выбрал твой муж, не правда ли? А потом, тебе понадобятся кашемировые шали. Господин Понмерси, позвольте мне говорить ей «ты». Это ненадолго.",
      "source_sha256": "b71ea6c67a10ba2bf6fe00c022e05ecfe0f017074664f810d7b418f099852883",
      "target_id": "ru-fr81-u365-r0025",
      "tag": "prose",
      "target_sha256": "0f5dc0227446b99b13f274143235b5827fe03a764121fce33d81547a2f7550ad"
    },
    {
      "source_id": "fr81-u365-r0026",
      "target": "А Козетта продолжала:",
      "source_sha256": "2a59d7cbebb5172449dfdae803a77b590f7e80ce66da9695f3b2f8ddc1f4b21a",
      "target_id": "ru-fr81-u365-r0026",
      "tag": "prose",
      "target_sha256": "cf8a450597418926b7705fb9ed6b8f31a315aada69c1ff09f5925baadb43122c"
    },
    {
      "source_id": "fr81-u365-r0027",
      "target": "— Как это жестоко — оставить нас так! Куда же вы уезжали? Почему так долго пропадали? Прежде ваши поездки не длились больше трех-четырех дней. Я посылала Николетту, ей всё отвечали: его нет. Давно ли вы вернулись? Почему вы не дали нам знать? Знаете ли, что вы очень изменились? Ах, гадкий отец! Он болел, а мы и не знали! Смотри, Мариус, потрогай его руку, какая она холодная!",
      "source_sha256": "5a4cf5bdce4a895259f7e62c69fbf309b5d5c8b67338778f646b427fe052103f",
      "target_id": "ru-fr81-u365-r0027",
      "tag": "prose",
      "target_sha256": "62b002f8a04a1e25e0bb059f29824361492c0fe5ea55412bb074358af50f9017"
    },
    {
      "source_id": "fr81-u365-r0028",
      "target": "— Итак, вы здесь! Господин Понмерси, вы меня прощаете! — повторил Жан Вальжан.",
      "source_sha256": "942e4af3353589f2205e0aadaede194d6ef80af57eae13d84a66d68b20904948",
      "target_id": "ru-fr81-u365-r0028",
      "tag": "prose",
      "target_sha256": "d955d27fe88c96695a6f6319584d8fa83c016c2aa5b0b0dc09265e28bfebf032"
    },
    {
      "source_id": "fr81-u365-r0029",
      "target": "При этом слове, которое Жан Вальжан только что повторил, всё, что распирало сердце Мариуса, нашло выход, и он разразился:",
      "source_sha256": "2df061b946756b4a2b452925b24650e2fe7a3ba9d0e3c1d358ea3e7a2b07636e",
      "target_id": "ru-fr81-u365-r0029",
      "tag": "prose",
      "target_sha256": "bc7edbacc7eb67bb1cca8a1b56d2b779b10a886d9737b742dc9a50a1ab03fa93"
    },
    {
      "source_id": "fr81-u365-r0030",
      "target": "— Козетта, слышишь? Он дошел до этого! Он просит у меня прощения. А знаешь ли ты, что он сделал для меня, Козетта? Он спас мне жизнь. Он сделал больше. Он отдал тебя мне. И после того как он спас меня и отдал тебя мне, Козетта, что он сделал с самим собой? Он принес себя в жертву. Вот этот человек. А мне, неблагодарному, мне, забывчивому, мне, безжалостному, мне, виновному, он говорит: «Благодарю!» Козетта, вся моя жизнь, проведенная у ног этого человека, будет слишком малой платой. Эта баррикада, эта клоака, эта пылающая печь, эта сточная яма — он прошел через всё это ради меня, ради тебя, Козетта! Он пронес меня сквозь все смерти, которые отводил от меня и принимал на себя. Всё мужество, все добродетели, весь героизм, вся святость — всё это в нем! Козетта, этот человек — ангел!",
      "source_sha256": "28b3a00f62d60ac925552ef8456960df9f5e9bc540386411d9ecc7b52ab04f20",
      "target_id": "ru-fr81-u365-r0030",
      "tag": "prose",
      "target_sha256": "76947a596024c1cb72a1ec41c55e44cc70cb4af29a460dee26e4bb0a8491955e"
    },
    {
      "source_id": "fr81-u365-r0031",
      "target": "— Тише! Тише! — совсем тихо сказал Жан Вальжан. — Зачем говорить всё это?",
      "source_sha256": "a1465b6c222804a898e74cd128d9a3f2e1d74bdce068fe076abf700bc7dae226",
      "target_id": "ru-fr81-u365-r0031",
      "tag": "prose",
      "target_sha256": "dbf425843e26e7124fcc824ec9ead50bc878ded6325f67ece85c8736338ed439"
    }
  ],
