{
  "unit": 178,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u178-r0032",
      "target": "— Мне так жаль…",
      "source_sha256": "6c0606dda9f8ea2c697e4a40fbe048ac3d33be83ea091e8bbc2ec788f356e556",
      "target_id": "ru-fr81-u178-r0032",
      "tag": "prose",
      "target_sha256": "c4893e43400d35b544489300111e1f7e9906358450c50f17de9a3ff9d0546490"
    },
    {
      "source_id": "fr81-u178-r0033",
      "target": "— Молодой человек, — сказал Лэгль из Мо, — пусть это послужит вам уроком. В будущем будьте аккуратны.",
      "source_sha256": "0cac279ddd1c2f211203be870479af4a6d0bdb06deca1b3609c1fa40e5092b0d",
      "target_id": "ru-fr81-u178-r0033",
      "tag": "prose",
      "target_sha256": "3d4d8f91d8afcaaee317d47ff24f4c7868cabc7b143904a70291d709f1bd117c"
    },
    {
      "source_id": "fr81-u178-r0034",
      "target": "— Я правда прошу у вас тысячу извинений.",
      "source_sha256": "0f9f0d7ada5ab62f609ed885838143d486725fc5500697c0e02c224538c6c0cb",
      "target_id": "ru-fr81-u178-r0034",
      "tag": "prose",
      "target_sha256": "414006b237176ea4fa96d6bbf31d6b1921aca1b42ad49bf3118892b07a3d8de0"
    },
    {
      "source_id": "fr81-u178-r0035",
      "target": "— Больше не рискуйте тем, чтобы из-за вас вычеркнули вашего ближнего.",
      "source_sha256": "5c20b15ce7b3149c739b8dd225097d53c22e6f2a19671d0ae3c7e8c6a7814c81",
      "target_id": "ru-fr81-u178-r0035",
      "tag": "prose",
      "target_sha256": "7d18d229b45fbf16040697393465277e702ec5e9ebaa9bce5b5866cb29c29c26"
    },
    {
      "source_id": "fr81-u178-r0036",
      "target": "— Я в отчаянии…",
      "source_sha256": "2042c4fdc28ca025a83d99c080ac1a0ab2f0cd32ff541365737bf5e113a66f57",
      "target_id": "ru-fr81-u178-r0036",
      "tag": "prose",
      "target_sha256": "852e5d7743eb321500d74dc9d1a16843c4f0b38fec5a5e6d2b8e0b5bbdd0b496"
    },
    {
      "source_id": "fr81-u178-r0037",
      "target": "Лэгль расхохотался.",
      "source_sha256": "9842c31495e724532db7f3df368b423ed59657320dd62c09c56185875693a47e",
      "target_id": "ru-fr81-u178-r0037",
      "tag": "prose",
      "target_sha256": "e387f3e75ff57d855b26ffa221076e25ad06f14840075de9e5c725b387a5a6a9"
    },
    {
      "source_id": "fr81-u178-r0038",
      "target": "— А я в восторге. Я был на пути к тому, чтобы стать адвокатом. Это вычёркивание меня спасает. Я отказываюсь от триумфов адвокатуры. Я не стану защищать вдову и не стану нападать на сироту. Прощай, мантия, прощай, стажировка. Вот и исключение получено. Этим я обязан вам, господин Понмерси. Намерен нанести вам торжественный визит с благодарностью. Где вы живёте?",
      "source_sha256": "788ae65cf952c6368d0f5b7cf6a7a85a15e2aef5d60c36413f46def2b5017659",
      "target_id": "ru-fr81-u178-r0038",
      "tag": "prose",
      "target_sha256": "66b1fbe762646537f03ee5bb3881b7a0d4f5047248278997706530365ca97afc"
    },
    {
      "source_id": "fr81-u178-r0039",
      "target": "— В этом кабриолете, — сказал Мариус.",
      "source_sha256": "de0bc170412745831ae53e4c91d8b0841460c7ecfac0e3e4125195362e42363e",
      "target_id": "ru-fr81-u178-r0039",
      "tag": "prose",
      "target_sha256": "a213f7cccc9eba410b5866c42f9cd3750522a4727f4f0e30a7ab82b4e5ae1ac9"
    },
    {
      "source_id": "fr81-u178-r0040",
      "target": "— Признак богатства, — спокойно возразил Лэгль. — Поздравляю вас. Это жилище обходится вам в девять тысяч франков в год.",
      "source_sha256": "c85909c4da785e47f2dbe891cc2580263efcec1dc307838f724797355aff2fab",
      "target_id": "ru-fr81-u178-r0040",
      "tag": "prose",
      "target_sha256": "5c94bf74fc63ddef243372843afa4ac8a8664ee466975161cb1c6ea20775c1a2"
    },
    {
      "source_id": "fr81-u178-r0041",
      "target": "В эту минуту Курфейрак вышел из кафе.",
      "source_sha256": "88759607385ca562e8eb3eb028dfe4ed85f10252601bc628b87bc6d5144846bf",
      "target_id": "ru-fr81-u178-r0041",
      "tag": "prose",
      "target_sha256": "c8ea9f540f20bdae2dc77e4fdf96b7ffe3c1fca8499ece5cf93772316ae94a21"
    },
    {
      "source_id": "fr81-u178-r0042",
      "target": "Мариус печально улыбнулся.",
      "source_sha256": "818a37c0c38e22170da3793d9b4fa05b2645540d6bf1b264b82324bee2f199ff",
      "target_id": "ru-fr81-u178-r0042",
      "tag": "prose",
      "target_sha256": "faeaf6f99d2debec3f9c7acb7f38ed2c1011abd18df51ef61bef725b35c12c15"
    },
    {
      "source_id": "fr81-u178-r0043",
      "target": "— Я живу в этом жилище уже два часа и стремлюсь из него выбраться; но такая уж это история: я не знаю, куда идти.",
      "source_sha256": "f776318891a26efaa1405b6fd7e93195f084e1a0fd28caabcbb17be6127416c4",
      "target_id": "ru-fr81-u178-r0043",
      "tag": "prose",
      "target_sha256": "26150d2da85e8ed472746f5f41bbd61b1a5ce854ba758ebb22eb744bbe8a204e"
    },
    {
      "source_id": "fr81-u178-r0044",
      "target": "— Сударь, — сказал Курфейрак, — идёмте ко мне.",
      "source_sha256": "bdae800c96279323ac419ea32af8f968ee55f146b3d6d98fc55fd1f79880b6ae",
      "target_id": "ru-fr81-u178-r0044",
      "tag": "prose",
      "target_sha256": "38e96c2dcf3c7c81377eea000883d2d7619b0803b293c255e62f8caba040bb58"
    },
    {
      "source_id": "fr81-u178-r0045",
      "target": "— Я имел бы преимущественное право, — заметил Лэгль, — но у меня нет своего угла.",
      "source_sha256": "7d7214fa9ffaf32a1c29a39758aa03fe8a669e19904fc65c41ea9eed075225a6",
      "target_id": "ru-fr81-u178-r0045",
      "tag": "prose",
      "target_sha256": "9b07aa599145747279f67cebd9c3da0190a20085bf2886cf20b60ec5b08dcba4"
    },
    {
      "source_id": "fr81-u178-r0046",
      "target": "— Замолчи, Боссюэ, — снова сказал Курфейрак.",
      "source_sha256": "7389a93c1eaf990e6aaa02a6c0406a7e6592d52eb11f6ac5475db2ade51a996d",
      "target_id": "ru-fr81-u178-r0046",
      "tag": "prose",
      "target_sha256": "c53e7410a710fd3a1826ab91ca7560ff99a150d0a53a47d1c725f97a48a738fb"
    },
    {
      "source_id": "fr81-u178-r0047",
      "target": "— Боссюэ? — переспросил Мариус. — Но мне казалось, вас зовут Лэгль.",
      "source_sha256": "b7cfb871eae77d02bcfaffc176fecd000be6c5c58ac27505be114a5ee73700fe",
      "target_id": "ru-fr81-u178-r0047",
      "tag": "prose",
      "target_sha256": "1a0fd20affb7b5150017809fb38a4d62f66146ecd9a627bd77c63e82d7c3598f"
    },
    {
      "source_id": "fr81-u178-r0048",
      "target": "— Из Мо, — ответил Лэгль, — а метафорически — Боссюэ.",
      "source_sha256": "747da60437393ba9de15025a4786f227057d8df9f1ab8d070a9864d2174726f0",
      "target_id": "ru-fr81-u178-r0048",
      "tag": "prose",
      "target_sha256": "0bcd8eec58d0aeb8c91bf9e3f37923189d03cc61974c78f80d42cdde250bbbab"
    },
    {
      "source_id": "fr81-u178-r0049",
      "target": "Курфейрак сел в кабриолет.",
      "source_sha256": "8f6a6374e26d08e0201fcb91a1e09b334cc95c38b34590bebdc0098e18bceb8d",
      "target_id": "ru-fr81-u178-r0049",
      "tag": "prose",
      "target_sha256": "c2ef5216cd471366ef89ce2c74a7c066b3ccba9b0fdd3ffa8ba14c7608adb040"
    },
    {
      "source_id": "fr81-u178-r0050",
      "target": "— Кучер, — сказал он, — в гостиницу «Порт-Сен-Жак».",
      "source_sha256": "6e4096b9966ad75b87ebf0d50d3516f1d5272a929bc7661d633857601c66b090",
      "target_id": "ru-fr81-u178-r0050",
      "tag": "prose",
      "target_sha256": "e184872a4fb69c7db2f2b9a4b99b9a59b3b4431e66ab9561125209608cc16e4d"
    },
    {
      "source_id": "fr81-u178-r0051",
      "target": "И в тот же вечер Мариус уже обосновался в комнате гостиницы «Порт-Сен-Жак», бок о бок с Курфейраком.",
      "source_sha256": "e27c295727b5ff528421adcc2ca08f64e7579ea874861f8c8a7c64a509166139",
      "target_id": "ru-fr81-u178-r0051",
      "tag": "prose",
      "target_sha256": "80d39605593a18e56d1163376e2450aa8be3b4f4cb07c3260d9e00a5a9d7cb2e"
    }
  ],
