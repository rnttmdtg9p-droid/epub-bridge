{
  "unit": 243,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u243-r0032",
      "target": "Первым следствием раздумий Гавроша было то, что вместо того, чтобы перелезать через изгородь, он присел под ней. Внизу, у корней кустарника, ветви слегка расходились.",
      "source_sha256": "4867db59d7653c61f3c2f12b38c2637cfd811f52a2a627fadde8a73695bacdd6",
      "target_id": "ru-fr81-u243-r0032",
      "tag": "prose",
      "target_sha256": "ad996b575248e227ef0d58efd097dda5f876b746fc802180b611aef3c613b59b"
    },
    {
      "source_id": "fr81-u243-r0033",
      "target": "— Гляди-ка, — воскликнул про себя Гаврош, — альков! — и забился туда. Он почти прислонился спиной к скамье папаши Мабёфа. Он слышал, как дышит восьмидесятилетний старик.",
      "source_sha256": "91773fb53d42716d3f80365399ae279e8de455032ce915b2c876490fc21ccb45",
      "target_id": "ru-fr81-u243-r0033",
      "tag": "prose",
      "target_sha256": "796308d03c44e60a4975ba9f75eafa16168f861ee33fac7b8ed5eda2f19603fe"
    },
    {
      "source_id": "fr81-u243-r0034",
      "target": "Тогда, вместо ужина, он попытался уснуть.",
      "source_sha256": "af154b15f66f59af25d17717baeaf30359abc8cbb25d1c7dbb93b4daf4c20a19",
      "target_id": "ru-fr81-u243-r0034",
      "tag": "prose",
      "target_sha256": "d457726eac3755410db3542e09c34a16b1056e07d51f2e11b264adb647214048"
    },
    {
      "source_id": "fr81-u243-r0035",
      "target": "Сон кошачий, сон вполглаза. Задремывая, Гаврош всё же следил.",
      "source_sha256": "c377d6915d11779890fb84ac6282c15708c76555bfc492717b16c61a1f5a8d5c",
      "target_id": "ru-fr81-u243-r0035",
      "tag": "prose",
      "target_sha256": "d8f712a5ee25ccf59b73f54be98d25ed2039648ab6dedb0818c41da99a699b82"
    },
    {
      "source_id": "fr81-u243-r0036",
      "target": "Белизна сумеречного неба белила землю, и тропинка протянулась мертвенной полосой между двумя рядами тёмных кустов.",
      "source_sha256": "7dda9beed9ee391320f9d2f5577954932a74dc3e44d0ff8460ee3b74bd868926",
      "target_id": "ru-fr81-u243-r0036",
      "tag": "prose",
      "target_sha256": "0afb3a16f002d825a1915c26b8c3a6e78fe331e702f66011d7e79e6dc905a99b"
    },
    {
      "source_id": "fr81-u243-r0037",
      "target": "Внезапно на этой белесой ленте показались два силуэта. Один шёл впереди, другой — на некотором расстоянии позади.",
      "source_sha256": "9294b7cc4ece6fcc0a29f8867aaa2711deffa2255b098aecb0319c3cec4ca228",
      "target_id": "ru-fr81-u243-r0037",
      "tag": "prose",
      "target_sha256": "0f53f7b0493d2beb94b62e7f672bd05a05389472e0dd41ebd5778b89eb1f40f6"
    },
    {
      "source_id": "fr81-u243-r0038",
      "target": "— Вот и двое, — проворчал Гаврош.",
      "source_sha256": "a9ce0d9b62040f42734f9414ca12bb4bd9939cb94b20258115ddb7909ff1cd9b",
      "target_id": "ru-fr81-u243-r0038",
      "tag": "prose",
      "target_sha256": "0791b2fc47706b25837b238a89659e0c9ccc5942c823a0c66ea4c2f22fd2f91d"
    },
    {
      "source_id": "fr81-u243-r0039",
      "target": "Первый силуэт казался каким-то старым буржуа, согбенным и задумчивым, одетым более чем просто, идущим медленно по причине возраста и бродящим вечером под звёздами.",
      "source_sha256": "9595550439a8e628209fdeb4b6289c5a0677a45abc12cdf2d7202605bb44a645",
      "target_id": "ru-fr81-u243-r0039",
      "tag": "prose",
      "target_sha256": "e1381589fff2c1ae5ab037a2daf3b00d478ae5dcf716ab3c1cdb8f5b4cf4bc79"
    },
    {
      "source_id": "fr81-u243-r0040",
      "target": "Второй был прям, твёрд и строен. Он соразмерял свой шаг с шагом первого, но в намеренной медлительности походки чувствовались гибкость и ловкость. В этом силуэте, при некоей дикости и тревожности, была вся повадка того, кого тогда называли щёголем: шляпа хорошей формы, чёрный, хорошо скроенный сюртук, вероятно из красивого сукна, туго стянутый в талии. Голова поднималась с какой-то крепкой грацией, а из-под шляпы в сумерках виднелся бледный профиль юноши. У этого профиля во рту была роза. Второй силуэт был хорошо знаком Гаврошу; это был Монпарнас.",
      "source_sha256": "726afbb369b644c771d96878e425eb6cbc04e9c0dbe230600a71cc52013cefb6",
      "target_id": "ru-fr81-u243-r0040",
      "tag": "prose",
      "target_sha256": "30b18eebffd38421b547b928c679e2ae88d5e4057f30abfccc8a712bddfefdda"
    },
    {
      "source_id": "fr81-u243-r0041",
      "target": "Что до другого, о нём он не мог бы сказать ничего, кроме того, что это старикашка.",
      "source_sha256": "51be38e613693716f08f49a87bfd37c3bfbbc34ef3fad0856a6a46e55926e9bd",
      "target_id": "ru-fr81-u243-r0041",
      "tag": "prose",
      "target_sha256": "b14a90facc8d13e2b70c4f60bf381e4d509bbecadb84a265b8e6109a67ec61ad"
    },
    {
      "source_id": "fr81-u243-r0042",
      "target": "Гаврош тотчас принялся наблюдать.",
      "source_sha256": "b8cefeb7737820bdf3143d9af160f6f47f60c99e6aea1b733bad7c694e3f4cfc",
      "target_id": "ru-fr81-u243-r0042",
      "tag": "prose",
      "target_sha256": "14730360166a3afb113d3098868ade75d9e89cc01c03a7e8a81973ac39683984"
    },
    {
      "source_id": "fr81-u243-r0043",
      "target": "Один из этих двух прохожих явно имел виды на другого. Гаврош очень удачно расположился, чтобы видеть продолжение. Альков как нельзя более кстати стал укрытием.",
      "source_sha256": "a88a76008307d8a9c5c099f4c368f33197dfc02fe5f2a1f20b0c5268e34c78ad",
      "target_id": "ru-fr81-u243-r0043",
      "tag": "prose",
      "target_sha256": "32f659a465a0b9a03bfde897dbeb0dd621114dc363d88f2f175731dc5ec18f28"
    },
    {
      "source_id": "fr81-u243-r0044",
      "target": "Монпарнас на охоте, в такой час, в таком месте — это было грозно. Гаврош чувствовал, как его мальчишеское нутро волнуется жалостью к старику.",
      "source_sha256": "2c656a212441f11299221dba4c58d1a30f0ab1ca9c7c9f2ec39834f7291adce7",
      "target_id": "ru-fr81-u243-r0044",
      "tag": "prose",
      "target_sha256": "02bf695fe3186d6628f74162fd82429cba2fb813c040ac94d0f49cd90acf88dd"
    },
    {
      "source_id": "fr81-u243-r0045",
      "target": "Что делать? Вмешаться? Одна слабость на выручку другой! Монпарнасу было бы над чем посмеяться. Гаврош не скрывал от себя, что для этого грозного восемнадцатилетнего бандита старик сначала, а ребёнок потом — это два глотка.",
      "source_sha256": "4c105b813f642bc455743391cded0a47027c2d23001c9ea1ac15b7a8e67d02e3",
      "target_id": "ru-fr81-u243-r0045",
      "tag": "prose",
      "target_sha256": "66a2ec3b4908758ec9e3be77dfba4820eb5e26dfca1a1ba6010b99592002eddd"
    },
    {
      "source_id": "fr81-u243-r0046",
      "target": "Пока Гаврош раздумывал, нападение совершилось, внезапное и омерзительное. Нападение тигра на онагра, нападение паука на муху. Монпарнас, вдруг, бросил розу, прыгнул на старика, схватил его за ворот, вцепился и повис на нём, и Гаврош едва удержал крик. Мгновение спустя один из этих людей лежал под другим, придавленный, хрипящий, бьющийся, с мраморным коленом на груди. Только это было не совсем то, чего ожидал Гаврош. Тот, кто был на земле, оказался Монпарнасом; тот, кто был сверху, — стариком.",
      "source_sha256": "786f36e78504d3adc3981e29aa77b5bb75e064efece69e7fb88634a843c322c3",
      "target_id": "ru-fr81-u243-r0046",
      "tag": "prose",
      "target_sha256": "130de2d6024939e970c3aeae9a817071c21059b959ce103385b42de25fc7c3cd"
    },
    {
      "source_id": "fr81-u243-r0047",
      "target": "Всё это происходило в нескольких шагах от Гавроша.",
      "source_sha256": "78d69ef7d832925f548ca5d48c156eeddcb54aeb9e25f5942ac9d48af64a2ec5",
      "target_id": "ru-fr81-u243-r0047",
      "tag": "prose",
      "target_sha256": "8d030d8d53dedc0016851173502d6339de37636774774b66bc81c7db9b82d800"
    },
    {
      "source_id": "fr81-u243-r0048",
      "target": "Старик принял удар и отдал его, и отдал так страшно, что в мгновение ока нападавший и тот, на кого напали, поменялись ролями.",
      "source_sha256": "710cde11507a81b44ae8643c4e1a95b4e01781585b613cf72d02d0708374254e",
      "target_id": "ru-fr81-u243-r0048",
      "tag": "prose",
      "target_sha256": "9d3dab7a9880df2101151dc3e225f06703073d271b5dcdcd6917ba55db14385f"
    },
    {
      "source_id": "fr81-u243-r0049",
      "target": "— Ну и бравый инвалид! — подумал Гаврош.",
      "source_sha256": "1fdca679daf386d9cbabd626e2e9a89bfaac2d7215c015925521346f78eaf328",
      "target_id": "ru-fr81-u243-r0049",
      "tag": "prose",
      "target_sha256": "57ba4cff00be754ea4e834b863c1e9adb7729cff81595384687b9f32d8f8438b"
    },
    {
      "source_id": "fr81-u243-r0050",
      "target": "И он не удержался и захлопал в ладоши. Но хлопки пропали даром. Они не дошли до двух борцов, поглощённых друг другом, оглушённых друг другом и смешивающих в схватке своё дыхание.",
      "source_sha256": "d3b4ff5aefd78b604254916f6d48cc637c133a05443cea55b0bafaeef3e7b3e0",
      "target_id": "ru-fr81-u243-r0050",
      "tag": "prose",
      "target_sha256": "22e0fb5353785bdfd63e899c276b26bd3892c726e9adac62ca3afe699421c276"
    },
    {
      "source_id": "fr81-u243-r0051",
      "target": "Наступила тишина. Монпарнас перестал биться. Гаврош сказал про себя: «Он что, помер?»",
      "source_sha256": "bfe90f1d6a093ed0bb30429705db5401cfd5ec99c7090d7e54b3ce86c12be434",
      "target_id": "ru-fr81-u243-r0051",
      "tag": "prose",
      "target_sha256": "661d3794cde1f1c454671baa06e8139eb64301a0182e527adbb3b8911fd174fa"
    },
    {
      "source_id": "fr81-u243-r0052",
      "target": "Старик не произнёс ни слова и не вскрикнул. Он выпрямился, и Гаврош услышал, как он говорит Монпарнасу:",
      "source_sha256": "a5fcb4c9eff7d74ed7170fe4509fcdb8d48eba3fee8b9905d2040ff1edabdf4f",
      "target_id": "ru-fr81-u243-r0052",
      "tag": "prose",
      "target_sha256": "3e5c737be279e752ab9809e9f180b0b55b8643e61a1c05a82531918ff35c58c8"
    },
    {
      "source_id": "fr81-u243-r0053",
      "target": "— Встань.",
      "source_sha256": "e59f520ef2a36cbd3e5709082d2e0d4b34beb93e11597a829f07b1b7b2ee7316",
      "target_id": "ru-fr81-u243-r0053",
      "tag": "prose",
      "target_sha256": "e72a6a55b7ca774e7551337e1d8dab70c1dfd606df1af04cdb42573bc7977e0f"
    },
    {
      "source_id": "fr81-u243-r0054",
      "target": "Монпарнас встал, но старик держал его. Вид у Монпарнаса был униженный и яростный, как у волка, которого схватила овца.",
      "source_sha256": "fb2de99286a27686217e6dc87d0f1c1d2974c3caeaf38a8d96d5c65c204e975e",
      "target_id": "ru-fr81-u243-r0054",
      "tag": "prose",
      "target_sha256": "aa9ad782af0be9dc5db3c5e1fc280a6553e1b4daebdf5354e91c9288fee77de5"
    },
    {
      "source_id": "fr81-u243-r0055",
      "target": "Гаврош смотрел и слушал, силясь удвоить зрение слухом. Он безмерно забавлялся.",
      "source_sha256": "0b0a0840e0b26e929a2f2a04d9b11a5d1a545b57024d222ade38106e25e99f6b",
      "target_id": "ru-fr81-u243-r0055",
      "tag": "prose",
      "target_sha256": "31c77ef2651e355c7d34eee3621334173f710c8a24f93bcbe2443f3385c0a110"
    },
    {
      "source_id": "fr81-u243-r0056",
      "target": "Он был вознаграждён за добросовестную тревогу зрителя. Ему удалось поймать на лету этот разговор, который от темноты приобретал какой-то трагический оттенок. Старик спрашивал. Монпарнас отвечал.",
      "source_sha256": "9988d83dd982d898aececc11fb9dde56be559b21635ba0fdcfca76cb864268df",
      "target_id": "ru-fr81-u243-r0056",
      "tag": "prose",
      "target_sha256": "c5da472741b15ea1c182b61f73034fa2d9a590d6349df8baf296893be77ba498"
    },
    {
      "source_id": "fr81-u243-r0057",
      "target": "— Сколько тебе лет?",
      "source_sha256": "cfac2c8c1dd5b843612d907cf1b8fd2c99be305094f52c5f7a5e76f8c00bce57",
      "target_id": "ru-fr81-u243-r0057",
      "tag": "prose",
      "target_sha256": "301128c8dca8ce89da6f2e529ee03ea0c9ab6f9e10a54dc3cff7d5c9e6d7a34c"
    },
    {
      "source_id": "fr81-u243-r0058",
      "target": "— Девятнадцать.",
      "source_sha256": "9c85f48901fd0c4124ee71a6d1e3b9dcb3a0affdbbf8f86a54c6e78fd2a1702e",
      "target_id": "ru-fr81-u243-r0058",
      "tag": "prose",
      "target_sha256": "b121ef177c171848e1d79cb8fe7c3bc6051731f865c0a9c898a2ded18fb206c1"
    },
    {
      "source_id": "fr81-u243-r0059",
      "target": "— Ты силён и здоров. Почему ты не работаешь?",
      "source_sha256": "68f042159345ab4a794562621132293907e663bce22280ec05f196dc169e460b",
      "target_id": "ru-fr81-u243-r0059",
      "tag": "prose",
      "target_sha256": "4497375e589fcd67b41d4024fec5d7a33a03a8a629d94e25890a78105c90e57e"
    },
    {
      "source_id": "fr81-u243-r0060",
      "target": "— Скучно.",
      "source_sha256": "6382caa29f0dc15af35e7ad643a74e9b2da5c7aa9d98ea7b212d44497e0eebf3",
      "target_id": "ru-fr81-u243-r0060",
      "tag": "prose",
      "target_sha256": "3eb43d5da44e50e682670295efe08d0f2b6b5073ef59071bd7e966643fa5095d"
    },
    {
      "source_id": "fr81-u243-r0061",
      "target": "— Какое у тебя ремесло?",
      "source_sha256": "f4249469bd7e71b6e0fc0b654c9fbd9fd4d0ee8063f574361170e75294907e57",
      "target_id": "ru-fr81-u243-r0061",
      "tag": "prose",
      "target_sha256": "74fa818011f70e8a3202e6da4d4adc3dd8bb3b89272d6c20e8a0981a8569a8be"
    },
    {
      "source_id": "fr81-u243-r0062",
      "target": "— Бездельник.",
      "source_sha256": "8e71286adb35d5cb508fa8359cf500eb24726ac728fc008e948385c54539e0fe",
      "target_id": "ru-fr81-u243-r0062",
      "tag": "prose",
      "target_sha256": "2888bdc832be3ba9e9282a31e63d73a49ce91fd8c8801d6cfadf75b0565d6b94"
    },
    {
      "source_id": "fr81-u243-r0063",
      "target": "— Говори серьёзно. Можно ли что-нибудь для тебя сделать? Кем ты хочешь быть?",
      "source_sha256": "546a241182cb53399de5d35378bbea19bcfe6ed456a491c1a8a97be736c96352",
      "target_id": "ru-fr81-u243-r0063",
      "tag": "prose",
      "target_sha256": "b46c7e202d688f7c6246e0973c46ede3349e7285bf1e058fdf0adfc5b4d3dfd5"
    }
  ],
