{
  "unit": 219,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u219-h",
      "target": "XVIII. Два стула Мариуса оказываются друг против друга",
      "source_sha256": "a24c86fc4acd7354458bc7127aa639821b21dd92183d1ff063a64cd735a38cd9",
      "target_id": "ru-fr81-u219-h",
      "tag": "heading",
      "target_sha256": "5f025ee5c0dfb3fed6c85b453dfcbc7138185e05e7716c9ae2ed176eb85cde70"
    },
    {
      "source_id": "fr81-u219-r0001",
      "target": "Вдруг далёкий, печальный гул колокола заставил задрожать стёкла. В Сен-Медаре било шесть часов.",
      "source_sha256": "41c86ae22b8ba2d24643ae85f8b0baaaca1f3f87afaa68bee91ef84dea9b7f8a",
      "target_id": "ru-fr81-u219-r0001",
      "tag": "prose",
      "target_sha256": "be659afdb6473b6cd43811c7f9dd0ded8212d694a6510bb13dde1a8fb8e17c55"
    },
    {
      "source_id": "fr81-u219-r0002",
      "target": "Жондрет отмечал каждый удар кивком головы. Когда пробил шестой, он снял пальцами нагар со свечи.",
      "source_sha256": "9fb5eaf1d63a44746d10a68298ec69e3a77822d731dae6af18c9e635a171522e",
      "target_id": "ru-fr81-u219-r0002",
      "tag": "prose",
      "target_sha256": "d02feeedef0eaeeafce4201f9431f38950dfb35d3c46b6396b6c373a0ebf0880"
    },
    {
      "source_id": "fr81-u219-r0003",
      "target": "Затем он принялся ходить по комнате, прислушался к тому, что делалось в коридоре, снова прошёлся, снова прислушался: — Только бы он пришёл! — проворчал он и вернулся к своему стулу.",
      "source_sha256": "95944ab2b70746e980a08d44c677bc0a7dd8dbeca8c0c8f9df21941031386921",
      "target_id": "ru-fr81-u219-r0003",
      "tag": "prose",
      "target_sha256": "0ff760e5e33523bcb55262038b886210d8127ce9263e201f1f7f3cc63bcaf081"
    },
    {
      "source_id": "fr81-u219-r0004",
      "target": "Едва он успел сесть, как дверь отворилась.",
      "source_sha256": "5d9590fcc03087938691c72a0c83d2b59be30837dd39b84bed97f145e14806b0",
      "target_id": "ru-fr81-u219-r0004",
      "tag": "prose",
      "target_sha256": "19a52c77bc850c91e098e114602008ff6c121e4cb1f5696c6098fb84a5572578"
    },
    {
      "source_id": "fr81-u219-r0005",
      "target": "Её открыла мамаша Жондрет и осталась в коридоре, состроив отвратительную любезную гримасу, которую снизу освещало одно из отверстий потайного фонаря.",
      "source_sha256": "bf22b64d73b05919a40ae5fecedf21b390e830eb242f5ff15fa94fd4aa18472e",
      "target_id": "ru-fr81-u219-r0005",
      "tag": "prose",
      "target_sha256": "7037bcabc4044d4e66355637957860011f77adcce85e804d1949d21683dc7b57"
    },
    {
      "source_id": "fr81-u219-r0006",
      "target": "— Входите, сударь, — сказала она.",
      "source_sha256": "0581c442144b3403395fbcf57c1c43c2176d18e3c14f85d0031eb3a424d5147a",
      "target_id": "ru-fr81-u219-r0006",
      "tag": "prose",
      "target_sha256": "17beb39c8512daa59e0f97bcff928a2a400e25a92439581f21f8db2da3c3c74c"
    },
    {
      "source_id": "fr81-u219-r0007",
      "target": "— Входите, мой благодетель, — повторил Жондрет, поспешно вскакивая.",
      "source_sha256": "ec60614fcbf2f35fe1d05fb79b0f501b61f009be3de7fb253d789a33a92555e4",
      "target_id": "ru-fr81-u219-r0007",
      "tag": "prose",
      "target_sha256": "6f8e31560f3e9b89cbba123163027e0b17df542e2c12a677aed9c5329ee93f16"
    },
    {
      "source_id": "fr81-u219-r0008",
      "target": "Появился господин Леблан.",
      "source_sha256": "2d39fc7d4882c5525eceee1df0ad3878d7f4f4e4952a644ec1b2b151262cdb5a",
      "target_id": "ru-fr81-u219-r0008",
      "tag": "prose",
      "target_sha256": "e65e09368081f2fdeabb8e955190a3e4f70c0048b746a7886bbd4bc333bcbf27"
    },
    {
      "source_id": "fr81-u219-r0009",
      "target": "Вид у него был безмятежный, и это делало его особенно достойным почтения.",
      "source_sha256": "d02d427b09942e422c6bfe99014766199fab50e27c341dbf947320b2233602cc",
      "target_id": "ru-fr81-u219-r0009",
      "tag": "prose",
      "target_sha256": "7b18c8581ec13b64724d21f833a60c2acc6d953fe3317b71ce483dd2c5cb364b"
    },
    {
      "source_id": "fr81-u219-r0010",
      "target": "Он положил на стол четыре луидора.",
      "source_sha256": "6e23fae12010e3e01899a084fcb1406b58cc115db19d8be2dbf94dbad470f068",
      "target_id": "ru-fr81-u219-r0010",
      "tag": "prose",
      "target_sha256": "abab6cce1fddab2c8bcabc972c8201f5654e2cbaccda9600d574af1fff990183"
    },
    {
      "source_id": "fr81-u219-r0011",
      "target": "— Господин Фабанту, — сказал он, — вот для уплаты за квартиру и на первые ваши нужды. Потом посмотрим.",
      "source_sha256": "2f038578debcc2c5a7767650f98f9efbbfb3d05f5105d992d10c7001b6732b94",
      "target_id": "ru-fr81-u219-r0011",
      "tag": "prose",
      "target_sha256": "10a3c75fd86cbc39e7d06c9e37b579dd3660e1208b9a4bb9eb7429bf62da82a8"
    },
    {
      "source_id": "fr81-u219-r0012",
      "target": "— Да воздаст вам Бог, мой великодушный благодетель! — сказал Жондрет и, быстро подойдя к жене, прибавил:",
      "source_sha256": "252ed73018b375381c624309f5e8e017600ece0ac94fd30664d83230f4438ff6",
      "target_id": "ru-fr81-u219-r0012",
      "tag": "prose",
      "target_sha256": "ebc0a4959640b9d03b819c4fddfc9b2ce4afc60ae472c0841c4a6ae6babec34c"
    },
    {
      "source_id": "fr81-u219-r0013",
      "target": "— Отошли фиакр!",
      "source_sha256": "395653719503d2e33018abcfbd75ca13ad8a3ec0e181449b116c0fffa4f6f02e",
      "target_id": "ru-fr81-u219-r0013",
      "tag": "prose",
      "target_sha256": "afe672011e2e1ff13f328c12af6600de9ebf2d11da1b94841077b338b1e1d761"
    },
    {
      "source_id": "fr81-u219-r0014",
      "target": "Она выскользнула за дверь, а муж рассыпался в поклонах и предлагал господину Леблану стул. Через минуту она вернулась и шепнула ему на ухо:",
      "source_sha256": "938c599e69c899bfc006021e8a9f7a4ba6392c2192113a4b1ccd547876879c86",
      "target_id": "ru-fr81-u219-r0014",
      "tag": "prose",
      "target_sha256": "edd60d83c6f32bf21f03520948e84a6180e6295586c8dca7c2d516d5f2cd4014"
    },
    {
      "source_id": "fr81-u219-r0015",
      "target": "— Готово.",
      "source_sha256": "da4bc6840a2f3ae7c6d3b1bb62264c3becfb5e3e67d67d3198bf1b5afcf0dd57",
      "target_id": "ru-fr81-u219-r0015",
      "tag": "prose",
      "target_sha256": "e27560606e5334da9e44c3fa2231910c28af499626f09d6c239e388bd970ed60"
    },
    {
      "source_id": "fr81-u219-r0016",
      "target": "Снег, не переставая падавший с самого утра, лежал таким толстым слоем, что не было слышно, как подъехал фиакр, и не было слышно, как он уехал.",
      "source_sha256": "09c6b38290e126deb012e6fb026ac73dd6cc94e0e2bc7183610cd9fdcb1179fe",
      "target_id": "ru-fr81-u219-r0016",
      "tag": "prose",
      "target_sha256": "31c896615235f805c8e0c8eb1462707fd8064c1fe4350874c0190d692009ab22"
    },
    {
      "source_id": "fr81-u219-r0017",
      "target": "Между тем господин Леблан сел.",
      "source_sha256": "e3f46a003114f9b4536b1bcfdb3b264bf7cdf5c8be98884a0f50915702796b76",
      "target_id": "ru-fr81-u219-r0017",
      "tag": "prose",
      "target_sha256": "21ef5c84b89594a61e99d80b1d94837bf0e62843bbf57b00577937484ef0c737"
    },
    {
      "source_id": "fr81-u219-r0018",
      "target": "Жондрет завладел другим стулом, напротив господина Леблана.",
      "source_sha256": "a27699918e766c1f451e0b60308ccc3d544ccd3211e9629c3382080cf6258335",
      "target_id": "ru-fr81-u219-r0018",
      "tag": "prose",
      "target_sha256": "c8b133cd14ad896f2637cabdfe5fc09b095d71ca545fdc002a9fa1e87290465f"
    },
    {
      "source_id": "fr81-u219-r0019",
      "target": "Теперь, чтобы составить себе представление о сцене, которая последует, пусть читатель вообразит ледяную ночь, безлюдные пустыри Сальпетриер, покрытые снегом и белые в лунном свете, как огромные саваны, тусклый, как лампада, свет фонарей, кое-где окрашивающий в красное эти трагические бульвары и длинные ряды чёрных вязов, быть может, ни одного прохожего на четверть льё вокруг, лачугу Горбо в наивысшей точке её тишины, ужаса и мрака, в этой лачуге, посреди этих пустынь, посреди этой тьмы, просторную мансарду Жондрета, освещённую одной свечой, а в этой берлоге двух человек, сидящих за столом: господина Леблана — спокойного, Жондрета — улыбающегося и страшного, жондретиху, волчицу-мать, в углу, а за перегородкой Мариуса, невидимого, стоящего, не упускающего ни слова, ни движения, с зорким глазом и пистолетом в руке.",
      "source_sha256": "0be75e50b16293924b5620dcfa0b55f524ff2d6ed182a19be5770d59b29101dd",
      "target_id": "ru-fr81-u219-r0019",
      "tag": "prose",
      "target_sha256": "c0cb1b673ba94a5f8d06eed91f83f4b58b651b07b66c6e9f613446e409abfc98"
    },
    {
      "source_id": "fr81-u219-r0020",
      "target": "Впрочем, Мариус испытывал только ужас, но не страх. Он сжимал рукоятку пистолета и чувствовал себя уверенно. — Я остановлю этого негодяя, когда пожелаю, — думал он.",
      "source_sha256": "b62777f97235ddec74fa627bf6ef637623b840df965f84911f459de80073c273",
      "target_id": "ru-fr81-u219-r0020",
      "tag": "prose",
      "target_sha256": "90948a7fa711d0023315c7f8a2b7e2a78e5f164ac9e1c6cecd1a94f7fcf8fcc9"
    },
    {
      "source_id": "fr81-u219-r0021",
      "target": "Он чувствовал, что полиция где-то тут, поблизости, в засаде, ждёт условленного знака и готова протянуть руку.",
      "source_sha256": "8cee213a32f0caf060ee016d9263e8ac50e66060846fc09bf0ae32f8ddadbfe5",
      "target_id": "ru-fr81-u219-r0021",
      "tag": "prose",
      "target_sha256": "e6544f3b00ee826df3151ee96d3838cab3820855e88b5e0ccf1e46d4cff3d830"
    },
    {
      "source_id": "fr81-u219-r0022",
      "target": "К тому же он надеялся, что от этой бурной встречи Жондрета и господина Леблана блеснёт какой-нибудь свет на всё то, что ему было важно узнать.",
      "source_sha256": "1acbe35fbda7ef2f8f1e0302d2b0c9a1628909f34f8f14849f34b003d1b82c40",
      "target_id": "ru-fr81-u219-r0022",
      "tag": "prose",
      "target_sha256": "06a06f297a1582e553c4baa8b3a7c7592f950c9ea15239f077aecd3362d12ad9"
    }
  ],
