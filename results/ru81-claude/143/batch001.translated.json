{
  "unit": 143,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u143-r0032",
      "target": "Фошлеван, совсем бледный, посмотрел на этого Грибье.",
      "source_sha256": "fcb99858b247992bf143ac8eb1dd1ceaf8474f88aa3b30ec83cae2dc90e9eac8",
      "target_id": "ru-fr81-u143-r0032",
      "tag": "prose",
      "target_sha256": "68a8eb31a34b4e1265069e290631a7edb3f48b56fd09302978d5e067f584c9b6"
    },
    {
      "source_id": "fr81-u143-r0033",
      "target": "Это был человек долговязый, тощий, землисто-бледный, совершенно погребальный. Он смахивал на неудавшегося лекаря, ставшего могильщиком.",
      "source_sha256": "bda58217c5f600ba5bce74d8bc55ceded750837019f75d64fb1e7c42286199e0",
      "target_id": "ru-fr81-u143-r0033",
      "tag": "prose",
      "target_sha256": "296a22b4711a87f88b6d99a8d967399264be09904e90be1b905ae191f6d0c497"
    },
    {
      "source_id": "fr81-u143-r0034",
      "target": "Фошлеван расхохотался.",
      "source_sha256": "249bd284b7029fd57349c9f3ff975749ee7b0697fb2926a8bbfdfc913607fd51",
      "target_id": "ru-fr81-u143-r0034",
      "tag": "prose",
      "target_sha256": "4bdf22a87a2db91bfa31f69dbc9246e928cb5b3a23caf4b5e587588aec248e97"
    },
    {
      "source_id": "fr81-u143-r0035",
      "target": "— Ах! Чего только на свете не бывает! Папаша Местьен помер. Малыш папаша Местьен помер, но да здравствует малыш папаша Ленуар! Знаете, что такое малыш папаша Ленуар? Это кувшинчик красного по шесть су, прямо на стойке. Это кувшинчик сюренского, черт побери! Настоящего парижского сюренского! Ах! Помер, старик Местьен! Жаль мне его; он был славный жизнелюб. Но и вы тоже жизнелюб. Не так ли, приятель? Сейчас пойдем вместе пропустим по стаканчику.",
      "source_sha256": "ef2aac64c1af1727613504095c9dd04537dbbfae70cb98fbe7a9a9c70f770a5b",
      "target_id": "ru-fr81-u143-r0035",
      "tag": "prose",
      "target_sha256": "1febb7266c23ccf933377473bbc849c8d3a502895d201a5c04950573a62b24f8"
    },
    {
      "source_id": "fr81-u143-r0036",
      "target": "Человек ответил: — Я учился. Я окончил четвёртый класс. Я никогда не пью.",
      "source_sha256": "b9d9c90872aed5654ed95a237badb29b1cee91cc0ba33623ffc63ba057520736",
      "target_id": "ru-fr81-u143-r0036",
      "tag": "prose",
      "target_sha256": "66c18b4caed7858c2306bc2bc99f9cc0ec7e66892d89bd191f16eb75457e0cb6"
    },
    {
      "source_id": "fr81-u143-r0037",
      "target": "Катафалк снова тронулся и катился по главной аллее кладбища.",
      "source_sha256": "3b50126d01a4c7219d8e8e21c08cd9909f5c9c1ac2594ccd2df7431b9aad2600",
      "target_id": "ru-fr81-u143-r0037",
      "tag": "prose",
      "target_sha256": "13e6a513707641ec746862c37722001fd4cc9ac005b185bb0bc9fd796429905f"
    },
    {
      "source_id": "fr81-u143-r0038",
      "target": "Фошлеван замедлил шаг. Он хромал ещё сильнее от тревоги, чем от своего увечья.",
      "source_sha256": "ae9c6f7fe942866772ae90b43f7fc0b13f05a1d3e5e679cd09fcb0a9fb044347",
      "target_id": "ru-fr81-u143-r0038",
      "tag": "prose",
      "target_sha256": "9a1129fc49ecb689a9055581ae5d40962e876f626366e130852140efb177c77b"
    },
    {
      "source_id": "fr81-u143-r0039",
      "target": "Могильщик шёл впереди него.",
      "source_sha256": "b3295abdac1d0fc76c490cf666bdc7b3d2da73d3510be23883259b54e53382ea",
      "target_id": "ru-fr81-u143-r0039",
      "tag": "prose",
      "target_sha256": "a51c36d99475cfee8b8485771aaaa8ceb19887401e6c307bdd24f576d45eaf68"
    },
    {
      "source_id": "fr81-u143-r0040",
      "target": "Фошлеван ещё раз подверг осмотру неожиданного Грибье.",
      "source_sha256": "46c32d000aab02599759fc3b5233a60e983fe349614da3b0bb8adc68eedc6740",
      "target_id": "ru-fr81-u143-r0040",
      "tag": "prose",
      "target_sha256": "2c8503fcf727289bb58fc89b15f4327771f5b37d1d2a5d63047308385aea3212"
    },
    {
      "source_id": "fr81-u143-r0041",
      "target": "Это был один из тех людей, что в молодости выглядят стариками, а при своей худобе очень сильны.",
      "source_sha256": "1689019a482b341cd4b1bb126e722e8c464e67a5ce4d198a2ee9676ec5cc20c3",
      "target_id": "ru-fr81-u143-r0041",
      "tag": "prose",
      "target_sha256": "9da092943091177be3d8e50f2f26494036c33f94ec44e838ad05cea45ba578f0"
    },
    {
      "source_id": "fr81-u143-r0042",
      "target": "— Приятель! — крикнул Фошлеван.",
      "source_sha256": "597dc7767b84718afe0d0800c86c3adc8cf58e709835f8458a01419ba781b683",
      "target_id": "ru-fr81-u143-r0042",
      "tag": "prose",
      "target_sha256": "e71aca42f4ae20930a939229ce253f4b3f6cc3c319ac242cfbf505b9d49fae8b"
    },
    {
      "source_id": "fr81-u143-r0043",
      "target": "Человек обернулся.",
      "source_sha256": "e937d5121c14eb6c4d12fcec37edf98e74a1854366e895ef5922abb6d7f7a1b2",
      "target_id": "ru-fr81-u143-r0043",
      "tag": "prose",
      "target_sha256": "55a805828ea3efcd5ac5fad2b30783a7681066ba0355d8ed45a1d2afdf8a10ab"
    },
    {
      "source_id": "fr81-u143-r0044",
      "target": "— Я могильщик при монастыре.",
      "source_sha256": "5fa56a79e930b67176e7d9827cf61d9f87fc1e826a3a561e0a7009df741c5279",
      "target_id": "ru-fr81-u143-r0044",
      "tag": "prose",
      "target_sha256": "9d9aeec496b68142b6d92f293be798319b7f7a140a14cd47d10aeb3ec14587dd"
    },
    {
      "source_id": "fr81-u143-r0045",
      "target": "— Мой коллега, — сказал человек.",
      "source_sha256": "6173eeb99fda636a8bc8c89125592698b04230d1a3e3d9f8ec416becfe08c04e",
      "target_id": "ru-fr81-u143-r0045",
      "tag": "prose",
      "target_sha256": "ecfb2e084aef427f0fd9985543b42a4a8066f410e24efce49492b7d13e9d8568"
    },
    {
      "source_id": "fr81-u143-r0046",
      "target": "Фошлеван, неграмотный, но весьма проницательный, понял, что имеет дело с опасной породой, с краснобаем.",
      "source_sha256": "c26f1d0d2ef0af295f62c699bdf0eb715c246aecd9b399151f1df4e53f6c15f6",
      "target_id": "ru-fr81-u143-r0046",
      "tag": "prose",
      "target_sha256": "62f4ef517ea602e6669bad1263b79cc261498486f561117fe03f77d9e1d788dc"
    },
    {
      "source_id": "fr81-u143-r0047",
      "target": "Он проворчал:",
      "source_sha256": "0777a8788ea3de02bf08b063dfbddae8928f9f6e0a102212367795a4c6155081",
      "target_id": "ru-fr81-u143-r0047",
      "tag": "prose",
      "target_sha256": "c5f3dadd3f37c57ff70eb3c1c225b363b2f0ac4346e591450071de344e33834e"
    },
    {
      "source_id": "fr81-u143-r0048",
      "target": "— Выходит, папаша Местьен помер.",
      "source_sha256": "224dfec04b3211f012f1a106fddf69c846777e191d920a448c1271ddbe7f3e7e",
      "target_id": "ru-fr81-u143-r0048",
      "tag": "prose",
      "target_sha256": "3111dbf91335d333ed2dee2f0be0882c4dfc47ffdbe489ed31b16670b9522130"
    },
    {
      "source_id": "fr81-u143-r0049",
      "target": "Человек ответил:",
      "source_sha256": "d07c88f260229f3d9c643231866a419a70a8b343da9f46f09724c6eb598a1a1d",
      "target_id": "ru-fr81-u143-r0049",
      "tag": "prose",
      "target_sha256": "b77f09a8554bd1e32d08ef28735278440855b4ccf186bf124a1f7e1b7c5eee40"
    },
    {
      "source_id": "fr81-u143-r0050",
      "target": "— Окончательно. Господь Бог заглянул в свою книжку сроков платежей. Подошла очередь папаши Местьена. Папаша Местьен помер.",
      "source_sha256": "47982d050d4fe073663112224d395c9f1b0b895b6359b25e8caf0968b1987883",
      "target_id": "ru-fr81-u143-r0050",
      "tag": "prose",
      "target_sha256": "85ee25f0b32bc494623617889ae32255e8d1a2dfb60e311959fecb9ec8e6368a"
    },
    {
      "source_id": "fr81-u143-r0051",
      "target": "Фошлеван машинально повторил:",
      "source_sha256": "39236dda8d0c8a07cee15156eaeae141b7d116d7682dec0aca81993b8ffd5b6f",
      "target_id": "ru-fr81-u143-r0051",
      "tag": "prose",
      "target_sha256": "8ee73316bd2db8428fcfb182fd1cea2e4d540e0c6df9c571b5d46864757b617c"
    },
    {
      "source_id": "fr81-u143-r0052",
      "target": "— Господь Бог…",
      "source_sha256": "c1aef9a3c2669afbda54cae8ffcf420d30453e203351f32df5cc4c251451d83c",
      "target_id": "ru-fr81-u143-r0052",
      "tag": "prose",
      "target_sha256": "b72c9281567fa1aa2bc33efcdffdeb9781dd44e17796198b4ddfba0d57687fe3"
    },
    {
      "source_id": "fr81-u143-r0053",
      "target": "— Господь Бог, — сказал человек веско. — Для философов — Отец вечный; для якобинцев — Верховное Существо.",
      "source_sha256": "8d908f5207ae5d70e9d840f02ff028034e9f19aaec530df6284ed932bf976b36",
      "target_id": "ru-fr81-u143-r0053",
      "tag": "prose",
      "target_sha256": "09ca8ad6ac1f7b0fb0402b27e4a39237255f0f8090090c07c7bb3114ec637616"
    },
    {
      "source_id": "fr81-u143-r0054",
      "target": "— Неужто мы не познакомимся? — пробормотал Фошлеван.",
      "source_sha256": "f63d1bef1f1a87a18123abc7ec26de17cc294b19a87c5cbf33f1ac2774beb22b",
      "target_id": "ru-fr81-u143-r0054",
      "tag": "prose",
      "target_sha256": "7cc01decb160cfbd6df5f7da6f814b2d478d8bcb6679fd89406be91fa77fba2e"
    },
    {
      "source_id": "fr81-u143-r0055",
      "target": "— Мы уже познакомились. Вы крестьянин, я парижанин.",
      "source_sha256": "6535bbd5f3444946cdc3782f41b7360b0599d3da3f630745f70036efe872360a",
      "target_id": "ru-fr81-u143-r0055",
      "tag": "prose",
      "target_sha256": "5d09ffe48a3cd3e3eede30a890e1e0ea07c7df85119f8a83b40488b4745562d9"
    },
    {
      "source_id": "fr81-u143-r0056",
      "target": "— Не знаешь человека, пока не выпьешь с ним вместе. Кто опорожняет стакан, тот опорожняет сердце. Пойдёте со мной выпить. От такого не отказываются.",
      "source_sha256": "178edbf6f1da61d28becbbc1b2e7e5061c1f0a206c034ed67a4b16f1ec995f71",
      "target_id": "ru-fr81-u143-r0056",
      "tag": "prose",
      "target_sha256": "8d7939228f2c04caa21c6c25a184d0bc557ab18c11a65addb45c939c6ce7b9ba"
    },
    {
      "source_id": "fr81-u143-r0057",
      "target": "— Сначала дело.",
      "source_sha256": "deeb427086dfd728ad613f45adf6f4ef351d9b00c69a4437bc1d1da62af75705",
      "target_id": "ru-fr81-u143-r0057",
      "tag": "prose",
      "target_sha256": "938783d79da3694be24988cdd93ec74b22cec0c81d4920b608964e9c44a59421"
    },
    {
      "source_id": "fr81-u143-r0058",
      "target": "Фошлеван подумал: «Я пропал».",
      "source_sha256": "eb8972ac609149f4ed86255d4ca5e84ef123ba09b0baa2c01c192fa6efd322b6",
      "target_id": "ru-fr81-u143-r0058",
      "tag": "prose",
      "target_sha256": "37b6199bd5ab33b107971686d5a12a677102750e9da2fffaa8368d2ce6f47eeb"
    },
    {
      "source_id": "fr81-u143-r0059",
      "target": "До маленькой аллеи, которая вела к уголку монахинь, оставалось лишь несколько оборотов колеса.",
      "source_sha256": "1ee49d02931af0091f941cbe76eb447a0b9df6e135065f02aae912fb0fc81479",
      "target_id": "ru-fr81-u143-r0059",
      "tag": "prose",
      "target_sha256": "305dc2d97b711cbd1538afb40c4626b284279d4b5874ce6691be1b6f08a782dc"
    },
    {
      "source_id": "fr81-u143-r0060",
      "target": "Могильщик продолжал:",
      "source_sha256": "ab7129cae17361515ae89c25adea75d30e71097eb0e0b81aeaa057914731c8fa",
      "target_id": "ru-fr81-u143-r0060",
      "tag": "prose",
      "target_sha256": "a2dbd8754a8fdf18fef9adbb82acc12b2abdbab7745ba4ff7a6a9b836f44d5be"
    },
    {
      "source_id": "fr81-u143-r0061",
      "target": "— Крестьянин, у меня семеро ребятишек, их надо кормить. Раз им надо есть, мне нельзя пить.",
      "source_sha256": "56c6eb757364454611c1dfd43d4682b93ae31a6602d0fe7be6b07dc8242ada43",
      "target_id": "ru-fr81-u143-r0061",
      "tag": "prose",
      "target_sha256": "677422199439876795aaeabae39cd0f29fa4d58233e0e9a134400c2d3bcfe833"
    },
    {
      "source_id": "fr81-u143-r0062",
      "target": "И он прибавил с удовлетворением серьёзного существа, которое составило фразу:",
      "source_sha256": "dab92e9a4cec83f4c5f70b4a77a2ae755d06c33598abc40eea34c31531d1bd3f",
      "target_id": "ru-fr81-u143-r0062",
      "tag": "prose",
      "target_sha256": "d57f2441d18181ef3f6c23f668e313127cfe242dab72c3518a8183223afc7108"
    },
    {
      "source_id": "fr81-u143-r0063",
      "target": "— Их голод — враг моей жажды.",
      "source_sha256": "1cc42ba3c2cde68087b3ee5a1c28c3a59797657cd44aaf2f946f7a89fe8ee868",
      "target_id": "ru-fr81-u143-r0063",
      "tag": "prose",
      "target_sha256": "a544a3c9ec607debfbe08addc7ccd6dbc20230a94b1f17b206b27c6950fc6bd8"
    }
  ],
