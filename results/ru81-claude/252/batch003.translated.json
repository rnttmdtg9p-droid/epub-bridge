{
  "unit": 252,
  "batch": 3,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u252-r0096",
      "target": "— К верху стояка[[N17]], — подхватил Бабет.",
      "source_sha256": "e256b288b0f260d4140827f29617d92ca9416cb01d03f047c3b495eaabfedc97",
      "target_id": "ru-fr81-u252-r0096",
      "tag": "prose",
      "target_sha256": "535b346e16edcb1e9a41d59dc84322f2ba001925c85c486ca5cacc9c6d53848e"
    },
    {
      "source_id": "fr81-u252-r0097",
      "target": "— К пруту окошка[[N18]], — добавил Брюжон.",
      "source_sha256": "41342ae1cd034d8cdea5ef3175b7cdcb67f1e1a3fccc73097b2819d63bebb467",
      "target_id": "ru-fr81-u252-r0097",
      "tag": "prose",
      "target_sha256": "f375c5a37fd8fad8739be13ba737700c894d93dcf0409ad6c8d2813a067c352d"
    },
    {
      "source_id": "fr81-u252-r0098",
      "target": "— А потом? — спросил Гаврош.",
      "source_sha256": "13d93b7e011672ce39ced0c74a9b9657e3c7c6b9294c3420d26320904b16d671",
      "target_id": "ru-fr81-u252-r0098",
      "tag": "prose",
      "target_sha256": "c371dd64314ea4b70d66d97487565bfaeb6290e2b9839ded3e59fa953d53d7d5"
    },
    {
      "source_id": "fr81-u252-r0099",
      "target": "— Вот и всё! — сказал Гелемер.",
      "source_sha256": "5b03c2edc2155f8e46d0ce7c47cf0a9df37ccf79f967f3e164cc5aeea4100ed5",
      "target_id": "ru-fr81-u252-r0099",
      "tag": "prose",
      "target_sha256": "13dbb3ea4219247388d54fb0d4528ea8ed75f801f7318e9e1c0f5d84a0f8b3d9"
    },
    {
      "source_id": "fr81-u252-r0100",
      "target": "Мальчишка оглядел верёвку, трубу, стену, окна и издал тот невыразимо презрительный звук губами, который означает:",
      "source_sha256": "71cbc3e654e770846a9da2581dcbeb5595345dbf82afa929756fccb59cdc78e0",
      "target_id": "ru-fr81-u252-r0100",
      "tag": "prose",
      "target_sha256": "5882ffff33b88d0cbc38797724f8da1fc9a134419fa7bc7da2258043b96a4d8f"
    },
    {
      "source_id": "fr81-u252-r0101",
      "target": "— Только-то!",
      "source_sha256": "363aeca51ac7d77d4f552437c17953e6234acb7a43527fe97db8c9693b4afb27",
      "target_id": "ru-fr81-u252-r0101",
      "tag": "prose",
      "target_sha256": "6bb3a78994007297ed94b88d7d0d749e7c24914b49233bc7f3b6b68f99bbb0a6"
    },
    {
      "source_id": "fr81-u252-r0102",
      "target": "— Там наверху человек, которого ты спасёшь, — продолжал Монпарнас.",
      "source_sha256": "08cb3b081d827c18104cab1fd7ff85d645820f4e194ee468d68706141bc95687",
      "target_id": "ru-fr81-u252-r0102",
      "tag": "prose",
      "target_sha256": "d59babcfe20548ccaee55180e5c8fb2bb6c72d2cdd2fdcb75b4070c0c1530a5b"
    },
    {
      "source_id": "fr81-u252-r0103",
      "target": "— Ну что, берёшься? — спросил Брюжон.",
      "source_sha256": "7c767c3cad7f7dca1cbae9d7b35f61ef5ffab914687269433bb2af04d2f21c6c",
      "target_id": "ru-fr81-u252-r0103",
      "tag": "prose",
      "target_sha256": "757c1179f94409654f8414e23978704ed7cb54bd14ec71c90338f76bcc88f351"
    },
    {
      "source_id": "fr81-u252-r0104",
      "target": "— Дурень! — ответил ребёнок так, словно вопрос показался ему неслыханным; и снял башмаки.",
      "source_sha256": "85b05f846cfdccadd934902e8c52ef10dacf7514b06148bc30a6c3b9d566acc0",
      "target_id": "ru-fr81-u252-r0104",
      "tag": "prose",
      "target_sha256": "deb5c6d3045910d8941e442944fa98f78a868afc9cae1628f5b669d37a250ef6"
    },
    {
      "source_id": "fr81-u252-r0105",
      "target": "Гелемер подхватил Гавроша одной рукой, поставил его на крышу лачуги, чьи трухлявые доски прогибались под тяжестью ребёнка, и вручил ему верёвку, которую Брюжон снова связал, пока Монпарнаса не было. Мальчишка направился к трубе, куда легко было забраться благодаря широкой трещине у самой крыши. Когда он уже собирался лезть, Тенардье, видевший, как приближаются спасение и жизнь, перегнулся через край стены; первый свет дня белил его лоб, залитый потом, землистые скулы, острый, дикий нос, всю его взъерошенную седую бороду, — и Гаврош узнал его.",
      "source_sha256": "0c7c6c7304525f633af2bcf1c0a867cdc0c0ccdc1120cd330a7588a888e37d82",
      "target_id": "ru-fr81-u252-r0105",
      "tag": "prose",
      "target_sha256": "d669ab3026ebdd4747959afb136c8b0a806a17d4a5d9b1c80018b4adb1bcb9ce"
    },
    {
      "source_id": "fr81-u252-r0106",
      "target": "— Ба! — сказал он. — Да это мой отец!.. А, это не помеха.",
      "source_sha256": "172ba32305d5fea90c4d8576f4e6b8ce8d761a8d0c9e5f3c49e23aa2bd18a613",
      "target_id": "ru-fr81-u252-r0106",
      "tag": "prose",
      "target_sha256": "961968ede017359e418df53cc25f8cae4cab97a8da0bfd2a295f2533667fd863"
    },
    {
      "source_id": "fr81-u252-r0107",
      "target": "И, взяв верёвку в зубы, он решительно начал карабкаться.",
      "source_sha256": "36ce4187305074e553e0b0cfddd956f91ba9d58cce6f44ac64a3c8a36163670f",
      "target_id": "ru-fr81-u252-r0107",
      "tag": "prose",
      "target_sha256": "0b9fe714c0493de5272de2369578397aad2a3fcbf901264047ab16e0b8351eb8"
    },
    {
      "source_id": "fr81-u252-r0108",
      "target": "Он добрался до верха развалины, оседлал старую стену, как коня, и крепко привязал верёвку к верхней перекладине окна.",
      "source_sha256": "1f8858b9f000714e5550192314296c235034dadfabbc3b4ab719fb17ff2eac7b",
      "target_id": "ru-fr81-u252-r0108",
      "tag": "prose",
      "target_sha256": "be4fbbdb39ba84677ab79e868d43b909d7a204f13f24d1ac30ce504174214fee"
    },
    {
      "source_id": "fr81-u252-r0109",
      "target": "Мгновение спустя Тенардье был на улице.",
      "source_sha256": "cd8c561b84799b6e5e2c27702029ae2be18ce5ee619d031d2df0e2d4dcff447f",
      "target_id": "ru-fr81-u252-r0109",
      "tag": "prose",
      "target_sha256": "66cb3be241d5eaa169f9f972327efd924034ca2a24d184d5d0654ee6a90b8016"
    },
    {
      "source_id": "fr81-u252-r0110",
      "target": "Едва он коснулся мостовой, едва почувствовал себя вне опасности, он перестал быть усталым, продрогшим, дрожащим; страшное, из чего он вышел, рассеялось, как дым, весь этот странный и свирепый ум пробудился и очутился на ногах, свободный и готовый идти вперёд. Вот каково было первое слово этого человека:",
      "source_sha256": "324ae16e373e95cea83d3ab9fe95fce19e55a5121000ab507f6e470f890e253e",
      "target_id": "ru-fr81-u252-r0110",
      "tag": "prose",
      "target_sha256": "2082d4094f1904d95b7ced63ee5edb59aadc5deced3e8b916475a2b04ed5b27c"
    },
    {
      "source_id": "fr81-u252-r0111",
      "target": "— Ну, а теперь кого мы съедим?",
      "source_sha256": "ad1c2775f66901be16c22ec31a168295228bd5848d494a68154bdd3b70e25ed1",
      "target_id": "ru-fr81-u252-r0111",
      "tag": "prose",
      "target_sha256": "abb86088034d6917cb53d632d66971afd15bc843fe464f65d16b0fa1ebeda097"
    },
    {
      "source_id": "fr81-u252-r0112",
      "target": "Нет нужды объяснять смысл этого ужасающе прозрачного слова, означающего разом: убить, зарезать и обобрать. [[I]]Съесть[[/I]], в истинном смысле: [[I]]пожрать[[/I]].",
      "source_sha256": "b90e370165b12be1bae7b8c32b8aaeed9b0afeee3c44ccfd8900c81082f85673",
      "target_id": "ru-fr81-u252-r0112",
      "tag": "prose",
      "target_sha256": "982a987b80bbcf6b3c018b309f481997ccedb7cbb4f38e65e21468ccef861b7f"
    },
    {
      "source_id": "fr81-u252-r0113",
      "target": "— Забьёмся-ка поплотнее в угол, — сказал Брюжон. — Покончим в трёх словах и сейчас же разойдёмся. Было одно дело, с виду недурное: улица Плюме, улица глухая, дом на отшибе, старая гнилая решётка перед садом, одни женщины.",
      "source_sha256": "0ea29c433267d648f51794f4aafeba5e59fad568bb831bb35af2179f3fa05d2c",
      "target_id": "ru-fr81-u252-r0113",
      "tag": "prose",
      "target_sha256": "4e3e140f29d9d5fdb157d058f23c84f4718975cbde418312fcb544ecb66c84aa"
    },
    {
      "source_id": "fr81-u252-r0114",
      "target": "— Ну так что ж? Почему бы и нет? — спросил Тенардье.",
      "source_sha256": "05198207faf0318105aa3eec9520469440ac1b8c736659bd0b33055756187444",
      "target_id": "ru-fr81-u252-r0114",
      "tag": "prose",
      "target_sha256": "b2ce9c8031e03cf06a0808d5be58eae4823c9e768569834d231d35ae83fcfde5"
    },
    {
      "source_id": "fr81-u252-r0115",
      "target": "— Твоя фея[[N19]], Эпонина, ходила взглянуть на дело, — ответил Бабет.",
      "source_sha256": "8a4f53691c056a5a8d59bb6c8196e403390dd70ec683a266bdd11cae107b6832",
      "target_id": "ru-fr81-u252-r0115",
      "tag": "prose",
      "target_sha256": "a23433c37d5a52f88715438557a1d831121a8e7d1fa87e529cbfcdd1a760969f"
    },
    {
      "source_id": "fr81-u252-r0116",
      "target": "— И принесла Магнон печенье, — добавил Гелемер. — Там нечего обделывать[[N20]].",
      "source_sha256": "5bda31ccea5546fbb9273d136efb472346326382a0a9111967b94205151bbc1d",
      "target_id": "ru-fr81-u252-r0116",
      "tag": "prose",
      "target_sha256": "c7a590ab1afd46a9386920577003f5b48809017615b58e52d8513bbd9d2194ee"
    },
    {
      "source_id": "fr81-u252-r0117",
      "target": "— Фея не дура[[N21]], — сказал Тенардье. — Однако всё же надо будет поглядеть.",
      "source_sha256": "edeb3490a65ba154561598d34fde6ad877983ee1ed5ec3d169c2f9eda4b5c11f",
      "target_id": "ru-fr81-u252-r0117",
      "tag": "prose",
      "target_sha256": "a4a6d10d824036fe7552a18259a924e752375b854718a14d694a423aba4f8946"
    },
    {
      "source_id": "fr81-u252-r0118",
      "target": "— Да, да, — сказал Брюжон, — надо будет поглядеть.",
      "source_sha256": "f36e9e58b1baea909b07b2cb34bab4796dd090ac79761847ec75f8aef437c695",
      "target_id": "ru-fr81-u252-r0118",
      "tag": "prose",
      "target_sha256": "d176e0d3cd1c4cf6d0530b8d9f4e95f74efc83d0d8e30a959330f223fc68deb1"
    },
    {
      "source_id": "fr81-u252-r0119",
      "target": "Между тем никто из этих людей, казалось, больше не замечал Гавроша, который во время этого совещания присел на одну из тумб ограды; он ждал несколько мгновений, может быть, что отец обернётся к нему, потом надел башмаки и сказал:",
      "source_sha256": "bc0d287bc43039a00066dd80cc2c1dc5ab883a3e12a2866f68cdae9a53dd8af5",
      "target_id": "ru-fr81-u252-r0119",
      "tag": "prose",
      "target_sha256": "4ac80fa2510c5d3a05983e9705e85d962ded9046cb574540d057c7ef4289d2d3"
    },
    {
      "source_id": "fr81-u252-r0120",
      "target": "— Всё, что ли? Я вам больше не нужен, ребята? Вы выпутались. Я пошёл. Мне пора будить моих мальцов.",
      "source_sha256": "76690888b975e57b67fee5134d3bef11f2df002dea363a6d0f8f9ab4d2c44dd0",
      "target_id": "ru-fr81-u252-r0120",
      "tag": "prose",
      "target_sha256": "3097a422b0d61d6dfd7b6cb52b4987db886f060be9f0cb433bf64eb6386dc2c2"
    },
    {
      "source_id": "fr81-u252-r0121",
      "target": "И он ушёл.",
      "source_sha256": "71d93cbe7146fc12d56577ae0198ef6beff05501a1a54737baf2cdb6ff0a3146",
      "target_id": "ru-fr81-u252-r0121",
      "tag": "prose",
      "target_sha256": "ab5ee2af91186c88f6c4ad59cccdb0b3d2d18dfce45dcacf3f7dfbbe0b41d3b5"
    },
    {
      "source_id": "fr81-u252-r0122",
      "target": "Пятеро мужчин один за другим вышли из ограды.",
      "source_sha256": "aaed448051429a9b525bd1de0cbc0e4da5e69b3207fdc124d7d21f8293290c65",
      "target_id": "ru-fr81-u252-r0122",
      "tag": "prose",
      "target_sha256": "a9d649d0804bfbb975f031dc91c44da40998f53324235cd5ced6c2a41d78e089"
    },
    {
      "source_id": "fr81-u252-r0123",
      "target": "Когда Гаврош скрылся за углом улицы Балле, Бабет отвёл Тенардье в сторону.",
      "source_sha256": "19a75bdef70257402e89535f51c41a8712c5dbe220352e217c0c563ce9ea607e",
      "target_id": "ru-fr81-u252-r0123",
      "tag": "prose",
      "target_sha256": "57ba3f2750262d4408bbd0a1a509725783a8bba967b27c3d57e77a5cdbc66ef2"
    },
    {
      "source_id": "fr81-u252-r0124",
      "target": "— Ты разглядел этого мальца? — спросил он его.",
      "source_sha256": "6f6f29f63832f1708f4c50be67cb97e381af2ded07441cf5b8e435f9d648096f",
      "target_id": "ru-fr81-u252-r0124",
      "tag": "prose",
      "target_sha256": "ca5e993505c2d125132bcf2c1e31211a223a53b68830212152123a148df28ece"
    },
    {
      "source_id": "fr81-u252-r0125",
      "target": "— Какого мальца?",
      "source_sha256": "3dcee38f87bf45e38bcd5688819cbc118bb46e6215182152c14117e52a46ad89",
      "target_id": "ru-fr81-u252-r0125",
      "tag": "prose",
      "target_sha256": "9a57cddcefbb992875e07e2d6a4daa15c37da5734d7d7fad4ec77dc90d360bc1"
    },
    {
      "source_id": "fr81-u252-r0126",
      "target": "— Того, что вскарабкался на стену и подал тебе верёвку.",
      "source_sha256": "7a1e46ad7077618ab9142c30d9ee6314e47b040a0fc6ad8f613f84a3adc1920f",
      "target_id": "ru-fr81-u252-r0126",
      "tag": "prose",
      "target_sha256": "bb9fb2a9e04b9f95672f0609efda9a3f3a09f78f99aa335d103d71d8113f3a32"
    },
    {
      "source_id": "fr81-u252-r0127",
      "target": "— Не очень.",
      "source_sha256": "4d0d908fb345d6c32134451e04cd18c66693aee0ee2dcb832efd04f07566d18f",
      "target_id": "ru-fr81-u252-r0127",
      "tag": "prose",
      "target_sha256": "e0e0ea3229d863f6ce3e07bc4646791e93e06caefe75b773e633888db1bda5f1"
    }
  ],
