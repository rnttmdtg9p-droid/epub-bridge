{
  "unit": 252,
  "batch": 4,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u252-r0128",
      "target": "— Ну, не знаю, а только мне сдаётся, что это твой сын.",
      "source_sha256": "ff71eee4a60cb798d279ceab516f31e39742048c5422283e87b7f9670cd5a758",
      "target_id": "ru-fr81-u252-r0128",
      "tag": "prose",
      "target_sha256": "9efd74ad65909224024e9ea1c1c5edde80925d3804a08ee95346e774f1c995af"
    },
    {
      "source_id": "fr81-u252-r0129",
      "target": "— Ба! — сказал Тенардье. — Ты думаешь?",
      "source_sha256": "9376144b039d632c088b4a2a6b5617dbc9591db9d754b7690f11a24672e212ad",
      "target_id": "ru-fr81-u252-r0129",
      "tag": "prose",
      "target_sha256": "42d047cd7dad5adbc1068046f132510eba644faa8c11fce0945ea738a777020f"
    },
    {
      "source_id": "fr81-u252-r0130",
      "target": "Какая славная ночь для побега!",
      "source_sha256": "7ab0ebc387f8da6fb3370a1af28ef6b335a87fd7df68e069f959db7524d51c7c",
      "target_id": "ru-fr81-u252-r0130",
      "tag": "footnote",
      "target_sha256": "8f7df06cee7f703517bdf2786eca0455d47a1666b4b8e34faa89ffe898a4b86c"
    },
    {
      "source_id": "fr81-u252-r0131",
      "target": "Пойдём отсюда. Что мы тут делаем?",
      "source_sha256": "561d9fd9bc10c741ef8a0e34ae479a9ab6a69bd067bcdddecef514fe1f11faa8",
      "target_id": "ru-fr81-u252-r0131",
      "tag": "footnote",
      "target_sha256": "22e3aadaf9ddd5755cbe4ee676680527a7e46163728da3e15c716ef1d9241c50"
    },
    {
      "source_id": "fr81-u252-r0132",
      "target": "Дождь такой, что чёртов огонь потушит. И потом, сюда сейчас пройдёт полиция. Вон там стоит часовой-солдат. Нас тут того и гляди сцапают.",
      "source_sha256": "bfea8341702ec38fd81506112930e0acade9e06bde39a701c6cda5dbdd519a63",
      "target_id": "ru-fr81-u252-r0132",
      "tag": "footnote",
      "target_sha256": "132380328b3fa5658f889977d5700553c5fd1e890032d70755eb927b2559fdc5"
    },
    {
      "source_id": "fr81-u252-r0133",
      "target": "Что ты мне тут рассказываешь? Трактирщик не мог бежать. Он не знает ремесла, вот что! Разорвать рубаху и разрезать простыни на верёвку, продолбить дыры в дверях, смастерить поддельные бумаги, изготовить отмычки, перепилить кандалы, спустить верёвку наружу, спрятаться, переодеться — для этого надо быть ловким. Старик не смог, работать он не умеет.",
      "source_sha256": "e31b55cadc83005e0435166f4ebb5a83be22d76cd0ca651e3355b2d887c15936",
      "target_id": "ru-fr81-u252-r0133",
      "tag": "footnote",
      "target_sha256": "a918b54df890ff3cfc66b5f24769e67ec5fd248ba7246babb522cc3f7395c422"
    },
    {
      "source_id": "fr81-u252-r0134",
      "target": "Твоего трактирщика поймали с поличным. Надо быть ловким. Он новичок. Его, верно, провёл какой-нибудь сыщик, а то и подсадная утка, что прикинулась сообщником. Послушай, Монпарнас, слышишь эти крики в тюрьме? Ты видел все эти свечи. Его опять схватили, поверь! Отделается тем, что отсидит свои двадцать лет. Я не трушу, я не трус, это всем известно, но нам остаётся только удирать, а то нам такое устроят, что мало не покажется. Не сердись, пойдём с нами, выпьем вместе бутылочку старого вина.",
      "source_sha256": "309637b5e7fe757160da499cd9494c27eb1704328e873d8f3f1ec4896c272598",
      "target_id": "ru-fr81-u252-r0134",
      "tag": "footnote",
      "target_sha256": "fd165c875cb5a7408f0c4926da45d1332db56d8dbc5ddac35f3d8e419136c140"
    },
    {
      "source_id": "fr81-u252-r0135",
      "target": "Говорю тебе, его опять схватили. В эту самую минуту трактирщик не стоит и гроша. Мы тут ничего не можем сделать. Пойдём отсюда. Мне каждую минуту кажется, что полицейский сержант держит меня в руке.",
      "source_sha256": "81892eb44d8e407dc22da49b403a0d55028cfd150bd6226915a49374ad55ce80",
      "target_id": "ru-fr81-u252-r0135",
      "tag": "footnote",
      "target_sha256": "da6506a5916f25c20926d1dde76036ae01a687ac8e289e4ea81ec88f521b742a"
    },
    {
      "source_id": "fr81-u252-r0136",
      "target": "Верёвка (арго Тампля).",
      "source_sha256": "a89459eb585b389748f613a5083984050f61e5e38e631982208924cbbe419965",
      "target_id": "ru-fr81-u252-r0136",
      "tag": "footnote",
      "target_sha256": "48cca36aeb76eee16980e6a1d4612463f77d7fb67058b598d3bb7d3f9b8bf7e3"
    },
    {
      "source_id": "fr81-u252-r0137",
      "target": "Моя верёвка (арго застав).",
      "source_sha256": "d7fce69238f8fa038ac745d007ecf3f24ebc5a8b633215b00741d062b7f62543",
      "target_id": "ru-fr81-u252-r0137",
      "tag": "footnote",
      "target_sha256": "7027cb2b6624adb89c4044ad44048baf78b6983706085f1e9b0eaa29fb9529e1"
    },
    {
      "source_id": "fr81-u252-r0138",
      "target": "Человек.",
      "source_sha256": "0b1a3d4f3e8e2434a3842fc9797d8a22cab22be2c7b6f79c7c1a5677aeecc65c",
      "target_id": "ru-fr81-u252-r0138",
      "tag": "footnote",
      "target_sha256": "aa4e80eeaa39a8475e4808a20357b2ab03473c682074c100b81ca37005cd2fa8"
    },
    {
      "source_id": "fr81-u252-r0139",
      "target": "Ребёнок (арго Тампля).",
      "source_sha256": "4ddff7720edb66a8f3caa4fc03722f2423cde5f4003ee73ec1d7d7d9d3dcd7d0",
      "target_id": "ru-fr81-u252-r0139",
      "tag": "footnote",
      "target_sha256": "eca5c7b858a60b54e275af1297b5aca8ed0a25433601f7faf4c3ca2d4e3a46ad"
    },
    {
      "source_id": "fr81-u252-r0140",
      "target": "Ребёнок (арго застав).",
      "source_sha256": "ed9e538f2ea524fc52dfbf5866ed2d53d8be350ae710277be9eca9b6f70ac26e",
      "target_id": "ru-fr81-u252-r0140",
      "tag": "footnote",
      "target_sha256": "ee59f99002899496e35c197146bffe1787a63bd0f97dc98cd1c2b460685e0348"
    },
    {
      "source_id": "fr81-u252-r0141",
      "target": "Ребёнок вроде меня — человек, а такие люди, как вы, — дети.",
      "source_sha256": "723afb4ced23d80c83035ea67c42251b23f651f06ceb7498c4c191c0f61c707b",
      "target_id": "ru-fr81-u252-r0141",
      "tag": "footnote",
      "target_sha256": "bb33e2f0e0fb365698344667d9fd357703465efd36af03b31916405312a67da5"
    },
    {
      "source_id": "fr81-u252-r0142",
      "target": "До чего же у мальчишки язык хорошо подвешен!",
      "source_sha256": "b66119c880ca5cfb3a4a1ed4c06677661bd761246d050555fd911cdca58d98d5",
      "target_id": "ru-fr81-u252-r0142",
      "tag": "footnote",
      "target_sha256": "aa3a78d1c8645e8e1e5fcdd9bb39a677ff5df90e8a23cc07a2d104142c9dde50"
    },
    {
      "source_id": "fr81-u252-r0143",
      "target": "Парижский мальчишка не из мокрой соломы сделан.",
      "source_sha256": "44a4204a6a147f91352636ef01a43751e1111e6b0730158994e397d9b623ec40",
      "target_id": "ru-fr81-u252-r0143",
      "tag": "footnote",
      "target_sha256": "e1c266017206867e87ebab5b2f0c26aa35eff448935dcd269ef09df1fc3c3aa3"
    },
    {
      "source_id": "fr81-u252-r0144",
      "target": "Эта верёвка.",
      "source_sha256": "6580cb58700d1e5b15b6e3655b422ca7e6b2b8aac8bc26070dbb5e1731913c02",
      "target_id": "ru-fr81-u252-r0144",
      "tag": "footnote",
      "target_sha256": "1846d7a0573210c4147e363510f9562f9ba0d48ef6bf68455ef115a932a3c912"
    },
    {
      "source_id": "fr81-u252-r0145",
      "target": "Привязать верёвку.",
      "source_sha256": "4d8ae6be8ebc61309730c09d4361055b3aab1d16082a34c811faf006d5d88289",
      "target_id": "ru-fr81-u252-r0145",
      "tag": "footnote",
      "target_sha256": "eee212408227ab0572f1c35bfcadae20eb46be10c0a075967e15a521eb441327"
    },
    {
      "source_id": "fr81-u252-r0146",
      "target": "На краю стены.",
      "source_sha256": "900c1f1f451e09a4bab9940b382e7d42d2c09480e2721fe5f155d189af946222",
      "target_id": "ru-fr81-u252-r0146",
      "tag": "footnote",
      "target_sha256": "85cd9a3257a04541b02e3022fb3d8600e3b7bd3aa69bd833199fc2b47b75c57e"
    },
    {
      "source_id": "fr81-u252-r0147",
      "target": "К перекладине окна.",
      "source_sha256": "cf17d36f71ab708b30732fe2b6d86c22cb8217b9bf2e5926c51781b8c1521dc2",
      "target_id": "ru-fr81-u252-r0147",
      "tag": "footnote",
      "target_sha256": "5af9771c9fb90a3e02bc636cc8a8c980eeacd3410c7d8b08c53b52bc6a772d79"
    },
    {
      "source_id": "fr81-u252-r0148",
      "target": "Твоя дочь.",
      "source_sha256": "c16a7ca7c0d8f6f134953ace4a049a88791d9a17488276c8ba7d10604a15dd85",
      "target_id": "ru-fr81-u252-r0148",
      "tag": "footnote",
      "target_sha256": "f163d331c59eaf6d2ee1c3835d58544eb6bfe1283d97a52cff2728791fbbc9e8"
    },
    {
      "source_id": "fr81-u252-r0149",
      "target": "Тут нечего делать.",
      "source_sha256": "349a7459fe0796b1f9c1e079c8906b81410bac90cd57695c534b4205551796ba",
      "target_id": "ru-fr81-u252-r0149",
      "tag": "footnote",
      "target_sha256": "3e7fadab801ea1f8308d59b8f2dcc8af8dbdb303267f0f14a3b829bedfd83908"
    },
    {
      "source_id": "fr81-u252-r0150",
      "target": "Дурак.",
      "source_sha256": "9c57984b7aee0c986490c7f2fd71ba24cab34c4852bfe26ea2f424ec8e034612",
      "target_id": "ru-fr81-u252-r0150",
      "tag": "footnote",
      "target_sha256": "f11f1cc097155ae79ae47c40323b78c905e3f95c064ba9dfb2314ee4ff4c9ecc"
    }
  ],
