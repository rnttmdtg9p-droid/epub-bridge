{
  "unit": 252,
  "batch": 2,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u252-r0064",
      "target": "Они подняли глаза. Тенардье чуть выдвинул голову вперёд.",
      "source_sha256": "5dc41b647fa8a866d66a3393fc0d2b425689c394ab345323bb580b494f1a0d29",
      "target_id": "ru-fr81-u252-r0064",
      "tag": "prose",
      "target_sha256": "272c3335c3af7639a1b0ab2ca24c4443e85731553ab0e656c819b65c0b24207c"
    },
    {
      "source_id": "fr81-u252-r0065",
      "target": "— Скорее! — сказал Монпарнас. — Другой конец верёвки у тебя, Брюжон?",
      "source_sha256": "88dc56fe576966d6b04135e8bbd7b2af2ba7e8d4d94efd9616791b01c57a9a09",
      "target_id": "ru-fr81-u252-r0065",
      "tag": "prose",
      "target_sha256": "a2167dc14f3e9a03db38a3a886a5be63758110294dfd8166e65bd01d6d4c7508"
    },
    {
      "source_id": "fr81-u252-r0066",
      "target": "— Да. — Свяжи оба конца вместе, мы бросим ему верёвку, он закрепит её на стене, ему хватит, чтобы спуститься.",
      "source_sha256": "7c8685eb16482c0688447a7731622ac6cb84752c6e592a978847f29cec5d6497",
      "target_id": "ru-fr81-u252-r0066",
      "tag": "prose",
      "target_sha256": "e525b3962fdb44b2d273dcef574b2a3d28364ba30f49c1d65b7536da7c7108c2"
    },
    {
      "source_id": "fr81-u252-r0067",
      "target": "Тенардье рискнул возвысить голос.",
      "source_sha256": "2079b0dfccfbded8e22097303b62fc3fce9352a5df94caa90147982a642e21d3",
      "target_id": "ru-fr81-u252-r0067",
      "tag": "prose",
      "target_sha256": "832e66846104cc15848de66452e36b1264c593463db3d933ed5aac445a0e8af1"
    },
    {
      "source_id": "fr81-u252-r0068",
      "target": "— Я окоченел.",
      "source_sha256": "3e74244ccfd8403bd6b008059e84488182b2d72bcd91cc77813ccff10fcced4e",
      "target_id": "ru-fr81-u252-r0068",
      "tag": "prose",
      "target_sha256": "65b6a4424483e0cf931ebeaa346c94b7cdaf691c985582bbd1b322921f42c01b"
    },
    {
      "source_id": "fr81-u252-r0069",
      "target": "— Мы тебя согреем.",
      "source_sha256": "c31959c56840dea20628bc3591358eebda4c217b77e9fbba43857feb968fa3e8",
      "target_id": "ru-fr81-u252-r0069",
      "tag": "prose",
      "target_sha256": "4330457b15d47d8f8ae9ebb0d25aac53b3b87e60914d0672453ff46618f61b7d"
    },
    {
      "source_id": "fr81-u252-r0070",
      "target": "— Я больше не могу шевельнуться.",
      "source_sha256": "f8fb0e33d5386af8f18b6de8e85e79e82ad493a2003e9e319114fdfcb3c9ea45",
      "target_id": "ru-fr81-u252-r0070",
      "tag": "prose",
      "target_sha256": "18b6fc7c33cc2977c89a5dad2589b58c264b7557ec37a8f436046d61bd418326"
    },
    {
      "source_id": "fr81-u252-r0071",
      "target": "— Ты соскользнёшь, а мы тебя подхватим.",
      "source_sha256": "c5e64d62f18fed724b9367969d67d50f9db99f441b4e3f434cc55421e00dfceb",
      "target_id": "ru-fr81-u252-r0071",
      "tag": "prose",
      "target_sha256": "9d55f6b9eb8b1504a59882f959116f36e95a4083ebc42a4069007ffb056da77d"
    },
    {
      "source_id": "fr81-u252-r0072",
      "target": "— У меня руки онемели.",
      "source_sha256": "5e1b0c12aa733259ed18b8c441e955de001088c971b01b5f26d50d93d6aad512",
      "target_id": "ru-fr81-u252-r0072",
      "tag": "prose",
      "target_sha256": "504d061c7ff0d16dc5171c4bda3a76ff5af7c19f9e0fcf9c7b29cbd41499dd6f"
    },
    {
      "source_id": "fr81-u252-r0073",
      "target": "— Только привяжи верёвку к стене.",
      "source_sha256": "264c0e062a3e7f654d397ac1d0e4994a8e67b0018a6542ed965b68cd4e396729",
      "target_id": "ru-fr81-u252-r0073",
      "tag": "prose",
      "target_sha256": "e4cca522ebb17ddc12f4d1a07166471af8e293df2068c48976f80fdaafc7479a"
    },
    {
      "source_id": "fr81-u252-r0074",
      "target": "— Не смогу.",
      "source_sha256": "b4e4a8f8b878e321fed36138f1058c4e5da656edb19ffc03c104a553f1e37f13",
      "target_id": "ru-fr81-u252-r0074",
      "tag": "prose",
      "target_sha256": "8789c40e7f6bd087c8166afd3ecde980b06b207731250f390f6936280f51da96"
    },
    {
      "source_id": "fr81-u252-r0075",
      "target": "— Надо, чтобы кто-нибудь из нас поднялся, — сказал Монпарнас.",
      "source_sha256": "450fa473c77a7d72c3e5714fed605f7d5930032e3de60373f98aedd8e622026c",
      "target_id": "ru-fr81-u252-r0075",
      "tag": "prose",
      "target_sha256": "8498a7298ecb7c729b5b6659befa5d5585ff214241666f18ce61f4d0bd65fe9e"
    },
    {
      "source_id": "fr81-u252-r0076",
      "target": "— Три этажа! — протянул Брюжон.",
      "source_sha256": "274e9b748b7069c901116f6f2ff88384b61777b3fcd4359fd2a787431d883a6d",
      "target_id": "ru-fr81-u252-r0076",
      "tag": "prose",
      "target_sha256": "d013b94b4b554577f1f118290d620dfc0742a88d46df626f5a5679b7668276ac"
    },
    {
      "source_id": "fr81-u252-r0077",
      "target": "Старая гипсовая труба, служившая когда-то для печки, которую зажигали в этой лачуге, тянулась вдоль стены и поднималась почти до того места, где виднелся Тенардье. Эта труба, в то время вся в трещинах и расселинах, упала с тех пор, но следы её видны и теперь. Она была очень узкая.",
      "source_sha256": "421e8f5f8597df2cfc03a3098e66429a9afb8d0a0651110387f162ef4fbeaa29",
      "target_id": "ru-fr81-u252-r0077",
      "tag": "prose",
      "target_sha256": "98a22301b3e7b37d347050e93afee54f933b6f00bff77d72275c2639a79d593a"
    },
    {
      "source_id": "fr81-u252-r0078",
      "target": "— Можно бы подняться по ней, — сказал Монпарнас.",
      "source_sha256": "da9eecd61be6b8a268c9ecece38b15692627af0d8e7b50b7e9e998cf00a449da",
      "target_id": "ru-fr81-u252-r0078",
      "tag": "prose",
      "target_sha256": "86199e31aff462373efb15b1c986010c3ddcb46d62606e7e697f9194d22e3d02"
    },
    {
      "source_id": "fr81-u252-r0079",
      "target": "— По этой трубе? — воскликнул Бабель. — Взрослый[[N9]] ни за что! Тут нужен пацан[[N10]].",
      "source_sha256": "23e28e257811f4dcf7220f9f9f24464228b6c6eba37333b145cd6d0e6ed647c9",
      "target_id": "ru-fr81-u252-r0079",
      "tag": "prose",
      "target_sha256": "060e65daeaea4f1c3bb149a66fa2301743425085470fc8bd79158e6e9c3357a3"
    },
    {
      "source_id": "fr81-u252-r0080",
      "target": "— Нужен мальчонка[[N11]], — подхватил Брюжон.",
      "source_sha256": "e9338c73a7a4b6c4b1f4ce964003a5355a5da494d66b66e68189c8f70a3b3ee8",
      "target_id": "ru-fr81-u252-r0080",
      "tag": "prose",
      "target_sha256": "d928ad8b46f1a91e06db7174825f0428f415c41e3f4d7f06657309c95e38ef41"
    },
    {
      "source_id": "fr81-u252-r0081",
      "target": "— Где найти такого воробья? — сказал Гёлемер.",
      "source_sha256": "eb0979b71e6e4e8d1f87a0e63545dc658df0fdab06d708775aa9cb8bf5788ebd",
      "target_id": "ru-fr81-u252-r0081",
      "tag": "prose",
      "target_sha256": "0de7e26575e529e7a7c8924b75a14d3f8b50a40d6bc858f9d609ba26e7f3498a"
    },
    {
      "source_id": "fr81-u252-r0082",
      "target": "— Погодите, — сказал Монпарнас. — Есть у меня на примете.",
      "source_sha256": "e86773f3a0ad78eae4920818f204c311fdfe8bdbb30f3463c321efcffc5f1cc5",
      "target_id": "ru-fr81-u252-r0082",
      "tag": "prose",
      "target_sha256": "7e6700eb3a665b187f29af5f5293ec9292f93258c5b110b4bf211a203205021f"
    },
    {
      "source_id": "fr81-u252-r0083",
      "target": "Он тихонько приоткрыл дверь в ограде, убедился, что по улице никто не проходит, осторожно вышел, затворил за собой дверь и побежал в сторону Бастилии.",
      "source_sha256": "c797a365ddefe6c5e63635219c69a51d72c77390620fa39bb4de1ab784ad273c",
      "target_id": "ru-fr81-u252-r0083",
      "tag": "prose",
      "target_sha256": "0aba694e6e546d29a5d8e073e2c4b7a0a853f1cd52ac22e7b748d155d7952533"
    },
    {
      "source_id": "fr81-u252-r0084",
      "target": "Прошло семь-восемь минут — для Тенардье восемь тысяч веков; Бабет, Брюжон и Гёлемер не разжимали зубов; наконец дверь снова отворилась, и появился запыхавшийся Монпарнас, ведя за собой Гавроша. Дождь по-прежнему делал улицу совершенно пустынной.",
      "source_sha256": "d09c919a0314e016a2602a158ca85be10423360d789442437a43a5a345743861",
      "target_id": "ru-fr81-u252-r0084",
      "tag": "prose",
      "target_sha256": "5a12d5626e423cf521e34c9b5dec9ac0625e2902231543f10770181f35998629"
    },
    {
      "source_id": "fr81-u252-r0085",
      "target": "Маленький Гаврош вошёл в ограду и спокойно оглядел эти разбойничьи лица. С волос у него стекала вода. Гёлемер обратился к нему:",
      "source_sha256": "48ba1fc5f58c761c3927f258c6702c5a138444854524e48f44076486fc5f8c11",
      "target_id": "ru-fr81-u252-r0085",
      "tag": "prose",
      "target_sha256": "84f830b27e8b6a47ca131612e90ad49262aff5521416c29902e8ff41cd84e7d4"
    },
    {
      "source_id": "fr81-u252-r0086",
      "target": "— Эй, малявка, ты мужчина?",
      "source_sha256": "a6cfd9aaee0d5bfa3c900f65684dd41b182facc50a875836c0fc933892fed609",
      "target_id": "ru-fr81-u252-r0086",
      "tag": "prose",
      "target_sha256": "b2c6d7bb7bb8873b974f44268499daff83ac6b47df953cb2e203b7fb33604bb2"
    },
    {
      "source_id": "fr81-u252-r0087",
      "target": "Гаврош пожал плечами и ответил:",
      "source_sha256": "b118c689400e33970789f25708e4321e8b54ab1cd23a59cba407bf1922e0fc75",
      "target_id": "ru-fr81-u252-r0087",
      "tag": "prose",
      "target_sha256": "9dc40a69aa586dbb69e7176e4ebfa4839a586ea1deee4418cb141df152a54d36"
    },
    {
      "source_id": "fr81-u252-r0088",
      "target": "— Пацан вроде меня — это мужчина, а мужчины вроде вас — это пацаны[[N12]].",
      "source_sha256": "d13a02599a8246016abaf5c7a168126e9a62c98e9b02441ffcdc510f2f7cc74a",
      "target_id": "ru-fr81-u252-r0088",
      "tag": "prose",
      "target_sha256": "91978501ac89d132382a98bad57b362549d49cb54e92f914db18aa69e6c179f9"
    },
    {
      "source_id": "fr81-u252-r0089",
      "target": "— Как этот мальчишка языком мелет[[N13]]! — воскликнул Бабет.",
      "source_sha256": "0e5b387433fa691ec645beadf44a0b6bf4a13240befd90f68533e81af2f2f855",
      "target_id": "ru-fr81-u252-r0089",
      "tag": "prose",
      "target_sha256": "1a055fe6196f40a36860cc99d3bc965d9dafb0c5022939865fddf9ed9a5bec03"
    },
    {
      "source_id": "fr81-u252-r0090",
      "target": "— Пантенский пацан не из мокрой соломы слеплен[[N14]], — добавил Брюжон.",
      "source_sha256": "11866302e6975aa405509692a13ccd3fc9e83004298c3e2a758558ab442b6d55",
      "target_id": "ru-fr81-u252-r0090",
      "tag": "prose",
      "target_sha256": "7691484ddf589cc45c614fb0e7b59fa0961b1606065ec03875175185162bbec3"
    },
    {
      "source_id": "fr81-u252-r0091",
      "target": "— Что вам от меня надо? — сказал Гаврош.",
      "source_sha256": "5be390f361e010b1f7a7fc7f0df6288b0397b9f3535759bc218fe367905fd03c",
      "target_id": "ru-fr81-u252-r0091",
      "tag": "prose",
      "target_sha256": "7fa62f597c544e033edaf5a2e3afd838a30978fd8542d2926b57d217020eb38e"
    },
    {
      "source_id": "fr81-u252-r0092",
      "target": "Монпарнас ответил:",
      "source_sha256": "edd559351bbf582f6f8aa9fa0f643bf12761fa4bb8c1068c6e8dfb135c92f0e9",
      "target_id": "ru-fr81-u252-r0092",
      "tag": "prose",
      "target_sha256": "009c0bcd51b89fb0551260b093aad6c5304b16f3d18788942e6a440f9cd7ec9b"
    },
    {
      "source_id": "fr81-u252-r0093",
      "target": "— Взобраться по этой трубе.",
      "source_sha256": "da064a4f7479084d5066ad416cc4b9dec77de0d4cc3b39f99c34108e2a35f135",
      "target_id": "ru-fr81-u252-r0093",
      "tag": "prose",
      "target_sha256": "fc9a63ec40794702aa63eb727494a74ef542cd2e324f9c9ef1eec30a0c067ee0"
    },
    {
      "source_id": "fr81-u252-r0094",
      "target": "— С этой вдовушкой[[N15]], — сказал Бабет.",
      "source_sha256": "ece3e8291a1ff3c71064cd5b75e57b6da2206daafb4e665ea35c0688b627dade",
      "target_id": "ru-fr81-u252-r0094",
      "tag": "prose",
      "target_sha256": "70560f7f036d68b173021c519cb0090d1f1990ebd05c6deba4766ab1c62ef14a"
    },
    {
      "source_id": "fr81-u252-r0095",
      "target": "— И привязать кручёную[[N16]], — продолжал Брюжон.",
      "source_sha256": "b3c24d34aaf4be7ea915faef4e53e84433e6f2c5f16ce8dc1139425c0787be5e",
      "target_id": "ru-fr81-u252-r0095",
      "tag": "prose",
      "target_sha256": "3bd40c7f22895af44a02905e44c664143a5a29eea4c48e58738f2737d7b54ad0"
    }
  ],
