{
  "unit": 16,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u016-r0031",
      "target": "— Да, — сказал человек.",
      "source_sha256": "bfb33f73878d8b6f3791cfdd82157894750b177c2e04476963d92899ca61121d",
      "target_id": "ru-fr81-u016-r0031",
      "tag": "prose",
      "target_sha256": "d1d3f903f94190281f4907e279a5f67a528c9d8c5d9800bc0d0fe246f39612db"
    },
    {
      "source_id": "fr81-u016-r0032",
      "target": "— А у меня, — сказал хозяин, — нет комнаты.",
      "source_sha256": "d567a4197d62a0db52ed9f3c46f3b701c68c7581dd4899cbb23fe8b7a0331b52",
      "target_id": "ru-fr81-u016-r0032",
      "tag": "prose",
      "target_sha256": "2fa70ed8f4a8d85d7d89a21ddc9d83b4b8b1c85c6c18d588b6cc6865199c0a8d"
    },
    {
      "source_id": "fr81-u016-r0033",
      "target": "Человек спокойно продолжал: — Поместите меня в конюшне.",
      "source_sha256": "6f19e22c462294a69170605bd2de5d265a1ee949eb4cb119717996b13888c1f2",
      "target_id": "ru-fr81-u016-r0033",
      "tag": "prose",
      "target_sha256": "3bef65da6d146186c0522327665a00e3f1d7fd669cf016b5d6682c6520142664"
    },
    {
      "source_id": "fr81-u016-r0034",
      "target": "— Не могу.",
      "source_sha256": "53111f55994787359e92038fe417ac06c9508d24079a8c95a8f05b8059f85bb1",
      "target_id": "ru-fr81-u016-r0034",
      "tag": "prose",
      "target_sha256": "36e67aae739ccb3dc9466569659a8fddcbd4eccca223cc6406d95b14687a378a"
    },
    {
      "source_id": "fr81-u016-r0035",
      "target": "— Почему?",
      "source_sha256": "4b5154ea331b0a88da96b0d95a9812f8ce55fa954dcfa4511479082dd555da57",
      "target_id": "ru-fr81-u016-r0035",
      "tag": "prose",
      "target_sha256": "5a7f49277ce4099a8cda575751c41cbe2652b4e11515588f5af4642c420fb08d"
    },
    {
      "source_id": "fr81-u016-r0036",
      "target": "— Лошади занимают всё место.",
      "source_sha256": "ece9606e1abf6e50e02bf4e33fa0ec78e0f9de79b7a10acd7dbb1cf055edc00f",
      "target_id": "ru-fr81-u016-r0036",
      "tag": "prose",
      "target_sha256": "9ffeecdb11f79619e59969dba450019d35974103037d93114cd8ba1749243e7d"
    },
    {
      "source_id": "fr81-u016-r0037",
      "target": "— Ну что ж, — возразил человек, — тогда уголок на чердаке. Охапку соломы. Посмотрим после ужина.",
      "source_sha256": "a2e3d11486cafa1995c532c17512f88e56bbece6a58fc68a6da336e3f3b84a06",
      "target_id": "ru-fr81-u016-r0037",
      "tag": "prose",
      "target_sha256": "5bbf9186a22309a44091d34b339cf419a0d386e0ed542e486f70141627af3f27"
    },
    {
      "source_id": "fr81-u016-r0038",
      "target": "— Я не могу дать вам ужина.",
      "source_sha256": "5d3c53e24550817212d6feb78c00c1f6c0e56d3cb21d62a4a28aae0b420be128",
      "target_id": "ru-fr81-u016-r0038",
      "tag": "prose",
      "target_sha256": "abebe2048a8f751b4801560dc5132eb2d7ed863feb1e36cf9ce6d562f1364b17"
    },
    {
      "source_id": "fr81-u016-r0039",
      "target": "Это заявление, сделанное тоном сдержанным, но твёрдым, показалось незнакомцу серьёзным. Он встал.",
      "source_sha256": "c9a8a0e31b99640ca7b1dbc0e2c274a48adf2901ee549086817b55a274b74ee7",
      "target_id": "ru-fr81-u016-r0039",
      "tag": "prose",
      "target_sha256": "88f80110dc5636c6de788baf13b277d5b309a94c1ca7fc381b993056d04efce8"
    },
    {
      "source_id": "fr81-u016-r0040",
      "target": "— Вот ещё! Да я умираю с голоду. Я шёл с восходом солнца. Я прошёл двенадцать льё. Я плачу. Я хочу есть.",
      "source_sha256": "47fba24d1991636142731bdd592985b54f2c0824dfedaf7bdc96f39311e6af5e",
      "target_id": "ru-fr81-u016-r0040",
      "tag": "prose",
      "target_sha256": "334d8e777b934a4fa7a16a46fc57f7abd57fed7f5cf32f6d73f1001f2b1f494a"
    },
    {
      "source_id": "fr81-u016-r0041",
      "target": "— У меня ничего нет, — сказал хозяин.",
      "source_sha256": "66b4626079dafdb65e0e96e31f3d2540ccb6f0d600d192ff9c5d173640098b8a",
      "target_id": "ru-fr81-u016-r0041",
      "tag": "prose",
      "target_sha256": "663d508b1e0e8212977b33d30a70580fc28bbeec8c36dd409d0fcdc90d4d5ca4"
    },
    {
      "source_id": "fr81-u016-r0042",
      "target": "Человек расхохотался и повернулся к камину и печам.",
      "source_sha256": "296a73e1624ad02df6302a502ac994f960a38806b0aadfa11f4f0268b5d675e4",
      "target_id": "ru-fr81-u016-r0042",
      "tag": "prose",
      "target_sha256": "cce2a6d04ddd1c49ed797d26f9c2eeef2dd0ef0c434cdefb86de2855e7be86a7"
    },
    {
      "source_id": "fr81-u016-r0043",
      "target": "— Ничего! А это всё?",
      "source_sha256": "d253be1e05e71ecd228470f6dee4a372a863324a0867031aa65224159f09e64c",
      "target_id": "ru-fr81-u016-r0043",
      "tag": "prose",
      "target_sha256": "c271987716e8924d21e5be138c2eab81608b2c4816a90b012cb246c69aa45ec6"
    },
    {
      "source_id": "fr81-u016-r0044",
      "target": "— Это всё мне заказано.",
      "source_sha256": "9714ef5d467b44eceb450271a93cfa9f986674ffa5e8e900dbf243ffeab17559",
      "target_id": "ru-fr81-u016-r0044",
      "tag": "prose",
      "target_sha256": "2fa952ec0df6ad09cd84162fc65b2a379c2e6fcb75c4886d15cc5358d4a54224"
    },
    {
      "source_id": "fr81-u016-r0045",
      "target": "— Кем?",
      "source_sha256": "ca0097084d509af46a1c03ca16412439147c6987df11b791e1b7ef3e11f1f6fb",
      "target_id": "ru-fr81-u016-r0045",
      "tag": "prose",
      "target_sha256": "20aba2f6a0491b8f680b34ff6bc2f67299dfe141f715297ff1c30be944a05460"
    },
    {
      "source_id": "fr81-u016-r0046",
      "target": "— Этими господами возчиками.",
      "source_sha256": "d4f4f826d0e3f92e2b4ee88f62ed6e6418eb7711ca335784adf72c85241b9ac5",
      "target_id": "ru-fr81-u016-r0046",
      "tag": "prose",
      "target_sha256": "bd2bcca2e0be1281b92234fc76edeedbf99da62a3e73717d664c6893bde69512"
    },
    {
      "source_id": "fr81-u016-r0047",
      "target": "— Сколько их?",
      "source_sha256": "b3052e45d9f7712394ddde5ae73f5357f781cab0c1b19569d84d5cdaf7398681",
      "target_id": "ru-fr81-u016-r0047",
      "tag": "prose",
      "target_sha256": "6d9425e22f9e0572039c417621e52ec777b0112702355926062e2119b466576a"
    },
    {
      "source_id": "fr81-u016-r0048",
      "target": "— Двенадцать.",
      "source_sha256": "d9df42d0a510833b63195365bb59f8881b3e75a5015eaecf1c0fedbc13344407",
      "target_id": "ru-fr81-u016-r0048",
      "tag": "prose",
      "target_sha256": "d00f6a71418c626415d868b10f6af4f313bf3c7a8899f011d0dc09b2d0e83695"
    },
    {
      "source_id": "fr81-u016-r0049",
      "target": "— Здесь еды на двадцать человек.",
      "source_sha256": "99c7f9d37777224e4eaae014711a7c3b214b6909859e8db26de1c44337a3c377",
      "target_id": "ru-fr81-u016-r0049",
      "tag": "prose",
      "target_sha256": "681b91e3a2be98be3d55d27213f02b4b3095350904fa4054b195fdb547ef4fd2"
    },
    {
      "source_id": "fr81-u016-r0050",
      "target": "— Они всё заказали и за всё заплатили вперёд.",
      "source_sha256": "36130ac864b4a9a41f934803f552646c79d869e5b0f94b1391296e367cb9cd6d",
      "target_id": "ru-fr81-u016-r0050",
      "tag": "prose",
      "target_sha256": "f683d8b1e1654daa284d37ea2d2dd6f8536f91f4b44529e68c57fdb88c712d57"
    },
    {
      "source_id": "fr81-u016-r0051",
      "target": "Человек снова сел и сказал, не повышая голоса:",
      "source_sha256": "057bd853a3fddce40adafee2034f4fee928768e3c9d2308123661951edd2f1cf",
      "target_id": "ru-fr81-u016-r0051",
      "tag": "prose",
      "target_sha256": "f163e1ece911bcf12cdc91782bcec6df96ec23d52e8620930b1d825fb0e078f4"
    },
    {
      "source_id": "fr81-u016-r0052",
      "target": "— Я на постоялом дворе, я голоден, и я остаюсь.",
      "source_sha256": "0d24923fee1e438f78aed06c7e3aa071289a506aa6d080b5d10e120effcde941",
      "target_id": "ru-fr81-u016-r0052",
      "tag": "prose",
      "target_sha256": "7d81bfe685bef450755118d6815cf4a0844607dfc8c9138c1279fa3f669725ab"
    },
    {
      "source_id": "fr81-u016-r0053",
      "target": "Тогда хозяин наклонился к его уху и сказал ему тоном, заставившим его вздрогнуть: — Убирайтесь.",
      "source_sha256": "a273e5b63ed2f949f4b5c8d829e989340dc69d547b30ecf995c7a57760755b8c",
      "target_id": "ru-fr81-u016-r0053",
      "tag": "prose",
      "target_sha256": "ea1cbe8089a1d51d7aac5b9dce3130ab5bda3e7f32d6392dd87dfe2ed41b0b77"
    },
    {
      "source_id": "fr81-u016-r0054",
      "target": "Путник в эту минуту наклонился и концом своей окованной палки пододвигал в огонь несколько угольков; он быстро обернулся и, едва открыв рот, чтобы возразить, услышал: — Полно, довольно слов. Хотите, я скажу вам, как вас зовут? Вас зовут Жан Вальжан. А теперь хотите, я скажу вам, кто вы такой? Увидев, как вы вошли, я заподозрил неладное, послал в мэрию, и вот что мне ответили. Вы умеете читать?",
      "source_sha256": "5bc9d3a1851630e5fdbe526323ffae8d99c0cb8202401acd046faee04ef48771",
      "target_id": "ru-fr81-u016-r0054",
      "tag": "prose",
      "target_sha256": "5484b9d944e37b6ca761b4f5742e819910cfc9e2608b718ec1ad6869bac04d3e"
    },
    {
      "source_id": "fr81-u016-r0055",
      "target": "Говоря так, он протягивал незнакомцу, совсем развёрнутую, бумагу, только что совершившую путь с постоялого двора в мэрию и из мэрии на постоялый двор. Человек бросил на неё взгляд. После молчания трактирщик продолжал:",
      "source_sha256": "4ad852ce9596a15f02a50b338f32ec633d67a0ba5e4829fd335c7c6ce54e53e2",
      "target_id": "ru-fr81-u016-r0055",
      "tag": "prose",
      "target_sha256": "1dbbfaf12571776775a9c7af24a2087fc7ab43c71e4b8611fd1233f97ff91d4e"
    },
    {
      "source_id": "fr81-u016-r0056",
      "target": "— У меня привычка быть вежливым со всеми. Убирайтесь.",
      "source_sha256": "04fecd809ea6b3a2c5d3d653d77582e82028be487332a5b1d5c961f707594fcf",
      "target_id": "ru-fr81-u016-r0056",
      "tag": "prose",
      "target_sha256": "6cac9c9191a03f6f2c410270bbb57666bb001bc1babb37d0ca1a30a7cbebaf95"
    },
    {
      "source_id": "fr81-u016-r0057",
      "target": "Человек опустил голову, подобрал мешок, который поставил на землю, и ушёл.",
      "source_sha256": "ea140dcf5a5bb938b79c3f0dff461b7661cfb9155ea836ea21c830b531d8856c",
      "target_id": "ru-fr81-u016-r0057",
      "tag": "prose",
      "target_sha256": "88738ba2ef5ac8ac71c5df05e33055ce0292528f4218bfc8eba62b7b8cd32d49"
    },
    {
      "source_id": "fr81-u016-r0058",
      "target": "Он пошёл по главной улице. Он шагал наугад, прямо перед собой, держась поближе к домам, как человек униженный и печальный. Он не обернулся ни разу. Если бы он обернулся, он увидел бы хозяина [[I]]«Кольбасского креста»[[/I]] на пороге двери, окружённого всеми постояльцами его трактира и всеми прохожими с улицы; хозяин оживлённо говорил и показывал на него пальцем, и по недоверчивым и испуганным взглядам этой кучки он догадался бы, что вскоре его появление станет событием для всего города.",
      "source_sha256": "c030e4ec77c3194a80f12b4447b65a9254a2499c555a9c83484b3605bf399f8a",
      "target_id": "ru-fr81-u016-r0058",
      "tag": "prose",
      "target_sha256": "426b6a9b8bd133a6a89fb7de153882f396536555e963f0afa8b187e698be1aa4"
    },
    {
      "source_id": "fr81-u016-r0059",
      "target": "Он ничего этого не видел. Люди, раздавленные бедой, не оглядываются назад. Они слишком хорошо знают, что злая судьба идёт за ними по пятам.",
      "source_sha256": "4814fbf027c0a096f9e0b1ca26061cc3df526c2c1b1f6a7cbc028553067ac0c2",
      "target_id": "ru-fr81-u016-r0059",
      "tag": "prose",
      "target_sha256": "811bbac6a78e02b5e9ddd21c759b46ae1b2944464726fd7a05ce586bcff09c3c"
    },
    {
      "source_id": "fr81-u016-r0060",
      "target": "Так он брёл некоторое время, всё шёл и шёл, наудачу, по незнакомым улицам, забывая об усталости, как это бывает в печали. Вдруг он остро почувствовал голод. Приближалась ночь. Он огляделся, не найдётся ли где пристанища.",
      "source_sha256": "f7efd5c38cd74123fa37fc16aacaa80f1e96e662c53051cb5d3fc7e7ffa88fee",
      "target_id": "ru-fr81-u016-r0060",
      "tag": "prose",
      "target_sha256": "7f5fddfe9bf778df0bf47b432f5c622c901a485364b2f59904b0e16466f05f54"
    },
    {
      "source_id": "fr81-u016-r0061",
      "target": "Прекрасная гостиница закрылась для него; он искал какой-нибудь совсем скромный кабачок, какую-нибудь совсем бедную дыру.",
      "source_sha256": "9f33e247fa35db865634bc5e3311786894eb46d56b36db33a695a0215f490b5d",
      "target_id": "ru-fr81-u016-r0061",
      "tag": "prose",
      "target_sha256": "54eb1a3fb536e2d7fc0bb460d96ab9765b57c7337792aeb886c13f924c8bc1d2"
    },
    {
      "source_id": "fr81-u016-r0062",
      "target": "Как раз в конце улицы загорелся огонёк; сосновая ветка, подвешенная на железном кронштейне, вырисовывалась на белом небе сумерек. Он пошёл туда.",
      "source_sha256": "a4c764a71a77009434217bfb59c3745bcfac9d7f6e7639000506277a23efaa3b",
      "target_id": "ru-fr81-u016-r0062",
      "tag": "prose",
      "target_sha256": "3808682c87833d602fe63e00b14b9c27952f47a3476c6e176ba77e03057beaee"
    }
  ],
