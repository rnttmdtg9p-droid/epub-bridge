  "rows": [
    {
      "source_id": "fr81-u197-r0032",
      "target": "— Со вчерашнего дня.",
      "source_sha256": "4615d67393234a90e73f4495f82b39d792aa33d1593f43725f75a55099eab4c7",
      "target_id": "ru-fr81-u197-r0032",
      "tag": "prose",
      "target_sha256": "f58235f61dceecfa353b6e7a8c3b96d614a410b5b9159bb965ba22670f14cec0"
    },
    {
      "source_id": "fr81-u197-r0033",
      "target": "— Где он теперь живёт?",
      "source_sha256": "af4f1baf7dbbf250da25a1e7142a35766d282e0a6210fe346e138c0d1bbab857",
      "target_id": "ru-fr81-u197-r0033",
      "tag": "prose",
      "target_sha256": "37ea0a169ea534f461afd57d41b68d25f8873c75ea9260bcca9837a30247e475"
    },
    {
      "source_id": "fr81-u197-r0034",
      "target": "— Понятия не имею.",
      "source_sha256": "6713e532fc62c79c3fb09be7a7fbc48784e1e099b71a40e62d91427199e6085b",
      "target_id": "ru-fr81-u197-r0034",
      "tag": "prose",
      "target_sha256": "14b67ce878d50a6d186e5da5723cfec8d5c3c9ed23eb46263611f4df457f8d12"
    },
    {
      "source_id": "fr81-u197-r0035",
      "target": "— Так он не оставил нового адреса?",
      "source_sha256": "37ab3f5581859f2424a6b14ac3562357734f88fbfd701ec2e2962426a9b2337f",
      "target_id": "ru-fr81-u197-r0035",
      "tag": "prose",
      "target_sha256": "7deafbe2e4b787c321cd644ee8e7ac885a256e5f05dfcf14daf0dc3a42b0f84e"
    },
    {
      "source_id": "fr81-u197-r0036",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u197-r0036",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u197-r0037",
      "target": "И привратник, подняв нос, узнал Мариуса.",
      "source_sha256": "42da7dfb797531b55e9c67a2abfb5e47f96715369d3a5d8545c88089eb2aaa81",
      "target_id": "ru-fr81-u197-r0037",
      "tag": "prose",
      "target_sha256": "0a28150c420c0ef1e3ced7c134af85a81c8940a6ce3305d6393e229b90bef9cf"
    },
    {
      "source_id": "fr81-u197-r0038",
      "target": "— Ба! Это вы! — сказал он. — Да вы, выходит, и вправду из любопытных?",
      "source_sha256": "cb3ab947860f64019be94244471bf6fea83d1e0ff74d41ffc3b9751739bab7d9",
      "target_id": "ru-fr81-u197-r0038",
