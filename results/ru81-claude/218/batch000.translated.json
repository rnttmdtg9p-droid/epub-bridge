{
  "unit": 218,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u218-h",
      "target": "XVII Употребление пятифранковой монеты Мариуса",
      "source_sha256": "4e1aef50761f7c0684c1def9e3d70c20b5574d4e4501d8a32827d841871edbae",
      "target_id": "ru-fr81-u218-h",
      "tag": "heading",
      "target_sha256": "12c6d006c3fe9c463cb16873d0c48ed1ecddb469f6c427fdcf5315010c00fdc1"
    },
    {
      "source_id": "fr81-u218-r0001",
      "target": "Мариус решил, что настало время вернуться на свой наблюдательный пост. В одно мгновение, с гибкостью, свойственной его возрасту, он оказался у отверстия в перегородке.",
      "source_sha256": "cf63eeecd8b6408c211be3bcaa1bb0ceabe5383ea13218ee88321a4033ede39b",
      "target_id": "ru-fr81-u218-r0001",
      "tag": "prose",
      "target_sha256": "dc44ecafec6706a8fc145676f8d812a02718633efc360c7ef16eec277855a186"
    },
    {
      "source_id": "fr81-u218-r0002",
      "target": "Он посмотрел.",
      "source_sha256": "9373dc7c7b2e1f49398249527d12078c6fdd38c47b41e5ac6c66cb28a2e0b3d3",
      "target_id": "ru-fr81-u218-r0002",
      "tag": "prose",
      "target_sha256": "1c9f26ef87cad09c1ada241d3ee33a4e3cdc9c81291f54699a09f7443eb990e2"
    },
    {
      "source_id": "fr81-u218-r0003",
      "target": "Внутренность жилища Жондрета являла необычайное зрелище, и Мариус понял, откуда взялся странный свет, который он там заметил. В позеленевшем от медянки подсвечнике горела свеча, но не она на самом деле освещала комнату. Вся конура словно была озарена отсветом довольно большой жаровни из листового железа, поставленной в камин и полной раскалённых углей. Той самой жаровни, которую жена Жондрета приготовила утром. Уголья пылали, жаровня раскалилась докрасна, над ней плясало голубое пламя, и в его свете можно было различить форму зубила, купленного Жондретом на улице Пьер-Ломбар: оно, воткнутое в жар, тоже наливалось красным. В углу, возле двери, лежали две кучи, как будто приготовленные для заранее намеченной цели: одна, казалось, была грудой железного лома, другая — грудой верёвок. Всё это, для человека, не знавшего, что здесь затевается, оставило бы ум в колебании между очень мрачной догадкой и очень простой. Притон, освещённый таким образом, был скорее похож на кузницу, чем на пасть ада, но Жондрет при этом свете смахивал скорее на демона, чем на кузнеца.",
      "source_sha256": "5b4bf0e1fc9e17e9b1c346a79140e86d52eea7c4f5b581152edcf59ead5117e2",
      "target_id": "ru-fr81-u218-r0003",
      "tag": "prose",
      "target_sha256": "cf39daec4d6e5487ad80e0ace85d7861f8ffaff74cd1c1aa210f77cebf25791f"
    },
    {
      "source_id": "fr81-u218-r0004",
      "target": "Жар от жаровни был так силён, что свеча на столе таяла с той стороны, что была обращена к ней, и оплывала скошенным краем. На камине стоял старый медный потайной фонарь, достойный Диогена, ставшего Картушем.",
      "source_sha256": "8bf6a5abfcfd775c892c20cf466c80e9cda2c4f0eee1896479939cf4c71b1da3",
      "target_id": "ru-fr81-u218-r0004",
      "tag": "prose",
      "target_sha256": "d2090a55e487d670f4a7106baef57a5d656fff330e8d4e5dc31dfdf3feb24b8d"
    },
    {
      "source_id": "fr81-u218-r0005",
      "target": "Жаровня, стоявшая прямо в очаге, рядом с почти погасшими головнями, выпускала свой чад в дымоход и не распространяла запаха.",
      "source_sha256": "744d75476770e3a5b023d3aef3463e4596989e8b490eda8ec78d4dfc7351339d",
      "target_id": "ru-fr81-u218-r0005",
      "tag": "prose",
      "target_sha256": "9003b0a990ee462746580561f2fb61450455b39865ec5a763f92cf1aac6a53e3"
    },
    {
      "source_id": "fr81-u218-r0006",
      "target": "Луна, входя через четыре стекла окна, бросала свою белизну в пурпурную, пылающую каморку, и для поэтической души Мариуса, мечтательной даже в миг действия, это было словно мысль неба, смешавшаяся с уродливыми грёзами земли.",
      "source_sha256": "a86f889684a2e90a5c80281b61764ef2eaed465b051125572e9b9ae348b64e5a",
      "target_id": "ru-fr81-u218-r0006",
      "tag": "prose",
      "target_sha256": "fb2d022bd135e97e8da535ac0b4255305adaf0bb7caa32a78fd4b3e9dda3813d"
    },
    {
      "source_id": "fr81-u218-r0007",
      "target": "Струя воздуха, проникавшая через разбитое стекло, помогала рассеивать запах угля и скрывать жаровню.",
      "source_sha256": "0cddd2b93870fc58b6adae7b4be54090054d76980f57bebccd95e6f4d3aae70a",
      "target_id": "ru-fr81-u218-r0007",
      "tag": "prose",
      "target_sha256": "a090c3a714805c5ce9e7e4c9f018bc530481d6bf4c3ec81b43eb5621a34c223c"
    },
    {
      "source_id": "fr81-u218-r0008",
      "target": "Логово Жондрета было, если вспомнить то, что мы говорили о лачуге Горбо, превосходно выбрано для того, чтобы служить сценой насильственного и мрачного дела и покровом преступления. Это была самая отдалённая комната самого уединённого дома на самом безлюдном бульваре Парижа. Если бы засады не существовало, её следовало бы придумать для этого места.",
      "source_sha256": "cdefd7ad81d5ae1c689795eca56ab4e9f9aa4934dfa6e38622be4cafac75a417",
      "target_id": "ru-fr81-u218-r0008",
      "tag": "prose",
      "target_sha256": "36902dab49aa0f90f473260beff63f8fbc84b43537cde76bbe7ca53156faa671"
    },
    {
      "source_id": "fr81-u218-r0009",
      "target": "Всю толщу дома и множество нежилых комнат отделяли эту дыру от бульвара, а единственное окно выходило на пустыри, обнесённые стенами и частоколами.",
      "source_sha256": "b2873f3ae005a46968ea766ada682e7b15ae76e000ed9bd47a4ad7d1d1abf74e",
      "target_id": "ru-fr81-u218-r0009",
      "tag": "prose",
      "target_sha256": "45b6af5d22c6f96275ac7a61f7c407225bec489edde05e8fb71499baf02e3cf2"
    },
    {
      "source_id": "fr81-u218-r0010",
      "target": "Жондрет раскурил трубку, уселся на стул с ободранным соломенным сиденьем и курил. Жена говорила ему вполголоса.",
      "source_sha256": "c557229dbb94cf8c56168897c339b721624bdb6d38fb0530706f057281c207e4",
      "target_id": "ru-fr81-u218-r0010",
      "tag": "prose",
      "target_sha256": "57a9a766ca8afdb378f1d4836a09b495daa74de76c45d56598922acf15eb795b"
    },
    {
      "source_id": "fr81-u218-r0011",
      "target": "Будь Мариус Курфейраком, то есть одним из тех людей, которые смеются при любых обстоятельствах жизни, он расхохотался бы, когда его взгляд упал на Жондретиху. На ней была чёрная шляпа с перьями, довольно похожая на шляпы герольдов на коронации Карла X, огромная шаль-тартан поверх вязаной юбки и мужские башмаки, которыми утром пренебрегла её дочь. Именно этот наряд исторг у Жондрета восклицание: [[I]]Отлично! ты[[/I]] [[I]]оделась! Хорошо сделала. Надо, чтобы ты могла внушать[[/I]] [[I]]доверие![[/I]]",
      "source_sha256": "e2a680855c959834d17afeccab1d6927d7e82ee7460a588f92ead4afc501877f",
      "target_id": "ru-fr81-u218-r0011",
      "tag": "prose",
      "target_sha256": "51f1a09d0583cd5d87109b4f6b335d1674a76f53fb47bfad502e5dc4d585e1b1"
    },
    {
      "source_id": "fr81-u218-r0012",
      "target": "Что до Жондрета, то он не снял нового сюртука, слишком широкого для него, который подарил ему господин Леблан, и его костюм по-прежнему являл тот контраст редингота и панталон, который в глазах Курфейрака составлял идеал поэта.",
      "source_sha256": "706ee7ea443e087474bdffc9489b6eee1c61136a79e6189fa859c5339859b5ae",
      "target_id": "ru-fr81-u218-r0012",
      "tag": "prose",
      "target_sha256": "715b48a30abe78405ba55fbf5e70c7cf57e1918090a2cb77feb3b49fc078c886"
    },
    {
      "source_id": "fr81-u218-r0013",
      "target": "Вдруг Жондрет повысил голос.",
      "source_sha256": "7b359742a0f4e59f7ceb85b943f7d37bf40f1c25b74992eec43d10184f2ab760",
      "target_id": "ru-fr81-u218-r0013",
      "tag": "prose",
      "target_sha256": "033601a7c34415171b1db29d863cd91b6570e34eb679a13f6cbfb181fcd609fc"
    },
    {
      "source_id": "fr81-u218-r0014",
      "target": "— Кстати! Вспомнил. В такую погоду он приедет в фиакре. Зажги фонарь, возьми его и спустись. Станешь за дверью внизу. Как только услышишь, что карета остановилась, сразу открой; он поднимется, ты посветишь ему на лестнице и в коридоре, а пока он будет входить сюда, живо сбегай вниз, заплати кучеру и отправь фиакр.",
      "source_sha256": "b93d5ea3f000e3cb9783a7a56c14fa590944bb6b263219df3a89b88758a0a6e9",
      "target_id": "ru-fr81-u218-r0014",
      "tag": "prose",
      "target_sha256": "62773e2e0c9ea0ceb3cf93ea88225f4eb62c9f23d04c0d6bd7747a7b1028d96d"
    },
    {
      "source_id": "fr81-u218-r0015",
      "target": "— А деньги? — спросила жена.",
      "source_sha256": "ce0d700b64f831c778997070044936af6884a08fd4bdd099440a24413ed7e0cf",
      "target_id": "ru-fr81-u218-r0015",
      "tag": "prose",
      "target_sha256": "70cc9f5300311dd477f4b1b9e14fefbe7900042a94cd71e412972e654e774c69"
    },
    {
      "source_id": "fr81-u218-r0016",
      "target": "Жондрет пошарил в панталонах и протянул ей пять франков.",
      "source_sha256": "2f18013adc21c547ab21d59b079109aad4a2b120c77b26c7aecffad51c68923c",
      "target_id": "ru-fr81-u218-r0016",
      "tag": "prose",
      "target_sha256": "768d383a889c6d1d5342514cab3bdfce932eda561133c9d006e80a159a158673"
    },
    {
      "source_id": "fr81-u218-r0017",
      "target": "— Это ещё что такое? — воскликнула она.",
      "source_sha256": "a5bd3aa075316e6a726e9a80b3c157d315fa818fa6c8bf2d2d546a81326b2f6e",
      "target_id": "ru-fr81-u218-r0017",
      "tag": "prose",
      "target_sha256": "ee022bbe3e72596e86edf7a8bfc5a72a42bed78385c9bde642ea283638c5120e"
    },
    {
      "source_id": "fr81-u218-r0018",
      "target": "Жондрет ответил с достоинством:",
      "source_sha256": "ab1be306cbfe91a1ef1b3234cb29872726e215fca9802c21f58246f418b05e71",
      "target_id": "ru-fr81-u218-r0018",
      "tag": "prose",
      "target_sha256": "d9f6cecc2fd49503c58ff1aad67ad8181dedad74132ee53137fa8395d99c5b1d"
    },
    {
      "source_id": "fr81-u218-r0019",
      "target": "— Это монарх, которого сосед дал нынче утром.",
      "source_sha256": "f4a7d11caa69f199ce9e492f0b42d6058359f9419fd43f43c4c4f01aab350dfd",
      "target_id": "ru-fr81-u218-r0019",
      "tag": "prose",
      "target_sha256": "e303149ba678ccebe03d1fbef8c1af497939f1c8b4beeb0639e2eef1c4e0065c"
    },
    {
      "source_id": "fr81-u218-r0020",
      "target": "И прибавил:",
      "source_sha256": "28e2be1d179c8a4bd4b91ea9b54982efb816aa795d34ee306f66e0f09be1974b",
      "target_id": "ru-fr81-u218-r0020",
      "tag": "prose",
      "target_sha256": "6dafeb517f1b8e49b812360b739556fc44d767270735a085eb4e94b22b7e289f"
    },
    {
      "source_id": "fr81-u218-r0021",
      "target": "— Знаешь что? Здесь понадобятся два стула.",
      "source_sha256": "7b0aa1ec9bcfdcd7688abde53ca4e598164868e911d5ad64be60aa57af2df2ae",
      "target_id": "ru-fr81-u218-r0021",
      "tag": "prose",
      "target_sha256": "2e6128ffbb9d6ced57a1358d9333fe944e94b789158dc4c67a1e124ffedbff7c"
    },
    {
      "source_id": "fr81-u218-r0022",
      "target": "— Зачем?",
      "source_sha256": "4b5154ea331b0a88da96b0d95a9812f8ce55fa954dcfa4511479082dd555da57",
      "target_id": "ru-fr81-u218-r0022",
      "tag": "prose",
      "target_sha256": "2dbb888fa6d413f7fe6e300e2500948cbeaa4517a86bc873b30ce37bc2bed5d3"
    },
    {
      "source_id": "fr81-u218-r0023",
      "target": "— Чтобы сидеть.",
      "source_sha256": "968bcf73f5000d6db5ce0a577bf885e60186410cea8106a37d085a7cb378564b",
      "target_id": "ru-fr81-u218-r0023",
      "tag": "prose",
      "target_sha256": "b78b1b198954b5fc9f3d522c65db5561093ca9c048aac1184a09479023a37c01"
    },
    {
      "source_id": "fr81-u218-r0024",
      "target": "Мариус почувствовал, как дрожь пробежала у него по пояснице, когда он услышал, что Жондретиха отвечает так спокойно:",
      "source_sha256": "2ec09482f732cda18580e87573ae898ee050c7b9740b247f8cfa57659ec80f31",
      "target_id": "ru-fr81-u218-r0024",
      "tag": "prose",
      "target_sha256": "80d5797a9c5b3fc1898746a5da04b8fcc9800daee58c57e43fb5303370b485a9"
    },
    {
      "source_id": "fr81-u218-r0025",
      "target": "— Чёрт возьми! Пойду принесу тебе стулья соседа.",
      "source_sha256": "ec9b20ea28c03a3a89bd8b8bacbb0d7011ce2f7619ff85b664b4668990788250",
      "target_id": "ru-fr81-u218-r0025",
      "tag": "prose",
      "target_sha256": "c8009eb021f462cd9346c4ef9d9655ef099fb744f0dc0d6010c4f3ffb25dabfc"
    },
    {
      "source_id": "fr81-u218-r0026",
      "target": "И быстрым движением она отворила дверь притона и вышла в коридор.",
      "source_sha256": "c56f2b1b078e72aecb27d0ffd445f113e8e30d29b9f1c0395d595c79cad5e57a",
      "target_id": "ru-fr81-u218-r0026",
      "tag": "prose",
      "target_sha256": "02b6d073f7efe9c2061c5bd2b690ff65cf61dda88c8a82793748f147a2b40322"
    },
    {
      "source_id": "fr81-u218-r0027",
      "target": "У Мариуса физически не было времени слезть с комода, добраться до кровати и спрятаться там.",
      "source_sha256": "952ad373ba2ec469c6630a8f04fc52c8a3cb5c0e0f736945730c86693c489460",
      "target_id": "ru-fr81-u218-r0027",
      "tag": "prose",
      "target_sha256": "ad47c4700c48f2edcc639c6e862acafe12bb4a5d381fee8592281ebc51efd4fb"
    },
    {
      "source_id": "fr81-u218-r0028",
      "target": "— Возьми свечу, — крикнул Жондрет.",
      "source_sha256": "e88be387d5fd2ac421fa15703ef08411817b5a9c9da73c4f81fcc44b3704ea50",
      "target_id": "ru-fr81-u218-r0028",
      "tag": "prose",
      "target_sha256": "ad7acee64a79663262edbc45d2b110c99b97cf9b1d270e1a01745255ca4fb423"
    },
    {
      "source_id": "fr81-u218-r0029",
      "target": "— Нет, — сказала она, — она будет мне мешать, мне нести два стула. Светит луна.",
      "source_sha256": "126372becc6e9a4aeacd16de07689bc3f5d178d2585c2d4724d4fc45728423e1",
      "target_id": "ru-fr81-u218-r0029",
      "tag": "prose",
      "target_sha256": "43c9757182a17008e63245efa047af7310ab7329d4238c8ac72f1b8f9c78ae2c"
    },
    {
      "source_id": "fr81-u218-r0030",
      "target": "Мариус услышал, как тяжёлая рука матери Жондрет ощупью ищет в темноте ключ. Дверь отворилась. Он остался пригвождённым к месту, оцепенев от потрясения и изумления.",
      "source_sha256": "37f8bfe301e71d31ab9ecbbdae31bb4ebe4a03c85076f02cb75d4e10901f0228",
      "target_id": "ru-fr81-u218-r0030",
      "tag": "prose",
      "target_sha256": "31786ded949406abe976dde3e0b0c6c367542ffb8185137a672c47d0b0875205"
    },
    {
      "source_id": "fr81-u218-r0031",
      "target": "Жондретиха вошла.",
      "source_sha256": "ba37540f7d4d24f10056e62bfe3f7e924d9ef93e764180913a2ed438a2273379",
      "target_id": "ru-fr81-u218-r0031",
      "tag": "prose",
      "target_sha256": "af8b0adebe4621fe1ded43ccbc3a2c1bfeb660320482359d9587ad8c8a218b50"
    }
  ],
