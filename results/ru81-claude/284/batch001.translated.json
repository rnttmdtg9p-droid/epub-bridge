{
  "unit": 284,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u284-r0032",
      "target": "Жавер, прислонённый к столбу и так опутанный верёвками, что не мог пошевелиться, держал голову прямо, с бесстрашной безмятежностью человека, который никогда не лгал.",
      "source_sha256": "87a925dc37256a1f4368572679eacfe156e21d0da3dbee35fd8f4926c6c9c527",
      "target_id": "ru-fr81-u284-r0032",
      "tag": "prose",
      "target_sha256": "5803fb0472643df9a131c70092d4306764b73b67a4c897874fa38a709e8a2a7b"
    },
    {
      "source_id": "fr81-u284-r0033",
      "target": "— Это шпик, — сказал Анжольрас.",
      "source_sha256": "aeeb7e7976a04aafdb7749f3e1e914341117722036869952096edf848135d12c",
      "target_id": "ru-fr81-u284-r0033",
      "tag": "prose",
      "target_sha256": "175ff840ca4ac8c88db294130d49a0120057df161207bf9a5b0903230231b36b"
    },
    {
      "source_id": "fr81-u284-r0034",
      "target": "И, повернувшись к Жаверу:",
      "source_sha256": "7240dc353ef5cc8d10f397c68b087f26aadb7cf73fc1ff3a024393656bc04919",
      "target_id": "ru-fr81-u284-r0034",
      "tag": "prose",
      "target_sha256": "48becd667208da239ad5ccf67389acd6115806c87a9c10fb063c2f268de512fe"
    },
    {
      "source_id": "fr81-u284-r0035",
      "target": "— Вас расстреляют за десять минут до того, как баррикада будет взята.",
      "source_sha256": "50ddd38673fec4815220ac0257910e0cc6e55a10c62a3f099239336fda11959e",
      "target_id": "ru-fr81-u284-r0035",
      "tag": "prose",
      "target_sha256": "10f9d0fe93a58d1fc6c8656c27e7b9a354847a64d25cd5ff1c27530e68975ec1"
    },
    {
      "source_id": "fr81-u284-r0036",
      "target": "Жавер ответил самым повелительным тоном:",
      "source_sha256": "e8d8d098b7fbb96128c4222697d298244ed3c31c98c2302e260afa82ce8ff60b",
      "target_id": "ru-fr81-u284-r0036",
      "tag": "prose",
      "target_sha256": "3ab3902aab553babd31f6166b29d7222adf6592306a17c3178654398fdda629f"
    },
    {
      "source_id": "fr81-u284-r0037",
      "target": "— Почему не сейчас же?",
      "source_sha256": "a0de218a7fae548d8e5bdc2f1bc91c6167651fc57ad55191e701b3fa1852a6f7",
      "target_id": "ru-fr81-u284-r0037",
      "tag": "prose",
      "target_sha256": "d2b7c2e4de34632653c669275c385f7041672415a6033796f57354c118ea7e30"
    },
    {
      "source_id": "fr81-u284-r0038",
      "target": "— Мы бережём порох.",
      "source_sha256": "df38444e4a3e2fa8e7376eb3fef575e5cffa8e009f2dc0948e07fba75e02ceaf",
      "target_id": "ru-fr81-u284-r0038",
      "tag": "prose",
      "target_sha256": "8bcade91421a2891aa2b97958b4b483abcc06c11ab9697e69e13a2b61cd38aea"
    },
    {
      "source_id": "fr81-u284-r0039",
      "target": "— Тогда покончите с этим ударом ножа.",
      "source_sha256": "8f985cf21baf550fc6f9ba95c1b5cd986d1d198392860449acfeedbfc813a44c",
      "target_id": "ru-fr81-u284-r0039",
      "tag": "prose",
      "target_sha256": "b3b864e18c181f0f4ab2e96d55c46fcb8784b4539592139853f7b22058cfbddf"
    },
    {
      "source_id": "fr81-u284-r0040",
      "target": "— Шпик, — сказал прекрасный Анжольрас, — мы судьи, а не убийцы.",
      "source_sha256": "61e6a264f50588bb11bd0d6e9e77f5ef8491db95e5322a7a630944085ee584ae",
      "target_id": "ru-fr81-u284-r0040",
      "tag": "prose",
      "target_sha256": "7d03321ba60fa6c6bf40be231ca5396fbaf258438a769a27d517677ce366ffe4"
    },
    {
      "source_id": "fr81-u284-r0041",
      "target": "Потом он позвал Гавроша.",
      "source_sha256": "3b9ea8efbac76a187808390d31c936b64104fb895a3c6c64e60656e8e0924504",
      "target_id": "ru-fr81-u284-r0041",
      "tag": "prose",
      "target_sha256": "0838b759db3ca4303d115180bc38bd5c70eb90fcbf735c54599556f658969cf1"
    },
    {
      "source_id": "fr81-u284-r0042",
      "target": "— Ты! Ступай по своему делу! Сделай, что я тебе сказал.",
      "source_sha256": "df06125c5bffabf8ebb4c716f3ac4aee0a43e1d92459a235da330524245a4593",
      "target_id": "ru-fr81-u284-r0042",
      "tag": "prose",
      "target_sha256": "3eb6e4953fd16d60232487ee8a151c9adbcfc5e2ce8fd1418d7111838e6f4c8c"
    },
    {
      "source_id": "fr81-u284-r0043",
      "target": "— Иду, — крикнул Гаврош.",
      "source_sha256": "116d1b330a739ef1d2891a27b88df1f043b83c80e2d7b56259fe0c8fff958995",
      "target_id": "ru-fr81-u284-r0043",
      "tag": "prose",
      "target_sha256": "5abf752eeeb6b2706dc862237ff5d2ce740849d5f1b64acb542c9888c12f4118"
    },
    {
      "source_id": "fr81-u284-r0044",
      "target": "И, остановившись перед уходом:",
      "source_sha256": "2266febbf4da754e03d27b6291318619f1666c6bbccb09f3f580994b03a7dac9",
      "target_id": "ru-fr81-u284-r0044",
      "tag": "prose",
      "target_sha256": "0a79e9bbefc3db142d4eb0bc63585ee207028cdf5998dbea7b272c9613cad48c"
    },
    {
      "source_id": "fr81-u284-r0045",
      "target": "— Кстати, вы отдадите мне его ружьё! А он добавил: Музыканта я вам оставляю, но кларнет хочу себе.",
      "source_sha256": "f18bfc60de7a4adb74615dca019653c15b9fb81cd8f61304c122e82257e71a5a",
      "target_id": "ru-fr81-u284-r0045",
      "tag": "prose",
      "target_sha256": "b1992b1a4703a9e9a495c122f82f1e94d47f52ec7390669186accc044c285e1b"
    },
    {
      "source_id": "fr81-u284-r0046",
      "target": "Мальчишка отдал честь по-военному и весело перемахнул через проход в большой баррикаде.",
      "source_sha256": "1df163219f416a0c74d51696cc3fa7c0f229dbd272bc1b325ebd8d619027d931",
      "target_id": "ru-fr81-u284-r0046",
      "tag": "prose",
      "target_sha256": "14f5024d017780d0272f6b43feb5582c1b7b83ccaf09af0c31ecbecb89a228b7"
    }
  ],
