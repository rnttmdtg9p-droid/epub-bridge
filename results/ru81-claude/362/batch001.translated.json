    },
    {
      "source_id": "fr81-u362-r0033",
      "target": "— Он сказал мне, что чувствует себя хорошо.",
      "source_sha256": "924a823b703fdda35bca7567d25f0cc775a9022d9e99a08c3790d182b8eaab60",
