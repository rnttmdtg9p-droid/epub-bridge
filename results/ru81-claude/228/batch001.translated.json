    },
    {
      "source_id": "fr81-u228-r0059",
      "target": "Гош.",
      "source_sha256": "21536e76abb51221d35ec351da31d36d5c74190db4f734462a73ca087505b505",
      "target_id": "ru-fr81-u228-r0059",
