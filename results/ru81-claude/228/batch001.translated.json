      "target_sha256": "15dd52682f149109f2597a1c3e8f0824f5a3f15391b25c5f54b5230e7ea860e4"
    },
    {
      "source_id": "fr81-u228-r0060",
      "target": "Марсо. Платон. Арбр-Сек.",
      "source_sha256": "094fc730ec4356529f7393fd420359d238e18d867c3bc3ad8169c7bf1c407136",
      "target_id": "ru-fr81-u228-r0060",
      "tag": "prose",
      "target_sha256": "68d90c3b795465a5859b94808ad1049ad6a5885e4ca8f0f0a06bfa5d47b37032"
    },
    {
      "source_id": "fr81-u228-r0061",
      "target": "Варшава. Тийи, газетчик «[[I]]Попюлер[[/I]]».",
      "source_sha256": "ae3d412c7cab23c607b68ee5c4dcd872df21f53a84fc552415ee07c1a52e354c",
      "target_id": "ru-fr81-u228-r0061",
      "tag": "prose",
      "target_sha256": "4643665746328505efe7c3d9363273eca3234a9921904e607a8da8bf558484fe"
    },
    {
      "source_id": "fr81-u228-r0062",
      "target": "Честный буржуа, в чьих руках остался этот список, знал его значение. По-видимому, этот список был полным перечнем секций четвёртого округа Общества прав человека, с именами и адресами начальников секций. Теперь, когда все эти факты, оставшиеся в тени, стали уже лишь историей, их можно обнародовать. Следует добавить, что основание Общества прав человека, видимо, относится ко времени более позднему, чем то, когда была найдена эта бумага. Быть может, это был лишь набросок.",
      "source_sha256": "da8f8570e3d32e42654a7c64ee091793c4e8f547a06b5ef4b9e4c24c5e95e29b",
      "target_id": "ru-fr81-u228-r0062",
      "tag": "prose",
      "target_sha256": "d9b5ea2eae00c575d044c8dc18be46114aaecd346315d19aedd2775462065077"
    },
    {
      "source_id": "fr81-u228-r0063",
      "target": "Однако же после толков и слов, после письменных улик начали проступать и факты вещественные.",
      "source_sha256": "59656f3f894cf5e4ae93daf592cbd37762521f507bdd9828e1072fc76c6173aa",
      "target_id": "ru-fr81-u228-r0063",
      "tag": "prose",
      "target_sha256": "8ac271f40e941218879b1d9bdf31d77a87be7c2b9b21e05a451843e5c5c9e22d"
    }
  ],
