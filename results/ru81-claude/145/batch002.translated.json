{
  "unit": 145,
  "batch": 2,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u145-r0064",
      "target": "— Это правильно.",
      "source_sha256": "290d2b572cb3ceffbefa726fb82d094dfd8a1cbe073d069e14d5a29c0c37c1fa",
      "target_id": "ru-fr81-u145-r0064",
      "tag": "prose",
      "target_sha256": "166e3fd17bd41460a34a5260b71a9e1192b6ebfdd034176d8f6a58115ffeddf1"
    },
    {
      "source_id": "fr81-u145-r0065",
      "target": "— Тогда пятнадцать франков штрафа.",
      "source_sha256": "c6df87998b4074b9c62a9e338be94894c2564e14cb1478f03501a3d6c3693f45",
      "target_id": "ru-fr81-u145-r0065",
      "tag": "prose",
      "target_sha256": "25bd93220dcfe856675f843aba5f1691a2d866cf08b93ce4b622466bde4e6bea"
    },
    {
      "source_id": "fr81-u145-r0066",
      "target": "— Пятнадцать франков!",
      "source_sha256": "02a01ad535a50fb8242dafc496967d676cffcb1d4bb5456f4e69043189bbb932",
      "target_id": "ru-fr81-u145-r0066",
      "tag": "prose",
      "target_sha256": "e6b3be28a518a9bba2de209ef2301763378edb073205431e4f421f9b24387a0b"
    },
    {
      "source_id": "fr81-u145-r0067",
      "target": "— Но время у вас есть… Где вы живёте?",
      "source_sha256": "47cc6d2d6375c3b3cfc2ca7254c950273f84aab56907bcb907b1669c44bcf1df",
      "target_id": "ru-fr81-u145-r0067",
      "tag": "prose",
      "target_sha256": "d2d2ddbf3d4ec5c5c626bf4049a92d2066b1198d2907daca95cb28221dedd95e"
    },
    {
      "source_id": "fr81-u145-r0068",
      "target": "— В двух шагах от заставы. Отсюда четверть часа ходу. Улица Вожирар, дом восемьдесят семь.",
      "source_sha256": "e7af7ad15d402c3bc0780d7cd1a6a9b31f3f2cac46bc68c3ea3f3835e213de0b",
      "target_id": "ru-fr81-u145-r0068",
      "tag": "prose",
      "target_sha256": "c1f0fb575453a0eb4b7d27c31c0c4b38c1f05b87fd6ef4df9b0248cdfe19c6e8"
    },
    {
      "source_id": "fr81-u145-r0069",
      "target": "— Так вы успеете, если подхватите свои ходули да припустите, выбраться сразу же.",
      "source_sha256": "5ad0c728552e3b573e3c771cfc1180bc542a75bcd09284d744e155c3946ecb63",
      "target_id": "ru-fr81-u145-r0069",
      "tag": "prose",
      "target_sha256": "bcb1bebf26df70b9a69c7d9707fcd6d4e048b9096f0c1500defeb84b762c44a0"
    },
    {
      "source_id": "fr81-u145-r0070",
      "target": "— Верно.",
      "source_sha256": "36e243e6aeb6e18c4fca448483306ee26e2f555bbdcc9f8ccdecc127a6e8d48d",
      "target_id": "ru-fr81-u145-r0070",
      "tag": "prose",
      "target_sha256": "34146dbedf056ba30f94b49feaba24ddda457a9e2d383e7c72481039faf1940c"
    },
    {
      "source_id": "fr81-u145-r0071",
      "target": "— Как выйдете за решётку, мчитесь домой, берёте свой билет, возвращаетесь, сторож кладбища вам отпирает. Раз билет при вас, платить не надо. И хороните своего покойника. А я его пока покараулю, чтоб не сбежал.",
      "source_sha256": "2197c652ea120eb4eaa9561dbaeb2cb0d0348299531c02d5e886a11c52b4bc60",
      "target_id": "ru-fr81-u145-r0071",
      "tag": "prose",
      "target_sha256": "c0022cebf1e0b7702e6f1c175d3096893c9b6fa3e0739f95a63c4e467326a751"
    },
    {
      "source_id": "fr81-u145-r0072",
      "target": "— Я обязан вам жизнью, землепашец.",
      "source_sha256": "b74561c9eed979d96f67c3c5d4002879552aacdc433ec4ba500246ef30e5937b",
      "target_id": "ru-fr81-u145-r0072",
      "tag": "prose",
      "target_sha256": "4ff5e4fe823ba55a2380b74401e6f8eef6e97a159624e0a10a9a55c0d20dc543"
    },
    {
      "source_id": "fr81-u145-r0073",
      "target": "— Убирайтесь-ка поскорей, — сказал Фошлеван.",
      "source_sha256": "fbc366ede91ac5e332c9c21010b595574d0564952e66cd0fe6ff635cf4399272",
      "target_id": "ru-fr81-u145-r0073",
      "tag": "prose",
      "target_sha256": "ddfa9a4b1840798c473bdbb60c88bff3d18da2430e9ef1ffa3f723d4d3db9e30"
    },
    {
      "source_id": "fr81-u145-r0074",
      "target": "Могильщик, вне себя от благодарности, потряс ему руку и побежал прочь.",
      "source_sha256": "325abecd62efac5b6aff0f3df82bcd63c789d4c1702c9c5ec446d42f50a55afd",
      "target_id": "ru-fr81-u145-r0074",
      "tag": "prose",
      "target_sha256": "5778f5c7425eda85959bbd4810e6785964745bcf9f62256e36fcbbb60416c506"
    },
    {
      "source_id": "fr81-u145-r0075",
      "target": "Когда могильщик скрылся в чаще, Фошлеван прислушивался, пока не затихли его шаги, затем наклонился над могилой и вполголоса сказал:",
      "source_sha256": "4336dbefba179db18a85cfdca61dbdc3648b282f9b103d65139a71f6208d829b",
      "target_id": "ru-fr81-u145-r0075",
      "tag": "prose",
      "target_sha256": "df692c21de8afabdfbc5d1c1341c93ac961434e80dedde817b782bf998cff6ea"
    },
    {
      "source_id": "fr81-u145-r0076",
      "target": "— Отец Мадлен!",
      "source_sha256": "f0998a6cbb9a6aee3d410623e8ff30109b1ea45a40f08c10b2dac6ee95b65b1d",
      "target_id": "ru-fr81-u145-r0076",
      "tag": "prose",
      "target_sha256": "120d563435e572418593de906115a19ebacddfc25acc06a46093ce4553db6e62"
    },
    {
      "source_id": "fr81-u145-r0077",
      "target": "Никто не ответил.",
      "source_sha256": "e63807163dd11f057672c731e306cbe55f7362ae4fca4ad8c21db044ca7c077a",
      "target_id": "ru-fr81-u145-r0077",
      "tag": "prose",
      "target_sha256": "e9561bb64b3e2123aaf5632eabd67f20c5125650a8f90e98a6fbb619ca2d14e4"
    },
    {
      "source_id": "fr81-u145-r0078",
      "target": "Фошлеван вздрогнул. Он скорее скатился в могилу, чем спустился в неё, бросился на изголовье гроба и закричал:",
      "source_sha256": "0203f9b6d90c935c9fdab94f80cfee2a24705b0d0957e231fbafb3d4df8c2f0f",
      "target_id": "ru-fr81-u145-r0078",
      "tag": "prose",
      "target_sha256": "d32df09636df3e4943549ef8c757d42070d15a013ac238f52972e8d05d5794c5"
    },
    {
      "source_id": "fr81-u145-r0079",
      "target": "— Вы тут?",
      "source_sha256": "b087f029420793b2a6abffa5a7b4e59feb63f7784d08de6394ee5abf52d2d4d2",
      "target_id": "ru-fr81-u145-r0079",
      "tag": "prose",
      "target_sha256": "aa014d285f0a2fc3002f61d31a348894d33d63e4b1743afb87eff2c43ebc4f2a"
    },
    {
      "source_id": "fr81-u145-r0080",
      "target": "В гробу была тишина.",
      "source_sha256": "a9d2f99febc3a45d0e98be0762dd85d0df02ef3bf30cd01aa3c0f2d4bfcdd23f",
      "target_id": "ru-fr81-u145-r0080",
      "tag": "prose",
      "target_sha256": "38c3041c376b5457738f97cc7630844f0f5e1217937a82effbd8a03162e3aae9"
    },
    {
      "source_id": "fr81-u145-r0081",
      "target": "Фошлеван, не дыша от дрожи, взял своё зубило и молоток и сорвал верхнюю доску. В сумеречном свете показалось лицо Жана Вальжана — бледное, с закрытыми глазами.",
      "source_sha256": "c4cad9aefbfc2541b5b85803bce0d3a4a49b2ae87bc2c92bf3d85e86433ae4c6",
      "target_id": "ru-fr81-u145-r0081",
      "tag": "prose",
      "target_sha256": "83880fed191b4ed2eb3a2f7ab6ab6660283cd50def22587806e03673572c4c43"
    },
    {
      "source_id": "fr81-u145-r0082",
      "target": "Волосы у Фошлевана встали дыбом, он выпрямился, затем привалился спиной к стенке могилы, готовый осесть прямо на гроб. Он посмотрел на Жана Вальжана.",
      "source_sha256": "8fc1d57548fce2e35b5b19549b389329c023f5b9582b698f46e92093d7cc2a39",
      "target_id": "ru-fr81-u145-r0082",
      "tag": "prose",
      "target_sha256": "48463db9008e8d47ddb457030ab46cf747517e5c6bae0183d9b4c28a829fd95a"
    },
    {
      "source_id": "fr81-u145-r0083",
      "target": "Жан Вальжан лежал бледный и неподвижный.",
      "source_sha256": "4db183d5e30a86e212703fb1a21fe5562dcd5914ea6d3ee82a87a054883813fc",
      "target_id": "ru-fr81-u145-r0083",
      "tag": "prose",
      "target_sha256": "45477227b74e2838f9dd8e6f0d5556620a2f78a282e6d0f2624135c7df33c764"
    },
    {
      "source_id": "fr81-u145-r0084",
      "target": "Фошлеван прошептал голосом тихим, как дыхание:",
      "source_sha256": "84caf5450a3f42c42fb7d7b1b32406b695a087f1a5808c7d17b9558c569bd895",
      "target_id": "ru-fr81-u145-r0084",
      "tag": "prose",
      "target_sha256": "f79dbe1bf727f8517d2435960bcc2cd53b132dba835af1514078b06a1bb52842"
    },
    {
      "source_id": "fr81-u145-r0085",
      "target": "— Он умер!",
      "source_sha256": "19260a04c3d71ca17506da0159516c3c59c31004d6d705fb7bb48a71e218babe",
      "target_id": "ru-fr81-u145-r0085",
      "tag": "prose",
      "target_sha256": "b8aa4a9f2f8f97085392e9010e38ad6e0d70ee43f76e5f93878b86971dffd6bf"
    },
    {
      "source_id": "fr81-u145-r0086",
      "target": "И, выпрямившись и скрестив руки так яростно, что два его стиснутых кулака ударили его по обоим плечам, он закричал:",
      "source_sha256": "0a4ee2ceea9f0ca1b39839434989a017b9b50683b77e0059927925a4c07b96e2",
      "target_id": "ru-fr81-u145-r0086",
      "tag": "prose",
      "target_sha256": "30e6ff7203fa56421427f7e85d8bd9e88ac7dc10e25bd1c48dd0dff0506f21b9"
    },
    {
      "source_id": "fr81-u145-r0087",
      "target": "— Вот как я его спасаю!",
      "source_sha256": "c06a927e0b0f920eeb5b753efe6fa00e84cb6c64bbd5677555bcc43a63c76189",
      "target_id": "ru-fr81-u145-r0087",
      "tag": "prose",
      "target_sha256": "5d970a0540afcb9333308c9a727cdb6038beb6c933e4753efc47769a693a178a"
    },
    {
      "source_id": "fr81-u145-r0088",
      "target": "Тут бедный старик принялся рыдать. Он говорил сам с собой, ибо ошибочно думать, будто монолог чужд природе. Сильное волнение нередко говорит вслух:",
      "source_sha256": "250ce2258702fb183d293c342720f34b7eb75e18b7c753620d8c9fe206f25b9c",
      "target_id": "ru-fr81-u145-r0088",
      "tag": "prose",
      "target_sha256": "586a2f0ee9e5e373e911ea5c586bbb121852f61d256e261e75eba405f0d44a59"
    },
    {
      "source_id": "fr81-u145-r0089",
      "target": "— Это всё папаша Местьен виноват. Зачем он помер, этот болван? Какая нужда ему была околевать, когда никто не ждал? Это он убивает господина Мадлена. Отец Мадлен! Он в гробу. Всё готово к выносу. Конец. — Да и где тут здравый смысл, в таких делах? Ах, боже мой! Он умер! Ну а его малышка, что мне с ней делать? Что скажет зеленщица? Чтобы такой человек так помер — да неужто это по-божески! Как подумаю, что он залез под мою телегу! Отец Мадлен! Отец Мадлен! Ей-богу, он задохнулся, я ведь говорил. Не пожелал мне верить. Ну вот, хорошенькую пакость мы учинили! Он умер, этот славный человек, самый добрый из всех добрых людей, каких только создал милосердный Бог! А его малышка! Ах! Нет уж, туда я не вернусь. Останусь здесь. Выкинуть этакую штуку! Стоило становиться двумя стариками, чтобы стать двумя старыми дураками. Да и как он вообще ухитрился войти в монастырь? С этого всё и началось. Не надо делать таких вещей. Отец Мадлен! Отец Мадлен! Отец Мадлен! Мадлен! Господин Мадлен! Господин мэр! Он меня не слышит. Выбирайтесь-ка теперь отсюда!",
      "source_sha256": "5483a4a46c241914e7c51298d6e5c660849c9dfc1bcd7edd79eee5073e449b47",
      "target_id": "ru-fr81-u145-r0089",
      "tag": "prose",
      "target_sha256": "f12cdd3278f50b4259b529100f0c25cd5f546f7a442e9534559644ba83ea55d9"
    },
    {
      "source_id": "fr81-u145-r0090",
      "target": "И он стал рвать на себе волосы.",
      "source_sha256": "fdd0177345bec9fd014a1cacd5a8ed2f9a55efe4b03b8210fae295acfa780a5f",
      "target_id": "ru-fr81-u145-r0090",
      "tag": "prose",
      "target_sha256": "11ada0d719d8ccd4250cdc3aa88155240d0b53f87610bc24e3e9cd2f18c41ce5"
    },
    {
      "source_id": "fr81-u145-r0091",
      "target": "Вдали, среди деревьев, послышался пронзительный скрип. Это закрывалась кладбищенская решётка.",
      "source_sha256": "507899809d43a55c53a1c200fa59d0d4559287d62448a7af0a4fe0fd6966ea56",
      "target_id": "ru-fr81-u145-r0091",
      "tag": "prose",
      "target_sha256": "b1f5cf42c6bbda0190a3cf7a0fbd855d496686a2ff84b12d1ab0c9f830cd5fa6"
    },
    {
      "source_id": "fr81-u145-r0092",
      "target": "Фошлеван склонился над Жаном Вальжаном и вдруг подскочил и отпрянул, насколько можно отпрянуть в могиле. Жан Вальжан смотрел на него широко открытыми глазами.",
      "source_sha256": "64a242d8ed3318c4de9c9a3eb5ea22000ff1e58d81c60d2335e77ceafe05bb56",
      "target_id": "ru-fr81-u145-r0092",
      "tag": "prose",
      "target_sha256": "dbbaed62fc6316e622b5bf1f11c211b8c13a21b95295f46a26fbfb793b55daec"
    },
    {
      "source_id": "fr81-u145-r0093",
      "target": "Видеть смерть страшно, видеть воскресение почти так же страшно. Фошлеван окаменел, побледнел, одичал, потрясённый этим избытком чувств, не зная, имеет ли он дело с живым или с мёртвым, и смотрел на Жана Вальжана, который смотрел на него:",
      "source_sha256": "21d2817d6eb0caca8c339f87fa72ec20a9e31df1587199a7698f8dd575f794b1",
      "target_id": "ru-fr81-u145-r0093",
      "tag": "prose",
      "target_sha256": "b7c5daf7ea334f3e50b5ddc602ea91a1913cbff2fb10ad6841bc0203bc7972ac"
    },
    {
      "source_id": "fr81-u145-r0094",
      "target": "— Я засыпал, — сказал Жан Вальжан.",
      "source_sha256": "c3fe795f9404c5f058b9343887ea67f96df1f0ce391c9f0abdee9061225159a4",
      "target_id": "ru-fr81-u145-r0094",
      "tag": "prose",
      "target_sha256": "ca5e7575f29bb40f835f653fae8fafccfd4a2a4b963786b05a0074e84138eb07"
    },
    {
      "source_id": "fr81-u145-r0095",
      "target": "И он приподнялся и сел.",
      "source_sha256": "7641ad24f0a2542bb8c21588e116e5b5c843faaf3b84121eb536ebd0c4a0981e",
      "target_id": "ru-fr81-u145-r0095",
      "tag": "prose",
      "target_sha256": "3f433ef3ce7373960d355602e8d305ff199caeb9eba64237270c9a7b3eebce35"
    }
  ],
