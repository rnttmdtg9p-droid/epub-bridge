{
  "unit": 145,
  "batch": 3,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u145-r0096",
      "target": "Фошлеван упал на колени.",
      "source_sha256": "ae5dcbf6609d21d66229e664c9c4c4e591f545564dd983c12701ffbf3679ce09",
      "target_id": "ru-fr81-u145-r0096",
      "tag": "prose",
      "target_sha256": "1d316e8777605282ce1c1821007f4969fc57cec3035bd331812acc4cfd725bcb"
    },
    {
      "source_id": "fr81-u145-r0097",
      "target": "— Пресвятая Дева! Ну и напугали же вы меня!",
      "source_sha256": "b5183ccf2488cc4090320d6df52698cd2da118379f820738e640c5de855b2960",
      "target_id": "ru-fr81-u145-r0097",
      "tag": "prose",
      "target_sha256": "a12d32b6c3fec05534b745029fa80f826c224263cb47082bd38e64b3817a5768"
    },
    {
      "source_id": "fr81-u145-r0098",
      "target": "Потом он поднялся и закричал:",
      "source_sha256": "0e2e68367131ebb44c716c6a8f69cf0f9659e9251e908ad244faeb80f727d53a",
      "target_id": "ru-fr81-u145-r0098",
      "tag": "prose",
      "target_sha256": "8197e0602b365d6082f88ff08c9492ffbc54976084606994d1db9d2c9ea30d23"
    },
    {
      "source_id": "fr81-u145-r0099",
      "target": "— Спасибо, отец Мадлен!",
      "source_sha256": "e6b195fe5e8e46368c9afa68e98b8050a81d19755f0a6e908b85a1c886e27ae0",
      "target_id": "ru-fr81-u145-r0099",
      "tag": "prose",
      "target_sha256": "beb74f41354400c4020f95dde3d2c95848a44059eadd7660e1357bb358eb6400"
    },
    {
      "source_id": "fr81-u145-r0100",
      "target": "Жан Вальжан был всего лишь в обмороке. Свежий воздух привёл его в чувство.",
      "source_sha256": "68081de9fa15d4e70c47e3d1053cf7beb2ba8db9e1d90cef5a39ccd35620185c",
      "target_id": "ru-fr81-u145-r0100",
      "tag": "prose",
      "target_sha256": "2fe3cf80628a7a087e4fe6f535f500f05b134e456ea62b450d26226b580e6226"
    },
    {
      "source_id": "fr81-u145-r0101",
      "target": "Радость — это отлив ужаса. Фошлевану пришлось почти так же трудно прийти в себя, как и Жану Вальжану.",
      "source_sha256": "58815f1074d32e0dbbdb55734bc324a7862b9e654d479c9d0f4ca6d63304cb33",
      "target_id": "ru-fr81-u145-r0101",
      "tag": "prose",
      "target_sha256": "fb229d1ebbed8a23d77985782c58548bee36645e8c73d3f91c7b403e709b961e"
    },
    {
      "source_id": "fr81-u145-r0102",
      "target": "— Так вы не умерли! Ах, до чего же вы умны! Я так звал вас, что вы и вернулись. Когда я увидел ваши закрытые глаза, я сказал: ну всё, задохнулся. Я бы взбесился, спятил бы по-настоящему, меня бы в смирительную рубашку. Упекли бы в Бисетр. Что мне было бы делать, если б вы умерли? А ваша малышка! Зеленщица ничего бы не поняла! Ей на руки сажают ребёнка, а дедушка умер! Вот так история! Святые угодники, вот так история! Ах, да вы живы — вот это самое лучшее!",
      "source_sha256": "32ed1c0046e82a13b2ddd1c81e64e9d5765fd73492792428ba1e93d54c565440",
      "target_id": "ru-fr81-u145-r0102",
      "tag": "prose",
      "target_sha256": "44099d414c0a1a48084aa00bdda29b1e51ff807deba6a3db06764616a6e1486f"
    },
    {
      "source_id": "fr81-u145-r0103",
      "target": "— Мне холодно, — сказал Жан Вальжан.",
      "source_sha256": "95b898bf4db334b448ce31a6b7ca20894a3adeabfa52526174660a17f84961fb",
      "target_id": "ru-fr81-u145-r0103",
      "tag": "prose",
      "target_sha256": "9682eef21c2ff74c4a601dea26723a6b947845c94c23ce38f7371c8d490e339f"
    },
    {
      "source_id": "fr81-u145-r0104",
      "target": "Это слово окончательно вернуло Фошлевана к действительности, а она была неотложной. Эти двое, даже придя в себя, невольно чувствовали смятение в душе, и в них было что-то странное — зловещее помрачение, навеянное самим этим местом.",
      "source_sha256": "aee851cb121381ae84d618372a6d655c62387479970eeaa7ab2fc01ad339c8ad",
      "target_id": "ru-fr81-u145-r0104",
      "tag": "prose",
      "target_sha256": "77f6e6de0cdbdb9e89728e2f7cd5a996cbdbee8fc3b45617b5fa45ff986fff56"
    },
    {
      "source_id": "fr81-u145-r0105",
      "target": "— Скорее выбираться отсюда, — вскрикнул Фошлеван.",
      "source_sha256": "c1036ec09af5f449f7f45412c6f119e48d8eadc32924feed0fe9cc74d9e21413",
      "target_id": "ru-fr81-u145-r0105",
      "tag": "prose",
      "target_sha256": "ac95bbbecc46d63a24d03960d501e0ec8a920ab780c98cedf6da395b0a8243cd"
    },
    {
      "source_id": "fr81-u145-r0106",
      "target": "Он порылся в кармане и вытащил фляжку, которую запас с собой.",
      "source_sha256": "a75f49dbc3fb9781ed9805d2c6a5936e4b0acd41956066a697f910d042a99ecf",
      "target_id": "ru-fr81-u145-r0106",
      "tag": "prose",
      "target_sha256": "4b5ca03d05195e0a23235a1d24aeb649b9b74f30e0550cdf81b65fca6038e8b1"
    },
    {
      "source_id": "fr81-u145-r0107",
      "target": "— Но сперва — глоточек! — сказал он.",
      "source_sha256": "4537013ffbe95f5bbc70e472f01d4e3862ce3978fc0822fec412533a8f32e616",
      "target_id": "ru-fr81-u145-r0107",
      "tag": "prose",
      "target_sha256": "c8225cfdbf0641b38f06e4047585a468d0dc6852081558358cab70d52977e4ef"
    },
    {
      "source_id": "fr81-u145-r0108",
      "target": "Фляжка довершила то, что начал свежий воздух. Жан Вальжан глотнул водки и полностью овладел собой.",
      "source_sha256": "2a801ca9e55afd04be43e3c53544c8f91ab2f8b6283c79c88487e0bc51d3f28c",
      "target_id": "ru-fr81-u145-r0108",
      "tag": "prose",
      "target_sha256": "165bc2e00f76539f3df6ae0d1d27493c6fe015e8b84de00978bbaf20cfd2988a"
    },
    {
      "source_id": "fr81-u145-r0109",
      "target": "Он вылез из гроба и помог Фошлевану заново заколотить крышку.",
      "source_sha256": "6195135cbe5b9e9e3ac9c8b48ba14798f43f58aca182b70da6397cf36bf83677",
      "target_id": "ru-fr81-u145-r0109",
      "tag": "prose",
      "target_sha256": "923fbd8e7e7af53531f91fe45a3e5ba00cb289cc579f7de017b6279dfe8f1d45"
    },
    {
      "source_id": "fr81-u145-r0110",
      "target": "Через три минуты они уже были вне могилы.",
      "source_sha256": "4fcb8aeacb77693743e0982ccb5fa8b35eac0f9d78d56c1c024b05d062b9acc8",
      "target_id": "ru-fr81-u145-r0110",
      "tag": "prose",
      "target_sha256": "ad28c6808d71086393b8ad9472d2988816267e28d47f635b2efaf44483f79879"
    },
    {
      "source_id": "fr81-u145-r0111",
      "target": "Впрочем, Фошлеван был спокоен. Он не спешил. Кладбище было закрыто. Появления могильщика Грибье опасаться не приходилось. Этот «новобранец» сидел дома и искал свой пропуск, да только не мог найти его в своей лачуге, потому что пропуск лежал в кармане у Фошлевана. Без пропуска он не мог вернуться на кладбище.",
      "source_sha256": "1141f8318e85c5810cbb66f3762a7f7d1d275973c48acfd8ca36052e2133ed4c",
      "target_id": "ru-fr81-u145-r0111",
      "tag": "prose",
      "target_sha256": "347ec37d1294c9a924b37db21ccad2e54ae630e67d0b2f6f6ba34b1d7b120a04"
    },
    {
      "source_id": "fr81-u145-r0112",
      "target": "Фошлеван взял лопату, Жан Вальжан — кирку, и они вдвоём похоронили пустой гроб.",
      "source_sha256": "fb31236d35fe06353518bf86801aaf8f8d9a5a439a522efbd8cda2a8d78f5b7e",
      "target_id": "ru-fr81-u145-r0112",
      "tag": "prose",
      "target_sha256": "24285e5cb17d79307dcb770a51c4602a3be9d6b4be4381e41bade9b545a44259"
    },
    {
      "source_id": "fr81-u145-r0113",
      "target": "Когда могила была засыпана, Фошлеван сказал Жану Вальжану:",
      "source_sha256": "f2785d216f010383c933ac5659f965e8e3e99fefc51cad4c1b0dc5dfd37c9581",
      "target_id": "ru-fr81-u145-r0113",
      "tag": "prose",
      "target_sha256": "5c956c5e2d22d3f800142187eca8e598fe21ab809d304e74792ad0c1657c4221"
    },
    {
      "source_id": "fr81-u145-r0114",
      "target": "— Пойдёмте. Лопату я оставлю себе, а вы возьмите кирку.",
      "source_sha256": "5a385cf22fff61189d5f301220c50e07aa2ced4d56ea6e8df2d876d950a64310",
      "target_id": "ru-fr81-u145-r0114",
      "tag": "prose",
      "target_sha256": "f1bb8df7017f3162a719dc7af01056415d7e1f0240ea47077ff1f76bfe6b6a3f"
    },
    {
      "source_id": "fr81-u145-r0115",
      "target": "Смеркалось.",
      "source_sha256": "a5108d8eeab46a928211dfcf881ad886817cab7ba2ca49a4c92fa0dc65ef91d8",
      "target_id": "ru-fr81-u145-r0115",
      "tag": "prose",
      "target_sha256": "a2700a75731fd76371f909b0fbeb221add9c6b2d963f2afc0abe560ee2933f27"
    },
    {
      "source_id": "fr81-u145-r0116",
      "target": "Жану Вальжану было нелегко двигаться и идти. В гробу он окоченел и стал немного трупом. Между этими четырьмя досками его схватило оцепенение смерти. Ему пришлось, так сказать, оттаивать после склепа.",
      "source_sha256": "f3d0a4437080a6e4ebd3c7aefc64389195e33d1123873ceda4c5a435df2867da",
      "target_id": "ru-fr81-u145-r0116",
      "tag": "prose",
      "target_sha256": "b1e5d740fe7d0da15c65a098587b418ff5fd2563cd10a0a3a68b84f188b5717b"
    },
    {
      "source_id": "fr81-u145-r0117",
      "target": "— Вы закоченели, — сказал Фошлеван. — Жаль, что я хромой, а то бы мы поколотили нога об ногу.",
      "source_sha256": "33c3b092c762b96f79489376c1bc8eb752725cd75d00ef1aa981d594684e588e",
      "target_id": "ru-fr81-u145-r0117",
      "tag": "prose",
      "target_sha256": "9aff8264cdb4f9353a2701c7c0c567fa459710a00e18cfe8e42123e8490ea96e"
    },
    {
      "source_id": "fr81-u145-r0118",
      "target": "— Ничего! — ответил Жан Вальжан. — Четыре шага — и ноги снова пойдут.",
      "source_sha256": "0a1834918a64d3da9e5f9eeab51f53ed645207ca8f34a58f111d057ec0be0f0e",
      "target_id": "ru-fr81-u145-r0118",
      "tag": "prose",
      "target_sha256": "7cc8044abb4c1ea7acae0431f9c819539b399ef3574663696cd5589025abce5c"
    },
    {
      "source_id": "fr81-u145-r0119",
      "target": "Они пошли по аллеям, по которым проезжал катафалк. Подойдя к запертой решётке и домику привратника, Фошлеван, державший в руке пропуск могильщика, бросил его в ящик; привратник дёрнул за шнур, дверь отворилась, и они вышли.",
      "source_sha256": "554da847fb6cc25a386c3958bade52e573e87d02e2a211e5dd6571e8add552e1",
      "target_id": "ru-fr81-u145-r0119",
      "tag": "prose",
      "target_sha256": "14e072c17a22f5160c40a2f628bb7138772f25a70fbc57c3f102f724106040cc"
    },
    {
      "source_id": "fr81-u145-r0120",
      "target": "— До чего всё ладно получилось! — сказал Фошлеван. — Какая славная мысль пришла вам в голову, отец Мадлен!",
      "source_sha256": "583ddb3539a0e01b27508bda84effc57779d7ec969253fabe7efd86b85a9449f",
      "target_id": "ru-fr81-u145-r0120",
      "tag": "prose",
      "target_sha256": "29e15834f4e39b34d780c72046fb0db939d8fec7c1c9218e9b61cd4552ef4bb3"
    },
    {
      "source_id": "fr81-u145-r0121",
      "target": "Они прошли заставу Вожирар самым простым на свете образом. Возле кладбища лопата и кирка — всё равно что два паспорта.",
      "source_sha256": "14562824364f6657a4f36f3b4c932596805bef4a73c18c6e8eb83ad5e63b3dcf",
      "target_id": "ru-fr81-u145-r0121",
      "tag": "prose",
      "target_sha256": "1e928a6acb6c3a74b531fa4137d89645b737e49f50c2d4f9b7b4d9fb0f488b1b"
    },
    {
      "source_id": "fr81-u145-r0122",
      "target": "Улица Вожирар была пустынна.",
      "source_sha256": "66e5689de894bff3d4bc0b5f27470d7b68963c2f486683c3fea3161d278064db",
      "target_id": "ru-fr81-u145-r0122",
      "tag": "prose",
      "target_sha256": "7a92cb112fd52a0ffa79d6746735bad0d3e83b8a6f208bb0541f81c315ac12e6"
    },
    {
      "source_id": "fr81-u145-r0123",
      "target": "— Отец Мадлен, — сказал Фошлеван, на ходу поднимая глаза к домам, — у вас глаза лучше, чем у меня. Покажите-ка мне номер восемьдесят седьмой.",
      "source_sha256": "1916a3f0a069707d4ff184649e53569c9499d684448dfafd8ee405be8739ab2b",
      "target_id": "ru-fr81-u145-r0123",
      "tag": "prose",
      "target_sha256": "b0b3cc174fd495d66f953261a6fbee929dc01eb43a830a467f3662af9f21b29d"
    },
    {
      "source_id": "fr81-u145-r0124",
      "target": "— Вот он как раз, — сказал Жан Вальжан.",
      "source_sha256": "7b3b8c59ab247d313939deb101324f6a702012b94a9365c556a7c55027be2b04",
      "target_id": "ru-fr81-u145-r0124",
      "tag": "prose",
      "target_sha256": "365b8cbdc08b69a4f4d307148bf5debeeaceef07d08f8eb6bbeb430ff32c4ad1"
    },
    {
      "source_id": "fr81-u145-r0125",
      "target": "— На улице никого нет, — продолжал Фошлеван. — Дайте мне кирку и подождите меня две минуты.",
      "source_sha256": "23fce676776357687bb26df3e94aefdd8c3b3f5f08e076780b28ac0143602a00",
      "target_id": "ru-fr81-u145-r0125",
      "tag": "prose",
      "target_sha256": "7d84ade38d1134a7343cbb2c290b812edf80df6e526f6e40cfce6661b93c85f2"
    },
    {
      "source_id": "fr81-u145-r0126",
      "target": "Фошлеван вошёл в дом номер восемьдесят семь и поднялся до самого верха, ведомый инстинктом, который всегда ведёт бедняка на чердак, и постучал в темноте в дверь мансарды. Голос ответил:",
      "source_sha256": "efcaebd5aea869610cc0cf8604b71579eaaa3aae4d046a881222807ed8bc07f4",
      "target_id": "ru-fr81-u145-r0126",
      "tag": "prose",
      "target_sha256": "1d89957fe2dc27a3fbb4b85e5d47cbfe5293ab5a489d7ca274270527ca5a9aa0"
    },
    {
      "source_id": "fr81-u145-r0127",
      "target": "— Войдите.",
      "source_sha256": "215555e42c4dd1f4dd0d04fc8e0baef402db21b8e7095020b017eaf8aaf12814",
      "target_id": "ru-fr81-u145-r0127",
      "tag": "prose",
      "target_sha256": "0d9325297e5ceb86c723b3a5f3daad730f80f273932e610c02960e2f109f2c21"
    }
  ],
