{
  "unit": 145,
  "batch": 4,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u145-r0128",
      "target": "Это был голос Грибье.",
      "source_sha256": "cfaba3b8e3d24ccd0a6cc89f52d01136539f3aa4221b8af111d79aa5bd7e9a95",
      "target_id": "ru-fr81-u145-r0128",
      "tag": "prose",
      "target_sha256": "2e23e602699720ca1031aac734acd9e7f0dcc2dbe8e9a193da3a1d05e046c7f7"
    },
    {
      "source_id": "fr81-u145-r0129",
      "target": "Фошлеван толкнул дверь. Жилище могильщика было, как и все эти злосчастные обиталища, голой и вместе с тем загромождённой конурой. Упаковочный ящик — быть может, гроб — служил там комодом, горшок из-под масла — рукомойником, тюфяк — постелью, а пол заменял и стулья, и стол. В углу, на какой-то тряпке, бывшей когда-то клочком старого ковра, сбились в кучу худая женщина и множество ребятишек. Всё это бедное убранство носило следы разгрома. Можно было подумать, что здесь произошло землетрясение — «для одного». Крышки были сдвинуты, лохмотья разбросаны, кувшин разбит, мать плакала, а детей, по всей вероятности, поколотили: то были следы яростного и грубого обыска. Было видно, что могильщик исступлённо искал свою карточку и сделал виноватым в её пропаже всё в этой конуре, от кувшина до жены. Вид у него был отчаянный.",
      "source_sha256": "64c865721758f67147e15467c5b2e8b432af626e9bc066e55e692047f24a7fb2",
      "target_id": "ru-fr81-u145-r0129",
      "tag": "prose",
      "target_sha256": "155d2d18084859fff5957fe575fcb4d60afee7a596ddc73ce5a70c0e93e20930"
    },
    {
      "source_id": "fr81-u145-r0130",
      "target": "Но Фошлеван слишком спешил к развязке приключения, чтобы заметить эту печальную сторону своего успеха.",
      "source_sha256": "1c6467cdb53a1752828fdaa2ce71f1f92ee49bd95f0be683c98fa8f69465e5f9",
      "target_id": "ru-fr81-u145-r0130",
      "tag": "prose",
      "target_sha256": "ddfa699fd9711a4c792728040a5a3e0f4fccc6b0630815933825a60b79bbc079"
    },
    {
      "source_id": "fr81-u145-r0131",
      "target": "Он вошёл и сказал:",
      "source_sha256": "8e17eaa2fea2b7a2c0cf6fd2bfef4a77e87010ed1c7c147f3fc7d3d7ceced5e9",
      "target_id": "ru-fr81-u145-r0131",
      "tag": "prose",
      "target_sha256": "55e84b293bbb5b13377072d41d5fc494f9e6d2c307bc333824e71c78d0167361"
    },
    {
      "source_id": "fr81-u145-r0132",
      "target": "— Я принёс вам вашу кирку и вашу лопату.",
      "source_sha256": "0b94b2b605e632b190f0aee490850f8758c98715ff9808a0819f426e525a28b7",
      "target_id": "ru-fr81-u145-r0132",
      "tag": "prose",
      "target_sha256": "ab8ce050dc359746774a19f9fdfc42940266fd35d87081fa9ce1177813034524"
    },
    {
      "source_id": "fr81-u145-r0133",
      "target": "Грибье посмотрел на него в изумлении.",
      "source_sha256": "3526f31598d59279d6120d69f2e695a3e80d7ae9b3b0375e60b679ff635fddc7",
      "target_id": "ru-fr81-u145-r0133",
      "tag": "prose",
      "target_sha256": "78b7fb4a06378333a2c91b40f811e24183122f2c1689a8730bab5ff4c6359269"
    },
    {
      "source_id": "fr81-u145-r0134",
      "target": "— Это вы, землячок?",
      "source_sha256": "efea72d0c47cc7c593d7496a0a07c5cc98c6c69b55c1e1b82a2cc6d16b155428",
      "target_id": "ru-fr81-u145-r0134",
      "tag": "prose",
      "target_sha256": "37c51efabbc7ff28b2c609567cd5fd42b5bbfc4cc5d900b163bd8ba2f0a1c12e"
    },
    {
      "source_id": "fr81-u145-r0135",
      "target": "— А завтра утром у кладбищенского привратника вы найдёте свою карточку.",
      "source_sha256": "cb1014242406f780eb721ac39d7ea3bc674343b3bf80b907cef8334d7743d04e",
      "target_id": "ru-fr81-u145-r0135",
      "tag": "prose",
      "target_sha256": "a8dd4e3aaf18aa17d785f0d2c31db1de04feb825adaebb4730a35c459e38d618"
    },
    {
      "source_id": "fr81-u145-r0136",
      "target": "И он положил лопату и кирку на пол.",
      "source_sha256": "49a991d1543f411527485a658823d4bb7f3bec517e6f9372e6c13a3886124553",
      "target_id": "ru-fr81-u145-r0136",
      "tag": "prose",
      "target_sha256": "10f04f6f9d14988709c6b13b2124046a18a3e907d5b93e08f2072b0fb775a43a"
    },
    {
      "source_id": "fr81-u145-r0137",
      "target": "— Что это значит? — спросил Грибье.",
      "source_sha256": "7a7e1bfe4029d14c92727b78f89beb47f0ecc63f2bdda2682f940963e31e39ae",
      "target_id": "ru-fr81-u145-r0137",
      "tag": "prose",
      "target_sha256": "0d214bed4386136382c161d7763f12efa18701e644a0b93568de12884e58bc7e"
    },
    {
      "source_id": "fr81-u145-r0138",
      "target": "— Это значит, что вы выронили свою карточку из кармана, что я нашёл её на земле, когда вы ушли, что я похоронил покойника, засыпал могилу, сделал вашу работу, что привратник отдаст вам вашу карточку и что вы не заплатите пятнадцати франков. Вот и всё, новобранец.",
      "source_sha256": "41d92d649692012162a0cc32d395fc879040c9a0a42da488d79263bb41503814",
      "target_id": "ru-fr81-u145-r0138",
      "tag": "prose",
      "target_sha256": "72e2ce6d12f1267e431a8dd5283fc350ad383df5b9016f5d4d79044b3a531d7a"
    },
    {
      "source_id": "fr81-u145-r0139",
      "target": "— Спасибо, деревенский! — воскликнул ошеломлённый Грибье. — В следующий раз выпивку ставлю я.",
      "source_sha256": "01607e6ba3529a9df3e1e322603afeac978743c93aa69f1fe6f2de8d6145839b",
      "target_id": "ru-fr81-u145-r0139",
      "tag": "prose",
      "target_sha256": "6521d5e54bec1bc9883b76d048884182ce8d22b396acd15164abe9961c6e6b43"
    }
  ],
