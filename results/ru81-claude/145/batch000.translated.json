{
  "unit": 145,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u145-h",
      "target": "VII. Где читатель найдёт происхождение выражения: не потерять карту",
      "source_sha256": "e9ce363e37fd47ecbe35070137e2713f49739c77c267d21084941dd644adbfdc",
      "target_id": "ru-fr81-u145-h",
      "tag": "heading",
      "target_sha256": "7a4083fc5b75d7668136cf69400fa582e8e11cdfd298246cbb143ddbeea52c83"
    },
    {
      "source_id": "fr81-u145-r0001",
      "target": "Вот что происходило над гробом, в котором лежал Жан Вальжан.",
      "source_sha256": "7d9dc09d8f24e79fd3a211cb58f0d7f16be8eb9c1d59aca6b6705a3c2d303dba",
      "target_id": "ru-fr81-u145-r0001",
      "tag": "prose",
      "target_sha256": "accce0f282c2821522b26c74200b7c356afc70c32c856a2af64f598d7223efa5"
    },
    {
      "source_id": "fr81-u145-r0002",
      "target": "Когда катафалк отъехал, когда священник и певчий мальчик снова сели в карету и уехали, Фошлеван, не спускавший глаз с могильщика, увидел, как тот наклонился и схватил свою лопату, торчавшую прямо в куче земли.",
      "source_sha256": "c83f09e7fe2ac2eb328247e12164eb2b0041950d1799a6a3165d5e07a0b9960d",
      "target_id": "ru-fr81-u145-r0002",
      "tag": "prose",
      "target_sha256": "c2433b49a2e812e4eb2a6512ce2ed048f85cf95f479cade5f9cff0749d881bc3"
    },
    {
      "source_id": "fr81-u145-r0003",
      "target": "Тогда Фошлеван принял последнее, отчаянное решение.",
      "source_sha256": "3148e8465caa3a46e4b1be66edbcd38e71788454b859fffa7ffbd6f1e8142f0c",
      "target_id": "ru-fr81-u145-r0003",
      "tag": "prose",
      "target_sha256": "51a5bf920956655e4685dadb4e05a543b19cb03dce510e981be14a015fb4c3bb"
    },
    {
      "source_id": "fr81-u145-r0004",
      "target": "Он стал между могилой и могильщиком, скрестил руки и сказал:",
      "source_sha256": "19109a6811f8a38b53ff9a5a07b0cd7e67cc529ddcb71d9dafbf3ee76465a416",
      "target_id": "ru-fr81-u145-r0004",
      "tag": "prose",
      "target_sha256": "2a9dfda365b5e42795b2ddecaa260b0e54f731feac5c88d4d50fe4d1b32cd9a5"
    },
    {
      "source_id": "fr81-u145-r0005",
      "target": "— Плачу я!",
      "source_sha256": "bb2c8ee6a1d1bac7b8765cfffbf4708d8cc687e0b60df1c93502ad61f3b9616d",
      "target_id": "ru-fr81-u145-r0005",
      "tag": "prose",
      "target_sha256": "f35655db879f44c497e4cfbc33f286993ed75b01defe4c4b810f30a91d85fde8"
    },
    {
      "source_id": "fr81-u145-r0006",
      "target": "Могильщик посмотрел на него с удивлением и ответил:",
      "source_sha256": "2ab0b365a5b73503a1326b845eb6ff339a24b5655c5843d45d4ca752a5fba8be",
      "target_id": "ru-fr81-u145-r0006",
      "tag": "prose",
      "target_sha256": "b8394955b0f18764911eec94cf06aca8185599c940505827a8a1c869a04a82f2"
    },
    {
      "source_id": "fr81-u145-r0007",
      "target": "— Что такое, мужик?",
      "source_sha256": "ea119e1153f22ebc112ab034ae0b0033c657c4b2015608fa880b148f6865686c",
      "target_id": "ru-fr81-u145-r0007",
      "tag": "prose",
      "target_sha256": "31c7d39b923a2aa824640c912ecf80ee900aeed0e08fbaa2774c42b2a099518c"
    },
    {
      "source_id": "fr81-u145-r0008",
      "target": "Фошлеван повторил:",
      "source_sha256": "181875bd50c11d1859ad86c0f061db4f361da1844f1d67a25ddb6d6955d05418",
      "target_id": "ru-fr81-u145-r0008",
      "tag": "prose",
      "target_sha256": "43c4edc074c8bb6afff63b26a1555a75b7147fdda88f83eefd77246e7f005b52"
    },
    {
      "source_id": "fr81-u145-r0009",
      "target": "— Плачу я!",
      "source_sha256": "bb2c8ee6a1d1bac7b8765cfffbf4708d8cc687e0b60df1c93502ad61f3b9616d",
      "target_id": "ru-fr81-u145-r0009",
      "tag": "prose",
      "target_sha256": "f35655db879f44c497e4cfbc33f286993ed75b01defe4c4b810f30a91d85fde8"
    },
    {
      "source_id": "fr81-u145-r0010",
      "target": "— Что?",
      "source_sha256": "61a0fac8ae488c6bc653f1215cdda5ca31b778598be9273b7ab3b579855004d9",
      "target_id": "ru-fr81-u145-r0010",
      "tag": "prose",
      "target_sha256": "517f3ff122eb546ca36332ec960df6083fe4c7e2f428e22ee5ca0183ce22e859"
    },
    {
      "source_id": "fr81-u145-r0011",
      "target": "— За вино.",
      "source_sha256": "d8e85800f8f2b05e32a2f7030277a4e0737a20350d0acec38ebdc4c24479484f",
      "target_id": "ru-fr81-u145-r0011",
      "tag": "prose",
      "target_sha256": "be7b2d5adab1037c48447872fc40e462a1527568c60d6db6ef98eb753225670a"
    },
    {
      "source_id": "fr81-u145-r0012",
      "target": "— Какое вино?",
      "source_sha256": "a0090a8ce66b385664953cbd4cb263a6b69881d3de32130c738df9debc9f8622",
      "target_id": "ru-fr81-u145-r0012",
      "tag": "prose",
      "target_sha256": "58e45aac09db8d0f9bd6f576b9cced0ba6cb412acc907dca6954c65b7cb3651a"
    },
    {
      "source_id": "fr81-u145-r0013",
      "target": "— Аржантейльское.",
      "source_sha256": "a4e459cd1416ba2e3a80b2a7ebf04fa7f3d4668e5f0e51cbff42b2acc9afef6e",
      "target_id": "ru-fr81-u145-r0013",
      "tag": "prose",
      "target_sha256": "1449845f6e7641c4442637c59a4f68e3b0ef5470bee6822c2b3feb476026671b"
    },
    {
      "source_id": "fr81-u145-r0014",
      "target": "— А где это аржантейльское?",
      "source_sha256": "f44c5cc8198b7ca7165e71bea88939b1387b13cdf37601507bee5b17ef66a7e5",
      "target_id": "ru-fr81-u145-r0014",
      "tag": "prose",
      "target_sha256": "4bccdc74e0ab670db8954c1ca9cbb44739db41ac3cc6ab7cd08f44d402ef041f"
    },
    {
      "source_id": "fr81-u145-r0015",
      "target": "— В «Спелой айве».",
      "source_sha256": "02073fe51e5574bc9280809649469f957ce650d3bc8ff7a2900a8495842b11a3",
      "target_id": "ru-fr81-u145-r0015",
      "tag": "prose",
      "target_sha256": "e50e73d25b81fc564d1d985edd1046e2336449b9e6d70014bd135f1c29fc4f8a"
    },
    {
      "source_id": "fr81-u145-r0016",
      "target": "— Иди к чёрту! — сказал могильщик.",
      "source_sha256": "7a291b368f5cd4b018bccc3b2bc44b77ea65f58843779ec795e6d567d44a2e02",
      "target_id": "ru-fr81-u145-r0016",
      "tag": "prose",
      "target_sha256": "18fc6b318b49d057b705ad2fe6451471a009e616e5d0b3060a4392d7926e583b"
    },
    {
      "source_id": "fr81-u145-r0017",
      "target": "И бросил лопату земли на гроб.",
      "source_sha256": "f6a6b35e0c1ab520d6108d4133a36c07f06ea529145f68aaf0850350bcf090eb",
      "target_id": "ru-fr81-u145-r0017",
      "tag": "prose",
      "target_sha256": "1d49d3a98aa042ab4f84dc34c63fd58b7b287a6ab54cf5bbbeff5dde615c1665"
    },
    {
      "source_id": "fr81-u145-r0018",
      "target": "Гроб отозвался глухим звуком. Фошлеван почувствовал, что шатается и сам готов упасть в могилу. Он закричал голосом, в котором уже начинало примешиваться удушье предсмертного хрипа:",
      "source_sha256": "8365947676135145cc594125b4917ab5cdc97bfd9f4f940bf4fda174a4b24c5d",
      "target_id": "ru-fr81-u145-r0018",
      "tag": "prose",
      "target_sha256": "78b514e3051a01b2754053d42ff8f9d4f82e91d76c69c8801e4b973f8a1e444b"
    },
    {
      "source_id": "fr81-u145-r0019",
      "target": "— Товарищ, пока не закрылась «Спелая айва»!",
      "source_sha256": "e2dccdb5de429b8106aee166bc5f0e3675c04281516e797b23e29cb3ad3b8872",
      "target_id": "ru-fr81-u145-r0019",
      "tag": "prose",
      "target_sha256": "d0551cf0d0d9f8781160fd92f256218302de2854da41e5b214d4ce6dd0221d29"
    },
    {
      "source_id": "fr81-u145-r0020",
      "target": "Могильщик снова набрал земли в лопату. Фошлеван продолжал:",
      "source_sha256": "854f8e57198373f9169fae39f9a6a7aa095641e13f17a04e562abee2aa6eabe0",
      "target_id": "ru-fr81-u145-r0020",
      "tag": "prose",
      "target_sha256": "544ecd6a223c9a6cda41a5a33f1fc7366792af2feb93911477a735d3ecd3fba0"
    },
    {
      "source_id": "fr81-u145-r0021",
      "target": "— Я плачу!",
      "source_sha256": "00ab875ffc348cacd1329a77cf530e3ca47b6410e4e9932e71c2c5699632d09d",
      "target_id": "ru-fr81-u145-r0021",
      "tag": "prose",
      "target_sha256": "7067dad8221378f700e022cdc1e48c14457c973cc56b6c87bcaef1b93eac60fe"
    },
    {
      "source_id": "fr81-u145-r0022",
      "target": "И он схватил могильщика за руку.",
      "source_sha256": "0585a2d5381c4dc5e3b871b2a14bd44d2aecfa54ad9f1a42fff9f9538ed70d7e",
      "target_id": "ru-fr81-u145-r0022",
      "tag": "prose",
      "target_sha256": "d8e1c6f30ebefcfeba75e08929a94c75a69fd852055548e01e106ab296586b8f"
    },
    {
      "source_id": "fr81-u145-r0023",
      "target": "— Послушайте меня, товарищ. Я могильщик при монастыре, я пришёл вам помочь. Эту работу можно сделать и ночью. Так давайте сперва пойдём пропустим по стаканчику.",
      "source_sha256": "73cb1f1ab46868921312f96d55f380b6e7dc5759f3fae495ed2787ca8ed86212",
      "target_id": "ru-fr81-u145-r0023",
      "tag": "prose",
      "target_sha256": "86b25f53d4adf4b437bccd0827d087268599ffa4d79c043741e2cfa9817eb44d"
    },
    {
      "source_id": "fr81-u145-r0024",
      "target": "И, говоря так, цепляясь за это отчаянное упорство, он мрачно думал: «А если он и выпьет! Неужто захмелеет?»",
      "source_sha256": "acbd793efa9a0b3daf08ce120cdd626e447031de3fd0d9db5315fa4c995fb886",
      "target_id": "ru-fr81-u145-r0024",
      "tag": "prose",
      "target_sha256": "824816022f6cb0c6fa9c88b5f73b35df7b9f7c4c633a2dd98949f3e66bd2b6ff"
    },
    {
      "source_id": "fr81-u145-r0025",
      "target": "— Провинциал, — сказал могильщик, — если вам так уж приспичило, я согласен. Выпьем. Но после работы, никогда не до неё.",
      "source_sha256": "569e91c7bba6ba55c6530026980c951a2f5ec67fc918f8f21b32d932efce001e",
      "target_id": "ru-fr81-u145-r0025",
      "tag": "prose",
      "target_sha256": "bcbabf360f780920f08c26491fe2542d246be25f7d78c732caaa1c0962e8fab0"
    },
    {
      "source_id": "fr81-u145-r0026",
      "target": "И он снова взмахнул лопатой. Фошлеван удержал его.",
      "source_sha256": "75412804b303cc57c3127990f6b78925e3daaaed5c85b7ddd84151e00389bb06",
      "target_id": "ru-fr81-u145-r0026",
      "tag": "prose",
      "target_sha256": "157e7b9c8587b1054da3baa9092cc52b0a28c16ff173e08af4ea3ddb8d28bf7b"
    },
    {
      "source_id": "fr81-u145-r0027",
      "target": "— Аржантейльское, по шесть су!",
      "source_sha256": "a5547a6df10f614296d89ec3d424b9b3c9b5e74c57bdfe2fc76713e299d69394",
      "target_id": "ru-fr81-u145-r0027",
      "tag": "prose",
      "target_sha256": "403f63ccd875afce4fddfd201dc076a5f3c237767b66b270d2620cb4e2a9c454"
    },
    {
      "source_id": "fr81-u145-r0028",
      "target": "— Ах вот что, — сказал могильщик, — да вы звонарь. Динь-дон, динь-дон — больше ничего и сказать не умеете. Отвяжитесь вы от меня.",
      "source_sha256": "787c2754fdd410993c3dc65a33e0439ef30ce9f164f534bce1c08e91486d8f30",
      "target_id": "ru-fr81-u145-r0028",
      "tag": "prose",
      "target_sha256": "028c740744e801fb8c183105b87da37deb27c3c7aff1b95db3943858183f0505"
    },
    {
      "source_id": "fr81-u145-r0029",
      "target": "И он бросил вторую лопату земли.",
      "source_sha256": "c312e6ca533506947fe5f476dd4f5164ab810a49775716b213d671d4a7292938",
      "target_id": "ru-fr81-u145-r0029",
      "tag": "prose",
      "target_sha256": "cb5c1c8fb0cc3c3844521f8f05a132c652b1368d02c526c9a658d275e984dc57"
    },
    {
      "source_id": "fr81-u145-r0030",
      "target": "Фошлеван дошёл до той минуты, когда человек уже не знает, что говорит.",
      "source_sha256": "d2265c140c6738dbf6cef8f826ddc4e8c75cf9f0a8c7dbcaab051ca8080b6f7b",
      "target_id": "ru-fr81-u145-r0030",
      "tag": "prose",
      "target_sha256": "6c06f2d380b2cd854007be3624c9ed28e7612121dd11954320e1a9eb75004ad1"
    },
    {
      "source_id": "fr81-u145-r0031",
      "target": "— Да идёмте же пить, — закричал он, — ведь плачу я!",
      "source_sha256": "fc9bb72a1dec14411cede322d608681bd833f0ac431adb36768ca1bb111ec7e7",
      "target_id": "ru-fr81-u145-r0031",
      "tag": "prose",
      "target_sha256": "374b828bf84002a832197646f636481ae062d01485e19d6c8b667eaa913a5644"
    }
  ],
