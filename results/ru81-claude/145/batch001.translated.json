{
  "unit": 145,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u145-r0032",
      "target": "— Когда уложим ребёнка, — сказал могильщик.",
      "source_sha256": "51a83c1a4cf76dd082c5fe4309b659e5243a8c405ab12173f5957562ff8051e5",
      "target_id": "ru-fr81-u145-r0032",
      "tag": "prose",
      "target_sha256": "e687fbeaa1a85a36d32cc7eeaf21a446209b47bf375b8a3b924a2e4afe791424"
    },
    {
      "source_id": "fr81-u145-r0033",
      "target": "Он бросил третью лопату земли.",
      "source_sha256": "88d80cc6c04e7331a327aad48984589c76dcbf503b042261a0d0c0cd342540b8",
      "target_id": "ru-fr81-u145-r0033",
      "tag": "prose",
      "target_sha256": "d4a783a2be9baf9eef1cb36fa47782152483341b3a1fda60639287088d6076e3"
    },
    {
      "source_id": "fr81-u145-r0034",
      "target": "Потом воткнул лопату в землю и добавил:",
      "source_sha256": "76a35a75d3a96e972c88542777c1106a09dcd1178a750c0bf3b92b3562721733",
      "target_id": "ru-fr81-u145-r0034",
      "tag": "prose",
      "target_sha256": "279666f9d5643054d4a27ed1e3d6a119446656cae48f79ef0d91d618fb0e860f"
    },
    {
      "source_id": "fr81-u145-r0035",
      "target": "— Видите ли, ночью будет холодно, и покойница стала бы кричать у нас за спиной, если бы мы посадили её туда без одеяла.",
      "source_sha256": "7e82c3af0baf893b529842a9cc9448a964e15634520faa2f644021166c1748fd",
      "target_id": "ru-fr81-u145-r0035",
      "tag": "prose",
      "target_sha256": "9ed9dbe2915d91ad2fa7f86be747fea40c897112f3e2e174e7442e47ad680fb6"
    },
    {
      "source_id": "fr81-u145-r0036",
      "target": "В эту минуту, нагружая лопату, могильщик наклонился, и карман его куртки раззявился.",
      "source_sha256": "1e53a18356dcfd5351223f407657d975e7985900d129142209fab947863feda5",
      "target_id": "ru-fr81-u145-r0036",
      "tag": "prose",
      "target_sha256": "cde1af8865fabb9711b69f883cf211b9624c9aeeff04890f0c6c148f14577bc8"
    },
    {
      "source_id": "fr81-u145-r0037",
      "target": "Блуждающий взгляд Фошлевана машинально упал в этот карман и задержался в нём.",
      "source_sha256": "aafa8c0f33f796ab984dff2a98382da62eddf58ec56366c8eebab734e5c04464",
      "target_id": "ru-fr81-u145-r0037",
      "tag": "prose",
      "target_sha256": "11f04c0a893f25906832b3f8b023e690538ac72d690adbc78eda0973ef7c2745"
    },
    {
      "source_id": "fr81-u145-r0038",
      "target": "Солнце ещё не скрылось за горизонтом; было ещё довольно светло, чтобы различить что-то белое на дне этого зияющего кармана.",
      "source_sha256": "c62a7fa87a5a6bb077bebfc61fcf9c18195c3ac966d9bef1b947531494aa4787",
      "target_id": "ru-fr81-u145-r0038",
      "tag": "prose",
      "target_sha256": "63289ed2dfd022e9678ce55c0b574d76354c9176060e5540b0eff9dd00c86de5"
    },
    {
      "source_id": "fr81-u145-r0039",
      "target": "Весь блеск молнии, на какой только способен глаз пикардийского крестьянина, пронёсся в зрачке Фошлевана. Ему пришла мысль.",
      "source_sha256": "8ba32f4dca4c422c8cf8bd30b1f5f7b55f83228d92f7d1068b807b788db7cc43",
      "target_id": "ru-fr81-u145-r0039",
      "tag": "prose",
      "target_sha256": "6c398aeb8e4ee4d336876db342e71517ac0e9939bc1da4b2ac516d588ff3b4e8"
    },
    {
      "source_id": "fr81-u145-r0040",
      "target": "Могильщик, всецело занятый своей лопатой земли, ничего не заметил, а Фошлеван сзади запустил руку в его карман и вытащил оттуда белую вещь, лежавшую на дне.",
      "source_sha256": "cc9edd8a1fa928590a75c0f944830b40c9fdcfed2145fb2076ec943aab862a89",
      "target_id": "ru-fr81-u145-r0040",
      "tag": "prose",
      "target_sha256": "dcbe8c86d8ae7ee5e5585032a118c909f9ceb15a765f08c289325017a51dec85"
    },
    {
      "source_id": "fr81-u145-r0041",
      "target": "Могильщик отправил в яму четвёртую лопату.",
      "source_sha256": "c74f515331728d6fe47fbd99d057112c073b7d5f1104841c45b039096022c29d",
      "target_id": "ru-fr81-u145-r0041",
      "tag": "prose",
      "target_sha256": "de82cc7b2d7b2656e0c2f80d9887696c4063b16aec55cf295b9a646b37e72cd3"
    },
    {
      "source_id": "fr81-u145-r0042",
      "target": "В ту минуту, когда он обернулся, чтобы взять пятую, Фошлеван посмотрел на него с глубоким спокойствием и сказал:",
      "source_sha256": "8e16b97ca1210145f1cf8b80ddba40088990ec72fd2d9322c32b9c44da0c80ae",
      "target_id": "ru-fr81-u145-r0042",
      "tag": "prose",
      "target_sha256": "6ba78fa9c41c541ab33113b0d7da200377a4ceee3a446e71c78c398e0c4ea739"
    },
    {
      "source_id": "fr81-u145-r0043",
      "target": "— Кстати, новичок, а карточка у вас при себе?",
      "source_sha256": "c6e12abb006ed452dfe3c152587a0e0b51c7e151ce171bdaa5ddc54764b9b3ea",
      "target_id": "ru-fr81-u145-r0043",
      "tag": "prose",
      "target_sha256": "398f714c9cce0c5fd45b81063ce129533e23f39264ea60411ed9976e80a3bf6a"
    },
    {
      "source_id": "fr81-u145-r0044",
      "target": "Могильщик остановился.",
      "source_sha256": "94c9a67d6ed4bd0fba02b35a4928311caecba613831208f229dc2384eb5a7802",
      "target_id": "ru-fr81-u145-r0044",
      "tag": "prose",
      "target_sha256": "7175945e774691b44aa5b5b81ec83a575d5146f51bf087a4a887d7079028e864"
    },
    {
      "source_id": "fr81-u145-r0045",
      "target": "— Какая карточка?",
      "source_sha256": "5256c9642e063bc8ab8d7772a6c13f43f8a7a2179eced4debbc7e7e6d6f30e63",
      "target_id": "ru-fr81-u145-r0045",
      "tag": "prose",
      "target_sha256": "7a6972583fde41ea418cc6a6800d49f5ddd582147f37e1e90be176dc9a3c10dc"
    },
    {
      "source_id": "fr81-u145-r0046",
      "target": "— Солнце сейчас сядет.",
      "source_sha256": "18a01baffd8cb5c02739b3753978dede0e3dc93513e2f702aed7008ee7030505",
      "target_id": "ru-fr81-u145-r0046",
      "tag": "prose",
      "target_sha256": "7827c5387000c23c1e2f9f7f9b388030fa3dff033c8c541118b8c1fe3a053251"
    },
    {
      "source_id": "fr81-u145-r0047",
      "target": "— Ну и ладно, пусть надевает свой ночной колпак.",
      "source_sha256": "f1210d667665118c3269e94902f5639dd56893ba5d303faf1bd1d4f7032d6531",
      "target_id": "ru-fr81-u145-r0047",
      "tag": "prose",
      "target_sha256": "1aabb2b26b9c7b53b999820f46c17d860c88967d0481a85b9d6ba4a9f144e0ec"
    },
    {
      "source_id": "fr81-u145-r0048",
      "target": "— Кладбищенскую решётку сейчас запрут.",
      "source_sha256": "f312bca432e437c6d6bcd4b3e5848322061fe5e0bed3038da2d1708755b2c716",
      "target_id": "ru-fr81-u145-r0048",
      "tag": "prose",
      "target_sha256": "ba6057a69582bbd9ae5786a3c947bd05f8980d3c9b18c3da0d91cc6b00d3fd9a"
    },
    {
      "source_id": "fr81-u145-r0049",
      "target": "— Ну и что с того?",
      "source_sha256": "3cb3ef6a0a446ce6225771556227fba2c505f01666d86c2bf6ff2d2a21b79bb7",
      "target_id": "ru-fr81-u145-r0049",
      "tag": "prose",
      "target_sha256": "0b892071b701b612ffd5c8a78be8d06b3672fb95ab9d632096edc6356e91a178"
    },
    {
      "source_id": "fr81-u145-r0050",
      "target": "— Карточка при вас?",
      "source_sha256": "51b5fbd866b4e6e0e0660a841dd1531a140269913b650211db5c3abf313fa540",
      "target_id": "ru-fr81-u145-r0050",
      "tag": "prose",
      "target_sha256": "91cc178dddd8bbaef5338d29ac2acd1fb3cb7327a9568dd4628d79eb399dc944"
    },
    {
      "source_id": "fr81-u145-r0051",
      "target": "— А, моя карточка! — сказал могильщик.",
      "source_sha256": "fb0d1a5eedbb2640d6a8b5426e20a23f38a25e7316604e89fc63cccc286f943a",
      "target_id": "ru-fr81-u145-r0051",
      "tag": "prose",
      "target_sha256": "7e07172f4d31b2177fe3948236ad6957644e4de506b2c2760210c6ea39c72933"
    },
    {
      "source_id": "fr81-u145-r0052",
      "target": "И он стал шарить в кармане.",
      "source_sha256": "6f2ecda12c6b92eeda5b845e2b84b5bad6841ec3b0fdc69e1305939943c8befc",
      "target_id": "ru-fr81-u145-r0052",
      "tag": "prose",
      "target_sha256": "38c9a37a15fa90f133e9d15d88aa1fc1352f4543c91d3b03ea27158edf0f27dd"
    },
    {
      "source_id": "fr81-u145-r0053",
      "target": "Обшарив один карман, он принялся за другой. Перешёл к жилетным кармашкам, осмотрел первый, вывернул второй.",
      "source_sha256": "ac52bbd1834ec5cd71d0f3f8261745ebc95245993b84c04594678b04afb20c75",
      "target_id": "ru-fr81-u145-r0053",
      "tag": "prose",
      "target_sha256": "13e087132322ec46ecc0d33ef21808d720b3ce4cfd6a64d1b1d8eb8e695387e0"
    },
    {
      "source_id": "fr81-u145-r0054",
      "target": "— Да нет же, — сказал он, — нет у меня карточки. Должно быть, забыл.",
      "source_sha256": "ed5ebe1a7323fb4ef6153294277bcbbe568fd48d19cfe656ce70f5d3a7d80ac5",
      "target_id": "ru-fr81-u145-r0054",
      "tag": "prose",
      "target_sha256": "109782b2bfcc5125264b66fab0d144cea6bd91d8b9d386710e348a927204ba69"
    },
    {
      "source_id": "fr81-u145-r0055",
      "target": "— Пятнадцать франков штрафа, — сказал Фошлеван.",
      "source_sha256": "e84a31fc19b11cecb27911e07d47abb441dc86a48da477ec24e0710ef77601dc",
      "target_id": "ru-fr81-u145-r0055",
      "tag": "prose",
      "target_sha256": "64c1df4a734dec0f8100a4ec3fbae282c51c2402c672d17e6c5ac0e1b58e6ef3"
    },
    {
      "source_id": "fr81-u145-r0056",
      "target": "Могильщик позеленел. Зелень — это бледность людей землистых.",
      "source_sha256": "580e0c4d48f3d2aa3e04e69d2ed49de36f49e5c6e8601b02bf02c1d37568cc71",
      "target_id": "ru-fr81-u145-r0056",
      "tag": "prose",
      "target_sha256": "c676da9fdc7dace19fb0ccd080bb5f9bb40b4a7a2f6aeda34c59516ce6b85ba2"
    },
    {
      "source_id": "fr81-u145-r0057",
      "target": "— Ах, Иисусе-боже-мой-колченогий-долой-луну! — воскликнул он. — Пятнадцать франков штрафа!",
      "source_sha256": "1f9ccd74dd78654853ed58a62225843d97d2fd5c3c6b5e1ed500ad3e89f5b765",
      "target_id": "ru-fr81-u145-r0057",
      "tag": "prose",
      "target_sha256": "9ab6cde445b3e78731e39c1e13064f2af6cbf34b917cd2b7993acdbcbe374082"
    },
    {
      "source_id": "fr81-u145-r0058",
      "target": "— Три монеты по сто су, — сказал Фошлеван.",
      "source_sha256": "46d1980c393e9622e6bd58c8e098cba95cb8b27a4ad87d2e5580d861f3d9f6eb",
      "target_id": "ru-fr81-u145-r0058",
      "tag": "prose",
      "target_sha256": "eb9e7e510745a2e13a99d9288eba0d22ff957a985acb52d5efe32384dfe5214c"
    },
    {
      "source_id": "fr81-u145-r0059",
      "target": "Могильщик уронил лопату.",
      "source_sha256": "7ae25776857422fa21da6602cff1c4cf3fc53503e8bf43320cb1dd185ec86f5d",
      "target_id": "ru-fr81-u145-r0059",
      "tag": "prose",
      "target_sha256": "e9033debac2d7b0fa8963be0d5342ee78b4c248c2ca0fe8de3b1297861fe182e"
    },
    {
      "source_id": "fr81-u145-r0060",
      "target": "Настал черёд Фошлевана.",
      "source_sha256": "dd04822b803b62018b37e666501d7bdfe0ddcb37853018f22677e416fdfd892e",
      "target_id": "ru-fr81-u145-r0060",
      "tag": "prose",
      "target_sha256": "5cc7fe46508daabc1b240e094dad5a46f0f3eabe40da1ef3ccbfaf24007121c3"
    },
    {
      "source_id": "fr81-u145-r0061",
      "target": "— Ну-ну, — сказал Фошлеван, — новобранец, без отчаяния. Дело не в том, чтобы убиваться и воспользоваться могилой. Пятнадцать франков — это пятнадцать франков, а впрочем, вы можете их и не платить. Я человек старый, вы новый. Я знаю все штуки, трюки, фокусы и крючки. Дам-ка я вам дружеский совет. Одно ясно: солнце садится, оно уже касается купола, и кладбище закроется через пять минут.",
      "source_sha256": "2b7e3bc236062ab845fbb7473ec6198944af9b7be6fd3f4af6b3eb87d44a4c58",
      "target_id": "ru-fr81-u145-r0061",
      "tag": "prose",
      "target_sha256": "f51a05002bc227bb8538c949de9391d83bc007128dc2f70c8f7a951703b1c573"
    },
    {
      "source_id": "fr81-u145-r0062",
      "target": "— Это верно, — ответил могильщик.",
      "source_sha256": "ba735687396d670f7412cc674bb66e83f8238f2eda59eb078fcaf246b9e2f333",
      "target_id": "ru-fr81-u145-r0062",
      "tag": "prose",
      "target_sha256": "a639654a5a799dba8038c351af875a5208dd20be19d151448ec3524594978d85"
    },
    {
      "source_id": "fr81-u145-r0063",
      "target": "— За пять минут вы не успеете ни засыпать могилу — а она, чёрт возьми, глубокая, эта яма, — ни выбраться вовремя, пока не заперли решётку.",
      "source_sha256": "cc5fb61df79fb0bffde4dfcd7212f2844140af32587a645a9a626ffec636a198",
      "target_id": "ru-fr81-u145-r0063",
      "tag": "prose",
      "target_sha256": "eff5c6680b811f05a87d414dd45df5d2c303f4e9ef8d1bd58b6fc1263c66bbb7"
    }
  ],
