{
  "unit": 208,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u208-h",
      "target": "VII. Стратегия и тактика",
      "source_sha256": "df4c91a770015c28b881c619b1af913f2fc635e7d3041a46172d3950fd0454e5",
      "target_id": "ru-fr81-u208-h",
      "tag": "heading",
      "target_sha256": "99158f300f8d34f0f8195d0cf07b5e1c20892f6c0759c3e107e2bbb04c80e453"
    },
    {
      "source_id": "fr81-u208-r0001",
      "target": "Мариус, с теснотой в груди, уже собрался спуститься со своего наспех устроенного наблюдательного пункта, как вдруг какой-то шум привлёк его внимание и заставил остаться на месте.",
      "source_sha256": "6924e93b6a56d0e4f152b9d31095d7cd138099f8e4fce93c44848ae06edebf20",
      "target_id": "ru-fr81-u208-r0001",
      "tag": "prose",
      "target_sha256": "5c34a23824f64d9b6d7430976381a133f6bf71dd559317984663d8e138182773"
    },
    {
      "source_id": "fr81-u208-r0002",
      "target": "Дверь логова только что резко распахнулась.",
      "source_sha256": "996fd66a11798e0e709c28a3ed2096eca3655f842d7c6b5b03568fa23ae9ce16",
      "target_id": "ru-fr81-u208-r0002",
      "tag": "prose",
      "target_sha256": "596426b2dba3b62e41c15b797616ee1dddc185125be7ca8133d39d1166a5eba0"
    },
    {
      "source_id": "fr81-u208-r0003",
      "target": "На пороге показалась старшая дочь.",
      "source_sha256": "0f93f51cfe8073951fe55a3026e6582f4bbd6bf66b85c63fbd1401e1eccc7cc3",
      "target_id": "ru-fr81-u208-r0003",
      "tag": "prose",
      "target_sha256": "4c751b638757e2363ba4095e0160e4780f550c6675f6457b52d271fc46ee1b7b"
    },
    {
      "source_id": "fr81-u208-r0004",
      "target": "На ногах у неё были большие мужские башмаки, забрызганные грязью, долетевшей до самых её красных щиколоток; плечи покрывала ветхая рваная накидка, которой Мариус на ней час назад не видел: она, по-видимому, оставила её у двери, чтобы внушать больше жалости, и, выходя, должна была снова надеть. Она вошла, захлопнула за собой дверь, остановилась, чтобы перевести дух, потому что совсем запыхалась, и затем закричала с выражением торжества и радости:",
      "source_sha256": "f04262c1e3c556ec4c2d084685ce29ed5b1b5ea4ca25f2f205b5037b6625ba9b",
      "target_id": "ru-fr81-u208-r0004",
      "tag": "prose",
      "target_sha256": "ed0b86e9d9840afeeb94de2b18dd20df108bf2eef4b54f69e7fdb95292ea66a5"
    },
    {
      "source_id": "fr81-u208-r0005",
      "target": "— Он едет!",
      "source_sha256": "96208fc7b61d61e76ea0097d77f2f6b4372f863a65697c84d29a1852be303523",
      "target_id": "ru-fr81-u208-r0005",
      "tag": "prose",
      "target_sha256": "b7d4b3bf971a4cc8a434e5a8f0fd559e072348c1c5c26b52672240786e269101"
    },
    {
      "source_id": "fr81-u208-r0006",
      "target": "Отец перевёл на неё глаза, жена повернула голову, младшая сестра не шевельнулась.",
      "source_sha256": "496464d9f8639a195ca586060866ebadfca24830e7ec749556dc6fa295f195b8",
      "target_id": "ru-fr81-u208-r0006",
      "tag": "prose",
      "target_sha256": "cce85634372bf44bc58965306ef0103e6db5faf6a9a1f62e94e671f2c85aaa29"
    },
    {
      "source_id": "fr81-u208-r0007",
      "target": "— Кто? — спросил отец.",
      "source_sha256": "74e0a9c8e8bc6d2b6505c155fcb85792a048d2fb753c70a01c1628ace80c980b",
      "target_id": "ru-fr81-u208-r0007",
      "tag": "prose",
      "target_sha256": "1951636f3dd782fc0c50b5e415becbb22f34192764005f889627cbbfac1e5faa"
    },
    {
      "source_id": "fr81-u208-r0008",
      "target": "— Господин!",
      "source_sha256": "6568cc495f04f759840ec7e6c6913f6e60ab9ca7a256616eae02aa57f4d106d3",
      "target_id": "ru-fr81-u208-r0008",
      "tag": "prose",
      "target_sha256": "88d89f77578d4510d989e2abd2bccc3aed4f9c2f6ddfa701239df708a5490ab8"
    },
    {
      "source_id": "fr81-u208-r0009",
      "target": "— Филантроп?",
      "source_sha256": "c5d1ee9af1e07f7d9e3600093cf97fc14d535efa3a570f877f59d5d11a86f08b",
      "target_id": "ru-fr81-u208-r0009",
      "tag": "prose",
      "target_sha256": "0dba3a77d3d0e86b1b4de4a2690274b8661e3d0c9fc8f141055ad283191dcd9e"
    },
    {
      "source_id": "fr81-u208-r0010",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u208-r0010",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u208-r0011",
      "target": "— Из церкви Сен-Жак?",
      "source_sha256": "9483d39afbfabbe6d7a90aef35999422b8516e590026a73f5d8d4cbb13ab1159",
      "target_id": "ru-fr81-u208-r0011",
      "tag": "prose",
      "target_sha256": "ee463bd77daa365668a5236dd756da684e8f995e2f8c590a137757672e0b3785"
    },
    {
      "source_id": "fr81-u208-r0012",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u208-r0012",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u208-r0013",
      "target": "— Этот старик?",
      "source_sha256": "05e1fb4c36b12a3e266ed217a68a2f5d3db8a09b2de7255ac8f0c285a5208c9e",
      "target_id": "ru-fr81-u208-r0013",
      "tag": "prose",
      "target_sha256": "d4a387c843b3afb877040c4fc4a471d45b42d7894e9a3e9f8f7c8f7b287c5a9a"
    },
    {
      "source_id": "fr81-u208-r0014",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u208-r0014",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u208-r0015",
      "target": "— И он приедет?",
      "source_sha256": "476d54c1a9a88ef397790877d12bc7d1b5544214af16a0d2ee42cecb71ff125a",
      "target_id": "ru-fr81-u208-r0015",
      "tag": "prose",
      "target_sha256": "ddc398e95efc58b0029206b820ceac33da2cbd2f94df7ec0a43df2520d772828"
    },
    {
      "source_id": "fr81-u208-r0016",
      "target": "— Он следует за мной.",
      "source_sha256": "0a29d30210e23ea1278c5f5178aacdb7e4ff8e1668ef3be8c5173db53cebe50d",
      "target_id": "ru-fr81-u208-r0016",
      "tag": "prose",
      "target_sha256": "dda829353a869bdd3d49bc5493e7c6efc51c80f24710a903ab3b83286014b20e"
    },
    {
      "source_id": "fr81-u208-r0017",
      "target": "— Ты уверена?",
      "source_sha256": "e6dae2ca624c5bdbe2ed26a32bb46f1e97909f793c387a7926aaabb6e2b4a595",
      "target_id": "ru-fr81-u208-r0017",
      "tag": "prose",
      "target_sha256": "d1810e0b68faef1eefb1ea4144a283dcd3a3912bff221fb05acfcb382859ddb2"
    },
    {
      "source_id": "fr81-u208-r0018",
      "target": "— Уверена.",
      "source_sha256": "f36f13933fe8cd7bd8fd57ef24a84ca2968b2c5fa56e5fd5919edaa7c8aba0f6",
      "target_id": "ru-fr81-u208-r0018",
      "tag": "prose",
      "target_sha256": "c2f35741807bdb452db5161ab8af8c7bdf23844d56f94fbffb2f74c71499af3d"
    },
    {
      "source_id": "fr81-u208-r0019",
      "target": "— Нет, правда, он едет?",
      "source_sha256": "f47703e3f00782fb89c9b61b8f4195e75fe978f67f8444a78ef4bf0813de12ef",
      "target_id": "ru-fr81-u208-r0019",
      "tag": "prose",
      "target_sha256": "f7438cc5756a010c139383c661d6c889cd09f3c0223d316bfd6e110c5e24a441"
    },
    {
      "source_id": "fr81-u208-r0020",
      "target": "— Едет в фиакре.",
      "source_sha256": "d2616a51eb5833cada975eb5796d015e885fdfe7369cd6fef4ce632bed9c6ac2",
      "target_id": "ru-fr81-u208-r0020",
      "tag": "prose",
      "target_sha256": "2a81d884bedb50e942cbe84eb2b50531101ac2bfc141f55e4b11660a88f75ec4"
    },
    {
      "source_id": "fr81-u208-r0021",
      "target": "— В фиакре. Ну чисто Ротшильд!",
      "source_sha256": "75d6a0f33d306f6b8a705b9028921f46a4b778a1fd848fcd173fc39d648cb38e",
      "target_id": "ru-fr81-u208-r0021",
      "tag": "prose",
      "target_sha256": "b37de1d6b3705705aee406455249b344eba5b722c74fe6db7ad90a90f0b73107"
    },
    {
      "source_id": "fr81-u208-r0022",
      "target": "Отец поднялся.",
      "source_sha256": "634e436e0e073c02027e8f1a7fac3bba96dbca480ab5afbb6f9179efd56d590a",
      "target_id": "ru-fr81-u208-r0022",
      "tag": "prose",
      "target_sha256": "876d15fd4d39cdbd10bbd4f169680ca6567eb9dda29bccaa6b4c2b1fcc95ec84"
    },
    {
      "source_id": "fr81-u208-r0023",
      "target": "— Почему ты уверена? Если он едет в фиакре, как же ты оказалась здесь раньше него? Ты хоть как следует дала ему адрес? Сказала ли ты ему: последняя дверь в конце коридора направо? Только бы он не ошибся! Значит, ты нашла его в церкви? Прочёл ли он моё письмо? Что он тебе сказал?",
      "source_sha256": "8b84b7c0d65e9e459d304cd637c7e551d5ea24813928728dc63eed7b7be91f7b",
      "target_id": "ru-fr81-u208-r0023",
      "tag": "prose",
      "target_sha256": "a2f4261210ffa596fc2a5fe6bb28a2efc6bf645fdd576cc8203703ccff4a5eac"
    },
    {
      "source_id": "fr81-u208-r0024",
      "target": "— Та-та-та! — сказала дочь. — Ну и скачешь же ты, старина! Слушай: я вошла в церковь, он был на своём обычном месте, я сделала ему реверанс и подала письмо, он прочёл и сказал мне: «Где вы живёте, дитя моё?» Я сказала: «Сударь, я вас провожу». А он мне: «Нет, дайте мне ваш адрес, моей дочери надо сделать покупки, я возьму экипаж и приеду к вам одновременно с вами». Я дала ему адрес. Когда я назвала дом, он как будто удивился и на миг заколебался, потом сказал: «Всё равно, я приеду». Когда обедня кончилась, я видела, как он вышел из церкви со своей дочерью, и видела, как они сели в фиакр. И я ему как следует сказала: последняя дверь в конце коридора направо.",
      "source_sha256": "3a2aeb72cdd0badbf5e994575c6fad3e648d8671b5934b0350ab1da5e37d514b",
      "target_id": "ru-fr81-u208-r0024",
      "tag": "prose",
      "target_sha256": "c23ee4123de97500ef4df11aa8476ce651846117413bfe19e1e3925f60e9936c"
    },
    {
      "source_id": "fr81-u208-r0025",
      "target": "— А что тебе говорит, что он приедет?",
      "source_sha256": "be98bf786d8b4a8e195dba8cb2f7161780f873f9768b6d4acc4d16f537c14824",
      "target_id": "ru-fr81-u208-r0025",
      "tag": "prose",
      "target_sha256": "66afed03c7e7b2cc37ca806d6b52ebb5ff6fc1dccc17a28704b83549c5ff7d92"
    },
    {
      "source_id": "fr81-u208-r0026",
      "target": "— Я только что видела, как фиакр подъезжал по улице Пти-Банкье. Потому-то я и бежала.",
      "source_sha256": "6899fbe0ca3dbedc9c8c15053999d7ce972985d2434c06b787ca83abe379dba8",
      "target_id": "ru-fr81-u208-r0026",
      "tag": "prose",
      "target_sha256": "c968fa4ace81191dcf212fb584942fe00d6401c720bc710b83f9dbefd8d2cc45"
    },
    {
      "source_id": "fr81-u208-r0027",
      "target": "— Откуда ты знаешь, что это тот же фиакр?",
      "source_sha256": "22d54c5f7a060f36048091d686c6915ef82ccf5f9eb1287a29c792bc299261c8",
      "target_id": "ru-fr81-u208-r0027",
      "tag": "prose",
      "target_sha256": "28123fc871232724c8da8c325413ef199545f58116d213efc769c5e413ed8836"
    },
    {
      "source_id": "fr81-u208-r0028",
      "target": "— Да потому что я заметила его номер!",
      "source_sha256": "86cc6096031528ddb4e1a19800bf5199ca671bd4a9171d47ff15a7168509f152",
      "target_id": "ru-fr81-u208-r0028",
      "tag": "prose",
      "target_sha256": "467ae123979cdeaa8f9d676696cf85feb5b1120481034b098a9db661647039a8"
    },
    {
      "source_id": "fr81-u208-r0029",
      "target": "— Какой это номер?",
      "source_sha256": "29194fd5a192dac3f3a0d7e92bb37f9bcf15f715f859ea67b2c534ddbab343a3",
      "target_id": "ru-fr81-u208-r0029",
      "tag": "prose",
      "target_sha256": "566b4f60d5abe59b914ab8db532d86fd332c28a08cedb9f5ba197bd29fdd1529"
    },
    {
      "source_id": "fr81-u208-r0030",
      "target": "— 440.",
      "source_sha256": "cbdcd234a1572d1d92d8ec6bb65f7546df986636a1e25a72fb4ed0b2ca53958f",
      "target_id": "ru-fr81-u208-r0030",
      "tag": "prose",
      "target_sha256": "cbdcd234a1572d1d92d8ec6bb65f7546df986636a1e25a72fb4ed0b2ca53958f"
    },
    {
      "source_id": "fr81-u208-r0031",
      "target": "— Хорошо, ты девка с головой.",
      "source_sha256": "c3e1e92265e80f61d5d62d71d6b3b3b04b2354ca5463a994065e31b3de76f868",
      "target_id": "ru-fr81-u208-r0031",
      "tag": "prose",
      "target_sha256": "564058d104b16cdd1e1fa3277c9d0a623fe6cf305bead6b333349576be9dac2d"
    }
  ],
