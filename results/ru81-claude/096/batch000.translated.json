{
  "unit": 96,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u096-h",
      "target": "III. Людям нужно вино, а лошадям — вода",
      "source_sha256": "6792f4c38d2e2cd04c0e84a6f24c92f769132fba5f044ec4f79aca9a9a02cad4",
      "target_id": "ru-fr81-u096-h",
      "tag": "heading",
      "target_sha256": "1f17480433872bf50651f77b7d966150b0a84e2a7308b31f2a2efca3c4e3bc00"
    },
    {
      "source_id": "fr81-u096-r0001",
      "target": "Прибыло четверо новых путников.",
      "source_sha256": "62b5270a9bfd8a03ca6cd8c9e2b95655b463d302eec3b7b6954c101767e06738",
      "target_id": "ru-fr81-u096-r0001",
      "tag": "prose",
      "target_sha256": "e30dab30b2fec9fb55724638675f0924844d4ded6f8bf66aab35ca116f191fb6"
    },
    {
      "source_id": "fr81-u096-r0002",
      "target": "Козетта грустно задумалась; ибо, хотя ей было всего восемь лет, она уже столько выстрадала, что грезила с мрачным видом старухи.",
      "source_sha256": "568bc285bcf0f0659d7749bd60d0d506628e4487f0a806a48015043efda397cd",
      "target_id": "ru-fr81-u096-r0002",
      "tag": "prose",
      "target_sha256": "700deffaa863429a4b68814bba55b9266b35a6afe59778c1c62a482dcfdb32e6"
    },
    {
      "source_id": "fr81-u096-r0003",
      "target": "Веко у неё было черно от удара кулаком, который ей дала Тенардье; оттого Тенардье время от времени и говорила: — До чего же она уродлива с этим синяком под глазом!",
      "source_sha256": "99ecf10b16f5faa54e8d02f49d37406f713b0c878eda0cce7fa75e6a47229031",
      "target_id": "ru-fr81-u096-r0003",
      "tag": "prose",
      "target_sha256": "8dc570421fffee3a2aa0c9ef7a717ee856feaf2ea98c85841cab341b3da613a8"
    },
    {
      "source_id": "fr81-u096-r0004",
      "target": "Итак, Козетта думала о том, что уже ночь, глубокая ночь, что пришлось второпях наполнять кувшины и графины в комнатах нежданно прибывших путников, и что в колодце больше нет воды.",
      "source_sha256": "b97445b9d3eaeb480b0fc7b4372fcdc1466734c150a8449b4aa7819a21349bfe",
      "target_id": "ru-fr81-u096-r0004",
      "tag": "prose",
      "target_sha256": "c65db5e5ae40fe1eec694241dde128d5d49584038b25d37db6141379a8ffe363"
    },
    {
      "source_id": "fr81-u096-r0005",
      "target": "Немного успокаивало её то, что в доме Тенардье воды пили мало. Недостатка в людях, которых мучила жажда, здесь не было; но это была такая жажда, которая охотнее обращается к кувшину с вином, чем к кувшину с водой. Тот, кто попросил бы стакан воды среди всех этих стаканов вина, показался бы всем этим людям дикарём. Однако был миг, когда ребёнок задрожал: Тенардье приподняла крышку кастрюли, кипевшей на печи, затем схватила стакан и быстро подошла к фонтану. Она повернула кран; ребёнок поднял голову и следил за каждым её движением. Из крана потекла тощая струйка воды и наполнила стакан до половины. — Вот те на, — сказала она, — воды-то больше нет! — и на мгновение замолчала. Ребёнок не дышал.",
      "source_sha256": "acd6b8471dd4436abac19cc9681da12bf9d7bbbce4ab51519e83dc6b4fbf81d7",
      "target_id": "ru-fr81-u096-r0005",
      "tag": "prose",
      "target_sha256": "44a96baa56eff50055aef5acb1beebff68e1742424228af37a5c245bb79655a5"
    },
    {
      "source_id": "fr81-u096-r0006",
      "target": "— Ну да ладно! — продолжала Тенардье, разглядывая наполовину полный стакан. — Этого хватит.",
      "source_sha256": "a777a3598d33f3183f1ba1e9479ecc99aa0fc57997325b2a931814c0f644c992",
      "target_id": "ru-fr81-u096-r0006",
      "tag": "prose",
      "target_sha256": "075be14524d648eec36d72830e5252a3703958715f15d585ea63569c9ef8b027"
    },
    {
      "source_id": "fr81-u096-r0007",
      "target": "Козетта снова взялась за работу, но больше четверти часа чувствовала, как сердце прыгает у неё в груди, точно большой снежный ком.",
      "source_sha256": "b6ad823c391ccd640658a4251a072f289de76aeec6ce21a28ea8dee07c510c84",
      "target_id": "ru-fr81-u096-r0007",
      "tag": "prose",
      "target_sha256": "0e206d244a60cda77ccc8527888c33b6392e0465838b427b94cc5a140f8e73dd"
    },
    {
      "source_id": "fr81-u096-r0008",
      "target": "Она считала минуты, уходившие таким образом, и очень хотела бы, чтобы уже настало завтрашнее утро.",
      "source_sha256": "aac667dcfb4d649b359c8dac243cc0486831f00081246a73a8afe7520a9faeac",
      "target_id": "ru-fr81-u096-r0008",
      "tag": "prose",
      "target_sha256": "95d274b434c025b72c460a0e3d46f27ca802892a25854e114c2a1395e01298ce"
    },
    {
      "source_id": "fr81-u096-r0009",
      "target": "Время от времени кто-нибудь из пьющих выглядывал на улицу и восклицал: — Темно, как в печи! — или: — Надо быть кошкой, чтобы идти по улице без фонаря в такой час! — И Козетта вздрагивала.",
      "source_sha256": "cfc450371ae85e2e7ffddbb83cfe45f2d2490baf62a09f5b5776ef923eeb0a5a",
      "target_id": "ru-fr81-u096-r0009",
      "tag": "prose",
      "target_sha256": "5eead1351ec3e6ed0dbca4a37bbd611f5503fcbb14004161b01eb7e73e213d78"
    },
    {
      "source_id": "fr81-u096-r0010",
      "target": "Вдруг вошёл один из торговцев-разносчиков, остановившихся в трактире, и сказал суровым голосом:",
      "source_sha256": "2b4e7f9b7f2911e2ffbfb57721ecbd0f44bb091becfdb7d0e4093042a147d72f",
      "target_id": "ru-fr81-u096-r0010",
      "tag": "prose",
      "target_sha256": "17a8919e1c480b7928a7fd08bfcd22d4acd49348bc97af7a7231bde5d0afad03"
    },
    {
      "source_id": "fr81-u096-r0011",
      "target": "— Моей лошади не дали пить.",
      "source_sha256": "40015cdf92145e53f84c41b7195792ca5d8a09d3b152b25f0886b69b885a2af9",
      "target_id": "ru-fr81-u096-r0011",
      "tag": "prose",
      "target_sha256": "c06751ebbd17063786e8a5520357321ab0ebd051060dff583644a4d9c3354a42"
    },
    {
      "source_id": "fr81-u096-r0012",
      "target": "— Как же не дали, — сказала Тенардье.",
      "source_sha256": "23ca73c5b750e72bc7d7361ab318f14c96e565281b198ad03ed36db65c4b27e2",
      "target_id": "ru-fr81-u096-r0012",
      "tag": "prose",
      "target_sha256": "8296293fc1d1c278128360908fdd4584a6449055ba238a4da8c96ba00f5f7fb2"
    },
    {
      "source_id": "fr81-u096-r0013",
      "target": "— А я вам говорю, что нет, хозяйка, — повторил торговец. Козетта вылезла из-под стола.",
      "source_sha256": "ba994ee6c3edfe5e38adb4418f7989b0a63ab66a5db8be2120854d66c35c8079",
      "target_id": "ru-fr81-u096-r0013",
      "tag": "prose",
      "target_sha256": "4b208754b3cc18961d9d853817cc1e2ccba8753c9857b5f8f794fc9765ec37fc"
    },
    {
      "source_id": "fr81-u096-r0014",
      "target": "— О, нет, дали, сударь! — сказала она. — Лошадь пила, она пила из ведра, полное ведро выпила, и это я ей носила пить, и я с ней говорила.",
      "source_sha256": "f0b988b6038fd72ce7526c1cdbe401e2eb6e3d3ca9dc9cf099b09ff18d986075",
      "target_id": "ru-fr81-u096-r0014",
      "tag": "prose",
      "target_sha256": "b013e84e7df9129bd03792a409eefa0c11a758cd687af6f7514aaeff9c020257"
    },
    {
      "source_id": "fr81-u096-r0015",
      "target": "Это была неправда. Козетта лгала.",
      "source_sha256": "30216671414b5370b69ae4a4f6a662df7da2e47b7430b7a3d9432c067a4035b4",
      "target_id": "ru-fr81-u096-r0015",
      "tag": "prose",
      "target_sha256": "fb9ca4094940ab155cd6d8807f8db68ea46006fb4856f6d935fbf9fcdbba530f"
    },
    {
      "source_id": "fr81-u096-r0016",
      "target": "— Подумать только: от горшка два вершка, а врёт — с дом величиной! — воскликнул торговец. — Говорю тебе, что она не пила, маленькая мерзавка! Я хорошо знаю, как она фыркает, когда не напилась.",
      "source_sha256": "ecfaea73b48941475aa35a98d7ba0a4dc197f882911f83f99c95670d86f8180b",
      "target_id": "ru-fr81-u096-r0016",
      "tag": "prose",
      "target_sha256": "81c0b827edfa99a36a3e05c0cdd5fdce58b046326cf9a4319935420424d1bbf4"
    },
    {
      "source_id": "fr81-u096-r0017",
      "target": "Козетта стояла на своём и добавила голосом, охрипшим от тоски и едва слышным:",
      "source_sha256": "2e3850d317b2824be56d0aee79702fe0ff8ccd95f951364fc71e77bd8911795a",
      "target_id": "ru-fr81-u096-r0017",
      "tag": "prose",
      "target_sha256": "ee4a50bf3842d42fda6f36c65f1a004b0cfdf6659080cbaa74f222fe5fb09da2"
    },
    {
      "source_id": "fr81-u096-r0018",
      "target": "— И даже очень много пила!",
      "source_sha256": "1beff90de9f8de1e392253009530efe1bdda6c5a1cf37025666a84d9de3f1c1c",
      "target_id": "ru-fr81-u096-r0018",
      "tag": "prose",
      "target_sha256": "cdbf927b327607ef0fb80501455ee1a19973c49abd40a7c249f4694a956a8917"
    },
    {
      "source_id": "fr81-u096-r0019",
      "target": "— Ну, хватит, — продолжал торговец, злясь, — дело не в этом, пусть напоят мою лошадь, и покончим с этим!",
      "source_sha256": "65e2bad91a2bbabdf1b3a5a233ed911c1dadadf3435a758a9e36b7451c548999",
      "target_id": "ru-fr81-u096-r0019",
      "tag": "prose",
      "target_sha256": "a62f1918239529cd690d0a07ea2a37f7f626dcff7c2a1621dab42fd1deae431f"
    },
    {
      "source_id": "fr81-u096-r0020",
      "target": "Козетта снова забралась под стол.",
      "source_sha256": "5ef3ea840e72128e2a895dcc4541cdec6bcfcdaf04deb0b0b5fa4b267700ed0a",
      "target_id": "ru-fr81-u096-r0020",
      "tag": "prose",
      "target_sha256": "79d2b668b3dc502274b6c83b801b26a46e003ce5d37aadf06fbee2009dd1e486"
    },
    {
      "source_id": "fr81-u096-r0021",
      "target": "— В самом деле, это справедливо, — сказала Тенардье, — если скотина не пила, то пить ей надо.",
      "source_sha256": "e632d75ec75deb2cf42f7307775234290fa9cce0b2f9e65b6544e2f9931abf03",
      "target_id": "ru-fr81-u096-r0021",
      "tag": "prose",
      "target_sha256": "89b9185deaeaa0cca323e980864061a7cd7606292a63687e330391f46f6e2231"
    },
    {
      "source_id": "fr81-u096-r0022",
      "target": "Затем, оглядевшись:",
      "source_sha256": "531ce0438c9904cdd94442d691056c6a281bf336821f9c20cf727baffa35696e",
      "target_id": "ru-fr81-u096-r0022",
      "tag": "prose",
      "target_sha256": "85cc588963b8bc2585a621a19081710209f70ef71ccf71991e44d811ae6f1948"
    },
    {
      "source_id": "fr81-u096-r0023",
      "target": "— Ну а где же эта другая?",
      "source_sha256": "dbecacde485015e18cfac2896c6e0c407b99bde47c88802b115865553a90a0b2",
      "target_id": "ru-fr81-u096-r0023",
      "tag": "prose",
      "target_sha256": "c123e5e2592164667e059652c3cea91826f859b114aa609ff7ece9c7bab241b0"
    },
    {
      "source_id": "fr81-u096-r0024",
      "target": "Она наклонилась и обнаружила Козетту, забившуюся в другой конец стола, почти под ногами пьющих.",
      "source_sha256": "f2a58c4330bbb3cb7ecc7a20b3a6614d73d3a8c1921619f329702d6285f70dee",
      "target_id": "ru-fr81-u096-r0024",
      "tag": "prose",
      "target_sha256": "db9fb74775ef26b127028f114614398604994407796a75507b0c0f7e0c12c5ed"
    },
    {
      "source_id": "fr81-u096-r0025",
      "target": "— Ты вылезешь или нет? — крикнула Тенардье.",
      "source_sha256": "cb18f871460bb60da804fa8e47ba34d03581d56afa799b3891246f117f925de8",
      "target_id": "ru-fr81-u096-r0025",
      "tag": "prose",
      "target_sha256": "bf06841e8312951fea2fa1eb6e6e11a8852b0c5e2e9f252cdf903e9ea4f1bb5d"
    },
    {
      "source_id": "fr81-u096-r0026",
      "target": "Козетта выбралась из той норы, в которой пряталась. Тенардье продолжала:",
      "source_sha256": "fec97a44f6044b8827dfdfcd088f8e45607166a87f2e6ff3d3f1f6925f67e274",
      "target_id": "ru-fr81-u096-r0026",
      "tag": "prose",
      "target_sha256": "86c02d420a6e847caf133cf1114d3635da7ca848049b6ddf970768253a419c82"
    },
    {
      "source_id": "fr81-u096-r0027",
      "target": "— Мадемуазель Собака-без-имени, ступай напои эту лошадь.",
      "source_sha256": "f8c963d8ccb470201b1fd9765bee335bf53cb4907711baa5ba4cc4d01eb0d6a7",
      "target_id": "ru-fr81-u096-r0027",
      "tag": "prose",
      "target_sha256": "b35ea5179f4a1b7398894092bba5e79e2b1c130b2c5ddc8f2d39ed09c3ec57c9"
    },
    {
      "source_id": "fr81-u096-r0028",
      "target": "— Но, сударыня, — слабо проговорила Козетта, — воды-то нет.",
      "source_sha256": "a62243f7febf6cc8ba3fc90b5922f8a2f27705201482d46c3a9095480d3121d3",
      "target_id": "ru-fr81-u096-r0028",
      "tag": "prose",
      "target_sha256": "33d7174228f7441720e278a827da41b4c340c5643fbe55d10cc2a26f87e6075e"
    },
    {
      "source_id": "fr81-u096-r0029",
      "target": "Тенардье распахнула настежь дверь на улицу:",
      "source_sha256": "1a80e15328561886ab258d352d34830648952e8f5067efb1bc40d81fa6548601",
      "target_id": "ru-fr81-u096-r0029",
      "tag": "prose",
      "target_sha256": "854947fcda249dcc333e535d9d578f4d7caf65d459cb89de7a0459046fdb09bc"
    },
    {
      "source_id": "fr81-u096-r0030",
      "target": "— Ну так ступай за ней!",
      "source_sha256": "5aee8792f118ca13834b00cd1ea0ecb320d2e439aea438d2c94996066ac67712",
      "target_id": "ru-fr81-u096-r0030",
      "tag": "prose",
      "target_sha256": "c69130a34bc64991122576ac0ae8be1599ebfced95681574adc3d1d7f2f3b0c2"
    },
    {
      "source_id": "fr81-u096-r0031",
      "target": "Козетта опустила голову и пошла взять пустое ведро, стоявшее в углу у камина.",
      "source_sha256": "d28cdc7389ac2a62058686b3064d8bf48a8611253f5913b3eb35f2c61152feb2",
      "target_id": "ru-fr81-u096-r0031",
      "tag": "prose",
      "target_sha256": "f4c6cb9c4d8b29adb8188274cb4a0f61e55d2e53c5d733ff3439eeb568db0067"
    }
  ],
