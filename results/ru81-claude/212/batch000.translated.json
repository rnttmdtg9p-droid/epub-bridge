{
  "unit": 212,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u212-h",
      "target": "XI. Предложение услуг от нищеты к горю",
      "source_sha256": "5ddce0f443b08d959c5b1dc1a70adb7dd1af0192edc70bef13b1def199b1aa56",
      "target_id": "ru-fr81-u212-h",
      "tag": "heading",
      "target_sha256": "aa4f463298e5a8d8eee284584115994c3bec730c98bcd7eb1869c1a6c3257a59"
    },
    {
      "source_id": "fr81-u212-r0001",
      "target": "Мариус медленно поднялся по лестнице лачуги; в ту минуту, когда он собирался войти в свою каморку, он заметил позади себя в коридоре старшую Жондрет, которая шла за ним. Эта девушка была ему отвратительна: ведь это у неё остались его пять франков, просить их обратно было поздно, кабриолета уже не было, фиакр был далеко. К тому же она бы их не вернула. А расспрашивать её о том, где живут люди, приходившие только что, было бесполезно: очевидно, она этого не знала, раз письмо за подписью Фабанту было адресовано [[I]]благодетельному господину из[[/I]] [[I]]церкви Сен-Жак-дю-О-Па.[[/I]]",
      "source_sha256": "c6b434a36ec2f0abb5b03cf52cfbc658d3c9dce1eb681380b9711334fa7166f5",
      "target_id": "ru-fr81-u212-r0001",
      "tag": "prose",
      "target_sha256": "b0d25bc17a631f85396dfc0e20d4c3e74a0740ee2bc34d052dc16f23a54dc89e"
    },
    {
      "source_id": "fr81-u212-r0002",
      "target": "Мариус вошёл в свою комнату и затворил за собой дверь.",
      "source_sha256": "c2012ad634e01d7a8dd40a6c424ab0c6e92495d00bfb4919e68239c2fbf06d3f",
      "target_id": "ru-fr81-u212-r0002",
      "tag": "prose",
      "target_sha256": "4ac85b82f4135f44e28754f56fbe2d52ebafddc1188f03b3df7d7d7835326fc2"
    },
    {
      "source_id": "fr81-u212-r0003",
      "target": "Она не закрылась; он обернулся и увидел руку, которая удерживала дверь приоткрытой.",
      "source_sha256": "e12e25debde781b838b0defb54881b7e94a7854267927067494dfa1e78dc26e6",
      "target_id": "ru-fr81-u212-r0003",
      "tag": "prose",
      "target_sha256": "c4916558542bc051908e88bb849f0970c71a1818301ba42eb8963899193380b3"
    },
    {
      "source_id": "fr81-u212-r0004",
      "target": "— Что это? — спросил он. — Кто там?",
      "source_sha256": "590d206c98d2862068eaf3b8c868851c7a86ba7c7acfaa5373cd8b727db27bbf",
      "target_id": "ru-fr81-u212-r0004",
      "tag": "prose",
      "target_sha256": "ae7176d03876c3f046a6d7f0c1f420515a9599452eeca93b2f7adc56d6ba6da9"
    },
    {
      "source_id": "fr81-u212-r0005",
      "target": "Это была дочь Жондрета.",
      "source_sha256": "7823f9b3387d24fa007aab642d57314dfc04fb7ee99bf074573963baa191003b",
      "target_id": "ru-fr81-u212-r0005",
      "tag": "prose",
      "target_sha256": "9be0ab75545b871b92541b2fa7fa36a0dc0803426a3a326346cf5e499f54a6ce"
    },
    {
      "source_id": "fr81-u212-r0006",
      "target": "— Это вы? — снова заговорил Мариус почти резко. — Опять вы! Что вам от меня нужно?",
      "source_sha256": "963776ebede552b2c3b6375663149a0fb3ee8ff44ff1423845542d0e87584245",
      "target_id": "ru-fr81-u212-r0006",
      "tag": "prose",
      "target_sha256": "0154e45e5728f33b0f89b2cb434c45a89460aecb75af0d6039738261a760dcbf"
    },
    {
      "source_id": "fr81-u212-r0007",
      "target": "Она казалась задумчивой и не смотрела на него. От утренней её уверенности не осталось и следа. Она не вошла и стояла в тени коридора, где Мариус видел её через полуоткрытую дверь.",
      "source_sha256": "af8c3ab7cec57277431eb4f59e9cc334a880ca3510c94c879a985ec27ba539f5",
      "target_id": "ru-fr81-u212-r0007",
      "tag": "prose",
      "target_sha256": "b538cada37be779c8581a54ec1e02080ca88743bbdbd1082118075ac0c45371d"
    },
    {
      "source_id": "fr81-u212-r0008",
      "target": "— Да ну же, ответите вы наконец? — сказал Мариус. — Что вам от меня нужно?",
      "source_sha256": "85a755ff4e0f72629fd4ccc355bd1b1bbc913dd3a0d72ddf6fd97c7be26d5b8d",
      "target_id": "ru-fr81-u212-r0008",
      "tag": "prose",
      "target_sha256": "69a1966db1fdab70e56497a8349b13c52daa259709ad8a9218f27c50264116f0"
    },
    {
      "source_id": "fr81-u212-r0009",
      "target": "Она подняла на него тусклый взгляд, в котором, казалось, смутно загоралось что-то вроде света, и сказала:",
      "source_sha256": "0a817bea2f896e044f6b62c9c32eac80ef3a4a4caf9dcd78cd4c8977f08e164f",
      "target_id": "ru-fr81-u212-r0009",
      "tag": "prose",
      "target_sha256": "b2de61c165ba5328c9c959afcd6056d01c64a36a05295a420cf1435c78207c90"
    },
    {
      "source_id": "fr81-u212-r0010",
      "target": "— Господин Мариус, у вас печальный вид. Что с вами?",
      "source_sha256": "741f732525c99fb4c741eeb0a4af641dbedd7212b09d07a8ebde049d9d18c3a0",
      "target_id": "ru-fr81-u212-r0010",
      "tag": "prose",
      "target_sha256": "fbc7f94ea5f11b06554e3c488ff8fd18278e7446e62fbb948c5636d2618d7220"
    },
    {
      "source_id": "fr81-u212-r0011",
      "target": "— Со мной? — сказал Мариус.",
      "source_sha256": "d5302f49431a07cac4e6373b03c5200f9c8c124b1ad9fc4e71cf51f307dc0c73",
      "target_id": "ru-fr81-u212-r0011",
      "tag": "prose",
      "target_sha256": "ba088bdd2989047f576f02e1578f8023fcb6ffc925a87de7bb17a918d74dab54"
    },
    {
      "source_id": "fr81-u212-r0012",
      "target": "— Да, с вами.",
      "source_sha256": "871f7856fe1895c7e781c6b7a0c9f3a14fd2cb8e811c52f7f2e0713f45c9e8cc",
      "target_id": "ru-fr81-u212-r0012",
      "tag": "prose",
      "target_sha256": "35d541e3e8ade0e5da49335a603a98d6eefac72fe7e1c7b127d125c8a4950a64"
    },
    {
      "source_id": "fr81-u212-r0013",
      "target": "— Ничего.",
      "source_sha256": "999fc331fe9e229d9cf32c5a6aad38da5e3a4415c382b8a76b0a9ef51eed5709",
      "target_id": "ru-fr81-u212-r0013",
      "tag": "prose",
      "target_sha256": "e3f85c1871f46242f187941d0f81f1c56fd3606d90062b2bf53412b1fd13d61d"
    },
    {
      "source_id": "fr81-u212-r0014",
      "target": "— Нет, есть!",
      "source_sha256": "3842aa62ea0cd21036c7ed61df7b17226f919ae1dac78c0f88b7827134c3d519",
      "target_id": "ru-fr81-u212-r0014",
      "tag": "prose",
      "target_sha256": "c2334e91854db2e3bb8bbbbbe040f73927871674f1ef0c7a1c1801c18cfcfe92"
    },
    {
      "source_id": "fr81-u212-r0015",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u212-r0015",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u212-r0016",
      "target": "— Я вам говорю, что есть.",
      "source_sha256": "bc9fa6991cec43110eba4223e708f9a719b94af05fde1deefa20e9b4de8fe0ac",
      "target_id": "ru-fr81-u212-r0016",
      "tag": "prose",
      "target_sha256": "406245d0018bbb60bcfd0fa89173ce8526381bcc577a801a8835f1b37b7af176"
    },
    {
      "source_id": "fr81-u212-r0017",
      "target": "— Оставьте меня в покое!",
      "source_sha256": "3075c0d215c3e24e12a51ac94d231c0c8aa15ffa025ef42cbbefd01828f357cc",
      "target_id": "ru-fr81-u212-r0017",
      "tag": "prose",
      "target_sha256": "7d220786a96a2cf363773f496726b417f5f01a6a6f63cd1a0d93a0bf141da9e7"
    },
    {
      "source_id": "fr81-u212-r0018",
      "target": "Мариус снова толкнул дверь, она продолжала её удерживать.",
      "source_sha256": "73a0c289191b006b8ee19dc5ea2585633cb02cf402d681280b80440ae1629970",
      "target_id": "ru-fr81-u212-r0018",
      "tag": "prose",
      "target_sha256": "86caad73b05d9290906f769977752e7f19848ff81e93eebc40a18bd74947a161"
    },
    {
      "source_id": "fr81-u212-r0019",
      "target": "— Послушайте, — сказала она, — вы неправы. Хоть вы и небогаты, а сегодня утром были добры. Будьте добры и теперь. Вы дали мне поесть, скажите же мне теперь, что с вами. У вас горе, это видно. Я не хотела бы, чтобы у вас было горе. Что нужно сделать для этого? Могу я на что-нибудь пригодиться? Употребите меня. Я не спрашиваю ваших тайн, вам не надо мне их говорить, но всё-таки я могу быть полезной. Я могу вам помочь, ведь я помогаю отцу. Когда надо отнести письма, сходить по домам, просить от двери к двери, найти адрес, пойти за кем-нибудь следом — я на это и гожусь. Ну так вы можете мне сказать, что с вами, я пойду поговорю с людьми. Иногда, если кто-нибудь поговорит с людьми, этого довольно, чтобы всё узнать, и всё устраивается. Воспользуйтесь мной.",
      "source_sha256": "e013453f9072218e934e86050a72bb0ae2b3ebba0c8d7fa9598a431e34f1b63e",
      "target_id": "ru-fr81-u212-r0019",
      "tag": "prose",
      "target_sha256": "ec3d6c9ce700d342e58bb87c9e9f68a0023141c92fcb871134978d8851dea13e"
    },
    {
      "source_id": "fr81-u212-r0020",
      "target": "Одна мысль мелькнула в уме Мариуса. Какою веткой пренебрегаешь, когда чувствуешь, что падаешь?",
      "source_sha256": "c875915a9799f22d20eef997f4af358686ea419870846e83f5a514f6ef2e7601",
      "target_id": "ru-fr81-u212-r0020",
      "tag": "prose",
      "target_sha256": "fbe88f04fba475b1ae2e394dd649da3048abf752af2e9aebb5fd66a688564cf1"
    },
    {
      "source_id": "fr81-u212-r0021",
      "target": "Он подошёл к Жондрет.",
      "source_sha256": "252fe5d5689d1022c909ca186ef888202f44be92a82817254bd143aa7a0118c3",
      "target_id": "ru-fr81-u212-r0021",
      "tag": "prose",
      "target_sha256": "a76d10e6aea0a2d250c03dac1c37bb19a687e50dd2a7317d330696bb77ed0ad6"
    },
    {
      "source_id": "fr81-u212-r0022",
      "target": "— Послушай… — сказал он ей.",
      "source_sha256": "e9cb5b4a18f4ee7e7c3480e87259a59806f7a6f13de4f8ee79955e2f52f4a691",
      "target_id": "ru-fr81-u212-r0022",
      "tag": "prose",
      "target_sha256": "6c4a37447104d862cc44cbcefe08b2395110378e9bea288017b9774ec53fba5a"
    },
    {
      "source_id": "fr81-u212-r0023",
      "target": "Она перебила его, и в глазах её сверкнула радость.",
      "source_sha256": "c48df1a42526503e439f873d9d2a0bd9bc74980b08289db82f7a2e46ac2ab4aa",
      "target_id": "ru-fr81-u212-r0023",
      "tag": "prose",
      "target_sha256": "5705a58a7d1e12157a8b64bb13c7fab0b26666e33e4ddd31d2fef2105625d7f2"
    },
    {
      "source_id": "fr81-u212-r0024",
      "target": "— О! да, говорите мне «ты»! Мне так больше нравится",
      "source_sha256": "d8bb276b093c2a16ad2d623c16dc7f1e9358b76036f233411cf9e4e524c32e4f",
      "target_id": "ru-fr81-u212-r0024",
      "tag": "prose",
      "target_sha256": "78849c2943a9b12a15e716d135ef5cfcf6ea6bc62e93ef195349068d1dc4e6f1"
    },
    {
      "source_id": "fr81-u212-r0025",
      "target": "— Ну так вот, — продолжал он, — ты привела сюда того старого господина с его дочерью…",
      "source_sha256": "eec19152a62789442842c943214bc27cd07986906e99da7690786085ba6af05b",
      "target_id": "ru-fr81-u212-r0025",
      "tag": "prose",
      "target_sha256": "2ec8b2f9d30af96c16322fccb5c561c75a6aabe88de4842ad19f46692f1ef334"
    },
    {
      "source_id": "fr81-u212-r0026",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u212-r0026",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u212-r0027",
      "target": "— Знаешь ты их адрес?",
      "source_sha256": "3b247817b05d4affcd885f74dae7753ec5085d0a8a71cdfb826fb3281d54a52f",
      "target_id": "ru-fr81-u212-r0027",
      "tag": "prose",
      "target_sha256": "e61aa5ea980295a396c8fe107bae45d20d265e901cccfb61d8ed8226eaf09663"
    },
    {
      "source_id": "fr81-u212-r0028",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u212-r0028",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u212-r0029",
      "target": "— Разыщи мне его.",
      "source_sha256": "949226a6a1dfeb98c0b4cb587983ec98118f06f7450035bc8f92ebbee0228a2a",
      "target_id": "ru-fr81-u212-r0029",
      "tag": "prose",
      "target_sha256": "8587dd024b08bca4333faf724cef2451201c8d4e0e68291951f40b07949eca50"
    },
    {
      "source_id": "fr81-u212-r0030",
      "target": "Взгляд Жондрет из тусклого стал радостным; из радостного он стал мрачным.",
      "source_sha256": "0984e5a4332d2b47d41113fece8b912fbaf5ca77a7330da4e1844fe10a224e35",
      "target_id": "ru-fr81-u212-r0030",
      "tag": "prose",
      "target_sha256": "272a68f26db1cfd637133821107229a8c266c560927191018520ecb431653552"
    },
    {
      "source_id": "fr81-u212-r0031",
      "target": "— Вот чего вы хотите? — спросила она.",
      "source_sha256": "e7eca0e93311e7046993646abf1f4efae8e263497a0b1e87716054eeea887e09",
      "target_id": "ru-fr81-u212-r0031",
      "tag": "prose",
      "target_sha256": "68fd19fd46adcf4518ef77de1bb1897940c8d595a28b5eff6e35e3068a4caaaa"
    }
  ],
