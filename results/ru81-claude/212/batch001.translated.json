{
  "unit": 212,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u212-r0032",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u212-r0032",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u212-r0033",
      "target": "— А вы их знаете?",
      "source_sha256": "7e255d17dddba7651ec3576d7536346ab1709469980e5221d439193e8cbcf8bd",
      "target_id": "ru-fr81-u212-r0033",
      "tag": "prose",
      "target_sha256": "0399883b6bf4648ce0764519160570dcd077bd05449e84bfca9e95e361c353a1"
    },
    {
      "source_id": "fr81-u212-r0034",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u212-r0034",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u212-r0035",
      "target": "— То есть, — живо подхватила она, — вы её не знаете, но хотите узнать.",
      "source_sha256": "2012e128e3be66c554cb12ae61edd946286983174c126f3326b0f6c5afe85936",
      "target_id": "ru-fr81-u212-r0035",
      "tag": "prose",
      "target_sha256": "7013e61364b6bcbf79eae6f31ae1ba45c3b9c86e42845e036528d8dea1023845"
    },
    {
      "source_id": "fr81-u212-r0036",
      "target": "В этом [[I]]их[[/I]], обратившемся в [[I]]её[[/I]], было что-то многозначительное и горькое.",
      "source_sha256": "5417e878b26d8afa375819b3b02df271401cc10c9a09b9ec412ff7503a8e1d48",
      "target_id": "ru-fr81-u212-r0036",
      "tag": "prose",
      "target_sha256": "00adbbba81f75aa7c8db3a9327b89dfed7ea365c56f6cbd533d6a9b3caf1caab"
    },
    {
      "source_id": "fr81-u212-r0037",
      "target": "— Ну так что же, можешь? — сказал Мариус.",
      "source_sha256": "4a04de2d2d8d87ae6debc6ca7478c853a557331487cd39b41c9a9b8dd01c33d5",
      "target_id": "ru-fr81-u212-r0037",
      "tag": "prose",
      "target_sha256": "d52eb0bab13f042ac5dc39ca2a42e44fdd155e96eeea2157336c51d4f0c1f7cc"
    },
    {
      "source_id": "fr81-u212-r0038",
      "target": "— Вы получите адрес красивой барышни.",
      "source_sha256": "ba11c3ca745dfee8ea1cc903646ffed10b83c728578490c624c72b3df9af27dc",
      "target_id": "ru-fr81-u212-r0038",
      "tag": "prose",
      "target_sha256": "490a03bc60e74ec26431d45f86c4ffbb3ae1b3ac46a0f6a918e97e8e276b0ed3"
    },
    {
      "source_id": "fr81-u212-r0039",
      "target": "И в этих словах, «красивой барышни», опять был какой-то оттенок, досадивший Мариусу. Он продолжал:",
      "source_sha256": "25342db055827de7d9ac5f26a64c05064269ed7c8280df50310c78f52ecad1ac",
      "target_id": "ru-fr81-u212-r0039",
      "tag": "prose",
      "target_sha256": "701646fab610e0c12c406c923dc78e54e25f37ce2717820dc9ff6ec91990a6d2"
    },
    {
      "source_id": "fr81-u212-r0040",
      "target": "— Ну, всё равно! Адрес отца и дочери. Их адрес, понимаешь!",
      "source_sha256": "0b474cc7b32b21c93108060fd3df42500ac2e461475cc958cf64e4c5689e25bb",
      "target_id": "ru-fr81-u212-r0040",
      "tag": "prose",
      "target_sha256": "20aff00609adaf3618c2314fd88748d74881d1077df64c879a012134a1c6ca30"
    },
    {
      "source_id": "fr81-u212-r0041",
      "target": "Она пристально посмотрела на него.",
      "source_sha256": "7de5f2c7788db3e7ece3922c582a9790bee8078137fab57466c15d740ed161b1",
      "target_id": "ru-fr81-u212-r0041",
      "tag": "prose",
      "target_sha256": "b5c3f901e69479e998159a7be5ee0a1ed0b27c3823696e03b207ff2ee61170dd"
    },
    {
      "source_id": "fr81-u212-r0042",
      "target": "— А что вы мне за это дадите?",
      "source_sha256": "0b01c210c95c7a4bbe547fd687defed298d00c92254113b6904ea5677e5c11f4",
      "target_id": "ru-fr81-u212-r0042",
      "tag": "prose",
      "target_sha256": "611ab1eee7ba795cb21561742b9e31cdf28f5b141b5e9c595e45839ea5efb25a"
    },
    {
      "source_id": "fr81-u212-r0043",
      "target": "— Всё, что захочешь!",
      "source_sha256": "bec7f3feb45e7bc1eac8c0b99d3c1b986bef0394969595e884af1dfc15c17432",
      "target_id": "ru-fr81-u212-r0043",
      "tag": "prose",
      "target_sha256": "21de7fd0186c3662333959544c9ee37666c999b4eb5f8aa9418cb67a5564c976"
    },
    {
      "source_id": "fr81-u212-r0044",
      "target": "— Всё, что я захочу?",
      "source_sha256": "d3d20855ad59ce20abdc92bf2e99b8f24769b0574b8044e982b6b75c31fdbb6b",
      "target_id": "ru-fr81-u212-r0044",
      "tag": "prose",
      "target_sha256": "ed9a203809c3a0d2252a1213646d33b271969fef13687f303e00ab7e4f4f1d6b"
    },
    {
      "source_id": "fr81-u212-r0045",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u212-r0045",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u212-r0046",
      "target": "— Вы получите адрес.",
      "source_sha256": "4976dd50bed29ed32907319e44e9ce81b608891d12206deb86f2a650bb750c85",
      "target_id": "ru-fr81-u212-r0046",
      "tag": "prose",
      "target_sha256": "11d5733f7f33e72918d3108be835124334907c0bc8280d7adddd20828e4e692b"
    },
    {
      "source_id": "fr81-u212-r0047",
      "target": "Она опустила голову, потом резким движением потянула дверь, и та затворилась.",
      "source_sha256": "5eb7e8a2968a47327832e2725984cb8085b61b6d0fceda536d842b4dee2b7dc6",
      "target_id": "ru-fr81-u212-r0047",
      "tag": "prose",
      "target_sha256": "8cdd16a437fc62343fccb503cfd44339d793252d9a185b7a3a53010a54b1cc79"
    },
    {
      "source_id": "fr81-u212-r0048",
      "target": "Мариус остался один.",
      "source_sha256": "e363a569dbc6f48868403510153732254fc0f91fd0c7231422e8888867f67633",
      "target_id": "ru-fr81-u212-r0048",
      "tag": "prose",
      "target_sha256": "f573ff7045c4e6a457d7b98d19b4eec01b976083ae610f88427aa9839c9c299f"
    },
    {
      "source_id": "fr81-u212-r0049",
      "target": "Он опустился на стул, уронив голову и положив оба локтя на кровать, погружённый в мысли, которых не мог уловить, словно во власти головокружения. Всё, что произошло с утра, появление ангела, его исчезновение, то, что только что сказала ему эта девушка, проблеск надежды, плавающий в безмерном отчаянии, — вот что смутно наполняло его мозг.",
      "source_sha256": "145be6e09297c04b1d8fdc3abfc2e0ef11dc4f04d43892765ff64c0e290145bd",
      "target_id": "ru-fr81-u212-r0049",
      "tag": "prose",
      "target_sha256": "29d9d88dee17f3f4af4ec2a626895685a7a3fd71b02064bbf4c9ebc0ab7f414b"
    },
    {
      "source_id": "fr81-u212-r0050",
      "target": "Вдруг его грубо вырвали из задумчивости.",
      "source_sha256": "3862d35fcab03860774e8d0afdee04def20899be0d884b06bbcfc63ea0b5ba6d",
      "target_id": "ru-fr81-u212-r0050",
      "tag": "prose",
      "target_sha256": "607f8a7fda37ce34fe7ce269d4dcad31cabdfaa156d4148a0a67c6d0be7e89d8"
    },
    {
      "source_id": "fr81-u212-r0051",
      "target": "Он услышал громкий и жёсткий голос Жондрета, произносившего слова, полные для него самого странного интереса:",
      "source_sha256": "1182c2bb3b083602c09e4b609fab4a0636b77e6085b2a08ff34038064a7d0ba1",
      "target_id": "ru-fr81-u212-r0051",
      "tag": "prose",
      "target_sha256": "d0404b8e17550b34ef7a8c9972d93b2cb0383c64915689c83100645c51e8225a"
    },
    {
      "source_id": "fr81-u212-r0052",
      "target": "— Говорю тебе, я уверен и я его узнал.",
      "source_sha256": "d9586cc673dc9625423845b1cad2e2713ad7b407e27efcf68261d34ef8eb15a3",
      "target_id": "ru-fr81-u212-r0052",
      "tag": "prose",
      "target_sha256": "bc8ff1000461e298cf29e6809247b8dcb7620a7acf46e58690f72000cf23ae6f"
    },
    {
      "source_id": "fr81-u212-r0053",
      "target": "О ком говорил Жондрет? Кого он узнал? Господина Леблана? Отца «его Урсулы»? Как! Неужели Жондрет его знал? Неужели Мариус таким внезапным и неожиданным образом получит все те сведения, без которых его жизнь оставалась тёмной для него самого? Неужели он наконец узнает, кого любит, кто эта девушка? Кто её отец? Неужели столь густая тень, что покрывала их, готова рассеяться? Неужели покров сейчас будет разорван? О небо!",
      "source_sha256": "be276d46a8c6ec657127f26c5ee75c51f6b6ac3a276091ee1deaa1103c04f9fa",
      "target_id": "ru-fr81-u212-r0053",
      "tag": "prose",
      "target_sha256": "91827bbb21cebb89272e534322044318967d5fe74e570ec2feb0564457986756"
    },
    {
      "source_id": "fr81-u212-r0054",
      "target": "Он не взобрался, а скорее взлетел на комод и снова занял место возле маленького отверстия в перегородке.",
      "source_sha256": "b229f79af36b3d8e8fcf1181132074926d39da0ad25e42805f528df9a0f2ac7f",
      "target_id": "ru-fr81-u212-r0054",
      "tag": "prose",
      "target_sha256": "6ddeb3da2b86f5ba8dda62c2af923e215999fb68ee486a5bbe1e583263f4d6bf"
    },
    {
      "source_id": "fr81-u212-r0055",
      "target": "Он снова увидел внутренность логова Жондрета.",
      "source_sha256": "7878c92a90879557fbf477711e0ff42dbf622c52acb49e9b64d07177d2188d54",
      "target_id": "ru-fr81-u212-r0055",
      "tag": "prose",
      "target_sha256": "6dabb65b18fe50323cf900598c0273402b97554e1b403cfb0d31adff87e96302"
    }
  ],
