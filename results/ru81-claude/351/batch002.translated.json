{
  "unit": 351,
  "batch": 2,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u351-r0063",
      "target": "— Разве что это другой старик.",
      "source_sha256": "2eaca0e913579f31617dd6d67b51359353d069a8950c1cae70e37b128be726e8",
      "target_id": "ru-fr81-u351-r0063",
      "tag": "prose",
      "target_sha256": "c9a0980841a3d0961dc96404db63dacc4686dad47a03af082ca897a17032b6d7"
    },
    {
      "source_id": "fr81-u351-r0064",
      "target": "— Постарайся разглядеть невесту, перегнись как следует.",
      "source_sha256": "5bd6a86d9947e2f3c8fb207449291b10f90d575c5942a55eeb32c9df3ab67a6f",
      "target_id": "ru-fr81-u351-r0064",
      "tag": "prose",
      "target_sha256": "3f99c401d0a9aededc8b0ee0ee7b17bc9b94c8e5c96d268b07931d24cbc6d26b"
    },
    {
      "source_id": "fr81-u351-r0065",
      "target": "— Не могу.",
      "source_sha256": "4084e6e9e9a44aaa572c4229ca82466750f0dcff6ca78a86e2569ad900bb4350",
      "target_id": "ru-fr81-u351-r0065",
      "tag": "prose",
      "target_sha256": "36e67aae739ccb3dc9466569659a8fddcbd4eccca223cc6406d95b14687a378a"
    },
    {
      "source_id": "fr81-u351-r0066",
      "target": "— Всё равно, у этого старика рыльце в пуху, я уверена, уж я в этом толк знаю.",
      "source_sha256": "0eca9748616fee15ce024068697b0ac5150502e9d65b55a10180747be2b64199",
      "target_id": "ru-fr81-u351-r0066",
      "tag": "prose",
      "target_sha256": "cf89cc6ce31f1a247902e61683133a45ff605a0a58237e57d279fc9df6ecd7c0"
    },
    {
      "source_id": "fr81-u351-r0067",
      "target": "— А тебе какая польза от того, что ты в этом толк знаешь?",
      "source_sha256": "1b186d2c9dcd5868b6985ab47fec892d0612c8314ab9f1409bf360ea1b8a17af",
      "target_id": "ru-fr81-u351-r0067",
      "tag": "prose",
      "target_sha256": "0a3aa4fc54e553190f4d303fa7f4322decdf6680a8277d5c9f9a2c38ad5d8ca7"
    },
    {
      "source_id": "fr81-u351-r0068",
      "target": "— Как знать. Всякое бывает!",
      "source_sha256": "4387e9f9a96a44e06bc76a1cd9290b8917c2ad3171f343d2b74293b49470a994",
      "target_id": "ru-fr81-u351-r0068",
      "tag": "prose",
      "target_sha256": "ae4e00ae8b03dfa5e9ce3ab8fd018f3cc795b387c955abdf704e416332d73ce7"
    },
    {
      "source_id": "fr81-u351-r0069",
      "target": "— А мне на стариков плевать.",
      "source_sha256": "e611b53bb30c8ac5b23d50b418dfb06d9c3af58bb32fa7f04c3363ac8289964d",
      "target_id": "ru-fr81-u351-r0069",
      "tag": "prose",
      "target_sha256": "d6a7a8debf74a20961849551c8d6132e4682be998c863f922cc3cbfee09829c1"
    },
    {
      "source_id": "fr81-u351-r0070",
      "target": "— Я его знаю.",
      "source_sha256": "5c8fe1025efed4357be36e68c9d778e6f92cda8c93e35bd2bbe9ac68fabedb3f",
      "target_id": "ru-fr81-u351-r0070",
      "tag": "prose",
      "target_sha256": "d713249dbb9a0bc9e60e654ad27e381fa49fe29b43825ea8dacc69d6ea6894d9"
    },
    {
      "source_id": "fr81-u351-r0071",
      "target": "— Знай себе на здоровье.",
      "source_sha256": "0e2aaa0686f95fa3bef4e4d7b73ef44ba4c8291a9cefe6f9a6c1af27f2f8d30d",
      "target_id": "ru-fr81-u351-r0071",
      "tag": "prose",
      "target_sha256": "f0743685f5e46e51a9b68a0d91e16ad28e6c56b15fef70b78b0373b676f32ba0"
    },
    {
      "source_id": "fr81-u351-r0072",
      "target": "— Как, чёрт возьми, он оказался на свадьбе?",
      "source_sha256": "8d939dbb51dd8bd747bf0f2c75962b20a8a9b293544ad6865240ecc71f81b0e2",
      "target_id": "ru-fr81-u351-r0072",
      "tag": "prose",
      "target_sha256": "e2a188a1534736b32e36cb2ec557fa24d7153d206c916a61117c0a2c6032cf93"
    },
    {
      "source_id": "fr81-u351-r0073",
      "target": "— Мы-то ведь тоже там.",
      "source_sha256": "cc1dd1c468884d982005a91b153802388820e01b42bb4c8ec485e9cf1761644d",
      "target_id": "ru-fr81-u351-r0073",
      "tag": "prose",
      "target_sha256": "d54bb6ae4da47378a7b3b4ad6ab092bdd49d33650eb8743e9dc14edb48f43d1f"
    },
    {
      "source_id": "fr81-u351-r0074",
      "target": "— Откуда она взялась, эта свадьба?",
      "source_sha256": "8e69b1879bc0fec38e4341bd0423613de32d0432847253f1a62cca626dec9d6e",
      "target_id": "ru-fr81-u351-r0074",
      "tag": "prose",
      "target_sha256": "cfc24bb957e5af9dc2a52d77f984ad8069bdf8578543957a786e188e705d0983"
    },
    {
      "source_id": "fr81-u351-r0075",
      "target": "— Почём я знаю?",
      "source_sha256": "265d8cdde0436fa584ae6ac7b208e52fb71980c6a35486469adaec26c46e27af",
      "target_id": "ru-fr81-u351-r0075",
      "tag": "prose",
      "target_sha256": "a4635bcaf3ff381dea70ba877e83887ffaa362844ad44c6bf4aa6d3c169fe531"
    },
    {
      "source_id": "fr81-u351-r0076",
      "target": "— Слушай.",
      "source_sha256": "1bd097d1d97f34ea5b8702d7e77f1d2bc9b49865ef70ab4a0c3108366258c7d2",
      "target_id": "ru-fr81-u351-r0076",
      "tag": "prose",
      "target_sha256": "441f87f72c82ab340e08458bc01fe3a8d60c211c7cb33f130b83a5bbdc26914a"
    },
    {
      "source_id": "fr81-u351-r0077",
      "target": "— Что?",
      "source_sha256": "61a0fac8ae488c6bc653f1215cdda5ca31b778598be9273b7ab3b579855004d9",
      "target_id": "ru-fr81-u351-r0077",
      "tag": "prose",
      "target_sha256": "517f3ff122eb546ca36332ec960df6083fe4c7e2f428e22ee5ca0183ce22e859"
    },
    {
      "source_id": "fr81-u351-r0078",
      "target": "— Тебе надо кое-что сделать.",
      "source_sha256": "b9b08487122289e85a0c023b87225b4a4c154ae471db0d478df88f1d4a886ad8",
      "target_id": "ru-fr81-u351-r0078",
      "tag": "prose",
      "target_sha256": "f5dfb977d5e73faabe1d485078a02bcacd9f6933e4ba2f9556f8fd46d2d8507b"
    },
    {
      "source_id": "fr81-u351-r0079",
      "target": "— Что?",
      "source_sha256": "61a0fac8ae488c6bc653f1215cdda5ca31b778598be9273b7ab3b579855004d9",
      "target_id": "ru-fr81-u351-r0079",
      "tag": "prose",
      "target_sha256": "517f3ff122eb546ca36332ec960df6083fe4c7e2f428e22ee5ca0183ce22e859"
    },
    {
      "source_id": "fr81-u351-r0080",
      "target": "— Слезть с нашей фуры и выследить[[N4]] эту свадьбу.",
      "source_sha256": "41e5e575aafebc8ebd31659d3a904b0fcf22fc6a1d56902c918596490b645278",
      "target_id": "ru-fr81-u351-r0080",
      "tag": "prose",
      "target_sha256": "5e101a4b986adf926a71aaf9e5df785630e9f676b0e0f7038907ba416cab7fab"
    },
    {
      "source_id": "fr81-u351-r0081",
      "target": "— Зачем?",
      "source_sha256": "ac45d9360c345b238a7e77f3b7df08f0e33d9f8536bf1ea216966e53bf2aa08e",
      "target_id": "ru-fr81-u351-r0081",
      "tag": "prose",
      "target_sha256": "2dbb888fa6d413f7fe6e300e2500948cbeaa4517a86bc873b30ce37bc2bed5d3"
    },
    {
      "source_id": "fr81-u351-r0082",
      "target": "— Чтобы узнать, куда она едет и что это за свадьба. Скорей слезай, беги, моя фея[[N5]], ты ведь молодая.",
      "source_sha256": "f915cbaa935e3f0a187b85723f71e0c5b0d07812ade34e6d68b81dad71454e00",
      "target_id": "ru-fr81-u351-r0082",
      "tag": "prose",
      "target_sha256": "3256add63b36aa13abae11bfbee0c2458ecf9604bad1e4bf4daf1f19c0272945"
    },
    {
      "source_id": "fr81-u351-r0083",
      "target": "— Я не могу бросить экипаж.",
      "source_sha256": "3c1698a8a63510f3ec05dffe1b940cb0d3caf64ef5075b8adb65bd30417d01f7",
      "target_id": "ru-fr81-u351-r0083",
      "tag": "prose",
      "target_sha256": "136c774b7804f8ddd1938e51f26a38b92d306c759186f32cfc989fbaaae67366"
    },
    {
      "source_id": "fr81-u351-r0084",
      "target": "— Это почему?",
      "source_sha256": "313535cd51669d9d3903f577d796cc72cc3490e379072d07984815fed899508b",
      "target_id": "ru-fr81-u351-r0084",
      "tag": "prose",
      "target_sha256": "4f9dbbeeb2438a3829415c2c1bc4b17328ea25a4a0da33b450f1edcae2bc92d3"
    },
    {
      "source_id": "fr81-u351-r0085",
      "target": "— Я нанята.",
      "source_sha256": "327d67e008f36359a72ddc31b25310009f9aea38019ce9ed9fabd7c12046616a",
      "target_id": "ru-fr81-u351-r0085",
      "tag": "prose",
      "target_sha256": "f13d16026f82cb1c65586947a88ae2904c334941b090d4ec65e3a087c020a060"
    },
    {
      "source_id": "fr81-u351-r0086",
      "target": "— Ах, чёрт!",
      "source_sha256": "b382ee782ed31a2492410350fd9e702a458968d02af822717de67dda377d88ec",
      "target_id": "ru-fr81-u351-r0086",
      "tag": "prose",
      "target_sha256": "0251fb8b960f6636d33df5d356430bdd9cbc5ae0d76d70168e3f0baaec551532"
    },
    {
      "source_id": "fr81-u351-r0087",
      "target": "— Я должна префектуре отработать свой день рыбной торговки.",
      "source_sha256": "5ee95b54fff60328ac30d1645c8ac6ea17f54685427b29795bae63f00b801e6d",
      "target_id": "ru-fr81-u351-r0087",
      "tag": "prose",
      "target_sha256": "66e8e57dfe55bafb841e629060c68389710ea939631ca6889d340730bcbf770f"
    },
    {
      "source_id": "fr81-u351-r0088",
      "target": "— Это верно.",
      "source_sha256": "1fa236e2447daa0f48ffd5c8a4a70fbe4bcef4fa03711354d064e959711bff99",
      "target_id": "ru-fr81-u351-r0088",
      "tag": "prose",
      "target_sha256": "7187123eb85427664fccb3fdfe99d8322b16538518b8c747279eff5fbd698075"
    },
    {
      "source_id": "fr81-u351-r0089",
      "target": "— Если я выйду из экипажа, первый же инспектор, который меня заметит, меня задержит. Ты же знаешь.",
      "source_sha256": "3bf22fe598ff905878978c643deb264332d768f7017a87d56a9f755e7d3e89ed",
      "target_id": "ru-fr81-u351-r0089",
      "tag": "prose",
      "target_sha256": "62d469245c95794d7f44c694ffb28dd6d3c1ede5bbf3d19af29b4ec54acb64a4"
    },
    {
      "source_id": "fr81-u351-r0090",
      "target": "— Да, знаю.",
      "source_sha256": "8d34fe0aacf46eeaf82e6da8f3d34fd046fed917946d279a5d0b3fc81908f800",
      "target_id": "ru-fr81-u351-r0090",
      "tag": "prose",
      "target_sha256": "956a13904008fa091894566122d72e76d0db8cb938dcaab044c92925c2474b38"
    },
    {
      "source_id": "fr81-u351-r0091",
      "target": "— Сегодня меня купил Фарос[[N6]].",
      "source_sha256": "d04d68347adcdbff22802095c16946d73145a02f28f2b2237539979ffcc76ac6",
      "target_id": "ru-fr81-u351-r0091",
      "tag": "prose",
      "target_sha256": "ffc34b4767eb353cbc5898c167a2f7ac8abf211421813170a5195234c1c84e25"
    },
    {
      "source_id": "fr81-u351-r0092",
      "target": "— Всё равно. Этот старик не даёт мне покоя.",
      "source_sha256": "caba589e2766a016a936aa9c242c1ce591a40a37254869a40a6b53ad01caae2c",
      "target_id": "ru-fr81-u351-r0092",
      "tag": "prose",
      "target_sha256": "5057969bfd22713c7ba8364e204756170dbdbc1bf4b586904556dc318607db38"
    },
    {
      "source_id": "fr81-u351-r0093",
      "target": "— Старики не дают тебе покоя. А ведь ты не девица.",
      "source_sha256": "d61e5931ab06e22e2600bf352e6bd67d85bccf907ca28bdb281a0bded9ea2b51",
      "target_id": "ru-fr81-u351-r0093",
      "tag": "prose",
      "target_sha256": "7ef7a2084a62d8103493d47b0e4e3f4c937f635301fe147b262b76178f28e8d4"
    },
    {
      "source_id": "fr81-u351-r0094",
      "target": "— Он в первой карете.",
      "source_sha256": "18af6fdde237869923c24ab95ea05761ff0474fc05f2e1dfcc892e1967ccec2f",
      "target_id": "ru-fr81-u351-r0094",
      "tag": "prose",
      "target_sha256": "49a0aff2c3031685960cd82e3e9a991fd1a646eeba43f4188e4ca2565ed4df98"
    }
  ],
