{
  "unit": 351,
  "batch": 3,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u351-r0095",
      "target": "— Ну и что?",
      "source_sha256": "4950a516c968f0619fb8b95afe126297c80c72d6fe6348e65ea081818635e18f",
      "target_id": "ru-fr81-u351-r0095",
      "tag": "prose",
      "target_sha256": "c3c7c847be433d2b02af850bdfcfd0e3734a843506123820fd38a33c0d05ab04"
    },
    {
      "source_id": "fr81-u351-r0096",
      "target": "— Он в повозке невесты.",
      "source_sha256": "382260f5e8ae4c01b42b0f0766888ebcd8937d40206e753d8e33263de2a0e7df",
      "target_id": "ru-fr81-u351-r0096",
      "tag": "prose",
      "target_sha256": "a081732bbe748340675de4ea7abc01054c12cc5ed092947372b30fab5ff101a0"
    },
    {
      "source_id": "fr81-u351-r0097",
      "target": "— А дальше?",
      "source_sha256": "a97f95ace0263b737b62a1340b89d88e54aa651167918516cceedcc6e30f38ac",
      "target_id": "ru-fr81-u351-r0097",
      "tag": "prose",
      "target_sha256": "e5a6aba524e0b98d278f33c5d3c33ad81ccb3ac017faa79f76d4450a97ed5030"
    },
    {
      "source_id": "fr81-u351-r0098",
      "target": "— Значит, он и есть отец.",
      "source_sha256": "e87d428640e8361a85bf6cf3c989574c6b67159970e4475acacce499296d8364",
      "target_id": "ru-fr81-u351-r0098",
      "tag": "prose",
      "target_sha256": "4e47a6321314fb24b4967e610d16198c44a1c93e44c2c8e41b5eb64bc99e41b4"
    },
    {
      "source_id": "fr81-u351-r0099",
      "target": "— А мне какое дело?",
      "source_sha256": "437b67df715d6a5fd6293c2b2928e8b4cbf2025e136f13636c7b64993f3d609d",
      "target_id": "ru-fr81-u351-r0099",
      "tag": "prose",
      "target_sha256": "cc0b6275166764471faa3475919ea3e6f0f84847c188e31313acfb37ff812544"
    },
    {
      "source_id": "fr81-u351-r0100",
      "target": "— Говорю тебе, он отец.",
      "source_sha256": "60514973eb58845de24d07023e0ed3bd1ba1ee374f2e89b402633981c82f265e",
      "target_id": "ru-fr81-u351-r0100",
      "tag": "prose",
      "target_sha256": "6a18bb23e87abfdcedff6b4672e30c61429055cab9d069b147e9c289d59a2557"
    },
    {
      "source_id": "fr81-u351-r0101",
      "target": "— Не он один такой отец на свете.",
      "source_sha256": "7eaab734149e4c637095828753fb2c625d0e8a690660fbb09f89593f49e3a29c",
      "target_id": "ru-fr81-u351-r0101",
      "tag": "prose",
      "target_sha256": "b43d740d7f472fdb83b2559e6c5b880875bf6826ef540ea3e251c584353917f3"
    },
    {
      "source_id": "fr81-u351-r0102",
      "target": "— Слушай.",
      "source_sha256": "1bd097d1d97f34ea5b8702d7e77f1d2bc9b49865ef70ab4a0c3108366258c7d2",
      "target_id": "ru-fr81-u351-r0102",
      "tag": "prose",
      "target_sha256": "441f87f72c82ab340e08458bc01fe3a8d60c211c7cb33f130b83a5bbdc26914a"
    },
    {
      "source_id": "fr81-u351-r0103",
      "target": "— Что?",
      "source_sha256": "61a0fac8ae488c6bc653f1215cdda5ca31b778598be9273b7ab3b579855004d9",
      "target_id": "ru-fr81-u351-r0103",
      "tag": "prose",
      "target_sha256": "517f3ff122eb546ca36332ec960df6083fe4c7e2f428e22ee5ca0183ce22e859"
    },
    {
      "source_id": "fr81-u351-r0104",
      "target": "— Мне почти нельзя выходить иначе как в маске. Здесь я спрятан, никто не знает, что я тут. Но завтра масок уже не будет. Пепельная среда. Я рискую попасться[[N7]]. Мне надо вернуться в свою нору. А ты свободна.",
      "source_sha256": "4f67d5389805b765b5353d1bab037393b1766b6e4fb4b6fa64b867ec549930e2",
      "target_id": "ru-fr81-u351-r0104",
      "tag": "prose",
      "target_sha256": "e40764c4ca66cdde92b88b401b2cccecae9a2dd9fa960ca78087930da1f55e63"
    },
    {
      "source_id": "fr81-u351-r0105",
      "target": "— Не слишком.",
      "source_sha256": "4d0d908fb345d6c32134451e04cd18c66693aee0ee2dcb832efd04f07566d18f",
      "target_id": "ru-fr81-u351-r0105",
      "tag": "prose",
      "target_sha256": "ee3f32f02bc6573f8459884f6670d001e6909a85f87768eb9dcc5bf500c0fa49"
    },
    {
      "source_id": "fr81-u351-r0106",
      "target": "— Всё равно больше, чем я.",
      "source_sha256": "762cbef7ef91454e1bda616e4ce58ec8bff4765c59f3c76eae425efc8639429f",
      "target_id": "ru-fr81-u351-r0106",
      "tag": "prose",
      "target_sha256": "2c6c3322293583a251a5ed2e809d8a11b988e1ed0cc95d94bf3e509a2e81256c"
    },
    {
      "source_id": "fr81-u351-r0107",
      "target": "— Ну и что дальше?",
      "source_sha256": "3cb3ef6a0a446ce6225771556227fba2c505f01666d86c2bf6ff2d2a21b79bb7",
      "target_id": "ru-fr81-u351-r0107",
      "tag": "prose",
      "target_sha256": "dc7d51c098f266b06b27244aab6140d938c591cf77cae0aae60f53b670fe5124"
    },
    {
      "source_id": "fr81-u351-r0108",
      "target": "— Тебе надо постараться узнать, куда направилась эта свадьба.",
      "source_sha256": "5560558ba76b87180c8406857238f3204395bcf5e8e03fa79b0f9a5010932207",
      "target_id": "ru-fr81-u351-r0108",
      "tag": "prose",
      "target_sha256": "efd9a03372a25c7e70b932cd6dd9ec417ae7d1030ed7d0d42a087bc0492ca72c"
    },
    {
      "source_id": "fr81-u351-r0109",
      "target": "— Куда она едет?",
      "source_sha256": "267f8bcf43c4a45c7382b751a16c1fc5ddde81be0009b41eda6135f97a3d38a1",
      "target_id": "ru-fr81-u351-r0109",
      "tag": "prose",
      "target_sha256": "d97fe4edc6346ef56589df88b2c528a0296920dbde2a9610f3a318d6cba99c2e"
    },
    {
      "source_id": "fr81-u351-r0110",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u351-r0110",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u351-r0111",
      "target": "— Я это знаю.",
      "source_sha256": "fe2310c329e9adf8364558b96da4abf6b483886867150a9723e93f15d5782784",
      "target_id": "ru-fr81-u351-r0111",
      "tag": "prose",
      "target_sha256": "9bd93ab425a0afc38157b919bcff562b8263fde25e82ded236cc5f2c6e2e8dd0"
    },
    {
      "source_id": "fr81-u351-r0112",
      "target": "— Так куда же она едет?",
      "source_sha256": "dc7f3d4beef461082d30c21c52300aeaa88cf08e9ad0e980989b6dcfc30263b5",
      "target_id": "ru-fr81-u351-r0112",
      "tag": "prose",
      "target_sha256": "7144e8023a01cc3ee175d1caf3daae6f69f4edfce4d7a38674c2502ee15c7ce7"
    },
    {
      "source_id": "fr81-u351-r0113",
      "target": "— В «Синий циферблат».",
      "source_sha256": "cf32424888f7b2687dd1ab77eabcdd065ade476766bd458400b7fb4bd9a10a4a",
      "target_id": "ru-fr81-u351-r0113",
      "tag": "prose",
      "target_sha256": "7ae56ac6cc02cc75ec12b811511f4df5d474ce58a30e7a9063ddd87048fa87da"
    },
    {
      "source_id": "fr81-u351-r0114",
      "target": "— Для начала, это не в той стороне.",
      "source_sha256": "90bd6443ea116328b301c664dd246c4b7b9ce5b1b983b97cf8ed1fa66a2d49b6",
      "target_id": "ru-fr81-u351-r0114",
      "tag": "prose",
      "target_sha256": "4c6e4f693087d07921662cde8a7fca989d4511f039a539f3eb955565d11a6fe4"
    },
    {
      "source_id": "fr81-u351-r0115",
      "target": "— Ну так на Рапе!",
      "source_sha256": "d52a487b981ce67978ba7328e55a3b52428c6f0f76113cece1174c430b78f1c0",
      "target_id": "ru-fr81-u351-r0115",
      "tag": "prose",
      "target_sha256": "96c863a4fb157d24121e455d70d270ea9c209ca3df71d79934887919fa409556"
    },
    {
      "source_id": "fr81-u351-r0116",
      "target": "— Или куда-нибудь ещё.",
      "source_sha256": "890d3547293759b80e11ff3e3eef110de0d061ca25ac1c98db8836e191579f42",
      "target_id": "ru-fr81-u351-r0116",
      "tag": "prose",
      "target_sha256": "1e1b900a07c99a84666adae5b9b7fd3f9b8824f237dd417933cb9daeb9866bb8"
    },
    {
      "source_id": "fr81-u351-r0117",
      "target": "— Она свободна. Свадьбы свободны.",
      "source_sha256": "0a0fdfb84d654a693b2110ea329766061f69806e3707a26531c5ca1409fa0463",
      "target_id": "ru-fr81-u351-r0117",
      "tag": "prose",
      "target_sha256": "8c9d012149f16cba9e8f1c416d18fa4785e4f824f20d48044c85e51bb66e6273"
    },
    {
      "source_id": "fr81-u351-r0118",
      "target": "— Дело не в этом. Говорю тебе, ты должна постараться выяснить для меня, что это за свадьба, чей этот старик и где эта свадьба живёт.",
      "source_sha256": "fcd0e2e6a13f7594556bb77e8972999acd0ff67614df3a633f3a2beaf918131b",
      "target_id": "ru-fr81-u351-r0118",
      "tag": "prose",
      "target_sha256": "01251ab8a4a9f1cd45f82a73efc4a6d4577532327a0fc5a98b7f2db1a4873ed1"
    },
    {
      "source_id": "fr81-u351-r0119",
      "target": "— Ещё чего! Вот будет потеха. Очень удобно — найти через неделю свадьбу, что прокатилась по Парижу в последний день карнавала. Найти свадьбу[[N8]] на сеновале! Разве это возможно?",
      "source_sha256": "a663b1fb1dc3b4c1eb514bb54adbbe13f554e7fccaa847ab156ea5906f2664b4",
      "target_id": "ru-fr81-u351-r0119",
      "tag": "prose",
      "target_sha256": "e611c65e754c6fec4ac1033d68755b1009287281e1207c4494c1083e8f8300ee"
    },
    {
      "source_id": "fr81-u351-r0120",
      "target": "— Всё равно, надо постараться. Слышишь, Азельма?",
      "source_sha256": "792091511387d9ba0f68d5157f68a99df9bcf5c8c5484c81f6c7215fa783e61f",
      "target_id": "ru-fr81-u351-r0120",
      "tag": "prose",
      "target_sha256": "8a0ca462c221ecfa12b06e516f1cc0185d12740b01736f3f6e198a9c73c790d5"
    },
    {
      "source_id": "fr81-u351-r0121",
      "target": "Обе вереницы по обе стороны бульвара возобновили своё движение в противоположные стороны, и карета масок потеряла из виду «повозку» невесты.",
      "source_sha256": "c1db982ca52590c8fd42a882d9af0549dc69cf3fc01ee54911f80cbcf37cf264",
      "target_id": "ru-fr81-u351-r0121",
      "tag": "prose",
      "target_sha256": "1d3964f794c30f4e492709ca96438ae380e7d73effc681e05c5b8b1eb3bc1b3a"
    },
    {
      "source_id": "fr81-u351-r0122",
      "target": "[[I]]Daron[[/I]] — отец.",
      "source_sha256": "24621da75cf3e04e93917fdeb19cc7fe532091ef89d66f3f6f2fbccef324adda",
      "target_id": "ru-fr81-u351-r0122",
      "tag": "footnote",
      "target_sha256": "395c06de106f408feac3567b504ab3357483751bb8e99c8e053ceb97b4d60cec"
    },
    {
      "source_id": "fr81-u351-r0123",
      "target": "[[I]]Roulotte[[/I]] — карета.",
      "source_sha256": "92e59aa78e8a06ca2995ab712b390d9678b5a548910701bede18b80b178c87bd",
      "target_id": "ru-fr81-u351-r0123",
      "tag": "footnote",
      "target_sha256": "9aeb230b64d01118832ddf80e299b2addf64be00951f144de8787439c9eb6dd2"
    },
    {
      "source_id": "fr81-u351-r0124",
      "target": "Пусть мне перережут горло, и пусть я за всю жизнь не скажу ни «вы», ни «ты», ни «я», если я не знаю этого парижанина.",
      "source_sha256": "3229e1eea17f2de28c3537f29f232f232cae0daa90cdd2aa8cf2acdca4bc7c04",
      "target_id": "ru-fr81-u351-r0124",
      "tag": "footnote",
      "target_sha256": "fcc59fd7237228fb4da10ea5a582cfa9dc1b0d8b91e82699bc3b3849bd3c5c4d"
    },
    {
      "source_id": "fr81-u351-r0125",
      "target": "[[I]]Filer[[/I]] — следовать.",
      "source_sha256": "7ceae170eda767dd35a1be7287457d886ebd3521b8a4fec714492d5aaeb46ef5",
      "target_id": "ru-fr81-u351-r0125",
      "tag": "footnote",
      "target_sha256": "ee015a7d38136e91f8d3efc43d9aa36cb63ac5006f2610f5fb76e0fbf47c9533"
    },
    {
      "source_id": "fr81-u351-r0126",
      "target": "[[I]]Fée[[/I]] — девка.",
      "source_sha256": "052431dfe66ed8dcc9dc19d880f58bf644729e3ea2019db939b8d745f7a3e27a",
      "target_id": "ru-fr81-u351-r0126",
      "tag": "footnote",
      "target_sha256": "eb441a7eb639682260d9041e796700d6cd890f4361855c2f7d1191ae3272f868"
    }
  ],
