{
  "unit": 60,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u060-r0032",
      "target": "— Я говорю, что это просто чудо, что вы проехали пять лье и не угодили вместе с лошадью в какую-нибудь канаву на большой дороге. Да вы взгляните сами.",
      "source_sha256": "35809adc3850387655b3ab7648714d1b99adf94235f7099f2fd0c6a300a32f63",
      "target_id": "ru-fr81-u060-r0032",
      "tag": "prose",
      "target_sha256": "73ea79484ebe681ffb9f2a881b417594f2a19aaafa4c89989febea161b8d591d"
    },
    {
      "source_id": "fr81-u060-r0033",
      "target": "Колесо и в самом деле было серьёзно повреждено. От удара почтовой кареты треснули две спицы, а ступица была изборождена, и гайка на ней больше не держалась.",
      "source_sha256": "7bf722a19307d7f6d18cfacb483041bba5892ec2bfc0b56bec35f7dcc247f952",
      "target_id": "ru-fr81-u060-r0033",
      "tag": "prose",
      "target_sha256": "f3996f12cd54630d48fe6c9e5823ced4aacd25b90d619fd21c4d7e6e327a71d4"
    },
    {
      "source_id": "fr81-u060-r0034",
      "target": "— Друг мой, — обратился он к конюху, — здесь есть колёсный мастер?",
      "source_sha256": "e3b180b1d1632134f2f2f8f37b3aabc4bb7b2055c31e8addfe9873587cfbe34a",
      "target_id": "ru-fr81-u060-r0034",
      "tag": "prose",
      "target_sha256": "e2c2f84fad1e6f59aa0751b20b7d6808aacb54dcb0222b29e547e43114964a10"
    },
    {
      "source_id": "fr81-u060-r0035",
      "target": "— Конечно, сударь.",
      "source_sha256": "eb51feef8b60bafe28c1e22548273eeaa25e0b7d15a976cc7c915c2dc23458a6",
      "target_id": "ru-fr81-u060-r0035",
      "tag": "prose",
      "target_sha256": "95945719a42a729b78d689a532361877f11c02bd74f4a0085f11811b03bd88cd"
    },
    {
      "source_id": "fr81-u060-r0036",
      "target": "— Окажите любезность, сходите за ним.",
      "source_sha256": "b6bfcf3cc5ca09f2e393d9c98e641f9969272941d60ef0b2c837d94a86a52d82",
      "target_id": "ru-fr81-u060-r0036",
      "tag": "prose",
      "target_sha256": "6c2ea684a093603396d33a076e8fe1190426392c98a3dfd80353a3802eb3f7c6"
    },
    {
      "source_id": "fr81-u060-r0037",
      "target": "— Он тут, в двух шагах. Эй! Мастер Бургайяр!",
      "source_sha256": "a33844ea20be241734839c0981d64cc351671cb4137837ab35cbbbec8afd7681",
      "target_id": "ru-fr81-u060-r0037",
      "tag": "prose",
      "target_sha256": "d69c64b3c22f19b33be9cf4db844259c7df021771775c9258d7e7b16e0bfd789"
    },
    {
      "source_id": "fr81-u060-r0038",
      "target": "Мастер Бургайяр, колёсник, стоял на пороге своего дома. Он подошёл осмотреть колесо и скривился, как хирург, разглядывающий сломанную ногу.",
      "source_sha256": "0ff171379a2ce507bd0e347dfca8c521233e3b43c74e69dfe5545a760cfb1e42",
      "target_id": "ru-fr81-u060-r0038",
      "tag": "prose",
      "target_sha256": "574dd512928ec494fb4e900d2e2231453ff49337e3d6d287c4401751702b9710"
    },
    {
      "source_id": "fr81-u060-r0039",
      "target": "— Можете вы починить это колесо немедленно?",
      "source_sha256": "8465cf2f5f66135e8271a6982ee5d282cd92b18a02974b4edc822f7f7cf1b53b",
      "target_id": "ru-fr81-u060-r0039",
      "tag": "prose",
      "target_sha256": "a4e86eb3de05bca6b57f6e969e2f22d178d1e62c1add0d60f30406b2cb5a1d45"
    },
    {
      "source_id": "fr81-u060-r0040",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u060-r0040",
      "tag": "prose",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "fr81-u060-r0041",
      "target": "— Когда я смогу ехать дальше?",
      "source_sha256": "4bef8af6b20acbce23eef0ffbe119d2059d1a68c9e57fd0e722daf486aae0023",
      "target_id": "ru-fr81-u060-r0041",
      "tag": "prose",
      "target_sha256": "d9ca2a86f5d023c6495e58b8bcbb6b9a77172bb2c9ae5ce624c1f9d351cb39c7"
    },
    {
      "source_id": "fr81-u060-r0042",
      "target": "— Завтра.",
      "source_sha256": "9c3348dd843c29a10de640ec1e0fa818c2ffada08210f2f070cae504fa766a1b",
      "target_id": "ru-fr81-u060-r0042",
      "tag": "prose",
      "target_sha256": "f1fb45b07aa7d41d2d1f9911973d62e712e36334648b4daa562ea96537a46103"
    },
    {
      "source_id": "fr81-u060-r0043",
      "target": "— Завтра!",
      "source_sha256": "b2285b6d14d1c2f005f3a39d4730f28910ed5c07c4282344c2a94d6271b2b841",
      "target_id": "ru-fr81-u060-r0043",
      "tag": "prose",
      "target_sha256": "c0d6e1671ad93f947cb4ee3384e27b3edcf8e9f392369753627654980255a20f"
    },
    {
      "source_id": "fr81-u060-r0044",
      "target": "— Тут работы на целый день. Разве сударь торопится?",
      "source_sha256": "b5bf9b9c333f5e5ebc35e9f4a97c090c4536f6a23938de1b10310eb67face82d",
      "target_id": "ru-fr81-u060-r0044",
      "tag": "prose",
      "target_sha256": "5c4b396a9ee546456dc53f8753a24a659ca0b76d3ca114327b559c7cb9cfc36e"
    },
    {
      "source_id": "fr81-u060-r0045",
      "target": "— Очень тороплюсь. Я должен ехать дальше самое позднее через час.",
      "source_sha256": "5b75b0d1b7874a75048cedf96b2fed080f76b67f89f614982b22a9774befd272",
      "target_id": "ru-fr81-u060-r0045",
      "tag": "prose",
      "target_sha256": "b70110b03e0fa0c20fa13362e948d0aa6f202b79c2ee18cf78d01597aaa4d9bf"
    },
    {
      "source_id": "fr81-u060-r0046",
      "target": "— Невозможно, сударь.",
      "source_sha256": "d57bccc843200f93da85607ddcb2e4b6bfbdcac803b5977038cbd7469b2adbf6",
      "target_id": "ru-fr81-u060-r0046",
      "tag": "prose",
      "target_sha256": "9bd2ff6f03d01875f27cad120cd0799b056be1c9c8a7f31d3a387f4bcd374c95"
    },
    {
      "source_id": "fr81-u060-r0047",
      "target": "— Я заплачу сколько потребуется.",
      "source_sha256": "19cfe7dce6be71d79d788e815a4fb4accd56318245711ea3b67385b4aaeab77b",
      "target_id": "ru-fr81-u060-r0047",
      "tag": "prose",
      "target_sha256": "c26d03e81cee26273c3e8ea1fe2e8caa3a814e5c409a68bb13415d6699ed88d2"
    },
    {
      "source_id": "fr81-u060-r0048",
      "target": "— Невозможно.",
      "source_sha256": "727dc0506b7fbe6a845b447d96d22621b6edf93037b9ec2e173c6d7634480922",
      "target_id": "ru-fr81-u060-r0048",
      "tag": "prose",
      "target_sha256": "19872cfacd9316e743888a21f9e89816c4fcbb822dc99efb48fbf56fe0708921"
    },
    {
      "source_id": "fr81-u060-r0049",
      "target": "— Ну хорошо! Через два часа.",
      "source_sha256": "f6c14a2695371d55086ee5a0096e3de14903fd635a7295ec133c4ee4a1637784",
      "target_id": "ru-fr81-u060-r0049",
      "tag": "prose",
      "target_sha256": "e9051b960fccd255d419c7dd760ead55da0ca2e50ae1b169c3f1ff53dbb2e0df"
    },
    {
      "source_id": "fr81-u060-r0050",
      "target": "— Сегодня невозможно. Надо переделать две спицы и ступицу. Сударь не сможет выехать раньше завтрашнего дня.",
      "source_sha256": "cac09e63f602527b8d12f6fdd61f9475270b22188569c34a793b4381d666dcea",
      "target_id": "ru-fr81-u060-r0050",
      "tag": "prose",
      "target_sha256": "284f1b98453bd1d2f2a66900f0c06170c74173e16ed1df1b03ab437aa94895a3"
    },
    {
      "source_id": "fr81-u060-r0051",
      "target": "— Дело, по которому я еду, не может ждать до завтра. А что, если вместо починки этого колеса поставить другое?",
      "source_sha256": "f2ddfd549e5ca56d5e5204fff6c921d11fac23a6d1941b3a7c19281320090ba2",
      "target_id": "ru-fr81-u060-r0051",
      "tag": "prose",
      "target_sha256": "786fa465ba6d4ed89dde14afabaf8d20c7e350c1ea3beb8c0c7dd2f65861dbc6"
    },
    {
      "source_id": "fr81-u060-r0052",
      "target": "— Как это?",
      "source_sha256": "d3362c5ad884845b6ac71bb569ddf77261553ee7e5ad465bcf67d3a116f4c11f",
      "target_id": "ru-fr81-u060-r0052",
      "tag": "prose",
      "target_sha256": "53d464339880ad47645a0273b4955011716824f2cfa29f2c4fa641b5abc5c9a1"
    },
    {
      "source_id": "fr81-u060-r0053",
      "target": "— Вы ведь колёсный мастер?",
      "source_sha256": "4ba10c5239da1fdbf177769950da21d9e5a08e0fa266f116b07fc32a3f981d2e",
      "target_id": "ru-fr81-u060-r0053",
      "tag": "prose",
      "target_sha256": "16dca31abf0c29589a3c6b1edeb000875212e7b7b7decef466d49582762b10a3"
    },
    {
      "source_id": "fr81-u060-r0054",
      "target": "— Конечно, сударь.",
      "source_sha256": "eb51feef8b60bafe28c1e22548273eeaa25e0b7d15a976cc7c915c2dc23458a6",
      "target_id": "ru-fr81-u060-r0054",
      "tag": "prose",
      "target_sha256": "95945719a42a729b78d689a532361877f11c02bd74f4a0085f11811b03bd88cd"
    },
    {
      "source_id": "fr81-u060-r0055",
      "target": "— Нет ли у вас колеса, которое вы могли бы мне продать? Я мог бы тогда выехать сразу же.",
      "source_sha256": "184fe73c3d6dac6adbb38f2106659274e3cb61b0d73662619f0eecc259bc18ec",
      "target_id": "ru-fr81-u060-r0055",
      "tag": "prose",
      "target_sha256": "a5c15280d300dd984b13765d226aa7d121c43315d396ac17c6ceec2d66984ab9"
    },
    {
      "source_id": "fr81-u060-r0056",
      "target": "— Запасного колеса?",
      "source_sha256": "9fdc99243ce23754ff7f6a8901d9ab2021d19ccd44d7c0186f97d35bde8e1efe",
      "target_id": "ru-fr81-u060-r0056",
      "tag": "prose",
      "target_sha256": "f08a00d83eb9f8cfcdabf86b0989a2964e553adfc6f9c0472c2127b99f8b2003"
    },
    {
      "source_id": "fr81-u060-r0057",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u060-r0057",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u060-r0058",
      "target": "— Готового колеса для вашего кабриолета у меня нет. Два колеса составляют пару. Два колеса не подходят друг к другу как попало.",
      "source_sha256": "d3f3839b47acadae7c3124d8705801db1411ed7678994643beae8cfd0a3db3b1",
      "target_id": "ru-fr81-u060-r0058",
      "tag": "prose",
      "target_sha256": "137848afea6b2ab993ebb750ce5e324ab69ba4f116e23fc114d8084ecf5d2141"
    },
    {
      "source_id": "fr81-u060-r0059",
      "target": "— В таком случае продайте мне пару колёс.",
      "source_sha256": "02c26e160268d217ba51aa266d2d57d1b3bd004c57d89346d401e4129653139d",
      "target_id": "ru-fr81-u060-r0059",
      "tag": "prose",
      "target_sha256": "430b038864abc9e34dfcdfc7c62cb3aeefe5d65754d9f5477b28c878e36396ed"
    },
    {
      "source_id": "fr81-u060-r0060",
      "target": "— Сударь, не всякие колёса подходят ко всякой оси.",
      "source_sha256": "43904497b3d842f4e0b30c677ba63772b4b027f317913508ed05a8acdd3a4ce7",
      "target_id": "ru-fr81-u060-r0060",
      "tag": "prose",
      "target_sha256": "41c170cff192ea059be92914d073c3790552463d44c6f1d790f113f36729fa53"
    },
    {
      "source_id": "fr81-u060-r0061",
      "target": "— Всё же попробуйте.",
      "source_sha256": "77bb9a94105ddd7e2585e65af3db3ffb0f99ee9bff7dff60193179b3e6406fd0",
      "target_id": "ru-fr81-u060-r0061",
      "tag": "prose",
      "target_sha256": "31e3e3197f51246170b91a29d221a3a6145a89e6d2e7e7fb3228aeb5572950c7"
    },
    {
      "source_id": "fr81-u060-r0062",
      "target": "— Это бесполезно, сударь. Мне нечего продать, кроме колёс для телег. Мы здесь живём в маленьком краю.",
      "source_sha256": "eafb1e9475fd64966a0a2fe8cc62a794e8db2dc2d8b24b6e08825577dfa7d6ee",
      "target_id": "ru-fr81-u060-r0062",
      "tag": "prose",
      "target_sha256": "d8ca94fc5c087d8a792a17d57781d134a09b694922d5cb96c4b522041b6291a6"
    },
    {
      "source_id": "fr81-u060-r0063",
      "target": "— Не найдётся ли у вас кабриолета, который вы могли бы мне сдать внаём?",
      "source_sha256": "3d0afc2dbe1964ec5b877de247e94d6764fe360beb590ca571eeb5e8ff3e105e",
      "target_id": "ru-fr81-u060-r0063",
      "tag": "prose",
      "target_sha256": "2969d2cb3d9d23c67f4c1a828b34562389ed4aeff06cb56e3c74df26fdc55ef4"
    }
  ],
