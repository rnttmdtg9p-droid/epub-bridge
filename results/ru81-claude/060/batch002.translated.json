{
  "unit": 60,
  "batch": 2,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u060-r0064",
      "target": "Хозяин-тележник с первого взгляда понял, что тильбюри — наёмный экипаж. Он пожал плечами.",
      "source_sha256": "991c26b1a91cafb8d0664de9364d8cf3071f400dcd40149fdc1202355fe84704",
      "target_id": "ru-fr81-u060-r0064",
      "tag": "prose",
      "target_sha256": "a43cb5b47e81161bf77b127e1429e6d07d3109041867759738b094f6d0c00067"
    },
    {
      "source_id": "fr81-u060-r0065",
      "target": "— Хорошо же вы обращаетесь с кабриолетами, которые вам сдают! Будь у меня кабриолет, я бы вам его не сдал.",
      "source_sha256": "34e07f3186de6b60591a30f3fba54584a59a3316c72fbff67b06f8fcef98a3b8",
      "target_id": "ru-fr81-u060-r0065",
      "tag": "prose",
      "target_sha256": "4043ce15fd1b946022c21501202a5251bf389710e5085cdb59b027936768b000"
    },
    {
      "source_id": "fr81-u060-r0066",
      "target": "— Ну так продайте мне.",
      "source_sha256": "ebd100c5df996099c162c472987010c0b7a0668d8a4f5da4e73b4c0e955cafbc",
      "target_id": "ru-fr81-u060-r0066",
      "tag": "prose",
      "target_sha256": "2c6c6f3ca5b6493d529bd955758e3a4615ace0f84b0b427f3dcdb717a165e07e"
    },
    {
      "source_id": "fr81-u060-r0067",
      "target": "— У меня его нет.",
      "source_sha256": "6c7aa457c784d790575e00a9d8101d259e9bf42b3d96e4bd313ebb0de75c37b9",
      "target_id": "ru-fr81-u060-r0067",
      "tag": "prose",
      "target_sha256": "e10c9226d2353e648f8ac84114d88f6312dc05229fa80b5544f9ceb6da733254"
    },
    {
      "source_id": "fr81-u060-r0068",
      "target": "— Как! Даже повозки нет? Я, как видите, не привередлив.",
      "source_sha256": "819afbab2cfc0f95636ed9df4a0befc2991fbbb1ec6400ad3fe28cfa58881bc9",
      "target_id": "ru-fr81-u060-r0068",
      "tag": "prose",
      "target_sha256": "d4805962486d512c8a7d2dbf4c25c7e096ad2e3e461ecb7960569310fc95e4b6"
    },
    {
      "source_id": "fr81-u060-r0069",
      "target": "— Край у нас маленький. Правда, вон там, под навесом, — добавил тележник, — стоит старая коляска; она принадлежит одному горожанину, он отдал её мне на сохранение и ездит в ней раз в сто лет, когда рак свистнет. Я бы вам её сдал, мне-то что? Но горожанину не надо бы видеть, как она проезжает; да и потом, это коляска, понадобятся две лошади.",
      "source_sha256": "3fd6fd0f8aab30db1621e9322fe0b92e8fa0df229e965b7ddf0e89ef02a339d0",
      "target_id": "ru-fr81-u060-r0069",
      "tag": "prose",
      "target_sha256": "52e8f44bea68bdcd2119c27721e7a3afa142a845e492b4cd477e7d0fc1211158"
    },
    {
      "source_id": "fr81-u060-r0070",
      "target": "— Я возьму двух почтовых лошадей.",
      "source_sha256": "53c89007f7e042f9bd4a89e1626cac3a8405148ac04e4000bbc970de7b51300a",
      "target_id": "ru-fr81-u060-r0070",
      "tag": "prose",
      "target_sha256": "682ddb9a78c116af9f594e798e55b412ec51d891de9ed5e5493e7b1470c366fb"
    },
    {
      "source_id": "fr81-u060-r0071",
      "target": "— А куда едет сударь?",
      "source_sha256": "9b0ac15fb54d9c7056e3cbfca7f06e8de0c39585d704cbd2cc913a7740d903fd",
      "target_id": "ru-fr81-u060-r0071",
      "tag": "prose",
      "target_sha256": "371eedf41f4dee7dad238f85792922dbd25a6c0042341f28a1817213a6a9cc72"
    },
    {
      "source_id": "fr81-u060-r0072",
      "target": "— В Аррас.",
      "source_sha256": "087e4f3d7986c3e1fcf149a80f8ba8d7fd13e885abac8bbc81d6d451e814f226",
      "target_id": "ru-fr81-u060-r0072",
      "tag": "prose",
      "target_sha256": "226d24c69dacf677ec914aa414c936c88d7b9ad40053a8bfc437336471e8301d"
    },
    {
      "source_id": "fr81-u060-r0073",
      "target": "— И сударь хочет приехать сегодня?",
      "source_sha256": "84f201095112e31908cfb7ca0312ac708099b729514ca1848e081153c55d631f",
      "target_id": "ru-fr81-u060-r0073",
      "tag": "prose",
      "target_sha256": "4467701e43b9cca58ed4a9d554c8a694891c19a8089e20fa1b65a515a1a0de60"
    },
    {
      "source_id": "fr81-u060-r0074",
      "target": "— Ну да.",
      "source_sha256": "89d460959304b6eae0249f48455afa5220f97ac5de5264e9929d7dacc1437fe8",
      "target_id": "ru-fr81-u060-r0074",
      "tag": "prose",
      "target_sha256": "d2b74bde9b3248327389843bf09a54382b39ce61d3d8fd5a4286e9b5c07f372d"
    },
    {
      "source_id": "fr81-u060-r0075",
      "target": "— На почтовых лошадях?",
      "source_sha256": "ba833e962cffed64bb10fc8c54bc03cb535d259a881805e9bb939e23c37c0324",
      "target_id": "ru-fr81-u060-r0075",
      "tag": "prose",
      "target_sha256": "61ca80e57186888efde00cfccef648ed8762d7f5b094e1b832fb162da4dda7c8"
    },
    {
      "source_id": "fr81-u060-r0076",
      "target": "— Почему бы нет?",
      "source_sha256": "343fd8e5ef163e40b608bfa4fe702410c418812adfddebff47984a216c70cd83",
      "target_id": "ru-fr81-u060-r0076",
      "tag": "prose",
      "target_sha256": "32b889dc3cdc15aef4e482aef4492c6eda9999b5d9aeffe516986f9463400310"
    },
    {
      "source_id": "fr81-u060-r0077",
      "target": "— А сударю всё равно, приедет ли он этой ночью, в четыре часа утра?",
      "source_sha256": "e0d34a86bb82beb2c8a2a27f05a037169a79f3c891250ef6297e67b8f3ab652f",
      "target_id": "ru-fr81-u060-r0077",
      "tag": "prose",
      "target_sha256": "a39867dd7e509bdd7a1f3aab72536996d45e1a90dc69a2cb5680176056b8a1e1"
    },
    {
      "source_id": "fr81-u060-r0078",
      "target": "— Нет, конечно.",
      "source_sha256": "08453de1f209e26e2fc9cfa398be9c7fb99a8d0b9af14763342dcd0bb9e6f327",
      "target_id": "ru-fr81-u060-r0078",
      "tag": "prose",
      "target_sha256": "1cb8cdc856aa2853a42c0a56c9913a841d0a7cb53561a899fa7a764180a994cf"
    },
    {
      "source_id": "fr81-u060-r0079",
      "target": "— Видите ли, насчёт почтовых лошадей надо кое-что сказать… У сударя есть паспорт?",
      "source_sha256": "dd5fceb113006c65ed7b66bcc97640b91f5586236cbdb8766cef5f33387c81b4",
      "target_id": "ru-fr81-u060-r0079",
      "tag": "prose",
      "target_sha256": "6091de79fb08079ef4737d485a28112791ddc67f59805b0a09f3252c4198ca18"
    },
    {
      "source_id": "fr81-u060-r0080",
      "target": "— Есть.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u060-r0080",
      "tag": "prose",
      "target_sha256": "aa0045b76334dc59e30160d443ecd7b743719fae4e916f03ffbfd49f6932e9ca"
    },
    {
      "source_id": "fr81-u060-r0081",
      "target": "— Так вот, на почтовых лошадях сударь раньше завтрашнего дня в Аррас не приедет. У нас просёлочная дорога. Станции обслуживаются плохо, лошади в поле. Начинается пора больших плугов, нужны сильные упряжки, и лошадей разбирают повсюду, и на почте, и в других местах. На каждой станции сударю придётся ждать по меньшей мере три-четыре часа. А потом ехать будут шагом. Подъёмов много.",
      "source_sha256": "26de8d3561c31b151ead7ffb940e5c84b8ec1292ff4859cd85d25e536d142557",
      "target_id": "ru-fr81-u060-r0081",
      "tag": "prose",
      "target_sha256": "43bf78abd4596900ebbec645add9de9cb07eed331f6215592dfe0c6d34b6cc55"
    },
    {
      "source_id": "fr81-u060-r0082",
      "target": "— Ну что же, поеду верхом. Выпрягайте кабриолет. Седло мне, верно, продадут где-нибудь здесь.",
      "source_sha256": "04638c90f8d1d786722023cce05144c8fe4bcb36c161b7ab5ecf8a78ec10c269",
      "target_id": "ru-fr81-u060-r0082",
      "tag": "prose",
      "target_sha256": "838eb0ad6dce874d1f2d8a6b99d36d622ebbd71603cc5c771f4ee91af568cc78"
    },
    {
      "source_id": "fr81-u060-r0083",
      "target": "— Без сомнения. Но вынесет ли эта лошадь седло?",
      "source_sha256": "f481ce60361bc2cf7159dae50e8de5fbe270bc972b9c5383846c2db175615f21",
      "target_id": "ru-fr81-u060-r0083",
      "tag": "prose",
      "target_sha256": "2fc6d7e0638f1b79e13b54945358452070fde31d0cb5e12b19face9dacc3b73d"
    },
    {
      "source_id": "fr81-u060-r0084",
      "target": "— Правда, вы мне напомнили. Не вынесет.",
      "source_sha256": "e5371aa2e7211654f619666d292de186536f4a4528cc1d5c859fb1fc9bdd29e6",
      "target_id": "ru-fr81-u060-r0084",
      "tag": "prose",
      "target_sha256": "0d0a2b6142e0a7a12afe5d9ae1580364ee69de852c8d2b99f614f2f8aa65ba20"
    },
    {
      "source_id": "fr81-u060-r0085",
      "target": "— Тогда…",
      "source_sha256": "55a5e8e173fa76749ead3de994655ea8c35cd8325208484a1897d7c0921349ad",
      "target_id": "ru-fr81-u060-r0085",
      "tag": "prose",
      "target_sha256": "f8f4905afbcf6e50045cc2e0ec5610ee44632a532a784aa0ea06cd6cd2db8d7a"
    },
    {
      "source_id": "fr81-u060-r0086",
      "target": "— Но, может быть, в деревне найдётся лошадь внаём?",
      "source_sha256": "f3686dddf70aa7ee543aa43b791ce965714b8463536db626a13f785699e3af8b",
      "target_id": "ru-fr81-u060-r0086",
      "tag": "prose",
      "target_sha256": "4d57995c688bb77df6c9020987cb8b46696b1135cd0f90ba6471ab341ec9c062"
    },
    {
      "source_id": "fr81-u060-r0087",
      "target": "— Лошадь, чтобы доехать до Арраса за один раз!",
      "source_sha256": "b06731a4874d86edb5f35da834d30003c5688ed31f29e335451b1f8b5e757519",
      "target_id": "ru-fr81-u060-r0087",
      "tag": "prose",
      "target_sha256": "6addc95adf79ee2e86d065a5c52486fe7d1142586e44ad68ebe7b6f378ab6503"
    },
    {
      "source_id": "fr81-u060-r0088",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr81-u060-r0088",
      "tag": "prose",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr81-u060-r0089",
      "target": "— Нужна лошадь, каких в наших местах не бывает. Её пришлось бы сначала купить, потому что вас здесь не знают. Но ни купить, ни нанять, ни за пятьсот франков, ни за тысячу вы такой не найдёте!",
      "source_sha256": "9a664a3e14c9b53986fb7b5a18227f11a17634906a23271b7e876c962c4f3def",
      "target_id": "ru-fr81-u060-r0089",
      "tag": "prose",
      "target_sha256": "52155fdc7ef44b165faa357aa4aafb50cef654b7974796b68f71e633e3b78b10"
    },
    {
      "source_id": "fr81-u060-r0090",
      "target": "— Как же быть?",
      "source_sha256": "98b22d5e9204cb52587c85a1e4cf019cd650a80250f7b1cbf6c515ff9858da70",
      "target_id": "ru-fr81-u060-r0090",
      "tag": "prose",
      "target_sha256": "022b4eb7e22da628ad23c3b386fa4b1a7c999ada94060820e924d9ea948ffe9e"
    },
    {
      "source_id": "fr81-u060-r0091",
      "target": "— Лучше всего, по чести говоря, чтобы я починил колесо, а вы отложили поездку до завтра.",
      "source_sha256": "c4425dd538b2bde41583f3ebc440d128d67214103bc8e2cd96fb43ca4c884528",
      "target_id": "ru-fr81-u060-r0091",
      "tag": "prose",
      "target_sha256": "6358e10918d3dccc36dffdf0cfc14b675d59841db1506763a7c27e9ba2c9631b"
    },
    {
      "source_id": "fr81-u060-r0092",
      "target": "— Завтра будет слишком поздно.",
      "source_sha256": "f95ae2b2deceab9d38189921ebbc539f07593b8f5e985d4e813aed2c344779f3",
      "target_id": "ru-fr81-u060-r0092",
      "tag": "prose",
      "target_sha256": "42f988c39718823f9c6157198c487c761665d7ac8c7d0f134bee424d4968090b"
    },
    {
      "source_id": "fr81-u060-r0093",
      "target": "— Ну, знаете!",
      "source_sha256": "667c2b4d3384f5519f6afa1d79e6d44febfd230c11e3f627876972a3b36a273c",
      "target_id": "ru-fr81-u060-r0093",
      "tag": "prose",
      "target_sha256": "dd3fc0626e314caab4d0ca1bb587ea3a1f334ea0ecea650bcf3a9d0aab544f38"
    },
    {
      "source_id": "fr81-u060-r0094",
      "target": "— А разве нет почтовой кареты, которая идёт в Аррас? Когда она проходит?",
      "source_sha256": "76027c9afcfaabf07f72d531efbfddadd21dbe5b7bd084aa9558fcd285cfbbb8",
      "target_id": "ru-fr81-u060-r0094",
      "tag": "prose",
      "target_sha256": "d14248ee8588f3b4bc2b8b0492cb24a8000ba91ca4726de2f9619220c411bee3"
    },
    {
      "source_id": "fr81-u060-r0095",
      "target": "— Следующей ночью. Обе почтовые кареты ходят ночью, и та, что едет туда, и та, что едет оттуда.",
      "source_sha256": "4783f475dddd35285478026551cee6df30a219e12a222cd5ea70e88c758de1b4",
      "target_id": "ru-fr81-u060-r0095",
      "tag": "prose",
      "target_sha256": "ae517cf54f0a2338ac3eceb2dfba5469d1c3deed912a2ac3d818048db1f95f7b"
    }
  ],
