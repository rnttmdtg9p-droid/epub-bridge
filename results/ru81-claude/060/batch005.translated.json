{
  "unit": 60,
  "batch": 5,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u060-r0160",
      "target": "— Если вы так и дальше поедете, вам туда рано не добраться.",
      "source_sha256": "da0435fbf57375745d8f236cbe7b843c2f7464992b9dca6995a558578fcc904c",
      "target_id": "ru-fr81-u060-r0160",
      "tag": "prose",
      "target_sha256": "023fe4a273ff8fdea08661e8cbc58818c975a662709811a423b71514d9eb6681"
    },
    {
      "source_id": "fr81-u060-r0161",
      "target": "Он остановил лошадь и спросил дорожного рабочего:",
      "source_sha256": "f1dfb68481921d83e26181c15b6ad2d9c61828b4b64673f6bb5479ec71ee4e8b",
      "target_id": "ru-fr81-u060-r0161",
      "tag": "prose",
      "target_sha256": "4cef095acc9f86b0a10164c3b8de255e6f5c68861fd422f0340243dad9f702e9"
    },
    {
      "source_id": "fr81-u060-r0162",
      "target": "— Сколько еще отсюда до Арраса?",
      "source_sha256": "2e03fce3403172876409691f13c5ecf072e30be7d1b6da65b9c9021998ab70c8",
      "target_id": "ru-fr81-u060-r0162",
      "tag": "prose",
      "target_sha256": "51dd337fcd62073867fcca550751ed404d1b60af9f6a74cc759f636f949423c4"
    },
    {
      "source_id": "fr81-u060-r0163",
      "target": "— Почти семь добрых льё.",
      "source_sha256": "3d2f49f46bcec54445fd0a733b7983c4608ecaac847c7ebda4f6a57ad1943743",
      "target_id": "ru-fr81-u060-r0163",
      "tag": "prose",
      "target_sha256": "04f5c5c14c8a5e785cab8bb5a2afee6ec8bb1876129ad3f22ea609d6b5262fa9"
    },
    {
      "source_id": "fr81-u060-r0164",
      "target": "— Как так? В почтовой книге значится всего пять с четвертью.",
      "source_sha256": "60f400eaf6bfbe78f1eae3a74d7593a1feadd96f691c8de48c8fd0c865271ed8",
      "target_id": "ru-fr81-u060-r0164",
      "tag": "prose",
      "target_sha256": "77d3d77012031f989a53d67245d5fce4fd1d8d2ec4a33b766453fa8f77025a7a"
    },
    {
      "source_id": "fr81-u060-r0165",
      "target": "— А-а! — отозвался рабочий. — Стало быть, вы не знаете, что дорогу ремонтируют? Через четверть часа отсюда вы найдете ее разрытой. Дальше никак не проехать.",
      "source_sha256": "e63ce1d4850528c2374fda4db7c107b6c12004b0eb4ac43376f7617c10cba703",
      "target_id": "ru-fr81-u060-r0165",
      "tag": "prose",
      "target_sha256": "7ecef4d52e66b330c1fbc46f2f916ae402c8befae242202f16aa35c0113bfef6"
    },
    {
      "source_id": "fr81-u060-r0166",
      "target": "— В самом деле?",
      "source_sha256": "0d7c96cdf4d3611c0b538362fa446837ce9e5c6aaddacd5e2f68c3e3f8567960",
      "target_id": "ru-fr81-u060-r0166",
      "tag": "prose",
      "target_sha256": "520400e5250b09c04cf965f348f0fab60e000c1611ebefaee3dc1bb7ae55985f"
    },
    {
      "source_id": "fr81-u060-r0167",
      "target": "— Возьмете налево, по дороге на Каранси, переедете реку; а когда доберетесь до Камблена, повернете направо: это дорога на Мон-Сент-Элуа, она и ведет в Аррас.",
      "source_sha256": "956d14afba255cace1b0c38b7ffc619f474042e6b372a45cb4918a0222c99e50",
      "target_id": "ru-fr81-u060-r0167",
      "tag": "prose",
      "target_sha256": "f680c4f3d952a4d8d5242b420913172f0409d428b88a9b7fa665bc880f6228e8"
    },
    {
      "source_id": "fr81-u060-r0168",
      "target": "— Но вот-вот наступит ночь, я заблужусь.",
      "source_sha256": "ad0322dd0739bea5fcfd74a99fb12675620066602799a7ca2766cd1d4d2b4c2f",
      "target_id": "ru-fr81-u060-r0168",
      "tag": "prose",
      "target_sha256": "42d9821e6319bd2b069626a860fa6fb9aac973acc650278c47c6519ba8e0fa24"
    },
    {
      "source_id": "fr81-u060-r0169",
      "target": "— Вы нездешний?",
      "source_sha256": "897e410fba53c48e7049c011e43c168e6c1346fea753e512b61d4e33023d3b1e",
      "target_id": "ru-fr81-u060-r0169",
      "tag": "prose",
      "target_sha256": "db1e931a35037fbde2743a4b18e52ac61640583f9f5b7ed5319dadfa873edd1e"
    },
    {
      "source_id": "fr81-u060-r0170",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u060-r0170",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u060-r0171",
      "target": "— А там сплошь проселки. Послушайте, сударь, — продолжал рабочий, — хотите, я вам дам совет? Лошадь у вас устала, возвращайтесь в Тинк. Там есть хороший постоялый двор. Переночуйте. А в Аррас поедете завтра.",
      "source_sha256": "c892b792c1d5ce86e25b15a0cd1c43ff3bed7bba1567615a8d0d543458e832dd",
      "target_id": "ru-fr81-u060-r0171",
      "tag": "prose",
      "target_sha256": "bb2afecf550aa1d636111ff8c26ba2bb118695fcce169eed5a217027f83380ff"
    },
    {
      "source_id": "fr81-u060-r0172",
      "target": "— Мне нужно быть там сегодня вечером.",
      "source_sha256": "8d75488aad14d1d4cf17c87de09156093265322729b54f82a4691129e8b80afc",
      "target_id": "ru-fr81-u060-r0172",
      "tag": "prose",
      "target_sha256": "5f86de5777349f4371b6ef4d75b67a21d9fd67ebbbf58a205721e2e6ca0b87cd"
    },
    {
      "source_id": "fr81-u060-r0173",
      "target": "— Тогда другое дело. Все равно поезжайте на этот постоялый двор и возьмите там подмогу — вторую лошадь. Конюх, что при лошади, проведет вас проселком.",
      "source_sha256": "323c8236f1b20c0f1e78dc8c4a9cd7c7cd36e25a9a95ac1f9473be47870af138",
      "target_id": "ru-fr81-u060-r0173",
      "tag": "prose",
      "target_sha256": "f9ea56a997eb0a1d42c98d829f25659978459c86f9f14b35507b48f496f619e0"
    },
    {
      "source_id": "fr81-u060-r0174",
      "target": "Он последовал совету рабочего, повернул назад, и через полчаса уже снова проезжал то же место, но крупной рысью, с хорошей подставной лошадью. Конюх, величавший себя форейтором, сидел на оглобле повозки.",
      "source_sha256": "bac89066072ac74709887461c3e85ecaa6860390f71c5be667b4c02c434db251",
      "target_id": "ru-fr81-u060-r0174",
      "tag": "prose",
      "target_sha256": "745bff44b4f5914903495a20b7930ba0e8d311f153b434874284709db9d87828"
    },
    {
      "source_id": "fr81-u060-r0175",
      "target": "Однако он чувствовал, что теряет время.",
      "source_sha256": "1a8358b2877fc42c8682757b412f00209316ceb314bf0ed263f35661f5c4ed02",
      "target_id": "ru-fr81-u060-r0175",
      "tag": "prose",
      "target_sha256": "bbab0d6c7ba1008ba38f99212070ee25e72d44ae386310243992f2ba022ecc82"
    },
    {
      "source_id": "fr81-u060-r0176",
      "target": "Стояла уже глубокая ночь.",
      "source_sha256": "4c27bf650601e21b91ea46b2d32ac0832a4579c019a8aeabdc228db1823d5181",
      "target_id": "ru-fr81-u060-r0176",
      "tag": "prose",
      "target_sha256": "482964afc1957b5a4a383b26ea40cbf90a03b265dba2938008971fe5c8448283"
    },
    {
      "source_id": "fr81-u060-r0177",
      "target": "Они свернули на проселок. Дорога стала ужасной. Повозка проваливалась из одной колеи в другую. Он сказал форейтору:",
      "source_sha256": "ee63ec6eb979022828198493a7d0a873e0abd30106e2e20bb28dfde32f195541",
      "target_id": "ru-fr81-u060-r0177",
      "tag": "prose",
      "target_sha256": "62207622318951887bc43a3c1855c2a7d7886942439c5c73713739df356813b7"
    },
    {
      "source_id": "fr81-u060-r0178",
      "target": "— Все время рысью, и двойные чаевые.",
      "source_sha256": "a98e639d37e852c46d975fa19dd9cc51ad8f3a6fa1b29d1c10deecbfabd4cdf3",
      "target_id": "ru-fr81-u060-r0178",
      "tag": "prose",
      "target_sha256": "adf56b7ba83559a825ab57a7356cba90e42cee2485d4df77dcf59ecff2a8ed03"
    },
    {
      "source_id": "fr81-u060-r0179",
      "target": "На ухабе сломалась вальек.",
      "source_sha256": "029f13c571051c23d6df5f0a23afe59318542ec6a5e0691e1be8e1d4beb137a6",
      "target_id": "ru-fr81-u060-r0179",
      "tag": "prose",
      "target_sha256": "5257d0604c814db487ad633b1a148047f2910f2b6c96595dd607b3ed4e4445a0"
    },
    {
      "source_id": "fr81-u060-r0180",
      "target": "— Сударь, — сказал форейтор, — вальек сломался, я не знаю, как теперь запрячь лошадь; эта дорога ночью очень плоха; если бы вы согласились вернуться ночевать в Тинк, мы могли бы завтра рано утром быть в Аррасе.",
      "source_sha256": "6a6457391e6f3ec6676238fa610c2c7cb5369559f4281ae9897c9a5be0b28c87",
      "target_id": "ru-fr81-u060-r0180",
      "tag": "prose",
      "target_sha256": "0b6c95cc0299442d367a15046c6d95f2c13d4f7195d1c0a60e9806907de40bb5"
    },
    {
      "source_id": "fr81-u060-r0181",
      "target": "Он ответил: — Есть у тебя кусок веревки и нож?",
      "source_sha256": "e4bc89834d77e900a6d037663a67b3391b9206b847ca6c992190374393fb2743",
      "target_id": "ru-fr81-u060-r0181",
      "tag": "prose",
      "target_sha256": "764224a876654ed791f1bd2091421a12b0f34b0c592c200a601f6e60f1e61669"
    },
    {
      "source_id": "fr81-u060-r0182",
      "target": "— Есть, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-fr81-u060-r0182",
      "tag": "prose",
      "target_sha256": "e847ed2ae44c0073799b772db9bdf26e21f1a486e974dfc3926667586015cd45"
    },
    {
      "source_id": "fr81-u060-r0183",
      "target": "Он срезал ветку с дерева и сделал из нее вальек.",
      "source_sha256": "133acd978e6e9028f6e36c2fdf68a14a526f1eb6ea753c2d85497018b2ef161a",
      "target_id": "ru-fr81-u060-r0183",
      "tag": "prose",
      "target_sha256": "cf7ee3bec182178a3ec9f9f3102670deb78f1c0a8e84ca8903316507b178c775"
    },
    {
      "source_id": "fr81-u060-r0184",
      "target": "Это отняло еще двадцать минут; но они снова пустились вскачь.",
      "source_sha256": "4d42fd5fee655e63174deb1e87a86e392ad6a68b38d2eb13727a700f44b86fee",
      "target_id": "ru-fr81-u060-r0184",
      "tag": "prose",
      "target_sha256": "6ca25abb6e71c3a62605e1e0d3339d5ecf9077b279ac3a125d8858ed559f8807"
    },
    {
      "source_id": "fr81-u060-r0185",
      "target": "Равнина была темна. Низкие, короткие, черные туманы ползли по холмам и отрывались от них, как дымы. В облаках виднелись беловатые отсветы. Сильный ветер, налетавший с моря, производил во всех углах горизонта шум, какой бывает, когда кто-то передвигает мебель. Все, что смутно виднелось, принимало позы ужаса. Сколько вещей содрогается под этими огромными дуновениями ночи!",
      "source_sha256": "8e9ec8b831446aad755493334d54cd1456673e26e6a762b46f9b19cdb2a2ce6d",
      "target_id": "ru-fr81-u060-r0185",
      "tag": "prose",
      "target_sha256": "aa7d9cf6aafb439cbbb5f0824d50495a08ae49760845ebfd95cc74d42a31e27c"
    },
    {
      "source_id": "fr81-u060-r0186",
      "target": "Холод пронизывал его. Он не ел со вчерашнего дня. Он смутно вспоминал другой свой ночной путь по большой равнине в окрестностях Диня. Это было восемь лет назад; а казалось, будто вчера.",
      "source_sha256": "3f329a62ee4af309da17715ca361ffabb4c6f250a6c8f4977a7a4d0fc4b76fb2",
      "target_id": "ru-fr81-u060-r0186",
      "tag": "prose",
      "target_sha256": "9427f226b8663ce9dcefb369bc0345aa1a881d34b18173013ea8deb9dfe4cfab"
    },
    {
      "source_id": "fr81-u060-r0187",
      "target": "На какой-то дальней колокольне пробило час. Он спросил парня:",
      "source_sha256": "02bacbc8c633f25a65de1f9dd0b4de05d9b9dd08977cfcf3acafd116870682d4",
      "target_id": "ru-fr81-u060-r0187",
      "tag": "prose",
      "target_sha256": "b9f2b43d4f105a17101f00d4e8aa0b8742efb727b43f1578ef4698d2d9f98de9"
    },
    {
      "source_id": "fr81-u060-r0188",
      "target": "— Который час?",
      "source_sha256": "ad7742a05821518574f8cde67def348a51537fe14e87b2831717d830ea06b3e7",
      "target_id": "ru-fr81-u060-r0188",
      "tag": "prose",
      "target_sha256": "c2ab059192248ca5e046679e2d958e3335093ded7c86cd3d9868cdcc6469ded6"
    },
    {
      "source_id": "fr81-u060-r0189",
      "target": "— Семь часов, сударь. В Аррасе будем в восемь. Нам осталось всего три льё.",
      "source_sha256": "846d0344e21710e1cca981c1151af9ee398abd5af180b99e62a4ef46cd3ce7f5",
      "target_id": "ru-fr81-u060-r0189",
      "tag": "prose",
      "target_sha256": "7fc39fd10128881cb7aef0b012a434ba51d003d10bcec957da0a1a21665292a7"
    },
    {
      "source_id": "fr81-u060-r0190",
      "target": "В эту минуту он впервые подумал — и счел странным, что это не пришло ему в голову раньше, — что, быть может, все его хлопоты напрасны; что он даже не знает, в котором часу суд; что ему следовало по меньшей мере осведомиться об этом; что нелепо ехать так, наобум, не зная, послужит ли это к чему-нибудь. Затем он начал прикидывать в уме: что обычно заседания уголовных судов начинаются в девять часов утра; что это дело не должно быть долгим; что кража яблок займет совсем немного времени; что затем останется лишь вопрос о тождестве личности; четыре-пять показаний, адвокатам почти нечего будет сказать; что он приедет, когда все уже будет кончено!",
      "source_sha256": "eec4d615348321ecaafb49106c7c268f75651f9c3cba4577242ca3696f8eb160",
      "target_id": "ru-fr81-u060-r0190",
      "tag": "prose",
      "target_sha256": "0adba08db1f2b43bfce00f611cf64edb11292ea305bc5df8d3f90ccb0c36f4d4"
    },
    {
      "source_id": "fr81-u060-r0191",
      "target": "Форейтор хлестал лошадей. Они переехали реку и оставили позади Мон-Сент-Элуа.",
      "source_sha256": "f168e864283f95bef6ebb4ffe0ebcba5b05ee7b94438efd93588fda79e40ba5d",
      "target_id": "ru-fr81-u060-r0191",
      "tag": "prose",
      "target_sha256": "9d9fe5e519bcc336930ea084f69783fb246468e54dd90c8a92a6c707ffe64f13"
    }
  ],
