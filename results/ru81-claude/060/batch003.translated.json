{
  "unit": 60,
  "batch": 3,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u060-r0096",
      "target": "— Как! Вам целый день нужен, чтобы починить это колесо?",
      "source_sha256": "a7aa6b946b557cf892ebc8820788e6640faaf11d0a925d038321cd9e93660976",
      "target_id": "ru-fr81-u060-r0096",
      "tag": "prose",
      "target_sha256": "235203da2710372b5a788ca39c8d941cb6eaa71bca7057cc8ead5ac369ee7060"
    },
    {
      "source_id": "fr81-u060-r0097",
      "target": "— Целый день, и то в обрез!",
      "source_sha256": "a47706513d03183a97bdc397bdfc015b62abd6309521ce7c4ce46f4ea513ad5e",
      "target_id": "ru-fr81-u060-r0097",
      "tag": "prose",
      "target_sha256": "a4fb14822d6034cb8dcb91912e3275130f0210b08ab08a25c2841aad547f5ef1"
    },
    {
      "source_id": "fr81-u060-r0098",
      "target": "— А если поставить двух работников?",
      "source_sha256": "ff2ba0cdb31e2a8ca5fa7270ee30adab501f30740f111aa75c39dbc13ecfea63",
      "target_id": "ru-fr81-u060-r0098",
      "tag": "prose",
      "target_sha256": "dba69e935e5b18836dae17f5a2a5e2cefde30cf61f9576c60280afa9fe8b9045"
    },
    {
      "source_id": "fr81-u060-r0099",
      "target": "— Хоть десятерых!",
      "source_sha256": "ff36c50bc8e823dc3f4298ca7fa3df665ef1745376b9d134194542ea47421fe3",
      "target_id": "ru-fr81-u060-r0099",
      "tag": "prose",
      "target_sha256": "5ef3ff3c1d561d3b1197a300c71a96549fa2008f96612636772e93cd6d4eef19"
    },
    {
      "source_id": "fr81-u060-r0100",
      "target": "— А если связать спицы верёвками?",
      "source_sha256": "a63d260ea558528ed006d0510637d8c9ea8f36a87cd9aee482c57d58d1fbb33d",
      "target_id": "ru-fr81-u060-r0100",
      "tag": "prose",
      "target_sha256": "a52c2e680fad187c485182814f7d2151bdfc6d9fff4cbfa66a4d52cdf9d53940"
    },
    {
      "source_id": "fr81-u060-r0101",
      "target": "— Спицы — можно, ступицу — нельзя. Да и обод тоже никуда не годится.",
      "source_sha256": "9ca64726ae62c8a41a62dad6437a30bb1e24af6c5c6902e1a6005672240f6ff5",
      "target_id": "ru-fr81-u060-r0101",
      "tag": "prose",
      "target_sha256": "78112d2e8c2faf1d3a15331378c6cbcc2678bda3fc889950b7d5397e8b2fc6b1"
    },
    {
      "source_id": "fr81-u060-r0102",
      "target": "— Есть в городе кто-нибудь, кто отдаёт внаём экипажи?",
      "source_sha256": "7fe95b015358f422c0c8174890f8d0058d27428f301cef2b3312a08111267dc2",
      "target_id": "ru-fr81-u060-r0102",
      "tag": "prose",
      "target_sha256": "f7b7137e8f147a3d8d4c9dc556c7f66edb25d1c7fd73b1ce8399a4164a9b15da"
    },
    {
      "source_id": "fr81-u060-r0103",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u060-r0103",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u060-r0104",
      "target": "— А другой тележный мастер есть?",
      "source_sha256": "40d6d518a36f675c17eae576bb38b2aa1ebada0c049ce87b47c8dab62b2bcee2",
      "target_id": "ru-fr81-u060-r0104",
      "tag": "prose",
      "target_sha256": "673ff8a3880b2863a6c2946e027a086b3e5aa404618e0b6bb19f9f11b84dc490"
    },
    {
      "source_id": "fr81-u060-r0105",
      "target": "Конюх и хозяин-колёсник ответили разом, качая головой:",
      "source_sha256": "0aea2a99880dd596b16d71b58d1c93fb70a96f0225221819d1bbb7fbf59ebcca",
      "target_id": "ru-fr81-u060-r0105",
      "tag": "prose",
      "target_sha256": "08f92271d0ef74175e74d9e2b4b5d305dbfde00175a1867be0305ecaf15f1f37"
    },
    {
      "source_id": "fr81-u060-r0106",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-fr81-u060-r0106",
      "tag": "prose",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "fr81-u060-r0107",
      "target": "Он почувствовал огромную радость.",
      "source_sha256": "6dc1b17195c32d9d746d85ebfcfd7385c017e19c677d19aba79eabce3a6783f2",
      "target_id": "ru-fr81-u060-r0107",
      "tag": "prose",
      "target_sha256": "feff39c53ecbee36487d7d2971e141548dc8959ae8127c5f521435f8d93d0cb1"
    },
    {
      "source_id": "fr81-u060-r0108",
      "target": "Было очевидно, что в дело вмешалось провидение. Это оно сломало колесо тильбюри и задержало его в пути. Он не покорился этому как бы первому предостережению; он только что сделал всё возможное, чтобы продолжить путешествие; он честно и добросовестно испробовал все средства; он не отступил ни перед временем года, ни перед усталостью, ни перед расходами; ему не в чем было себя упрекнуть. Если он не поедет дальше, это уже его не касалось. Это уже не его вина; это было не делом его совести, а делом провидения.",
      "source_sha256": "eee8d9e5080b58e38db14bc54de6a83285f532934127ae46a99a5acb5cb6f187",
      "target_id": "ru-fr81-u060-r0108",
      "tag": "prose",
      "target_sha256": "bbc2bfe565397e5787f83c7eadfe2f7537accede6f147b3567e0c76dc9e667ad"
    },
    {
      "source_id": "fr81-u060-r0109",
      "target": "Он вздохнул. Он вздохнул свободно, всей грудью, впервые после посещения Жавера. Ему казалось, что железная рука, двадцать часов сжимавшая ему сердце, наконец разжалась.",
      "source_sha256": "da728a55ae309f655423a70cde0d5e51c0e338937aff39851c4f6efb0f6471af",
      "target_id": "ru-fr81-u060-r0109",
      "tag": "prose",
      "target_sha256": "ec71e9df9e98bc9ed72059683717ee77909537d29f4cbd27e3a4f8ded341e62a"
    },
    {
      "source_id": "fr81-u060-r0110",
      "target": "Ему казалось, что теперь Бог на его стороне и объявил об этом.",
      "source_sha256": "c40f1f38bd20d0c54e6a9be40c4ce06ec71db81eb37cf3e0717ac6155063dfa0",
      "target_id": "ru-fr81-u060-r0110",
      "tag": "prose",
      "target_sha256": "92ef47a745df94cdeaa45ef2d8b79aa2e1754e02cf2f95044556b502aee052d8"
    },
    {
      "source_id": "fr81-u060-r0111",
      "target": "Он сказал себе, что сделал всё, что мог, и что теперь ему остаётся лишь спокойно вернуться назад.",
      "source_sha256": "0958f485bd1d68d8664283a42f243726629f791cb86ee36ec826b7df78eb39ca",
      "target_id": "ru-fr81-u060-r0111",
      "tag": "prose",
      "target_sha256": "60a97851b2feb4ee69881ce289c31b69d5523568117b767abbddbc3427099029"
    },
    {
      "source_id": "fr81-u060-r0112",
      "target": "Если бы его разговор с колёсником происходил в комнате постоялого двора, у него не было бы свидетелей, никто бы его не услышал, всё так бы и осталось, и, вероятно, нам не пришлось бы рассказывать ни об одном из событий, которые читатель сейчас увидит; но этот разговор происходил на улице. Всякая беседа на улице неизбежно собирает кружок. Всегда находятся люди, которым только и нужно, что быть зрителями. Пока он расспрашивал колёсника, несколько прохожих остановились возле них. Послушав несколько минут, один мальчишка, на которого никто не обратил внимания, отделился от кучки и убежал.",
      "source_sha256": "7c6755cdc2d72edd69e361492d4881c355666fef3d6ba14271e19ef934316f9b",
      "target_id": "ru-fr81-u060-r0112",
      "tag": "prose",
      "target_sha256": "8a307709df6d8bf9ff6bd1eaeb52ac93d20248f840671424b384942b7573066f"
    },
    {
      "source_id": "fr81-u060-r0113",
      "target": "В ту минуту, когда путешественник, после описанного нами внутреннего совещания с самим собой, решился повернуть назад, этот ребёнок вернулся. С ним была старуха.",
      "source_sha256": "8e474ba087c77768a6e37497e7ff8aa1e64734c58204258e2a640c718699250c",
      "target_id": "ru-fr81-u060-r0113",
      "tag": "prose",
      "target_sha256": "52e3c11ed8403a642bd8f79b9ae2bb0f87d7f46ec85321f10243b372369170c8"
    },
    {
      "source_id": "fr81-u060-r0114",
      "target": "— Сударь, — сказала женщина, — сын говорит мне, что вы хотите нанять кабриолет.",
      "source_sha256": "fa9969f4ef4b038cd303c8e46a897cee6914a3859547329ec0eda6cc55f8836a",
      "target_id": "ru-fr81-u060-r0114",
      "tag": "prose",
      "target_sha256": "21d109d81c2124c45d82cc0dabebe5ee7216bc8ff78bc8fad49fd6d9ef713899"
    },
    {
      "source_id": "fr81-u060-r0115",
      "target": "От этих простых слов, произнесённых старухой, которую вёл ребёнок, пот заструился у него по пояснице. Ему почудилось, что рука, выпустившая его, вновь появилась во мраке за его спиной, готовая снова схватить его.",
      "source_sha256": "c91dba5acc6fed550821d15f0ddd3440c8f2631000e3d5046100dcb5066b793f",
      "target_id": "ru-fr81-u060-r0115",
      "tag": "prose",
      "target_sha256": "6415100bd4b1e1a7a954488f1228f6b62cdd008c23506145fa01aee79b27d9d5"
    },
    {
      "source_id": "fr81-u060-r0116",
      "target": "Он ответил:",
      "source_sha256": "199b619971afb212faa834f5669870844e27393d8deb51451f462df160009be2",
      "target_id": "ru-fr81-u060-r0116",
      "tag": "prose",
      "target_sha256": "b3eb94c304e72356e90b009354a82a871486deb46ab63968ffdf02f95cff5dfe"
    },
    {
      "source_id": "fr81-u060-r0117",
      "target": "— Да, добрая женщина, я ищу кабриолет внаём.",
      "source_sha256": "56800278afaa98713f6c4b93a6ca2c6f1df8a7ea389c0fad73f15dec5327d6f5",
      "target_id": "ru-fr81-u060-r0117",
      "tag": "prose",
      "target_sha256": "550b47d428a403d19ffd68744f31fbf4a1c1b3984680a529fad9033e0ebf74bb"
    },
    {
      "source_id": "fr81-u060-r0118",
      "target": "И поспешил добавить:",
      "source_sha256": "b384f627e806b369c6883e1eb56de863fa5d09e127e934aa2a74cc08db08721f",
      "target_id": "ru-fr81-u060-r0118",
      "tag": "prose",
      "target_sha256": "78978110bcbe81f9bb8a212590d7b17e73f33689fb3666bc2d2d46a4a5235ea5"
    },
    {
      "source_id": "fr81-u060-r0119",
      "target": "— Но в этих краях его нет.",
      "source_sha256": "ac283d0f0b3a072cdab0c6c704cb1ad47fe70545a507efbeb62d5dfcb97fe9bb",
      "target_id": "ru-fr81-u060-r0119",
      "tag": "prose",
      "target_sha256": "09e2889c622a5e364af34cd00951e2ed5181052058cda15844c21eab83f2bc76"
    },
    {
      "source_id": "fr81-u060-r0120",
      "target": "— Как же нет, — сказала старуха.",
      "source_sha256": "722be8818cd27f2933ec6a9ed62a448bf5ba40b4baa4427cbdce68fce81e2641",
      "target_id": "ru-fr81-u060-r0120",
      "tag": "prose",
      "target_sha256": "dd06575d6ab21c28544cb7db8b28aa8d9538e1e2c388e304a5a6e57015a3b148"
    },
    {
      "source_id": "fr81-u060-r0121",
      "target": "— Где же это? — спросил колёсник.",
      "source_sha256": "267dadb8fb23b532b6a71336a0ca4aa1fe6fc879c77bc14fc95b921faba86f7a",
      "target_id": "ru-fr81-u060-r0121",
      "tag": "prose",
      "target_sha256": "0e9933386ce58596b3ee0ad5a4c26498412c6fb9593dda4dc5c98264baf5d6dd"
    },
    {
      "source_id": "fr81-u060-r0122",
      "target": "— У меня, — ответила старуха.",
      "source_sha256": "1c3b4e31e869c49a34d9c6f52f6c54acb83a553d44c990b75b36a01219ce458e",
      "target_id": "ru-fr81-u060-r0122",
      "tag": "prose",
      "target_sha256": "97a0ef518711ff37e190819fbba446adb099c1312c68cd4805338ef331515365"
    },
    {
      "source_id": "fr81-u060-r0123",
      "target": "Он вздрогнул. Роковая рука снова схватила его.",
      "source_sha256": "58e8b3bec5540f93d33a55701936e4be0d851d609e35f5fa61c807b97f2762a2",
      "target_id": "ru-fr81-u060-r0123",
      "tag": "prose",
      "target_sha256": "81d304f3afee578c1b3747015487666f34deeacc1cb73ed994bbe0efeac5e298"
    },
    {
      "source_id": "fr81-u060-r0124",
      "target": "У старухи и в самом деле стояла под навесом какая-то плетёная таратайка. Колёсник и слуга с постоялого двора, огорчённые тем, что путешественник ускользает от них, вмешались.",
      "source_sha256": "e4832c685458baefe8139a9f36bdaab2d6c05226393ee9af1e1ecd7145a15075",
      "target_id": "ru-fr81-u060-r0124",
      "tag": "prose",
      "target_sha256": "2003349191897bc67d15900c6f9ed86decab8a03566afc27db337eb83b0711c0"
    },
    {
      "source_id": "fr81-u060-r0125",
      "target": "— Это ужасная колымага, — она поставлена прямо на ось, — правда, сиденья внутри подвешены на кожаных ремнях, — в ней дождь льёт внутрь, — колёса ржавые и изъедены сыростью, — она уедет ненамного дальше тильбюри, — настоящая развалина! — этот господин сильно ошибся бы, сев в неё, — и так далее, и так далее.",
      "source_sha256": "44f7e85611797cc181230b4b13e04551736bb106481cc533af4563f33a5ef13c",
      "target_id": "ru-fr81-u060-r0125",
      "tag": "prose",
      "target_sha256": "538bebeab5ff0223ccf02b87683fcd780f916d740e4e8a9521766d9445809367"
    },
    {
      "source_id": "fr81-u060-r0126",
      "target": "Всё это была правда, но эта колымага, эта развалина, эта штука, чем бы она ни была, катилась на двух колёсах и могла доехать до Арраса.",
      "source_sha256": "88c1c19569eac50071dcfbe46bba43075748464163b35a3f9f8a3b3ff73d9563",
      "target_id": "ru-fr81-u060-r0126",
      "tag": "prose",
      "target_sha256": "0b8b5c2b38d9e892ead3f2908b3055d481e055970cecd1fce7951f385d61c399"
    },
    {
      "source_id": "fr81-u060-r0127",
      "target": "Он заплатил, сколько спросили, оставил тильбюри в починку у колёсника, чтобы забрать его по возвращении, велел запрячь белую лошадь в таратайку, сел в неё и продолжил путь, которым ехал с самого утра.",
      "source_sha256": "2699373c0861457c8e397dce0dde7700ba0ddc9383a22aafb2421f5139a07825",
      "target_id": "ru-fr81-u060-r0127",
      "tag": "prose",
      "target_sha256": "ed85008689dc0e370ff6996ceb9a65151a40adcf89985a596c28b97e53eb89fb"
    }
  ],
