{
  "unit": 303,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr81-u303-r0032",
      "target": "Авторитет его был велик. Анжольрас, правда, был начальником баррикады, но Мариус был её спасителем.",
      "source_sha256": "1eb3ba35becd25bef55e27e340e3e559ca88af406e56120ac23acb0f9ac6133d",
      "target_id": "ru-fr81-u303-r0032",
      "tag": "prose",
      "target_sha256": "479688ddabb61f55a72dbf12304e1c503f8311fca69d37d2a59de1ff5d0abb01"
    },
    {
      "source_id": "fr81-u303-r0033",
      "target": "— Я приказываю! — крикнул Анжольрас.",
      "source_sha256": "fcca594d83ffb8d0a0f97f261e03a09e2e31da7e3df7052c9f1d918aee551ed6",
      "target_id": "ru-fr81-u303-r0033",
      "tag": "prose",
      "target_sha256": "1db33cf31a199fac48b815a7ab48c891055ca9ee1de2d1f4ebdccbc632dda20a"
    },
    {
      "source_id": "fr81-u303-r0034",
      "target": "— Я вас прошу, — сказал Мариус.",
      "source_sha256": "e4d86b023ee9bbf975da88ef73943e66a3776e3597911791063d638863c4828f",
      "target_id": "ru-fr81-u303-r0034",
      "tag": "prose",
      "target_sha256": "e0debb81906b6b8e259d048ce65b7cf0acf135e1c4b4c45f4333d1735c6ee6d1"
    },
    {
      "source_id": "fr81-u303-r0035",
      "target": "Тогда, тронутые словами Комбефера, поколебленные приказом Анжольраса, взволнованные просьбой Мариуса, эти героические люди стали обличать друг друга. — Это правда, — говорил юноша человеку зрелых лет. — Ты отец семейства. Уходи. — Скорее уж ты, — отвечал тот, — у тебя две сестры, и ты их кормишь. — И разгорелась неслыханная борьба. Спорили о том, кого не выставят за порог могилы.",
      "source_sha256": "ea1c3294b5f6b32ea137c9ed72e54a83bcf4c3cd154a5193795c5d27bd788d3a",
      "target_id": "ru-fr81-u303-r0035",
      "tag": "prose",
      "target_sha256": "1c305f6b5d0a95b4a1d1f064537975263078f02c9703e2bf2cef5ecf666ed1a2"
    },
    {
      "source_id": "fr81-u303-r0036",
      "target": "— Поторопимся, — сказал Курфейрак, — через четверть часа будет поздно.",
      "source_sha256": "e767ba942c64b578f761aa81d2d5a6c20e49c93d4e303f3eac7c736292dd8791",
      "target_id": "ru-fr81-u303-r0036",
      "tag": "prose",
      "target_sha256": "b122b2eecdfcd654403f147c43d136fbb536547aee5a7f277694161c7211fbe1"
    },
    {
      "source_id": "fr81-u303-r0037",
      "target": "— Граждане, — продолжал Анжольрас, — здесь республика, и здесь царит всеобщее голосование. Назовите сами тех, кто должен уйти.",
      "source_sha256": "21cd91da86cdbb9271a5394cb893b099edce6e1a2f7cdcfb2168232fe11de1a4",
      "target_id": "ru-fr81-u303-r0037",
      "tag": "prose",
      "target_sha256": "569fa2cfc6ef7b51e1382f33f2e2b1c8e6bac9d2e0c50cfe18affa60be26d021"
    },
    {
      "source_id": "fr81-u303-r0038",
      "target": "Повиновались. Через несколько минут пятеро были названы единодушно и вышли из рядов.",
      "source_sha256": "26302b3ef7dc37655396dd2fe197316b14d58d15b9fa09bcaaba461a6fa76a6d",
      "target_id": "ru-fr81-u303-r0038",
      "tag": "prose",
      "target_sha256": "e237b14ad21bd44e4515de14c47c25e22cbccd24c37acbbce6971f9cc1d65947"
    },
    {
      "source_id": "fr81-u303-r0039",
      "target": "— Их пятеро! — воскликнул Мариус.",
      "source_sha256": "eaff8c1b670df2598bbe3a6d32d345bb0bdb87a0f4047948969acc2f6860d273",
      "target_id": "ru-fr81-u303-r0039",
      "tag": "prose",
      "target_sha256": "7a6c3393bb0934d3dcda9e00383c9415d4d476a1de1967889186ffbc011c096f"
    },
    {
      "source_id": "fr81-u303-r0040",
      "target": "Мундиров было только четыре.",
      "source_sha256": "c454ec9d7d60cd4cb8f023711f1b9676a38bca2432bad70167fb73dc496ba0f5",
      "target_id": "ru-fr81-u303-r0040",
      "tag": "prose",
      "target_sha256": "d6c152509875bbe1f57c1010aef7e753aae578cd190326a60a0145554c5bd0f4"
    },
    {
      "source_id": "fr81-u303-r0041",
      "target": "— Ну что ж, — снова заговорили пятеро, — один должен остаться.",
      "source_sha256": "32deea8c58a8b0486620f0f71f66347c56553e535e10d1a3630a03a2c757c234",
      "target_id": "ru-fr81-u303-r0041",
      "tag": "prose",
      "target_sha256": "1ca66d1957c670f35fdc335767d3769f69155656f7624c2dfb587635b5f3ffcc"
    },
    {
      "source_id": "fr81-u303-r0042",
      "target": "И пошёл спор о том, кому остаться и кто найдёт у других доводы, чтобы не оставаться. Благородная ссора возобновилась.",
      "source_sha256": "f73c472f62541fea089ad6ea61c3d57bc54a67fb433c81e7a012adec81873ec1",
      "target_id": "ru-fr81-u303-r0042",
      "tag": "prose",
      "target_sha256": "b2fa04a6872c8be953719d5a53ebf2e65bd6a14c4c49e7e73539dd362ef35e3b"
    },
    {
      "source_id": "fr81-u303-r0043",
      "target": "— У тебя жена, которая тебя любит. — У тебя старая мать. — У тебя нет ни отца, ни матери, что станется с твоими тремя маленькими братьями? — Ты отец пятерых детей. — Ты имеешь право жить, тебе семнадцать лет, это слишком рано.",
      "source_sha256": "2a3f6370f54ee3deca51967c06d95faba0da16e8cddaef0f024e02e879726e26",
      "target_id": "ru-fr81-u303-r0043",
      "tag": "prose",
      "target_sha256": "1dfeddbd4c70d2ac61a5c06bd93f88fdf886229a78a19380a088af635dcb48c6"
    },
    {
      "source_id": "fr81-u303-r0044",
      "target": "Эти великие революционные баррикады были местом встречи героизмов. Невероятное было там простым. Эти люди не удивлялись друг другу.",
      "source_sha256": "56e38389b6d0f2ddc4426960482eb2b53ee9fc1d3e27e5238df327f142edeacf",
      "target_id": "ru-fr81-u303-r0044",
      "tag": "prose",
      "target_sha256": "fd089a1157a03d6eb877862c780772297417b2276c00d0a8acd127e5aa0bf463"
    },
    {
      "source_id": "fr81-u303-r0045",
      "target": "— Скорее, — повторял Курфейрак.",
      "source_sha256": "70128b39db9e65c184a0a65ead2812119d504323f33456270001e91be086cd17",
      "target_id": "ru-fr81-u303-r0045",
      "tag": "prose",
      "target_sha256": "a0b2bba5f2de8341b6c078ecefe3d24c9e343e3d7e18421fe48c0469246bfe0f"
    },
    {
      "source_id": "fr81-u303-r0046",
      "target": "Из групп закричали Мариусу:",
      "source_sha256": "3ccf3ff0da0706be0785c58f39486e861d265a50b4f07ec51cc17a61fdf8eb57",
      "target_id": "ru-fr81-u303-r0046",
      "tag": "prose",
      "target_sha256": "6ceb18ee01cb5019c9c42d9bc573ece5c1c1d06739dbe80b9b1a7c96ea29d852"
    },
    {
      "source_id": "fr81-u303-r0047",
      "target": "— Назовите вы того, кто должен остаться.",
      "source_sha256": "ef406837ed9b605e33c74761206571fe33ef93636de375fdda04f5c316b47b49",
      "target_id": "ru-fr81-u303-r0047",
      "tag": "prose",
      "target_sha256": "987d25ad462992cf8a50cf70579559ae84abf1f0a06f09cea8911989691b9dac"
    },
    {
      "source_id": "fr81-u303-r0048",
      "target": "— Да, — сказали пятеро, — выбирайте. Мы вам подчинимся.",
      "source_sha256": "aa08e7b094d31ac862eeb6918564c5d3008f8fdea1ecc815cc6f8c6e423ca0d3",
      "target_id": "ru-fr81-u303-r0048",
      "tag": "prose",
      "target_sha256": "56e8719916cdac8613eead77c90da875122121a1c81b4024f73a8857fe6d7dfb"
    },
    {
      "source_id": "fr81-u303-r0049",
      "target": "Мариус уже не верил в возможность волнения. Однако при мысли, что надо выбрать человека для смерти, вся его кровь прихлынула к сердцу. Он побледнел бы, если бы мог побледнеть ещё сильнее.",
      "source_sha256": "49dde17f133dee1979bd982df0faae920e0d52ce3d194c3959e1e4498c5e9c94",
      "target_id": "ru-fr81-u303-r0049",
      "tag": "prose",
      "target_sha256": "6d7de03057d2c82e7a3af015c3ff4c169eb4f211309244e75cb1a845679a33a9"
    },
    {
      "source_id": "fr81-u303-r0050",
      "target": "Он подошёл к пятерым, которые ему улыбались, и каждый, с глазами, полными того великого пламени, что виднеется в глубине истории при Фермопилах, кричал ему:",
      "source_sha256": "96346fba7f61e3e2424f66ad07f7aa03ce0a5b76e6374c9e811bfde441c1ddf0",
      "target_id": "ru-fr81-u303-r0050",
      "tag": "prose",
      "target_sha256": "139a2b7eb6e48608fb80cafc7baade0bb1f873d2d3b26ee4d337652d8b2e6374"
    },
    {
      "source_id": "fr81-u303-r0051",
      "target": "— Я! я! я!",
      "source_sha256": "245fe22843c5e3f0afb9f101598aa9586e8d99dcfa0a68885c9907802a69fdf1",
      "target_id": "ru-fr81-u303-r0051",
      "tag": "prose",
      "target_sha256": "af01a7d96b050850f4689027cf85e6a51fd00713dc75853f328218577d227e02"
    },
    {
      "source_id": "fr81-u303-r0052",
      "target": "И Мариус, тупо, пересчитал их; их по-прежнему было пятеро! Затем взгляд его опустился на четыре мундира.",
      "source_sha256": "3e3593a0d296ca8a8329c520a8001757c8a0d1788c6903d3d7de752924a93be8",
      "target_id": "ru-fr81-u303-r0052",
      "tag": "prose",
      "target_sha256": "37af0c9f5d8be574fb7c31f079fc1ae68b8d358c41b599bb3b59507be0bdc202"
    },
    {
      "source_id": "fr81-u303-r0053",
      "target": "В это мгновение пятый мундир упал, словно с неба, на четыре других.",
      "source_sha256": "b20db304fa91b3fcecb3befe66c86d31c7f0c0c0d3c98393874730f55c25485b",
      "target_id": "ru-fr81-u303-r0053",
      "tag": "prose",
      "target_sha256": "74896b32708d6a20d82c8b260212d213cc342c2dffcf012906ef5fed74fbe37e"
    },
    {
      "source_id": "fr81-u303-r0054",
      "target": "Пятый человек был спасён.",
      "source_sha256": "8727ef564cd4ac09d44a73b627df71bba6bff282a48dd80bc77b30dd614940d0",
      "target_id": "ru-fr81-u303-r0054",
      "tag": "prose",
      "target_sha256": "cf41578cbd414969687dc3fb2c0087a5c9a39839262f87989fc951c043b061de"
    },
    {
      "source_id": "fr81-u303-r0055",
      "target": "Мариус поднял глаза и узнал господина Фошлевана.",
      "source_sha256": "6ee31715f7372180f0e3ecd8c5fc402ba2d6e058f7680bf6e6b4a75bee2985cf",
      "target_id": "ru-fr81-u303-r0055",
      "tag": "prose",
      "target_sha256": "8b7cfe7c91dbbbdb484b63b49bad8151278048792a751f306f9e7911899ebb4a"
    },
    {
      "source_id": "fr81-u303-r0056",
      "target": "Жан Вальжан только что вошёл на баррикаду.",
      "source_sha256": "160ab9c8cf3e5efe07e67b61c24cbb5ed56df5bc439847714f42089c9f46455a",
      "target_id": "ru-fr81-u303-r0056",
      "tag": "prose",
      "target_sha256": "18f76698f18ce2f0c4e02b053a4130be4778b85c7fcd72f9e2546871cd5ba6f2"
    },
    {
      "source_id": "fr81-u303-r0057",
      "target": "То ли разузнав дорогу, то ли по наитию, то ли случайно, он пришёл по переулку Мондетур. Благодаря мундиру национального гвардейца он прошёл без труда.",
      "source_sha256": "add08053a91a227a35b8143d03267aba8f54ed5652052b27c5923d1a243245de",
      "target_id": "ru-fr81-u303-r0057",
      "tag": "prose",
      "target_sha256": "a242dde746cef9b4b42fad1705d519d9f7bca35038bce75c25b051fb224869cb"
    },
    {
      "source_id": "fr81-u303-r0058",
      "target": "Дозорный, поставленный повстанцами на улице Мондетур, не должен был поднимать тревогу из-за одинокого национального гвардейца. Он позволил ему войти в улицу, говоря себе: это, вероятно, подкрепление, а в худшем случае — пленный. Минута была слишком серьёзной, чтобы часовой мог отвлечься от своего долга и от своего наблюдательного поста.",
      "source_sha256": "83699614c27722ca7fabbc3cc8e6647e388a24ae751121bcc29d80fb49a9d2c3",
      "target_id": "ru-fr81-u303-r0058",
      "tag": "prose",
      "target_sha256": "27d20af7577052fc6fd9f8ceb535a60c5737ab22eb17da9bbeb28c695821fbf8"
    },
    {
      "source_id": "fr81-u303-r0059",
      "target": "Когда Жан Вальжан вошёл в редут, никто его не заметил: все глаза были прикованы к пятерым избранным и к четырём мундирам. Жан Вальжан же всё видел и слышал и молча снял с себя мундир и бросил его на груду остальных.",
      "source_sha256": "618c015ab0e70c86e88853a83cf791cde4c5151ca79f10d1c119d75cce19d71e",
      "target_id": "ru-fr81-u303-r0059",
      "tag": "prose",
      "target_sha256": "ec6841b8bb5af45c875409c7422be71505b8dc7ce0edddcd4e2c5d51d9758518"
    },
    {
      "source_id": "fr81-u303-r0060",
      "target": "Волнение было неописуемо.",
      "source_sha256": "dfe8bc3e06af583cfc5123b3e29eb93cbee5996816fa4dc9138b40f128e3dd49",
      "target_id": "ru-fr81-u303-r0060",
      "tag": "prose",
      "target_sha256": "83045a67cb5f3236ec5dd5a8f944fad6273b9ab19f4e54dfe4a5cc21ab88e39d"
    },
    {
      "source_id": "fr81-u303-r0061",
      "target": "— Кто этот человек? — спросил Боссюэ.",
      "source_sha256": "2569a462c69660d358c56a661429bd8f484b6608b0bb89061bfe6a0f782f68bc",
      "target_id": "ru-fr81-u303-r0061",
      "tag": "prose",
      "target_sha256": "51df0981d18b2f49afa05142031187fa4f5c676a30e7130cd873fdaf82e7a873"
    },
    {
      "source_id": "fr81-u303-r0062",
      "target": "— Это, — ответил Комбефер, — человек, который спасает других.",
      "source_sha256": "6932dba0a63e9d8ee8ca87935cb4723f54b04989528a19dfb4c49190d86e9444",
      "target_id": "ru-fr81-u303-r0062",
      "tag": "prose",
      "target_sha256": "91f6855132381e75c0c4038b3a6074dad4da7946677720aad2adacebc15650fd"
    },
    {
      "source_id": "fr81-u303-r0063",
      "target": "Мариус добавил серьёзным голосом:",
      "source_sha256": "faa3dea516910eb0afea83b9efc9dc41a7a40f6460a5eed02ccf99c0a541cb8f",
      "target_id": "ru-fr81-u303-r0063",
      "tag": "prose",
      "target_sha256": "5de838d5c265b3f1390db62da1aed8cb8f04bd95b04c3e0bdd584d8807a487c2"
    }
  ],
