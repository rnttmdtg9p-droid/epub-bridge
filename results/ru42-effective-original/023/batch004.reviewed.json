  "rows": [
    {
      "source_id": "fr42c-023-0080",
      "target": "— Осматриваю безбрежный горизонт.",
      "source_sha256": "7515ee43744944ab57061cae0e0ea0472094305dec33480aa8091f4089193cf5",
      "target_id": "ru-fr42c-023-0080",
      "tag": "p",
      "target_sha256": "cc6ee8d868337abfcdf1cb5fd085ba81d4ebca796742c03d0de76750d26d7d07"
    },
    {
      "source_id": "fr42c-023-0081",
      "target": "— Не могли бы вы спуститься на минутку?",
      "source_sha256": "eb9047716dd6156e485ed36cc4ec6e536bb37c8542434ff0a7f9a85911ff1c08",
      "target_id": "ru-fr42c-023-0081",
      "tag": "p",
      "target_sha256": "0c59e58cd86edf9bf9884f40b0379614c162ef631c9405a15dc5e2d4e84dd887"
    },
    {
      "source_id": "fr42c-023-0082",
      "target": "— Я вам нужен?",
      "source_sha256": "4e6228593d9d5378018f1a8949a78bc35159c7a4475f90d489426ab56dd3be2a",
      "target_id": "ru-fr42c-023-0082",
      "tag": "p",
      "target_sha256": "d52e60e522b09223f7def3c383c59afab3cab30c71bf701bf9dddbea3b201903"
    },
    {
      "source_id": "fr42c-023-0083",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-fr42c-023-0083",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "fr42c-023-0084",
      "target": "— По какому поводу?",
      "source_sha256": "fc7604cb5d4a0f4f219107a7e8ad3ee114ec0d5f8032bcfa563ede0a4bd538c8",
      "target_id": "ru-fr42c-023-0084",
      "tag": "p",
      "target_sha256": "81ca4e151a91f96b72278717d664696762d7c0f6677284f3d0f313492b0caf47"
    },
    {
      "source_id": "fr42c-023-0085",
      "target": "— Чтобы узнать, какие страны пересекает тридцать седьмая параллель.",
      "source_sha256": "23e0a01ca0424820e6ed3a8c5b4875fb01488316d5a5d1c97ff8048eb3efe185",
      "target_id": "ru-fr42c-023-0085",
      "tag": "p",
      "target_sha256": "92d7f3cbab666c1d44b1e1af28ce0637ca8fb27ed64ddc0138c866e8c1ab2f64"
    },
    {
      "source_id": "fr42c-023-0086",
      "target": "— Нет ничего проще, — ответил Паганель, — даже не стоит меня беспокоить, чтобы сказать вам это.",
      "source_sha256": "6e27d4b66e70886104dfd0a41898e77f81267d2cb9e0d67c46cc3eb58cfe1c93",
      "target_id": "ru-fr42c-023-0086",
      "tag": "p",
      "target_sha256": "07b3545787c01a6fbef3da424a793175a50c88289acdf221b36eea51f3cb7f15"
    },
    {
      "source_id": "fr42c-023-0087",
      "target": "— Ну так говорите.",
      "source_sha256": "8596e488e68d0395719f316c66e4d8edcbaef4defac88d1d33802090f8895c36",
      "target_id": "ru-fr42c-023-0087",
      "tag": "p",
      "target_sha256": "7db4c9f047a526400d753fb979c24abbcb3fbbfa2f591c6852c918e54c57c95b"
    },
    {
      "source_id": "fr42c-023-0088",
      "target": "— Извольте. Покинув Америку, тридцать седьмая южная параллель пересекает Атлантический океан.",
      "source_sha256": "706ba6df70b693386a04daa1aab75dde38e53f8c6dc8749669b564901e26a327",
      "target_id": "ru-fr42c-023-0088",
      "tag": "p",
      "target_sha256": "d2eff31dd0ba44cb8750e88ca449a4967f0483a50439fad16f510ab10dfa0735"
    },
    {
      "source_id": "fr42c-023-0089",
      "target": "— Хорошо.",
      "source_sha256": "f3d7ca7adf55afde99d5083e5807b0c8d2a66225bc62113e06bec760af0ed0df",
      "target_id": "ru-fr42c-023-0089",
      "tag": "p",
      "target_sha256": "f921c955f44e9252400074163fbbfbe4d7b1f83b6ab07d5c60690d73edb3ba97"
    },
    {
      "source_id": "fr42c-023-0090",
      "target": "— Она встречает острова Тристан-да-Кунья.",
      "source_sha256": "e192e0609d0095e83f832b262a189dae4905470e295c4ab4333e143f54f9c87e",
      "target_id": "ru-fr42c-023-0090",
      "tag": "p",
      "target_sha256": "fc1715926f053e139db802104eac10a324d66076a13fc5323be91ce07538d5f8"
    },
    {
      "source_id": "fr42c-023-0091",
      "target": "— Прекрасно.",
      "source_sha256": "4f653cbefef20261430a10b5814fa587c949acf0f66500871336d448e7b4175b",
      "target_id": "ru-fr42c-023-0091",
      "tag": "p",
      "target_sha256": "fe3361ff960acc849f8f5253a86614969f62d76ed9cab3a45774e11643890bfe"
    },
    {
      "source_id": "fr42c-023-0092",
      "target": "— Она проходит двумя градусами ниже мыса Доброй Надежды.",
      "source_sha256": "f2ba3bafdc3bf608b3ceb3054e05f5fb09531954022ba5b2ed83352473047e66",
      "target_id": "ru-fr42c-023-0092",
      "tag": "p",
      "target_sha256": "6c6384521d17ff40265b9932ba4f3dd1814c5d3abb3590a3914316529e4362f7"
    },
    {
      "source_id": "fr42c-023-0093",
      "target": "— Дальше?",
      "source_sha256": "a97f95ace0263b737b62a1340b89d88e54aa651167918516cceedcc6e30f38ac",
      "target_id": "ru-fr42c-023-0093",
      "tag": "p",
      "target_sha256": "e214265e20a7a3a9d0657f5c426a8f131b71220f388b58c8b4c23d48b26df1d3"
    },
    {
      "source_id": "fr42c-023-0094",
      "target": "— Она бежит через Индийское море.",
      "source_sha256": "010c1f200066fa79e3098b066e1112def404abcefb2ea14e001f7d118380f57f",
      "target_id": "ru-fr42c-023-0094",
      "tag": "p",
      "target_sha256": "9d405f15f935bae00eba408ab85242ef6087a4855c59ae67efbcf7ad2a857161"
    },
    {
      "source_id": "fr42c-023-0095",
      "target": "— Потом?",
      "source_sha256": "030543b9e2490ebbad30c1649314b885954ec87caae11feb0d5925624e0cd451",
      "target_id": "ru-fr42c-023-0095",
      "tag": "p",
      "target_sha256": "de8702db9bffa2557aeb6b96937627539cc675fb1b0208764ab2d2c405c36722"
    },
    {
      "source_id": "fr42c-023-0096",
      "target": "— Она едва касается острова Сен-Пьер из группы островов Амстердам.",
      "source_sha256": "6981434f5b6f0343a9ffc151e339d9baa9499277d7cce983319cbe0a4657730a",
      "target_id": "ru-fr42c-023-0096",
      "tag": "p",
      "target_sha256": "b90df9dbd347c4deb229e7324ec47a5945c0edcf1a9a30bb9a36588706a79325"
    },
    {
      "source_id": "fr42c-023-0097",
      "target": "— Продолжайте.",
      "source_sha256": "4ebb7cf8de18174d08b16a6e910ddbc42827f025d5ccdcac951fcdb009fddfc7",
      "target_id": "ru-fr42c-023-0097",
      "tag": "p",
      "target_sha256": "fa36b1726b1cd98273cd537f4d240ee37ae6c69cbd12a726e5ec17da0eb5fdae"
    },
    {
      "source_id": "fr42c-023-0098",
      "target": "— Она рассекает Австралию по провинции Виктория.",
      "source_sha256": "9c05f3d6e7a3a8ed4d1fb7a08b17479287b56916d59914b8374629c7ea3c6824",
      "target_id": "ru-fr42c-023-0098",
      "tag": "p",
      "target_sha256": "9becb89f3d8a5a82b307f48cd35a2bc89b3a9d1fb9f463f106c3d119860226d0"
    },
    {
      "source_id": "fr42c-023-0099",
      "target": "— Продолжайте.",
      "source_sha256": "6131ab901f66205a970087a3549119c33d17d0647b1d2a0ba4c18d7fcc2d1b85",
      "target_id": "ru-fr42c-023-0099",
      "tag": "p",
      "target_sha256": "fa36b1726b1cd98273cd537f4d240ee37ae6c69cbd12a726e5ec17da0eb5fdae"
