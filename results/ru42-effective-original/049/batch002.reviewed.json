{
  "unit": 49,
  "batch": 2,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "fr42c-049-0039",
      "target": "— Пятьдесят фунтов.»",
      "source_sha256": "d5b40f3647232be32b950f8f75764cce897ae513132c0134f916b4ef19fd841d",
      "target_id": "ru-fr42c-049-0039",
      "tag": "p",
      "target_sha256": "2307c7fb9efe451fbeeddf996be3cb3e8a1c35dc202e805f195a9b6d5177bfd6"
    },
    {
      "source_id": "fr42c-049-0040",
      "target": "Гленарван кивнул в знак согласия.",
      "source_sha256": "4e20521dce3c390cdcd5bfe7b4ba9494004032e63cd04b48f5821136e29b147c",
      "target_id": "ru-fr42c-049-0040",
      "tag": "p",
      "target_sha256": "4584e1184f1f0afaf76c992b32ca57b21b015ec12d603d12982cc49e032c8b20"
    },
    {
      "source_id": "fr42c-049-0041",
      "target": "«Хорошо! Пятьдесят фунтов, — ответил Джон Манглс.",
      "source_sha256": "93877e1de0658bbb5973d9e6ac5a1669754dc9af290cf7a023f6b9dea1de32f2",
      "target_id": "ru-fr42c-049-0041",
      "tag": "p",
      "target_sha256": "d95420b3c029e518a025aecfc9b90d1026206fde33b5f148d6e78823e7063c3e"
    },
    {
      "source_id": "fr42c-049-0042",
      "target": "— Но с голым переходом, — добавил Уилл Хэлли.",
      "source_sha256": "7a4bfd3591fb1aad5d0965b9221a36fd5ac1f1cbbfbc0640a7f86df8fa79d02d",
      "target_id": "ru-fr42c-049-0042",
      "tag": "p",
      "target_sha256": "57f0ca785101e2ae0b6b7433248ab79a1ababa53827f195070c9adbf8eeaf330"
    },
    {
      "source_id": "fr42c-049-0043",
      "target": "— С голым переходом.",
      "source_sha256": "1a58fd3e8f98ad3a7962e98a80e1058ec05ce7377730b3321283d116e4610934",
      "target_id": "ru-fr42c-049-0043",
      "tag": "p",
      "target_sha256": "7567b67e4dc7314e9534b9b643a64c95a126793a3ff63aaae245cd23a72394f6"
    },
    {
      "source_id": "fr42c-049-0044",
      "target": "— Харчи отдельно.",
      "source_sha256": "26d5590100330165266b4ef0e554a04b62fccdb659c44753fd7e3934a1099d91",
      "target_id": "ru-fr42c-049-0044",
      "tag": "p",
      "target_sha256": "82da8c719504a902f53df958d2d2d711f73c177f54584fe1c92c6054c53c342a"
    },
    {
      "source_id": "fr42c-049-0045",
      "target": "— Отдельно.",
      "source_sha256": "af07714c819cddd23d83454869a98d3590c9a780901d476ad08fb1cd385fc901",
      "target_id": "ru-fr42c-049-0045",
      "tag": "p",
      "target_sha256": "6a1304cd625102bea1b8efdb633691d4290856a5b70193202f712ac832239654"
    },
    {
      "source_id": "fr42c-049-0046",
      "target": "— Согласен. А дальше? — сказал Уилл, протягивая руку.",
      "source_sha256": "aec09734d83590c199e6dce57bba4538bc1015513194a6fa41fe82df4c16c9dd",
      "target_id": "ru-fr42c-049-0046",
      "tag": "p",
      "target_sha256": "0f71387780330986c3fb10da53f2616b63302320dc9427ea351eadb0d0cebe24"
    },
    {
      "source_id": "fr42c-049-0047",
      "target": "— Что?",
      "source_sha256": "6f4905b437b6948a18583e0d14b52d7f2dd428bf5712d1870e5426b63921de17",
      "target_id": "ru-fr42c-049-0047",
      "tag": "p",
      "target_sha256": "517f3ff122eb546ca36332ec960df6083fe4c7e2f428e22ee5ca0183ce22e859"
    },
    {
      "source_id": "fr42c-049-0048",
      "target": "— Задаток?",
      "source_sha256": "474b85eba25a2eead4cbb32bebe239aa73b46cab1d3632aa78d6602006f7a103",
      "target_id": "ru-fr42c-049-0048",
      "tag": "p",
      "target_sha256": "88e99430ede7bda5689353533df8f47559819eaa4eb82868aee09d9975d185d2"
    },
    {
      "source_id": "fr42c-049-0049",
      "target": "— Вот половина платы, двадцать пять фунтов, — сказал Джон Манглс, отсчитывая деньги шкиперу, который сунул их в карман, не сказав спасибо.",
      "source_sha256": "47f611c3dc2873a5e33177091372b45fe1f88ee687f81750e51128234d30cb7c",
      "target_id": "ru-fr42c-049-0049",
      "tag": "p",
      "target_sha256": "9b2bac56aab51364d0a659b7a4c77fdedd023179b33772020046c0463084b34f"
    },
    {
      "source_id": "fr42c-049-0050",
      "target": "— Завтра на борту, — сказал он. — До полудня. Будете вы там или нет, я снимаюсь с якоря.",
      "source_sha256": "be5130dbdf51de2a7dab7b9063fad407b1adc8171eaddceae5b31a15c8c71533",
      "target_id": "ru-fr42c-049-0050",
      "tag": "p",
      "target_sha256": "e244c8b9db11b5cb2af2048972a3392e59fb90c74429af7d1ad0da88f3f3ca28"
    },
    {
      "source_id": "fr42c-049-0051",
      "target": "— Будем.»",
      "source_sha256": "1419f74f064194f03a6c8df91008e19a1c6b4328c34404eba422854c270ea073",
      "target_id": "ru-fr42c-049-0051",
      "tag": "p",
      "target_sha256": "9fc3e26954266eb722c1bb788df9e29249cf6244ab65700a92719e225d5c431e"
    },
    {
      "source_id": "fr42c-049-0052",
      "target": "Получив этот ответ, Гленарван, майор, Роберт, Паганель и Джон Манглс покинули судно, а Уилл Хэлли так и не дотронулся пальцем до зюйдвестки[[FN:85]], нахлобученной на его рыжие вихры.",
      "source_sha256": "abdc1862a3c93d096d05d0846e95bdc4d6753d61d7b5c9e1bc5a9bfd3b5dac20",
      "target_id": "ru-fr42c-049-0052",
      "tag": "p",
      "target_sha256": "e095bb35cad8ce3fba023da6905b80adc08b857d13d9e8c0a3665949639c092e"
    },
    {
      "source_id": "fr42c-049-0053",
      "target": "Это был бриг по имени «<i>Маккуори</i>». (Стр. 436.)",
      "source_sha256": "7b92114c61199d128a46db3d8e88c11598797740507e89b0af7c65fda0d46b8c",
      "target_id": "ru-fr42c-049-0053",
      "tag": "figcaption",
      "target_sha256": "872786b486812410fe6969844695e63b92c175ef42617f037c3674ba6e723266"
    },
    {
      "source_id": "fr42c-049-0055",
      "target": "«Какой дикарь! — сказал Джон.",
      "source_sha256": "120ca4f9493593bc0417def927814ddc223cae3a3a56cbfa38c7948c0310648e",
      "target_id": "ru-fr42c-049-0055",
      "tag": "p",
      "target_sha256": "c0047444d473884444c2169e0dcf70b1b36f4aed476d8cc77a4a33f14ad29828"
    },
    {
      "source_id": "fr42c-049-0056",
      "target": "— А по мне, так он подходит, — ответил Паганель. — Настоящий морской волк.",
      "source_sha256": "1d3143a5cb51372fe128f07bcea729d4c6a0e93ec7a493a982c17e842b84b17a",
      "target_id": "ru-fr42c-049-0056",
      "tag": "p",
      "target_sha256": "63427b3d1247c8637f4bd8d186439c567bf0fcd13322203be9bbacdb46643709"
    },
    {
      "source_id": "fr42c-049-0057",
      "target": "— Настоящий медведь! — возразил майор.",
      "source_sha256": "441e0be2490ff1afd0d0cbfe224da4b3f62085753578efc5a2ee18544924b3bf",
      "target_id": "ru-fr42c-049-0057",
      "tag": "p",
      "target_sha256": "fe33a38d88d4b2af2333e5b7db185535edbc82539b81a7b695911464f6fdbe82"
    },
    {
      "source_id": "fr42c-049-0058",
      "target": "— И, думаю, — добавил Джон Манглс, — этот медведь когда-то, должно быть, торговал живым товаром.",
      "source_sha256": "b4153b61389237d1a37d9fd2af7fc7c0c08c44fd6e9f1e47fdaded8a5890aa0f",
      "target_id": "ru-fr42c-049-0058",
      "tag": "p",
      "target_sha256": "1762c1eebb5ccb40c5bc08d8d5361cc693081a945724406b0a818003b4bd44ed"
    },
    {
      "source_id": "fr42c-049-0059",
      "target": "— Не всё ли равно! — ответил Гленарван. — Раз он командует «<i>Маккуори</i>», а «<i>Маккуори</i>» идёт в Новую Зеландию. От Туфолд-бея до Окленда мы будем видеть его мало; после Окленда не увидим вовсе.»",
      "source_sha256": "49ef4a445ee59ed6cbb9bf4232ed674c97bdc8c872c30f2685517480737c21e5",
      "target_id": "ru-fr42c-049-0059",
      "tag": "p",
      "target_sha256": "d42f917a6bfd7d658c69fc0e3de2870f2a78ac3c59cae66719b68d458d10e6c4"
    }
  ],
