    },
    {
      "source_id": "fr42c-049-0035",
      "target": "— Надо посмотреть, — ответил хозяин «<i>Макквори</i>».",
      "source_sha256": "93bdb3f425f93e918c27276693314be530d7b442d98115cbb4166c29f0c94367",
      "target_id": "ru-fr42c-049-0035",
