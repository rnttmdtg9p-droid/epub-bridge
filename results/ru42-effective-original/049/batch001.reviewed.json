      "target_sha256": "d7079c5b2b92aaf39c0d99fa5bbd7ed1f908617473088781eef7acf8807813a3"
    },
    {
      "source_id": "fr42c-049-0029",
      "target": "— Да. Сколько их?",
      "source_sha256": "442abf9537233f9001a6a6b00009d4e18aba1cf28f39cc389d415105872c85ab",
      "target_id": "ru-fr42c-049-0029",
      "tag": "p",
      "target_sha256": "563e6651bc2876a1a39a5b8e8d09efa4b2405687d49a8dce492bc57af966ea78"
    },
    {
      "source_id": "fr42c-049-0030",
      "target": "— Девять, из них две дамы.",
