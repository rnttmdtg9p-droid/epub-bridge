      "target_id": "ru-fr42c-049-0031",
      "tag": "p",
      "target_sha256": "f980574573c093c12e93de90025c7b07449aa73f48fbcbf8f8c0d63b74cb5234"
    },
    {
      "source_id": "fr42c-049-0032",
      "target": "— Мы как-нибудь устроимся в рубке, которую предоставят в их распоряжение.",
      "source_sha256": "b7f20ff6584c0a25c66a53a930db2b6cd9be9c26afa5bf4bad6d7341dc3c926f",
      "target_id": "ru-fr42c-049-0032",
      "tag": "p",
      "target_sha256": "b30eeab361d3726697bac3ce6ced401817c450d24d9f8ebccad5212aeb625303"
    },
    {
      "source_id": "fr42c-049-0033",
      "target": "— Дальше что?",
      "source_sha256": "a97f95ace0263b737b62a1340b89d88e54aa651167918516cceedcc6e30f38ac",
