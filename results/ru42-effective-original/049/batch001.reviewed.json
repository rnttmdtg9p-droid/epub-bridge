    },
    {
      "source_id": "fr42c-049-0020",
      "target": "— Что он везёт?",
      "source_sha256": "47cb145bd55c1fe9b01d98949b927cb729520eba5a1559cf0a84e79560f3f0d3",
      "target_id": "ru-fr42c-049-0020",
