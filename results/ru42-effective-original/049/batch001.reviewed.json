    },
    {
      "source_id": "fr42c-049-0022",
      "target": "— Когда он отправляется?",
      "source_sha256": "11154ac8c903b6ac7fc16e4e91cdb7f93a980866020f82f1d0deb41c424e3b20",
      "target_id": "ru-fr42c-049-0022",
      "tag": "p",
      "target_sha256": "f431be087cdab42e55079b74905e42cbcd298d3adf55137113df8eaddea517a5"
    },
    {
      "source_id": "fr42c-049-0023",
      "target": "— Завтра, с полуденным приливом. Дальше что?",
      "source_sha256": "efbb8b672d4a76f8f197a1646e3739d0678f097841d8f7f0ea3a9a611c7521e6",
      "target_id": "ru-fr42c-049-0023",
      "tag": "p",
      "target_sha256": "2b4cb9c95849f6bff18c4d50c12221ddbb678c8e6b9fdb845c74a34a4ed951f2"
    },
    {
      "source_id": "fr42c-049-0024",
      "target": "— Возьмёт ли он пассажиров?",
      "source_sha256": "193743371b435183917540ce0856edcae0b308649b332be96d858cd5efcc5907",
      "target_id": "ru-fr42c-049-0024",
      "tag": "p",
      "target_sha256": "e2f48d57bf6b81cd7cf20c6336377d3573cf90b25e9311230c2cc5375a02b0a7"
    },
    {
      "source_id": "fr42c-049-0025",
      "target": "— Смотря какие пассажиры и смирятся ли они с судовой похлёбкой.",
      "source_sha256": "47f166d37f05b8b642d4d8e1bd67e66529356854c34898d13fa68ed82e33498a",
      "target_id": "ru-fr42c-049-0025",
      "tag": "p",
      "target_sha256": "beca5da522875977d50e58f6d7e36944c37d5d1ab3c162689519a73f12ec977d"
    },
    {
      "source_id": "fr42c-049-0026",
      "target": "— Они привезут свои припасы.",
      "source_sha256": "8bdb49255e7646659a932e28e4a19a33126f95ee0365c541b04fe912b30e91ae",
      "target_id": "ru-fr42c-049-0026",
      "tag": "p",
      "target_sha256": "2ca4277e58feae0d59150ca53a9cc9befe706139af725e2ecf51481b80059abe"
    },
    {
      "source_id": "fr42c-049-0027",
