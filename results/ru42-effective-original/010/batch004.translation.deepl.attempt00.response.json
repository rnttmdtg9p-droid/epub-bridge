{
  "translations": [
    {
      "text": "<p>Леди Хелена, стоя на кормовой рубке, в последний раз воскликнула:\n</p>",
      "detected_source_language": "FR",
      "model_type_used": "quality_optimized",
      "tag_handling_version": "v2"
