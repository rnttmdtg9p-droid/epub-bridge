      "target_sha256": "e8dbfe18b8b60dfc3f76c1138e262eb8d69cdd834774b8fc34ccf204565f8131"
    },
    {
      "source_id": "ru77-art-caption-31-393",
      "target": "«Перед дворянином он был раболепен»",
      "source_sha256": "c20112b73ef3ee35f45f4547846eb0937f70c31cd327d8c23c31444b004322e6",
      "target_id": "ru-ru77-art-caption-31-393",
      "tag": "figcaption",
      "target_sha256": "e8519ba9038c2a5536f77b52a6ffa65c5799c4991f65fcdfdb400051b97610a1"
    },
    {
      "source_id": "ru77-art-caption-31-403",
      "target": "«ВСКОРЕ МЫ НАТКНУЛИСЬ НА ПРОИСШЕСТВИЕ.»",
      "source_sha256": "86fc0fa697eb612c5a7ff2d2981e92e9ac5e25bd81b962d24516bea865e9ab9b",
      "target_id": "ru-ru77-art-caption-31-403",
      "tag": "figcaption",
      "target_sha256": "11f9552157ca101a5a9e6d0bc86fbf8543131b23e099e7c8a2fdcd13b9f788c0"
    },
    {
      "source_id": "ru77-art-caption-32-405",
      "target": "Ног под собой не чуя. Она так гордилась",
      "source_sha256": "10fe65ca5793e82790c8e6f7c73e558c464c5d1eca35c44dcfd03acfe60d6023",
      "target_id": "ru-ru77-art-caption-32-405",
      "tag": "figcaption",
      "target_sha256": "790d85fea79f306dccfed4eaaeb3e259a1d97a5b42ee984fd0779811539f942a"
    },
    {
      "source_id": "ru77-art-caption-33-425",
      "target": "ЭВОЛЮЦИЯ.",
      "source_sha256": "9f490f9b6979e2ab8119814f3a5c7b781b79ecc49bd1231468a0086a24e6b4a2",
      "target_id": "ru-ru77-art-caption-33-425",
      "tag": "figcaption",
      "target_sha256": "ddadb0a74ba1d8dc8c6a416f9e6d87310719695eb59100af511d28e9700c8c33"
    },
    {
      "source_id": "ru77-art-caption-33-429",
      "target": "РАЗНИЦА В НОСАХ НИЧЕГО НЕ МЕНЯЕТ.",
      "source_sha256": "80009c59682286041beaa79d23f46f1f37123e90dc3a223471d1c894b6f25879",
      "target_id": "ru-ru77-art-caption-33-429",
      "tag": "figcaption",
      "target_sha256": "13686a8d27a6521eece2e7985dd30a937efb4ce484bf9eb4ea985d61cfb775c5"
    },
    {
      "source_id": "ru77-art-caption-34-435",
      "target": "Милорд граф Грип",
      "source_sha256": "5f56135977f2d61128991da745be14dba82ece8c185485c54a4443d0ce916f25",
      "target_id": "ru-ru77-art-caption-34-435",
      "tag": "figcaption",
      "target_sha256": "5327c03901071a42dee5e696f8ee771435d9ed4239f6896452f4a0574b2da505"
    },
    {
      "source_id": "ru77-art-caption-34-440",
      "target": "«ЕМУ ТАК И ХОТЕЛОСЬ ДРАКИ.»",
      "source_sha256": "95af44c206cf3e35faa593215fe5f9ce7f275130d443383d7cbf9309648f9308",
      "target_id": "ru-ru77-art-caption-34-440",
      "tag": "figcaption",
      "target_sha256": "a6ed64732f721708e6a6c7cc93df41b8cdda1aa3962f9c5900027f285156b3c8"
    },
    {
      "source_id": "ru77-art-caption-34-443",
      "target": "«ДА, ГОСУДАРЬ, БОЮСЬ, ИМЕННО ТАК ОНО И ЕСТЬ.»",
      "source_sha256": "5267da491f0d13e6ab893b1dc3973951164b03a1ace9904f68cf5f19eeccab57",
      "target_id": "ru-ru77-art-caption-34-443",
      "tag": "figcaption",
      "target_sha256": "872c06b8a00c0fe08a19d83f139466db7c8ae928707102be48eb70368d6fd76c"
    },
    {
      "source_id": "ru77-art-caption-34-447",
      "target": "ОРАТОР.",
      "source_sha256": "baba94967ee1a6f2fad0daa2e4995d9fa7cbd568ed929ae3d9ed545bc61d36fa",
      "target_id": "ru-ru77-art-caption-34-447",
      "tag": "figcaption",
      "target_sha256": "af9e3bf3c3307d94df55a7ebe586a16a314fcfcb5a92a4951928d088598bdf91"
    },
    {
      "source_id": "ru77-art-caption-34-450",
      "target": "«МЫ СОСТАВЛЯЛИ ХВОСТ ЕГО ПРОЦЕССИИ.»",
      "source_sha256": "a129d1a7fb4e0cacb2824ef95d5f863761e50a34745263b5126b45909ab0d7f6",
      "target_id": "ru-ru77-art-caption-34-450",
      "tag": "figcaption",
