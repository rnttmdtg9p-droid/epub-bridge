      "tag": "figcaption",
      "target_sha256": "a1f3b45b49f333cae11a1709f9dfa945ce2a19dc69aa24a0cbf512a9b8afe127"
    },
    {
      "source_id": "ru77-art-caption-30-389",
      "target": "«ДЕРЕВО ПОЗНАЁТСЯ ПО ПЛОДАМ ЕГО.»",
      "source_sha256": "754a40dda8d92f1f451d6a158a79eae55c5db58f77018cc5a3aaf742bf0d55dc",
      "target_id": "ru-ru77-art-caption-30-389",
