    },
    {
      "source_id": "ru77-art-caption-29-367",
      "target": "ТЕПЕРЬ ОН БЫЛ ВЕЛИК",
      "source_sha256": "f678cdaa10d9340045a38989152de4608d74a7f6ac824be460f47fe777b4aeb7",
      "target_id": "ru-ru77-art-caption-29-367",
      "tag": "figcaption",
      "target_sha256": "513767876c9916a644f93073699755169e3ee347a89d394e82010a9e41dc2ef9"
    },
    {
      "source_id": "ru77-art-caption-30-377",
      "target": "Дерево и плод",
      "source_sha256": "566563145c78726fbee815629e90b7d4bf798bf4b41d20e231875da722d4dd74",
      "target_id": "ru-ru77-art-caption-30-377",
