{
  "unit": 55,
  "batch": 0,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "ru77-u055-heading",
      "target": "ВНУТРЕННИЙ ТРАНСПОРТНЫЙ ПАКЕТ ПОДПИСЕЙ К ИЛЛЮСТРАЦИЯМ BATCH004 — ИСКЛЮЧИТЬ ИЗ СОДЕРЖАНИЯ ДЛЯ ЧИТАТЕЛЯ",
      "source_sha256": "1d2c1da2c18433de95e695b0d04d63ad3e95c0bdd68d7e632c124dfbf9adb653",
      "target_id": "ru-ru77-u055-heading",
      "tag": "heading",
      "target_sha256": "4c5db3f199be2074033eed434bb0934a98ead3875cc2d38b2318541d73f9ba58"
    },
    {
      "source_id": "ru77-art-caption-19-233",
      "target": "«ТОГДА СЭР МАРХАУС ПОБЕЖАЛ К ГЕРЦОГУ И ПОРАЗИЛ ЕГО КОПЬЁМ.»",
      "source_sha256": "e70b9ecee74787769cfc3eec9f18c4f1e583c9def21cac2733c5798f89552209",
      "target_id": "ru-ru77-art-caption-19-233",
      "tag": "figcaption",
      "target_sha256": "af6a21111f71fe479b0f0a4f072b05fc989b38423ea190a1829c67356427bb97"
    },
    {
      "source_id": "ru77-art-caption-20-237",
      "target": "Самая хлопотная старая Свинья изо всего стада",
      "source_sha256": "1ebad3632a782d599fa40a24f6d887c4fc7d939e724752f4b2e8eb7ee99bbc0b",
      "target_id": "ru-ru77-art-caption-20-237",
      "tag": "figcaption",
      "target_sha256": "f368c15bb5be62734a7c23c1835ae27a6c1aff3331dd02be9ad34e05d9392a0e"
    },
    {
      "source_id": "ru77-art-caption-20-246",
      "target": "«МЫ ПРИГНАЛИ СВИНЕЙ ДОМОЙ.»",
      "source_sha256": "3e6ef4b5aaa589fc4021e3085b9fd6cbd7837bdb81eb9d338c2e56c3272e0146",
      "target_id": "ru-ru77-art-caption-20-246",
      "tag": "figcaption",
      "target_sha256": "e27fe734f0af6f9ee3ae4c971043ae30a13e13e87ce4a5af0e0726a8e9b4c654"
    },
    {
      "source_id": "ru77-art-caption-21-249",
      "target": "«СИЛА ВОСПИТАНИЯ, ВЛИЯНИЯ, ОБРАЗОВАНИЯ; ОНА МОЖЕТ ВЫРАСТИТЬ ЧЕЛОВЕКА ТАК, ЧТО ОН ПОВЕРИТ ВО ЧТО УГОДНО.»",
      "source_sha256": "c4fadfc176620085b8d7df5d1ee06da50dfe1b9779b871b5102d06eb9abd2b39",
      "target_id": "ru-ru77-art-caption-21-249",
      "tag": "figcaption",
      "target_sha256": "7184a9c8e188e5af6aa61af3702283dd88e94ed17aaaaca14754d598c7f698b6"
    },
    {
      "source_id": "ru77-art-caption-21-253",
      "target": "СЭНДИ И БОСС ЗА ВТОРЫМ СТОЛОМ.",
      "source_sha256": "3a8ab63dc342a8fc171ba52df6f0a584c2fede9d09d3086041bab0a109b510a9",
      "target_id": "ru-ru77-art-caption-21-253",
      "tag": "figcaption",
      "target_sha256": "809d8bfc7eb4a346caf1d690855d8faa23137cbae2fcbf6bbc0ddbddd84698e0"
    },
    {
      "source_id": "ru77-art-caption-21-257",
      "target": "«В НЁМ БЫЛ ПРЕДСТАВЛЕН ОБРАЗЕЦ ПОЧТИ ВСЕХ ВЫСШИХ ЗАНЯТИЙ И ПРОФЕССИЙ.»",
      "source_sha256": "bf6345849e4e5942bfddb75dfb65ed9b4745393c71afdbd412ddf7dfa296fce1",
      "target_id": "ru-ru77-art-caption-21-257",
      "tag": "figcaption",
      "target_sha256": "e4bd945dbf83d21c24786bbc347026a840012e382098cf817f7a142ede9cb535"
    },
    {
      "source_id": "ru77-art-caption-22-275",
      "target": "«НА ДВЕНАДЦАТОМ ПОВТОРЕНИИ ОНИ РАЗВАЛИЛИСЬ НА КУСКИ.»",
      "source_sha256": "c798cca9cbed99ffdad3a9b82b1c4d26200f23cca8ff32ec3969937ee96b7020",
      "target_id": "ru-ru77-art-caption-22-275",
      "tag": "figcaption",
      "target_sha256": "e3ecb92aafd6d66fface0b172e2c43a510bf1bd63fabbd9d8da902c9a249a4e0"
    },
    {
      "source_id": "ru77-art-caption-23-283",
      "target": "«Повелеваю лютому Духу, что владеет Святым Источником, ныне извергнуть в небеса все адские огни, какие ещё остаются в нём!»",
      "source_sha256": "56f6ecf11545de55f918a766a7b8a6f866bc11e4fa8be24add058efcd5489e2b",
      "target_id": "ru-ru77-art-caption-23-283",
      "tag": "figcaption",
      "target_sha256": "010dbe2c73bf42daea0bdb499148356fa1adb4af61a1358edfafffffdff6b61b"
    },
    {
      "source_id": "ru77-art-caption-23-293",
      "target": "«БГВДЖДЖИЛЛИГКК!!»",
      "source_sha256": "274ebcb51c688ec0f4b9b4d50a7b5073332255ede030e9d154891dbc42da3212",
      "target_id": "ru-ru77-art-caption-23-293",
      "tag": "figcaption",
      "target_sha256": "7fed2886ce85f557031de4c0d6ed39dd8a99494d30213863ed1c166de2ebb980"
    },
    {
      "source_id": "ru77-art-caption-24-297",
      "target": "«Как, бишь, это у вас называется?—Остолопы.»",
      "source_sha256": "96256090b0d1bdf1c661bb1bf3563337aab341e555b01622e7c095f8d617c71c",
      "target_id": "ru-ru77-art-caption-24-297",
      "tag": "figcaption",
      "target_sha256": "fa5b0660db82f214c973575ce3ac86ed4c2e551bf3ec10f7c51e248233d49cfa"
    },
    {
      "source_id": "ru77-art-caption-24-302",
      "target": "«СЭНДИ ИЗНЕМОГЛА ОТ УХОДА ЗА БОЛЬНЫМ.»",
      "source_sha256": "2319c32fe9079f1523b27460e6f84a9822cd0a9245f8476339d67f78f51f89f2",
      "target_id": "ru-ru77-art-caption-24-302",
      "tag": "figcaption",
      "target_sha256": "2fe6d087c2a7ed646d99403c1f01fca41d7510b971b6e462e0ad786b9c4d8ce6"
    },
    {
      "source_id": "ru77-art-caption-24-310",
      "target": "ЛЖЕПРОРОК ИДЁТ НА ВСТРЕЧУ С КОРОЛЁМ.",
      "source_sha256": "03b6efbcc5ffec45aaee8383a170d420888d7972d7c4feb2c997b24115cd590e",
      "target_id": "ru-ru77-art-caption-24-310",
      "tag": "figcaption",
      "target_sha256": "4f8d97827381edc8fb8ce63ff191c82f1ed6b24618e68e012c7a09e0185e4d0c"
    },
    {
      "source_id": "ru77-art-caption-25-313",
      "target": "«Воистину, трудности я здесь вижу мало! дело сие по простоте своей есть даже детская забава.»",
      "source_sha256": "241202d6a78733797c47c26ffcce0f85f9bcd6c10d4b6dd9b7f11863e54f2cb5",
      "target_id": "ru-ru77-art-caption-25-313",
      "tag": "figcaption",
      "target_sha256": "1faffc6c77e24d3581a7898560954635d41989d45bc577bdee071c90d8c77a42"
    },
    {
      "source_id": "ru77-art-caption-25-319",
      "target": "«СЛЕДУЮЩИЙ!»",
      "source_sha256": "918bcc4448bb6a8623f237fbea2d054a0490b3c7ff01559e6a93ec7e2dfa5fdd",
      "target_id": "ru-ru77-art-caption-25-319",
      "tag": "figcaption",
      "target_sha256": "e79e9f851cae07ebb599fa651a17bc5a8cd7722f8f34aa5fc6f25135c32177ff"
    },
    {
      "source_id": "ru77-art-caption-25-322",
      "target": "«НИ СЛОВА ИЗ ВСЕГО ЭТОГО ЭТИ СОМЫ НЕ МОГЛИ ВЗЯТЬ В ТОЛК — НИ ГОЛОВЫ, НИ ХВОСТА.»",
      "source_sha256": "4842b32a4c2494ac29ee6d3a31399fa28868895ebc1e0a4503157ba80bce7179",
      "target_id": "ru-ru77-art-caption-25-322",
      "tag": "figcaption",
      "target_sha256": "d59c2c7e049952e2f3c636e0fcb7a142a7c2d3a6cce3095c663a9a53cdeec5d4"
    }
  ],
