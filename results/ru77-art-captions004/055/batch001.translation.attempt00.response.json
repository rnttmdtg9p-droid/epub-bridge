      "text": "{\"rows\":[{\"source_id\":\"ru77-art-caption-25-326\",\"target\":\"УКРАШЕНИЯ АРИСТОКРАТИИ ШЕСТОГО ВЕКА.\"},{\"source_id\":\"ru77-art-caption-26-331\",\"target\":\"Последнее извержение всего два цента\"},{\"source_id\":\"ru77-art-caption-26-334\",\"target\":\"«ГДЕ ЛАНСЕЛОТ, ТАМ ОНА НЕ ЗАМЕЧАЕТ ВЫХОДА КОРОЛЯ.»\"},{\"source_id\":\"ru77-art-caption-27-345\",\"target\":\"ЦИРЮЛЬНИК ЕГО ВЕЛИЧЕСТВА КОРОЛЯ\"},{\"source_id\":\"ru77-art-caption-27-351\",\"target\":\"«ПОЧЕМУ ВЫ НЕ ПРЕДУПРЕДИТЕ МЕНЯ, ЧТОБЫ Я ПРЕКРАТИЛ?»\"},{\"source_id\":\"ru77-art-caption-27-356\",\"target\":\"ЕЩЁ ОДНО ЧУДО.\"},{\"source_id\":\"ru77-art-caption-28-359\",\"target\":\"Дух, что идёт с бременами, не имеющими чести\"},{\"source_id\":\"ru77-art-caption-28-363\",\"target\":\"«БРАТ! — ТАКОЙ ГРЯЗИ?»\\n«БРАТ! — ТАКОЙ ГРЯЗИ?»\\n«БРАТ! — ТАКОЙ ГРЯЗИ?»\"},{\"source_id\":\"ru77-art-caption-29-367\",\"target\":\"ТЕПЕРЬ ОН БЫЛ ВЕЛИК\"},{\"source_id\":\"ru77-art-caption-30-377\",\"target\":\"Дерево и плод\"},{\"source_id\":\"ru77-art-caption-30-382\",\"target\":\"ОГОНЬ.\"},{\"source_id\":\"ru77-art-caption-30-389\",\"target\":\"«ДЕРЕВО ПОЗНАЁТСЯ ПО ПЛОДАМ ЕГО.»\"},{\"source_id\":\"ru77-art-caption-31-393\",\"target\":\"«Перед дворянином он был раболепен»\"},{\"source_id\":\"ru77-art-caption-31-403\",\"target\":\"«ВСКОРЕ МЫ НАТКНУЛИСЬ НА ПРОИСШЕСТВИЕ.»\"},{\"source_id\":\"ru77-art-caption-32-405\",\"target\":\"Ног под собой не чуя. Она так гордилась\"},{\"source_id\":\"ru77-art-caption-33-425\",\"target\":\"ЭВОЛЮЦИЯ.\"}]}"
    }
