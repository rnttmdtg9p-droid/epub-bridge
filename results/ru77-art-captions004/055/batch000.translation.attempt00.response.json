      "text": "{\"rows\":[{\"source_id\":\"ru77-u055-heading\",\"target\":\"ВНУТРЕННИЙ ТРАНСПОРТНЫЙ ПАКЕТ ПОДПИСЕЙ К ИЛЛЮСТРАЦИЯМ BATCH004 — ИСКЛЮЧИТЬ ИЗ СОДЕРЖАНИЯ ДЛЯ ЧИТАТЕЛЯ\"},{\"source_id\":\"ru77-art-caption-19-233\",\"target\":\"«ТОГДА СЭР МАРХАУС ПОБЕЖАЛ К ГЕРЦОГУ И ПОРАЗИЛ ЕГО КОПЬЁМ.»\"},{\"source_id\":\"ru77-art-caption-20-237\",\"target\":\"Самая хлопотная старая Свинья изо всего стада\"},{\"source_id\":\"ru77-art-caption-20-246\",\"target\":\"«МЫ ПРИГНАЛИ СВИНЕЙ ДОМОЙ.»\"},{\"source_id\":\"ru77-art-caption-21-249\",\"target\":\"«СИЛА ВОСПИТАНИЯ, ВЛИЯНИЯ, ОБРАЗОВАНИЯ; ОНА МОЖЕТ ВЫРАСТИТЬ ЧЕЛОВЕКА ТАК, ЧТО ОН ПОВЕРИТ ВО ЧТО УГОДНО.»\"},{\"source_id\":\"ru77-art-caption-21-253\",\"target\":\"СЭНДИ И БОСС ЗА ВТОРЫМ СТОЛОМ.\"},{\"source_id\":\"ru77-art-caption-21-257\",\"target\":\"«В НЁМ БЫЛ ПРЕДСТАВЛЕН ОБРАЗЕЦ ПОЧТИ ВСЕХ ВЫСШИХ ЗАНЯТИЙ И ПРОФЕССИЙ.»\"},{\"source_id\":\"ru77-art-caption-22-275\",\"target\":\"«НА ДВЕНАДЦАТОМ ПОВТОРЕНИИ ОНИ РАЗВАЛИЛИСЬ НА КУСКИ.»\"},{\"source_id\":\"ru77-art-caption-23-283\",\"target\":\"«Повелеваю лютому Духу, что владеет Святым Источником, ныне извергнуть в небеса все адские огни, какие ещё остаются в нём!»\"},{\"source_id\":\"ru77-art-caption-23-293\",\"target\":\"«БГВДЖДЖИЛЛИГКК!!»\"},{\"source_id\":\"ru77-art-caption-24-297\",\"target\":\"«Как, бишь, это у вас называется?—Остолопы.»\"},{\"source_id\":\"ru77-art-caption-24-302\",\"target\":\"«СЭНДИ ИЗНЕМОГЛА ОТ УХОДА ЗА БОЛЬНЫМ.»\"},{\"source_id\":\"ru77-art-caption-24-310\",\"target\":\"ЛЖЕПРОРОК ИДЁТ НА ВСТРЕЧУ С КОРОЛЁМ.\"},{\"source_id\":\"ru77-art-caption-25-313\",\"target\":\"«Воистину, трудности я здесь вижу мало! дело сие по простоте своей есть даже детская забава.»\"},{\"source_id\":\"ru77-art-caption-25-319\",\"target\":\"«СЛЕДУЮЩИЙ!»\"},{\"source_id\":\"ru77-art-caption-25-322\",\"target\":\"«НИ СЛОВА ИЗ ВСЕГО ЭТОГО ЭТИ СОМЫ НЕ МОГЛИ ВЗЯТЬ В ТОЛК — НИ ГОЛОВЫ, НИ ХВОСТА.»\"}]}"
    }
