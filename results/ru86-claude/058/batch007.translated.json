{
  "unit": 58,
  "batch": 7,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr86-u058-b0224",
      "target": "— Сударыня...",
      "source_sha256": "a8638e06b90ee2250935fa359a4d01317275a1436ffb2cc51422343cc49a5eb1",
      "target_id": "ru-fr86-u058-b0224",
      "tag": "p",
      "target_sha256": "dc500119a96c4d5628b99157ea8adc93c1b9bb7717582fb560b74516451423b1"
    },
    {
      "source_id": "fr86-u058-b0225",
      "target": "Она прервала его очень тихим, яростным голосом: — Чего тебе надо?",
      "source_sha256": "d1e5422e2b39b193529084696d3f2e2461741142d23e4850b506128362ff29fc",
      "target_id": "ru-fr86-u058-b0225",
      "tag": "p",
      "target_sha256": "6a70d204313ef5ee7524787d28a740b54d6e443da99c1c73a13c89fe8ef4cd2b"
    },
    {
      "source_id": "fr86-u058-b0226",
      "target": "— Не вы, — сказал он, — другая.",
      "source_sha256": "48ee03367ea96b2b587c56cb5f6a6ab1ee7431c7e6bb005b0384427a1f3b0abf",
      "target_id": "ru-fr86-u058-b0226",
      "tag": "p",
      "target_sha256": "bdb808a9a44a2e3e4d1b20bb0ef5f54153a66ca4d3b4acb10b3d24278d2b3068"
    },
    {
      "source_id": "fr86-u058-b0227",
      "target": "— Какая другая?",
      "source_sha256": "cb37198c4e85a2e35ff92eb5690f6b96322283b6f11893156f51cfc018111c2b",
      "target_id": "ru-fr86-u058-b0227",
      "tag": "p",
      "target_sha256": "fbc653c0b32cbf6c00ba4652cfd07495043267fd7756c81d74c954220678c8a4"
    },
    {
      "source_id": "fr86-u058-b0228",
      "target": "— Молодая.",
      "source_sha256": "4942c42eefed79f235ce520064268794d0dedd936a7257fe8b8847b4793e0b8e",
      "target_id": "ru-fr86-u058-b0228",
      "tag": "p",
      "target_sha256": "2b4161195e61c0d944ecd99e80c8b1bd58a7c9ca331fdc36c0844366763d94d0"
    },
    {
      "source_id": "fr86-u058-b0229",
      "target": "Она принялась трясти головой и кричать: — Никого нет! Никого нет! Никого нет!",
      "source_sha256": "82041d2d54425262803e8def758cd0b750f89a847c8320baf0079f054866bc95",
      "target_id": "ru-fr86-u058-b0229",
      "tag": "p",
      "target_sha256": "d015560fd13fc2183ceb83a5025244153b4ee1b419f7405ed9298da9b42b2944"
    },
    {
      "source_id": "fr86-u058-b0230",
      "target": "— Есть! — снова сказал палач. — Вы сами это хорошо знаете. Позвольте мне взять молодую. Вам я не хочу причинять зла.",
      "source_sha256": "b19fbe7867ad1096bdda0d080dde4842da2e12158436f96d247225a0f3d63f21",
      "target_id": "ru-fr86-u058-b0230",
      "tag": "p",
      "target_sha256": "f2fdc4dbca4d0571c7dc3301a1155675af0066bcc15addfda1b218c1dcfdda1b"
    },
    {
      "source_id": "fr86-u058-b0231",
      "target": "Она сказала со странной усмешкой:",
      "source_sha256": "3af7262351d2dac372ea922f53e749a0109eca27be118c63ea8cc7e256d14673",
      "target_id": "ru-fr86-u058-b0231",
      "tag": "p",
      "target_sha256": "a1ebe855ffc099c9b2a785d7cf1e3cfbbfa52dcbd7bd3c571bd0891b7479c7a9"
    },
    {
      "source_id": "fr86-u058-b0232",
      "target": "— А! Мне ты не хочешь причинять зла!",
      "source_sha256": "2e444b4e73a151dc178dba517370b34b9741806c9f3950d32fb92ea021269069",
      "target_id": "ru-fr86-u058-b0232",
      "tag": "p",
      "target_sha256": "3e85a6290974f6ef4c4b726ce472dd3b2e263db4f248cb30b981c075cfc19882"
    },
    {
      "source_id": "fr86-u058-b0233",
      "target": "— Оставьте мне другую, сударыня; этого хочет господин прево.",
      "source_sha256": "fe507d18af04975877195f1a6e32ff4dee11a95a296d462e65bd5584f32b10ce",
      "target_id": "ru-fr86-u058-b0233",
      "tag": "p",
      "target_sha256": "4314ac2a0be4b19057ec9295a532ec5f09ff7f0f40cc9732893a439586081126"
    },
    {
      "source_id": "fr86-u058-b0234",
      "target": "Она повторила с безумным видом: — Никого нет.",
      "source_sha256": "a256988844b3997a3939775a4753024044f03a48ac225d7f15593d418c9e58c0",
      "target_id": "ru-fr86-u058-b0234",
      "tag": "p",
      "target_sha256": "0c98e4eb2fd0047ff649352ce8f579ee4e25a064a7be82a92bc9bd32a4843381"
    },
    {
      "source_id": "fr86-u058-b0235",
      "target": "— А я вам говорю, что есть! — возразил палач. — Мы все видели, что вас было две.",
      "source_sha256": "bc95241faa213fad7f30348d817ceabdbdff707edcc5160aa9fb6b34155e804b",
      "target_id": "ru-fr86-u058-b0235",
      "tag": "p",
      "target_sha256": "fab0bd824ad99a3e096917df99c70536b6cc1ac1f3b56f77dd8a95d43d2ea5c7"
    },
    {
      "source_id": "fr86-u058-b0236",
      "target": "— Погляди-ка лучше! — сказала затворница, усмехаясь. — Сунь голову в оконце.",
      "source_sha256": "9619f6010a695f24fc7d2ccf727e1b6531dc146d7b0828206d2ab92d59665807",
      "target_id": "ru-fr86-u058-b0236",
      "tag": "p",
      "target_sha256": "788405b62bebbc97a0da42a2b380264d7019cef3490a46203980ab79348340a9"
    },
    {
      "source_id": "fr86-u058-b0237",
      "target": "Палач осмотрел ногти матери и не посмел.",
      "source_sha256": "5d3dca4e6710689191c8356fdcf3252804cba002e8e1da50578ff88c1712e1e6",
      "target_id": "ru-fr86-u058-b0237",
      "tag": "p",
      "target_sha256": "26be3228cea80aa162c7b25955fd87eea3c7b2b863f8b192748a4fe47eaa91d2"
    },
    {
      "source_id": "fr86-u058-b0238",
      "target": "— Поторапливайся! — крикнул Тристан, который только что выстроил свой отряд кругом Крысиной норы и теперь сидел верхом на лошади возле виселицы.",
      "source_sha256": "d393c3a248dfb1665fc947dba3dd39a564b15a8a1a1422d11c8025b77b936e4e",
      "target_id": "ru-fr86-u058-b0238",
      "tag": "p",
      "target_sha256": "51bbd892e6692de1520e8d3c79a0016550bd5f5e48c8f23da1704576f6c3a655"
    },
    {
      "source_id": "fr86-u058-b0239",
      "target": "Анрие ещё раз вернулся к прево, совсем смущённый. Он положил свою верёвку на землю и неловко мял в руках шляпу.",
      "source_sha256": "7892915ba31dcb5474cde49ccb4af5ea5db462b876c83f40f377b92a2b169bb4",
      "target_id": "ru-fr86-u058-b0239",
      "tag": "p",
      "target_sha256": "6e92e425c69bfe5444b074e4dfb20c688643538b1fae47208af6aa6038fa16fa"
    },
    {
      "source_id": "fr86-u058-b0240",
      "target": "— Монсеньор, — спросил он, — где входить?",
      "source_sha256": "4b85818dc0c134e8b6b80693d9a207ed200c69345a415b3b3d259187d313b4d6",
      "target_id": "ru-fr86-u058-b0240",
      "tag": "p",
      "target_sha256": "b4412324dfe7b7d1d5f9fb31fe28bd248f2daf9c781dd6242a1d5d7620ae11b1"
    },
    {
      "source_id": "fr86-u058-b0241",
      "target": "— В дверь.",
      "source_sha256": "85ed867dc59b924fe5b2cb7ac70a25c28b1363411ef78734ce42c42b9599b5b8",
      "target_id": "ru-fr86-u058-b0241",
      "tag": "p",
      "target_sha256": "a2f7b8fd526087206c4558443385ae6302c216ae211255edb1549833eb3e8e07"
    },
    {
      "source_id": "fr86-u058-b0242",
      "target": "— Её нет.",
      "source_sha256": "5ddd9e1a4625853303482cce5d2afd5a23f31d0807a4f159b3fa32a48d3e78e0",
      "target_id": "ru-fr86-u058-b0242",
      "tag": "p",
      "target_sha256": "157496ab0558f5711a35ee8c63a3ce1a10087747322998472b6b12f4db16ca5d"
    },
    {
      "source_id": "fr86-u058-b0243",
      "target": "— В окно.",
      "source_sha256": "42d96d852b271d1dbf9eaaea6cc1491b5bb6609cb64f8265b9bb27eb7460516a",
      "target_id": "ru-fr86-u058-b0243",
      "tag": "p",
      "target_sha256": "399aa4ca87a475e07f044bdfb249a6251ef8562a8af318d5162da8c47e48eec6"
    },
    {
      "source_id": "fr86-u058-b0244",
      "target": "— Оно слишком узко.",
      "source_sha256": "447faed7f8a780fd1cf96569bce84cb651e649d0da93f671884343570d532ef0",
      "target_id": "ru-fr86-u058-b0244",
      "tag": "p",
      "target_sha256": "13dd275593b17d0fb3c6786fc8b226a6003be08723f386c6d2d2720208073371"
    },
    {
      "source_id": "fr86-u058-b0245",
      "target": "— Расширь его, — сказал Тристан в гневе. — Разве у тебя нет кирок?",
      "source_sha256": "88d5fe6a3d7985040749e633d131fadc45781ef1e43f5ad9a382d8d6794ebad8",
      "target_id": "ru-fr86-u058-b0245",
      "tag": "p",
      "target_sha256": "41eb66bc9d4d307c72681a070fde6ba763ec300f77d6f1fd96afba727ed04cb7"
    },
    {
      "source_id": "fr86-u058-b0246",
      "target": "Из глубины своего логова мать, всё так же настороженная, смотрела. Она уже ни на что не надеялась, она уже не знала, чего хочет, но она не хотела, чтобы у неё отняли дочь.",
      "source_sha256": "5db0ede3e967fe90f221d6320f2c7b344b11f081fcbc03d7a716e685f274d555",
      "target_id": "ru-fr86-u058-b0246",
      "tag": "p",
      "target_sha256": "853fbd141fbd2ad563fae3ae5c169000fddc6fd9b1396df30a9858fcdf06ed84"
    },
    {
      "source_id": "fr86-u058-b0247",
      "target": "Анрие Кузен пошёл за ящиком с орудиями палаческого ремесла под навес Дома на столбах. Вынес оттуда и двойную лестницу, которую тут же приставил к виселице. Пять или шесть человек из людей прево вооружились кирками и ломами, и Тристан вместе с ними направился к оконцу.",
      "source_sha256": "b6d7be9df478a53c65a2d22583f46e9cd789ebf79b6230a28c443451f7f68c43",
      "target_id": "ru-fr86-u058-b0247",
      "tag": "p",
      "target_sha256": "f65aa217e2588c590ed6ae148bda199757c6a8ed60a7753955a088384102bb80"
    },
    {
      "source_id": "fr86-u058-b0248",
      "target": "— Старуха, — строго сказал прево, — выдай нам эту девку по-хорошему.",
      "source_sha256": "d826a56c9c71898bc17aaf25555cb4d0b77d92c9f9a2f70dfbdf3bffd8629e51",
      "target_id": "ru-fr86-u058-b0248",
      "tag": "p",
      "target_sha256": "726a344b816ce5d4f9eb80edbb42709bcb9a172ea28106eb53080dad817db11f"
    },
    {
      "source_id": "fr86-u058-b0249",
      "target": "Она посмотрела на него так, как смотрят, когда не понимают.",
      "source_sha256": "636e64df9b0fb33e93e6a8fc0436aa4dea6836f77140d5bec6ae3154cba2c9a4",
      "target_id": "ru-fr86-u058-b0249",
      "tag": "p",
      "target_sha256": "520da28d8fa80a60e5d538ab15454107dc812832dfb5e58c2cbfce5f25b30788"
    },
    {
      "source_id": "fr86-u058-b0250",
      "target": "— Голова Господня! — продолжал Тристан. — Какое тебе дело до того, чтобы эту колдунью не повесили так, как угодно королю?",
      "source_sha256": "bf3ff130b9093d5ec730df42a92693cc289ad7a835c5b473a7fb0ce9121b909e",
      "target_id": "ru-fr86-u058-b0250",
      "tag": "p",
      "target_sha256": "b0f61cdfe8cac44d000830d3862c94374cbfe6633b1bbea9049043dc3f618cac"
    },
    {
      "source_id": "fr86-u058-b0251",
      "target": "Несчастная засмеялась своим диким смехом.",
      "source_sha256": "f20ff51e017a912fe38d5b3376bbe5e5ec3351609b11df46d14ab3753cc23bb3",
      "target_id": "ru-fr86-u058-b0251",
      "tag": "p",
      "target_sha256": "f92b1118d63de1f2f19cb988198dad027c4f78ad3e93db2469f9314d92aa799b"
    },
    {
      "source_id": "fr86-u058-b0252",
      "target": "— Какое мне дело? Это моя дочь.",
      "source_sha256": "e56bc5be55bff0a8f296701d4cf3fd5d7e8f5abf27e267405e3aaa308b463f4f",
      "target_id": "ru-fr86-u058-b0252",
      "tag": "p",
      "target_sha256": "e83a10762aa2fcf12e22acacfeedf48f64b9cb72d1faa7a3c9ddace190b05521"
    },
    {
      "source_id": "fr86-u058-b0253",
      "target": "Тон, которым она произнесла это слово, заставил содрогнуться даже самого Анрие Кузена.",
      "source_sha256": "7731e8e29ccbca14c705ec67f8513118c0086d331320b561cf15204fb455c5ae",
      "target_id": "ru-fr86-u058-b0253",
      "tag": "p",
      "target_sha256": "6a537ba485d6ecc71c76a98f5e1900c9ce3ca7bb915e8a6288e10a3a67603bdb"
    },
    {
      "source_id": "fr86-u058-b0254",
      "target": "— Мне жаль, — отозвался прево. — Но такова добрая воля короля.",
      "source_sha256": "85955ed4f0994a41f0277f6d6f3bc429cfe531889df71056ce5344fb30eafeb2",
      "target_id": "ru-fr86-u058-b0254",
      "tag": "p",
      "target_sha256": "595ff806e174e6673d02cf8943bd1aba2204cbabdff15e5d4eb20b9d7560a440"
    },
    {
      "source_id": "fr86-u058-b0255",
      "target": "Она закричала, удваивая свой страшный смех: — Какое мне дело до твоего короля? Я тебе говорю, что это моя дочь!",
      "source_sha256": "2cc9d9a3efc780d721974934c13c1e8b22956c00665ba1b1501c7aa05438fc73",
      "target_id": "ru-fr86-u058-b0255",
      "tag": "p",
      "target_sha256": "db3932ae80e0e110d24371a774b832931d362abba58e4c56dbd8325f2474e181"
    }
  ],
