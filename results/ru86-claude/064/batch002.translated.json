  "rows": [
    {
      "source_id": "fr86-u064-b0064",
      "target": "Эта комета, против которой папа Каликст, дядя Борджиа, повелел служить публичные молебны, та же самая, что вновь появится в 1835 году. ([[I]]Примечание Виктора Гюго[[/I]])",
      "source_sha256": "7c720af5827d5d1cd5c4fa6002a019d1637a9bc001a33e8898dbb2a9e7fafed5",
      "target_id": "ru-fr86-u064-b0064",
      "tag": "p",
      "target_sha256": "a913364b0961f082c7f4bb3b030c8100436bd32f563e40c6b1130c44da4c069b"
    },
    {
      "source_id": "fr86-u064-b0065",
      "target": "«Сан, связанный со значительной полицейской властью, а также со множеством прав и преимуществ.»",
      "source_sha256": "77088c90918ef58f157987b66e889c382d935a3ae4ddaa58f6b60981de00b6ed",
      "target_id": "ru-fr86-u064-b0065",
      "tag": "p",
      "target_sha256": "8448cbaae7f8c0763e2c5ee08c4b59cdeebe36bb5e78902fe476708523ab767d"
    },
    {
      "source_id": "fr86-u064-b0066",
      "target": "Счета домена, 1383 год. ([[I]]Примечание Виктора Гюго[[/I]])",
      "source_sha256": "d988a7c8d25b8c155a9f282c840f7ab7e36007b5a6d2fb6e42f8d58163819fed",
      "target_id": "ru-fr86-u064-b0066",
      "tag": "p",
      "target_sha256": "43bb60509d0ed48fc73929655de759add430029ed3a1e6cd737547a387b7d9f2"
    },
    {
      "source_id": "fr86-u064-b0067",
      "target": "«Текст закона суров.»",
      "source_sha256": "0a146a2e737fbed026e4731ecd7583fbbe0e7389c893f15fbe1d5cd533b7437c",
      "target_id": "ru-fr86-u064-b0067",
      "tag": "p",
      "target_sha256": "224f2648079d0961a0da16465336a8203c1255f826c82ec494fd2fb8de5af1c4"
    },
    {
      "source_id": "fr86-u064-b0068",
      "target": "«Тело Христово!»",
      "source_sha256": "2b86bbc36e1e321cd321287f665fcbc163718544e909bca502cf838f4a4049d2",
      "target_id": "ru-fr86-u064-b0068",
      "tag": "p",
      "target_sha256": "6006887f6b35f629a683eb8d39e3c0718088021fe68c2e2b38f8fe7dcb64bb66"
    },
    {
      "source_id": "fr86-u064-b0069",
      "target": "«Клянусь Геркулесом!»",
      "source_sha256": "5c0987f6ad994d324a3463e0ebaf1e72a0a6bd4fda7e2ab297fc236f4b33008f",
      "target_id": "ru-fr86-u064-b0069",
      "tag": "p",
      "target_sha256": "a1fbbc1a5c9075e099e014f6f1e89cba71e5881a4242c8266b2f2a9cd7dcac32"
    },
    {
      "source_id": "fr86-u064-b0070",
      "target": "«Во вред куртизанке.»",
      "source_sha256": "4a25414c20f3ee3487d9708d608fcfe9f8b8f2a5064c0e509b80bafa000dbc29",
      "target_id": "ru-fr86-u064-b0070",
      "tag": "p",
      "target_sha256": "61d027f21529900deb594a89394eb4c1bd8254225db7585673b41f2847023b7e"
    },
    {
      "source_id": "fr86-u064-b0071",
      "target": "«Своим громким голосом сквозь тьму.» Ср. Вергилий, «Энеида», VI, 619: «...et magna testatur voce per umbras».",
      "source_sha256": "a654e221b5386838da7fdd02768522b7e3e6fff5238b8cc1743163c94c75d9a5",
      "target_id": "ru-fr86-u064-b0071",
      "tag": "p",
      "target_sha256": "62debd5aeb452f6513b217274e529ac8524e859d49a3ef4120211b5ab22bc21d"
    },
    {
      "source_id": "fr86-u064-b0072",
      "target": "«Молчи и надейся.»",
      "source_sha256": "790ba01d33f2e0839a3dcb394899f0bb242e60b57a9e6fa6b1735d4ad0e24d39",
      "target_id": "ru-fr86-u064-b0072",
      "tag": "p",
      "target_sha256": "07b262e555f5f73e6dabf5ef1248de07ac3eba6e5edee3fcd7965eabbe6435ff"
    },
    {
      "source_id": "fr86-u064-b0073",
      "target": "«Крепкий щит — спасение вождей.»",
      "source_sha256": "69575d1846068137bafd8c2c7c6f47224289354f3bbce4df3e838259759b6b56",
      "target_id": "ru-fr86-u064-b0073",
      "tag": "p",
      "target_sha256": "48ea418b42b8a701ed1994f353d48eb3789658933cf0ab4e5be7c8e6bfe0a32c"
    },
    {
      "source_id": "fr86-u064-b0074",
      "target": "«Это твоё.»",
      "source_sha256": "232803f2a70014c7a918f1126bb73fd1d3592bc9b619a7da066338100c8979af",
      "target_id": "ru-fr86-u064-b0074",
      "tag": "p",
      "target_sha256": "f118adae1a1c694d676fc38c64113ea16f4b3a073395cdd58764a642859fc90a"
    },
    {
      "source_id": "fr86-u064-b0075",
      "target": "«Ты же молись.»",
      "source_sha256": "cff8f49d274aef5fa3452be3e4a14105c062673be9cbabb8ebe56da848bad10b",
      "target_id": "ru-fr86-u064-b0075",
      "tag": "p",
      "target_sha256": "e9b5e362f803422331c1684b30ea7a3a1331daa7a4b28336563026c68aeaf3e3"
    },
    {
      "source_id": "fr86-u064-b0076",
      "target": "«Неровным шагом.» Ср. Вергилий, «Энеида», II, 724.",
      "source_sha256": "6cb54f4b2c620e8e2470c6fc48268b885b89d83ea162c2c67d542ed966ad9f9b",
      "target_id": "ru-fr86-u064-b0076",
      "tag": "p",
      "target_sha256": "fe5d4a1864a75079b822d00409e858186c6e251aa3547410b6eed15c6d72893c"
    },
    {
      "source_id": "fr86-u064-b0077",
      "target": "«Глухой нелеп.»",
      "source_sha256": "8663cd0a6040fa90780b3c39d1a5af21f846f175a5a30387684c463ee6c59af8",
      "target_id": "ru-fr86-u064-b0077",
      "tag": "p",
      "target_sha256": "00faa529d2b92bdee633f58d46337882fc2781d0c68add2ef12e4db4d51645b9"
    },
    {
      "source_id": "fr86-u064-b0078",
      "target": "«Питай себя сам.»",
      "source_sha256": "ecdd389801125c906ecc458e9032c03cb7f430e476aae47957399d176ce6a8b5",
      "target_id": "ru-fr86-u064-b0078",
      "tag": "p",
      "target_sha256": "f2cff6544d3081f6f8ff6d191428d4113006d3217016d28b346d441c46a79376"
    },
    {
      "source_id": "fr86-u064-b0079",
      "target": "Господин.",
      "source_sha256": "28ed34af3756e82d00f9153fa47b78c1264bc7360bdb24c35b8bdb73ffdeddf9",
      "target_id": "ru-fr86-u064-b0079",
      "tag": "p",
      "target_sha256": "c080c9b9afff888d276642627a262624285e984d1c52b954ccfbe5b42998dd62"
    },
    {
      "source_id": "fr86-u064-b0080",
      "target": "«Не будут думать, что мужчина и женщина, оставшись одни, читают «Отче наш».»",
      "source_sha256": "35f4b41fade27fb0a17a9fa7352331ea76bc3258a080ebd53c3a0d585755ff9c",
      "target_id": "ru-fr86-u064-b0080",
      "tag": "p",
      "target_sha256": "73f6bc1ceb3f4337fac9d5cf6ee4dfee575e904d6867dae134de4ba2448fb391"
    },
    {
      "source_id": "fr86-u064-b0081",
      "target": "«Так же как.»",
      "source_sha256": "324c65174d4a83f0be4b720b4fd4153163da6b9b72fef4800b3ee12551ea8dd9",
      "target_id": "ru-fr86-u064-b0081",
      "tag": "p",
      "target_sha256": "9bafc3b4dd68160c7523fd6875cdd4e1126d1ab0b9dc9480caa2b89409e303ca"
    },
    {
      "source_id": "fr86-u064-b0082",
      "target": "«Но истина в том, что.»",
      "source_sha256": "a1a9a4b8399b773bf983ea3c30d9649449dfcb986c0ca1180b4f5ec07891e045",
      "target_id": "ru-fr86-u064-b0082",
      "tag": "p",
      "target_sha256": "b25487914f717202f138529b590b7e4b84a83964aab85a395fa36fdba1f472ee"
    },
    {
      "source_id": "fr86-u064-b0083",
      "target": ". «Поистине, эти жаровни с мясом — вещь поразительная!» (По-итальянски.)",
      "source_sha256": "e21cab692c2f1a965dfbb2f98e161a9146c27831df601f98a5d89ebdf7382c4a",
      "target_id": "ru-fr86-u064-b0083",
      "tag": "p",
      "target_sha256": "06d494523e5bfc66339c779171b52b310f70e4a3ca38676fca960771b57f17ac"
    },
    {
      "source_id": "fr86-u064-b0084",
      "target": "«Дыши, надейся.»",
      "source_sha256": "1ee4e85b331f9633fbc9c393694d72519727221e2356c182b012cec7b78fae2f",
      "target_id": "ru-fr86-u064-b0084",
      "tag": "p",
      "target_sha256": "888512a4c51e6735d0dcb82b9fbdd84a4c06b0eeb0ad3f04379cc3450832f43c"
    },
    {
      "source_id": "fr86-u064-b0085",
      "target": "«Откуда? Оттуда?»",
      "source_sha256": "cbba13249649280206823ba4ed957c93cdf3f2d2354edbb230292cead0431ac8",
      "target_id": "ru-fr86-u064-b0085",
      "tag": "p",
      "target_sha256": "361e807888fcc5aa899b820ee69cf5c3a5f777b1649f228e6f2fb55bca4e9154"
    },
    {
      "source_id": "fr86-u064-b0086",
      "target": "«Человек для человека — чудовище.»",
      "source_sha256": "9d226765bf42396d5426ce2d48436b8665ef11f89d50907fe2f4410c20e3348f",
      "target_id": "ru-fr86-u064-b0086",
      "tag": "p",
      "target_sha256": "9f5c42a5c2e201eb30654d01207ed6c8166987b949000fc9ed958ccf48b9bf5b"
    },
    {
      "source_id": "fr86-u064-b0087",
      "target": "«Светила, стан, имя, божество.»",
      "source_sha256": "b22327b8284f6e380c287e883264e9eb4243fdeffbe2b3f0e55ca1be1db5ea6c",
      "target_id": "ru-fr86-u064-b0087",
      "tag": "p",
      "target_sha256": "6c86527954d86d9a8c065ed9c98326bbf2dbc2ca36387027616724eb38e11f4f"
    },
    {
      "source_id": "fr86-u064-b0088",
      "target": "Каллимах, «Фрагменты», 359: «Большая книга — большое зло.»",
      "source_sha256": "a57cd089369ff3c1dfc57e38046152dcdeabd282de3aecab9833d8501c654fd7",
      "target_id": "ru-fr86-u064-b0088",
      "tag": "p",
      "target_sha256": "22a7b31dcc0fe148f24307089b24d0b8642ed3a8554d771cd4ff90304cc8565f"
    },
    {
      "source_id": "fr86-u064-b0089",
      "target": "«Дерзай знать.»",
      "source_sha256": "89d6b1a4b3c022f8e2b93352dec7311854f40bc519974393b1c86ac72629248e",
      "target_id": "ru-fr86-u064-b0089",
      "tag": "p",
      "target_sha256": "f919849b00123e5cf3e321ea5c61aa1ed04c81e6d6648085d7e679574b507d6c"
    },
    {
      "source_id": "fr86-u064-b0090",
      "target": "«Дышит, где хочет.»",
      "source_sha256": "3cc9a02365d56fa9247bc0a33b36f6748e22de718d1a18c55780c3edc2c966f1",
      "target_id": "ru-fr86-u064-b0090",
      "tag": "p",
      "target_sha256": "9a180b2119094b270152a6a7693aa81c4125e287792f8974a0e01196ee2d8b50"
    },
    {
      "source_id": "fr86-u064-b0091",
      "target": "«Принудительный режим» (питания атлетов, ср. Аристотель, «Политика», 1339a).",
      "source_sha256": "eab0d3c10f6217a6c2d1457ba5eb6d778ec3555721727a6e602fa1d92307927c",
      "target_id": "ru-fr86-u064-b0091",
      "tag": "p",
      "target_sha256": "98ca5f8508206f5df51b46fc359d3ffadd5ae504ea6bacd943ff164d3f48fb26"
    },
    {
      "source_id": "fr86-u064-b0092",
      "target": "«Dominum — господин небесный, domnus — господин земной.»",
      "source_sha256": "1bc63bbbdf061daf7aa54a2024a9bd9bcfac9ec31d2da26bcf7abe9e96a3c1af",
      "target_id": "ru-fr86-u064-b0092",
      "tag": "p",
      "target_sha256": "378015d51e002e5ed6b8aa36582f0602cf5e0632ae2e3cb4861edddaca3259df"
    },
    {
      "source_id": "fr86-u064-b0093",
      "target": "«Здесь и там.»",
      "source_sha256": "30384c90db436036c653e60065013f3b8fa8f50de8dfe54965c095b1385ec790",
      "target_id": "ru-fr86-u064-b0093",
      "tag": "p",
      "target_sha256": "b441e0f845354ca77f6d7314ced7eaf092662b7097e43b0c217006580f735a01"
    },
    {
      "source_id": "fr86-u064-b0094",
      "target": "«Рок.»",
      "source_sha256": "5519858d9b5040896b1d8f4141fe7bc7a33ed6717932909da0e6102831cbd979",
      "target_id": "ru-fr86-u064-b0094",
      "tag": "p",
      "target_sha256": "1d12d4f2486b3954c5fb7f419e1252b3c25c5aad1405108d3ae3bf788d21bfbc"
    },
    {
      "source_id": "fr86-u064-b0095",
      "target": "«Это по-гречески, этого не прочесть.»",
      "source_sha256": "a1f657dcf1a20efc07b56b34be1c2b9b840f55e63dd2fcd624b5af551f420b9e",
      "target_id": "ru-fr86-u064-b0095",
      "tag": "p",
      "target_sha256": "7658374859a8add38592c7cbc247ef9c0fb6c802888a749e67d17e5d181c6ba8"
    }
  ],
