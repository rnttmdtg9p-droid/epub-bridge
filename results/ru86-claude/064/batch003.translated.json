    },
    {
      "source_id": "fr86-u064-b0098",
      "target": "Плавт, «Ослы», 549–50: «Против стрекал, раскалённых лезвий, крестов, железа, уз, цепей, темниц, колодок, петель, пут.»",
      "source_sha256": "2b1b44edda09868f09b44513119980280c303e37d091bcb8e9a4537a5c44f933",
      "target_id": "ru-fr86-u064-b0098",
      "tag": "p",
      "target_sha256": "2e0caa95623205c9c95cc843ea373766e593e01dc10b264d8a4def39c68f7064"
    },
    {
      "source_id": "fr86-u064-b0099",
      "target": "Плавт, «Ослы», 301: «Нагой и в путах, ты весишь сто фунтов, когда висишь вниз головой, за ноги.» Запятую следует читать после es, а не перед ним.",
      "source_sha256": "6232a3ff97b481bcdf5033800f90eb5898ab9999348b2d3e530eab8af035f0a0",
      "target_id": "ru-fr86-u064-b0099",
      "tag": "p",
      "target_sha256": "bf39de7e2a0467f5bacf4fd518a48eeb4fa75179ad2358620f0ff6fe27d6b7ae"
    },
    {
      "source_id": "fr86-u064-b0100",
      "target": "«Стрига или маска!»",
      "source_sha256": "35b0db4a5c265d49381dc5d31c7fa7dc77b937e4f3ebdfe46ed322018ce5d1c4",
      "target_id": "ru-fr86-u064-b0100",
      "tag": "p",
      "target_sha256": "27ffcd050a9773d962be4d9224933093503ed8b258092f30da03216cab1d92ac"
    },
    {
      "source_id": "fr86-u064-b0101",
      "target": "Диалог об энергии и действии демонов.",
      "source_sha256": "58cae5d9546d4fa572cf7c756d2ffec04fe680e3ebe11010f2ab32fe6ceb6019",
      "target_id": "ru-fr86-u064-b0101",
      "tag": "p",
      "target_sha256": "e1f3a607d1b49c7107acf8f754399770225648938209db91206695576c1efbbc"
    },
    {
      "source_id": "fr86-u064-b0102",
      "target": "«Тебя, Боже, хвалим.»",
      "source_sha256": "f56aafcefce916e010d2b53733c283892b6410e68e5ec186114eb11ef0206540",
      "target_id": "ru-fr86-u064-b0102",
      "tag": "p",
      "target_sha256": "e3b25de5118a0a0fc1901c9af57dafd52d0aedc69ebb80358a6aa9e934eb8904"
    },
    {
      "source_id": "fr86-u064-b0103",
      "target": "«При сохранении видовой формы душа спасена.»",
      "source_sha256": "8f4bb9c55010c2ef9e701dfe365647ccc4bd60b8051a64442dc4df08f7031309",
      "target_id": "ru-fr86-u064-b0103",
      "tag": "p",
      "target_sha256": "965935b2d9c68ad6cae1456fce3ec87ea886c4a89414eff05c7298f70b90a635"
    },
    {
      "source_id": "fr86-u064-b0104",
      "target": "Монтень, «Опыты», III, 13: «Недостоин тот, кто живёт среди дурных слов.»",
      "source_sha256": "07834f6b47911e01136f4ab31606b4620ad1abc15bcb8533de6d3fe17dff1cd1",
      "target_id": "ru-fr86-u064-b0104",
      "tag": "p",
      "target_sha256": "936043cd93769dfc0dbcd5a62a601fcea4a2e845fa8bebe269483dd5ba5d4b83"
    },
    {
      "source_id": "fr86-u064-b0105",
      "target": "Гораций, «Сатиры», I, 8, 1: «Некогда я был стволом смоковницы»",
      "source_sha256": "9baebeda9d92499a48814fdf033cc88e7b7888324e4d1fe30fa0afe524d5850f",
      "target_id": "ru-fr86-u064-b0105",
      "tag": "p",
      "target_sha256": "675020af9f4651870fb68b7074c832a615076701492bfe41ce898aac7daabd3e"
    },
    {
      "source_id": "fr86-u064-b0106",
      "target": "Ренье, «Сатиры», XI, 24.",
      "source_sha256": "18b150e1eb802df0d827eddd8118e56e1f58101e69aeed3f15f7a14dca74e06f",
      "target_id": "ru-fr86-u064-b0106",
      "tag": "p",
      "target_sha256": "56d28bd59770dd05d0bd5f48534d1de16e7034f8056164d429ec78204ec97c83"
    },
    {
      "source_id": "fr86-u064-b0107",
      "target": "«Посему, господа, ввиду явной стриги, при очевидном преступлении и несомненном преступном умысле, во имя святой церкви Парижской Богоматери, коей принадлежит право высшего и низшего суда всякого рода на сём незапятнанном острове Сите, настоящим мы заявляем требование: во-первых, некоторого денежного возмещения; во-вторых, публичного покаяния перед главными вратами собора Парижской Богоматери, церкви кафедральной; в-третьих, приговора, в силу коего эта стрига вместе с её козой будут казнены либо на площади, в просторечии именуемой Гревой, либо при выходе с острова, на реке Сене, близ оконечности королевского сада!»",
      "source_sha256": "9f792f81ac0832e3401c5245bb623176946b7b75d916589a9f4a3d957279c8b1",
      "target_id": "ru-fr86-u064-b0107",
      "tag": "p",
      "target_sha256": "0605011baee6f3f5875ced5f8a13c8f77765f48c55c843511eb39aa652c28812"
    },
    {
      "source_id": "fr86-u064-b0108",
      "target": "«Увы! Низкая латынь!»",
      "source_sha256": "9531d09d721d28a77de3aff66306cc7db43907aa81c6544657a8b8751c5478af",
      "target_id": "ru-fr86-u064-b0108",
      "tag": "p",
      "target_sha256": "c880f8c8d51b271f002e65862b29b31093f3b8c0692045f11d1f14cfe669af2b"
    },
    {
      "source_id": "fr86-u064-b0109",
      "target": "«Отрицаю.»",
      "source_sha256": "5d17e5871daaa11ecfdd3ae6f826c68204d047a5bd338d2f5930a289f92838a9",
      "target_id": "ru-fr86-u064-b0109",
      "tag": "p",
      "target_sha256": "20958905166b26d468e8b66bb7107f6cbade8f248c74a10de5b39c38971d865c"
    },
    {
      "source_id": "fr86-u064-b0110",
      "target": "Данте, «Ад», III, 9: «Оставьте всякую надежду». Фраза, начертанная на вратах Ада.",
      "source_sha256": "3fc9fcfde833dbc58aff451abd26c99e02365fb74fc626505f0bbfa0fc174ea1",
      "target_id": "ru-fr86-u064-b0110",
      "tag": "p",
      "target_sha256": "af4286eac5aa6ba0a6e5a6e5e627a9cdcb8c286517741037727722ebb9e163b6"
    },
    {
      "source_id": "fr86-u064-b0111",
      "target": "Лафонтен, «Басни», I, 18, «Лиса и Аист».",
      "source_sha256": "e1724d5e1f1714fc43b548bca000fb40ac5c8c177b35f8bf212ac1a14fa8bfe2",
      "target_id": "ru-fr86-u064-b0111",
      "tag": "p",
      "target_sha256": "dbecad33397a65ecff78b228124aceb6c67deeafb663abd6ed95aeae71164e2d"
    },
    {
      "source_id": "fr86-u064-b0112",
      "target": "Псалмы, III, 7–8: «Я не боюсь мириад людей, которые со всех сторон ополчились против меня. Встань, Предвечный! Спаси меня, Боже мой!» (перевод Сегона в пересмотренной редакции.)",
      "source_sha256": "dfb383721507ad4c8244e89aa72fee975555017630b7f2a3a7e970e742181b69",
      "target_id": "ru-fr86-u064-b0112",
      "tag": "p",
      "target_sha256": "0daeefde671f553db5f529377c7954124a633ecca65d26c0ff17b9364a0da9d1"
    },
    {
      "source_id": "fr86-u064-b0113",
      "target": "Псалмы, LXIX, 2–3: «Спаси меня, о Боже, ибо воды дошли мне до горла. Я достиг самой глубины вод, поток накрывает меня с головой.»",
      "source_sha256": "bcd76c0db8136aa448fa6e2e4ce763a320b97edd81e5b8e236172395e2964cf4",
      "target_id": "ru-fr86-u064-b0113",
      "tag": "p",
      "target_sha256": "d641fe59e1a599c4d2b5e061b71997ce11add201f29163271137d2dc29fe5773"
    },
    {
      "source_id": "fr86-u064-b0114",
      "target": "Иоанн, V, 24: «Кто слушает слово Моё и верует в Пославшего Меня, имеет жизнь вечную и не приходит на суд, но перешёл от смерти в жизнь.»",
      "source_sha256": "c96d05cae8ba625f00187fe03442e1ff05c056207a867ae05f097bcaa75d7115",
      "target_id": "ru-fr86-u064-b0114",
      "tag": "p",
      "target_sha256": "2a0c3a25264d4d7979c135c669caf659f79a10c2eb35b62f49f6fea809a3961c"
    },
    {
      "source_id": "fr86-u064-b0115",
      "target": "Иона, II, 3–4: «Из недр обители мёртвых я взывал о помощи, и Ты услышал мой голос, Ты бросил меня в бездну, в самое сердце морей, и потоки вод окружили меня.»",
      "source_sha256": "157982f7ed5ea36bb8a3b1b87feaefb872d5b0fd457d153bcc1fdfd6d347c773",
      "target_id": "ru-fr86-u064-b0115",
      "tag": "p",
      "target_sha256": "78342e432ec68699e5411f39a279580ad313f049af401e5339d237a9902be162"
    },
    {
      "source_id": "fr86-u064-b0116",
      "target": "«Иди, двойственная душа, и да будет к тебе милосерден Бог!»",
      "source_sha256": "88744c45d6f539d97d14c6cf6b67565c2b46499f445c979fdb9e73e1d4fabb80",
      "target_id": "ru-fr86-u064-b0116",
      "tag": "p",
      "target_sha256": "7c5b21bf9d8a63eda3baa58bfe32a14888d8c1f0ec5fd3a22f03e3020438bae8"
    },
    {
      "source_id": "fr86-u064-b0117",
      "target": "«Что для монахов Сен-Жермена было гидрой, ибо школяры постоянно порождали новые поводы для спора.»",
      "source_sha256": "e5168d1117809a18967d510e352e2162bcdd8c474f230633ffb0a9bf4770bd51",
      "target_id": "ru-fr86-u064-b0117",
      "tag": "p",
      "target_sha256": "6dd624022b7db3e6704e151ea1ada1f2dcc26c1a0df6300599fd747b24846fa9"
    },
    {
      "source_id": "fr86-u064-b0118",
      "target": "«Счастливый старик!» (Ср. Вергилий, «Буколики», I, 46 и 51.)",
      "source_sha256": "2974eba113ee4743b3b506b57f10f2cfa7c93b487d1c8ac234a19598e9a8ae1f",
      "target_id": "ru-fr86-u064-b0118",
      "tag": "p",
      "target_sha256": "66e72ab704eceeeb7b899ce5d915e5bc865529fdc0434b391dc36cfec3edf23f"
    },
    {
      "source_id": "fr86-u064-b0119",
      "target": "Иов, IV, 12 и 15.",
      "source_sha256": "38bb6e2ccb32c031aa886ecef0ca3df34285487228cdeed74db366a046691d9a",
      "target_id": "ru-fr86-u064-b0119",
      "tag": "p",
      "target_sha256": "cb80c68be83a956bdbdf16ce0406ccb7df02a43ecf4349c5f8a013c1d0eb999e"
    },
    {
      "source_id": "fr86-u064-b0120",
      "target": "О резке камней.",
      "source_sha256": "25e76266e1118b41961284b7c8e737d87e961946e9d5c11c57e971f1ac36ef25",
      "target_id": "ru-fr86-u064-b0120",
      "tag": "p",
      "target_sha256": "cc9879c710790085bd2472a0aebc6f097df9e2c47ad56b83e4a15a742f11b155"
    },
    {
      "source_id": "fr86-u064-b0121",
      "target": "«Всё дело в том, чтобы яства, питьё, сон, любовь — всё было умеренно.»",
      "source_sha256": "32095251e679580f8aa4c2c9d5e43f7be77101840381c431f433052a7098aca9",
      "target_id": "ru-fr86-u064-b0121",
      "tag": "p",
      "target_sha256": "82c75b467b3710ef55d70067af3999f219dc1ec035c8e4319cda130f4a009bbd"
    },
    {
      "source_id": "fr86-u064-b0122",
      "target": "«Брак, заключённый с посторонними.»",
      "source_sha256": "6547ba8ab51abed4f4cc83d4b582985d9fd18fdf06b3906a0ada70071d1fd42a",
      "target_id": "ru-fr86-u064-b0122",
      "tag": "p",
      "target_sha256": "4900dfc0cf0f55afe9953987a6bf1ba5ab803a9e5cbbc661965bc1cad74b4711"
    },
    {
      "source_id": "fr86-u064-b0123",
      "target": "«Учение докторов, дисциплина учеников гибнут.»",
      "source_sha256": "d9f7bb6cd62dd7bd23724bf7678553f909dfb82e0f1816906b57ff874a8ef523",
      "target_id": "ru-fr86-u064-b0123",
      "tag": "p",
      "target_sha256": "194d2c1c3d29b914e72bfa6b658af5cf52db5cc40de4197ef7f08ebbd5bf1450"
    },
    {
      "source_id": "fr86-u064-b0124",
      "target": "«Многолюдное неистовство народа, который неистовствует.»",
      "source_sha256": "c71a0ffe549daef982c39e3c64997b7bcad21dfbf3d4e9db5e3d396bafaba18b",
      "target_id": "ru-fr86-u064-b0124",
      "tag": "p",
      "target_sha256": "86003ab6afb5f14b8562acdd55e463e473949eb6c42918a040b28cfc48c6fc82"
    },
    {
      "source_id": "fr86-u064-b0125",
      "target": "«Какие песнопения! какие инструменты! какие напевы! какие мелодии звучат здесь без конца! звучат сладостные инструменты гимнов, нежная мелодия ангелов, дивные песни песней!»",
      "source_sha256": "450226dc71342d572923b1eb1160d3c75155e10ae00a4ea7be1189ac16e473cb",
      "target_id": "ru-fr86-u064-b0125",
      "tag": "p",
      "target_sha256": "1aa7979570bf3d7dee76cdce8a7c017214ddd1649bb23548c02c6fff0956a880"
    },
    {
      "source_id": "fr86-u064-b0126",
      "target": "«Не всякому дано иметь нос.»",
      "source_sha256": "a43770806f588614d7310fbbe6f8b1fa5d80abbf39283118dfff397c76f07080",
      "target_id": "ru-fr86-u064-b0126",
      "tag": "p",
      "target_sha256": "d71eaa454586cbdaaba84149bf26c14e242c32806cb103492a0dd9a818883e2e"
    },
    {
      "source_id": "fr86-u064-b0127",
      "target": "«Распутная вещь — вино, и буйная — опьянение.»",
      "source_sha256": "b1a4b32a6fb66b8ab8307389b6c72bf8657980f761f58e2b96a35078d026a483",
      "target_id": "ru-fr86-u064-b0127",
      "tag": "p",
      "target_sha256": "e2eb525862cb885cce56324d54d68338ec7984467a502085d578dc05249c76bc"
    }
  ],
