  "rows": [
    {
      "source_id": "fr86-u064-b0096",
      "target": "«Кто не работает, да не ест.»",
      "source_sha256": "c3ac9313ceddd37f530a81b928d6932c79ecf226393232e666d73c98101bac59",
      "target_id": "ru-fr86-u064-b0096",
