    },
    {
      "source_id": "fr86-u064-b0097",
      "target": "Междометие, выражающее скорбь: «Увы! Увы!»",
      "source_sha256": "40708c040a88632cf0bbe481913eaece8df7b87b7e33edc401ba77907e7e69fd",
      "target_id": "ru-fr86-u064-b0097",
