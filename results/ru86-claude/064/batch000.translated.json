    {
      "source_id": "fr86-u064-b0000",
      "target": "Рок.",
      "source_sha256": "4d211999f6fde9da174f4d067bd771ba400a19ceeefcae2c3a7d0773102aa081",
      "target_id": "ru-fr86-u064-b0000",
      "tag": "p",
