{
  "unit": 37,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr86-u037-b0032",
      "target": "— В семь часов.",
      "source_sha256": "b9386942b1213e2eb44fbf0c86ef6ae5dad24c6d99c5eca1dfd6f1f2e03f47e2",
      "target_id": "ru-fr86-u037-b0032",
      "tag": "p",
      "target_sha256": "5b44a14bb1b47e833a6a8989125adfa97e4efca75b43e69f09a6e9afdef7301b"
    },
    {
      "source_id": "fr86-u037-b0033",
      "target": "— Через четверть часа.",
      "source_sha256": "c10f1353c7bb1d5fc1de6e0819a14fc4f9993d674b8d5fef3a92450f507f575a",
      "target_id": "ru-fr86-u037-b0033",
      "tag": "p",
      "target_sha256": "a350c846bae453c9b9578ee63cdc6a19fe3d15d3d3bed97d723895d9d1418477"
    },
    {
      "source_id": "fr86-u037-b0034",
      "target": "— У Фалурдель.",
      "source_sha256": "5a9fd8ddce935f2789ac06a6e4a8aa4c719d9719b9dd01d805decdbb5d71d36d",
      "target_id": "ru-fr86-u037-b0034",
      "tag": "p",
      "target_sha256": "44a76164a47eccc5e012d20f65f99616716b37d22f7ca41b53a83a1ec16c21c9"
    },
    {
      "source_id": "fr86-u037-b0035",
      "target": "— Именно так.",
      "source_sha256": "36697d6f4975a223a966f9823acaeeb4b7991ceae5abc0760876edca88c62a3b",
      "target_id": "ru-fr86-u037-b0035",
      "tag": "p",
      "target_sha256": "d9ebed989f2d0490b6179976ee8a45219cf75364dbf36a9799b8a77f2cc59c1d"
    },
    {
      "source_id": "fr86-u037-b0036",
      "target": "— В притоне на мосту Сен-Мишель.",
      "source_sha256": "0ab70d0448da1d6a807f8300eac7d34371ea934e09daf19754f65b5221703568",
      "target_id": "ru-fr86-u037-b0036",
      "tag": "p",
      "target_sha256": "a0c4dfae29a469054a8359d60a02f175b75981cb4ad7fc949487850fa3d64150"
    },
    {
      "source_id": "fr86-u037-b0037",
      "target": "— Святого Михаила Архангела, как говорится в молитве.",
      "source_sha256": "9b149b87b5971e631581844f9607d3e38acf372c34db989d6844b05388b78013",
      "target_id": "ru-fr86-u037-b0037",
      "tag": "p",
      "target_sha256": "8fdc48ed23e05efa7a63cc71c2a8a209e7eef373fd0c68ff7067289f49660f91"
    },
    {
      "source_id": "fr86-u037-b0038",
      "target": "— Нечестивец! — проворчал призрак. — С женщиной?",
      "source_sha256": "a7a658dfe58af8d189edcbdf1868ff4bf5b48c85b1d7f2781b7611f762e89007",
      "target_id": "ru-fr86-u037-b0038",
      "tag": "p",
      "target_sha256": "86874dd75e51d30745802fc1e299287eb4ff530f4212baf7f2cee0a8f26b02bc"
    },
    {
      "source_id": "fr86-u037-b0039",
      "target": "— [[I]]Confiteor[[/I]].",
      "source_sha256": "9f3d82f636f1a17e44678638c861b84b59133187a412ad7bf5b9ebf5e6c00501",
      "target_id": "ru-fr86-u037-b0039",
      "tag": "p",
      "target_sha256": "5b71e5a4d83d4632975ae290866e5f6bd3357bb9e51b6db818afd4d6bcbf4ab3"
    },
    {
      "source_id": "fr86-u037-b0040",
      "target": "— Которую зовут...",
      "source_sha256": "b3fd777aba8a520e5b359c5e15344917d2c411bb658abbae853335f361d9d9b6",
      "target_id": "ru-fr86-u037-b0040",
      "tag": "p",
      "target_sha256": "9b96add8abde663d32fcb662cd7fd7fb3e34f47b4512814121fec245e5cb1fe7"
    },
    {
      "source_id": "fr86-u037-b0041",
      "target": "— Ла Смеральда, — весело сказал Феб. Вся его беззаботность понемногу вернулась к нему.",
      "source_sha256": "685aaeb8e07b5c484b317824e3ed15091212e184e7d38b546cdc4ecba1428285",
      "target_id": "ru-fr86-u037-b0041",
      "tag": "p",
      "target_sha256": "7b116fec967529daaf72df6f756d58a03218885d109dd405b7ae04886ee1c9fb"
    },
    {
      "source_id": "fr86-u037-b0042",
      "target": "При этом имени когти тени яростно встряхнули руку Феба.",
      "source_sha256": "f4a5f9faaf51ad2081373b55df12d0479b6246357bbbd3b147094f50898de6af",
      "target_id": "ru-fr86-u037-b0042",
      "tag": "p",
      "target_sha256": "1830dbbc587be0353a685a9f4d49da52ffe0fe945080356002595446c2220e2f"
    },
    {
      "source_id": "fr86-u037-b0043",
      "target": "— Капитан Феб де Шатопер, ты лжёшь!",
      "source_sha256": "371151ef5306ba0b308ca3272573a1809ec78de9214dd734af8f7974822a348d",
      "target_id": "ru-fr86-u037-b0043",
      "tag": "p",
      "target_sha256": "5fa9464c4f39367d5770218857979f808a49adcb2b2076db8739e4525816b17f"
    },
    {
      "source_id": "fr86-u037-b0044",
      "target": "Если бы кто-нибудь мог увидеть в этот миг пылающее лицо капитана, его прыжок назад, такой резкий, что он вырвался из клещей, схвативших его, гордую осанку, с какой он схватился рукой за эфес шпаги, и перед этим гневом — мрачную неподвижность человека в плаще, тот, кто увидел бы это, пришёл бы в ужас. Это было нечто вроде поединка дон Жуана со статуей.",
      "source_sha256": "ec5920d00a7b8d46b3228f4fe1937bf1249376cf3d46f4662ee2bd2b15ba0335",
      "target_id": "ru-fr86-u037-b0044",
      "tag": "p",
      "target_sha256": "27b7fc8350dbded249adfbf355c10afdde56e135403ebde5b03f6f2f99732ef8"
    },
    {
      "source_id": "fr86-u037-b0045",
      "target": "— Христос и Сатана! — крикнул капитан. — Такое слово редко задевает слух Шатопера! Ты не посмел бы повторить его.\n\n— Ты лжёшь! — холодно сказала тень.",
      "source_sha256": "9cc36415712d684ccf37d14a81b9245c586fae53223a1c6a29c7f6feede2bd60",
      "target_id": "ru-fr86-u037-b0045",
      "tag": "p",
      "target_sha256": "9ba82f157d52d3fdc106ed3eda716251aacad9b0160c351819efacb4c4aebfe5"
    },
    {
      "source_id": "fr86-u037-b0046",
      "target": "— Ты лжёшь! — холодно сказала тень.",
      "source_sha256": "1361f8baea319f94013b09442ee2496cbafcc84f336427aab9c61e3e475e52f1",
      "target_id": "ru-fr86-u037-b0046",
      "tag": "p",
      "target_sha256": "ccb8d5805abbab459e6faf8d049051f90516b28a26b01bd0b4cd1f3da60871d1"
    },
    {
      "source_id": "fr86-u037-b0047",
      "target": "Капитан заскрежетал зубами. Бурый монах, призрак, суеверия — он забыл всё в этот миг. Он видел только человека и оскорбление.",
      "source_sha256": "872ccb73eb2a8a5f189fd39767d22f99cb7f7f3e40553ef06ad57c153e9576d7",
      "target_id": "ru-fr86-u037-b0047",
      "tag": "p",
      "target_sha256": "5b10a31695668660f175f299662efbaa8c2805dfaa799696cbd3a856c1b7f360"
    },
    {
      "source_id": "fr86-u037-b0048",
      "target": "— А! Вот это хорошо! — пробормотал он голосом, сдавленным от ярости. Он выхватил шпагу и, запинаясь, ибо гнев заставляет дрожать так же, как страх, проговорил: — Здесь! Сейчас же! Вперёд! Шпаги! Шпаги! Крови на эти камни!",
      "source_sha256": "ce4fc04ee6340c6e81348d752dd6820c5d08147049a6e5aca5fc5c85518f8fc5",
      "target_id": "ru-fr86-u037-b0048",
      "tag": "p",
      "target_sha256": "0d67cacec208cec8017f17aeb307ff4eeaf341a394f96fa18b1c266fabab3e30"
    },
    {
      "source_id": "fr86-u037-b0049",
      "target": "Но тот не двигался. Когда он увидел противника, стоящего в позиции и готового к выпаду, он сказал, и в его голосе дрожала горечь: — Капитан Феб, вы забываете о своём свидании.",
      "source_sha256": "e64e511170299718e1eaa10116b4f9a08e29c8f5ae5bbb9b74fc9de4847028f7",
      "target_id": "ru-fr86-u037-b0049",
      "tag": "p",
      "target_sha256": "5a5b8145d602b12ab74bdc34077d3a4af24e26d6c384c093719470cc96769e6c"
    },
    {
      "source_id": "fr86-u037-b0050",
      "target": "Вспышки гнева у людей вроде Феба — как молочный суп: капля холодной воды укрощает его кипение. Эти простые слова заставили опуститься шпагу, сверкавшую в руке капитана.",
      "source_sha256": "b4339a5521ed76c01a86ef8bf051313fbd4941811e294a66419bad39f2d4decc",
      "target_id": "ru-fr86-u037-b0050",
      "tag": "p",
      "target_sha256": "42f0cb04c20c93381787d3dd6339de0e2271ae218e2fc11b0df8609a551e3ffe"
    },
    {
      "source_id": "fr86-u037-b0051",
      "target": "— Капитан, — продолжал человек, — завтра, послезавтра, через месяц, через десять лет вы найдёте меня готовым перерезать вам горло; но сперва ступайте на ваше свидание.\n\n— В самом деле, — сказал Феб, словно пытаясь договориться с самим собой, — шпага и девушка — две прелестные вещи, которые приятно встретить на свидании; но я не вижу, почему мне нужно пренебречь одной ради другой, когда я могу получить обе.",
      "source_sha256": "16fba88157a5ecb18fdcb3a6dcef59d358c030bc9087e5610551699c8762b228",
      "target_id": "ru-fr86-u037-b0051",
      "tag": "p",
      "target_sha256": "14aada5bee973cbc9c6c56898009aed0b391e428951a9e14fc85d648641f7757"
    },
    {
      "source_id": "fr86-u037-b0052",
      "target": "— В самом деле, — сказал Феб, словно пытаясь договориться с самим собой, — шпага и девушка — две прелестные вещи, которые приятно встретить на свидании; но я не вижу, почему мне нужно пренебречь одной ради другой, когда я могу получить обе.",
      "source_sha256": "bd18bed55b5509c01b6325e6a53f5127a96e9e90e564540c5be0a20a21641fc0",
      "target_id": "ru-fr86-u037-b0052",
      "tag": "p",
      "target_sha256": "37befc1c27469a574e3f584e062136da0cc3b6e1a30868601f36204a7da7bdd5"
    },
    {
      "source_id": "fr86-u037-b0053",
      "target": "Он вложил шпагу в ножны.",
      "source_sha256": "58d21033cc2337ae4e3c326a5da9f9daf9caf1f1f7d8abb6688a1a5dc11d88c7",
      "target_id": "ru-fr86-u037-b0053",
      "tag": "p",
      "target_sha256": "4c52273e34d406513fe023b5e0e5f271ac9a280da60ec786395651bf55dcd213"
    },
    {
      "source_id": "fr86-u037-b0054",
      "target": "— Ступайте на ваше свидание, — повторил незнакомец.",
      "source_sha256": "1a86670d9927ecb3f60b84e927c7c549542d4adfc998e8b18915c58d1b83db9a",
      "target_id": "ru-fr86-u037-b0054",
      "tag": "p",
      "target_sha256": "47a9fa09b79365a3fc4b0df2c480d07f91816858bb933a0058c598c5c2b38620"
    },
    {
      "source_id": "fr86-u037-b0055",
      "target": "— Сударь, — ответил Феб с некоторым смущением, — премного благодарен вам за вашу любезность. В сущности, завтра всегда будет время изрезать друг другу камзол папаши Адама прорезями и петлями. Я признателен вам за то, что вы позволяете мне провести ещё один приятный часок. Я, правда, надеялся уложить вас в сточную канаву и всё же поспеть к красотке, тем более что в подобных случаях хорошим тоном считается заставить женщин немного подождать. Но вы, как видно, малый не промах, и надёжнее отложить партию до завтра. Итак, я иду на своё свидание. Оно назначено на семь часов, как вы знаете. — Тут Феб почесал за ухом. — А, рога Господни! Я забыл! У меня нет ни гроша, чтобы заплатить за каморку, а старая карга захочет получить деньги вперёд. Она мне не доверяет.",
      "source_sha256": "49aee4d7d2a91e17ca18fde9bea14e696f178c16d500fbdf04357bf402bb28c2",
      "target_id": "ru-fr86-u037-b0055",
      "tag": "p",
      "target_sha256": "26eff3b743fa6bb77b120b1e0782fad2ebf1522d25502b9ce2ed85673dff44bc"
    },
    {
      "source_id": "fr86-u037-b0056",
      "target": "— Вот чем заплатить.",
      "source_sha256": "dedd98b12192c59a5ebbf03392c001479ef697e59081155ac9cd30b8a96e2a23",
      "target_id": "ru-fr86-u037-b0056",
      "tag": "p",
      "target_sha256": "4c03429b8f327b7dd6480be9fcdc9bb2b821fe6050f64780f0243fa442e032c3"
    },
    {
      "source_id": "fr86-u037-b0057",
      "target": "Феб почувствовал, как холодная рука незнакомца сунула в его ладонь крупную монету. Он не удержался и взял эти деньги и пожал эту руку.",
      "source_sha256": "f62f996a15594400f098647f408d54f4b03e81ecdb5ae2079f9136883a64afaf",
      "target_id": "ru-fr86-u037-b0057",
      "tag": "p",
      "target_sha256": "af9fe83c1858a5234ae4521839952b87a7cf466c7142e83cc672dbc5a9179324"
    },
    {
      "source_id": "fr86-u037-b0058",
      "target": "— Истинный Бог! — воскликнул он. — Вы славный малый!",
      "source_sha256": "402cd17d26527933bf9e630d7cf28d96264287aca1c56b3c8c8e3275916911d3",
      "target_id": "ru-fr86-u037-b0058",
      "tag": "p",
      "target_sha256": "4e957bfc849112af7cfeacb72fc13c9c4cd0d52105282f9a9a23cfb9085e9e93"
    },
    {
      "source_id": "fr86-u037-b0059",
      "target": "— Одно условие, — сказал человек. — Докажите мне, что я был неправ, а вы говорили правду. Спрячьте меня где-нибудь в уголке, откуда я мог бы увидеть, действительно ли эта женщина та, чьё имя вы назвали.",
      "source_sha256": "bb3008c603309821dd035481bc047f0326a825d93e914dd19647e23ca78c7528",
      "target_id": "ru-fr86-u037-b0059",
      "tag": "p",
      "target_sha256": "499755e312d21977ae5be2fa439798854937a667285ab5773275bf76ca6a7900"
    },
    {
      "source_id": "fr86-u037-b0060",
      "target": "— О! — ответил Феб. — Мне это совершенно всё равно. Мы возьмём комнату Святой Марфы. Вы сможете спокойно смотреть из чулана, что рядом.",
      "source_sha256": "26453e7609ad801ff27957524132ee6672c4fa57cf8475760fa80c2356fee049",
      "target_id": "ru-fr86-u037-b0060",
      "tag": "p",
      "target_sha256": "b5a397bdcc4d6870f69c2c49c0347847da2517f3f3e4859aba1362cc00cd53a2"
    },
    {
      "source_id": "fr86-u037-b0061",
      "target": "— Идёмте же, — сказала тень.",
      "source_sha256": "e3e4eda014b0582f92c3e879d6fa6c478b923da47d3bdff6cffdc4064e8e8adb",
      "target_id": "ru-fr86-u037-b0061",
      "tag": "p",
      "target_sha256": "1eccb75d56a8f133952393523d54152571ae4f97dd1e39b775b016e6a88a0d88"
    },
    {
      "source_id": "fr86-u037-b0062",
      "target": "— К вашим услугам, — сказал капитан. — Не знаю, не мессер ли вы Диаболус собственной персоной. Но останемся сегодня вечером добрыми друзьями. Завтра я расплачусь с вами за все свои долги — и кошельком, и шпагой.",
      "source_sha256": "3d5fe1b7585b9d1ee9026e411db4b5a162152592d07059b00c16ba44e9f2a5a9",
      "target_id": "ru-fr86-u037-b0062",
      "tag": "p",
      "target_sha256": "9a93864730f7b10cf0ff3580d9563ca2eedfac999f98fb5712eef647a23f8dea"
    },
    {
      "source_id": "fr86-u037-b0063",
      "target": "Они снова быстро зашагали. Через несколько минут шум реки возвестил им, что они на мосту Сен-Мишель, застроенном тогда домами. — Сначала я введу вас, — сказал Феб своему спутнику, — потом пойду за красоткой, которая должна ждать меня близ Малого Шатле.",
      "source_sha256": "4700969731212636be19d02eabb15471c0af5ec72e92bec73869256726e85502",
      "target_id": "ru-fr86-u037-b0063",
      "tag": "p",
      "target_sha256": "aac00278007de26d94beaa86dd28d15e7cf58e4beed2e04372c80ebf4abd1814"
    }
  ],
