    {
      "source_id": "fr86-u062-b0001",
      "target": "ПРИМЕЧАНИЕ I.",
      "source_sha256": "83457f2320a107cf323a99fd6f5c9ca4949034b08d487868585b88b4854aa51d",
      "target_id": "ru-fr86-u062-b0001",
