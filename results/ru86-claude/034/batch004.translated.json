{
  "unit": 34,
  "batch": 4,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr86-u034-b0120",
      "target": "— Жеан, вы стоите на очень скользком склоне. Знаете ли вы, куда идёте?",
      "source_sha256": "ca60a705b8b68d91c8819c7f67eb21664fd50575fd3866452de02e464bd7219b",
      "target_id": "ru-fr86-u034-b0120",
      "tag": "p",
      "target_sha256": "7880ccbcb5c16ded1084e2affbc12e340c8efb863c8f587163534d733e971d81"
    },
    {
      "source_id": "fr86-u034-b0121",
      "target": "— В кабак, — сказал Жеан.",
      "source_sha256": "6483d3408f92bb66d93a1643f6fb535dd4ec09b376e8bf429e95c3e6c1311505",
      "target_id": "ru-fr86-u034-b0121",
      "tag": "p",
      "target_sha256": "ee504a74f25e533dbf7c73a276c905253f6193252565989e61ac7cabfe8cbcb2"
    },
    {
      "source_id": "fr86-u034-b0122",
      "target": "— Кабак ведёт к позорному столбу.",
      "source_sha256": "23b7b50a8dbdc65c139a44c665df8b6292acc651e647a29bf6726d8f418a5fb0",
      "target_id": "ru-fr86-u034-b0122",
      "tag": "p",
      "target_sha256": "4365aca28d68441be9b2197f6fa2e2a2b6c19eff5b1997ea922b996d9800472a"
    },
    {
      "source_id": "fr86-u034-b0123",
      "target": "— Это такой же фонарь, как всякий другой, и, пожалуй, именно с ним Диоген и нашёл бы своего человека.",
      "source_sha256": "991056ecaa7c4e714bbfe1f7b80f1418c1cf6392e2735ecbd45d5b44d1bce25f",
      "target_id": "ru-fr86-u034-b0123",
      "tag": "p",
      "target_sha256": "7026033c3011b395dc68a2810f50fc901f4529aa1014731f77a65737b2b2739d"
    },
    {
      "source_id": "fr86-u034-b0124",
      "target": "— Позорный столб ведёт к виселице.",
      "source_sha256": "7e7771ce8c5c360957000bfba406bf26f3aa5debc5d4678156d235e3088ac0c4",
      "target_id": "ru-fr86-u034-b0124",
      "tag": "p",
      "target_sha256": "df601bede8821078add9d6b65edc4071222947f4693f58b5408b1240b589b642"
    },
    {
      "source_id": "fr86-u034-b0125",
      "target": "— Виселица — это весы: на одном конце человек, на другом вся земля. Прекрасно быть этим человеком.",
      "source_sha256": "bdaded97c28c5a8c18a9827aaf2f06f9299cc46f41ca0e6c164f1f57191b0e6d",
      "target_id": "ru-fr86-u034-b0125",
      "tag": "p",
      "target_sha256": "497b7e0f726c512a2c4cc18107d40ec9d24ce30b9e8dc96c071ad378958caaa9"
    },
    {
      "source_id": "fr86-u034-b0126",
      "target": "— Виселица ведёт в ад.",
      "source_sha256": "7e92296187c8fe83277a7a30cd845e71f58ca05229dfa20807e50bfb83564bae",
      "target_id": "ru-fr86-u034-b0126",
      "tag": "p",
      "target_sha256": "5ec20acf456600304e45fa81cc7dd0702824863e58cf7b52fb81709fae002450"
    },
    {
      "source_id": "fr86-u034-b0127",
      "target": "— Что ж, большой костёр.",
      "source_sha256": "1e8a83457c0d45358167519359aa6694796ddefcdd244a010c88ec9c17d7cb17",
      "target_id": "ru-fr86-u034-b0127",
      "tag": "p",
      "target_sha256": "7e5a44fe35233c938486867e1fb7446457ad45b2703fda1ae06e0ad103769e5b"
    },
    {
      "source_id": "fr86-u034-b0128",
      "target": "— Жеан, Жеан, конец будет плохой.",
      "source_sha256": "dead6c504782194771ea9733f8c5380370a7d88df5dd7c3953435a0e634cb4c3",
      "target_id": "ru-fr86-u034-b0128",
      "tag": "p",
      "target_sha256": "9bccf6d7869fe9828b25feee335dca2f16abe1a82f5b8724e5c8516a5954d072"
    },
    {
      "source_id": "fr86-u034-b0129",
      "target": "— Зато начало было хорошее.»",
      "source_sha256": "24b7b86ffbf67bc1e6e64bc31bbdbb0955dd2cb6b1fbf2d4543e0a639a027798",
      "target_id": "ru-fr86-u034-b0129",
      "tag": "p",
      "target_sha256": "442d46ba503a99076781b56dc7d6fbce507c8ada2e61080d61d81328dc3ba653"
    },
    {
      "source_id": "fr86-u034-b0130",
      "target": "В этот миг на лестнице послышался звук шагов.",
      "source_sha256": "f251974934e211737577f548db0b9ae3a9b34d616e931069ba98a9a501b3ff13",
      "target_id": "ru-fr86-u034-b0130",
      "tag": "p",
      "target_sha256": "8d3e1c7c6ba849f71991957b2d9bc33d984080014615a66b8f6e34bbbd4e0637"
    },
    {
      "source_id": "fr86-u034-b0131",
      "target": "«Тише! — сказал архидиакон, приложив палец к губам. — Это мэтр Жак. Слушайте, Жеан, — добавил он вполголоса, — берегитесь когда-либо заговорить о том, что вы здесь увидите и услышите. Живо прячьтесь под эту печь и не дышите.»",
      "source_sha256": "fefb66044bd4f463e950bbefe56c500f4aa6b914fca3a724b5e7c15ae838cd33",
      "target_id": "ru-fr86-u034-b0131",
      "tag": "p",
      "target_sha256": "4437115b58a17e926ed48fe217d0dbe47d25253ba4be2fcccca5852c3ac1b807"
    },
    {
      "source_id": "fr86-u034-b0132",
      "target": "Школяр забился под печь. Там ему пришла в голову плодотворная мысль.",
      "source_sha256": "14eebc5378c287e5a5465072f122a48cdf63c155be9161991b3ff81fb892c53d",
      "target_id": "ru-fr86-u034-b0132",
      "tag": "p",
      "target_sha256": "078cc8194ff0332bf1c81f3a04f64115dc5c73a295d5a22e42d69921c7ee9153"
    },
    {
      "source_id": "fr86-u034-b0133",
      "target": "«Кстати, брат Клод, флорин за то, что я не буду дышать.",
      "source_sha256": "be3442a24cd61cc052b0ef9ac2a95d4cf65dbebcc1f1c9aae52b322c0f767a03",
      "target_id": "ru-fr86-u034-b0133",
      "tag": "p",
      "target_sha256": "e30e0f93501c5816fd32f62500fd2780ace937ab1d13ae97619b20b5d05016e0"
    },
    {
      "source_id": "fr86-u034-b0134",
      "target": "— Тише! Обещаю вам.",
      "source_sha256": "a39831d9882ba9a0fe80b4f13becc1d94a4537f4e08e5bb1a7abf9c157732f5d",
      "target_id": "ru-fr86-u034-b0134",
      "tag": "p",
      "target_sha256": "61cccd0d0f85ec3987307a33aa0a759dc488b24ba3535312dcb43148bca6a28c"
    },
    {
      "source_id": "fr86-u034-b0135",
      "target": "— Надо мне его отдать.",
      "source_sha256": "1410ede43107d4b455eb77a24d68b3f8fdb73d51b4f6a3681196393aead53f04",
      "target_id": "ru-fr86-u034-b0135",
      "tag": "p",
      "target_sha256": "658db85fcce1487a18e5204aca2fca8aa7ed3c304f23aab77060f134fd7ef2c8"
    },
    {
      "source_id": "fr86-u034-b0136",
      "target": "— Так возьми!» — сказал архидиакон, гневно бросив ему свой кошелёк.",
      "source_sha256": "e62f3eee5a9273320d45a3b0091f8f5762ebd1f16d1f5d8c4f2221664ba203ef",
      "target_id": "ru-fr86-u034-b0136",
      "tag": "p",
      "target_sha256": "1d5f8e48ae3a7f32381c64e36c1e5742db9139490f57e7ac55332d993e19417b"
    },
    {
      "source_id": "fr86-u034-b0137",
      "target": "Жеан снова забился поглубже под печь, и дверь отворилась.",
      "source_sha256": "3dd7e1312800fa932253a80f42e0b91ce92003d7a05cb0334c74e591cd685d33",
      "target_id": "ru-fr86-u034-b0137",
      "tag": "p",
      "target_sha256": "26f81b074a2141fee4c2d7111ea8dfb765bf79c6adb9504980456a641b14a136"
    }
  ],
