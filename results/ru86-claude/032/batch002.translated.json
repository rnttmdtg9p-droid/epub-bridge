  "rows": [
    {
      "source_id": "fr86-u032-b0064",
      "target": "И чело священника омрачилось.",
      "source_sha256": "a2e9b8549081e570518ca34a8d828ecb7baf71ace69ab72d06fc9ff0c6356f1b",
      "target_id": "ru-fr86-u032-b0064",
