{
  "unit": 55,
  "batch": 8,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr86-u055-b0256",
      "target": "— Друг мой, — возразил король, — вы говорите о битве. Здесь же мятеж. И я справлюсь с ним, стоит мне только нахмурить брови.»",
      "source_sha256": "7e647f0e835d7e01ba01e41c6d41f3c2ea5585c718438e0063014959c2b2b159",
      "target_id": "ru-fr86-u055-b0256",
      "tag": "p",
      "target_sha256": "4c78fe4ee5589220678d0611fbc5e6fda7d8cd239ba1bcb9504d8ffb94d6a6ae"
    },
    {
      "source_id": "fr86-u055-b0257",
      "target": "Тот отвечал с безразличием:",
      "source_sha256": "4ede0a2c6dcb96e6cd3c1715acedc6cdd864352b469c11ee62e9aa930dbb92bf",
      "target_id": "ru-fr86-u055-b0257",
      "tag": "p",
      "target_sha256": "9ae7e050fcbe4a3987261eb4ae1401f004446f69a5917d5c7b9d840a57f3ea43"
    },
    {
      "source_id": "fr86-u055-b0258",
      "target": "«Может быть, Государь. В таком случае это значит, что час народа ещё не пробил.»",
      "source_sha256": "b39b0bcdfcbeed0e42e219aa2ac57bd6dffa2cf2417a25779862a1333deb09b9",
      "target_id": "ru-fr86-u055-b0258",
      "tag": "p",
      "target_sha256": "8e2e181a8d44c38276c449dbcaace8c47b8fb5125343d3f11debd6942b6b4bba"
    },
    {
      "source_id": "fr86-u055-b0259",
      "target": "Гильом Рим счёл нужным вмешаться.",
      "source_sha256": "aea58bd78c58c2c80eae29daa019b86cf54413293c5ce454b8ad19a7309a2fd3",
      "target_id": "ru-fr86-u055-b0259",
      "tag": "p",
      "target_sha256": "8ab26dab5443cab832116ec5a2999ef6caf5c97eb79471df74f98ef788121590"
    },
    {
      "source_id": "fr86-u055-b0260",
      "target": "«Мэтр Коппеноль, вы говорите с могущественным королём.",
      "source_sha256": "83894f9ebaea5dbe3fabad7bcc19a980a997064f4899d6359f1d93416d6c430f",
      "target_id": "ru-fr86-u055-b0260",
      "tag": "p",
      "target_sha256": "ec2b6871eb4b773cd2b6f6840d1154a34f458cb5a1f9114861873687cc031713"
    },
    {
      "source_id": "fr86-u055-b0261",
      "target": "— Я знаю, — серьёзно ответил чулочник.",
      "source_sha256": "d43c648e254f2c1b60457677e9634b9f90ad4dd828c4b31aa605b8b57f2cf91c",
      "target_id": "ru-fr86-u055-b0261",
      "tag": "p",
      "target_sha256": "de9aab94410a2b7dbd888804c63aa0b75ba2f0dea379576ff52888b02556681f"
    },
    {
      "source_id": "fr86-u055-b0262",
      "target": "— Пусть его говорит, господин Рим, друг мой, — сказал король, — мне по душе такая прямота. Мой отец Карл Седьмой говорил, что истина больна. А я думал, что она умерла и так и не нашла себе духовника. Мэтр Коппеноль разубеждает меня.»",
      "source_sha256": "804a5fbc1f0075c5824df3ec07f6f68af7d0b405141b9957b15427895bfe3c71",
      "target_id": "ru-fr86-u055-b0262",
      "tag": "p",
      "target_sha256": "1a4f843d650e6bdcfcaa350c340ee4f763eac484c8de76f0e150b1913c840419"
    },
    {
      "source_id": "fr86-u055-b0263",
      "target": "Затем, по-свойски положив руку на плечо Коппенолю, он сказал:",
      "source_sha256": "caa1516d9588022f8525ddf7fdd35f6a37c5c1fcdf5824c3fd35c2d8fa40578d",
      "target_id": "ru-fr86-u055-b0263",
      "tag": "p",
      "target_sha256": "e8e0da6b1ad9378fdc8b0f5347f0d7cd89c0000f69e3f8c5fa04bc374df33545"
    },
    {
      "source_id": "fr86-u055-b0264",
      "target": "«Так что вы говорили, мэтр Жак?...",
      "source_sha256": "51a14d1d69bdaad6c39616e65cb861607f6b5f29d7f61ccccf08b4c65ee1425a",
      "target_id": "ru-fr86-u055-b0264",
      "tag": "p",
      "target_sha256": "73c923c52a4dfa041320cfad3d37a2d167c83560aa299fc269f6f7487b9b6504"
    },
    {
      "source_id": "fr86-u055-b0265",
      "target": "— Я говорю, Государь, что вы, пожалуй, правы и что у вас час народа не пробил.»",
      "source_sha256": "53f682cb483f84d0c04085e5cc72d9679c56a66960acac6655ce0937ca556d1e",
      "target_id": "ru-fr86-u055-b0265",
      "tag": "p",
      "target_sha256": "e24c438335a2dce63d503532575337c5b7acdf62511b9d216976e90cc292ba79"
    },
    {
      "source_id": "fr86-u055-b0266",
      "target": "Людовик XI посмотрел на него своим проницательным взглядом.",
      "source_sha256": "559b71f2e564c309e4efc407c948694bb51c06cc26d8dc400514c3b15407456c",
      "target_id": "ru-fr86-u055-b0266",
      "tag": "p",
      "target_sha256": "0ea5ee9d632b5e4207648253df75b74a1a57bbe59d08694c76d0c08b91484f8b"
    },
    {
      "source_id": "fr86-u055-b0267",
      "target": "«А когда настанет этот час, мэтр?",
      "source_sha256": "457788db908769a2b56853014b38f88ae774b5975d1d8b396f99bf3df4af3d3d",
      "target_id": "ru-fr86-u055-b0267",
      "tag": "p",
      "target_sha256": "50d3edfc8c17252982b9588a1c3ef7459addc27bc24b5093ac5fd5332f69b09e"
    },
    {
      "source_id": "fr86-u055-b0268",
      "target": "— Вы услышите, как он пробьёт.",
      "source_sha256": "70357686a0ef5ad3b56d66038390a4d2fcf6cfdc5a15b7d3ba14e60fb7cd27fa",
      "target_id": "ru-fr86-u055-b0268",
      "tag": "p",
      "target_sha256": "088b891338facb3d1adca9439628670ea2f2315486a4d54ab7c775ca44fd71f0"
    },
    {
      "source_id": "fr86-u055-b0269",
      "target": "— По каким же часам, скажите на милость?»",
      "source_sha256": "08fb05c3ff7b9ce5ac1f717e55fd3885b74a8703c97631f0fa33b127665b4b5b",
      "target_id": "ru-fr86-u055-b0269",
      "tag": "p",
      "target_sha256": "eb2ed0d26197c8bd8a30580f08b9b261518a815c45f77d427a556ebfdcf4c3ef"
    },
    {
      "source_id": "fr86-u055-b0270",
      "target": "Коппеноль со спокойным, простоватым видом подвёл короля к окну.",
      "source_sha256": "3528c2e1b1b4bb94cb3bff2126213bdbab2cea040f0037969ec7605c69564fcf",
      "target_id": "ru-fr86-u055-b0270",
      "tag": "p",
      "target_sha256": "ee5cb0aa3484b0134103ce7a12838e93e9fd67deec52fc08d5054456554c09ba"
    },
    {
      "source_id": "fr86-u055-b0271",
      "target": "«Слушайте, Государь! Здесь есть донжон, есть колокольня с набатом, есть пушки, есть горожане, есть солдаты. Когда загудит набат, когда загрохочут пушки, когда с великим шумом рухнет донжон, когда горожане и солдаты станут вопить и убивать друг друга — вот тогда этот час и пробьёт.»",
      "source_sha256": "df682d25fa1bcaa7e478093a5da9053904113f339c1ebe513ae3e9567dcec5ca",
      "target_id": "ru-fr86-u055-b0271",
      "tag": "p",
      "target_sha256": "adba0a2ac71431dd2a2de80dc767c66c243721cd70dba7e128fb0a246b3fd653"
    },
    {
      "source_id": "fr86-u055-b0272",
      "target": "Лицо Людовика стало мрачным и задумчивым. Он помолчал мгновение, затем легонько хлопнул рукой по толстой стене донжона, как похлопывают по крупу боевого коня. «О нет! — сказал он. — Не правда ли, ты не рухнешь так легко, моя добрая Бастилия?»",
      "source_sha256": "3d047274035ccf78ed1beef062f51ee4467e3fd2f111ca878054683309f7663d",
      "target_id": "ru-fr86-u055-b0272",
      "tag": "p",
      "target_sha256": "ac22c764d02677436cb9bcce6c21a75862738d9af4e51b253aa75a78ab5cfd1e"
    },
    {
      "source_id": "fr86-u055-b0273",
      "target": "И, резко обернувшись к смелому фламандцу, он спросил:",
      "source_sha256": "04de2ad7f525f27e3312e308a5d1f5d02dde7637ab88b60169a16e959a374ebf",
      "target_id": "ru-fr86-u055-b0273",
      "tag": "p",
      "target_sha256": "25605c725a8c6a3fa200b8d8c66583217c988211a6dbc90e304d1a1ac720b15d"
    },
    {
      "source_id": "fr86-u055-b0274",
      "target": "«Видели ли вы когда-нибудь мятеж, мэтр Жак?",
      "source_sha256": "0311988231a4b98ab93def02258ac68755e11b54409aa9f547136908cd08bed0",
      "target_id": "ru-fr86-u055-b0274",
      "tag": "p",
      "target_sha256": "a724e8fd6e59c42b39fad0b8d7e65353673517a65dcdf580666b7bccc2948f1a"
    },
    {
      "source_id": "fr86-u055-b0275",
      "target": "— Я сам их делал, — сказал чулочник.",
      "source_sha256": "63680b51f3cbf22321f2f31d4693c2e114230f79787b09c6c7ce8b71451999c3",
      "target_id": "ru-fr86-u055-b0275",
      "tag": "p",
      "target_sha256": "48912df18068d3c158a08a3929b1eab31b8535bed95c483de94cfb18d9bd9a5f"
    },
    {
      "source_id": "fr86-u055-b0276",
      "target": "— Как же вы это делаете, — спросил король, — чтобы поднять мятеж?",
      "source_sha256": "d0c9aebe331a2572e1c602351680e6b5234232c44812a4bd7e74dd5b64959401",
      "target_id": "ru-fr86-u055-b0276",
      "tag": "p",
      "target_sha256": "2b2e81f83637a4ddf7a32638294574d3ae98727fc56a471b5a953a262097fcff"
    },
    {
      "source_id": "fr86-u055-b0277",
      "target": "— Ах! — ответил Коппеноль. — Это не так уж трудно. Способов сотня. Прежде всего, нужно, чтобы в городе были недовольные. Дело нередкое. А затем — нрав жителей. Жители Гента легко идут на мятеж. Они всегда любят сына государя, а самого государя — никогда. Ну так вот! Однажды утром, предположим, входят в мою лавку и говорят мне: отец Коппеноль, случилось то-то и то-то, девица Фландрская хочет спасти своих министров, великий бальи удваивает налог на ту или иную вещь, или что-нибудь ещё. Что угодно. Я бросаю работу, выхожу из своей чулочной, иду на улицу и кричу: «Грабь!» Там всегда найдётся какая-нибудь вышибленная бочка. Я взбираюсь на неё и громко говорю первые пришедшие слова, то, что у меня на сердце; а у человека из народа, Государь, всегда есть что-нибудь на сердце. Тогда люди собираются толпой, кричат, бьют в набат, вооружают чернь, разоружая солдат, к ним присоединяются торговцы с рынка — и дело пошло! И так будет всегда, пока есть сеньоры в сеньориях, горожане в городах и крестьяне в краях.",
      "note": null,
      "source_sha256": "498d15b4b6a15a53e23cbea54e28d01f0066b0549a3a4b53dbd2bd355fdf9c4a",
      "target_id": "ru-fr86-u055-b0277",
      "tag": "p",
      "target_sha256": "9fd212a63301d713aeba6c62cddc768de9d3f1856e3910f10e9a357617625ab5"
    },
    {
      "source_id": "fr86-u055-b0278",
      "target": "— А против кого вы так восстаёте? — спросил король. — Против ваших бальи? Против ваших сеньоров?",
      "source_sha256": "849c05a4c63f6b2636c01d2efe331e9ea1dbcfc5051a683fce94a5056a15afed",
      "target_id": "ru-fr86-u055-b0278",
      "tag": "p",
      "target_sha256": "5f3a031af2bf2f96060e9738baaa5c98257b043f88a47bdb88d5d23f8ea1c12f"
    },
    {
      "source_id": "fr86-u055-b0279",
      "target": "— Случается. Смотря по обстоятельствам. Случается, и против герцога.»",
      "source_sha256": "1b38b72c3ca81d7acc21fb57bfc8543cd053e899002d90b98c5d2f9e0e456cc6",
      "target_id": "ru-fr86-u055-b0279",
      "tag": "p",
      "target_sha256": "c4cbb76e8450fd7b09e56dd05b3b09d034419c3c40780e1b4b3bf0e36d08f7b5"
    },
    {
      "source_id": "fr86-u055-b0280",
      "target": "Людовик XI вернулся на своё место и сказал с улыбкой:",
      "source_sha256": "52aab8565c49a855afd80a7acb7bfd2bae6e7776dc593f00470dac7c7dc9512a",
      "target_id": "ru-fr86-u055-b0280",
      "tag": "p",
      "target_sha256": "667b4d88a7d47daaf6d3bd3bb5f7118d9eba1b6479795c80e44850c0af2e6bb6"
    },
    {
      "source_id": "fr86-u055-b0281",
      "target": "«Ах! Здесь они пока дошли только до бальи!»",
      "source_sha256": "caa257c49773591fd2cd0ba8d5fd984c441ec89438525d6a975d8ddada01f30e",
      "target_id": "ru-fr86-u055-b0281",
      "tag": "p",
      "target_sha256": "eae53ba71a3f171d39005aaeb9987c0e352d82f60bcf619f761d1d43fdf5fb5f"
    },
    {
      "source_id": "fr86-u055-b0282",
      "target": "В этот миг вернулся Оливье ле Дэн. За ним шли двое пажей, несшие королевский туалет; но Людовика XI поразило то, что его сопровождали ещё парижский прево и начальник ночной стражи, и оба казались подавленными. Злопамятный цирюльник тоже казался подавленным, но втайне был доволен. Он и заговорил первым:",
      "source_sha256": "0de94a2e467bde25ae117561f98872a6b9e090bf1c2f2132be13e0eab43ec649",
      "target_id": "ru-fr86-u055-b0282",
      "tag": "p",
      "target_sha256": "97b8c23c492c3e249f09b5c2669f88e0529992ca47e89c0499d885d71511ade7"
    },
    {
      "source_id": "fr86-u055-b0283",
      "target": "«Государь, прошу прощения у Вашего Величества за злосчастную весть, которую я приношу.»",
      "source_sha256": "24851d961f76d5e20a366014c87d51a7eb705fed83950d39046f918dba28fc51",
      "target_id": "ru-fr86-u055-b0283",
      "tag": "p",
      "target_sha256": "732a50d801050b41434dedd4947093a5fb2f55bbdf09f2ef5553cd39baa44bea"
    },
    {
      "source_id": "fr86-u055-b0284",
      "target": "Король, резко обернувшись, ножками кресла содрал циновку с пола:",
      "source_sha256": "5b35425e44d787b40c6a91af41837b8d4a4594a1bbd30a6e69de019dda772e41",
      "target_id": "ru-fr86-u055-b0284",
      "tag": "p",
      "target_sha256": "ef6db2dcf7fe5ef816d612c5b2d4f80ad9b7a03cd16435d2ea7d5d52812c566c"
    },
    {
      "source_id": "fr86-u055-b0285",
      "target": "«Что это значит?",
      "source_sha256": "bfe37b71a5bc761e19721d9c8c417097d724ac384c053b084ef867af948382c7",
      "target_id": "ru-fr86-u055-b0285",
      "tag": "p",
      "target_sha256": "f5841052cb36218f8d78cc25f04f48c173d6e76c77198bff141e0851d8b99df0"
    },
    {
      "source_id": "fr86-u055-b0286",
      "target": "— Государь, — продолжал Оливье ле Дэн с недоброй миной человека, радующегося, что ему предстоит нанести тяжёлый удар, — этот народный мятеж обрушивается не на бальи Дворца.",
      "source_sha256": "09f3bc1be43e887d44df456106c4b60f77786e64c5848809c0fd1ed645c1b773",
      "target_id": "ru-fr86-u055-b0286",
      "tag": "p",
      "target_sha256": "7680fca08456d49bd6a4d6fa0da3e39aefa2c3b5f267e85a1cc26b82c4645a17"
    },
    {
      "source_id": "fr86-u055-b0287",
      "target": "— А на кого же?",
      "source_sha256": "68d31b1212a8248f0b25f4fdd94d222a2f2e6c324422540937694fea8b121a25",
      "target_id": "ru-fr86-u055-b0287",
      "tag": "p",
      "target_sha256": "dc90c624ad290741c691c066a76e6d5caea50585fed327302aa7dad9a8a904e9"
    }
  ],
