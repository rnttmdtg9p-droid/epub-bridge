{
  "unit": 15,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr86-u015-b0032",
      "target": "Он повысил голос: «Мадемуазель!»",
      "source_sha256": "5359d95f29c41cfbe8a289e2f793ea90f35204b12bc85d0885dbc445abbb78b2",
      "target_id": "ru-fr86-u015-b0032",
      "tag": "p",
      "target_sha256": "e9836c6ac9b777c70ea1ec9e379e276e09054cb3fe181df5f49845aacf1e9f4d"
    },
    {
      "source_id": "fr86-u015-b0033",
      "target": "Она, казалось, не слышала его.",
      "source_sha256": "a252c62f3247836cad69d9fb8d773b4263944784c5d78028cfb87093c305c114",
      "target_id": "ru-fr86-u015-b0033",
      "tag": "p",
      "target_sha256": "a0788dbf7d44f788ae65075e629dae28fe469549ce172e4dccb599be4e48c783"
    },
    {
      "source_id": "fr86-u015-b0034",
      "target": "Он повторил ещё громче: «Мадемуазель Эсмеральда!»",
      "source_sha256": "d990d5e9a51d24240510648a050d516ca4a532a8df52c04fd566966dc36bfc3a",
      "target_id": "ru-fr86-u015-b0034",
      "tag": "p",
      "target_sha256": "4e196bd8cfd0a32d1dfd95e78e5829c10027ac808ca5e65aab0279a51f8c8f8d"
    },
    {
      "source_id": "fr86-u015-b0035",
      "target": "Напрасный труд. Мысли девушки были далеко, и голос Гренгуара не имел власти вернуть их. К счастью, вмешалась коза. Она принялась тихонько тянуть хозяйку за рукав. «Чего ты хочешь, Джали? — живо спросила цыганка, словно внезапно очнувшись от сна.",
      "source_sha256": "1f386d807cdbd0fcab89043e41f1982e8ad19093f7a37bf71b4e51f3f7a79968",
      "target_id": "ru-fr86-u015-b0035",
      "tag": "p",
      "target_sha256": "fa842ad6162377ea8b019944d4abfc640f0d2b4609ce76f817585c05948cd922"
    },
    {
      "source_id": "fr86-u015-b0036",
      "target": "— Она голодна, — сказал Гренгуар, радуясь случаю завязать разговор.",
      "source_sha256": "9ff7dbc0074a27906c2a1d23e96dbae718a90c08d8ec0853ab1eada99504ffe6",
      "target_id": "ru-fr86-u015-b0036",
      "tag": "p",
      "target_sha256": "d789277fab36ab0b2cbddca3fb47b2365f4e3ea4e758bc3d7c691aaeb4c88a11"
    },
    {
      "source_id": "fr86-u015-b0037",
      "target": "Эсмеральда стала крошить хлеб, и Джали грациозно ела его из ладони.",
      "source_sha256": "ca7638418481312f978425308ea16d40828aea7c834252920db66724d05128d4",
      "target_id": "ru-fr86-u015-b0037",
      "tag": "p",
      "target_sha256": "0d7a71256126c0a5fab7cffe904c631f0b766fb4599c43cb72cd886ed00ebb96"
    },
    {
      "source_id": "fr86-u015-b0038",
      "target": "Впрочем, Гренгуар не дал ей времени вернуться к своим грёзам. Он отважился на щекотливый вопрос.",
      "source_sha256": "2b5162e28daa1d9a5ba1e9f2241d046135b6a9966b76b654f879e9b65d1acc4c",
      "target_id": "ru-fr86-u015-b0038",
      "tag": "p",
      "target_sha256": "f61ba465b6f6251d2fa7fd733243d5b03181c0b3712e3d2963240ef906587887"
    },
    {
      "source_id": "fr86-u015-b0039",
      "target": "«Так вы, значит, не хотите, чтобы я был вашим мужем?»",
      "source_sha256": "49279a735c0a1f9772a8bfb923988e47dc59c4a8ca38bce4c9cbdb93fd97180e",
      "target_id": "ru-fr86-u015-b0039",
      "tag": "p",
      "target_sha256": "dce81c4c376d7550a4d72dd06cf29802fa748022849cf22f0541958cb6415442"
    },
    {
      "source_id": "fr86-u015-b0040",
      "target": "Девушка пристально посмотрела на него и сказала: «Нет.",
      "source_sha256": "aa4c4697be5bb3d154e1e8a829a3d6feb6df6464aacb2841a489c78ae638e171",
      "target_id": "ru-fr86-u015-b0040",
      "tag": "p",
      "target_sha256": "2999cf56b73cc4b902fcb1d6049693ebd80ebfd0c097a565abfe317d7502c5f7"
    },
    {
      "source_id": "fr86-u015-b0041",
      "target": "— Или любовником? — продолжал Гренгуар.",
      "source_sha256": "1d1c2bb6ce1ae9247d45e76748437c47f96629c71a7af85360f509b0b94c3c1a",
      "target_id": "ru-fr86-u015-b0041",
      "tag": "p",
      "target_sha256": "014db1f73e7b338e97bd9d0b0460922747ed972e04d26c2e2e5bc6a6588b1e78"
    },
    {
      "source_id": "fr86-u015-b0042",
      "target": "Она сделала недовольную гримаску и ответила: «Нет.",
      "source_sha256": "69c6f2274bb9cda6d15671b0c24965a9543217008d08508d92cc0c3fcd845dbe",
      "target_id": "ru-fr86-u015-b0042",
      "tag": "p",
      "target_sha256": "db3cf0cd72167f638f06d39b9deadf221a605c2108503ac570c993367fe62af8"
    },
    {
      "source_id": "fr86-u015-b0043",
      "target": "— Или другом? — настаивал Гренгуар.",
      "source_sha256": "fd84affcac9086ee913bde90c2a70513305ac94d3c6298793dcd4488a4921e5d",
      "target_id": "ru-fr86-u015-b0043",
      "tag": "p",
      "target_sha256": "013a860b383fed8d3e2d6eab98e658f8c5351af7f49c4f0a9f056575acb833eb"
    },
    {
      "source_id": "fr86-u015-b0044",
      "target": "Она снова пристально посмотрела на него и, помедлив, сказала: «Может быть.»",
      "source_sha256": "d500a6ec822aaa8edbd1a1e3aaa7fa0e96a5e01fcee07ad401518c588d4b359e",
      "target_id": "ru-fr86-u015-b0044",
      "tag": "p",
      "target_sha256": "4c517b51e7ec74805549c36f5c383fbff76b7cec8fbdf790ec7854386286b9ae"
    },
    {
      "source_id": "fr86-u015-b0045",
      "target": "Это [[I]]может быть[[/I]], столь дорогое философам, придало Гренгуару смелости.",
      "source_sha256": "61c95d1fe691e2c1d5c40e1f448a6cde5e539d5eb659f59221048c917a3ba578",
      "target_id": "ru-fr86-u015-b0045",
      "tag": "p",
      "target_sha256": "600bb601d2e74f4d8ecab1e67e4a9c6268322670fb423f6507642dbd5ad8f7a0"
    },
    {
      "source_id": "fr86-u015-b0046",
      "target": "«Знаете ли вы, что такое дружба? — спросил он.",
      "source_sha256": "2850bfac6a8aac66ecd749fbf3612180e1fe2e9547798b8e8719c6bc3e8334a1",
      "target_id": "ru-fr86-u015-b0046",
      "tag": "p",
      "target_sha256": "7389cc352eb69d0d15db216cf05b5fc71367fde7664d6b38736066a89c8dc1c6"
    },
    {
      "source_id": "fr86-u015-b0047",
      "target": "— Да, — ответила цыганка. — Это быть братом и сестрой: две души, которые соприкасаются, не сливаясь, как два пальца одной руки.",
      "source_sha256": "6552da1f60f73d3687f95a8f4cc13f83999a69d0503066b3961f66754b1aabc1",
      "target_id": "ru-fr86-u015-b0047",
      "tag": "p",
      "target_sha256": "0b3bcb2b6bfbcff5fcb225d6d9f5ad9c0162ef2565c9da49c8a214301c52b60e"
    },
    {
      "source_id": "fr86-u015-b0048",
      "target": "— А любовь? — продолжал Гренгуар.",
      "source_sha256": "c2bf5f57a4f60a60af32a53b310194a0a85d2e0a1f10a9d2ef081ad328e1996f",
      "target_id": "ru-fr86-u015-b0048",
      "tag": "p",
      "target_sha256": "3483bf6486c3225034aae91f53e0acd0c3bbe79a29e21cfe3833967f448b06a6"
    },
    {
      "source_id": "fr86-u015-b0049",
      "target": "— О, любовь! — сказала она, и голос её дрожал, и глаза сияли. — Это быть двумя и стать одним. Мужчина и женщина, слитые в одного ангела. Это небо.»",
      "source_sha256": "d9c9b1cf86e3e050e77f39dc18c7af19f3957e62e51819e218a79b97fbc5017d",
      "target_id": "ru-fr86-u015-b0049",
      "tag": "p",
      "target_sha256": "58115c8f1cb452989d2169925adba498920e5296a7831e0f45b1316d87a5e395"
    },
    {
      "source_id": "fr86-u015-b0050",
      "target": "Уличная плясунья, говоря так, была необыкновенно прекрасна, и красота её поразила Гренгуара: она казалась ему в совершенном согласии с почти восточной восторженностью её слов. Её чистые розовые губы чуть улыбались; её ясный, безмятежный лоб временами мрачнел от мысли, как зеркало от дыхания; а из-под опущенных длинных чёрных ресниц струился какой-то неизъяснимый свет, придававший её профилю ту идеальную нежность, которую позднее Рафаэль нашёл в мистической точке пересечения девственности, материнства и божественности.",
      "source_sha256": "d8f404327030c0119ad22ddbdd027d507dfdcc3868454923c55d6922b4819d62",
      "target_id": "ru-fr86-u015-b0050",
      "tag": "p",
      "target_sha256": "a37b0ce98b6464c6e9fbbe88a605c8f3507774312a3bed92f6df5ee6df5a516a"
    },
    {
      "source_id": "fr86-u015-b0051",
      "target": "Тем не менее Гренгуар не отступил.",
      "source_sha256": "8846573b2f51c623d52acf3b091f5facc26b891f8a8a2db9529c3244d1fa2c73",
      "target_id": "ru-fr86-u015-b0051",
      "tag": "p",
      "target_sha256": "6886ec575b71807eaf93ac805e33260f40231ccd919645bc0d5760978945a2d4"
    },
    {
      "source_id": "fr86-u015-b0052",
      "target": "«Каким же надо быть, чтобы вам понравиться?",
      "source_sha256": "e9f9e92568b94350bd1fbe78827c78328b50e1ed2ccb05294d88f3877efba129",
      "target_id": "ru-fr86-u015-b0052",
      "tag": "p",
      "target_sha256": "9745d003f6a3cc4f6c54242fdb267cc3f1019b9cfff46c65020d5f19db25e6f3"
    },
    {
      "source_id": "fr86-u015-b0053",
      "target": "— Надо быть мужчиной.",
      "source_sha256": "fdadfd6b0281385bceba9b451fe82f585e29a0477539c1fcf9d51c21021d0fba",
      "target_id": "ru-fr86-u015-b0053",
      "tag": "p",
      "target_sha256": "b44309588600dee560fe2886ce09aa9462e3ff8c6e877ed86853847aaed06882"
    },
    {
      "source_id": "fr86-u015-b0054",
      "target": "— А я, — сказал он, — кто же я, по-вашему?",
      "source_sha256": "733aed1e69357d718efad630e4a656144ba7974e5948a4db495e8a2565b099ae",
      "target_id": "ru-fr86-u015-b0054",
      "tag": "p",
      "target_sha256": "e1c548b152180ae7a75cd666e4317382808ad6958d44c3b257e2d245384f549e"
    },
    {
      "source_id": "fr86-u015-b0055",
      "target": "— Мужчина — это тот, у кого шлем на голове, меч в руке и золотые шпоры на каблуках.",
      "source_sha256": "92693128975d00e3f759e7d546b57588f261508c42842597b66853bd1e8b3dea",
      "target_id": "ru-fr86-u015-b0055",
      "tag": "p",
      "target_sha256": "529591f8691f01f6ff231c7e625214ac467f5ca491ff0bb152048c0b5b753a7f"
    },
    {
      "source_id": "fr86-u015-b0056",
      "target": "— Так, — сказал Гренгуар, — без коня нет и мужчины. — А вы любите кого-нибудь?",
      "source_sha256": "a47a9d9df6438d024f65d32549f5701849dc0bfa429f496d41fb1200c381de0f",
      "target_id": "ru-fr86-u015-b0056",
      "tag": "p",
      "target_sha256": "4230ee5b4b1fb9c86e0c4629e6188f53520ab9269a2f0f7c7082196dbc2534c9"
    },
    {
      "source_id": "fr86-u015-b0057",
      "target": "— Любовью?",
      "source_sha256": "81a9773ac680a10ebc04fdfe8889de496b24c7fe10db11dd5c114366c441b9a2",
      "target_id": "ru-fr86-u015-b0057",
      "tag": "p",
      "target_sha256": "112b9af281583fe5b6501f772507076fdcb62c6ce7c9e1525db33f151b868c2d"
    },
    {
      "source_id": "fr86-u015-b0058",
      "target": "— Любовью.»",
      "source_sha256": "4282459f49c44c4a9f51d01f26ddcc4f3ed850b93ea846a1aa2ff14fe63a4be5",
      "target_id": "ru-fr86-u015-b0058",
      "tag": "p",
      "target_sha256": "2a6e9b6798bb9c1db4a1a93341bbee1cada66e0b353e2596421232fd518b6800"
    },
    {
      "source_id": "fr86-u015-b0059",
      "target": "Она на мгновение задумалась, затем сказала с особым выражением: «Скоро я это узнаю.",
      "source_sha256": "72ba20cbaa27248e02b131d8c3cb0e39ffd3f4d601271ec04ea1022782f324b5",
      "target_id": "ru-fr86-u015-b0059",
      "tag": "p",
      "target_sha256": "e344de174a3d76983b350159b0113f6e261cdb8751b2be6a2774ba742f9d4f66"
    },
    {
      "source_id": "fr86-u015-b0060",
      "target": "— Почему не сегодня вечером? — нежно спросил тогда поэт. — Почему не от меня?»",
      "source_sha256": "7a0dff3c920766c727d4b2b077667a0f472d2c67ea69a737753d202ac2301f44",
      "target_id": "ru-fr86-u015-b0060",
      "tag": "p",
      "target_sha256": "9ab9496ddc81eef39e839cbd8057eb400a6d2ed7cbc8be3456e306ab45adbf3d"
    },
    {
      "source_id": "fr86-u015-b0061",
      "target": "Она бросила на него серьёзный взгляд.",
      "source_sha256": "60ddd53af53f552d8582daa494daef87a8e241a4d04a81861bed520a5ac83f01",
      "target_id": "ru-fr86-u015-b0061",
      "tag": "p",
      "target_sha256": "aca49d9261f9c4f9401987a81bde8d74c4d063432d52ab3b63594154c22c5cb3"
    },
    {
      "source_id": "fr86-u015-b0062",
      "target": "«Я смогу полюбить только того, кто сумеет меня защитить.»",
      "source_sha256": "5715bb51db1e573a0b4e706056f1aca2ff1067134b1867ac1c02af2ad40d92f1",
      "target_id": "ru-fr86-u015-b0062",
      "tag": "p",
      "target_sha256": "f4f7a535a6666288979e918ba216569c2e7ab2194cd3f8351a5c9d4a5d617d51"
    },
    {
      "source_id": "fr86-u015-b0063",
      "target": "Гренгуар покраснел и принял это к сведению. Было очевидно, что девушка намекала на ту малую поддержку, которую он оказал ей в критический миг два часа назад. Это воспоминание, изгладившееся из его памяти другими приключениями вечера, вернулось к нему. Он хлопнул себя по лбу.",
      "source_sha256": "d664f51179ebd815982b1a097199490726bb3e361eeac7508db1653c9e01066b",
      "target_id": "ru-fr86-u015-b0063",
      "tag": "p",
      "target_sha256": "90b1c0c3916a512ca487ce77cd02294b45bb25c41c7377ada05d8c2c0dc05fe6"
    }
  ],
