{
  "unit": 4,
  "batch": 1,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr86-u004-b0032",
      "target": "— О, совсем ничего, — ответила Жискета.",
      "source_sha256": "46de8ef7ac7db5a47ca617390554bf97f0b5b03124daff8a502804486b7b6439",
      "target_id": "ru-fr86-u004-b0032",
      "tag": "p",
      "target_sha256": "824f219c8a993ef4e1105dc1facaf9a2d748412079ddeec3c1ba973ed7be926b"
    },
    {
      "source_id": "fr86-u004-b0033",
      "target": "— Ничего, — сказала Лиенарда.",
      "source_sha256": "f7bb70db5b5c9d4ce724d33a651283514621693f847653d92eb7e336ee9c36bf",
      "target_id": "ru-fr86-u004-b0033",
      "tag": "p",
      "target_sha256": "7e1437edff53358a6cb9f7cf740ad0af7ce466295673b4fffd28ef5d1b084a9a"
    },
    {
      "source_id": "fr86-u004-b0034",
      "target": "Высокий белокурый юноша шагнул, чтобы удалиться. Но две любопытные вовсе не хотели упускать добычу.",
      "source_sha256": "6e48bf4ee318a5e793515be9f25c9cdfc960d5756282a4c4279eff5147820c49",
      "target_id": "ru-fr86-u004-b0034",
      "tag": "p",
      "target_sha256": "46a3d7af19ca44ce37934d5f71ceb5b3ec7179761e2161389e38f7bad642bab1"
    },
    {
      "source_id": "fr86-u004-b0035",
      "target": "— Мессир, — живо сказала Жискета с порывистостью открывающегося шлюза или женщины, принявшей решение, — так вы знаете того солдата, что в мистерии будет играть госпожу Деву?",
      "source_sha256": "f143962994112e0519dbc92dabc8444af3d3efa79f14c167456efa87f3ee1549",
      "target_id": "ru-fr86-u004-b0035",
      "tag": "p",
      "target_sha256": "d6eca7d957253dc5761b215b74ea4072f11b89bbcfbb0efebb4e85fe8a3c2393"
    },
    {
      "source_id": "fr86-u004-b0036",
      "target": "— Вы хотите сказать, роль Юпитера? — переспросил незнакомец.",
      "source_sha256": "05d0d164122cf946b40f98cb0b9ac39d35ee5bd8914cf0d580fc0ccb210aadcd",
      "target_id": "ru-fr86-u004-b0036",
      "tag": "p",
      "target_sha256": "2da755fbdb3dcb8d433040d7f4a34b5b99596848c29523792e56e7b5ff5a39f6"
    },
    {
      "source_id": "fr86-u004-b0037",
      "target": "— Ну да! — сказала Лиенарда. — Какая же она глупая! Так вы знаете Юпитера?",
      "source_sha256": "21efef316f59a39bba5aaf9de43b739a93787125a32f085e44549e2ade0fc45b",
      "target_id": "ru-fr86-u004-b0037",
      "tag": "p",
      "target_sha256": "c9c79c76b8f7abefeb54108779165a1dee538e1964f9155a6b2f9d4f6a0568e2"
    },
    {
      "source_id": "fr86-u004-b0038",
      "target": "— Мишеля Жиборна? — ответил незнакомец. — Да, сударыня.",
      "source_sha256": "b0dc6d55494dcd075fae09cb8a0a190cc6a020e08fc46e898f5556f2dc5f98d7",
      "target_id": "ru-fr86-u004-b0038",
      "tag": "p",
      "target_sha256": "efbad52b59078367f8713297dd1257748c901f83654c5ddde9f1d5d39d7725a0"
    },
    {
      "source_id": "fr86-u004-b0039",
      "target": "— Ну и борода у него! — сказала Лиенарда.",
      "source_sha256": "a53f187ce1901d78ef29006e3cbe19c8086f9537e7698ccb316f8be2e2f02d20",
      "target_id": "ru-fr86-u004-b0039",
      "tag": "p",
      "target_sha256": "52a4e79526cc5d16cbfa08723ac535586294e08efdd73634c2347b444310e2b2"
    },
    {
      "source_id": "fr86-u004-b0040",
      "target": "— А будет ли красиво то, что они станут об этом говорить? — робко спросила Жискета.",
      "source_sha256": "9ae1262f24f536681ac85ffe93e8e8dd337ef50478bc96d2237dc0c538a333ab",
      "target_id": "ru-fr86-u004-b0040",
      "tag": "p",
      "target_sha256": "7633b6f421dcd16df0ebea990c31aefbb8c51097eea9874447b4160d4c287495"
    },
    {
      "source_id": "fr86-u004-b0041",
      "target": "— Очень красиво, мадемуазель, — ответил незнакомец без малейшего колебания.",
      "source_sha256": "5569d783e3d7a0f3919f0bd284bc429e065c87ae5e318deeb9434bd5259f9a81",
      "target_id": "ru-fr86-u004-b0041",
      "tag": "p",
      "target_sha256": "0037707e67178a129723af802bda4ababbb2971d27a31d57de47e38a0c3b3f28"
    },
    {
      "source_id": "fr86-u004-b0042",
      "target": "— А что это будет? — спросила Лиенарда.",
      "source_sha256": "f08eab72851bd00cf35729cf972a4140e425777066903a2e0d0717674d44983a",
      "target_id": "ru-fr86-u004-b0042",
      "tag": "p",
      "target_sha256": "bd8de46128c6daa56d168d7b9c91b98ee53a8d0b641f08c021f353c33d432636"
    },
    {
      "source_id": "fr86-u004-b0043",
      "target": "— [[I]]Праведный суд госпожи Девы[[/I]], моралите, если вам будет угодно, мадемуазель.",
      "source_sha256": "cf4374779f64e9a1796fb8a6ec187c11b26de354b0ba573f93e5a2c27a1e3754",
      "target_id": "ru-fr86-u004-b0043",
      "tag": "p",
      "target_sha256": "4394acc99ba900a0f488b5730a42d9cfde9ca8e8b4c499ab79e27968b8738dea"
    },
    {
      "source_id": "fr86-u004-b0044",
      "target": "— А, тогда другое дело, — отозвалась Лиенарда.",
      "source_sha256": "551c53870630fcf4b5760bd1a54b49b7db31478739282588ca18215aec913c78",
      "target_id": "ru-fr86-u004-b0044",
      "tag": "p",
      "target_sha256": "b3df3d1d8b0f62efddd98f1f041bf263e3f3faad22612cc02e7a145facb573c8"
    },
    {
      "source_id": "fr86-u004-b0045",
      "target": "Наступило недолгое молчание. Незнакомец нарушил его:",
      "source_sha256": "90dd47cda566c48323fa80299369410793779ee2e73ebd7624dd5f2136055425",
      "target_id": "ru-fr86-u004-b0045",
      "tag": "p",
      "target_sha256": "764d706cb5b91ec9936b4a781db9aa07d77bad0fdea30a839f6d8ff460d6e252"
    },
    {
      "source_id": "fr86-u004-b0046",
      "target": "— Это совсем новое моралите, которое ещё нигде не игралось.",
      "source_sha256": "2610d811ab26c62bbde6698ba59434051f311eceeb019e2b7162d622181b91d2",
      "target_id": "ru-fr86-u004-b0046",
      "tag": "p",
      "target_sha256": "85cb33177602e1b1d1d5ba36b0dd96c6cbf12024d61718987b226d645ea6e7c3"
    },
    {
      "source_id": "fr86-u004-b0047",
      "target": "— Значит, это не то же самое, — сказала Жискета, — что давали два года назад, в день въезда господина легата, когда три красивые девицы изображали персонажей...",
      "source_sha256": "1e8232e95e04d9b61038217a46db9c2276eb39667ee91cd026a6d0ad42f6e310",
      "target_id": "ru-fr86-u004-b0047",
      "tag": "p",
      "target_sha256": "76575a8345c17a001bf62298afd14de17b71d630b08f09a13daf27696a99d987"
    },
    {
      "source_id": "fr86-u004-b0048",
      "target": "— Сирен, — сказала Лиенарда.",
      "source_sha256": "0431beb554e3977085e3a26a917c0b56b9afb2b4186b64a72df454000e7cdbe0",
      "target_id": "ru-fr86-u004-b0048",
      "tag": "p",
      "target_sha256": "2837af673c7c0d31031a1ac8b214d10bee17e9a025c2186c1b965a208a4ab67b"
    },
    {
      "source_id": "fr86-u004-b0049",
      "target": "— И совсем нагих, — добавил молодой человек.",
      "source_sha256": "92fcbf065039b03863fc045ea56cdcbb2bc8bbb72c5f1e0e850f42306288051e",
      "target_id": "ru-fr86-u004-b0049",
      "tag": "p",
      "target_sha256": "d6e19ba1a5a2a57b5dd7a043fcea09425f24bc34a15c2d767ce9eef489d293b1"
    },
    {
      "source_id": "fr86-u004-b0050",
      "target": "Лиенарда стыдливо опустила глаза. Жискета взглянула на неё и сделала то же. Он продолжал с улыбкой:",
      "source_sha256": "1f4a8ee92824684d0379150206f148c506456194cfde395867df3f90cbd2fcf3",
      "target_id": "ru-fr86-u004-b0050",
      "tag": "p",
      "target_sha256": "e3f68f07fd9ff369a10b68860f603e3a18795d0c85ae789188fc69021d33e6ea"
    },
    {
      "source_id": "fr86-u004-b0051",
      "target": "— Это было весьма забавно видеть. Нынче же — моралите, нарочно сочинённое для госпожи фландрской принцессы.",
      "source_sha256": "5484c1e4a5a291c215f382a9f28d40f250b5416f2a28a26028a35e8008081d33",
      "target_id": "ru-fr86-u004-b0051",
      "tag": "p",
      "target_sha256": "5a9e25b00499e64de067ebf3fcaf5103ceedf1ee76890f572d25b033092cff7e"
    },
    {
      "source_id": "fr86-u004-b0052",
      "target": "— А будут ли петь пастушеские песенки? — спросила Жискета.",
      "source_sha256": "753932ef22e9adfeecfd4b31814a0bb878f2172ac58bf2ee14f4ec3841680df9",
      "target_id": "ru-fr86-u004-b0052",
      "tag": "p",
      "target_sha256": "70f2dabac79f03526480c1c85a2483b17d3e38e83e206d94eb68db8dd8367029"
    },
    {
      "source_id": "fr86-u004-b0053",
      "target": "— Фи! — сказал незнакомец. — В моралите! Не следует смешивать жанры. Если бы это была сотти — тогда пожалуйста.",
      "source_sha256": "96565bac355672e5f0649636ceb21dcd21980ccbce19999e55db162a3fb1b3f7",
      "target_id": "ru-fr86-u004-b0053",
      "tag": "p",
      "target_sha256": "2fead8f07ff1836484bee1403b8c651438941db88480ed36cd6e4b92bf5cd409"
    },
    {
      "source_id": "fr86-u004-b0054",
      "target": "— Жаль, — продолжала Жискета. — В тот день у фонтана Понсо дикие мужчины и женщины сражались друг с другом и принимали разные позы, распевая коротенькие мотеты и пастушеские песенки.",
      "source_sha256": "07b3d915fab7e79daabdb35068ba5aa2274f8e096933d3e90d26c1bc2420aa2b",
      "target_id": "ru-fr86-u004-b0054",
      "tag": "p",
      "target_sha256": "b65ecccfb4856194bedae8f9fdd8bf847db6c743c2d0f92e9d10b99f303dc111"
    },
    {
      "source_id": "fr86-u004-b0055",
      "target": "— Что годится для легата, — довольно сухо сказал незнакомец, — то не годится для принцессы.",
      "source_sha256": "f2b2b385654b814b6a7b0353c0a7c52132673ab9a30774bf424fd5791082f7b9",
      "target_id": "ru-fr86-u004-b0055",
      "tag": "p",
      "target_sha256": "558c49d3020306967aa4cb75b2f13e3e99e192a166eb0ec248654d7b1d7c6ee0"
    },
    {
      "source_id": "fr86-u004-b0056",
      "target": "— А рядом с ними, — подхватила Лиенарда, — состязались несколько негромких инструментов, которые играли чудесные мелодии.",
      "source_sha256": "f6b8f88e3300fa0aee2538c8e9a81e0d37825315ad005facb407f63d907ddf25",
      "target_id": "ru-fr86-u004-b0056",
      "tag": "p",
      "target_sha256": "66f39c5e58deb3b3e761b7f7af451851fdd76f7b68ed5e5977450dec5e391ac4"
    },
    {
      "source_id": "fr86-u004-b0057",
      "target": "— А чтобы освежить прохожих, — продолжала Жискета, — фонтан изливал из трёх отверстий вино, молоко и ипокрас, и пил кто хотел.",
      "source_sha256": "f55b4ea72b373b2a4743d52dc524f7383f58196d4dcf1a2eb199009fc2b786d2",
      "target_id": "ru-fr86-u004-b0057",
      "tag": "p",
      "target_sha256": "b61b9bccc64f1137d8a39d2f5d663206d068cf2106a2de205f44ba4f59226697"
    },
    {
      "source_id": "fr86-u004-b0058",
      "target": "— А немного ниже Понсо, — вторила Лиенарда, — у Троицы, представляли Страсти в лицах, без слов.",
      "source_sha256": "fc4e31bd8e31eb0050f51a3c47f95c757bf9d73cf8a273b0c71aa7f7944589cb",
      "target_id": "ru-fr86-u004-b0058",
      "tag": "p",
      "target_sha256": "bb55350c5d8f0b3074a302056495a8a32fcfda5eb2a8835eab4be3a246195692"
    },
    {
      "source_id": "fr86-u004-b0059",
      "target": "— Как же мне не помнить! — воскликнула Жискета. — Господь на кресте, а справа и слева два разбойника!",
      "source_sha256": "cf2151a73a18c32a448c9be6cb5b988748e8c3c6796ed72d6bb8796121dcd9e1",
      "target_id": "ru-fr86-u004-b0059",
      "tag": "p",
      "target_sha256": "47042971f7c42521c40457ea67b2ee6bb3889bc09521374597f6b509f9b19feb"
    },
    {
      "source_id": "fr86-u004-b0060",
      "target": "Тут молодые кумушки, разгорячившись от воспоминания о въезде господина легата, принялись говорить обе разом.",
      "source_sha256": "e51fce598b946daa0f060b3eaa825a1f9244e337f7f637cd208ef58af5b66226",
      "target_id": "ru-fr86-u004-b0060",
      "tag": "p",
      "target_sha256": "fc7c4b5fb1ec66475409ef263b1980c5a345d3177f7707e56d172db1a2a9b9b0"
    },
    {
      "source_id": "fr86-u004-b0061",
      "target": "— А дальше, у ворот Живописцев, были другие особы, очень богато одетые.",
      "source_sha256": "18b55b19e9f763b6dfb75b38d1c8d1a12c1e678fb032f8302262950f47cda609",
      "target_id": "ru-fr86-u004-b0061",
      "tag": "p",
      "target_sha256": "684f19d57b7cafccb161892932a33ca03060ec75759d576ded8f9564366cc2cc"
    },
    {
      "source_id": "fr86-u004-b0062",
      "target": "— А у фонтана Сент-Инносан тот охотник, что гнался за ланью, с превеликим шумом собак и охотничьих рогов!",
      "source_sha256": "941ad1d78825348a58d2f9f358a9f18260307509aefd7ab07ed87a308628b547",
      "target_id": "ru-fr86-u004-b0062",
      "tag": "p",
      "target_sha256": "1516d8f724511d98606c51dbfda17e1573698757e4b36c04d1cac33de2d70748"
    },
    {
      "source_id": "fr86-u004-b0063",
      "target": "— А у парижской бойни те подмостки, что изображали дьеппскую бастилию!",
      "source_sha256": "6ecb7babff7819a00a8be82317e61f6fb53f5b7bc2615820291747f86f6ba7ce",
      "target_id": "ru-fr86-u004-b0063",
      "tag": "p",
      "target_sha256": "abc33c7416930de7cf4d39b8a2f60e80a4a73d4f27a50d3c537888c21d06f933"
    }
  ],
