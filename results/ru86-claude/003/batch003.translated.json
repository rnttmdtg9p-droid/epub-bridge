{
  "unit": 3,
  "batch": 3,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr86-u003-b0084",
      "target": "— Скажи-ка, Робен Пуспен, а это ещё кто такой?",
      "source_sha256": "087ba7789e023de1ab7d8ff695a139695d875e2ea97dd3c3093cb9b8dddd8538",
      "target_id": "ru-fr86-u003-b0084",
      "tag": "p",
      "target_sha256": "b21673d208fca8b7aacc6f5e61c1c0d53f04d0a59e4838ab3017cceef7e3f746"
    },
    {
      "source_id": "fr86-u003-b0085",
      "target": "— Это Жильбер де Сюийи, [[I]]Gilbertus de Soliaco[[/I]], канцлер Отёнского коллежа.",
      "source_sha256": "d14deaf261964fa69dff39121da059efae172724761792924559f9466181a1b0",
      "target_id": "ru-fr86-u003-b0085",
      "tag": "p",
      "target_sha256": "a7b19ae3cd093d762c8f4ec149204620cd6b92de09e296e5ab28270952f911e8"
    },
    {
      "source_id": "fr86-u003-b0086",
      "target": "— На, вот мой башмак: тебе оттуда лучше целиться, чем мне; запусти ему прямо в рожу.",
      "source_sha256": "e54c235c409d6b87150f992c26695f8723011a63849b212ebf104cedb8347412",
      "target_id": "ru-fr86-u003-b0086",
      "tag": "p",
      "target_sha256": "c27fba431fd9155aacbc18956ded8ed4b3c247837e10a704bae23fec60b49147"
    },
    {
      "source_id": "fr86-u003-b0087",
      "target": "— [[I]]Saturnalitias mittimus ecce nuces[[/I]][[N6]].",
      "source_sha256": "76066eb0119782a506a44093842680bfb7510f76855f01cb4af637649f150687",
      "target_id": "ru-fr86-u003-b0087",
      "tag": "p",
      "target_sha256": "49a19753ca89d42ea2b5bef276c9162a951395df7aa3ec2cc86deb5078061584"
    },
    {
      "source_id": "fr86-u003-b0088",
      "target": "— Долой шестерых богословов в белых стихарях!",
      "source_sha256": "f9dad4d39e12e26e00fca2dfd2fba91c2ceb92ccf6a9d28b41a5547075abb195",
      "target_id": "ru-fr86-u003-b0088",
      "tag": "p",
      "target_sha256": "e0fbd63c74e2cb29c30f2ca4c282d24f31c788edd8db61b547778d972d973b46"
    },
    {
      "source_id": "fr86-u003-b0089",
      "target": "— Так это богословы? А я думал, это шесть белых гусей, которых святая Женевьева подарила городу за ленное владение Ругни.",
      "source_sha256": "7fc045bad419a8df21890f3929197fbf73ff5ecaf6a29fc71d64fd152430296f",
      "target_id": "ru-fr86-u003-b0089",
      "tag": "p",
      "target_sha256": "0d867e9186141ba5349ea1c00bcd225201dc285dab51838111c89dc2195012e2"
    },
    {
      "source_id": "fr86-u003-b0090",
      "target": "— Долой лекарей!",
      "source_sha256": "c64bbf951e6371ec22299976f7c9e383b3fe8aa3782943096a73909d009773e4",
      "target_id": "ru-fr86-u003-b0090",
      "tag": "p",
      "target_sha256": "e3a5975029ff340d77bd8653c1e73d864b2869d832289b4352fdfd3763d3c9b2"
    },
    {
      "source_id": "fr86-u003-b0091",
      "target": "— Долой кардинальские и кводлибетные диспуты!",
      "source_sha256": "76c10e6479e7fdec52dfeaf77be31ad87caf754ebbb267ecde6cb45b7f0cfe93",
      "target_id": "ru-fr86-u003-b0091",
      "tag": "p",
      "target_sha256": "ab7546716a8bd6566f7049a06abfd1146b7f2560b30826d14c334367be81ee0c"
    },
    {
      "source_id": "fr86-u003-b0092",
      "target": "— Вот тебе моя шапочка, канцлер Сент-Женевьев! Ты обошёл меня несправедливостью. — А ведь правда! Он отдал моё место в Нормандской нации маленькому Асканио Фальцаспаде, который из провинции Бурж, потому что он итальянец.",
      "source_sha256": "5865437145fc5aebb6ac9856f222fc48900a8497f8dd0d2cc1a6c8441d84f997",
      "target_id": "ru-fr86-u003-b0092",
      "tag": "p",
      "target_sha256": "10b6a6b226b6d3c4b51bde47a92aa8f5ed8e75e8320d7295e94c06e2d317d3b4"
    },
    {
      "source_id": "fr86-u003-b0093",
      "target": "— Это несправедливо, — сказали все школяры. — Долой канцлера Сент-Женевьев!",
      "source_sha256": "b38825b6366ad522bc6f8ced6e1908b1c53d72c23e37f73095057a6b8b0fbc05",
      "target_id": "ru-fr86-u003-b0093",
      "tag": "p",
      "target_sha256": "f9efad959a8c00a9bd522b4cd2305ff20a176207b61d42bba84cee662bd8c076"
    },
    {
      "source_id": "fr86-u003-b0094",
      "target": "— Эй, эй! Мэтр Жоашен де Ладор! Эй, эй! Луи Дагюй! Эй, эй! Ламбер Октман!",
      "source_sha256": "4a182a51bd246b6e07183a6a11b9388a173a3584622d4e5ce8559aa440375be6",
      "target_id": "ru-fr86-u003-b0094",
      "tag": "p",
      "target_sha256": "10e665b9abc0713493ae0d8018f0d55206415e7a17d27358f788532cbb0eb422"
    },
    {
      "source_id": "fr86-u003-b0095",
      "target": "— Чтоб дьявол задушил прокурора Германской нации!",
      "source_sha256": "e2f3f312136eb2cf94b616d7c0f4052bc06420947c3e2d54973118ffaa5df31e",
      "target_id": "ru-fr86-u003-b0095",
      "tag": "p",
      "target_sha256": "0321de9551d2cb549c3e05a269f96e6af7960e65fcd7eac0db6bdd734c2ed331"
    },
    {
      "source_id": "fr86-u003-b0096",
      "target": "— И капелланов Сент-Шапель в серых капюшонах; [[I]]cum tunicis grisis[[/I]]!",
      "source_sha256": "c2ddbc91e3bce6cc0de1e6846e9376f9cfe2abb6eda2fe2df02e41bca86b91c1",
      "target_id": "ru-fr86-u003-b0096",
      "tag": "p",
      "target_sha256": "2de4b4afd5a31417533c42f48a79b8bb5f1fec24f15447976b3685033e0bbafc"
    },
    {
      "source_id": "fr86-u003-b0097",
      "target": "— [[I]]Seu de pellibus grisis fourratis[[/I]][[N7]]!",
      "source_sha256": "c260e974082318ab4bed566c6dcc7d387ed03ec1da23ad615acbf08ce967598f",
      "target_id": "ru-fr86-u003-b0097",
      "tag": "p",
      "target_sha256": "80a2431b79e6269002984025f17e170f8b35d766a62c05fc9d74f68a3e08766f"
    },
    {
      "source_id": "fr86-u003-b0098",
      "target": "— Эгей! Магистры свободных искусств! Все эти прекрасные чёрные мантии! Все эти прекрасные красные мантии!",
      "source_sha256": "56cba45aa4dcecf44a4cb351461266f2a42b529d41b8d3d247665f7d44730f97",
      "target_id": "ru-fr86-u003-b0098",
      "tag": "p",
      "target_sha256": "519b56352f6958e160dc8b368b2db720446003957df4eb013171a4c6e4a4c620"
    },
    {
      "source_id": "fr86-u003-b0099",
      "target": "— Славный шлейф получился у ректора.",
      "source_sha256": "2302cecc2188973b6586fe8b74a20817b7433f2f8dfb168250a98adef5d379ad",
      "target_id": "ru-fr86-u003-b0099",
      "tag": "p",
      "target_sha256": "c8dca23c5c1e91fda144f8fdfc89346b2d441b91af9702ed8b20a3b110ff62aa"
    },
    {
      "source_id": "fr86-u003-b0100",
      "target": "— Ни дать ни взять венецианский дож, идущий на обручение с морем.",
      "source_sha256": "1512debf1e506989d5b9ee4b0446ac67a899c2c616a4f55bc068f4a8aae8b1a5",
      "target_id": "ru-fr86-u003-b0100",
      "tag": "p",
      "target_sha256": "5b5356e80ddbe2445852b68f8a26a92fd345c0f2a30b28d6fcf458aa2abd0eac"
    },
    {
      "source_id": "fr86-u003-b0101",
      "target": "— Слышь, Жеан! Каноники Сент-Женевьев!",
      "source_sha256": "25171af055abd537e05448355bc3e76b60aeee57dc9c144ee0c448701fdff465",
      "target_id": "ru-fr86-u003-b0101",
      "tag": "p",
      "target_sha256": "03a4304840d84608028ee926a85a6fb84995b653b40c9e60a4b76d9fa5f17524"
    },
    {
      "source_id": "fr86-u003-b0102",
      "target": "— К дьяволу всё это каноничество!",
      "source_sha256": "37823bd2b98394d427e2780c3f1abecadba53578b6bf726152e382f47fd551be",
      "target_id": "ru-fr86-u003-b0102",
      "tag": "p",
      "target_sha256": "759aa5b6f7b7c815f3deeafc3ca8f42ced89bd11e4892dfcae89b5dc0205557d"
    },
    {
      "source_id": "fr86-u003-b0103",
      "target": "— Аббат Клод Шоар! Доктор Клод Шоар! Вы, часом, не Мари Жиффарду ищете?",
      "source_sha256": "b5a95a663fb70ce2e4d7f1c66cf01e604c5b6c53aae9c64bc621afaff1a557b6",
      "target_id": "ru-fr86-u003-b0103",
      "tag": "p",
      "target_sha256": "71a84bf42b34a78e70fa01a2f138f3447815b66d76e424b18acfac7810716cc0"
    },
    {
      "source_id": "fr86-u003-b0104",
      "target": "— Она на улице Глатиньи.",
      "source_sha256": "0755063db3e7237afe687b259dcf982539451bf0df423d10662e69f9c7455579",
      "target_id": "ru-fr86-u003-b0104",
      "tag": "p",
      "target_sha256": "3d2294a4bffe5441b37ccea5542c3edf11022782cab7ce47a13299d4144f3fda"
    },
    {
      "source_id": "fr86-u003-b0105",
      "target": "— Стелет постель королю рибодов.",
      "source_sha256": "1ac9335c21c1e723483c9c2dddd470fc01d3727f448d02510483e216797817a1",
      "target_id": "ru-fr86-u003-b0105",
      "tag": "p",
      "target_sha256": "db750629830fdde50f80f51b8107d9cc38b2155e533469ce077f0d82520c4b5f"
    },
    {
      "source_id": "fr86-u003-b0106",
      "target": "— Платит свои четыре денье; [[I]]quatuor denarios[[/I]].",
      "source_sha256": "7ec2de852762803c122bb2233205a6dede904c512619d10bfdc69d4c3306baac",
      "target_id": "ru-fr86-u003-b0106",
      "tag": "p",
      "target_sha256": "06c44173647c9a598317b902b9a8ef14984808c3b844a2edb93bcad04384f2a4"
    },
    {
      "source_id": "fr86-u003-b0107",
      "target": "— [[I]]Aut unum bombum[[/I]][[N8]].",
      "source_sha256": "0afe4de3fa2a92ee3a8afa9e7501b5e4ec2e4e11e14c38e18876946d8bf15b2a",
      "target_id": "ru-fr86-u003-b0107",
      "tag": "p",
      "target_sha256": "b85edd344611dc1d52baa61d01f4c2ff09d64d0dd8c507ddb5151b436ffa4df8"
    },
    {
      "source_id": "fr86-u003-b0108",
      "target": "— Хотите, чтобы она расплатилась с вами прямо по носу?",
      "source_sha256": "148295ccccf6b23e310cba42f34798a53b8a99815684ef85b7987e7e6fd1bb96",
      "target_id": "ru-fr86-u003-b0108",
      "tag": "p",
      "target_sha256": "92c1488659b73442da93b0f938e42d38793636c20cfc0534f22d4ca5d4c17595"
    },
    {
      "source_id": "fr86-u003-b0109",
      "target": "— Товарищи! Мэтр Симон Сангюэн, выборщик от Пикардии, а жена у него на крупе!",
      "source_sha256": "d3db2b7e6a716cf3c5f4730e08de3af17fbb2de1d905066b712fb9c63dc7c577",
      "target_id": "ru-fr86-u003-b0109",
      "tag": "p",
      "target_sha256": "26b7a6cd63f8b24fcb2e3bc530e4678e728e717cf1d974896b124601936df28f"
    },
    {
      "source_id": "fr86-u003-b0110",
      "target": "— [[I]]Post equitem sedet atra cura[[/I]][[N9]].",
      "source_sha256": "463a14daa3a7a218b7a21989745b46612e1089d3c3b7df87eef47c9925fb874b",
      "target_id": "ru-fr86-u003-b0110",
      "tag": "p",
      "target_sha256": "b26596cc63cdd17938c2e299c67b47626156e76c0065399deb0e4a4dcb7f3077"
    },
    {
      "source_id": "fr86-u003-b0111",
      "target": "— Смелей, мэтр Симон!",
      "source_sha256": "4ef55f47acae58f2adad6a38a20275d14f6e7a5bb3a84279a693e7089ed52e8c",
      "target_id": "ru-fr86-u003-b0111",
      "tag": "p",
      "target_sha256": "a532bb0939feb8d6202ef2a5cbce4add8399a6bf4f1e6c3775b25808bf24f15f"
    },
    {
      "source_id": "fr86-u003-b0112",
      "target": "— Добрый день, господин выборщик!",
      "source_sha256": "8ca665e025291755ff3bcf5851855f0cfb7ae869ae415a1507de024ebeca8958",
      "target_id": "ru-fr86-u003-b0112",
      "tag": "p",
      "target_sha256": "6834407aea86cd0f1690dee8607e891bb5aa8803e91e911b5cd0444a507a4fec"
    },
    {
      "source_id": "fr86-u003-b0113",
      "target": "— Доброй ночи, госпожа выборщица!",
      "source_sha256": "960f5cba7b27e87df99982f600036efd5b6faf0147652480ede4ec10e2512192",
      "target_id": "ru-fr86-u003-b0113",
      "tag": "p",
      "target_sha256": "3157d5f9aae1ea4ef65feaa06417858d12bed8c6ca1bce9bbb30e28a16ad69f6"
    },
    {
      "source_id": "fr86-u003-b0114",
      "target": "— Как же они счастливы, что видят всё это», — со вздохом говорил [[I]]Joannes de Molendino[[/I]], всё ещё сидевший среди листвы своей капители.",
      "source_sha256": "869178e543c61e9c2e0ddbdaff14caf070efbb79dadadc58a6a16aaf6f90bd1a",
      "target_id": "ru-fr86-u003-b0114",
      "tag": "p",
      "target_sha256": "d109279ecd2c779bf0bc9b9429cbf78091e48f166c3bb29db708887fbe6852e5"
    },
    {
      "source_id": "fr86-u003-b0115",
      "target": "Между тем присяжный книготорговец Университета мэтр Андри Мюнье склонился к уху королевского меховщика-скорняка, делавшего мантии для короля, мэтра Жиля Лекорню.",
      "source_sha256": "19c81eea9cfbc2c3ddf95cd83c446f804cd54f614dab9fa9301548a8d56eca96",
      "target_id": "ru-fr86-u003-b0115",
      "tag": "p",
      "target_sha256": "1ddbd3549a041a4f3eeae4e02f0c76ee80a1e01b1f900a70742f2a708c80f802"
    }
  ],
