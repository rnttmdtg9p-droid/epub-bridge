{
  "unit": 3,
  "batch": 2,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "fr86-u003-b0052",
      "target": "Мэтр Андри поднял глаза, словно на миг прикинул высоту столба и вес пострела, мысленно умножил этот вес на квадрат скорости — и умолк.",
      "source_sha256": "61b75624ad66e742fc349a24d66ab7b6e1e6670b72d62a50307cdcdf5e6537de",
      "target_id": "ru-fr86-u003-b0052",
      "tag": "p",
      "target_sha256": "a7f8369d53dc32376b0c90249689daee5942abbb5e4bd1869c4eb03432f1d698"
    },
    {
      "source_id": "fr86-u003-b0053",
      "target": "Жеан, хозяин поля битвы, торжествуя, продолжал:",
      "source_sha256": "057ed58eb3c2b1c92fb30f83adf8c900dc9e94b90301f1470d8431f595b78c15",
      "target_id": "ru-fr86-u003-b0053",
      "tag": "p",
      "target_sha256": "2a061a3e80f68f6214a3490e90a26f81e70e2e40ece62b91ec33adcb2cebe3ed"
    },
    {
      "source_id": "fr86-u003-b0054",
      "target": "«Да, я так и сделаю, хоть я и брат архидиакона!",
      "source_sha256": "fb6e7a506389b6fcd42d2bc98c04299524f474ec6cff841b7c24e6751ca6b1c9",
      "target_id": "ru-fr86-u003-b0054",
      "tag": "p",
      "target_sha256": "0571cfcd055b90ab41144a8e2f60d8a05fb322f9d218ba6871ba685737e841c6"
    },
    {
      "source_id": "fr86-u003-b0055",
      "target": "— Хороши молодцы, нечего сказать, эти наши университетские! Не суметь даже отстоять наши привилегии в такой день, как сегодня! Ну как же: в Городе — майское дерево и праздничный костёр; в Сите — мистерия, папа шутов и фламандские послы; а в Университете — ничего!",
      "source_sha256": "fe19511aedb32a4b6434be4d4aaabd54359438d169fb02a055816f37567470d8",
      "target_id": "ru-fr86-u003-b0055",
      "tag": "p",
      "target_sha256": "49a49358bf77ff2e8cf86881c7a74c63344dbea5f309ee5352d3d105cc169038"
    },
    {
      "source_id": "fr86-u003-b0056",
      "target": "— А между тем площадь Мобер довольно велика! — подхватил один из школяров, расположившихся на столе у окна.",
      "source_sha256": "df4231c4a826cbdd577a4a65b2f7e39383c665fa641a50bd88f2b171c428a9ff",
      "target_id": "ru-fr86-u003-b0056",
      "tag": "p",
      "target_sha256": "d059af2ccaf1caf840ca883c3ef5a0855f0ba9c894fd2c2c6f4d3cfeafda2cd6"
    },
    {
      "source_id": "fr86-u003-b0057",
      "target": "— Долой ректора, выборщиков и прокураторов! — закричал Иоаннес.",
      "source_sha256": "59f7647c2ce1a12e4132074e695bcb9cfc38757526a17dcaddb9e64f606f3b44",
      "target_id": "ru-fr86-u003-b0057",
      "tag": "p",
      "target_sha256": "0ad3b601f4e99d925b1480a24df42ad1989ca52c4be7059a80dfe19881e07bb9"
    },
    {
      "source_id": "fr86-u003-b0058",
      "target": "— Нынче вечером надо бы устроить костёр на Шан-Гайар, — продолжал другой, — из книг мэтра Андри.",
      "source_sha256": "a1aa7e66752f4f617ea8e80a6f5496210a08a4e392ac21a15c13e65f14d35ba6",
      "target_id": "ru-fr86-u003-b0058",
      "tag": "p",
      "target_sha256": "e56932a1f9bd19d27ca4e1e2644248cae9d532f9e93719b48e8dea4001cdd3e8"
    },
    {
      "source_id": "fr86-u003-b0059",
      "target": "— И из пюпитров писцов! — сказал его сосед.",
      "source_sha256": "6a929e3229327ff2ce204175ce8a96d981c7bb14dc619ae063610c6254a728e6",
      "target_id": "ru-fr86-u003-b0059",
      "tag": "p",
      "target_sha256": "42cd82966aad8a319238ca205d6b0dd9ae2573862b7c87d1872693b70062ef9a"
    },
    {
      "source_id": "fr86-u003-b0060",
      "target": "— И из розог беделей!",
      "source_sha256": "8847d7d5502e3a39955069c196d0918385ab33f49129ac335584ae4ea2813906",
      "target_id": "ru-fr86-u003-b0060",
      "tag": "p",
      "target_sha256": "da80adc885ef3e0ceac921c806b6ddcd875b2c661820f65345fbc98dfb65314d"
    },
    {
      "source_id": "fr86-u003-b0061",
      "target": "— И из плевательниц деканов!",
      "source_sha256": "d425787225719da95286ee124b3a677ace5b635e09186622e7d51a28bf59a59c",
      "target_id": "ru-fr86-u003-b0061",
      "tag": "p",
      "target_sha256": "9730663c527db8c7a972544e680e3db4e6dc0ff7873c0cbbb6aa839b3fc8f30b"
    },
    {
      "source_id": "fr86-u003-b0062",
      "target": "— И из буфетов прокураторов!",
      "source_sha256": "9ff33b24f70aeb1c8178c8eb4c2a55135175a51674faa284142509d7b08fb6ef",
      "target_id": "ru-fr86-u003-b0062",
      "tag": "p",
      "target_sha256": "c928e4a3e4cc92f8ab48c71268cfaae7b5f95945d2f5bf4eb5981ebc5c38cbe4"
    },
    {
      "source_id": "fr86-u003-b0063",
      "target": "— И из ларей выборщиков!",
      "source_sha256": "364f3a03b577aef2422f239c6ec6df036c94a53250cbd22fd39cdecf3727ae0e",
      "target_id": "ru-fr86-u003-b0063",
      "tag": "p",
      "target_sha256": "7aaea369fb7c4367336496ca03ef82b81a938313f318114bb4f436fd5c145ac8"
    },
    {
      "source_id": "fr86-u003-b0064",
      "target": "— И из табуретов ректора!",
      "source_sha256": "23720414655aaefcc6fce84bf3e326d6c6378a8c5ff4a6a0d2b12fbd71a02190",
      "target_id": "ru-fr86-u003-b0064",
      "tag": "p",
      "target_sha256": "287da5a1a65b3385773c846aacbabc32c7cb9309ae40cbac92a9b7101dbc9d71"
    },
    {
      "source_id": "fr86-u003-b0065",
      "target": "— Долой! — подхватил малыш Жеан фальшбурдоном. — Долой мэтра Андри, беделей и писцов; богословов, медиков и декретистов; прокураторов, выборщиков и ректора!",
      "source_sha256": "5f65881f768ab66b6b7a0d172cb12636a4b5a0faf8ebd3200455bf7d41db2060",
      "target_id": "ru-fr86-u003-b0065",
      "tag": "p",
      "target_sha256": "41ae1c819595b9429480dd3c24bf07d6192d8e42d961be6d911bb2557e4fc159"
    },
    {
      "source_id": "fr86-u003-b0066",
      "target": "— Так это конец света! — пробормотал мэтр Андри, затыкая уши.",
      "source_sha256": "15d89352e6ca6b21073597bfa170288d2ea94624cc1d0837de34deb51f6cab3d",
      "target_id": "ru-fr86-u003-b0066",
      "tag": "p",
      "target_sha256": "115566488e922edd8148d0fb6d791420cf6787fe963da85a7e43ae06c18f4e60"
    },
    {
      "source_id": "fr86-u003-b0067",
      "target": "— Кстати, ректор! Вон он, проходит по площади, — закричал один из тех, что стояли у окна».",
      "source_sha256": "8e0d72301b936a3dfe6d6b0b1d5336cd2b4cc717a5d7f19bd6ee8f63834aaf5c",
      "target_id": "ru-fr86-u003-b0067",
      "tag": "p",
      "target_sha256": "9bc147b103cd194ea016b49cb0db054b322f5182810cb2e1af7de8e8b8648d89"
    },
    {
      "source_id": "fr86-u003-b0068",
      "target": "Все наперебой бросились оборачиваться к площади.",
      "source_sha256": "66ad538b5de6ac7eac097e5ee5217dc897fa99a9b05317ae6b77130a9edaae4b",
      "target_id": "ru-fr86-u003-b0068",
      "tag": "p",
      "target_sha256": "740156c4f93ce0a2b031ad97607f759f17b409779b0082160b8d05ec730961d5"
    },
    {
      "source_id": "fr86-u003-b0069",
      "target": "«Неужели это и вправду наш почтенный ректор, мэтр Тибо? — спросил Жеан Фролло дю Мулен, который, уцепившись за столб внутри зала, не мог видеть, что делается снаружи.",
      "source_sha256": "0eb462fc85de20590fac1f63c1f23cbad2fe67d01f6bcda885bf6ac01d72e90d",
      "target_id": "ru-fr86-u003-b0069",
      "tag": "p",
      "target_sha256": "3ed70479dbd2c2686d21df2e47941876245af256c64c9ad3e34145320d9f381b"
    },
    {
      "source_id": "fr86-u003-b0070",
      "target": "— Да, да, — ответили все остальные, — это он, он самый, мэтр Тибо, ректор».",
      "source_sha256": "d8ae8c394c47dbe2ed77db234c796d65bcf47636155d0b08c789ee69fb3acd77",
      "target_id": "ru-fr86-u003-b0070",
      "tag": "p",
      "target_sha256": "95cd46ba71b0c7f08ec14cbb57af320d6d523d2889c124f7117995258d8c227f"
    },
    {
      "source_id": "fr86-u003-b0071",
      "target": "Это и в самом деле был ректор со всеми сановниками Университета; они торжественным шествием направлялись навстречу посольству и как раз пересекали Дворцовую площадь. Школяры, теснясь у окна, встретили их на пути насмешками и ироническими рукоплесканиями. Ректор, шедший во главе своей свиты, принял на себя первый залп; он был жесток.",
      "source_sha256": "33efcf82f8ff0611bf1729046c74374af38e4b4b0b8c578925723bf6c58ac74e",
      "target_id": "ru-fr86-u003-b0071",
      "tag": "p",
      "target_sha256": "2ff7c8351aa2210bafd6ba1fd3e1db91f6ddbffdbdf8cb0900b24803329f595f"
    },
    {
      "source_id": "fr86-u003-b0072",
      "target": "«Здравствуйте, господин ректор! Эгей! Да здравствуйте же!",
      "source_sha256": "da4c3fc93bfe3d8990bad704d247baeb72ef0c63f37994121d00105fa7fa1ebf",
      "target_id": "ru-fr86-u003-b0072",
      "tag": "p",
      "target_sha256": "aab622bdda8747e5680b59c5d0eab956a3b8f811e75c0ad0d71c8d22b8be4467"
    },
    {
      "source_id": "fr86-u003-b0073",
      "target": "— Как он ухитрился попасть сюда, старый игрок? Неужто бросил свои кости?",
      "source_sha256": "86e472baa4c37f1cd1668812e613f8445268c23adebb3da26f0fe908f8745fef",
      "target_id": "ru-fr86-u003-b0073",
      "tag": "p",
      "target_sha256": "2e0ccc8542b3bee915b445a13f5e22151d40ac04e1943297c5e038797af0cb36"
    },
    {
      "source_id": "fr86-u003-b0074",
      "target": "— Как он трусит на своём муле! У неё уши короче, чем у него.",
      "source_sha256": "9e4f5ebf8bb11bfafb89102855850a523c327c5a45fcf9598c3e2e611a8a38e4",
      "target_id": "ru-fr86-u003-b0074",
      "tag": "p",
      "target_sha256": "7e6ae510b96b925d1afac3e79e5f49c2633e003444ea258128e47cc160348940"
    },
    {
      "source_id": "fr86-u003-b0075",
      "target": "— Эгей! Здравствуйте, господин ректор Тибо! [[I]]Tybalde aleator[[/I]][[N4]]! Старый дурень! Старый игрок!",
      "source_sha256": "541dbf20064acf3f217357ffd89a01c1783b1c32911759a1e95cd501340168b0",
      "target_id": "ru-fr86-u003-b0075",
      "tag": "p",
      "target_sha256": "8eb946a08016732deeaee9146f103b260d01edf012db8b819baf8ad72572af9d"
    },
    {
      "source_id": "fr86-u003-b0076",
      "target": "— Храни вас Бог! Часто ли выпадала вам нынче ночью двойная шестёрка?",
      "source_sha256": "58bcf1150dcf7a2b867eb06b3de0034a6e9bd1db8ca46e76b8da64e0b75b2136",
      "target_id": "ru-fr86-u003-b0076",
      "tag": "p",
      "target_sha256": "5b06ad742bd0a8fd2612fbd48bbfd5e7cdd0f9c926d054d8ff38086e9d7cae0c"
    },
    {
      "source_id": "fr86-u003-b0077",
      "target": "— О, дряхлая образина, свинцово-серая, осунувшаяся и избитая от любви к игре и костям!",
      "source_sha256": "ddb4df54b540d66304f6177e4e02cc206a6ab7a1726e89643c17da555b14a341",
      "target_id": "ru-fr86-u003-b0077",
      "tag": "p",
      "target_sha256": "9b461017666528c816f7d75537964f9f5a5799081c66ebf63ca6214ab20e491a"
    },
    {
      "source_id": "fr86-u003-b0078",
      "target": "— Куда это вы направились, [[I]]Tybalde ad dados[[/I]][[N5]], повернувшись спиной к Университету и трусите к Городу?",
      "source_sha256": "cd6c7dcc17f382ef622892b256e9d578c8ee7c459babfa7602305ac12c9a1ca4",
      "target_id": "ru-fr86-u003-b0078",
      "tag": "p",
      "target_sha256": "74610ffe1688d30d8775fc54aef88597610d0cb7b5f4d5fe46dfc63e324fa8a3"
    },
    {
      "source_id": "fr86-u003-b0079",
      "target": "— Верно, ищет себе жильё на улице Тибото́де, — закричал Жеан дю Мулен.",
      "source_sha256": "48092fc5b82057aa60a6a240d4ebd35dd39a2df456ea7483743768ecc5a5ce71",
      "target_id": "ru-fr86-u003-b0079",
      "tag": "p",
      "target_sha256": "64ef228ec341daee176321b1e2e7adc6eb247b9e489929bdf1f68d8d5e7b5a96"
    },
    {
      "source_id": "fr86-u003-b0080",
      "target": "Вся ватага повторила это острое словцо громовым голосом, яростно хлопая в ладоши.",
      "source_sha256": "6d494a2b7470493e67efa97e9c7abe84f949f85f35a944178a56dc024faa8323",
      "target_id": "ru-fr86-u003-b0080",
      "tag": "p",
      "target_sha256": "9c146c2b264136fd421119e8570e7cea86b8f9305542bef7eb00440056bc1682"
    },
    {
      "source_id": "fr86-u003-b0081",
      "target": "«Вы ищете жильё на улице Тибото́де, не так ли, господин ректор, игрок из дьяволовой партии?»",
      "source_sha256": "98eff60b769ecd46e3031db460ec0b4a4dd8d95d8d981d02e1bef9b9ef97333d",
      "target_id": "ru-fr86-u003-b0081",
      "tag": "p",
      "target_sha256": "9e78e211d58a478289797fe64e99f776bc3cc28815d1a9089c12d5c440d46012"
    },
    {
      "source_id": "fr86-u003-b0082",
      "target": "Затем настал черёд других сановников.",
      "source_sha256": "16d8b0f22eccd3593dee157acf7f6c20a51bd1fbb562103e54f54a768769b442",
      "target_id": "ru-fr86-u003-b0082",
      "tag": "p",
      "target_sha256": "5cb8be5ca9a6da881e274996fe0efb08b79b7ade01b2669fbe6ed07940d579ae"
    },
    {
      "source_id": "fr86-u003-b0083",
      "target": "«Долой беделей! Долой булавоносцев!",
      "source_sha256": "65edc860337377496efc53bb8cba2b90ca87ca2c42a644db83dddec2d916bc8a",
      "target_id": "ru-fr86-u003-b0083",
      "tag": "p",
      "target_sha256": "8ffe1b98c7c2a3940eb69f37ba2eed4575d4ebe605d3e37e86942f0a65579cc4"
    }
  ],
