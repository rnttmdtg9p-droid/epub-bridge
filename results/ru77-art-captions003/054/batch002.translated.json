    },
    {
      "source_id": "ru77-art-caption-18-218",
      "target": "ЦЕРКОВЬ, КОРОЛЬ, ЗНАТЬ И СВОБОДНЫЙ ЧЕЛОВЕК.",
      "source_sha256": "10f51299c93726ae8f58c7b4d2243b48692196c42280cf713852b66cc8ab9b90",
