    },
    {
      "source_id": "ru77-art-caption-15-181",
      "target": "МАРХАУС, СЫН КОРОЛЯ ИРЛАНДИИ, ПО ИЗОБРАЖЕНИЮ НА НАДГРОБИИ, НАЙДЕННОМУ В ЗАМКЕ.",
