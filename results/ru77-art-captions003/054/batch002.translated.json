    {
      "source_id": "ru77-art-caption-13-155",
      "target": "«ВЫЧЕСТЬ НАРОД И ОСТАВИТЬ ПОСЛЕ СЕБЯ КАКУЮ-НИБУДЬ ГУЩУ».”",
      "source_sha256": "8970f8713e76ed7d10fbf13f836e592fe7fa1cc405925156a0f2c2f5b79c100e",
