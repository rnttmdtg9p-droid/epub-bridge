    },
    {
      "source_id": "ru77-art-caption-11-131",
      "target": "«ЧЁРТ ПОБЕРИ, НЕУЖЕЛИ ТАКОЙ ПУСТЯК НЕЛЬЗЯ ПОНЯТЬ?»",
      "source_sha256": "2e03301d707f32ac57a7de819c173b1989c3996344855c8c62586527907f8f16",
      "target_id": "ru-ru77-art-caption-11-131",
      "tag": "figcaption",
      "target_sha256": "b366a88268d160f5de5fafa5d086c7bf3e8c15847ef2686580e306cecad8bf36"
    },
    {
      "source_id": "ru77-art-caption-11-136",
      "target": "«И ТАК МЫ ОТПРАВИЛИСЬ».”",
      "source_sha256": "00cee2a0186a8fcdc82602f85e6a01e4ee14e7b52bb6c913e767928803c3f9b8",
      "target_id": "ru-ru77-art-caption-11-136",
      "tag": "figcaption",
      "target_sha256": "263081edf1c50751c77c9a06c3a479e8aec874daff657cdedcd648784f2f7b50"
    },
    {
      "source_id": "ru77-art-caption-12-139",
      "target": "Сей Железный Хлыщ",
      "source_sha256": "7747262b12809b43b874edcc51043371711000550eddf02bbd916118b07c2f10",
      "target_id": "ru-ru77-art-caption-12-139",
      "tag": "figcaption",
      "target_sha256": "a4c153e0c42f0d23c35d06f728df3cc61250bb1f4c05cfecae0f6b87870b877d"
    },
    {
      "source_id": "ru77-art-caption-12-144",
      "target": "ДЕЙСТВИЕ СОЛНЦА НА ЖЕЛЕЗНОЕ ОДЕЯНИЕ.",
      "source_sha256": "cdc26b2b4c4239a7b20a1ff59292c6883ce077efcd9a48a525140d0ed765717f",
      "target_id": "ru-ru77-art-caption-12-144",
      "tag": "figcaption",
      "target_sha256": "58e1008881bda01f5ce9a3b34e292019aa3fd2fa64fc9f19017cfdc05ce8ec26"
    },
    {
      "source_id": "ru77-art-caption-12-146",
      "target": "«ОНА ПРОДОЛЖАЛА ПРИНОСИТЬ И ЛИТЬ, ПОКА Я НЕ ПРОМОК НАСКВОЗЬ».”",
      "source_sha256": "84c5bff882ca03a8f7b718005239f655c83e03869450dda1468a56cadf2a743c",
      "target_id": "ru-ru77-art-caption-12-146",
      "tag": "figcaption",
      "target_sha256": "b0378174a7baf8dbd19cc2ec23c236de7aa838b094827167ac5459f11da4485c"
    },
    {
      "source_id": "ru77-art-caption-13-149",
      "target": "Audi Alteram",
      "source_sha256": "2de7e1ccf5531efec9f6d579fffc45d8f6da2f3e5029dbbe7a61cdb8a8f65dea",
      "target_id": "ru-ru77-art-caption-13-149",
      "tag": "figcaption",
      "target_sha256": "2de7e1ccf5531efec9f6d579fffc45d8f6da2f3e5029dbbe7a61cdb8a8f65dea"
    },
    {
      "source_id": "ru77-art-caption-13-156",
      "target": "ПОХОРОНЫ СВОБОДНОГО ЧЕЛОВЕКА.",
      "source_sha256": "096cd264960572378671f73f4563cd66a09694ea724f665816ab0a68394a7615",
      "target_id": "ru-ru77-art-caption-13-156",
      "tag": "figcaption",
      "target_sha256": "ab342c71c64b7309bb0d522266386152c240853a29930bc608c76e7e4e613e61"
    },
    {
      "source_id": "ru77-art-caption-14-163",
      "target": "Они приняли меня за одного из тех ОГНЕДЫШАЩИХ ДРАКОНОВ",
      "source_sha256": "d001003a97e43400890b87969107e6747d7e6cae51cbeaf577408f43443825c8",
      "target_id": "ru-ru77-art-caption-14-163",
      "tag": "figcaption",
      "target_sha256": "121f77eebab42090ee8658fcfad0219d63afcab9f123431480a1c4b21d66cdbb"
    },
    {
      "source_id": "ru77-art-caption-14-166",
      "target": "ДЕЙСТВИЕ ТРУБКИ НА СВОБОДНЫХ ЛЮДЕЙ.",
      "source_sha256": "b5936786cee072f959a775c8302b0d79a94be9c856868b440b57e4e4e724e8b4",
      "target_id": "ru-ru77-art-caption-14-166",
      "tag": "figcaption",
      "target_sha256": "df0b3bc6992093f83f6111c3304f2a28a89adfa560010a26d3e439455c6a5664"
    },
    {
      "source_id": "ru77-art-caption-14-168",
      "target": "«ЗАЩИТИ ТЕБЯ, ГОСПОДИ! — ЖИЗНИ УГРОЖАЕТ ОПАСНОСТЬ!»",
      "source_sha256": "79eac4f4384678a8336823c5543d27959a442aae61531a4f258dd52cf547c7c5",
      "target_id": "ru-ru77-art-caption-14-168",
      "tag": "figcaption",
      "target_sha256": "9af2d42deca5921fa720443a3162233777490b26800c4a0649a41fd5fe4daf9b"
    },
    {
      "source_id": "ru77-art-caption-14-169",
      "target": "«ОНИ ПРИШЛИ ВСЕ РАЗОМ, ОНИ ПРИШЛИ С ШУМОМ КРЫЛЬЕВ».”",
      "source_sha256": "1e551cafc684aa8e07e4ee9344dc8b179c2632992976e8fdd5fcce1d63d00c4c",
      "target_id": "ru-ru77-art-caption-14-169",
