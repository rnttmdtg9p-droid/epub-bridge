    },
    {
      "source_id": "ru77-art-caption-11-125",
      "target": "СЭНДИ",
      "source_sha256": "de439474ec46783f21573efc03a9a014884d4499cc92d0df1960cbd40ddaa503",
      "target_id": "ru-ru77-art-caption-11-125",
