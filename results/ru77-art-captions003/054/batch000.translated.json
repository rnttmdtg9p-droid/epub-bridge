    {
      "source_id": "ru77-u054-heading",
      "target": "ВНУТРЕННЯЯ ПАРТИЯ ПОДПИСЕЙ К ИЛЛЮСТРАЦИЯМ BATCH003 — НЕ ВКЛЮЧАТЬ В ТЕКСТ ДЛЯ ЧИТАТЕЛЯ",
      "source_sha256": "7c0c5a284e4137fd1398645a344d7ef24b0560f3cd57ad820ee230348a2719ba",
      "target_id": "ru-ru77-u054-heading",
