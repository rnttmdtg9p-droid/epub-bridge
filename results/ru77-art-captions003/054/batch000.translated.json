      "target_sha256": "c8ef281d59387ee81ef9df4186da74e07340db49602f4d08ed5e9c208ffa92c1"
    },
    {
      "source_id": "ru77-art-caption-02-038",
      "target": "«ПРОВАЛИВАЙ, — СКАЗАЛ Я, — ТЫ НЕ БОЛЬШЕ АБЗАЦА».”",
      "source_sha256": "b7db8dee2c644a766a79fa9debb24ac8f8bde9aa5ed67bc2b9c93d144f9ca731",
      "target_id": "ru-ru77-art-caption-02-038",
