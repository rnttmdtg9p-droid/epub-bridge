    },
    {
      "source_id": "ru77-art-caption-04-051",
      "target": "Это ужасное чудовище, вздымающееся до небес.",
      "source_sha256": "2e5e350aefd5e5555bcd92b884dc5e56b5146ec9d75fd1353c4d2264b3cc3ba1",
      "target_id": "ru-ru77-art-caption-04-051",
      "tag": "figcaption",
