      "target_id": "ru-ru77-art-caption-05-059",
      "tag": "figcaption",
      "target_sha256": "e6c552a932845560e0d1fba38a2a0a33f9c89f263090299ab93b5b399af4e398"
    },
    {
      "source_id": "ru77-art-caption-05-066",
      "target": "«ОН БЫЛ ИСПУГАН ДО САМОГО МОЗГА КОСТЕЙ».”",
      "source_sha256": "41b46e4143637ba399bfbb29e8080fd1255d000392063d722351548f81ef9a33",
      "target_id": "ru-ru77-art-caption-05-066",
