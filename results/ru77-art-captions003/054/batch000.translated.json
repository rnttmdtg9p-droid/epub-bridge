    },
    {
      "source_id": "ru77-art-caption-03-041",
      "target": "Мерлин.",
      "source_sha256": "728a0bc9810bbfc8d3a93fd008005185e6fcdc36cce5966907128a064e7ddda0",
      "target_id": "ru-ru77-art-caption-03-041",
