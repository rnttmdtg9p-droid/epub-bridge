    },
    {
      "source_id": "ru77-art-caption-03-046",
      "target": "«МУХИ ЖУЖЖАЛИ И КУСАЛИСЬ, НИКЕМ НЕ ТРЕВОЖИМЫЕ».”",
      "source_sha256": "58232e4282f05487fc5e7397dd064298de63f7a8eb4fe26a706c473274853947",
      "target_id": "ru-ru77-art-caption-03-046",
      "tag": "figcaption",
