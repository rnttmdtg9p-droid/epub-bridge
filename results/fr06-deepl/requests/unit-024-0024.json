  "response": {
    "translations": [
      {
        "text": "— Eh bien, bien sûr ! — s’écria-t-il d’un ton sec, et son expression, ainsi que le ton de sa voix, changèrent soudain à nouveau. Il jeta une nouvelle fois un regard autour de lui.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— C’est vous qui les engagez chez Kapernoumov ?",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Oui…",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Ils sont là, derrière la porte ?",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Oui… Ils ont la même chambre.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Tout ça en même temps ?",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Dans une seule, s’s.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— J’aurais peur la nuit dans votre chambre, fit-il remarquer d’un ton maussade.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      }
