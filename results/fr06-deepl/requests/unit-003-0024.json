  "response": {
    "translations": [
      {
        "text": "— Et toi, ne crache pas dans le puits.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— On paie les enfants en cuivre. Que ferais-tu avec quelques kopecks ? — poursuivit-il à contrecœur, comme s’il répondait à ses propres pensées.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Et toi, tu voudrais tout le capital d’un coup ?",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "Il la regarda d’un air étrange.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Oui, tout mon capital, — répondit-il fermement après un moment de silence.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Allez, doucement, tu me fais peur ; c’est vraiment effrayant. Tu vas faire un tour derrière la clôture ou pas ?",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Comme tu veux.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Ah oui, j’avais oublié ! Tu as reçu une lettre hier, en ton absence.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      }
    ]
  }
