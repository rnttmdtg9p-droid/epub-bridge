    "translations": [
      {
        "text": "— Je sais.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "Elle resta silencieuse pendant une minute.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— L’ont-ils retrouvé, alors ? demanda-t-elle timidement.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Non, on ne l’a pas retrouvé.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Mais comment le savez-vous donc ? — demanda-t-elle à nouveau d’une voix à peine audible, et encore une fois après un silence de près d’une minute.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "Il se tourna vers elle et la regarda fixement, intensément.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Devine, — dit-il avec le même sourire tordu et impuissant.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "C’était comme si des convulsions parcouraient tout son corps.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      }
    ]
