    "translations": [
      {
        "text": "— Ce n’est pas tous les jours que vous recevez ça, n’est-ce pas ?",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "Sonya fut encore plus troublée qu’auparavant, et la rougeur lui monta à nouveau aux joues.",
