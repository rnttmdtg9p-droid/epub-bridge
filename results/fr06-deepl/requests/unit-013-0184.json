    "translations": [
      {
        "text": "Plusieurs personnes se tenaient à l’entrée même de l’immeuble, côté rue, observant les passants : les deux concierges, une femme, un petit-bourgeois en peignoir et quelqu’un d’autre encore. Raskolnikov se dirigea droit vers eux.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Qu’est-ce que vous voulez ? — répondit l’un des concierges.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Êtes-vous passé au bureau ?",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Je viens d’y aller. Que voulez-vous ?",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Ils sont là-bas ?",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Ils sont là.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Et l’assistant est là ?",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "— Il était là tout à l’heure. Que voulez-vous ?",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      }
