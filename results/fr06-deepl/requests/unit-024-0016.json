        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
        "text": "Elle s’assit. Il la regarda avec bienveillance, presque avec compassion, pendant une minute.",
        "detected_source_language": "RU",
        "model_type_used": "quality_optimized"
      },
      {
