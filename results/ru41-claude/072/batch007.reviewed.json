{
  "unit": 72,
  "batch": 7,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id09591",
      "target": "— Ты его знаешь?",
      "source_sha256": "b467123c07979baee3e460e5b3921ff47fc64f9dd2135e14aaff4f15f4532d70",
      "target_id": "ru-id09591",
      "tag": "p",
      "target_sha256": "c878753a0f8fbeebc6c19b0684557d7bfa2fe3e392b8febb3793205b4fecc422"
    },
    {
      "source_id": "id09592",
      "target": "— Мне показалось, что я его узнал, и я не ошибся: толстый и низенький.",
      "source_sha256": "507e095dde49486d66fe6b83b382b43f3f6c38e210eb235c6bfd1add3e5069d3",
      "target_id": "ru-id09592",
      "tag": "p",
      "target_sha256": "0097cb69dbc9fe94fb168de02e12dd090c515e4151f1977d4055756f6c39fa96"
    },
    {
      "source_id": "id09593",
      "target": "— Кто это? — спросили разом, вполголоса, все четверо друзей.",
      "source_sha256": "46e068aeea295eb0d317cf91392da0e8b0572c968cee2c4f43e543bdeb51ea19",
      "target_id": "ru-id09593",
      "tag": "p",
      "target_sha256": "2db4867a129316ef3d0f77823d9c1922cbde1cc30de08d1e360cfdbfdabbca43"
    },
    {
      "source_id": "id09594",
      "target": "— Генерал Оливер Кромвель.",
      "source_sha256": "d0bd2c7e944a88cb1f437121ca0ca45b486cc18070fc93d83adbe665dce84218",
      "target_id": "ru-id09594",
      "tag": "p",
      "target_sha256": "59e4a9b84c2d3a4a0b39397e39772ead82e128886ffa38eb4aa4c475cc7a2145"
    },
    {
      "source_id": "id09595",
      "target": "Четверо друзей переглянулись.",
      "source_sha256": "5bceb4c8f044527f1cb371c5bb7954b5848d21f3f80ecf098040aadbd5cd2100",
      "target_id": "ru-id09595",
      "tag": "p",
      "target_sha256": "ac4d429ed439781ff6c4538731d821bfa1f6f01092bce40944390c4b5dd9ce0f"
    },
    {
      "source_id": "id09596",
      "target": "— А другой? — спросил Атос.",
      "source_sha256": "e0707bf9fa36e20aa7aaf0792df320a73e9762ccdc4a5bc6965f5d154d8f7624",
      "target_id": "ru-id09596",
      "tag": "p",
      "target_sha256": "d13037256b17c81a45cd4606b05718dbbca5337d7494292d54a5582a85099873"
    },
    {
      "source_id": "id09597",
      "target": "— Худой и стройный.",
      "source_sha256": "0896085379954f34df321b834f7cf15bf9741007da782d7a46c47e7f516a4422",
      "target_id": "ru-id09597",
      "tag": "p",
      "target_sha256": "3857cda750ed0b333cf1d3cd36be0b2817e239f7858293d7bcac6a63ec0dcdb0"
    },
    {
      "source_id": "id09598",
      "target": "— Это палач, — в один голос сказали д’Артаньян и Арамис.",
      "source_sha256": "2fe3d480d5daf4a4c2bff27c9892dd636211d0e93ff929f2fd6a8103f3bda0fa",
      "target_id": "ru-id09598",
      "tag": "p",
      "target_sha256": "389c33e386cba2f0c1325bf72bd2a893a7fc244d954e1d58c657d23049c94458"
    },
    {
      "source_id": "id09599",
      "target": "— Я вижу только его спину, — продолжал Гримо, — но погодите, он шевельнулся, он оборачивается; и если он снял маску, я смогу увидеть… Ах!",
      "source_sha256": "56d207aeb5f7b27919f0d6d3438bb8b04ddcad10a0a44a01eba853f9335149e1",
      "target_id": "ru-id09599",
      "tag": "p",
      "target_sha256": "4a305dd223021af18938d205b4143161c06b776839874afb24e78bd0f2b37eb6"
    },
    {
      "source_id": "id09600",
      "target": "Гримо, словно его ударили в самое сердце, выпустил железный крюк и отшатнулся назад, издав глухой стон. Портос удержал его в своих объятиях.",
      "source_sha256": "76010e85b18b4f4ef073fa40af294e78bf5c89a836cc5c79ac52e5599ca054c0",
      "target_id": "ru-id09600",
      "tag": "p",
      "target_sha256": "16e958d6786b4bd7496ea981bb26693d2f7aab9a4442f465e2fa8b2a17adade1"
    },
    {
      "source_id": "id09601",
      "target": "— Ты его видел? — спросили четверо друзей.",
      "source_sha256": "f27e9f06f81e5d3e194b34a5defb45cfc82f3a84c0ed8b70eec0618336334100",
      "target_id": "ru-id09601",
      "tag": "p",
      "target_sha256": "50fad36f5689c0b66b9d57575fed30cafb93f86a1b4dfc9d21767f1798056ee7"
    },
    {
      "source_id": "id09602",
      "target": "— Да, — сказал Гримо; волосы у него стояли дыбом, на лбу выступил пот.",
      "source_sha256": "b2b9347a74b3a821e139fc0ba75def9faad7992c96ec47c0224d02049cfaecaa",
      "target_id": "ru-id09602",
      "tag": "p",
      "target_sha256": "84cb57cc8eabb3197bcdb538ea66d7581c5f8201aded3e053d14ee79b443d2cd"
    },
    {
      "source_id": "id09603",
      "target": "— Худого и стройного? — спросил д’Артаньян.",
      "source_sha256": "2cd96ef274b5077d3f5c5e580224517e5a1457d79e2264488287bcde3f767a52",
      "target_id": "ru-id09603",
      "tag": "p",
      "target_sha256": "01a017131f6a0b2730ee7b55b9a1499006b3da3595d1bb61daebdd24e3c15062"
    },
    {
      "source_id": "id09604",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id09604",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "id09605",
      "target": "— Палача, словом? — спросил Арамис.",
      "source_sha256": "62334967d9ef6844d716e9af819974553a1ea74124f29ba64f1b58421a8f0cdf",
      "target_id": "ru-id09605",
      "tag": "p",
      "target_sha256": "8127db9c5d3c6e321afd13c8bb5844258bdcc1fb8f6e3dd0132d32a59b6c7bd2"
    },
    {
      "source_id": "id09606",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id09606",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "id09607",
      "target": "— И кто же это? — спросил Портос.",
      "source_sha256": "a19723e9509c120cf0c8ec70e79fd0babebca1f8875fd106c2d961e4ff82f15e",
      "target_id": "ru-id09607",
      "tag": "p",
      "target_sha256": "3439a91dff6e92432a15cdc171c08d7e20d4021279c10514f59fb5d09c949c4d"
    },
    {
      "source_id": "id09608",
      "target": "— Он! Он! — пролепетал Гримо, бледный как мертвец, дрожащими руками схватив руку своего господина.",
      "source_sha256": "0a2612a527aba3054e670b26842903f6a0f655a087a96865cdbc2b3d5ba90479",
      "target_id": "ru-id09608",
      "tag": "p",
      "target_sha256": "de301db88d3ea60a8cd477c11a108eb45d278753dbe67ede669632b470e4392b"
    },
    {
      "source_id": "id09609",
      "target": "— Кто — он? — спросил Атос.",
      "source_sha256": "087d72d855c6b53e54a55c3d7ba01e6b63711611f2a1d57f2acc13835b17922c",
      "target_id": "ru-id09609",
      "tag": "p",
      "target_sha256": "2eff2b0b5e311c8d1d36fe9cc4be5a5821e65173c43f04891f3c2ea4cd62c33e"
    },
    {
      "source_id": "id09610",
      "target": "— Мордаунт!.. — ответил Гримо.",
      "source_sha256": "d4c125eb3e40425f31aaf7e1484407877a634362472db165913867a63745b88b",
      "target_id": "ru-id09610",
      "tag": "p",
      "target_sha256": "c37f3d7f8ac22af55d5ceaa7c8332b879292355518493bf704e1f57e9bc4a70b"
    }
  ],
