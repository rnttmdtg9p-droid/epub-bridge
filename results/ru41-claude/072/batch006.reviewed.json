{
  "unit": 72,
  "batch": 6,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id09571",
      "target": "— Мужчина.",
      "source_sha256": "cd5f3d31b53d6f1b124efe27691e0f5dd2e3b59503e34a7ca37533f75b965d10",
      "target_id": "ru-id09571",
      "tag": "p",
      "target_sha256": "801c5aa0982983cb72a44cd3df9997d02c47d6639d3a87c61006fe057e130760"
    },
    {
      "source_id": "id09572",
      "target": "— А-а! — сказал д’Артаньян. — Значит, их двое.",
      "source_sha256": "b8ea93cffa92fbfb41bb176a676ae6d5eb19bbc9baa5eb4d7b8555b9666a64c4",
      "target_id": "ru-id09572",
      "tag": "p",
      "target_sha256": "2d18b8efef0d75659305fd7bf11df1a001bbdcb35b9c2d0d27088565b1e882a4"
    },
    {
      "source_id": "id09573",
      "target": "— Хотел бы я, чтобы их было четверо, — сказал Атос, — по крайней мере, силы были бы равны.",
      "source_sha256": "83d3f59abc6d1b4ec89a6178bac86ba340681e6d3aaa685d439b20d09e957b67",
      "target_id": "ru-id09573",
      "tag": "p",
      "target_sha256": "e30971116859a44f7bd3e58bd86b0a36242aa31eaeec1ff5514df33bddc19e66"
    },
    {
      "source_id": "id09574",
      "target": "— Может быть, их и четверо, — сказал д’Артаньян.",
      "source_sha256": "d487deff1a1336f62298ee934cc335551218594ae8fb97d4569d8bdda763ea0a",
      "target_id": "ru-id09574",
      "tag": "p",
      "target_sha256": "e4169d1deada934d50adb2fe6f97b72f94b0c3e526a27aac5c9ec02ab6079e2b"
    },
    {
      "source_id": "id09575",
      "target": "— Как так?",
      "source_sha256": "24abe4982bc1efaf04df8781dfe2ce72e9299c18c2fb0ec5d15297b000883304",
      "target_id": "ru-id09575",
      "tag": "p",
      "target_sha256": "b4592186655d9f97c936bc9d5e1c7013346d208284974aa91c654d8e6e435aad"
    },
    {
      "source_id": "id09576",
      "target": "— Разве другие люди не могли оказаться в этом доме раньше них и ждать их там?",
      "source_sha256": "2737c8dfc01a40b94575f73c849e38ed51f1e016650fc29c1f967d7371ad30fa",
      "target_id": "ru-id09576",
      "tag": "p",
      "target_sha256": "68a4bd857c36ac8ceafcc58b7cb3f9fe0e45eee0cfc5aee46037494c29369f28"
    },
    {
      "source_id": "id09577",
      "target": "— Можно посмотреть, — сказал Гримо, указывая на окно, сквозь ставни которого пробивалось несколько лучей света.",
      "source_sha256": "0452cd92e0239aab2c53eae4652b1f33657a72bfeb0df4644e3c7e05c8fcee72",
      "target_id": "ru-id09577",
      "tag": "p",
      "target_sha256": "7b004dcf79142d1d66d0a631cc0c0e89c378eae46a93ae96218945cee8a09389"
    },
    {
      "source_id": "id09578",
      "target": "— Верно, — сказал д’Артаньян, — позовём остальных.",
      "source_sha256": "486fe94dade1a2e75c8c2f80e8dc32ba193a244dc7803935e02942d439dfb471",
      "target_id": "ru-id09578",
      "tag": "p",
      "target_sha256": "8f6418e51432d0ae5a2af8cd2a0f0174d89685e3d448f49473f6627594017baf"
    },
    {
      "source_id": "id09579",
      "target": "И они обошли дом, чтобы подать знак Портосу и Арамису подойти.",
      "source_sha256": "31a6746d09e4a281854c5acd0dd3a9be5b728fb6e2f7ec522af05091c8556e71",
      "target_id": "ru-id09579",
      "tag": "p",
      "target_sha256": "a138a82ea9c07b9f75073de708759b904538ba2275c12278e27a6f3e3ddaca94"
    },
    {
      "source_id": "id09580",
      "target": "Те прибежали поспешно.",
      "source_sha256": "d95a3d4694fee5713bccdff10e9fc1d039ae0f524a836d3e0288689d28b0787e",
      "target_id": "ru-id09580",
      "tag": "p",
      "target_sha256": "233bef298852da162b84329ce66e56ff37a7404c2d1bafa26a050e2457f3afb6"
    },
    {
      "source_id": "id09581",
      "target": "— Вы что-нибудь видели? — спросили они.",
      "source_sha256": "e92be3c80b7756019b93c4ba0080c28a0ddf8b7feb7c252e07907fd4ba0f852e",
      "target_id": "ru-id09581",
      "tag": "p",
      "target_sha256": "01f1a1d9d19ec227db4419cdb93f0281b9d9957308a9b3b97efc59df41878f9a"
    },
    {
      "source_id": "id09582",
      "target": "— Нет, но сейчас увидим, — ответил д’Артаньян, указывая на Гримо, который, цепляясь за выступы стены, уже поднялся на пять или шесть футов от земли.",
      "source_sha256": "64d4577d7f66279a2c8494edef91270a87ffbd67b1b7da72f1d110e52478e54b",
      "target_id": "ru-id09582",
      "tag": "p",
      "target_sha256": "eb8c7c1b3c7c36048c9797a11035620a7a2897c53eb598fdab9d3e95e6f5981d"
    },
    {
      "source_id": "id09583",
      "target": "Все четверо подошли ближе. Гримо продолжал подъём с ловкостью кошки; наконец ему удалось ухватиться за один из тех крючков, которыми удерживают ставни, когда они распахнуты; в то же время нога его нашла на стене лепной выступ, который, по-видимому, давал ему достаточную опору, потому что он сделал знак, означавший, что он добрался до цели. Тогда он приблизил глаз к щели ставня.",
      "source_sha256": "1bf0e4a28dd852b158ce3c1d4dc0edc96ce7eb1584a6419e497b0b40e169d803",
      "target_id": "ru-id09583",
      "tag": "p",
      "target_sha256": "53afdd415dc49cf8b211666210aad9d02504a88c74870e2996298bcb4998c04e"
    },
    {
      "source_id": "id09584",
      "target": "— Ну что? — спросил д’Артаньян.",
      "source_sha256": "f08c659ca4c2ff20971f4dc7c332b0491543e1fca4adfcbfd031aead258a3959",
      "target_id": "ru-id09584",
      "tag": "p",
      "target_sha256": "25b30dfaa64a04a43a482fb98ae25c12f17685e4696e4ca9f1b6ba52531f45f3"
    },
    {
      "source_id": "id09585",
      "target": "Гримо показал сжатую руку, в которой были отогнуты только два пальца.",
      "source_sha256": "7d06b76e53583f4b1971a38cbaa1829612f862e6ae8b6acaa2eb8f86bc1bf0e5",
      "target_id": "ru-id09585",
      "tag": "p",
      "target_sha256": "6c0198a0c73a3bc1d0618c8cce2b85791c7ccda0ec9b5a2d7603585e8fbbe780"
    },
    {
      "source_id": "id09586",
      "target": "— Говори, — сказал Атос, — твоих знаков не видно. Сколько их?",
      "source_sha256": "f4b31e8ba931cceb095786e5d8c5674bc253717331c477876e6ce9aa7ef7d9a7",
      "target_id": "ru-id09586",
      "tag": "p",
      "target_sha256": "9b68298d078970848cf29f97f9d22e8d0661e7c38c6bec112109cffe0fb39827"
    },
    {
      "source_id": "id09587",
      "target": "Гримо сделал над собой усилие.",
      "source_sha256": "4de9b1abb96631930123388c5c78e2431491f5415b111c220097e5a7e4c4dc0f",
      "target_id": "ru-id09587",
      "tag": "p",
      "target_sha256": "e801e592be57bf55fc42a82c3e074645a28e1c04ec0908c23c17c83617ff290e"
    },
    {
      "source_id": "id09588",
      "target": "— Двое, — сказал он, — один напротив меня, другой стоит ко мне спиной.",
      "source_sha256": "0f64c03781257f86bb64f9647aba73b7fdd3fe6ba27bc47b8c93105bd1ce9c7e",
      "target_id": "ru-id09588",
      "tag": "p",
      "target_sha256": "743cc73f418131adea9d353feeab21c04b83243bdcd2452b0bcd682a1000a449"
    },
    {
      "source_id": "id09589",
      "target": "— Хорошо. А кто тот, что напротив тебя?",
      "source_sha256": "2ed6684ff2033db01cafdc0c0c4742aac509593f29966decbdcb87ecce7cef64",
      "target_id": "ru-id09589",
      "tag": "p",
      "target_sha256": "206c5f13fdf45f49aa6c722135863b8005638d0bdb71f57bca884aa84013f84a"
    },
    {
      "source_id": "id09590",
      "target": "— Человек, которого я видел проходящим.",
      "source_sha256": "8bedaf70b52458bdf4589596addcf82c7cf84161fe147f56dc3aa30a7f9ad8d8",
      "target_id": "ru-id09590",
      "tag": "p",
      "target_sha256": "3220e84f7a340b58aa1b524a5bac5082f16910f9643f5b9fd617d452fb03e387"
    }
  ],
