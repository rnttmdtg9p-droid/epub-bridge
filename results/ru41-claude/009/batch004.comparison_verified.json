{
  "unit": 9,
  "batch": 4,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id01100",
      "target": "— Нет, монсеньор, будьте покойны.",
      "source_sha256": "2071d466b90ffe4debdf1f704a9eed8b18a30cb825b2c11f793693ae7975260a",
      "target_id": "ru-id01100",
      "tag": "p",
      "target_sha256": "9c15247696a788d3a5d028578991af5dd3fd3b8fc96f8b02f0b6ddca167fe0e4"
    },
    {
      "source_id": "id01101",
      "target": "Д’Артаньян решил, что настал момент и ему вступить в разговор.",
      "source_sha256": "0cb44eed4799b2e3be630f76a90ea93388833485f84e6d58466bf1c4303a0da9",
      "target_id": "ru-id01101",
      "tag": "p",
      "target_sha256": "edcdff5387d62e7dbf528c92438e5ead2f38fae897b46f752af0275c727fa24f"
    },
    {
      "source_id": "id01102",
      "target": "— Эй, господа! — сказал он со своим гасконским выговором. — Что вам угодно, чего вы требуете?",
      "source_sha256": "636378b0a455d286cfba4e886a7db5e24c4d72dda1f9f7b1ba973099d82266b4",
      "target_id": "ru-id01102",
      "tag": "p",
      "target_sha256": "864877276af47e70024d0db6734f894770a117e4d71cc014c1575356a5fc3333"
    },
    {
      "source_id": "id01103",
      "target": "— Сейчас узнаешь! — завопили всадники хором.",
      "source_sha256": "3d43a4949625d8b037a43f22ca17d196b2dbac3a0600cbe536d04a95a8a9f605",
      "target_id": "ru-id01103",
      "tag": "p",
      "target_sha256": "b6e28989820fe376d05ab7dbefe96df7789ac89a418fff02b5d6a3bb8f5d1590"
    },
    {
      "source_id": "id01104",
      "target": "— Стойте, стойте! — крикнул тот, кого они называли монсеньором. — Стойте, головой отвечаете, это не его голос.",
      "source_sha256": "4cea9a6a15e7655d7568f5170812ae90441d12d98a2555d455603342b8a0ae1d",
      "target_id": "ru-id01104",
      "tag": "p",
      "target_sha256": "c6680a6c159b317cdc0902643e82a4db88939f8316d38039d453b33184ef3fb3"
    },
    {
      "source_id": "id01105",
      "target": "— Да что же это, господа, — сказал д’Артаньян, — неужто в Нуази все взбесились? Только поостерегитесь: предупреждаю вас, что первого, кто подойдёт на длину моей шпаги, а шпага у меня длинная, я выпотрошу.",
      "source_sha256": "0078f2c326c399789784643ea4bbdb00ad95539b88b0b03af9ebeaafc9d7c361",
      "target_id": "ru-id01105",
      "tag": "p",
      "target_sha256": "b6794d360d7c7fdb756c48cfe00f22b02822516a6071456ea68e07615ee53070"
    },
    {
      "source_id": "id01106",
      "target": "Предводитель приблизился.",
      "source_sha256": "16e192e648d6ac303dcb2f417c64960065f12c3fbb8bd5630600b33c8c54ec9f",
      "target_id": "ru-id01106",
      "tag": "p",
      "target_sha256": "f7a70218684d4f108750fa632743a6661e7a733c81f4202959987fe890caa86b"
    },
    {
      "source_id": "id01107",
      "target": "— Что вы здесь делаете? — спросил он надменным голосом, словно привыкшим повелевать.",
      "source_sha256": "c664bc6a6e54fa4de535a0f224a7486f0260d30878463a614319febde61a17b8",
      "target_id": "ru-id01107",
      "tag": "p",
      "target_sha256": "9229f1dafe720b5b39d2159e817cb355e9fcfb2f34f29a38ca5ec6fbb2051085"
    },
    {
      "source_id": "id01108",
      "target": "— А вы сами? — сказал д’Артаньян.",
      "source_sha256": "15ca42161ca8ae518b6a355f126160b29c9544694b42d2c4b04549f61d9787c8",
      "target_id": "ru-id01108",
      "tag": "p",
      "target_sha256": "94f95bb9cc73d1ba22382940ac05f4b64ecdf3192d30362e3caa4441df7e86ff"
    },
    {
      "source_id": "id01109",
      "target": "— Будьте вежливы, не то вас славно отделают; ибо хотя иной и не желает называть себя, он хочет, чтобы его уважали по его званию.",
      "source_sha256": "de098174c60a523d0b6e80b4ef5512f10805666c5ffca1a6feae770fe55a7e0e",
      "target_id": "ru-id01109",
      "tag": "p",
      "target_sha256": "1020c8d83109d3f1df6f72e613a3e6bb092c3a65b124c698b835ea48c5a96e41"
    },
    {
      "source_id": "id01110",
      "target": "— Вы не хотите назвать себя потому, что руководите засадой, — сказал д’Артаньян, — а я путешествую мирно, со своим лакеем, и у меня нет тех же причин скрывать от вас своё имя.",
      "source_sha256": "69cf31c3dd80ae5cb7ea4537ec0ce7b68be8e8bc162d18fdf12fb7deaa3ab1a3",
      "target_id": "ru-id01110",
      "tag": "p",
      "target_sha256": "211b19fce57c087d7e882e1d204a09f61dda0da2da0a08390665e15aa7d53fa7"
    },
    {
      "source_id": "id01111",
      "target": "— Довольно, довольно! Как вас зовут?",
      "source_sha256": "af29b2f4e1b9e7def094301c0afd40414e695e5499992ced67d14931d0e2c72c",
      "target_id": "ru-id01111",
      "tag": "p",
      "target_sha256": "a2e437e712d8cbcce704deb96133f6d730fa3454dcd0154900ea636f0b1b531b"
    },
    {
      "source_id": "id01112",
      "target": "— Я называю вам своё имя, чтобы вы знали, где меня найти, сударь, монсеньор или мой принц, как вам угодно, чтобы вас называли, — сказал наш гасконец, не желавший делать вид, будто уступает угрозе. — Вы знаете господина д’Артаньяна?",
      "source_sha256": "4dbf6f1471f5be3432dcfc901bce484b211ee070c8e01e1b1d4a0ae870e94f41",
      "target_id": "ru-id01112",
      "tag": "p",
      "target_sha256": "2ccdb8b82b7612fcfeed262c3614701d7499e41a8716310921d823360ccbc37a"
    },
    {
      "source_id": "id01113",
      "target": "— Лейтенанта королевских мушкетёров? — сказал голос.",
      "source_sha256": "e89111774a07b5e67d5d9dab65b6529e9c5822f48cf9bfa65ae29d6f8040766a",
      "target_id": "ru-id01113",
      "tag": "p",
      "target_sha256": "65c0ce1b2ed808016827355abc75ba6aa9c416d28a52051c57afa105a9c3c622"
    },
    {
      "source_id": "id01114",
      "target": "— Именно его.",
      "source_sha256": "6b701415ee3a73a258e5472d3905ac42032f28affe254419b60e5d1dd1470538",
      "target_id": "ru-id01114",
      "tag": "p",
      "target_sha256": "d1d77ac545906b5a5b968fef80817b01113a5547f31ae38235937adc014b9037"
    },
    {
      "source_id": "id01115",
      "target": "— Да, разумеется.",
      "source_sha256": "a3ed86558068a8913bdf954132cd1215b84ad66156ebce088956e1564ccdc6e4",
      "target_id": "ru-id01115",
      "tag": "p",
      "target_sha256": "f13788e6dedc66d4b76e94426bf05de36ee044ee87a15c3fa9614697f56d37bd"
    },
    {
      "source_id": "id01116",
      "target": "— Ну так вот! — продолжал гасконец. — Вы, должно быть, слышали, что у него крепкая рука и мастерский клинок?",
      "source_sha256": "3332c05dc2d639dcd9c4d3884cfe8cb82c182542617c7abd6fdeadb57eb55b22",
      "target_id": "ru-id01116",
      "tag": "p",
      "target_sha256": "c83ef006fd363d082ee1c620cbff74ae8df21d818f0bba923d81bba886afdbf3"
    },
    {
      "source_id": "id01117",
      "target": "— Вы господин д’Артаньян?",
      "source_sha256": "9ad3fd6037040bc16b5966134c905a5c84e8e66ce592eb90dcb267d790afb66a",
      "target_id": "ru-id01117",
      "tag": "p",
      "target_sha256": "adfa383e07e248a97e59ce5290bbb7c57b644244695f6fa9231cd7a20b736ade"
    },
    {
      "source_id": "id01118",
      "target": "— Это я.",
      "source_sha256": "110fd6807fb8e40a907aae0fed97c2fc059638136235f92c1dc2322abdf0b1e4",
      "target_id": "ru-id01118",
      "tag": "p",
      "target_sha256": "addbb03d1e401ac2f507fad22de778b1cbae9b4bc0724d34ee633778a717cdcb"
    },
    {
      "source_id": "id01119",
      "target": "— Так, значит, вы пришли сюда, чтобы защищать <i>его</i>?",
      "source_sha256": "269aa1ab0ee34a6c5e2a7356e7805d5e9e390b2470bd8dd0264c9fca397bac03",
      "target_id": "ru-id01119",
      "tag": "p",
      "target_sha256": "178c6fc76e3088ca2c8ffe11785a521536d5cd0072868641dc92470e93cb2108"
    }
  ],
