{
  "unit": 9,
  "batch": 1,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id01040",
      "source_sha256": "ee506240c550d371a197ae6ccb0c633d6f6e799cc34387c4060c3d05739eaa94",
      "target": "«— Он непременно должен быть в Нуази или приехать туда сегодня вечером, ведь я узнал его слугу.",
      "target_id": "ru-id01040",
      "tag": "p",
      "target_sha256": "0201034776e5b994a9e934dab86d829882d4194a2deb7ff7d78a1325e34daf6e"
    },
    {
      "source_id": "id01041",
      "source_sha256": "7a09eedef24f4cdbbc1b7bd0e6a80d1594b48ba257948b6c72821e9e828f32d9",
      "target": "«— Ты уверен? — спросил человек в плаще.",
      "target_id": "ru-id01041",
      "tag": "p",
      "target_sha256": "0aac6655bddf994640d11b48f3653bff728060241d6f349576b024bc04eb9b53"
    },
    {
      "source_id": "id01042",
      "source_sha256": "628811c545339a910564259b0e1cd2a04018b362f62b78b76d95fefee5fdb6fc",
      "target": "— Да, ваше высочество.",
      "target_id": "ru-id01042",
      "tag": "p",
      "target_sha256": "1c6a865807d6ef77988c63e3d920c3b1943051c477a5da0999c44dc89a43c31b"
    },
    {
      "source_id": "id01043",
      "source_sha256": "d957113077d7c0dfbaa25bd4f3fd71793e3f65809f44d84f60b7cc1e4e1a25df",
      "target": "— Ваше высочество! — прервал д’Артаньян.",
      "target_id": "ru-id01043",
      "tag": "p",
      "target_sha256": "e99f4f5ce2be07febcb1f1131e9168346a52dc6474710e616a1772f417d28821"
    },
    {
      "source_id": "id01044",
      "source_sha256": "773faea9e94ef2f9e197e557f4c0caf89d42750f834b780ea7ce6f56d072738a",
      "target": "— Да, ваше высочество. Но послушайте же.",
      "target_id": "ru-id01044",
      "tag": "p",
      "target_sha256": "d11b5ba833e32ba9f76bf224dca5e565f83a4301b86a80e978efb2eb91670384"
    },
    {
      "source_id": "id01045",
      "source_sha256": "2174bc94b7636b1b5ba4904dd5d245aa625e2bd00c29b4a088f5fd7b8a65fbc9",
      "target": "«— Если он там, то что же, в конце концов, с ним делать? — спросил другой собутыльник.",
      "target_id": "ru-id01045",
      "tag": "p",
      "target_sha256": "741cc397bf8be3c9fa925cc544a437fa68de36f2831506271248c6f92f1d6552"
    },
    {
      "source_id": "id01046",
      "source_sha256": "521800ec95f07f54aecbd8055a74fe1450eb0696bd719530ab6925401a5349fe",
      "target": "«— Что с ним делать? — сказал принц.",
      "target_id": "ru-id01046",
      "tag": "p",
      "target_sha256": "f47ddeed184d8dfc75b4ca2903c92a62da3cc9fb837d4b05ae3a7ee7d1f014a1"
    },
    {
      "source_id": "id01047",
      "source_sha256": "4ed218c65c71d7c7d839e38c00d2903ce431214bd65222af2663ba46a8e4ef3a",
      "target": "«— Да. Он не из тех, кто так легко дастся в руки, он пустит в ход шпагу.",
      "target_id": "ru-id01047",
      "tag": "p",
      "target_sha256": "e58a065023f9ba2155a366ecb7b33dd4c244a3c3faaba6fa04ad2f91fb67390d"
    },
    {
      "source_id": "id01048",
      "source_sha256": "b5129477e4c7be81648a828215b1d8d5030d6fb453ff734b5c62fea9c4469acd",
      "target": "«— Что ж, придётся поступить так же, как он, но постарайтесь взять его живым. Есть ли у вас верёвки, чтобы связать его, и кляп, чтобы заткнуть ему рот?",
      "target_id": "ru-id01048",
      "tag": "p",
      "target_sha256": "8e1d93761c74fa99b244e73dd89a03fcdee1157f6808742bf3846ef9ee553e7f"
    },
    {
      "source_id": "id01049",
      "source_sha256": "07e30ee7d5a23096ad9adeb0976b76e281aead3e4d13a15771da7ee2743d01a0",
      "target": "«— У нас всё это есть.",
      "target_id": "ru-id01049",
      "tag": "p",
      "target_sha256": "51ae27e1353e94a147121982df6710ccfb70ec4770a8053c02b118224a401c84"
    },
    {
      "source_id": "id01050",
      "source_sha256": "30ed8c66b9ae0505e6c816ef5cdf8e9109ec9ceb4e5e94937461061e5f8d2fb1",
      "target": "«— Имейте в виду, что, по всей вероятности, он будет переодет кавалером.",
      "target_id": "ru-id01050",
      "tag": "p",
      "target_sha256": "4d2b30e7d7fe9cfe8848df0ffadc7650b30ec2cbbc551a9c00025a3fd62770af"
    },
    {
      "source_id": "id01051",
      "source_sha256": "276676b83a0e3cdf9b38887ccef5d5ddda4e90c4e1f973d5ad056c4674d2ff6a",
      "target": "«— О да, да, монсеньор, будьте покойны.",
      "target_id": "ru-id01051",
      "tag": "p",
      "target_sha256": "956eeab06d796fd414974759f8aa67cf4ad897f5f55227f8aa58000aa20b5391"
    },
    {
      "source_id": "id01052",
      "source_sha256": "48bce816d98577678d19c6e3cd86bc73837463449aabd8011957637f91a74807",
      "target": "«— К тому же я буду там и буду вами руководить.",
      "target_id": "ru-id01052",
      "tag": "p",
      "target_sha256": "cea2b517f05ecf335221a31f5675e8afdfe8c64822108c175feb4c60f40aac31"
    },
    {
      "source_id": "id01053",
      "source_sha256": "6ba1ff7ba3d6bc1e46d815c9d39a9a5742f36017ba13cd253509facdcf0185c4",
      "target": "«— Вы ручаетесь, что правосудие…",
      "target_id": "ru-id01053",
      "tag": "p",
      "target_sha256": "88f306ad73186f53a86cb606d98aa459f0fa9ca0db1421fdc5bc289f8f7f145a"
    },
    {
      "source_id": "id01054",
      "source_sha256": "4f38d7afa9ce4a2edb03172fdb25c9b05d4682a069564d5788238007b7eaf30e",
      "target": "«— Я отвечаю за всё, — сказал принц.»",
      "target_id": "ru-id01054",
      "tag": "p",
      "target_sha256": "adac24efc1889c280e1bf499dcc547e1aa9423ae48b801a1120e7a976840e9c3"
    },
    {
      "source_id": "id01055",
      "source_sha256": "6f8986f922b82e0e94c9278fca7f6a4b6d878ba7c0d2153830ba1b30ac359598",
      "target": "«— Хорошо, мы сделаем всё, что в наших силах.»",
      "target_id": "ru-id01055",
      "tag": "p",
      "target_sha256": "d79fef084c78738ef59ccb1fedd38a502728ef11f5125c765dda68964c94d296"
    },
    {
      "source_id": "id01056",
      "source_sha256": "ed03131dbe80a5e2bde69f21c4143a94b782934fcd033a6aed62f055ec6d440a",
      "target": "И с этим они вышли из конюшни.",
      "target_id": "ru-id01056",
      "tag": "p",
      "target_sha256": "02552dbc9e887551d001fd322f665414bdf33b8fafebd90e13a3c8e77d680712"
    },
    {
      "source_id": "id01057",
      "source_sha256": "cd4aefb7d80e50021bf2d618519f6e8f953734dcf5141d089e0b12e02a7dabbc",
      "target": "— Ну и что же, — сказал д’Артаньян, — какое нам до этого дело? Это одно из тех предприятий, какие затеваются каждый день.",
      "target_id": "ru-id01057",
      "tag": "p",
      "target_sha256": "f4844e7b9f9a08841e5d3e765d9034a02f3d38e52d3b67b6cbb3c57593092e2d"
    },
    {
      "source_id": "id01058",
      "source_sha256": "965aeea5fbde749513dc396cb3a7e29d71d36f22b488bfd862e5e1c111d63e84",
      "target": "— Вы уверены, что оно направлено не против нас?",
      "target_id": "ru-id01058",
      "tag": "p",
      "target_sha256": "eabc6a6f766fc978090b9d684552f55bed7c805be9dc479695ea2f375e10e9e0"
    },
    {
      "source_id": "id01059",
      "source_sha256": "eca09b33f2f129537574885fa626b9073ab5a0a6dd78be7bb57971ea54b69585",
      "target": "— Против нас! А почему?",
      "target_id": "ru-id01059",
      "tag": "p",
      "target_sha256": "b58595f348818add68f8c9c94743008eeba2282d76140fe2fde2cdf518e3e0fc"
    }
  ],
