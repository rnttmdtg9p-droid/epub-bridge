{
  "unit": 80,
  "batch": 3,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id10604",
      "target": "— О! — воскликнул Гримо, вытаращив глаза.",
      "source_sha256": "3afc1ceb7a4f10fffbd3e434b568b0508e66434fb8739d34510d562a6431522d",
      "target_id": "ru-id10604",
      "tag": "p",
      "target_sha256": "9c11f98377916e3300ce5793ee95f2a1f73fcd2ddc9d4120e29e6c3156364f08"
    },
    {
      "source_id": "id10605",
      "target": "— Что? — спросили в один голос Арамис и Атос.",
      "source_sha256": "db40d2b74211dcb6f2e9bfcc1786a04116420a7e075db7520738f5ce5d3f8d68",
      "target_id": "ru-id10605",
      "tag": "p",
      "target_sha256": "57c6ca11ce7d6f145b1024aadc098eee625b88370e07ad2c76a3f2909fb846d6"
    },
    {
      "source_id": "id10606",
      "target": "— Планше! — повторил Гримо. — Планше в горжете!",
      "source_sha256": "a0402cc84aca7fd678b55cce1edc84abfaba7de2cdc1607e4654c10bd03fd72d",
      "target_id": "ru-id10606",
      "tag": "p",
      "target_sha256": "0028a4c76ad5f608d35e12399a7cab685c38109571ec932848a5a7189e6122fd"
    },
    {
      "source_id": "id10607",
      "target": "— Господа де Ла Фер и д’Эрбле, — воскликнул офицер, — вы вернулись в Париж! О, какая для меня радость, господа! Ведь вы, без сомнения, приехали присоединиться к господам принцам!",
      "source_sha256": "3cfc42ad78a07c8c8b07946ace7b295366daadb84d1194e68ff3f46906d303b6",
      "target_id": "ru-id10607",
      "tag": "p",
      "target_sha256": "8e7f3a9bac8db6202ecd0ba8a924024e16b6b5b45e7c261cb6c61816d7981125"
    },
    {
      "source_id": "id10608",
      "target": "— Как видишь, мой милый Планше, — сказал Арамис, а Атос улыбался, глядя на важный чин, который занимал в городском ополчении бывший товарищ Мушкетона, Базена и Гримо.",
      "source_sha256": "f0e0cac6da93ef90e17dabcd3c3519d17e70ae2bce8a13bb07cba82ce22697bf",
      "target_id": "ru-id10608",
      "tag": "p",
      "target_sha256": "9f23dcee9c89312a4c7d3e34e538a6df56342e4823acdc1b44b3364f61ac99e0"
    },
    {
      "source_id": "id10609",
      "target": "— А господин д’Артаньян, о котором вы только что говорили, господин д’Эрбле, смею ли я спросить, есть ли у вас о нём вести?",
      "source_sha256": "bf0995ddf98cacdcac0397f55567832bd02ed4262dbd3949b002857e38844758",
      "target_id": "ru-id10609",
      "tag": "p",
      "target_sha256": "919783b0231e3f48e16cd22775ee561a4fcd27119cf6a084b99789637a8ad2ec"
    },
    {
      "source_id": "id10610",
      "target": "— Мы расстались с ним четыре дня назад, мой дорогой друг, и всё заставляло нас думать, что он приехал в Париж раньше нас.",
      "source_sha256": "8994732db42546df9dd0e00b5c1cf2f05cdea7e3ff35dd40f7566c6181dbd70e",
      "target_id": "ru-id10610",
      "tag": "p",
      "target_sha256": "df71cd61bba423f151bd60afbe77edc1b329ba3f72a4931df3c3939904d040f8"
    },
    {
      "source_id": "id10611",
      "target": "— Нет, сударь, я уверен, что в столицу он не возвращался; впрочем, быть может, он остался в Сен-Жермене.",
      "source_sha256": "11b67709eeb4f9b50ea4cabe05bf856d85b98156d465d265158fd12e1912929d",
      "target_id": "ru-id10611",
      "tag": "p",
      "target_sha256": "e8702678dd442fc8ed3497a1b002e0b985cae0aa7fac987d923d9ce83bd44e54"
    },
    {
      "source_id": "id10612",
      "target": "— Не думаю, мы условились встретиться в <i>«Ла Шеврет»</i>.",
      "source_sha256": "bb3e416738f9db7057c52c26136587f2aacb3fd6d9012bbf48d9afed115a0de2",
      "target_id": "ru-id10612",
      "tag": "p",
      "target_sha256": "5520cb40362b681e3264e91829612826caadb5e1a499b2268cfaa37d5a139826"
    },
    {
      "source_id": "id10613",
      "target": "— Я заезжал туда сегодня же.",
      "source_sha256": "2d76be7a67a174681c6fde8516685edce3dd1f62986db91a63c86b77e6554ffd",
      "target_id": "ru-id10613",
      "tag": "p",
      "target_sha256": "f55d1a0903e0791c8164a83dcb2d12e654bb8a5363bb2e086e97a660df3198b3"
    },
    {
      "source_id": "id10614",
      "target": "— И прекрасная Мадлен ничего о нём не знала? — спросил Арамис с улыбкой.",
      "source_sha256": "7ed47d508b374284c2376b6ab7b2f32d10e87bbe58819aeaa5956a1823efdfcd",
      "target_id": "ru-id10614",
      "tag": "p",
      "target_sha256": "ce3826ded77a05737e19e2a68d4d29871b06642d4c9ac8427989fb29d662e0ad"
    },
    {
      "source_id": "id10615",
      "target": "— Нет, сударь, и не скрою даже, что она казалась весьма встревоженной.",
      "source_sha256": "c11d44f3262187af8dbade3923ea42268fa5142ea71406cef1fa1d83a5e89fa2",
      "target_id": "ru-id10615",
      "tag": "p",
      "target_sha256": "f6ac3a8cc098676fedd1eb5747251e772874736b206fcdadd0490510c59b12e1"
    },
    {
      "source_id": "id10616",
      "target": "— В сущности, — сказал Арамис, — время ещё не потеряно, а мы ехали очень поспешно. Позвольте же, мой дорогой Атос, не расспрашивая больше о нашем друге, поздравить господина Планше.",
      "source_sha256": "f82bf4b4cd26b1825813ff93f54e2070d390d1c30ad2f56a8820addddaef680d",
      "target_id": "ru-id10616",
      "tag": "p",
      "target_sha256": "33a2e4ce91f8c978cfbe59317e21a3a6c5ae1b5c1702f77b36f4f54019a19dae"
    },
    {
      "source_id": "id10617",
      "target": "— Ах, господин шевалье! — сказал Планше, поклонившись.",
      "source_sha256": "e178bd693da5ed7161a9f98a11d79162d1b06be79bf4df23b58305b595fb6593",
      "target_id": "ru-id10617",
      "tag": "p",
      "target_sha256": "8eb4edf208b3e035bf9cf9fb3bf12b49def163b5d63ec666b51213cb74496944"
    },
    {
      "source_id": "id10618",
      "target": "— Лейтенант! — сказал Арамис.",
      "source_sha256": "ea4db9717b800188f553e97fd4220b1a69ba0c423e40129294a7fd14d068382c",
      "target_id": "ru-id10618",
      "tag": "p",
      "target_sha256": "53d9f5ae9d7b337074ff265c07af9c5ec461a1ed52caf14c101f0806ba894783"
    },
    {
      "source_id": "id10619",
      "target": "— Лейтенант, и мне обещано стать капитаном.",
      "source_sha256": "c9ddf89ec7725323dd6599e870a46f872705a9646952fb194ba1defe966da1eb",
      "target_id": "ru-id10619",
      "tag": "p",
      "target_sha256": "7d9f2d7a8d8a8070636ee10f56c29f8960622273288f4fed0179b53345534f07"
    },
    {
      "source_id": "id10620",
      "target": "— Это очень хорошо, — сказал Арамис, — а как все эти почести достались вам?",
      "source_sha256": "c9a2e481928ee7f0e25e9e49ca1f83064a5fbecda6e3da6a7bb70623f844cca8",
      "target_id": "ru-id10620",
      "tag": "p",
      "target_sha256": "6a03f8cf1007f47fa167a1f65d166c62e8eabfefae3f6d0998b7548ad325a623"
    },
    {
      "source_id": "id10621",
      "target": "— Прежде всего, господа, вы знаете, что это я помог бежать господину де Рошфору?",
      "source_sha256": "337f2bc0b6f80ea1753e475f0713ba03d272d45cadcb25038fa5b89e478f3976",
      "target_id": "ru-id10621",
      "tag": "p",
      "target_sha256": "a03aaacbea79246c1f2ce1201ff60aa755b343cdace237b517fcec0f4fbe8b03"
    },
    {
      "source_id": "id10622",
      "target": "— Да, ей-богу! Он нам рассказывал об этом.",
      "source_sha256": "0fedb8e1f7f71b083771c7ffb0b4327cbd1762623b72597ef8e237dc2c19e268",
      "target_id": "ru-id10622",
      "tag": "p",
      "target_sha256": "c964cd0c09c25b1c824c8771df8323332c681a1800bc4ca4f7e1d9c6e1caf607"
    },
    {
      "source_id": "id10623",
      "target": "— Из-за этого случая Мазарини чуть было не повесил меня, что, естественно, сделало меня ещё популярнее, чем я был.",
      "source_sha256": "532cd697501bd13818f26240ceb9250e04281c92675641bf9204356cfaf0506e",
      "target_id": "ru-id10623",
      "tag": "p",
      "target_sha256": "7729299c987db294a4d6ef14cc1619894775ac0e0dd0976197842ac79003e7eb"
    }
  ],
