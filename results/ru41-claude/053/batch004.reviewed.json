{
  "unit": 53,
  "batch": 4,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id06869",
      "target": "— Я провёл свою жизнь на больших дорогах.",
      "source_sha256": "18ae8b4f35ce9117c2d4b6d27b927c89926ee897c122f9bd1b7903f208a86354",
      "target_id": "ru-id06869",
      "tag": "p",
      "target_sha256": "88e813e94addfa95be617fe9de86f8c4cca10e0b3073695072fa1db62eee1dcf"
    },
    {
      "source_id": "id06870",
      "target": "— Что-нибудь удерживало бы вас в Париже?",
      "source_sha256": "1b99f6bffeca89ecd12d304b5d8636463d009007a1a9d5c6762f180fdcc3b0b7",
      "target_id": "ru-id06870",
      "tag": "p",
      "target_sha256": "dcb2a6158775ff179c6ed3a2460ebe2c1e455e1840cd8ff4123881dc6e716212"
    },
    {
      "source_id": "id06871",
      "target": "— Меня в Париже не удержало бы ничто, кроме приказа свыше.",
      "source_sha256": "cf162cebd92c8d1bd8c8e5c3137712f6c45e4797437618c1421b8ff678bfdced",
      "target_id": "ru-id06871",
      "tag": "p",
      "target_sha256": "15c97856a85bb4975442fd1e1ca700654fa9e3603987bbb7de931b1e595ba71e"
    },
    {
      "source_id": "id06872",
      "target": "— Хорошо. Вот письмо, которое надлежит вручить по адресу.",
      "source_sha256": "ab9979e61454b1ca3b445db0b4bccdb49497869099cc25915e2c66823b19d6cd",
      "target_id": "ru-id06872",
      "tag": "p",
      "target_sha256": "bd351d92439973d71ac98709aecedb70785cc8d9a8d76e6b52d349bea88cb64e"
    },
    {
      "source_id": "id06873",
      "target": "— По адресу, монсеньёр? Но адреса на нём нет.",
      "source_sha256": "9c952f05d76e7b7d3288c1518f5813441a1b9d04b643faaa7a2fc662005589b9",
      "target_id": "ru-id06873",
      "tag": "p",
      "target_sha256": "8a21e051cb32042dd569e922c1a1e32f010b6926bcbc5b45db1a22f0ca272a5f"
    },
    {
      "source_id": "id06874",
      "target": "И в самом деле, на стороне, противоположной печати, не было никакой надписи.",
      "source_sha256": "68829c2155346bcfa42c92999ec0d9180409e08e064e060a2d23fad064aa93b5",
      "target_id": "ru-id06874",
      "tag": "p",
      "target_sha256": "a4527cb9b990f4c12da3d998aecf2982bf866a48cb0e9d931744fc19352a914d"
    },
    {
      "source_id": "id06875",
      "target": "— То есть, — подхватил Мазарини, — конверт двойной.",
      "source_sha256": "0d3d0f5f8e52e7692432b0f7bddc3c819d00c4ee2b5bbe67ee16d43d9d817c90",
      "target_id": "ru-id06875",
      "tag": "p",
      "target_sha256": "5eb53607b82cd7361f2df60f98c8b9430773a1699ca4548242f7a0b22eac00f8"
    },
    {
      "source_id": "id06876",
      "target": "— Понимаю, и первый конверт я должен разорвать лишь по прибытии в определённое место.",
      "source_sha256": "69cd8573d12434c85ad860b5caae15ce7ff7dc6e885ce1a8a94e0b4613236966",
      "target_id": "ru-id06876",
      "tag": "p",
      "target_sha256": "065db45ddb94498e94157c6b9b00299d0a96de69ac946433f7e9a40ccee81f66"
    },
    {
      "source_id": "id06877",
      "target": "— Превосходно. Берите и отправляйтесь. У вас есть друг, господин дю Валлон; я его очень люблю, вы возьмёте его с собой.",
      "source_sha256": "f12ec02cc49311bed93a1324ffebdc76bd3f56582ded21b7cd40dae1e9c34b31",
      "target_id": "ru-id06877",
      "tag": "p",
      "target_sha256": "15be2b89ce1f05854ef4dcb506823a3c3a55a15a58bec9db6d9c52c781fa46f5"
    },
    {
      "source_id": "id06878",
      "target": "— Чёрт возьми! — сказал себе д’Артаньян. — Он знает, что мы слышали его вчерашний разговор, и хочет удалить нас из Парижа.",
      "source_sha256": "c7e3e5242368ac82dbf547c753e8dc5cf4e441d3521777666f02e127e3789f55",
      "target_id": "ru-id06878",
      "tag": "p",
      "target_sha256": "f7882313c133bde6b7090a4d61173a10b813388686815ca386751ca2c1de16a1"
    },
    {
      "source_id": "id06879",
      "target": "— Вы колеблетесь? — спросил Мазарини.",
      "source_sha256": "1229de3262d2942c5ca87b6a197480ff040fdc32b58ccae8137c6311ad243101",
      "target_id": "ru-id06879",
      "tag": "p",
      "target_sha256": "bb3f8eb39560cc747d7f7db2770333774125dc0c48e719f7dfd8fa8fef8efa4f"
    },
    {
      "source_id": "id06880",
      "target": "— Нет, монсеньёр, и я еду немедленно. Мне хотелось бы только одного…",
      "source_sha256": "785b370a071daa8e068f5d0b1358596f6d04e862afaa8b34a09f714c485f53e1",
      "target_id": "ru-id06880",
      "tag": "p",
      "target_sha256": "db628ce599d5979573bf2856e002cc96e0899f8e89483bdfadbd4b78cfba28b2"
    },
    {
      "source_id": "id06881",
      "target": "— Чего именно? Говорите.",
      "source_sha256": "ec8da732e309268b8e84969a1588e42e69e2050c4336c9dac5a90f98d0629621",
      "target_id": "ru-id06881",
      "tag": "p",
      "target_sha256": "03791656ea12f2d26eccf8ae4255ea74c2823fd95e7fa5ae35de0ddb8d92b4ae"
    },
    {
      "source_id": "id06882",
      "target": "— Чтобы ваше высокопреосвященство зашли к королеве.",
      "source_sha256": "8dca29313e41ab6687be7abd9480822e9a69a4fee5e9a186e5de8fa6a9f7512a",
      "target_id": "ru-id06882",
      "tag": "p",
      "target_sha256": "a6883b76f86b7a87ee140a6decae379d0489d58ef88f3b859ab9486424d6e9c4"
    },
    {
      "source_id": "id06883",
      "target": "— Когда же?",
      "source_sha256": "3d5af5b46f5cae54d8e5fddd19266fdb20171fb878f5720dbf9afdc45c6f6502",
      "target_id": "ru-id06883",
      "tag": "p",
      "target_sha256": "43b49604cb97ba71e3679591168bb1086fcb6e3e75de9694811af4bee46a8ad1"
    },
    {
      "source_id": "id06884",
      "target": "— В ту же минуту.",
      "source_sha256": "f45eb564175a0dce2613481432d6f1222178f4e52de699a7420ae69510d20ebb",
      "target_id": "ru-id06884",
      "tag": "p",
      "target_sha256": "6b2e98c1e4492b03bba388e777bbd60da124192b71b1dd7128f50037683fb38b"
    },
    {
      "source_id": "id06885",
      "target": "— Зачем?",
      "source_sha256": "d153e97e225d5762951a3296b23d7c2556b6527fd1c4fa679d8b7ab5fdd4e947",
      "target_id": "ru-id06885",
      "tag": "p",
      "target_sha256": "2dbb888fa6d413f7fe6e300e2500948cbeaa4517a86bc873b30ce37bc2bed5d3"
    },
    {
      "source_id": "id06886",
      "target": "— Чтобы сказать ей только эти слова: «Я посылаю господина д’Артаньяна куда-то и отправляю его тотчас же».",
      "source_sha256": "94440895c3665bebe170e6674c5ca90d4ee0c5de29a2357f81611a8d2e82d033",
      "target_id": "ru-id06886",
      "tag": "p",
      "target_sha256": "3de429eb0af41204ab5a4f8e8226ef7463d425c3106901a4f1b4b5984389a20b"
    },
    {
      "source_id": "id06887",
      "target": "— Вот видите, — сказал Мазарини, — вы виделись с королевой.",
      "source_sha256": "b71cf6385469b92a364b7151f3f9cd831f972d73ee5a7edc3e723d8fec594930",
      "target_id": "ru-id06887",
      "tag": "p",
      "target_sha256": "8cea0d4d806057fef9d03f78a59fd62cd068e01fa44c9f2124e468252687d770"
    },
    {
      "source_id": "id06888",
      "target": "— Я имел честь сказать вашему высокопреосвященству, что тут возможно недоразумение.",
      "source_sha256": "45abf9dad78aa253c46a3fc70bbeb9f935a3c30d103e0898def0a2b0165d2c35",
      "target_id": "ru-id06888",
      "tag": "p",
      "target_sha256": "bd1ba008029a961488d62f1c4581fe3dd9c97eeb5933b8a2c3b41fecc7753dc1"
    }
  ],
