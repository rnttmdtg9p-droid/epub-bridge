{
  "unit": 65,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id08742",
      "target": "— Нашу партию.",
      "source_sha256": "4426abfd386ed043a7f43cb09740829935c263fd7927de139af2c38423a109a8",
      "target_id": "ru-id08742",
      "tag": "p",
      "target_sha256": "59bc5def6e383d1eca9bad5e47236529cd25b75664d08467f98179fcc6011e82"
    },
    {
      "source_id": "id08743",
      "target": "— Ничто на свете, — сказал Гроуслоу.",
      "source_sha256": "399530970ad6f1cdac0c70364e10aaa69dc5715c433a6b2839d0424c36fe9d63",
      "target_id": "ru-id08743",
      "tag": "p",
      "target_sha256": "53be07c68e8b39cd3aca5325ffd7e003d41ed07c4968929e7c9c3ffb37946174"
    },
    {
      "source_id": "id08744",
      "target": "— В самом деле, приходите сегодня вечером к нам, а завтра мы отправимся к вам с ответным визитом. Если что-нибудь в наших людях вас встревожит — а они, как вам известно, неистовые роялисты, — что ж! об этом не будет сказано ни слова, и это всё равно будет ещё одна славно проведённая ночь.",
      "source_sha256": "68147184c634db3c7cc3f283a1d4443a558511400e8a3eb2c71207c52f9b80b2",
      "target_id": "ru-id08744",
      "tag": "p",
      "target_sha256": "8e0724d5c0ef260800b2e52ae064a1e621a25a9a02ab6fdcba4832fed8759ee7"
    },
    {
      "source_id": "id08745",
      "target": "— Превосходно! Сегодня вечером у вас, завтра у Стюарта, послезавтра у меня.",
      "source_sha256": "8559a77e7dc4ea2ee90e24db07fb031f72e3748004f74b74092169ddcc32fe17",
      "target_id": "ru-id08745",
      "tag": "p",
      "target_sha256": "a7a645c8638a2a3b560505687e48bc213c1a0909a79ecf802447eb10801e2132"
    },
    {
      "source_id": "id08746",
      "target": "— А в остальные дни — в Лондоне. Эх, мордиу! — сказал д’Артаньян. — Вы сами видите, что весело жить можно где угодно.",
      "source_sha256": "acd9a1e8cdb48ab5161891513a97dc7104c1a33ddc182b7f059debeebe53f5f0",
      "target_id": "ru-id08746",
      "tag": "p",
      "target_sha256": "303ce12c788a78a9c602e30f32d5eed1d28879672504bba74edd3fb4ab957472"
    },
    {
      "source_id": "id08747",
      "target": "— Да, если встречаешь французов, и таких французов, как вы, — сказал Гроуслоу.",
      "source_sha256": "c9c1fa8853f1c30ca760f30b5900840c12811f0c501617238401b934ae4ee24b",
      "target_id": "ru-id08747",
      "tag": "p",
      "target_sha256": "436ce1d84648419d7652997beac76ed932457e28d69463d71ef55d0cc85db232"
    },
    {
      "source_id": "id08748",
      "target": "— И таких, как г-н дю Валлон; вы сами увидите, что за молодчина! Неистовый фрондёр, человек, который чуть не убил Мазарини между двумя дверями; его используют потому, что его боятся.",
      "source_sha256": "59d6b9511842cba556b71d76b0ebcecd8d06fa033ad5d7c7706d14472bbbc383",
      "target_id": "ru-id08748",
      "tag": "p",
      "target_sha256": "c996ae33c33f018887ef73b718c07d213248b539bb275f46f7cce8c1a67ca810"
    },
    {
      "source_id": "id08749",
      "target": "— Да, — сказал Гроуслоу, — у него славное лицо, и, хоть я с ним и не знаком, он мне вполне по душе.",
      "source_sha256": "bf006ed611bf464efde49d58502e8e351078921f332e8bf488663a713f2f3ea4",
      "target_id": "ru-id08749",
      "tag": "p",
      "target_sha256": "68e5eb5eadd422bef5049f113805e95d719ebaf0fadc5323fa7e10953b0aa189"
    },
    {
      "source_id": "id08750",
      "target": "— Это будет совсем другое дело, когда вы узнаете его. Ах! Да вот, смотрите, он меня зовёт. Простите, мы так тесно связаны, что он не может без меня обойтись. Вы меня извините?",
      "source_sha256": "075452c71143c6fa0a9e2e0f28170e67c06ed84ebe0cb417625cdfcd26aa9230",
      "target_id": "ru-id08750",
      "tag": "p",
      "target_sha256": "28d0387f804d36fecb9046f1b65a1f3da2dabba1d2c4fcbfc47d08d945bcbfb4"
    },
    {
      "source_id": "id08751",
      "target": "— Помилуйте!",
      "source_sha256": "b75601826a63060b5d7694b59ef08e9973e4e1fea74bf54997b2222d113d1a4c",
      "target_id": "ru-id08751",
      "tag": "p",
      "target_sha256": "acfcbb1526e63faeead4c2192001c8822b839f7c22b1709aaea0d43785d98381"
    },
    {
      "source_id": "id08752",
      "target": "— До вечера.",
      "source_sha256": "f8b2873c2585cd6d2eb526ecc7a1ea6bb750648b5a66a5848f18d3b80dded58e",
      "target_id": "ru-id08752",
      "tag": "p",
      "target_sha256": "bdc703c9e39e0a9af48ab898009951da37ae85d6ccae4ce96204bed1416028f3"
    },
    {
      "source_id": "id08753",
      "target": "— У вас?",
      "source_sha256": "971b2b7bda1c485257060b1c12591819dbe45890704f9a1141e1bfbb68174622",
      "target_id": "ru-id08753",
      "tag": "p",
      "target_sha256": "4458d368e00eb8c923a6d8c4c3be8be4d87ddba73632c3e36a82e086fbe5687a"
    },
    {
      "source_id": "id08754",
      "target": "— У меня.",
      "source_sha256": "aba557381b890c205fde658246bfbe7f4a8459218c2cade6da85485e5be2458f",
      "target_id": "ru-id08754",
      "tag": "p",
      "target_sha256": "5edc70da26328e7f2a26e30d757b9419d96901cca8dfb24e21c86356d29c97b4"
    },
    {
      "source_id": "id08755",
      "target": "Двое мужчин обменялись поклонами, и д’Артаньян вернулся к своим спутникам.",
      "source_sha256": "a169dea88d09917e6d45f85d04c3bc5d05acb4c89af7ba23116324112ab690e0",
      "target_id": "ru-id08755",
      "tag": "p",
      "target_sha256": "c0780a349b73b5e3646091037cfbabb0173941a8d0b5e7bd8fa6edfb78af298f"
    },
    {
      "source_id": "id08756",
      "target": "— Что, чёрт возьми, вы могли сказать этому бульдогу? — спросил Портос.",
      "source_sha256": "117a6e8fd92fcab35941cc8fe3868b5033c61b8b31779778a9d2ad58e6796ee5",
      "target_id": "ru-id08756",
      "tag": "p",
      "target_sha256": "5c36c838ac542d90eaee7ee15441d5944b465acd981178ecc9b820fcfc308c6b"
    },
    {
      "source_id": "id08757",
      "target": "— Дорогой друг, не говорите так о г-не Гроуслоу, он один из моих близких друзей.",
      "source_sha256": "46cff0b632eaa8dcddfbd0685201e281c0780c7856ed3abd8ed9838b7d010e66",
      "target_id": "ru-id08757",
      "tag": "p",
      "target_sha256": "6a8eb3c35e47f690b09d6d9b09deac75c6f2a61abafb917e2e7ed413bf447d7c"
    },
    {
      "source_id": "id08758",
      "target": "— Один из ваших друзей, — сказал Портос, — этот убийца крестьян.",
      "source_sha256": "e642ef228d894c89a6c52d5c17d92e8bb4f914f5c8019e51c7589628e7b9dc77",
      "target_id": "ru-id08758",
      "tag": "p",
      "target_sha256": "b8986e162294dc90a6e90cbb31863b384068129f0693752ce4802cfefeb14311"
    },
    {
      "source_id": "id08759",
      "target": "— Тсс! Дорогой Портос. Ну да, г-н Гроуслоу несколько горяч, это правда, но в глубине души я обнаружил в нём два достоинства: он глуп и горд.",
      "source_sha256": "ac9b2fad2703e1ce2b6bdea59a7ad3d9e0c9bdd29996d48eebffb4ca618a5baa",
      "target_id": "ru-id08759",
      "tag": "p",
      "target_sha256": "528d45c094a36f26ba7f97f823a190170142079339e0d35761308a5731c1a528"
    },
    {
      "source_id": "id08760",
      "target": "Портос вытаращил изумлённые глаза, Атос и Арамис переглянулись с улыбкой; они знали д’Артаньяна и понимали, что он ничего не делает без цели.",
      "source_sha256": "b0b765000aceda2326f7f715c81547459305c0c3e9348b506122a5b30bc7fd96",
      "target_id": "ru-id08760",
      "tag": "p",
      "target_sha256": "23a44a655d7ffdc776e9be2cf7e96586719bf0dfe42b5520976d0c790a433e60"
    },
    {
      "source_id": "id08761",
      "target": "— Впрочем, — продолжал д’Артаньян, — вы и сами сумеете его оценить.",
      "source_sha256": "0c1b1c422d3b8863a5240478601383c1f8f8f79e61f85846ebac798e49e9f83a",
      "target_id": "ru-id08761",
      "tag": "p",
      "target_sha256": "ac21d05bd84bb26490e9fd973e93b8e8aa0bca7db4fc75e510e593193fef381f"
    }
  ],
