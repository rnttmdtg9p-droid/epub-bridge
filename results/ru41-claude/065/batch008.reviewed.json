{
  "unit": 65,
  "batch": 8,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id08802",
      "target": "Атос вздрогнул, глаза его вспыхнули.",
      "source_sha256": "feb00bf6439591e2b8e9fc96df5d1be9c4193f6b7efe1adf630ab603eac5116d",
      "target_id": "ru-id08802",
      "tag": "p",
      "target_sha256": "d05592b5a9e924bc2671f014d9ce2732bd01ef0875a8efba28dbb1f2e488fbfc"
    },
    {
      "source_id": "id08803",
      "target": "— Д’Артаньян, — сказал он, сомневаясь после того, как уже обнадёжился, — это ведь не шутка, не так ли? Она причинила бы мне слишком большую боль!",
      "source_sha256": "08207d6c196f995470f1257d17f889e4cd57d92ac61adc9087d3995374bde51a",
      "target_id": "ru-id08803",
      "tag": "p",
      "target_sha256": "7323593273558799569165e0d2e3c54aba12c5a2f9fcc605a05f9b591514383e"
    },
    {
      "source_id": "id08804",
      "target": "— Странный вы человек, Атос, — сказал д’Артаньян, — что так сомневаетесь во мне. Где и когда вы видели, чтобы я шутил с сердцем друга и жизнью короля? Я вам сказал и повторяю, что этой ночью мы спасаем Карла I. Вы положились на меня в том, чтобы найти средство, — средство найдено.",
      "source_sha256": "abba2f033bb8fc527649bd38304b597765860f09c98970308cc3eac63c13589b",
      "target_id": "ru-id08804",
      "tag": "p",
      "target_sha256": "7e98778babd1488d099464bca387c33fc6c25046ddf51a1c0a35420262144f7d"
    },
    {
      "source_id": "id08805",
      "target": "Портос смотрел на д’Артаньяна с чувством глубокого восхищения. Арамис улыбался, как человек, который надеется.",
      "source_sha256": "db2aac09ccd95a224a23759036477dcdd2a0041c259b2662e1c77c601e7bcf1c",
      "target_id": "ru-id08805",
      "tag": "p",
      "target_sha256": "d3ecc11433603ffcb914c41dd50cfc4a5048ba9de71895201797c516896552fc"
    },
    {
      "source_id": "id08806",
      "target": "Атос был бледен как смерть и дрожал всем телом.",
      "source_sha256": "33e05500c86aa66368e35f0ce551006af01fc40ab674b57b4cbeab01722b52ed",
      "target_id": "ru-id08806",
      "tag": "p",
      "target_sha256": "ead5d9a0d5410afb6514ad3d8bf8cf537814ccf5f6cb99951d10a4b5431d4aa6"
    },
    {
      "source_id": "id08807",
      "target": "— Говорите, — сказал Атос.",
      "source_sha256": "f4f1d055828394bfbf23e4a57157d612d7dca9fda7bdc1a6531894b016d21480",
      "target_id": "ru-id08807",
      "tag": "p",
      "target_sha256": "a341a020558a5aef372ab965f3b5dc8c26c5d13c9a9da4221caf5b9360c81e9a"
    },
    {
      "source_id": "id08808",
      "target": "Портос широко раскрыл свои большие глаза, Арамис, можно сказать, повис на губах д’Артаньяна.",
      "source_sha256": "a45e8555f664ac47d67271c6c77219a70afbd6534bc48a06025b026b93d03338",
      "target_id": "ru-id08808",
      "tag": "p",
      "target_sha256": "ba888789f5c72c3194e4e932281ce9d4bb20be8a066034f33e2ae64876e7a415"
    },
    {
      "source_id": "id08809",
      "target": "— Нас пригласили провести ночь у господина Гроуслоу, вы это знаете?",
      "source_sha256": "17944e6514dcb662df43a162d9324071bb7b6d19584b2c4f8289978e6d53efbc",
      "target_id": "ru-id08809",
      "tag": "p",
      "target_sha256": "1ebe0625bf4f45acda8806523a84bf3558d84a5419d0605655e6420e9e068b9d"
    },
    {
      "source_id": "id08810",
      "target": "— Да, — ответил Портос, — он взял с нас обещание дать ему реванш.",
      "source_sha256": "7fbbb3caa987ee2a25c8f2537d9013d93f058c5f35edc97b1101371da319de8e",
      "target_id": "ru-id08810",
      "tag": "p",
      "target_sha256": "842532e9238b22bb8598cda02f4538a4cedf23b58193e4d5eeaa6957036ee1de"
    },
    {
      "source_id": "id08811",
      "target": "— Хорошо. А знаете ли вы, где мы дадим ему реванш?",
      "source_sha256": "62479ac7f951947aa3a89d53425bc85c7ea35eb62cc77efe2cb0ee4b8cf167b0",
      "target_id": "ru-id08811",
      "tag": "p",
      "target_sha256": "d309cf66b8adff6749979de694c1a555506a7b03c669bcf54c15fd4092a206eb"
    },
    {
      "source_id": "id08812",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-id08812",
      "tag": "p",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "id08813",
      "target": "— У короля.",
      "source_sha256": "ae6e39f0132450e1652809dc747829234ed601272d333ae28735b497764f1237",
      "target_id": "ru-id08813",
      "tag": "p",
      "target_sha256": "ff64ec8c4d0a11a96c1341af73f562e831bf8aa00175ab162bb4d8703232ddc3"
    },
    {
      "source_id": "id08814",
      "target": "— У короля! — воскликнул Атос.",
      "source_sha256": "f1bf16a83dfd2bf0806f250c2636779095cdc34f1304e44cee1662424eea2012",
      "target_id": "ru-id08814",
      "tag": "p",
      "target_sha256": "b8b67457f459f2bd76ec869de494c2c38e8bca8dc417a24759614c3226530b87"
    },
    {
      "source_id": "id08815",
      "target": "— Да, господа, у короля. Господин Гроуслоу сегодня вечером стоит в карауле подле Его Величества и, чтобы развлечься на посту, приглашает нас прийти составить ему компанию.",
      "source_sha256": "657f45d3f343701ce144f401baa8887c61bbf37d2bccc172c051aaad90c87b49",
      "target_id": "ru-id08815",
      "tag": "p",
      "target_sha256": "934fc13841e3b041eae0d1b074d0748afa494b00ed43a1fc801eceae78c0d899"
    },
    {
      "source_id": "id08816",
      "target": "— Всех четверых? — спросил Атос.",
      "source_sha256": "ba2de37986573c8bff382e0d42034d66626c65319b9666cd4bb57facbb78309b",
      "target_id": "ru-id08816",
      "tag": "p",
      "target_sha256": "eff015038df80c713a36b48e63faa466d55cc185dd6bdf908167b18309408d94"
    },
    {
      "source_id": "id08817",
      "target": "— Черт возьми! Разумеется, всех четверых; неужели мы оставим наших пленников!",
      "source_sha256": "ca340509b5a8eb6366d3e1cd97f23998d2184113a0a576ec14375f6ac5a32913",
      "target_id": "ru-id08817",
      "tag": "p",
      "target_sha256": "687707e2a249ca8c7ec017b7d3cfafbdbd42c339a126dcf8f24d010bd4b95763"
    },
    {
      "source_id": "id08818",
      "target": "— А! А! — произнёс Арамис.",
      "source_sha256": "bccc5fddd7e3e1a65d6ff4aa95bb7064a8d8ede35032e876a1856d565fc5c051",
      "target_id": "ru-id08818",
      "tag": "p",
      "target_sha256": "1c95adb26fcea567730f6c64f3988906a9cab3e8f7533185d2ba7375c8b8ac30"
    },
    {
      "source_id": "id08819",
      "target": "— Ну же, — сказал Атос, трепеща.",
      "source_sha256": "07a36caa8a58b13f6c36e561e87fd720f6776cf6e0c3f31f4d4a010f7aa9c9c2",
      "target_id": "ru-id08819",
      "tag": "p",
      "target_sha256": "9a6b6d90d01fc216cee99fda9008e1659bbf74b2151b642e2c613e3c9f0f7fc4"
    },
    {
      "source_id": "id08820",
      "target": "— Итак, мы идём к Гроуслоу, мы — со шпагами, вы — с кинжалами; вчетвером мы овладеваем этими восемью болванами и их глупым командиром. Господин Портос, что вы на это скажете?",
      "source_sha256": "f563cd4b235ddcdcab855d9e39606a0a81c11a75061ba3ef0bff5fa501a51e54",
      "target_id": "ru-id08820",
      "tag": "p",
      "target_sha256": "0836a4e6db1dcdcbdf4f5e1c60388bb8712ec8022a3e395013b09d23ab547883"
    },
    {
      "source_id": "id08821",
      "target": "— Я говорю, что это легко, — сказал Портос.",
      "source_sha256": "984b1dafbcf038cfca1d0e88b3815bf60150fd66bdfe0d6cbe4a99fead5c2a98",
      "target_id": "ru-id08821",
      "tag": "p",
      "target_sha256": "774bd367719a4f97b5ce12bb1316e447349d6f23dc684636997ed0d045437268"
    }
  ],
