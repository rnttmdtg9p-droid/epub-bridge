{
  "unit": 65,
  "batch": 4,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id08722",
      "target": "— А! А! — произнёс Гроулоу.",
      "source_sha256": "1d0c6f0f3eb0fd8bf115eef91452a5143f00e88e60adeaeef0e77781003f56ce",
      "target_id": "ru-id08722",
      "tag": "p",
      "target_sha256": "b833577a6ee6ac40957637e95a3806150b607acb42b41a60da0d2abf4816b15a"
    },
    {
      "source_id": "id08723",
      "target": "— Теперь вы понимаете, что вынуждает меня отклонить вашу любезность, которую я, впрочем, тем более ценю, что нет ничего скучнее, чем всё время играть с одним и тем же человеком: шансы вечно уравновешивают друг друга, и через месяц видишь, что ни выиграл, ни проиграл.",
      "source_sha256": "53cb4549597a49eece4dd827a73e33869c149cd7858606b1db71a33ff3052fb1",
      "target_id": "ru-id08723",
      "tag": "p",
      "target_sha256": "0d0a18f74dba4fc69e3cf1d35c59ad60bb96bbb1dbdd40a78c696b2f81eb461c"
    },
    {
      "source_id": "id08724",
      "target": "— Ах! — со вздохом сказал Гроулоу. — Есть кое-что и поскучнее — не играть вовсе.",
      "source_sha256": "1bea05de33dae81838acde6f896ea6ba94d53288a7b1400b8fa71c5e245d4cf9",
      "target_id": "ru-id08724",
      "tag": "p",
      "target_sha256": "0b02c6fd2624a5c7ad549be12a8d56143e144d3c00a65470c7bf5e6b6ca71305"
    },
    {
      "source_id": "id08725",
      "target": "— Это я понимаю, — сказал д’Артаньян.",
      "source_sha256": "ca26ccc7960653701aba6f29b63f1c3dacc6486f232ebb5675b2ef68d23cd0a3",
      "target_id": "ru-id08725",
      "tag": "p",
      "target_sha256": "bda3769148c01204b65b311d35c98f5acf784598955e2c089f197b4164305bab"
    },
    {
      "source_id": "id08726",
      "target": "— Но послушайте, — продолжал англичанин, — а опасны ли ваши люди?",
      "source_sha256": "54cf2c4857442879d010c13d4cc9d8130f9d2bfcd33149e8cbdae2e57ef776c4",
      "target_id": "ru-id08726",
      "tag": "p",
      "target_sha256": "acaf9b985b6412edd280d5716309212cc1fed628b6734409fdc1583e8d887dc0"
    },
    {
      "source_id": "id08727",
      "target": "— В каком отношении?",
      "source_sha256": "ffd414dc8ca19878ec20e6afd340ab8ffc68c934475a2681949377200979b192",
      "target_id": "ru-id08727",
      "tag": "p",
      "target_sha256": "b9c2ceb4e08be20658a72acb172768b1fec781b8dca2d3b7a1aeb9978ccd32fc"
    },
    {
      "source_id": "id08728",
      "target": "— Способны ли они решиться на дерзкую вылазку?",
      "source_sha256": "ee8ed35b4cd379c3b1db91ef8903eba3a67bbfeaa77db1ed68fd9b3789bb8564",
      "target_id": "ru-id08728",
      "tag": "p",
      "target_sha256": "9f9eea4983fa2fe0f06bd8c96200a03cdd2b7babb3b1f6e57e7ba47c401a4d1f"
    },
    {
      "source_id": "id08729",
      "target": "Д’Артаньян расхохотался.",
      "source_sha256": "e85c58e5c084a42a0bed76324a21a1c574eda74b28c3c95c7eb78b379487c201",
      "target_id": "ru-id08729",
      "tag": "p",
      "target_sha256": "dc65479423f125087230022d42bd3e4229e12ca0f6f6907e08f4164655edbf2d"
    },
    {
      "source_id": "id08730",
      "target": "— Господи Иисусе! — воскликнул он. — Один из них трясётся в лихорадке, никак не в силах свыкнуться с тем прелестным краем, где вы живёте; другой — мальтийский рыцарь, робкий, как девица; а для пущей безопасности мы отняли у них даже складные ножи и карманные ножницы.",
      "source_sha256": "ac064ab94522cb7f13b080ad45c160e96eaf7a369e04c077546c9aae7b34fe83",
      "target_id": "ru-id08730",
      "tag": "p",
      "target_sha256": "647b1c6e5f8d2bff3403f66c97ebc0723af2086e7bb6a482954992b79a540053"
    },
    {
      "source_id": "id08731",
      "target": "— Что ж, — сказал Гроулоу, — приводите их.",
      "source_sha256": "9b8a904445c71ba78c21bfe849452d1432edac8d4201bc9062c7fe5fcd06a73f",
      "target_id": "ru-id08731",
      "tag": "p",
      "target_sha256": "8720826992f103ef85f33bdf049bcd87956f23774b7e9f294c0e74ca0cf7c1f7"
    },
    {
      "source_id": "id08732",
      "target": "— Как, вы хотите?.. — сказал д’Артаньян.",
      "source_sha256": "fa3fc88e11c161bcf6349d996aab6c9501d24be8a0c6c237049c0662076e87e2",
      "target_id": "ru-id08732",
      "tag": "p",
      "target_sha256": "301d5c9e6f9162d2f4f156ccc5408b61de7312b3da6b699220e7304593d6ce8a"
    },
    {
      "source_id": "id08733",
      "target": "— Да, у меня восемь человек.",
      "source_sha256": "643d7ed25d2801a7218e9523351f96635d4ea475006a136bc9227bc6b5ff3e50",
      "target_id": "ru-id08733",
      "tag": "p",
      "target_sha256": "c3f18772d15912458ac5687b1547ba4518c17ef960e8b63f66fbea1e4be5e844"
    },
    {
      "source_id": "id08734",
      "target": "— Ну и что же?",
      "source_sha256": "2caed6e1ccb03a9e5b3191e4e09dc771bdcca703c589c4b9b2a520a990a050f0",
      "target_id": "ru-id08734",
      "tag": "p",
      "target_sha256": "0372d0cc02b30b45ee0906a42a95fdac881a0e83dbb10bc95391cdd6ec02fa01"
    },
    {
      "source_id": "id08735",
      "target": "— Четверо будут стеречь их, четверо будут стеречь короля.",
      "source_sha256": "bb3ed8969affb4fa97f6fde08b26480410d0f54ccd8a786ee456a64492a264a7",
      "target_id": "ru-id08735",
      "tag": "p",
      "target_sha256": "bc6ca590f825f05bdaa8fa6926e1c433bab1ea773efabe8566f6bd2ef247cb4e"
    },
    {
      "source_id": "id08736",
      "target": "— В самом деле, — сказал д’Артаньян, — дело можно так устроить, хотя я причиняю вам большое беспокойство.",
      "source_sha256": "5cbd3414fdc2c548def4db5a0bb403a97474d26aa15b17231351e79f89fded13",
      "target_id": "ru-id08736",
      "tag": "p",
      "target_sha256": "fccaf5333741b554d36a10a132d59f1fe3a3c3dd82e0969be53b5194f5174727"
    },
    {
      "source_id": "id08737",
      "target": "— Ба! Приходите всё равно; увидите, как я всё улажу.",
      "source_sha256": "cecc8c7e2f149f672865f48246be4b01a3545e8c3b859f14fe890fb591d9e2aa",
      "target_id": "ru-id08737",
      "tag": "p",
      "target_sha256": "1a8acfa661bee66ca34a27374c42ec7e10fa93632815681ce3280ba329d8d965"
    },
    {
      "source_id": "id08738",
      "target": "— О, я об этом не тревожусь, — сказал д’Артаньян. — Такому человеку, как вы, я вверяюсь с закрытыми глазами.",
      "source_sha256": "cecd55676741e0c474688c2d7acbff1ded3bc896bea4605c0ecb32e3e0cf7a5c",
      "target_id": "ru-id08738",
      "tag": "p",
      "target_sha256": "2028daa91890b1c6bf0a4c8ff993c909d761baebec4f2cd45d8494a49cadc634"
    },
    {
      "source_id": "id08739",
      "target": "Эта последняя лесть вызвала у офицера один из тех маленьких довольных смешков, что делают людей друзьями того, кто их вызывает, ибо они — испарение приласканного тщеславия.",
      "source_sha256": "e215df08acf6a2183b66564ba94dc6d4a837687b1e61029259cbb425ab514fe4",
      "target_id": "ru-id08739",
      "tag": "p",
      "target_sha256": "59cb8d8120e93d167d0f3f9f2af42535ad4a33fc8c34a18d81dc6443be8c36a3"
    },
    {
      "source_id": "id08740",
      "target": "— Но, — сказал д’Артаньян, — мне пришло в голову: что мешает нам начать сегодня же вечером?",
      "source_sha256": "71d57ee4a4f494e7b383c3a234c5b8af0d4cdf1b7299361955c8e10710207b65",
      "target_id": "ru-id08740",
      "tag": "p",
      "target_sha256": "d5038e2b1d25da449a0ef8f0c61d22a5e28c681e9ec41447ca04f462c48af515"
    },
    {
      "source_id": "id08741",
      "target": "— Что именно?",
      "source_sha256": "76a587c94445b792a681201ec13506ab0ccb1622e0adbb18c41d7ace86f0e6ef",
      "target_id": "ru-id08741",
      "tag": "p",
      "target_sha256": "00e195d300c713a812567908a1542198c648cc146e5f98cadfd307320af6aba6"
    }
  ],
