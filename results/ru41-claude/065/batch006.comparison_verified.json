{
  "unit": 65,
  "batch": 6,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id08762",
      "target": "— Каким образом?",
      "source_sha256": "24abe4982bc1efaf04df8781dfe2ce72e9299c18c2fb0ec5d15297b000883304",
      "target_id": "ru-id08762",
      "tag": "p",
      "target_sha256": "c3206c9a81474d84488bdfc68e3d8d4a20c91f3abeb5c575e7ee481f2c2746f5"
    },
    {
      "source_id": "id08763",
      "target": "— Я представлю вам его сегодня вечером: он придёт играть с нами.",
      "source_sha256": "fd5930e77614843c260ab553f766d20a50fa8bae50adbe5cf65439e4afe9b2bf",
      "target_id": "ru-id08763",
      "tag": "p",
      "target_sha256": "2faaba820220d421d927701ef1e07887997ea2d272e6e106ef85dc18e7c5f410"
    },
    {
      "source_id": "id08764",
      "target": "— О-о! — сказал Портос, у которого при этом слове загорелись глаза. — А он богат?",
      "source_sha256": "d15b798487b851a85b540ef9ce6f81d5be5b57b4495944485150466ec18dc13a",
      "target_id": "ru-id08764",
      "tag": "p",
      "target_sha256": "13b4d974dc5b2276f4154b2eedeb218db989a5b233a9334c72e41fbfc7b8bd44"
    },
    {
      "source_id": "id08765",
      "target": "— Он сын одного из крупнейших торговцев Лондона.",
      "source_sha256": "240ea099a8423b5494a2aa8927bce08b0ba1b6840d7aa66495c4030332550eb2",
      "target_id": "ru-id08765",
      "tag": "p",
      "target_sha256": "8cea148df76f15e02fa75c1599d7e6e251d9f6eec3ac19a43e3a97303aeca1f7"
    },
    {
      "source_id": "id08766",
      "target": "— И он знает ландскнехт?",
      "source_sha256": "aabaa9741d22d0d7d55aff3b95eb71184382c94fd6d7314da97c259a444db0b4",
      "target_id": "ru-id08766",
      "tag": "p",
      "target_sha256": "89e92d78f639d757186cc4cec6bfaaeb8851d977cbb987c0c3538478642af663"
    },
    {
      "source_id": "id08767",
      "target": "— Он его обожает.",
      "source_sha256": "6a4badd082409bb91c75c9b286d202c4c06eefb3ec629da57cb6fde8f2336e70",
      "target_id": "ru-id08767",
      "tag": "p",
      "target_sha256": "b655fdcfb47bae072cee4819b6adb218a2da065688774c489725e0338ca2897d"
    },
    {
      "source_id": "id08768",
      "target": "— А бассет?",
      "source_sha256": "04b1a2d0f6ae74bc47c0ad0facc30310216be3590ceb256d74526445a7df3d31",
      "target_id": "ru-id08768",
      "tag": "p",
      "target_sha256": "9470da30d5d4f09029592cc904097b75dcd8ffaa81ecf838eef8fce8a7f52824"
    },
    {
      "source_id": "id08769",
      "target": "— Это его безумие.",
      "source_sha256": "66d4b4d65a6300fd1f5708db84e88a688bd781edc62a5846682aa7ffc0803d20",
      "target_id": "ru-id08769",
      "tag": "p",
      "target_sha256": "910fba890f2b7583cd6f6a9f73134c2ec26d3d544df7af16f2dea202c0978d22"
    },
    {
      "source_id": "id08770",
      "target": "— А бириби?",
      "source_sha256": "64de6f5e667ab9a57e460e5c9d0ce7ca35ca435456b6083d02d6a2eb9315c608",
      "target_id": "ru-id08770",
      "tag": "p",
      "target_sha256": "41bdd581d387db7aedcb4e18ccb39de6a8c7a9b8eba4bc85719f1b5f0501f649"
    },
    {
      "source_id": "id08771",
      "target": "— В нём он доходит до тонкостей.",
      "source_sha256": "b3a3884e19fdf460a4bf6b1f73f95c6369f64fea52cb513fcf669984ee5be6f4",
      "target_id": "ru-id08771",
      "tag": "p",
      "target_sha256": "a374e0378c89579a437c7d5fb2d83bd524e3acc0f7161891940945a1e474fe9e"
    },
    {
      "source_id": "id08772",
      "target": "— Отлично, — сказал Портос, — мы проведём приятную ночь.",
      "source_sha256": "b436bae51a01d80daa67f45cafd687cb95fae7c3d29085313d302d1d8acb34db",
      "target_id": "ru-id08772",
      "tag": "p",
      "target_sha256": "c8ff88bef8db45e635e374432c849f039f0c143d41ca73315eb0015ab533b968"
    },
    {
      "source_id": "id08773",
      "target": "— Тем более приятную, что она пообещает нам ночь ещё лучшую.",
      "source_sha256": "d8ca872c76eab236576fa9e00efa61438f5d0c04d35c5bd8fd041b312c1aef0a",
      "target_id": "ru-id08773",
      "tag": "p",
      "target_sha256": "1e195fd61110c82421cc37b30a47aa48b19c63b315b010b7cdb8416a630462c2"
    },
    {
      "source_id": "id08774",
      "target": "— Каким образом?",
      "source_sha256": "24abe4982bc1efaf04df8781dfe2ce72e9299c18c2fb0ec5d15297b000883304",
      "target_id": "ru-id08774",
      "tag": "p",
      "target_sha256": "c3206c9a81474d84488bdfc68e3d8d4a20c91f3abeb5c575e7ee481f2c2746f5"
    },
    {
      "source_id": "id08775",
      "target": "— Да: сегодня вечером мы даём ему сыграть, а завтра он даст сыграть нам.",
      "source_sha256": "66e2dcde35bd7ba3d187ef699d6103df9acaf3f41eba6815f8b7e0b7f8ba70f1",
      "target_id": "ru-id08775",
      "tag": "p",
      "target_sha256": "a3fb096995ad8a21f44d087bd7cfcc525041408e4bdac0b8134a2642f6830195"
    },
    {
      "source_id": "id08776",
      "target": "— Где же?",
      "source_sha256": "349748df10f9251c932d34b0f3c821fa7c6a6af2bceda1015f77227f570efde5",
      "target_id": "ru-id08776",
      "tag": "p",
      "target_sha256": "9b691ccb7a4d015da8a444ba56eeeb76f3e78170d71f3f76292a1d469c77af73"
    },
    {
      "source_id": "id08777",
      "target": "— Я вам скажу. А теперь займёмся только одним: достойно примем честь, которую оказывает нам г-н Гроуслоу. Сегодня вечером мы остановимся в Дерби: пусть Мушкетон поедет вперёд, и, если во всём городе найдётся хоть одна бутылка вина, пусть купит её. Не мешает ему и приготовить небольшой ужин, в котором вы участия не примете: вы, Атос, потому что у вас лихорадка, а вы, Арамис, потому что вы мальтийский рыцарь, и разговоры таких солдафонов, как мы, вам неприятны и заставляют вас краснеть. Вы хорошо это поняли?",
      "source_sha256": "309a64fedcbc629b8bcdd4cad91052121fe9d293c1aceab667094b80074ddc0b",
      "target_id": "ru-id08777",
      "tag": "p",
      "target_sha256": "c2a9515b2af71ad8e1b8e8f3d2ce60c1b4ed345bcd1ea5dcc5b8016103b69be9"
    },
    {
      "source_id": "id08778",
      "target": "— Да, — сказал Портос, — но чёрт меня побери, если я понимаю.",
      "source_sha256": "db46cca497437c9385f2199c6cdb4cca4dff204db4bf9c9547cd55ae4360dc29",
      "target_id": "ru-id08778",
      "tag": "p",
      "target_sha256": "114b2a33e80d0f2dfa1e73692e895418bea7b26a1a4ba56a8cd372fffe62be09"
    },
    {
      "source_id": "id08779",
      "target": "— Портос, друг мой, вы знаете, что по отцу я происхожу от пророков, а по матери — от сивилл, что говорю я только притчами и загадками; имеющие уши да слышат, а имеющие глаза да смотрят; больше сейчас я ничего сказать не могу.",
      "source_sha256": "93df9c1ea12e336c981498dc761d38b503eb355e6ea54c189662613901e0a0fc",
      "target_id": "ru-id08779",
      "tag": "p",
      "target_sha256": "4278958331650aaa018e1c63f65c09a03bdf01b52a3914a61fab2179ac96d113"
    },
    {
      "source_id": "id08780",
      "target": "— Делайте, друг мой, — сказал Атос, — я уверен, что всё, что вы делаете, сделано хорошо.",
      "source_sha256": "737c07e364bfe24654c32e922b7dafc2a896542fdaed57524d8ea599e8917419",
      "target_id": "ru-id08780",
      "tag": "p",
      "target_sha256": "12873da3c8440857ff6387be62ff332fe15ea4b25955de4c7528a8bbd4338463"
    },
    {
      "source_id": "id08781",
      "target": "— А вы, Арамис, придерживаетесь того же мнения?",
      "source_sha256": "f78e00974d23517c7367d425d8184fedbcceac1e5fba1bd4e26b62448f61cde1",
      "target_id": "ru-id08781",
      "tag": "p",
      "target_sha256": "6ae7ade463e9537fe9b096ce25dc1b5f7b481c3960f7a930099e197a1a316363"
    }
  ],
