{
  "unit": 30,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id04006",
      "target": "— От Фрике? — переспросил д’Артаньян. — Это имя мне знакомо.",
      "source_sha256": "a1ca64a9fddb2e563b485c24f0ac63eb22044040af8d2c8b76cc6826c3e125b0",
      "target_id": "ru-id04006",
      "tag": "p",
      "target_sha256": "a60b3da2597b6345d87688d062a80ef2d2f8b3fc54bccf7705953331f4eefd04"
    },
    {
      "source_id": "id04007",
      "target": "— Это сын служанки господина Бруселя, молодчик, который, ручаюсь вам, в мятеже не отдал бы своей доли собакам.",
      "source_sha256": "5ddeca87c873887a2b147057d1af379e9ccf93d8801945ca930c9a228a791f46",
      "target_id": "ru-id04007",
      "tag": "p",
      "target_sha256": "4409a3b6217767a106b0d1e9384a78f7dc23c9be798b93c5c87a78fc8591c5ad"
    },
    {
      "source_id": "id04008",
      "target": "— Не певчий ли он в Нотр-Дам? — спросил д’Артаньян.",
      "source_sha256": "b22a3c0d10240616e7fec3741ef456da972eef6d0d40dfb96ae43e1ac681a25a",
      "target_id": "ru-id04008",
      "tag": "p",
      "target_sha256": "d490b1c981f94a4108d49740fadabc0d8bd887f565a31d87301c490ed0424327"
    },
    {
      "source_id": "id04009",
      "target": "— Да, он самый; Базен ему покровительствует.",
      "source_sha256": "85e996fddbf860377dc596714ef4ec47b6fdb676bf0589a17422be6e75019954",
      "target_id": "ru-id04009",
      "tag": "p",
      "target_sha256": "b9f86d5956c58cfdaef33550b2a7d5eb85251239632f4baea870cefdf15575c6"
    },
    {
      "source_id": "id04010",
      "target": "— А-а! Знаю, — сказал д’Артаньян. — И мальчик за стойкой в кабачке на улице Каландр?",
      "source_sha256": "a015e21e5663e57131ef91a1179b076ba6280180e6cbc37c2bd89dcfce5fd0f5",
      "target_id": "ru-id04010",
      "tag": "p",
      "target_sha256": "cecfc5183beed40e233bf28a9e1d86a52b761bf927f02b9e7a77aeee69148823"
    },
    {
      "source_id": "id04011",
      "target": "— Вот именно.",
      "source_sha256": "794be617d028265b56d20bc89183f24ef4514b88920a86ae7f65602830f38d89",
      "target_id": "ru-id04011",
      "tag": "p",
      "target_sha256": "7526799da4dd42c74019ffde78d9326074fe2d1de2b61e9379a56e6c6ff23723"
    },
    {
      "source_id": "id04012",
      "target": "— Что вам в этом мальце? — спросил Портос.",
      "source_sha256": "bf77003297d8cea37fbdf4ec79882d8db379a082cf36181d5e4d906d1aec0972",
      "target_id": "ru-id04012",
      "tag": "p",
      "target_sha256": "95d92e5c28e99ebb86c4fb6929fe7a07a4c4131bd099ec2f288981bc16355a4a"
    },
    {
      "source_id": "id04013",
      "target": "— Хм! — сказал д’Артаньян. — Он уже давал мне хорошие сведения и при случае мог бы дать ещё.",
      "source_sha256": "5c26a0d8ba37f0098ec0bd059ded1a4e9269b6913ab8db992c12207bc551d48b",
      "target_id": "ru-id04013",
      "tag": "p",
      "target_sha256": "1c7c0fde884d5d62982c1cb8345e0f52939f8279b6112d7e7651823e183cf8a6"
    },
    {
      "source_id": "id04014",
      "target": "— Вам, чуть не задавившему его хозяина?",
      "source_sha256": "5b77f898cde8047c105a1c10adb10d57d86efe183c1728973ee70d894ea7f609",
      "target_id": "ru-id04014",
      "tag": "p",
      "target_sha256": "5a46410d477ed9c54f46e7f582141a90b4b24dd6c0d9d118b87c9b3890ec86d5"
    },
    {
      "source_id": "id04015",
      "target": "— А кто ему об этом скажет?",
      "source_sha256": "0b55ffca1e90c314be511d1aba280ed2a6d633d670bfa981fa2d6b7844075a3c",
      "target_id": "ru-id04015",
      "tag": "p",
      "target_sha256": "cf6986d872ffe6e3f5bbb8c5059cc24de4497f12ccc490b9bfbaff27b845ce70"
    },
    {
      "source_id": "id04016",
      "target": "— Это верно.",
      "source_sha256": "04234ed8ee9232354c819d96d3a51f346f61edbd942c573a6f86c53c8625a9c5",
      "target_id": "ru-id04016",
      "tag": "p",
      "target_sha256": "7187123eb85427664fccb3fdfe99d8322b16538518b8c747279eff5fbd698075"
    },
    {
      "source_id": "id04017",
      "target": "В ту же самую минуту Атос и Арамис въезжали в Париж через предместье Сент-Антуан. Они подкрепились в пути и торопились, чтобы не опоздать на свидание. За ними следовал один Базен. Гримо, как помнит читатель, остался ходить за Мушкетоном и должен был прямо присоединиться к молодому виконту де Бражелону, который отправлялся во Фландрскую армию.",
      "source_sha256": "3e2cf0495c84b415f32cc342228f7ece076511175a16cbaa689c0a77c4c54c59",
      "target_id": "ru-id04017",
      "tag": "p",
      "target_sha256": "1a88b1c1b6e66cb2338a2bb6f3a04d0fe62d418b13e76d4e5ab0f99d7595814e"
    },
    {
      "source_id": "id04018",
      "target": "— Теперь, — сказал Атос, — нам надо заехать в какую-нибудь гостиницу, чтобы надеть городское платье, оставить пистолеты и шпаги и обезоружить нашего слугу.",
      "source_sha256": "f65fd6bc8d73e96f246ca485580e23430105f8b1258e839e5154eba167610bde",
      "target_id": "ru-id04018",
      "tag": "p",
      "target_sha256": "b4af9a364a33f262b7fceb3b647d59f88aa45fd2b04bf8c0ddc6489285abed19"
    },
    {
      "source_id": "id04019",
      "target": "— О, нисколько, дорогой граф, и в этом вы позволите мне не только не согласиться с вами, но и попытаться привлечь вас на мою сторону.",
      "source_sha256": "371a885fc69a637037d97f34d5bf4f0d9d3b45fb42013871b361e371bfff2f51",
      "target_id": "ru-id04019",
      "tag": "p",
      "target_sha256": "55b63717b8ca89ca94750c3d1291e2f38742e1317d39c1d1b7e965f9877f9c36"
    },
    {
      "source_id": "id04020",
      "target": "— Почему же?",
      "source_sha256": "120a856622f024cc93ff199c2b3ebc654f9e65761c27017bfd8d0e9f88b68c05",
      "target_id": "ru-id04020",
      "tag": "p",
      "target_sha256": "d04e535109dce7f15eaca0f9a4b515ecd71d7a92dd33d80dbaec78fd084b9d52"
    },
    {
      "source_id": "id04021",
      "target": "— Потому что мы едем на военное свидание.",
      "source_sha256": "abccf86b132a51b8ed1b7a173147ca782033817914774d0599996239d0e67c48",
      "target_id": "ru-id04021",
      "tag": "p",
      "target_sha256": "f0868bd1fd1fe719a4b297b1ae7e5e1ed25ba5608ec0d7a204ab41c35fc0fcf4"
    },
    {
      "source_id": "id04022",
      "target": "— Что вы хотите сказать, Арамис?",
      "source_sha256": "730175fdddcd6882cac7a2ed3ef9b7f76e2d6d0f174bea61e29d9dd4969ab106",
      "target_id": "ru-id04022",
      "tag": "p",
      "target_sha256": "cc696e5ed4d820c383f0a4b3f30d45da7b67523d3f5016309b3f8fb077150a16"
    },
    {
      "source_id": "id04023",
      "target": "— Что Королевская площадь — это продолжение большой Вандомской дороги, и ничего другого.",
      "source_sha256": "bc0077233f22ab2db2c168dfe8a2d011773ede65bece2df321f97bb473554b93",
      "target_id": "ru-id04023",
      "tag": "p",
      "target_sha256": "e57b17155338da987ed384192bf561eae94aa0d81a3d39f42d2295e53f61963c"
    },
    {
      "source_id": "id04024",
      "target": "— Как! Наши друзья…",
      "source_sha256": "952bfc114ede80834ca92703b4a099f42878883e1a64af852d963e443b24cea4",
      "target_id": "ru-id04024",
      "tag": "p",
      "target_sha256": "1947f90945074161a62cc0a83a17a5c11ed1ea3e8dab221b2cdbe9bb09b480e6"
    },
    {
      "source_id": "id04025",
      "target": "— Стали нашими опаснейшими врагами, Атос; поверьте мне, будем недоверчивы, а главное — будьте недоверчивы вы.",
      "source_sha256": "d065568c3440087cff267d0221fa6545fdb05c61fa92814ec45fbec602ddebed",
      "target_id": "ru-id04025",
      "tag": "p",
      "target_sha256": "19cc515a1861a1b5a6072ccc8927071f7506fc1324f06a1e77e8dd35297ad434"
    }
  ],
