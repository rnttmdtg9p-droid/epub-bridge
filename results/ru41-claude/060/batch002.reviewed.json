{
  "unit": 60,
  "batch": 2,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id08142",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-id08142",
      "tag": "p",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "id08143",
      "target": "— Кем? — спросил Кромвель.",
      "source_sha256": "c63da5e07247f201691d7f34fb69087bed2094e6b19ff0e2d45defe309d20d18",
      "target_id": "ru-id08143",
      "tag": "p",
      "target_sha256": "c95f59ea99b19df610390579fdda5dc9c083f7971c806c173d7c5d67c0fc88dc"
    },
    {
      "source_id": "id08144",
      "target": "— Мною.",
      "source_sha256": "177c52202eca12b706888148fb7f431b596516ddc41863799acd3e5e4a1e547b",
      "target_id": "ru-id08144",
      "tag": "p",
      "target_sha256": "a134a56c45b5bc812f956df2890913a00b82a139ddfdb0e994dc816a4d68146b"
    },
    {
      "source_id": "id08145",
      "target": "— Как его звали?",
      "source_sha256": "01ae75d0589349894da470e825c8c34347dd9a811610b02cadce985f42d33527",
      "target_id": "ru-id08145",
      "tag": "p",
      "target_sha256": "d7f3c3b4bc44f75cdbe81fc350a36b1c08d85330409de2ca5df5a71fc11614c3"
    },
    {
      "source_id": "id08146",
      "target": "— Лорд де Винтер.",
      "source_sha256": "90818609050bd25bdf9996fb69871f3456adecf38346314219a36677a56a98fc",
      "target_id": "ru-id08146",
      "tag": "p",
      "target_sha256": "d6d3874366e242d22f0b9aca61708d12e80558ce9aa223a0c974421ec89dace8"
    },
    {
      "source_id": "id08147",
      "target": "— Ваш дядя? — воскликнул Кромвель.",
      "source_sha256": "c1f122393c8a9a3cd72fc64a2f183fa317db453a971773ef5f8dc7db272cb4d4",
      "target_id": "ru-id08147",
      "tag": "p",
      "target_sha256": "42fe1fb6b2230a7cc9c5d7f86472464b3b637584e00763c79b08e74e5f80b142"
    },
    {
      "source_id": "id08148",
      "target": "— Мой дядя! — возразил Мордонт. — Изменники Англии не принадлежат к моей семье.",
      "source_sha256": "5bd8b1de457eddf5e1466868eaf33a317891a3d534fe7787c68eef16a44e2e5d",
      "target_id": "ru-id08148",
      "tag": "p",
      "target_sha256": "34400d7c7b1aed1b71cbad7f8cf7fa9d1e70fd358c4f96023453af11d7a740ab"
    },
    {
      "source_id": "id08149",
      "target": "Кромвель на мгновение задумался, глядя на этого молодого человека; затем с той глубокой меланхолией, которую так хорошо изображает Шекспир, сказал:",
      "source_sha256": "3ebf1ebe1e854b33c8026710d9be7949af066e87c84dacafb28bebf7faa9fade",
      "target_id": "ru-id08149",
      "tag": "p",
      "target_sha256": "f63c1d587b35c974a6badbc30a0cf218d80084b20ff8436d74ce798a946eae7c"
    },
    {
      "source_id": "id08150",
      "target": "— Мордонт, — сказал он ему, — вы страшный слуга.",
      "source_sha256": "5b9681c6fc23bd4e209a50796c2341bfd93383cc2a9e4a52a3336ff715e95536",
      "target_id": "ru-id08150",
      "tag": "p",
      "target_sha256": "1eac3cc7e3e99d810f4ce42032460c23e7ad7517e411cf19eeb12d600b0b1ff7"
    },
    {
      "source_id": "id08151",
      "target": "— Когда Господь повелевает, — сказал Мордонт, — нечего торговаться с его веleниями. Авраам занёс нож над Исааком, а Исаак был его сыном.",
      "source_sha256": "2d8941863b53c6ae2c719a33d3039c4e6594ed821ae1ddc1fe2e7251d81f7d2a",
      "target_id": "ru-id08151",
      "tag": "p",
      "target_sha256": "379bf50aa4f0bbc714f095f83e8cf3e12e91046461377a28c2af69022a7a3730"
    },
    {
      "source_id": "id08152",
      "target": "— Да, — сказал Кромвель, — но Господь не позволил жертвоприношению совершиться.",
      "source_sha256": "c96bcfd4f3cf90e0f33a883ed3878ed273858c6b4882d4a35a47966ce9ce4b6b",
      "target_id": "ru-id08152",
      "tag": "p",
      "target_sha256": "0eea2d3b566044a8e3c3cbf5a76b7872eeffe59a454d83dc38dbf0bf1f3231c5"
    },
    {
      "source_id": "id08153",
      "target": "— Я посмотрел вокруг, — сказал Мордонт, — и не увидел ни козла, ни козлёнка, застрявшего в кустах на равнине.",
      "source_sha256": "eac8f6e035434ba5efdd822baabaca12f89007281d016399f558a1738fff4ffb",
      "target_id": "ru-id08153",
      "tag": "p",
      "target_sha256": "d4b5ad82049b751fe3b57d474ffc246b0be94a90fbc3fb4c0fed8a031272539e"
    },
    {
      "source_id": "id08154",
      "target": "Кромвель наклонил голову.",
      "source_sha256": "11b8719a88c7892dd27f521da0986058a5e6bd1f069529b9ececae14ff9feac0",
      "target_id": "ru-id08154",
      "tag": "p",
      "target_sha256": "b9c134398407599515cfdfe1ff71bbaf210d548a6667115249a5eea1c44abf8f"
    },
    {
      "source_id": "id08155",
      "target": "— Вы сильны среди сильных, Мордонт, — сказал он. — А французы, как они себя вели?",
      "source_sha256": "decff9d6eebb53962cc5d3a47fbd609cebbea72cede6bb7171f992d5f994a64f",
      "target_id": "ru-id08155",
      "tag": "p",
      "target_sha256": "16224728070405c351314420e64dd69385e872be557c80d4fcbc589aba050a46"
    },
    {
      "source_id": "id08156",
      "target": "— Как люди отважные, сударь, — сказал Мордонт.",
      "source_sha256": "8db956a2fa9027adf7d4be3db86ab97b7854a42cfc74d393bd6f98601cb32698",
      "target_id": "ru-id08156",
      "tag": "p",
      "target_sha256": "bc91d54189a3e799348865b9b658d0d047a4a1fc5b49f3c8f95f0532fc5e5bb8"
    },
    {
      "source_id": "id08157",
      "target": "— Да, да, — пробормотал Кромвель, — французы хорошо сражаются; и в самом деле, если моя подзорная труба хороша, мне кажется, я видел их в первом ряду.",
      "source_sha256": "f09417ccfd2ad312a9f7d7793f2478b21b50014d6056e77c43683e2bfea5f0c2",
      "target_id": "ru-id08157",
      "tag": "p",
      "target_sha256": "c94edfe310fcd0ecd6aa13e1b5eda9f3710d11fb2515c5653db79f63fc91dade"
    },
    {
      "source_id": "id08158",
      "target": "— Они были там, — сказал Мордонт.",
      "source_sha256": "a28eb777e3e7f917755bba3619bec6ea89676f696a160961b57ae1caa1048cac",
      "target_id": "ru-id08158",
      "tag": "p",
      "target_sha256": "c5be8624b7dbcc02881f1860ba45b614ef839cfbfc867631a9a01ee2ec873852"
    },
    {
      "source_id": "id08159",
      "target": "— Однако после вас, — сказал Кромвель.",
      "source_sha256": "5640c079689dbf10b8f81f32c93c574c32ee5210ba7d6ef7f92c9ae72e26c22f",
      "target_id": "ru-id08159",
      "tag": "p",
      "target_sha256": "e776ab10fbd70bb6e16a935583c0ae11f11d126e8db108f46a8f1b6fcf05229c"
    },
    {
      "source_id": "id08160",
      "target": "— Это вина их лошадей, а не их самих.",
      "source_sha256": "a744b058aea54f9fa19aa2233cec04cec50dd74fc0e2abd7a6a22ff05cd90072",
      "target_id": "ru-id08160",
      "tag": "p",
      "target_sha256": "d8a3a6a616ca081b6e00747431dd6576ef8b7f25a2d87a42e03c525d90d49c0e"
    },
    {
      "source_id": "id08161",
      "target": "Снова наступило мгновение молчания.",
      "source_sha256": "b848bc6847e548caba177184da993438a3d21e014cc72ec663b651dc219b0f42",
      "target_id": "ru-id08161",
      "tag": "p",
      "target_sha256": "042020ab7eb8604392e2a4a9368e0e7c122b8ca879c6b73b451be15dd5d51a34"
    }
  ],
