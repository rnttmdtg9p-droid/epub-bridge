{
  "unit": 60,
  "batch": 3,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id08162",
      "target": "— А шотландцы? — спросил Кромвель.",
      "source_sha256": "68807844c841258ed988ac3832b4349c8557bfff64f2500b032fe2e41c0418b9",
      "target_id": "ru-id08162",
      "tag": "p",
      "target_sha256": "2571989a46ccbe25c777e6a40f433d25a6c5593a8bfeaa24de96915f2d4de524"
    },
    {
      "source_id": "id08163",
      "target": "— Они сдержали слово, — сказал Мордонт, — и не двинулись с места.",
      "source_sha256": "5be96f1fab3bc3717093c65496d3640b9b5f9aa235fcc63457dfe7e86feab3d8",
      "target_id": "ru-id08163",
      "tag": "p",
      "target_sha256": "f9747047331ab731234e355b7fdd25a19cacaaf1d621bd5f3f548cbf7d0ddd0f"
    },
    {
      "source_id": "id08164",
      "target": "— Негодяи! — пробормотал Кромвель.",
      "source_sha256": "6def41776f7765fb882abe35ad87f7755b6db614cfbe15ee5870b5ca79785184",
      "target_id": "ru-id08164",
      "tag": "p",
      "target_sha256": "b4eb8d79ac9a7c61810e8b4fc3e2838e53fba39f0cc30645d513185266641a80"
    },
    {
      "source_id": "id08165",
      "target": "— Их офицеры просят увидеться с вами, сударь.",
      "source_sha256": "ac6ff22eba7abe492bae2164b138cace90e1823f7ed267d99f1dcb3ef13e6283",
      "target_id": "ru-id08165",
      "tag": "p",
      "target_sha256": "1c0c0d5c5bec721077baaa3333103c1a846c8dfe5731160a6ec10c6c35385e3e"
    },
    {
      "source_id": "id08166",
      "target": "— У меня нет времени. Им заплатили?",
      "source_sha256": "99efea9d3952b43e989b3f10c985aac63601414f2e2e1ac03c1b12bf7ffc3cf4",
      "target_id": "ru-id08166",
      "tag": "p",
      "target_sha256": "98c8e17e2946854226607806958917f4d6fba237c9ea1f7c01c028486cb17a2d"
    },
    {
      "source_id": "id08167",
      "target": "— Этой ночью.",
      "source_sha256": "81f95f9b95d4e41a1626d2f5360971542ec5c1fe4d8f6902d4cd3e6a921593d7",
      "target_id": "ru-id08167",
      "tag": "p",
      "target_sha256": "2978457fbcd76c72b4afe19ed598e8036d9d6438d9f18ed2add0fae27a4864d3"
    },
    {
      "source_id": "id08168",
      "target": "— Тогда пусть уходят, пусть возвращаются в свои горы, пусть прячут там свой позор, если только их горы достаточно высоки для этого; у меня больше нет с ними дела, а у них — со мной. А теперь ступайте, Мордонт.",
      "source_sha256": "9cdeda18618c787da55555d3c5a60ac1b2933f121202c263bcec7dba5b71bc91",
      "target_id": "ru-id08168",
      "tag": "p",
      "target_sha256": "0b29b9033a5de1da9b4e456127a127dfdae8ea65f89c5069d5bbadb0cabbed9a"
    },
    {
      "source_id": "id08169",
      "target": "— Прежде чем уйти, — сказал Мордонт, — я хотел бы задать вам несколько вопросов, сударь, и обратиться к вам с просьбой, мой господин.",
      "source_sha256": "e020cfb28ba2047b032c9b829e1415b3e1de05f3d1507da363a77d90b4854f67",
      "target_id": "ru-id08169",
      "tag": "p",
      "target_sha256": "bace776b792bd007b8bd1b48388068b520627b782d2b6da5ada94c26c8418717"
    },
    {
      "source_id": "id08170",
      "target": "— Ко мне?",
      "source_sha256": "ce95db591a43f47c22fc332b28c4bbf792b519db1ffcc022404c1e668942ac8c",
      "target_id": "ru-id08170",
      "tag": "p",
      "target_sha256": "9bb894cf1d47b1dbc52bd693c303aadd411dae97962c55a166d1a59bdbe1d846"
    },
    {
      "source_id": "id08171",
      "target": "Мордонт поклонился:",
      "source_sha256": "98e1f1302c7edfe4594cc35d44f2fb1329f6f84a85c6312715c766318c29d390",
      "target_id": "ru-id08171",
      "tag": "p",
      "target_sha256": "233c8280e646649ec2f78ec6ec86746811e67b3ebe8355d3e4cab742a088eaa0"
    },
    {
      "source_id": "id08172",
      "target": "— Я прихожу к вам, мой герой, мой покровитель, мой отец, и говорю вам: господин мой, довольны ли вы мною?",
      "source_sha256": "cc46ea7772ea89b3f2550de7cfe2dfb2963d31d55463982fd29bf30a95e37626",
      "target_id": "ru-id08172",
      "tag": "p",
      "target_sha256": "a1eb751823c1fca849d7b0f64ac62b595d4d1cc2fcc6112f7fe88eb3ee031a92"
    },
    {
      "source_id": "id08173",
      "target": "Кромвель посмотрел на него с удивлением.",
      "source_sha256": "b395f3701a6d73fa9ef9dc8c096371ce001fdfba79203ea57f4fde945f5a9a81",
      "target_id": "ru-id08173",
      "tag": "p",
      "target_sha256": "0e2f197f5294c8bdc214be0d9621b9ad2be83690b903bd88bd01a6556159f549"
    },
    {
      "source_id": "id08174",
      "target": "Молодой человек оставался невозмутим.",
      "source_sha256": "e11a664cf3d82f1645be4f161d58a0b0635dc3f6fe73e8ef4af4fe373e2dd42b",
      "target_id": "ru-id08174",
      "tag": "p",
      "target_sha256": "fbc1098d65a4c68f0497cdcdf7fc3272a2fcbd71f453f8eb74a4d0aa94532323"
    },
    {
      "source_id": "id08175",
      "target": "— Да, — сказал Кромвель, — с тех пор как я вас знаю, вы исполняли не только свой долг, но и более того: вы были верным другом, ловким переговорщиком, хорошим солдатом.",
      "source_sha256": "3aebb6c0163fdcf0dfabea30e206d57ff0413c9d9c870d3557a0f1c62ffa7107",
      "target_id": "ru-id08175",
      "tag": "p",
      "target_sha256": "71c8d78ab8dd0a32b2359d13f4527a761c7d2a1591e2346f6dbfbbe3b9665691"
    },
    {
      "source_id": "id08176",
      "target": "— Помните ли вы, сударь, что именно мне первому пришла мысль условиться с шотландцами о том, чтобы они отказались от своего короля?",
      "source_sha256": "42c8376a9674dabd676a2552534c4d6c97a21d9bb92947f2cfb75fbb3956c73c",
      "target_id": "ru-id08176",
      "tag": "p",
      "target_sha256": "c9aeddc162b020fddc8bcfcebda71b06475a2d8156b45c071284bf54f3e8a9f4"
    },
    {
      "source_id": "id08177",
      "target": "— Да, мысль исходит от вас, это правда; я еще не заходил в презрении к людям так далеко.",
      "source_sha256": "a64688bc7056d846c346e076f1499861421ee909daad361e8b0c2e6e6faa05de",
      "target_id": "ru-id08177",
      "tag": "p",
      "target_sha256": "58da2e763bb8b83d3bd075abb933767e783d85bd9982ab7f18748078d9fa0190"
    },
    {
      "source_id": "id08178",
      "target": "— Хорошим ли послом я был во Франции?",
      "source_sha256": "897e7d308297ef994dc7b52bcdde80d91b3972737a8cede54dd27e2e67a736ce",
      "target_id": "ru-id08178",
      "tag": "p",
      "target_sha256": "454854a23a291322c5e1c462a8285a300cdcfab8af78e7323ccb220c264d703d"
    },
    {
      "source_id": "id08179",
      "target": "— Да, и вы добились от Мазарини того, о чем я просил.",
      "source_sha256": "5ebe9eccf6e7a16ff6e624e76213e998d646096a85b0f09e112089233a2b65b1",
      "target_id": "ru-id08179",
      "tag": "p",
      "target_sha256": "660d36b707fc73daab7f105af45b22564266314d64555950e1696b049306bb95"
    },
    {
      "source_id": "id08180",
      "target": "— Всегда ли я сражался ревностно за вашу славу и ваши интересы?",
      "source_sha256": "b0a42ecc39f7194b68c630c6e64ff15c98bde4d6101c9221701683d4cbbaf1b5",
      "target_id": "ru-id08180",
      "tag": "p",
      "target_sha256": "ae8550142ba455e2bdae7249f922ba9129fd9bd06fd980488930fd90c644e0eb"
    },
    {
      "source_id": "id08181",
      "target": "— Быть может, даже слишком ревностно, — именно это я и ставил вам в упрек только что. Но к чему вы клоните всеми этими вопросами?",
      "source_sha256": "e92b289cc2fc79455205a184fe397d62f3b677db3bc3424a670252ff08837262",
      "target_id": "ru-id08181",
      "tag": "p",
      "target_sha256": "0e5bd1b4c90f8c648f0e08753453132d642acf3db98e252d0a21f0042742e428"
    }
  ],
