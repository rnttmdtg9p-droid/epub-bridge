{
  "unit": 97,
  "batch": 1,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id12251",
      "target": "Она снова вздохнула и оперла прелестную головку на кокетливо согнутую кисть руки, по-прежнему восхитительную по форме и белизне.",
      "source_sha256": "b0b22b9f6eeff9dab2f47295c5bbc8fc15735d7e04a3ef19a24833a083f3a70e",
      "target_id": "ru-id12251",
      "tag": "p",
      "target_sha256": "27ea22f42be2a0229326a38859ef31f3b6e771cab3a38c5e2f6e0c81464f5c1e"
    },
    {
      "source_id": "id12252",
      "target": "— Сударыня, — возразил граф, — что же вы говорили только что? Никогда я не видел вас такой юной, никогда не видел вас прекраснее.",
      "source_sha256": "dad44da76d5982a38bbed6c5c09258fbd15bb0981ddc1619eb8ddba4b03fdb69",
      "target_id": "ru-id12252",
      "tag": "p",
      "target_sha256": "c8bb7b804e28588ffa93db15a482863cb871b7c30bf5d5a00d787a828b338253"
    },
    {
      "source_id": "id12253",
      "target": "Герцогиня покачала головой.",
      "source_sha256": "05d2c5b4ec503dc795b1f3b2d96803c6de12fa14ecbe16e4ec31b11090d1c1ce",
      "target_id": "ru-id12253",
      "tag": "p",
      "target_sha256": "cb11284208e7ac3dc4e50d9a95fdc2d150092bd59771eefcfbcf4149920ddd2e"
    },
    {
      "source_id": "id12254",
      "target": "— Господин де Бражелон остаётся в Париже? — спросила она.",
      "source_sha256": "155d001bd4879e8b76aa3818405d2cd2e8fca36b34a0fe5fe4429e365db01d50",
      "target_id": "ru-id12254",
      "tag": "p",
      "target_sha256": "2aeb0413a3ef5ef21ce74cbd20b2934575345fe32fbf359c5a4bf6280a19ad80"
    },
    {
      "source_id": "id12255",
      "target": "— А как вы думаете? — спросил Атос.",
      "source_sha256": "55f65d5a098af1c6d432036e69b3b6e7358aa6ecaeb1ba240e9271adc533ea1e",
      "target_id": "ru-id12255",
      "tag": "p",
      "target_sha256": "e21c9c1c1468aa8d1ef05584acf2ded765978f1076cccb506cc2d6d2b04fd730"
    },
    {
      "source_id": "id12256",
      "target": "— Оставьте его мне, — отозвалась герцогиня.",
      "source_sha256": "c8eef6551893728a5ad71c96e413f0a76b36f1563bc079dbf2c4546f7365b0e4",
      "target_id": "ru-id12256",
      "tag": "p",
      "target_sha256": "47857dc9918d7d5cbd06359786e0cd9cf2bd48f2695d96e92ffc74bbb7f48679"
    },
    {
      "source_id": "id12257",
      "target": "— Ни за что, сударыня: если вы забыли историю Эдипа, то я её помню.",
      "source_sha256": "019b50805f116ad24cbeaecdac1d8fc2adc3de7b739a3967bd0f77a9702c75bb",
      "target_id": "ru-id12257",
      "tag": "p",
      "target_sha256": "b57343acc508b72a44ebfc0b66d6e4c3aee683a669db8279274c23e1311614fb"
    },
    {
      "source_id": "id12258",
      "target": "— Право, вы очаровательны, граф, и мне хотелось бы прожить месяц в Бражелоне.",
      "source_sha256": "3ab3272869fb8c8c0aaf1f8850acbd7952a3b1d15d2ad35a46f47a6274d5a223",
      "target_id": "ru-id12258",
      "tag": "p",
      "target_sha256": "e25c549414ca385cca53b87bef5dd9e00a85e0342c0555074824e0dc96b8ea86"
    },
    {
      "source_id": "id12259",
      "target": "— Не боитесь ли вы, герцогиня, что у меня появится множество завистников? — галантно ответил Атос.",
      "source_sha256": "abe049f56f09059aa283624c92a453981454dfd6a64c1a2dfc6e228606265938",
      "target_id": "ru-id12259",
      "tag": "p",
      "target_sha256": "f6d9ee1145d91378c6d01e7ca694c85b630b2982ec348e958e1ee5da23c433ee"
    },
    {
      "source_id": "id12260",
      "target": "— Нет, я приеду инкогнито, граф, под именем Мари Мишон.",
      "source_sha256": "776c5e051f058aecf1b07a5c241420b518b1850b512add5e43ca97518b49e3a5",
      "target_id": "ru-id12260",
      "tag": "p",
      "target_sha256": "85dc0a7eaa3836e82477813d6ea0dcefbbec5ceda362f5eee32605782d53f841"
    },
    {
      "source_id": "id12261",
      "target": "— Вы восхитительны, сударыня.",
      "source_sha256": "15fdb086776a3040ea0f0ee693fa151d8419b4101da58bf855af6b89897dc272",
      "target_id": "ru-id12261",
      "tag": "p",
      "target_sha256": "87148f80ffa14d45a9ff96619016402386eace94476636625587687529f6840c"
    },
    {
      "source_id": "id12262",
      "target": "— Но Рауля не оставляйте возле себя.",
      "source_sha256": "3ed6c818b87adb13cc6222f23230c89f69786dcb246f0443fdffafb860030850",
      "target_id": "ru-id12262",
      "tag": "p",
      "target_sha256": "8f11180e8e6897a6ad66cdc6ed2601536eb81563b6328df7b05cc62a82e82766"
    },
    {
      "source_id": "id12263",
      "target": "— Почему же?",
      "source_sha256": "a8fa7453ebc8a0dbf427ff426d3b569471c511fefc35a91dd136e6ca4f0242f4",
      "target_id": "ru-id12263",
      "tag": "p",
      "target_sha256": "d04e535109dce7f15eaca0f9a4b515ecd71d7a92dd33d80dbaec78fd084b9d52"
    },
    {
      "source_id": "id12264",
      "target": "— Потому что он влюблён.",
      "source_sha256": "ec6f1a202e03319818b8b63e2d20b5959ceb7d04a5023033dcbb4a0a17081f84",
      "target_id": "ru-id12264",
      "tag": "p",
      "target_sha256": "38e0a03453996746f102fb1f6de3689a12149ed760dd1d94ca9d0261f3452be2"
    },
    {
      "source_id": "id12265",
      "target": "— Он — дитя!",
      "source_sha256": "25e9a11bf74661b6c0fd39a136ae55308bab18888279b7aad6a604e85e7a394c",
      "target_id": "ru-id12265",
      "tag": "p",
      "target_sha256": "a1473cc28f136fd2d2e5db8c3381ba2da00a0f58e3184b16b7a614201c7fb10b"
    },
    {
      "source_id": "id12266",
      "target": "— Так ведь и любит он дитя!",
      "source_sha256": "bdbd4afcf8521c13707f9be2eb6684da67a5e8a314d35c962414b381517b3913",
      "target_id": "ru-id12266",
      "tag": "p",
      "target_sha256": "5e00d25c0afdcebc0ca414e791ef65c814345d2b27104ac499fadea1cccec277"
    },
    {
      "source_id": "id12267",
      "target": "Атос стал задумчив.",
      "source_sha256": "de77ec408be36b012c6aad034f0cc3319fcce5b1cc46ecfd4f6a4960bb5900d8",
      "target_id": "ru-id12267",
      "tag": "p",
      "target_sha256": "36fd8663fb623ce1307f5ec454d454749e91156adcc1ac7f9c24d61d97b6251c"
    },
    {
      "source_id": "id12268",
      "target": "— Вы правы, герцогиня, эта странная любовь к семилетней девочке когда-нибудь может сделать его очень несчастным; во Фландрии скоро будут драться, и он поедет.",
      "source_sha256": "1822b934c9d27fa213c83f8116c4c0a31fea7b0b3450df315743044fa7fd56d1",
      "target_id": "ru-id12268",
      "tag": "p",
      "target_sha256": "a5bca889db357f7057177902be957fb7d2aacd6994d530454b991356a4037d87"
    },
    {
      "source_id": "id12269",
      "target": "— А потом, в свою очередь, вы пришлёте его ко мне, и я заключу его в кирасу против любви.",
      "source_sha256": "96bfab58d47be1886fecec82c25e3c6188f3e6668304a99d55b93b1b695203ec",
      "target_id": "ru-id12269",
      "tag": "p",
      "target_sha256": "72ca91d32d6f0a93d36df0607128a06ba1d2afb648431aeeff189502b1afb068"
    },
    {
      "source_id": "id12270",
      "target": "— Увы, сударыня, — сказал Атос, — нынче любовь подобна войне, и кираса в ней стала бесполезной.",
      "source_sha256": "18eeb06f8392f15ea1193c4a80188daa7748c6b01d5c74fe840c9854bd67303d",
      "target_id": "ru-id12270",
      "tag": "p",
      "target_sha256": "980545982c75c0fddc04ce780f5af5fc212d0180cac06fc966d331d8ccae6a75"
    }
  ],
