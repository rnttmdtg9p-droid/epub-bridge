{
  "unit": 4,
  "batch": 2,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id00493",
      "source_sha256": "78f65e72f707018ec47aa2408ae1ee7e91809978eef5360cf775a496b878090f",
      "target": "Кардинал улыбнулся.",
      "target_id": "ru-id00493",
      "tag": "p",
      "target_sha256": "b4447d13a1b75c5addf917f5dcb283bb8a6bcf71c9fa99676a3f89f1d21be752"
    },
    {
      "source_id": "id00494",
      "source_sha256": "27b82870ad14cb1e49c85dbb38da954d66500cae05606c01cef30157d4ed4af4",
      "target": "— Но, — продолжала королева, — вы, без сомнения, пришли по какому-то важному делу; что же случилось?",
      "target_id": "ru-id00494",
      "tag": "p",
      "target_sha256": "f12d8a816d235caf6be946ddf67a29fdfedc7ead056bbe011e2b5984f9c2079e"
    },
    {
      "source_id": "id00495",
      "source_sha256": "04f0c5a44ce46aeb05c95b3fa0e14c20164fe1259555a641218f9fb184396f03",
      "target": "Мазарини сел, или, вернее, откинулся в широком кресле и с меланхолическим видом сказал:",
      "target_id": "ru-id00495",
      "tag": "p",
      "target_sha256": "bdab81404b29c738426a2516a132b69098ac809f0a109dbb117c037a1153c7b4"
    },
    {
      "source_id": "id00496",
      "source_sha256": "ca256ae20bb0ba2174d1fb5640ff6b28ffeff35f5bab80c3a20c4d6f8ddda59f",
      "target": "— Случилось то, — сказал он, — что, по всей вероятности, нам вскоре придётся расстаться, если только ваша преданность мне не зайдёт так далеко, чтобы последовать за мной в Италию.",
      "target_id": "ru-id00496",
      "tag": "p",
      "target_sha256": "4ad57f1775b460980765d462825c813231f5e0688dd0ca3f0f69d2d69858f2c1"
    },
    {
      "source_id": "id00497",
      "source_sha256": "c66121827d016717571772b1443c30bb53f17f6a973c0c3029c3006c6ea6a701",
      "target": "— А почему так? — спросила королева.",
      "target_id": "ru-id00497",
      "tag": "p",
      "target_sha256": "35791f310d0d4c8efaff14f8be315158771c5e2dd72c0d2996e25fd0959b32aa"
    },
    {
      "source_id": "id00498",
      "source_sha256": "7f44b9fa2fcb6226c91be7cdf6893428c8bbee50bf7469be6daaef6bde2e6d26",
      "target": "— Потому что, как говорится в опере <i>«Тисбе»</i>, — продолжал Мазарини:",
      "target_id": "ru-id00498",
      "tag": "p",
      "target_sha256": "804222dd51f11082f60693ba2a13cedf38a0936f4c22291545325f7bfa938eea"
    },
    {
      "source_id": "id00499",
      "source_sha256": "c18a92116ac082325068e9f17d538d08fb47f48909ede0a51dc5f7260e3d2e21",
      "target": "<i>Весь мир сговорился разъединить наши пламена.</i>",
      "target_id": "ru-id00499",
      "tag": "p",
      "target_sha256": "6acc19b2598c6a01a5bc8c14de241f2140d5f46eb317a175140fc97a3a339e94"
    },
    {
      "source_id": "id00500",
      "source_sha256": "dd51744dce64faa9532e27c7fa541f3b0eea6a8383d94e0f82b518a77b0d0628",
      "target": "— Вы шутите, сударь! — сказала королева, пытаясь вернуть себе хоть немного прежнего достоинства.",
      "target_id": "ru-id00500",
      "tag": "p",
      "target_sha256": "0d9cfdce34d81dfa81d5bf221dc28d60a6c10f77639f186f501fe7aabd0d8f17"
    },
    {
      "source_id": "id00501",
      "source_sha256": "bdd0a6c1e87d9f79c18c819441413feea58d6bcccdf932365c4baaf089427850",
      "target": "— Увы, нет, сударыня! — сказал Мазарини. — Я нисколько не шучу; скорее я заплакал бы, прошу вас в этом не сомневаться; и есть отчего, ибо заметьте, что я сказал:",
      "target_id": "ru-id00501",
      "tag": "p",
      "target_sha256": "41951246aa64003803f852a29a8396fec59d7c8d465f02811b1518168d9be68c"
    },
    {
      "source_id": "id00502",
      "source_sha256": "c18a92116ac082325068e9f17d538d08fb47f48909ede0a51dc5f7260e3d2e21",
      "target": "<i>Весь мир сговорился разъединить наши пламена.</i>",
      "target_id": "ru-id00502",
      "tag": "p",
      "target_sha256": "6acc19b2598c6a01a5bc8c14de241f2140d5f46eb317a175140fc97a3a339e94"
    },
    {
      "source_id": "id00503",
      "source_sha256": "fe5f4371b3f2e38ba1ce88a3f7e3dc4305e213a4cb3dbd317b42735adb18d046",
      "target": "Но так как вы часть всего мира, я хочу сказать, что и вы меня покидаете.",
      "target_id": "ru-id00503",
      "tag": "p",
      "target_sha256": "9854725f1b4ccdf06863153d7a50f5a1c2f0da9b58679b14738b97ca1932a7c2"
    },
    {
      "source_id": "id00504",
      "source_sha256": "14e5ac181d04b917bafab6362df84d03bd77b39f24a99660d3a556f96363508d",
      "target": "— Кардинал!",
      "target_id": "ru-id00504",
      "tag": "p",
      "target_sha256": "3232b4f18f1dd9dbc00d358cc6b885d217ef8d09ddcfa3d22dac484cc4b7cb0d"
    },
    {
      "source_id": "id00505",
      "source_sha256": "8d3ac5429fcde2cdd515a5c5ec3d008bb7f0b4d1c140eb4f5b450fb630de7231",
      "target": "— Ах, Боже мой, разве я не видел, как на днях вы весьма приятно улыбались господину герцогу Орлеанскому, или, вернее, тому, что он вам говорил!",
      "target_id": "ru-id00505",
      "tag": "p",
      "target_sha256": "384c5adf019f1d5cae33d108cb10c0291ce6fe8f1b3547575d6ef983e8a5539d"
    },
    {
      "source_id": "id00506",
      "source_sha256": "0fcc7fb67420f189a04c88376308830f0b52b063a227a6c1a68506dc81b22d26",
      "target": "— А что он мне говорил?",
      "target_id": "ru-id00506",
      "tag": "p",
      "target_sha256": "ab073ecc0f1b3089e3d7c8fcdc30be2c2cb69e8410a0bebb338fa93509218fb1"
    },
    {
      "source_id": "id00507",
      "source_sha256": "53dc36b6d3dd6c6d522b5626908737eea267379e8363d42922acee8ab41dd8be",
      "target": "— Он говорил вам, сударыня: «Ваш Мазарини — камень преткновения; пусть он уедет, и всё пойдёт хорошо».",
      "target_id": "ru-id00507",
      "tag": "p",
      "target_sha256": "6dbe2b3220ae37171a2456654de69d8e74e08ddd29b5926b72670db1135783eb"
    },
    {
      "source_id": "id00508",
      "source_sha256": "7403a5ce90d7bb61c5dbc06a452d90f2b6cedb72fecc902d32126d69eae9b008",
      "target": "— Чего же вы хотели, чтобы я сделала?",
      "target_id": "ru-id00508",
      "tag": "p",
      "target_sha256": "850c9d610c1e74c0551305f2a2e1ca9f0acf97fc9d66b49f3494dd69eb3e2785"
    },
    {
      "source_id": "id00509",
      "source_sha256": "2964ae834fd1671ca3b76e8872e8277780a2223a6e46412e7e3ca779c0e4a2da",
      "target": "— О, сударыня, вы ведь королева, мне кажется!",
      "target_id": "ru-id00509",
      "tag": "p",
      "target_sha256": "a22401f77d2f5d4243b575fdd7d7257351c39705028bc162bc8ab53d34700d3e"
    },
    {
      "source_id": "id00510",
      "source_sha256": "9efff0ed50a2954911d6fdeab5a76c656bfa43e03592688bfbab22fb5fab46c7",
      "target": "— Хороша королевская власть, отданная на милость первого же марателя бумаг из Пале-Рояля или первого же мелкопоместного дворянчика королевства!",
      "target_id": "ru-id00510",
      "tag": "p",
      "target_sha256": "36b80783b53f5bb74ca44102d11caaa359a5b57abc11fdfc99c5356018f7ed2a"
    },
    {
      "source_id": "id00511",
      "source_sha256": "4257d2270f1172bc2693fb4b9e664d4c22c50c8c7f5ebd876e249cd6e9795402",
      "target": "— Однако вы достаточно сильны, чтобы удалить от себя людей, которые вам не нравятся.",
      "target_id": "ru-id00511",
      "tag": "p",
      "target_sha256": "a28bb0b7c67e25598e946c8dcbacee3a109e733bd4ac6f5f2585d8ca62a0cc58"
    },
    {
      "source_id": "id00512",
      "source_sha256": "4befcc9c11baf66b0eadd30eda18add5bd84f74449b0fb30f859fc0790bdb0e5",
      "target": "— То есть которые не нравятся вам! — ответила королева.",
      "target_id": "ru-id00512",
      "tag": "p",
      "target_sha256": "19e5868207b72adb93547256ce0a66def0b43c09619e50c1bddeb121b8d9f5a9"
    }
  ],
