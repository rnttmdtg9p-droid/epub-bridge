{
  "unit": 26,
  "batch": 2,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id03359",
      "source_sha256": "2b8e531b77d950a35f1dba1ed3918f4a1063032a336646c00556d301f4ac9ffa",
      "target": "— Я хотел сказать: королевы больше нет. Королева? Не беспокойтесь, мы её не увидим.",
      "target_id": "ru-id03359",
      "tag": "p",
      "target_sha256": "e68c922929648be8de4f1c52009718dfb1e4f598f6d91d14941e5d3733329f0c"
    },
    {
      "source_id": "id03360",
      "source_sha256": "d2f8cae0ea0d1e898ef117e24645c93bddd04dc6f5dfdccf8ac9b90a2b73c517",
      "target": "— И вы говорите, что мы отправляемся прямо сейчас в Пале-Рояль?",
      "target_id": "ru-id03360",
      "tag": "p",
      "target_sha256": "e08e602079130a6cd868edf65ac4f45137290a7fb3f61503551352b057af28a4"
    },
    {
      "source_id": "id03361",
      "source_sha256": "3a593341675fce5c6830932f0c6cc4aecdb7e7451a414eed27d045a13305d661",
      "target": "— Прямо сейчас. Только, чтобы не опоздать, я возьму у вас взаймы одну из ваших лошадей.",
      "target_id": "ru-id03361",
      "tag": "p",
      "target_sha256": "68b1f634331472eb736c34b719335f8fd421a38cba582e0fd55781e3119816d8"
    },
    {
      "source_id": "id03362",
      "source_sha256": "e64756d4406fd333b1f990027b449297a2d815ea5c6189ad0dc7501030629837",
      "target": "— Как вам угодно: все четыре к вашим услугам.",
      "target_id": "ru-id03362",
      "tag": "p",
      "target_sha256": "7bf17de5c9129bbea3f52427c50d4a9820805d577cfda31a51bd613c5ed9ecd9"
    },
    {
      "source_id": "id03363",
      "source_sha256": "1cb6f4d1078e0ee72fdb517e7413a07a00259259865928b80105e3d241299080",
      "target": "— О, мне пока нужна только одна.",
      "target_id": "ru-id03363",
      "tag": "p",
      "target_sha256": "eb8a375f99c556e5f386ab169d9256968c11dd0ca3f3b939a1118d040f1a2c60"
    },
    {
      "source_id": "id03364",
      "source_sha256": "ae24f8b420ba85fca83d8931603c54c3f1bba5cd82f89608bc2975e7fd7c185b",
      "target": "— А слуг мы не берём с собой?",
      "target_id": "ru-id03364",
      "tag": "p",
      "target_sha256": "7b8a98b85e8c5fe30eaedb8d992b1b77b3e28cf1e4c96df5c4a61664c6df01f3"
    },
    {
      "source_id": "id03365",
      "source_sha256": "edc0e5e38187bf533bd302728e21a3d56d9e8122921ce5a790c07b211fdaf5c7",
      "target": "— Да, возьмите Мушкетона, это не повредит. А что до Планше, у него есть причины не появляться при дворе.",
      "target_id": "ru-id03365",
      "tag": "p",
      "target_sha256": "1720659cb7213f1e88fe58620795794a6f715ea25cb1ca9a8f12e0ffddf4f5d1"
    },
    {
      "source_id": "id03366",
      "source_sha256": "120a856622f024cc93ff199c2b3ebc654f9e65761c27017bfd8d0e9f88b68c05",
      "target": "— А почему же?",
      "target_id": "ru-id03366",
      "tag": "p",
      "target_sha256": "f39a5cec8f86cd19b7ce4c40d1375471a9f69817aa5296123b974fd97701c5ae"
    },
    {
      "source_id": "id03367",
      "source_sha256": "7464eb1ef78589273c195bfeed6edfdcbb7f97ce4c7dc9415af8f1c8639e79e2",
      "target": "— Гм! Он не в ладах с Его Высокопреосвященством.",
      "target_id": "ru-id03367",
      "tag": "p",
      "target_sha256": "ce6975fa15b2d366ccb3a3314f572b27e0db783cc7a7153104a1075c0217d557"
    },
    {
      "source_id": "id03368",
      "source_sha256": "a87ee37d80aa52f2cbca837fa8fa9e8db931134ffeba920eeb462c5dce614d4e",
      "target": "— Муштон, — сказал Портос, — оседлайте Вулкана и Баярда.",
      "target_id": "ru-id03368",
      "tag": "p",
      "target_sha256": "5ef812411e25d492aeb1a48cd2409b28f4b7b4f74c7c5bda5bd86ac761f6769b"
    },
    {
      "source_id": "id03369",
      "source_sha256": "376307270abddf5ac18fe1eaa7878faf69506f1e7835d4565f78bcf10664cea7",
      "target": "— А мне, сударь, брать Грубияна?",
      "target_id": "ru-id03369",
      "tag": "p",
      "target_sha256": "624409118fe08a02af064bedcc2f7c555e29ddcd45aad20e5ca2e9a216520f16"
    },
    {
      "source_id": "id03370",
      "source_sha256": "3cb3c608604fea6c9de2fc6cf09bb44299bc7b32ca1e75951ec6cf045312c9ec",
      "target": "— Нет, возьмите парадную лошадь, возьмите Феба или Великолепного: мы едем по-парадному.",
      "target_id": "ru-id03370",
      "tag": "p",
      "target_sha256": "7967e6210e8316adf523cbea53c873301023214a7efa5c8f80f9b37c4d1b8bd4"
    },
    {
      "source_id": "id03371",
      "source_sha256": "5bcc9bcd7c369d9f7ee3ce8f0901069be555f8a8b1321c825cd0ad19f2550992",
      "target": "— А! — сказал Мушкетон, переведя дух. — Значит, дело только в том, чтобы нанести визит?",
      "target_id": "ru-id03371",
      "tag": "p",
      "target_sha256": "ab7e0d24995f52ef51fff7acfad2243b721080a21d6ec9e9fdf4d66f95d3ae04"
    },
    {
      "source_id": "id03372",
      "source_sha256": "45943df2d7e51d8faecb2ed38fae0b683a6b9069967d1e26c2f9d692bbcba97b",
      "target": "— Ну да, боже мой, конечно, Муштон, и ничего больше. Только на всякий случай положите пистолеты в седельные кобуры; на моём седле вы найдёте мои, они совсем заряжены.",
      "target_id": "ru-id03372",
      "tag": "p",
      "target_sha256": "5e3eb93da28686bb5dde43cb2bd1e2f0c1a2c24bfbece75a5005d1574c4dc501"
    },
    {
      "source_id": "id03373",
      "source_sha256": "7e8776b5bc759a87ae68b05ab633f444ab2571f6606e4f7afea4dc1afa37dd4a",
      "target": "Муштон вздохнул: он плохо понимал, что это за церемонные визиты, которые наносят, вооружившись до зубов.",
      "target_id": "ru-id03373",
      "tag": "p",
      "target_sha256": "5d5b0e01997e4464fe57d3f22a94c8b19e16687fc435b3ed407f54106ebc00b7"
    },
    {
      "source_id": "id03374",
      "source_sha256": "23fafc456473f9c104fc2828c921644ff761ff2323dbe4a2e7e18f0249fbac89",
      "target": "— В самом деле, — сказал Портос, с довольным видом глядя вслед удалявшемуся бывшему лакею, — вы правы, д’Артаньян: Муштона будет довольно, у Муштона весьма представительная наружность.",
      "target_id": "ru-id03374",
      "tag": "p",
      "target_sha256": "0562c8349de3d60e7ede415be4a031fb89009771f064529b5f4618740a697fb8"
    },
    {
      "source_id": "id03375",
      "source_sha256": "7a0939bd2ce4ae2dafd2d38d319cc436de18ed4d140f9114c3aa22ed09f9203f",
      "target": "Д’Артаньян улыбнулся.",
      "target_id": "ru-id03375",
      "tag": "p",
      "target_sha256": "87277d0260c7aaa3e9d278d537074d2a100f2d92537ee784bb2ac06134131dff"
    },
    {
      "source_id": "id03376",
      "source_sha256": "c88b6348206d755d39de229ab23dd5cd15ffac9159e0e730f1846dee7ad669d7",
      "target": "— А вы, — сказал Портос, — разве не переоденетесь во что-нибудь свежее?",
      "target_id": "ru-id03376",
      "tag": "p",
      "target_sha256": "dd3135279337439729c5839121d7fafcf879e909c65bd88a8a8b6902a0710a57"
    },
    {
      "source_id": "id03377",
      "source_sha256": "f5b277fafd03abdda007068dd89153af10f04e861469fcefc3f1255ea5299cf0",
      "target": "— Ничуть, я останусь как есть.",
      "target_id": "ru-id03377",
      "tag": "p",
      "target_sha256": "ea48edc4f7c34ecd0af753fa3bb59f0e38ca8552cb3db1790b37263a3070aa79"
    },
    {
      "source_id": "id03378",
      "source_sha256": "d776e06150bcb5873fcac4bcb2b4393869db1f08ccad23c1d868f3755d385128",
      "target": "— Но вы весь мокрый от пота и в пыли, а сапоги у вас сильно забрызганы грязью?",
      "target_id": "ru-id03378",
      "tag": "p",
      "target_sha256": "ad6444262e8f42e3b0ffc92de17951a258e5b1b957c8bc9563f8d928e64b4298"
    }
  ],
