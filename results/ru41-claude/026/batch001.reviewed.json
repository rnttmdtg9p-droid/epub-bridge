{
  "unit": 26,
  "batch": 1,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id03339",
      "source_sha256": "3d5af5b46f5cae54d8e5fddd19266fdb20171fb878f5720dbf9afdc45c6f6502",
      "target": "— Когда же это?",
      "target_id": "ru-id03339",
      "tag": "p",
      "target_sha256": "ea96c6f0f5a697607aa9830f50d622bf605af2fb235c249e09f46b6bc28120e0"
    },
    {
      "source_id": "id03340",
      "source_sha256": "0ea3ad6232c627c8b3e329f14a236b8639b8b133863a607c3838c6e01c788e9b",
      "target": "— Ей-богу, скоро, надеюсь.",
      "target_id": "ru-id03340",
      "tag": "p",
      "target_sha256": "e19c0722be092e8df80044212c6c9ebd2db67b5c4eefcce35e828c8b29a00569"
    },
    {
      "source_id": "id03341",
      "source_sha256": "3599460c3c4eafc2a3a856054b5bdecf161233d389929f54d8f630d300d55d6f",
      "target": "— А! Тем лучше!",
      "target_id": "ru-id03341",
      "tag": "p",
      "target_sha256": "0de7160f28481763b594c230ce1a1f45419b7a456c885481c3fec8f195896d88"
    },
    {
      "source_id": "id03342",
      "source_sha256": "9c21dc1f7efcd99bcf5569ac4d9da68d6204b40971fcb49e7b65a76d1b9a6242",
      "target": "Вслед за этим возгласом Портоса послышался тихий и глубокий стон, доносившийся из угла у двери. Д’Артаньян, только что спешившийся, увидел тогда, как рельефно вырисовывается на стене огромное брюхо Мушкетона, чей печальный рот выпускал глухие жалобы.",
      "target_id": "ru-id03342",
      "tag": "p",
      "target_sha256": "0c66944b8e8a7a5d8cac886ef7e50eb376cfc1c3fc380b71e3a8c42b791f6763"
    },
    {
      "source_id": "id03343",
      "source_sha256": "3eca0358252a88c5199040818115c699062fe66d43e8db7955aa723332531850",
      "target": "— И вы тоже, мой бедный господин Мустон, чувствуете себя не на месте в этой убогой гостинице, не так ли? — спросил д’Артаньян тем насмешливым тоном, в котором с равным правом могло быть и сострадание, и издёвка.",
      "target_id": "ru-id03343",
      "tag": "p",
      "target_sha256": "fae687cc90567d1232ec2baab605f399a616a53b78fc339ef88517ea0a48b6e8"
    },
    {
      "source_id": "id03344",
      "source_sha256": "c288ac468ae825cf5ec34566b52ed4b3dd1619bbbe35df5f4a0fd42785f27cbf",
      "target": "— Он находит здешнюю кухню отвратительной, — ответил Портос.",
      "target_id": "ru-id03344",
      "tag": "p",
      "target_sha256": "69a921744d399c1e53d8aaf965e6a99c75b8d2602502530da0c4f574780860e2"
    },
    {
      "source_id": "id03345",
      "source_sha256": "7dedcebd0005279792f1b1662a55d77400e1bd41b2fd5a58b297d2a2922a2838",
      "target": "— Что ж, — сказал д’Артаньян, — почему же он сам не стряпал, как в Шантильи?",
      "target_id": "ru-id03345",
      "tag": "p",
      "target_sha256": "e75d4ec77e8c02b16a06620e1881cb5cb10426e7b69ececcfc40e85dcbee53f3"
    },
    {
      "source_id": "id03346",
      "source_sha256": "e6554412058750981b0dd16912465faa103efb72b8abaa14302d76e05933f16f",
      "target": "— Ах, сударь, здесь у меня уже не было, как там, прудов господина принца, где можно ловить этих прекрасных карпов, и лесов его высочества, где можно ставить петли на этих нежных куропаток. Что до погреба, я осмотрел его подробно, и, по правде сказать, это очень малость.",
      "target_id": "ru-id03346",
      "tag": "p",
      "target_sha256": "5dee821faab083c37aa2aba582e696eaab00479cecaafd5538ff84a78882c3c0"
    },
    {
      "source_id": "id03347",
      "source_sha256": "8dff70d13504ccc2e68e9628674c03ccf06ad121587b020631ec14fca4416055",
      "target": "— Господин Мустон, — сказал д’Артаньян, — по правде, я бы вас пожалел, если бы мне сейчас не предстояло дело куда более спешное.",
      "target_id": "ru-id03347",
      "tag": "p",
      "target_sha256": "8fe4d926da89d74a7b8b6373c41cc22053f4fb27520a09c7a7b5c74f650bbea2"
    },
    {
      "source_id": "id03348",
      "source_sha256": "2d806c916d31bee1457cacf85697c47544f97f3a89e45cb1e367c25678cee418",
      "target": "Затем, отведя Портоса в сторону:",
      "target_id": "ru-id03348",
      "tag": "p",
      "target_sha256": "d05be635559caba2f262a1dad55c0ad7d59b927b055720dea2508989a1c841ba"
    },
    {
      "source_id": "id03349",
      "source_sha256": "78abee4003ac11496064fa341dc2f3ccb0f708cd8c75a50d88d1b121912770df",
      "target": "— Мой дорогой дю Валлон, — продолжал он, — вы уже совсем одеты, и это кстати, потому что я веду вас сейчас же к кардиналу.",
      "target_id": "ru-id03349",
      "tag": "p",
      "target_sha256": "405cdcf2155e2f11cdfad093566807e0c40aae32329d10248f62d1564b37d9fe"
    },
    {
      "source_id": "id03350",
      "source_sha256": "4255b567b74fb0a4975764c91d4d7023f668e2b4a3b230a7d68944210bd7f355",
      "target": "— Ба! В самом деле? — сказал Портос, широко раскрыв изумлённые глаза.",
      "target_id": "ru-id03350",
      "tag": "p",
      "target_sha256": "0047be1be9b49afb43f32187b7695471bd8d6691e352ff9a55837cf279214e21"
    },
    {
      "source_id": "id03351",
      "source_sha256": "98c8b893d3b73de30bcec1a262192d680bf9195fd1f4f8c5b3a1cfd25f742f9b",
      "target": "— Да, друг мой.",
      "target_id": "ru-id03351",
      "tag": "p",
      "target_sha256": "716869fe3e6b2a98a1084fd21ab7d77a27fec3969b86eb574692848772882f01"
    },
    {
      "source_id": "id03352",
      "source_sha256": "d90541c4c596efbbecf202fc79f6d57821b53379a302dda469e6a1ab9d7dc227",
      "target": "— Представление?",
      "target_id": "ru-id03352",
      "tag": "p",
      "target_sha256": "a0998218ea1141b2f43946148d9d96492a99a72776780ddef0416c187470c8a9"
    },
    {
      "source_id": "id03353",
      "source_sha256": "471783d7439e43236708db6fba95fe4be1c90700d349fcbaec7f7b0620426b22",
      "target": "— Это вас пугает?",
      "target_id": "ru-id03353",
      "tag": "p",
      "target_sha256": "cbc56fd7bbe9da778a3c008ee4d2ae193fec96f6d930d2bf135c9f0baaf99e94"
    },
    {
      "source_id": "id03354",
      "source_sha256": "c15d37a96cdcafdcb7d25c5c864bb1d8bcaed4d8c7f46a49e0d145235250587f",
      "target": "— Нет, но это меня волнует.",
      "target_id": "ru-id03354",
      "tag": "p",
      "target_sha256": "2dc8cf60cf113b8f820da0141f9dccf04988aff8a735709573fb386ebcc33bea"
    },
    {
      "source_id": "id03355",
      "source_sha256": "646349983226afc5ba7446ba904bdf97c6656e406f70f3b0caab8758cb1a8493",
      "target": "— О, будьте покойны; вам больше не придётся иметь дело с тем, другим кардиналом, а этот не раздавит вас своим величием.",
      "target_id": "ru-id03355",
      "tag": "p",
      "target_sha256": "90142a90435bcae12c742a5bff0d5f3cec6b2c09e420e1c74d72be16be142d48"
    },
    {
      "source_id": "id03356",
      "source_sha256": "482f56c8d77fec83bb3427f46f95a5da5896cda1e703922571952c876cab9a7e",
      "target": "— Всё равно, вы понимаете, д’Артаньян, двор!",
      "target_id": "ru-id03356",
      "tag": "p",
      "target_sha256": "58a5919ac1ce97e76ab6f00869a582d1c539b10dfe0679ad486525488eb6cf24"
    },
    {
      "source_id": "id03357",
      "source_sha256": "1466592fa93ddcb973c626b58b710529be15d8207c7f2215b4ffc57196bfa0bf",
      "target": "— Э, друг мой, двора больше нет.",
      "target_id": "ru-id03357",
      "tag": "p",
      "target_sha256": "cd1b28124092dc0b3fe255cce267d1cfdede2b53ce7e8803bc9c4337fac2e31d"
    },
    {
      "source_id": "id03358",
      "source_sha256": "8940d9446a2b99d4f6662714a774383fe09e4e32fcdd870fa9b3c53c8a94d213",
      "target": "— Королева!",
      "target_id": "ru-id03358",
      "tag": "p",
      "target_sha256": "77e24b28065af3b8cb569a84316bce28fb8f03cb7522da362cf19eec83dc64a4"
    }
  ],
