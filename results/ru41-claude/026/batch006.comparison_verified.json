{
  "unit": 26,
  "batch": 6,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id03439",
      "target": "Офицер был так бледен и так расстроен, что Мазарини, убедившись, что он принёс какое-то важное известие, сделал знак д’Артаньяну и Портосу уступить дорогу гонцу.",
      "source_sha256": "5c6a1f5cf3b09f333a3e9eab6460ac150a3a05baba70f799dee9613ddbc73347",
      "target_id": "ru-id03439",
      "tag": "p",
      "target_sha256": "b89c2c9225181a56a53302631591055a0c5cf0c78814544839d1d127962b86ee"
    },
    {
      "source_id": "id03440",
      "target": "Д’Артаньян и Портос отошли в угол кабинета.",
      "source_sha256": "074de728547ccfed20034b7f158db741d4d6992053d7d70b3c06c80acfb06aa7",
      "target_id": "ru-id03440",
      "tag": "p",
      "target_sha256": "a3797b3ce1eec356530a34694d02b79e347e9d39649c4d214670be1f4bd84f4b"
    },
    {
      "source_id": "id03441",
      "target": "— Говорите, сударь, говорите скорее, — сказал Мазарини. — Что же случилось?",
      "source_sha256": "42e7abcfc8a01b265251e046dad291c2cb4937fe2f9c8e9a653ed9de1589dc2f",
      "target_id": "ru-id03441",
      "tag": "p",
      "target_sha256": "d602d6706af6405203838d58340cc0a049181003084b58d9b4aa20d212f0e85a"
    },
    {
      "source_id": "id03442",
      "target": "— Случилось, монсеньор, — сказал гонец, — что господин де Бофор только что бежал из Венсенского замка.",
      "source_sha256": "ea54e48e5b356d9e5a0186ce7a74d1ab3981706c8456bbce1d1c0e29f5ff1c34",
      "target_id": "ru-id03442",
      "tag": "p",
      "target_sha256": "321555fb1b679d0cae8d357a001fe4585fb43a577b6a0ec4bd7260740e9f7e87"
    },
    {
      "source_id": "id03443",
      "target": "Мазарини вскрикнул и в свою очередь стал бледнее того, кто принёс ему это известие; он снова упал в кресло, почти уничтоженный.",
      "source_sha256": "71edbf761f97ad4f439f6daf863ff972d38af994900b14f8ca8509a076f3e61f",
      "target_id": "ru-id03443",
      "tag": "p",
      "target_sha256": "bf2bf66ffe9bff4cc78c75783ad0b494941cf90c7c0371fdb7ce854435658b40"
    },
    {
      "source_id": "id03444",
      "target": "— Бежал! — сказал он. — Господин де Бофор бежал?",
      "source_sha256": "315d571b02cf9fb69ec3db3ede58526df95b2e7e260d5c8a6bbe4e6a8b9acc3d",
      "target_id": "ru-id03444",
      "tag": "p",
      "target_sha256": "444caf3b78aea20885bfa50625a46b276dad98e2207698db401098f8cac52672"
    },
    {
      "source_id": "id03445",
      "target": "— Монсеньор, я видел с высоты террасы, как он бежал.",
      "source_sha256": "e82b15669a2056dcf17ba2659b9486da3ded89ebe3e72167a1265489e3170d8c",
      "target_id": "ru-id03445",
      "tag": "p",
      "target_sha256": "0e2a5b9086402481cf1f15c56853943bcb21eae926879203280e46021e846e56"
    },
    {
      "source_id": "id03446",
      "target": "— И вы не стреляли в него?",
      "source_sha256": "c1e183a02880ac9d0dd4deaf82965630c4e1be87d51f971a1c9aa7f1058d1309",
      "target_id": "ru-id03446",
      "tag": "p",
      "target_sha256": "3997f37bc3e38943b1b755f33ab55c73f1abdc73dd03021ada09af7f706f1c31"
    },
    {
      "source_id": "id03447",
      "target": "— Он был вне досягаемости выстрела.",
      "source_sha256": "ea18c61b26d44c55c1f9671f0edc1a2d27d1458bdad285a1dc03bd1d267a7adb",
      "target_id": "ru-id03447",
      "tag": "p",
      "target_sha256": "dc96135309157fbd15defaaa4867c2c2ca6361002a835869a08a0679f354c148"
    },
    {
      "source_id": "id03448",
      "target": "— Но господин де Шавиньи, что же он делал?",
      "source_sha256": "ab0ba2c7da89857242849725caf5917f8f2558355dc5c9d7a71c07cd77d866c4",
      "target_id": "ru-id03448",
      "tag": "p",
      "target_sha256": "5939857681e05caa03d383f557f2a9fa6fa60bf41c65034b2c2b419d08974aa9"
    },
    {
      "source_id": "id03449",
      "target": "— Его не было на месте.",
      "source_sha256": "2b5bcf4487c9d5200f09335defa9d1f5218c68bc06c4e649a8ca6149904159f7",
      "target_id": "ru-id03449",
      "tag": "p",
      "target_sha256": "c0939cb733a93faec798eb039f8269ad8054f36e32c175e02ff92310756d1c6f"
    },
    {
      "source_id": "id03450",
      "target": "— А Ла Рамэ?",
      "source_sha256": "1f29e3ed7336dd89b852a74a6b2e77316f3927b016a8865636abc043cc77ef2f",
      "target_id": "ru-id03450",
      "tag": "p",
      "target_sha256": "177e06768160944b4bac9d039fcf15a39dcc94fc324188c6bf296fa9690cd167"
    },
    {
      "source_id": "id03451",
      "target": "— Его нашли связанным в комнате узника, с кляпом во рту и с кинжалом рядом.",
      "source_sha256": "4a73283e36f3dc7c44745aaeaa32ca8fe856e4e6682eec09dcd03a389c6a21cb",
      "target_id": "ru-id03451",
      "tag": "p",
      "target_sha256": "74d582897d67c4a3766f5e54ae1a6cf3a7e92cbd986b0d23e998674927f72896"
    },
    {
      "source_id": "id03452",
      "target": "— Но этот человек, которого он взял себе в помощники?",
      "source_sha256": "854482c6331f97e8b10561b2821d49ed324393292629665384642d6cbd7a1a8f",
      "target_id": "ru-id03452",
      "tag": "p",
      "target_sha256": "f5097f2d1d213fcf5c9929dea4a5feac46dd09f74fd42edda8ac3ab8a8b5f225"
    },
    {
      "source_id": "id03453",
      "target": "— Он был сообщником герцога и бежал вместе с ним.",
      "source_sha256": "d465b4a933208e31ff92e30e6730260532f490dd9c1a75360c5ef7132eeda535",
      "target_id": "ru-id03453",
      "tag": "p",
      "target_sha256": "bbcf0f4873927a3ec16ea078a53310f116746a7f100ff2cee0a1de7174082a8b"
    },
    {
      "source_id": "id03454",
      "target": "Мазарини издал стон.",
      "source_sha256": "d4754dc73e14e51f6bb3669d759358cfcfad35f2d75865e48dd38a922525e61c",
      "target_id": "ru-id03454",
      "tag": "p",
      "target_sha256": "8ff23868c65fd66ab132333f4144ee720544448f026d08a181ca193ac4eef570"
    },
    {
      "source_id": "id03455",
      "target": "— Монсеньор, — сказал д’Артаньян, сделав шаг к кардиналу.",
      "source_sha256": "a0a91910db78d3ed2cae28030d3a69d0f2b1db5063c4f31336864c04f9a3ee9a",
      "target_id": "ru-id03455",
      "tag": "p",
      "target_sha256": "12904d0ee189980544ee8e613517193e4c01e33e7510ecc0cae2b8be07368914"
    },
    {
      "source_id": "id03456",
      "target": "— Что? — сказал Мазарини.",
      "source_sha256": "b0d73739dc3d98311bc075e34f24cc90a3d10c74f93573a8ace01274181002cc",
      "target_id": "ru-id03456",
      "tag": "p",
      "target_sha256": "abd253db7fd669048612b93882eb2be304d88f1ec53e3b08de64d95f6b65bf7e"
    },
    {
      "source_id": "id03457",
      "target": "— Мне кажется, что Ваше Высокопреосвященство теряет драгоценное время.",
      "source_sha256": "ae35e1193755e9d943869ddfc900da3a48e3dbe0b0efd42fc0a4e5b821b05d36",
      "target_id": "ru-id03457",
      "tag": "p",
      "target_sha256": "37faff9b3d1275b87602faf056af23c38e85fd4d47a9e28a0297a28dd976cf75"
    },
    {
      "source_id": "id03458",
      "target": "— Как так?",
      "source_sha256": "24abe4982bc1efaf04df8781dfe2ce72e9299c18c2fb0ec5d15297b000883304",
      "target_id": "ru-id03458",
      "tag": "p",
      "target_sha256": "b4592186655d9f97c936bc9d5e1c7013346d208284974aa91c654d8e6e435aad"
    }
  ],
