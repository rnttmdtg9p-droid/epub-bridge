{
  "unit": 34,
  "batch": 7,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id04425",
      "target": "— Бывший бетюнский палач? — пробормотал Гримо, припоминая… — Человек лет пятидесяти пяти — шестидесяти, высокий, крепкий, смуглый, с чёрными волосами и чёрной бородой?",
      "source_sha256": "a0b55b3cd56ded6dd939aa676c7e2500410893eff2b40c937a95edb874cf0177",
      "target_id": "ru-id04425",
      "tag": "p",
      "target_sha256": "386920619246ad03143159ba744a9d2d2d8618693d973668ff63ba0cc86ad96f"
    },
    {
      "source_id": "id04426",
      "target": "— Он самый, только борода у него поседела, да и волосы побелели. Вы его знаете? — спросил хозяин.",
      "source_sha256": "36266b66d064b767bed0ee8842ad74b8b1b6c7e04b99433a9e713d6a628e7ca1",
      "target_id": "ru-id04426",
      "tag": "p",
      "target_sha256": "428fe51ce7cc1cacab2a3cbfbc9a9c80ae583169c1e9711969de55e9b48e765d"
    },
    {
      "source_id": "id04427",
      "target": "— Я видел его однажды, — сказал Гримо; лоб его омрачился от картины, которую рисовало ему это воспоминание.",
      "source_sha256": "d7b3b57de73353b739e233098d4515f0c324b75f4c260f3f885d438487f8571a",
      "target_id": "ru-id04427",
      "tag": "p",
      "target_sha256": "7549fa51818b763d3a34cc8ec463198d036114199da996f70c4db6ea290953c2"
    },
    {
      "source_id": "id04428",
      "target": "Хозяйка прибежала вся дрожа.",
      "source_sha256": "768213c1757da8d0a6b1ec669194c356db5566935b7275b59a32600540e4b8c9",
      "target_id": "ru-id04428",
      "tag": "p",
      "target_sha256": "6080463d29ba87e688467afe8791797bd873bbbb2c7514b07e954bfd52945e91"
    },
    {
      "source_id": "id04429",
      "target": "— Ты слышал? — сказала она мужу.",
      "source_sha256": "5a396c71d54e51b671d0a128ea102ab6624d26d2d7d5060fcbb9f3812986090a",
      "target_id": "ru-id04429",
      "tag": "p",
      "target_sha256": "a415def5cafc6c4f32cdf90f6e9aeeb2e8d5a0720d06d093f5e4c9b08ccecf34"
    },
    {
      "source_id": "id04430",
      "target": "— Да, — ответил хозяин, с тревогой глядя в сторону двери.",
      "source_sha256": "48e2f0d6e834c64f0a20578b4803a396cb7f10cafa5b5242ad99362b00fa6510",
      "target_id": "ru-id04430",
      "tag": "p",
      "target_sha256": "2caf913a5bfd0fdc1e102c5b0304a9bd2ba6b396c1911e6a0165ca5eb08cd61a"
    },
    {
      "source_id": "id04431",
      "target": "В эту минуту послышался крик, не такой громкий, как первый, но за ним последовал долгий, протяжный стон.",
      "source_sha256": "e6dc90e1cb849bdf0f2792600ced905212f80412873447689cb47e7d7f1c9d15",
      "target_id": "ru-id04431",
      "tag": "p",
      "target_sha256": "a3606aee8b54a026acd9f774befb04176d6e6132fc2b8ba61aa17ece2a6fa6c2"
    },
    {
      "source_id": "id04432",
      "target": "Все трое, содрогнувшись, переглянулись.",
      "source_sha256": "6521711d704ff8c09961f44e82b8cee7088765df7fea5713f736158bff5712f7",
      "target_id": "ru-id04432",
      "tag": "p",
      "target_sha256": "36195834eaa1d1dbd99aecafa0cfc9733719c31331002e1493dcb7ac34d1fb7b"
    },
    {
      "source_id": "id04433",
      "target": "— Надо посмотреть, что там, — сказал Гримо.",
      "source_sha256": "088b29703380758495c31ae8197db4a8ecd7321fd6969bb7595f7fc6cea80071",
      "target_id": "ru-id04433",
      "tag": "p",
      "target_sha256": "acc17e7659aa96c5748fdf1f5bc31ccd9f3b47221cac104886ec4eb653bf9ffc"
    },
    {
      "source_id": "id04434",
      "target": "— Похоже на крик человека, которого режут, — пробормотал хозяин.",
      "source_sha256": "08056cae6296343cad6ce64db9eb521b253bab30e2a7115801041b0e0ab2a811",
      "target_id": "ru-id04434",
      "tag": "p",
      "target_sha256": "1236d44f21f696f67c65d925af21c28e816d8339e3251eca709efa833dfab31a"
    },
    {
      "source_id": "id04435",
      "target": "— Господи Иисусе! — сказала хозяйка, крестясь.",
      "source_sha256": "c40ee7d4055f7af6fce92aa440a1c2cf0cde7b97366be4ccfe40e3728c582822",
      "target_id": "ru-id04435",
      "tag": "p",
      "target_sha256": "9994e8e6f3da716ee8ac38cb1b7244a6aeefd0ca3399d97fef6eac38a0514ffe"
    },
    {
      "source_id": "id04436",
      "target": "Если Гримо и говорил мало, то, как известно, действовал он много. Он бросился к двери и сильно дёрнул её, но она была заперта изнутри на засов.",
      "source_sha256": "4395d665e39120ba619289e6091ba251a033332450e449c505bfcceeef807e6a",
      "target_id": "ru-id04436",
      "tag": "p",
      "target_sha256": "108215cabad023087b2a59f8a4824f18b0f5a1e1a88a2e38820084979fe48b3c"
    },
    {
      "source_id": "id04437",
      "target": "— Откройте! — закричал хозяин. — Откройте, сударь монах, откройте сию же минуту!",
      "source_sha256": "2524ecb371f21c7b95a1570bc8e1645aeecb6802a8d9d09b05251c5a79be7102",
      "target_id": "ru-id04437",
      "tag": "p",
      "target_sha256": "d65ed86ea17478b1784869785d76b56c652d76dff3622e0a0c1b4dc45ecb64be"
    },
    {
      "source_id": "id04438",
      "target": "Никто не ответил.",
      "source_sha256": "ea2ff4c8e022cc62ce450a651bfd262eafd6eb04c73cd311446bdf5d3e2732a9",
      "target_id": "ru-id04438",
      "tag": "p",
      "target_sha256": "e9561bb64b3e2123aaf5632eabd67f20c5125650a8f90e98a6fbb619ca2d14e4"
    },
    {
      "source_id": "id04439",
      "target": "— Откройте, или я вышибу дверь! — сказал Гримо.",
      "source_sha256": "ae8c773dc7cb8500bebb248e52f1234e56b9033ca451eb7408f88e9d61a22f4f",
      "target_id": "ru-id04439",
      "tag": "p",
      "target_sha256": "ca2006eec0eb6391889a8427fbd142bfcc1c2e294f1468af1a91b03e7a6d865b"
    },
    {
      "source_id": "id04440",
      "target": "Та же тишина.",
      "source_sha256": "c69abc8dbc4046de5167207327c971d0aab7df9e5a02fe1d54e1334e63e518bf",
      "target_id": "ru-id04440",
      "tag": "p",
      "target_sha256": "26a53bf58a092fb9394b8070217832fbd7b87ea5450278a736e5a6afeacdf27e"
    },
    {
      "source_id": "id04441",
      "target": "Гримо огляделся и заметил в углу лом, оказавшийся там случайно; он кинулся к нему и, прежде чем хозяин успел помешать его замыслу, уже выбил дверь внутрь.",
      "source_sha256": "9e8ab8a1a175c44643bc0ac005fc979559ea45a39455854bd92570887f6c5faf",
      "target_id": "ru-id04441",
      "tag": "p",
      "target_sha256": "51614f6bb87ab41d7cffda5d1d173b27925fcdc2b2cfdc1545d13b1036f5a74d"
    },
    {
      "source_id": "id04442",
      "target": "Комната была залита кровью, которая сочилась сквозь матрасы; раненый больше не говорил, а хрипел; монах исчез.",
      "source_sha256": "5f3754579c8cd88b6a28a2297edad6ab067721a743a9f32d0d434c13dabfc1c1",
      "target_id": "ru-id04442",
      "tag": "p",
      "target_sha256": "e561580675e7a34f2222b86678c5dd907e7a9f032a2d0c7f2472aea9732f7fa2"
    },
    {
      "source_id": "id04443",
      "target": "— Монах? — закричал хозяин. — Где монах?",
      "source_sha256": "45ac3ff30b9d47641fc02abaf459e163bc1496b2c66365cbc4dc7467eee737a4",
      "target_id": "ru-id04443",
      "tag": "p",
      "target_sha256": "4eda978173966dd4bbd511f3be81eeb20c80dfbb97138448e62887fe348560d7"
    },
    {
      "source_id": "id04444",
      "target": "Гримо бросился к открытому окну, выходившему во двор.",
      "source_sha256": "797d1f4d99819236bac3604521b6e96f599e57118c3898a07ecbc5c966eda547",
      "target_id": "ru-id04444",
      "tag": "p",
      "target_sha256": "63e5685128feade0a717bc8de586307dd1dd597636a2d3f8eadf442cd388aec3"
    }
  ],
