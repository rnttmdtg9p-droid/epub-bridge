{
  "unit": 34,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id04385",
      "source_sha256": "812fda9608c739b854c2edc419bc7fec6e5e22b01b64865e731468224d80ad92",
      "target": "— Ну что? Что такое? — спросил тот. — Уж не дурно ли тебе стало?",
      "target_id": "ru-id04385",
      "tag": "p",
      "target_sha256": "7649a09c5198480b7ff9671415b1bdaa7ac49bf9d0bac4c7bf81df6496cb47a3"
    },
    {
      "source_id": "id04386",
      "source_sha256": "24dd91a0cf217dc0c8a947baade7d33512436a6a78d50b39e3fe11b7d34d91da",
      "target": "— Нет, но взгляни! — сказала хозяйка, указывая мужу на раненого.",
      "target_id": "ru-id04386",
      "tag": "p",
      "target_sha256": "e6490e4b83332885956b8b28350b780f2d981171eeeebc24ca1b34074fb1fa68"
    },
    {
      "source_id": "id04387",
      "source_sha256": "11debb5a03975d9bc1f20989e780d797c98c5e19a6f2a42bd9310e6696959d99",
      "target": "— Ещё бы! — отвечал тот. — Он, по-моему, очень плох.",
      "target_id": "ru-id04387",
      "tag": "p",
      "target_sha256": "9105d66b61b56f94e172cd9abfc8d1d435c03f6c1ef3d1660cd2ed420ebc44eb"
    },
    {
      "source_id": "id04388",
      "source_sha256": "f3391d3477dc6dd27630e8c64d20376fd3c86823ab9249629e95ea416da25470",
      "target": "— Я не о том, — продолжала женщина, вся дрожа, — я спрашиваю, узнаёшь ли ты его?",
      "target_id": "ru-id04388",
      "tag": "p",
      "target_sha256": "fb40f9106ac3114cd4826a03610d126c89b68c5b37e0df4158a255479334159b"
    },
    {
      "source_id": "id04389",
      "source_sha256": "a8eb73112cd1942986dcbeeff7112d869ae47454ee4ababc318e13f9743d9cc7",
      "target": "— Этот человек? Постой-ка…",
      "target_id": "ru-id04389",
      "tag": "p",
      "target_sha256": "b97dfc055123c903373cf3e72513afb722547ef62265982c1fbd93f3b0010a6d"
    },
    {
      "source_id": "id04390",
      "source_sha256": "97cb8f987df0164b9e1dbd4d930947de1edb17bc21673e17baf6e7ef4b79105c",
      "target": "— Ах! Вижу, что узнаёшь, — сказала женщина, — ведь ты и сам побледнел.",
      "target_id": "ru-id04390",
      "tag": "p",
      "target_sha256": "fdfe63d2d69e504bd282f9fd4a04e03f3d91ca144d510ec1e57a015f1fa37bb1"
    },
    {
      "source_id": "id04391",
      "source_sha256": "fabd0212a01854211c59e42db139a6859be9dbcea7dce6eb9cf7241b76eeaddd",
      "target": "— Да неужели! — воскликнул хозяин. — Горе нашему дому, это же бывший палач из Бетюна.",
      "target_id": "ru-id04391",
      "tag": "p",
      "target_sha256": "416a702092eb606fefa7bfc959a7106ab24a44b99d771169377265220404dedf"
    },
    {
      "source_id": "id04392",
      "source_sha256": "18a2b3d7f4b0f476351279205198319aa0267d2f5c35687078c75084b69c3eec",
      "target": "— Бывший палач из Бетюна! — пробормотал молодой монах, сделав движение, словно хотел остановиться, и позволив отразиться на лице отвращению, которое внушал ему его кающийся.",
      "target_id": "ru-id04392",
      "tag": "p",
      "target_sha256": "c7e7ed228b4555dc77fb01e36e58c87c943becd29068c6dbb2be24a8be0a7099"
    },
    {
      "source_id": "id04393",
      "source_sha256": "11a08418b6f511a6c66c652919d7317b27eea9df03456f779ce452f8fc445274",
      "target": "Г-н д’Арминж, стоявший у двери, заметил его колебание.",
      "target_id": "ru-id04393",
      "tag": "p",
      "target_sha256": "a7a467b4debd23b3020c9e773a904498fe646e486237cf1b3d30de6afd148e2b"
    },
    {
      "source_id": "id04394",
      "source_sha256": "f8b299c684ab41c05c2bdae8c4a5b24fdeaeb50cea9a3d9f2ab1697ee8eb3605",
      "target": "— Господин монах, — сказал он, — быть палачом или когда-то им быть — не мешает этому несчастному оставаться человеком. Окажите же ему последнюю услугу, которой он от вас требует, и ваше дело будет лишь более достойным награды.",
      "target_id": "ru-id04394",
      "tag": "p",
      "target_sha256": "490eb6baeb6508b500a22f8f33d540ae5173aa44fca39f24a051ec34e4aaa499"
    },
    {
      "source_id": "id04395",
      "source_sha256": "301b36b8eca0d9e78baf1ff702aacafa5f5a0e95fbfba0c38649e7e942f67d48",
      "target": "Монах ничего не ответил, но молча продолжал путь к нижней комнате, где двое слуг уже уложили умирающего на постель.",
      "target_id": "ru-id04395",
      "tag": "p",
      "target_sha256": "0144f6e53b660105912424c2aa4c0ef37bd8dfb026e29886eef5cf941ab13a3d"
    },
    {
      "source_id": "id04396",
      "source_sha256": "6f1b11fa830994f231290dd7b34f39c691e48e261eee0c8efbc51d05efa09f50",
      "target": "Увидев, что божий человек подходит к изголовью раненого, оба лакея вышли, затворив дверь за монахом и умирающим.",
      "target_id": "ru-id04396",
      "tag": "p",
      "target_sha256": "ebdd32ddebd56c7908bc2ac163397c16d435128f7500605ba74ee99cee457a9f"
    },
    {
      "source_id": "id04397",
      "source_sha256": "948d2e7d1c9eef972440eaba3cc0b2c36d4d769101c5731a912a63bfda99b1fe",
      "target": "Д’Арминж и Оливен ждали их; они снова сели на коней, и все четверо тронулись рысью по дороге, в конце которой уже скрылись Рауль и его спутник.",
      "target_id": "ru-id04397",
      "tag": "p",
      "target_sha256": "7efe847a76a324d8fca0ac7cd1dca354e96d8e933608fb99e79955584d67bd28"
    },
    {
      "source_id": "id04398",
      "source_sha256": "859f679213f9e73b4f1c02603714cff54fdaaeab24f954c1eb9a9b9b9c901c24",
      "target": "В ту минуту, когда воспитатель с эскортом в свою очередь скрылся из виду, у порога постоялого двора остановился новый путник.",
      "target_id": "ru-id04398",
      "tag": "p",
      "target_sha256": "911e506aa36e149319e19a51401a30e00c516d53f86cb784fd8661c3604373c9"
    },
    {
      "source_id": "id04399",
      "source_sha256": "a4be62d2e26108f8cb6dea609d4e2a8449b9ee4ad6f657c38bf9944bf421a96a",
      "target": "— Что угодно господину? — спросил хозяин, ещё бледный и дрожащий от только что сделанного открытия.",
      "target_id": "ru-id04399",
      "tag": "p",
      "target_sha256": "4f3d7246c47d8bf84c12a62d5a3f1f0441cdb93849b93fac28eb4a32d05164ed"
    },
    {
      "source_id": "id04400",
      "source_sha256": "69e85b77f4de754fc761dd8a45c5360019c67449d1a10e100c74134d96c99215",
      "target": "Путник сделал знак, каким изображают пьющего, и, сойдя на землю, показал на свою лошадь и сделал знак, каким изображают растирающего.",
      "target_id": "ru-id04400",
      "tag": "p",
      "target_sha256": "eb8f96aeac9b3158fbb3e47482acbfbe94e099e12d8b3bbc208f973ea6ebc5bf"
    },
    {
      "source_id": "id04401",
      "source_sha256": "106f0d8ce4f350da88042a23073025f806f7f1c3da15ccc66cc85f3919776f3f",
      "target": "— Ах, чёрт! — сказал про себя хозяин. — Кажется, этот немой.",
      "target_id": "ru-id04401",
      "tag": "p",
      "target_sha256": "9f03d12ac8c96a5c1a50b54340f42f868ed06cb8d79c43648a9d5d1e14e33c05"
    },
    {
      "source_id": "id04402",
      "source_sha256": "04f053bb81f0765bc956c6fffff98758cc169e4ac746801375b35c45af196d71",
      "target": "— А где вы желаете выпить? — спросил он.",
      "target_id": "ru-id04402",
      "tag": "p",
      "target_sha256": "7c88d477a657d07f0e9434912d912544f73a85f3fe9f4b0c5f566a1f8381b719"
    },
    {
      "source_id": "id04403",
      "source_sha256": "23c678a9854b7b010ce93d61e75366d8a4a244f637d7007d4252f62d6ad5c807",
      "target": "— Здесь, — сказал путник, указав на стол.",
      "target_id": "ru-id04403",
      "tag": "p",
      "target_sha256": "eab6cfb0d1595155695bdb0a95a104d759b6662786445dbcf9c07cfdd3f707b0"
    },
    {
      "source_id": "id04404",
      "source_sha256": "f44811781c386f747187547cc8196e40e2d2db13c7b9ac692cfad81babd5452d",
      "target": "— Я ошибся, — сказал хозяин, — он не совсем немой.",
      "target_id": "ru-id04404",
      "tag": "p",
      "target_sha256": "bf70f28cb252131befe049eb5ef641b22c2533c441aa05fce726fd9ccf2aa62c"
    }
  ],
