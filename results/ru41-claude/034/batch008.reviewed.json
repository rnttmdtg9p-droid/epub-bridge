{
  "unit": 34,
  "batch": 8,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id04445",
      "source_sha256": "cb9d6d6eefe49c161f4c39fd34bc5bf395fc3a144c1854565360e04b843cb7db",
      "target": "— Должно быть, он сбежал этим путём, — воскликнул он.",
      "target_id": "ru-id04445",
      "tag": "p",
      "target_sha256": "3b4cabd5e85f037dbb73a7c9601143e7d79bd17b8b35f9a883bcae4e4df01139"
    },
    {
      "source_id": "id04446",
      "source_sha256": "a8529392a829b97dbbd3a844fe35cf1858b05c3a7591a65ceeddb01d8cff39af",
      "target": "— Вы думаете? — сказал перепуганный хозяин. — Эй, малый, посмотри, на месте ли в конюшне мул монаха.",
      "target_id": "ru-id04446",
      "tag": "p",
      "target_sha256": "0f51ff4bdea893be5de249def1d5d7d0b89a7c2b74f421f9b6580b8340bac991"
    },
    {
      "source_id": "id04447",
      "source_sha256": "7809c5259ec97b8cabd2cf2a7b3972cf48cdcf167dae2173b061bdbc67227eee",
      "target": "— Мула нет! — крикнул тот, к кому был обращён этот вопрос.",
      "target_id": "ru-id04447",
      "tag": "p",
      "target_sha256": "e4bfaa7ac4e71f63a1dcdca252296522fa21a90d20b52324821837a25cc759c8"
    },
    {
      "source_id": "id04448",
      "source_sha256": "d09d73948b21ce33eb0ca091462f56648293766a3c47e4783310c1847bd4551e",
      "target": "Гримо нахмурил брови, хозяин сложил руки и недоверчиво огляделся вокруг. Что до его жены, она не посмела войти в комнату и стояла у двери, объятая ужасом.",
      "target_id": "ru-id04448",
      "tag": "p",
      "target_sha256": "05f164c1683d2ac86eb21250b3cf036bc734869aabca3ed4429d51ee49aaa4c5"
    },
    {
      "source_id": "id04449",
      "source_sha256": "6d2043e14cf11c745992b4d4b39836ac4f4ba484d768b15c4b1f38cea1ef9b98",
      "target": "Гримо подошёл к раненому, вглядываясь в его грубые, резко очерченные черты, которые пробуждали в нём столь страшное воспоминание.",
      "target_id": "ru-id04449",
      "tag": "p",
      "target_sha256": "7529b7d702ce211cc789df1b9a1ea4f487fdb82dac5ce1b092673c0df507bff8"
    },
    {
      "source_id": "id04450",
      "source_sha256": "91919656e5e755707c98d06342b085260ef803b3e5e495b8656d273557c4164c",
      "target": "Наконец, после минуты мрачного и безмолвного созерцания:",
      "target_id": "ru-id04450",
      "tag": "p",
      "target_sha256": "3b76737feaea4d00e6a3be4c6dc6e71c64eccb0b593adc93b084f557a6bd6a53"
    },
    {
      "source_id": "id04451",
      "source_sha256": "97dbb7379666fcc15cfff9fc37a9ae9f98d8c69aa0a30100e9c64c984605fa76",
      "target": "— Сомнений больше нет, — произнёс он, — это он самый.",
      "target_id": "ru-id04451",
      "tag": "p",
      "target_sha256": "2d169fcc09312842f2e2840cb6a25cf2b97019df5d8656d448d3fa64e25b3c6c"
    },
    {
      "source_id": "id04452",
      "source_sha256": "d9ebb229d5385a4472cc0c7580f3e3e0c9035594e28f88a134bd37498c12e776",
      "target": "— Он ещё жив? — спросил хозяин.",
      "target_id": "ru-id04452",
      "tag": "p",
      "target_sha256": "6d541324eb7bcc3272306b6de2820017a10987dfa2f7ba18e8c96f420773babe"
    },
    {
      "source_id": "id04453",
      "source_sha256": "0a320974ca766b89941dbd54a638821dbccb7083910b5781478912234ecf0d24",
      "target": "Гримо, не отвечая, распахнул его камзол, чтобы приложить руку к сердцу, а хозяин в свою очередь подошёл ближе; но вдруг оба отпрянули: хозяин вскрикнул от ужаса, Гримо побледнел.",
      "target_id": "ru-id04453",
      "tag": "p",
      "target_sha256": "900e0d14bdd50dc08b49582965aaff2b2fb447cc00f974372c9856220a2fd1b0"
    },
    {
      "source_id": "id04454",
      "source_sha256": "8a93e8f6799e4036a4cb3949aad6f6797917cd439d6c64df82e816ac892d8819",
      "target": "Клинок кинжала был вонзён по самую рукоять в левую сторону груди палача.",
      "target_id": "ru-id04454",
      "tag": "p",
      "target_sha256": "55e9f911774b8c625ffdab87d2f2d0bf067f97e400fde2df96f43a451e2fade7"
    },
    {
      "source_id": "id04455",
      "source_sha256": "36c83dae756e1c9120df9bd9cd664b06bb872880ea045f300e240225947a77db",
      "target": "— Бегите за помощью, — сказал Гримо, — а я останусь подле него.",
      "target_id": "ru-id04455",
      "tag": "p",
      "target_sha256": "d2c38ba352e01dd53117dde2d7dfd457f26802ae3ed7e452cf8fc1cb6d62fbe0"
    },
    {
      "source_id": "id04456",
      "source_sha256": "038f597d0801246cd14f0d05ba2e1db068683ec853c63f6d10b5ceb63eaa2dd6",
      "target": "Хозяин вышел из комнаты сам не свой; а его жена убежала при крике, который испустил её муж.",
      "target_id": "ru-id04456",
      "tag": "p",
      "target_sha256": "74524b6f223c092358abb9badbefcb44a11e5daa3131831fd41b72914b9c0280"
    }
  ],
