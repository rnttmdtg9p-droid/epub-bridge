{
  "unit": 34,
  "batch": 6,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id04405",
      "target": "И он поклонился, пошёл за бутылкой вина и печеньем и поставил всё это перед своим молчаливым гостем.",
      "source_sha256": "f7a11244f44ef08346da724bb706112046fd228b75f5cad55766fff9f5856c23",
      "target_id": "ru-id04405",
      "tag": "p",
      "target_sha256": "4368881151d1a19b7dde61fa64d4afb5d3338343626c47868d717d04c9781dfa"
    },
    {
      "source_id": "id04406",
      "target": "— Господин больше ничего не желает? — спросил он.",
      "source_sha256": "db18725ff034c8b0210fdd98f77dc0b735fd467d8e984108b05f5721cce33dd2",
      "target_id": "ru-id04406",
      "tag": "p",
      "target_sha256": "40cb0d49362ad8eda90d036db5e14ed58bcfa6251ba7f9a6f621c2a5c6c87837"
    },
    {
      "source_id": "id04407",
      "target": "— Как же, желаю, — сказал путник.",
      "source_sha256": "2305f4544ae5d272e361dbf91b81659ad1cc7d8410fbf52b1faadbad932868a7",
      "target_id": "ru-id04407",
      "tag": "p",
      "target_sha256": "fc06d04964f84e8ae3449a9ceb1a7faf13aa4e12d949ccfad1b6df3477416532"
    },
    {
      "source_id": "id04408",
      "target": "— Чего желает господин?",
      "source_sha256": "af2f1b516d965cf0b65d60b3ccd6ae6517a4b3e406531199baf663163d0de293",
      "target_id": "ru-id04408",
      "tag": "p",
      "target_sha256": "b2cb0835d19cd6fdd94da6588097cc3fca6743c85a35abe1ffe668fe5d82826d"
    },
    {
      "source_id": "id04409",
      "target": "— Узнать, не видели ли вы, как проезжал молодой дворянин пятнадцати лет, на рыжем коне, в сопровождении лакея.",
      "source_sha256": "4d26c49b44424eacaf56fce4d9d70cac56f81359ad62a1ac1bd2fdf12c21bf40",
      "target_id": "ru-id04409",
      "tag": "p",
      "target_sha256": "9e3f3abd4f8d24be9864c7a642c7407e7934825ee6b8ed66733f5ac4acc3b5f1"
    },
    {
      "source_id": "id04410",
      "target": "— Виконт де Бражелон? — спросил хозяин.",
      "source_sha256": "49eea1795bc5c1801d543dccf424870c36e8e9ff0344e66513d121dee9c5d6b8",
      "target_id": "ru-id04410",
      "tag": "p",
      "target_sha256": "61baf1a3d108b6b380709281ea365f6c7ecc40e3e45f1c8b4eab41f4717c087e"
    },
    {
      "source_id": "id04411",
      "target": "— Именно.",
      "source_sha256": "794be617d028265b56d20bc89183f24ef4514b88920a86ae7f65602830f38d89",
      "target_id": "ru-id04411",
      "tag": "p",
      "target_sha256": "998f4c024d35be5ccf142d5c49fc9e5ea30f6a600809a5fa7f3dae89ba9a4a2e"
    },
    {
      "source_id": "id04412",
      "target": "— Так это вас зовут господином Гримо?",
      "source_sha256": "4ec9db8e1eac92dc11ac5de794903aabbbfe7939313a47bff9023614946f5fad",
      "target_id": "ru-id04412",
      "tag": "p",
      "target_sha256": "3ffc6c805f140167d98f1dab78e39a0b2bc11b3ea2872734c88e9cdd442228b2"
    },
    {
      "source_id": "id04413",
      "target": "Путник знаком показал, что да.",
      "source_sha256": "4da5eaf81b20097f04589ac785549ef00534e2e0e2a0367bbf83924294660eb4",
      "target_id": "ru-id04413",
      "tag": "p",
      "target_sha256": "c1a65ad41035dbda3c0ff1c3cfe4ed707bb8766423eed64d9e7a9b8a3362b56d"
    },
    {
      "source_id": "id04414",
      "target": "— Что ж! — сказал хозяин. — Ваш молодой господин был здесь всего четверть часа назад; он будет обедать в Мазенгарбе, а ночевать в Камбрене.",
      "source_sha256": "1d4133cd4c430d9d1820efc6c6c1d3650112b2d2ad3cfa8a324352be14c1b061",
      "target_id": "ru-id04414",
      "tag": "p",
      "target_sha256": "64167ab9b1f1004358696e59095d7aec47d098685b589966eebd9e8a7e60a861"
    },
    {
      "source_id": "id04415",
      "target": "— Сколько отсюда до Мазенгарба?",
      "source_sha256": "aa977ead0596d76d3011f5c2980915358512109e2a71d1c84e66ce9e6052b522",
      "target_id": "ru-id04415",
      "tag": "p",
      "target_sha256": "8aa77b73f52f538e30f84d1d8509175e5089d6fb5437fe460631cd7a0263c2bf"
    },
    {
      "source_id": "id04416",
      "target": "— Два с половиной льё.",
      "source_sha256": "126df4f4340b6b778945500fbecc891d352516e845978b86f9dbe42307e623b4",
      "target_id": "ru-id04416",
      "tag": "p",
      "target_sha256": "e588dba4768d16dff20472f6782abe441125ba10595a3d61a08a3f0020aadc60"
    },
    {
      "source_id": "id04417",
      "target": "— Благодарю.",
      "source_sha256": "ba00533d5f8a20039dee72bb323bb61957e9984a4aba2d689a3e5329ccd83e5b",
      "target_id": "ru-id04417",
      "tag": "p",
      "target_sha256": "941f24ff1041b1d8efe682235b57f2bb148fa0535365d41570034c3b11eb9cb6"
    },
    {
      "source_id": "id04418",
      "target": "Гримо, уверенный, что встретит своего молодого господина до исхода дня, казался спокойнее; он отёр лоб, налил себе стакан вина и молча выпил его.",
      "source_sha256": "85ef87bf6ba7d8e17aaa864dd22acf68ba503d6e25f1ddbb16d7e1d61e124783",
      "target_id": "ru-id04418",
      "tag": "p",
      "target_sha256": "545261807bf21c6280ca7045027d073f5a5aa6e745e908696675fa65011bd0b9"
    },
    {
      "source_id": "id04419",
      "target": "Он только что поставил стакан на стол и собирался наполнить его вторично, как вдруг из комнаты, где находились монах и умирающий, раздался ужасный крик.",
      "source_sha256": "26c7b33f18d0ef36f9195aca132e46785b31043512cfa7f3c9b93ca9034b26ea",
      "target_id": "ru-id04419",
      "tag": "p",
      "target_sha256": "32b99795da6e140cd7b99f30ec4f631ea975c340a02df3433664c5b1392500d2"
    },
    {
      "source_id": "id04420",
      "target": "Гримо вскочил на ноги.",
      "source_sha256": "722d189a74192b0f978a9caa5db79e6e2e72cd5f7fb01ecd9005f42280761f42",
      "target_id": "ru-id04420",
      "tag": "p",
      "target_sha256": "817a5ff7d56245763fba1338b36225ce77adc6cf18d1f96b470ae5c51f1040c2"
    },
    {
      "source_id": "id04421",
      "target": "— Что это, — сказал он, — и откуда этот крик?",
      "source_sha256": "597ab10c8abd00e8ae8818c65a8890a1ce01522a6f4feee8626c72011dc0ea0e",
      "target_id": "ru-id04421",
      "tag": "p",
      "target_sha256": "1b1bc16ac69f1d23556983d76e2022758f4a8ece7402d68d0a2646d3fa5dbd33"
    },
    {
      "source_id": "id04422",
      "target": "— Из комнаты раненого, — сказал хозяин.",
      "source_sha256": "94349adfdba35680deacc312ed2bb2a95570601b58bf6ada9ae4f7ad663227ea",
      "target_id": "ru-id04422",
      "tag": "p",
      "target_sha256": "56db59609bb7f6dcf7bd8b718606a12632f4407996c3efc8d0a2064061e8eed5"
    },
    {
      "source_id": "id04423",
      "target": "— Какого раненого? — спросил Гримо.",
      "source_sha256": "bef38dc9b17573b061833a346d066cf3bdd7779a2d46dca757a3f751cdf8b822",
      "target_id": "ru-id04423",
      "tag": "p",
      "target_sha256": "fb9abbb30f4786a82a03598ee1ba779b6a26244abd563c95e19dbcd0d6f118b4"
    },
    {
      "source_id": "id04424",
      "target": "— Бывшего бетюнского палача, только что ставшего жертвой покушения испанских партизан; его принесли сюда, и он сейчас исповедуется брату-августинцу. Похоже, он сильно страдает.",
      "source_sha256": "e2ead8432fce4ebbe2776fbf9aaaf934c110651268e1f7715015d1a75294cf0d",
      "target_id": "ru-id04424",
      "tag": "p",
      "target_sha256": "e58f4a01027d99f2250fc2b3906a7d28b85eb7a728573adc3e1d4927f40b7e23"
    }
  ],
