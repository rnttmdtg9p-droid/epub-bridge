{
  "unit": 91,
  "batch": 1,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id11609",
      "target": "— И всё-таки мне очень хотелось бы понять, — сказал Портос.",
      "source_sha256": "c09958b5e3bd8fe0c72d65b3df42c95e03860013866d08516e9d36264162758d",
      "target_id": "ru-id11609",
      "tag": "p",
      "target_sha256": "55e81850be18197948baa0420dfb622ed5b71e595114391ceee7ba7b5c9ba8e6"
    },
    {
      "source_id": "id11610",
      "target": "— Слушайте, дорогой друг, и в двух словах вы всё поймёте. Дверь караулки отворяется, как видите.",
      "source_sha256": "631adc91f64933c8073bf851797ce27e9198385880f5959251226c85d269a397",
      "target_id": "ru-id11610",
      "tag": "p",
      "target_sha256": "5c8a5d71b5e825da8723851ff6e296821f936f430566a5529156bd66041865f1"
    },
    {
      "source_id": "id11611",
      "target": "— Да, вижу.",
      "source_sha256": "600911d1b59d98e0b45bd4deddafee22de791fe4ddcab116b2db97a7e346c824",
      "target_id": "ru-id11611",
      "tag": "p",
      "target_sha256": "ecfe8ce7179c840a73286b8ac51b9783226253c9d76418fa73cb0462db8a9af7"
    },
    {
      "source_id": "id11612",
      "target": "— Сейчас в наш двор, который господин Мазарини пересекает, направляясь в оранжерею, отправят двух стражников, сопровождающих его.",
      "source_sha256": "37eacd3382eef9ec394befd198a5cb729c15b9f87373d814eff5496d4e1fc131",
      "target_id": "ru-id11612",
      "tag": "p",
      "target_sha256": "2e925996ef9ba763c2b97ea7ea3d609102f27608986b66f49906134e375c9514"
    },
    {
      "source_id": "id11613",
      "target": "— Вот они выходят.",
      "source_sha256": "25747b63aac553cb7dfa9b2cea4d042e1185d4b4d16670da664b08e1f77ee9eb",
      "target_id": "ru-id11613",
      "tag": "p",
      "target_sha256": "12e791f990ef7dd5f7446448cd70bed6e730cb48a015e1c6588df308752e0e29"
    },
    {
      "source_id": "id11614",
      "target": "— Лишь бы они закрыли дверь караулки. Хорошо! Закрывают.",
      "source_sha256": "b86f39497295b70905cda8955f646d67d6e4c47af317981531587ae78bc97b1f",
      "target_id": "ru-id11614",
      "tag": "p",
      "target_sha256": "66c70d761561c09f51051fe77b03ec5e0abfa44c1b16b0025a1c0ad6e2c50ee4"
    },
    {
      "source_id": "id11615",
      "target": "— А потом?",
      "source_sha256": "5bff505644acbcd2b6f2451eade0894641a1e85dc522053a5918012dba6a9f4d",
      "target_id": "ru-id11615",
      "tag": "p",
      "target_sha256": "9a71a39f85166f948fd08e62089931116adeee1e1e287861ea3bec3694e4fbaf"
    },
    {
      "source_id": "id11616",
      "target": "— Тише! Они могут нас услышать.",
      "source_sha256": "2670bb99e83aa0aa0d170e1f19066897e7bc679bb7adad6aabdd2d9b828dcbf0",
      "target_id": "ru-id11616",
      "tag": "p",
      "target_sha256": "875f0b2c63ff0ea6ec56bf4cb2b51c43e452dbfd7f8f54dab2211e4b5f4050ac"
    },
    {
      "source_id": "id11617",
      "target": "— Тогда я ничего не узнаю.",
      "source_sha256": "4e36d775e32be74a3f64680840ffd44c54ea4e0ef8fc53773b0b10037e64c56b",
      "target_id": "ru-id11617",
      "tag": "p",
      "target_sha256": "357a6ebf24c73478051168f7f8694a77a48c831d93f08dc8e1695bbd6e88fd90"
    },
    {
      "source_id": "id11618",
      "target": "— Узнаете, потому что по мере того, как вы будете исполнять, вы будете и понимать.",
      "source_sha256": "bfe4d4e02310eb6a617de5abe4e44929ac60a56789dc598a574e3013f1b5fb50",
      "target_id": "ru-id11618",
      "tag": "p",
      "target_sha256": "17c70e2d38dbc50cfebc016f23653bb721d540de801f4349af94fa098d725631"
    },
    {
      "source_id": "id11619",
      "target": "— И всё же я предпочёл бы…",
      "source_sha256": "7aa8ac58ea404f5a1e126e0fab4a84d2180a15f17e9b9af8a5360c9d7cf38d22",
      "target_id": "ru-id11619",
      "tag": "p",
      "target_sha256": "ab155853d6a73b6bc33c89a97be8349b7526e303d8896894b583fb9b9ee7fe3d"
    },
    {
      "source_id": "id11620",
      "target": "— Вы получите удовольствие от неожиданности.",
      "source_sha256": "12b7fe294fcdf7d8a3a3104d88d26e72345bc419c815f18a494e8148c3ccab75",
      "target_id": "ru-id11620",
      "tag": "p",
      "target_sha256": "6913b3cf11654a13b3d3b828efebe0d901670bb17e9bbfc1af3b49ee46352471"
    },
    {
      "source_id": "id11621",
      "target": "— Ишь ты, и правда, — сказал Портос.",
      "source_sha256": "80bac965f66a69bc4bc5fbbdb169b06d12b63e3008229d2ffbc46cb8c3d04e1d",
      "target_id": "ru-id11621",
      "tag": "p",
      "target_sha256": "6f6428ef8a06bd583d23f3604654a2050dbc901ff144ec25610588a356167664"
    },
    {
      "source_id": "id11622",
      "target": "— Тсс!",
      "source_sha256": "1eaea34dbbf9926a500531a9fb1c6cdcd8cb9027bd2b051ee03111d69f35d20e",
      "target_id": "ru-id11622",
      "tag": "p",
      "target_sha256": "7025767caf3bf032756c7747bb734532b3317b09d0b99b5758e73e80e42e53c0"
    },
    {
      "source_id": "id11623",
      "target": "Портос остался нем и неподвижен.",
      "source_sha256": "dfc191f8e32b99f86ffdfb5625b4d41096267df2b42bfea7f33b5a87a340a6e7",
      "target_id": "ru-id11623",
      "tag": "p",
      "target_sha256": "eff1b6d19f011c3459d504e0c03b954c794732bc21a5e1b8324eb1bf9b5db3e5"
    },
    {
      "source_id": "id11624",
      "target": "И в самом деле, оба солдата приближались к окну, потирая руки, ведь стоял, как мы уже сказали, февраль, и было холодно.",
      "source_sha256": "c1800489224f33519b83dcb8c293d4300eb960df79565ac918e45d824aa31e4d",
      "target_id": "ru-id11624",
      "tag": "p",
      "target_sha256": "cada6fa89053191aed72231d6c65b5c545d98f458beba7121456ce9df8e934bd"
    },
    {
      "source_id": "id11625",
      "target": "В эту минуту дверь караульного помещения отворялась, и одного из солдат позвали назад. Солдат оставил товарища и вернулся в караулку.",
      "source_sha256": "67fb8350084c488b9420d027a7603839a5220bc4476bbbe50a8b43a160074e2d",
      "target_id": "ru-id11625",
      "tag": "p",
      "target_sha256": "337b884bebe556446a085416104089e357c964ae9cb6cb28c37f0fc660aa7c9e"
    },
    {
      "source_id": "id11626",
      "target": "— Значит, всё идёт по-прежнему? — спросил Портос.",
      "source_sha256": "59f45310f93fe10fd0790ff277422d59d3eb4724ab46e0194b1519cf5b3ede53",
      "target_id": "ru-id11626",
      "tag": "p",
      "target_sha256": "28de55a9118eb502f7d8afe49249922eb357680356fd7cab295b13f99900d098"
    },
    {
      "source_id": "id11627",
      "target": "— Лучше, чем когда-либо, — ответил д’Артаньян. — Теперь слушайте. Я позову этого солдата и стану с ним беседовать, как вчера беседовал с одним из его товарищей. Помните?",
      "source_sha256": "ab9de2defb5b53978d94e4a0b5d4562a4d510823c8c07d7a2d4c894a87ddafbb",
      "target_id": "ru-id11627",
      "tag": "p",
      "target_sha256": "ce886670156ed8161378f62e8edb03af02098d975a03d62f5e55c437a2f10700"
    },
    {
      "source_id": "id11628",
      "target": "— Да; только я не расслышал ни слова из того, что он говорил.",
      "source_sha256": "8bf6ef5d3657a3fbf52e184c65104d1969b74d498ac8c106f4d86e21f5ad4e1a",
      "target_id": "ru-id11628",
      "tag": "p",
      "target_sha256": "f0f2dba035395359012a629f9d5990d50e4bd2d9198bc6ff78d36a6880b5ae90"
    }
  ],
