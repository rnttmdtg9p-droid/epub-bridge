{
  "unit": 91,
  "batch": 3,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id11649",
      "target": "— Топрый фечер, мосьё, — ответил солдат.",
      "source_sha256": "c7a9a85e28fe3796d01eee7d99f0f551bc092e138de6b4c44615510ded9beb42",
      "target_id": "ru-id11649",
      "tag": "p",
      "target_sha256": "1634941bdc68e0eb63151f8087e6f0a41ec013fa924946c7cc94fd769f90aa71"
    },
    {
      "source_id": "id11650",
      "target": "— Не слишком-то тепло прогуливаться, — сказал д’Артаньян.",
      "source_sha256": "5ef77868741b9066c3fb45c2c6483ce297d3d90662a09c2c79588df73bfea00e",
      "target_id": "ru-id11650",
      "tag": "p",
      "target_sha256": "976a914dc390c4ce1e3745ca7282d95d8bd6e899f388f5e504f4418f0255ccc5"
    },
    {
      "source_id": "id11651",
      "target": "— Бррррррун, — произнёс солдат.",
      "source_sha256": "d474831f7748c834b85d1f2af5494dc61da3540d57f1501f5b34e8f2168206c1",
      "target_id": "ru-id11651",
      "tag": "p",
      "target_sha256": "74bf4e663886cf5a97e8a04161f07a7ca110d33534325d0eaa0b56026dc74804"
    },
    {
      "source_id": "id11652",
      "target": "— И я полагаю, что стакан вина вам был бы не неприятен?",
      "source_sha256": "6eb85d55a56fd58b7fd77eb83a8df74caed350a0d0a8366d78ac6fd9bc4c2cd2",
      "target_id": "ru-id11652",
      "tag": "p",
      "target_sha256": "7ef8ef10e85b30682985c0aa50e36a103e8db0b31bda605aff66408e7e6b5a46"
    },
    {
      "source_id": "id11653",
      "target": "— Штакан фина — он пудет пыть жалаothers.",
      "source_sha256": "a3b4fdb7c8e003a090d1bf2d94b8ee365153d104c96930fe66719958a92d7e33",
      "target_id": "ru-id11653",
      "tag": "p",
      "target_sha256": "9013bfb2d748750a1666ee5cbb7d6b37c60608bd6cec968c89172381d5fdc237"
    },
    {
      "source_id": "id11654",
      "target": "— Рыба клюёт! Рыба клюёт! — шепнул д’Артаньян Портосу.",
      "source_sha256": "f1c9dd54bc6c376034d36bb725e2907d0eccac6539421d7d5a8b977180bf486a",
      "target_id": "ru-id11654",
      "tag": "p",
      "target_sha256": "96b5f66baa254e168cac13ddd06d1872fe21e91bb61e4e68fefc7dca50544086"
    },
    {
      "source_id": "id11655",
      "target": "— Понимаю, — сказал Портос.",
      "source_sha256": "999c0a2af951542f83e59e537af1185ebfa327a71c3b14607868b9437dd32438",
      "target_id": "ru-id11655",
      "tag": "p",
      "target_sha256": "907372179933048adda6d0b9f1144186bac835368ab925d8372b4ee62cf20988"
    },
    {
      "source_id": "id11656",
      "target": "— У меня тут есть бутылка, — сказал д’Артаньян.",
      "source_sha256": "2d7c4987548e4739b089e20b68af636bdbb3cffca1001e4231dfccf0bfdf42ae",
      "target_id": "ru-id11656",
      "tag": "p",
      "target_sha256": "474012199e6d414c5459a5be93f2f872992d0b9340e1f966e384e232f8fea765"
    },
    {
      "source_id": "id11657",
      "target": "— Путылька!",
      "source_sha256": "4cb5df02f56ee2f2ed41a38edf0641ed0ac67930d0613e5bbaaafb44333f2be2",
      "target_id": "ru-id11657",
      "tag": "p",
      "target_sha256": "6b1dabf5b7247e6ef9b5c096c037421ebfbf77a2cbf5ca1d487fbbb2f84ca35c"
    },
    {
      "source_id": "id11658",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id11658",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "id11659",
      "target": "— Польная путылька?",
      "source_sha256": "6063156a90d3e11cf4670d8b94aa4b05dce26f2d7d1707ad43aee86420f2a7ba",
      "target_id": "ru-id11659",
      "tag": "p",
      "target_sha256": "4142721da3f614e28950c34e1da743728c7a505b5f09ba63140fba8689b0dbcb"
    },
    {
      "source_id": "id11660",
      "target": "— Целая, и она ваша, если захотите выпить её за моё здоровье.",
      "source_sha256": "072f09083bdfaebb74b62644fcca962fefac498c0a256e8d364e73ec24ae9ffe",
      "target_id": "ru-id11660",
      "tag": "p",
      "target_sha256": "0d93bb976e6c3d80f76d18b77d86f3b340bd2ea72225299bd725aa939954bba2"
    },
    {
      "source_id": "id11661",
      "target": "— Эхе! Я фотеть порошо, — сказал солдат, приближаясь.",
      "source_sha256": "ad0569378ff206f43b5f266b709983a1485041142aa40f5483b9988fefb68c53",
      "target_id": "ru-id11661",
      "tag": "p",
      "target_sha256": "60347087035369bbd164e2e0c63775aba95d16f5da0d4bfd8796a6ee5ff654f2"
    },
    {
      "source_id": "id11662",
      "target": "— Ну так идите и возьмите её, друг мой, — сказал гасконец.",
      "source_sha256": "cd9b4fa8c3379a57a871472e532c0b090587b530ff347cb665f9ab6004349d39",
      "target_id": "ru-id11662",
      "tag": "p",
      "target_sha256": "db8c5f8ddd80cf880e0821bd534278893f6e6ebe8172c230a9f36d5f6c0ae581"
    },
    {
      "source_id": "id11663",
      "target": "— Ошень ахотно. Я тумаю, тут есть шкамейка.",
      "source_sha256": "58654bfda4d5a1ae5af69a97413a0c0fb115213744a7585e590980938c50ae40",
      "target_id": "ru-id11663",
      "tag": "p",
      "target_sha256": "be623046181ae70fe670eebf7041734cf0054dc71d3b9ef99c6a54a26cc85830"
    },
    {
      "source_id": "id11664",
      "target": "— О, Боже мой, можно подумать, что её нарочно здесь поставили.",
      "source_sha256": "735615d7167a6af77b9341bad6eb53693669101578bfe8652adde6434009ac92",
      "target_id": "ru-id11664",
      "tag": "p",
      "target_sha256": "dda0d3850cdcf743bba7242ee51338f9b70c497bb307bba1a1e4dcb26475d927"
    },
    {
      "source_id": "id11665",
      "target": "Взберитесь на неё… Вот так, хорошо, правильно, друг мой.",
      "source_sha256": "2ddcaba2fd2f365f3febd47349d036448518e46750401d4f70afb81c3bec71ed",
      "target_id": "ru-id11665",
      "tag": "p",
      "target_sha256": "94e23810b763e456be1c7a170c74298279cc5e05cfcdfa1411f6eebce4eea7b8"
    },
    {
      "source_id": "id11666",
      "target": "И д’Артаньян кашлянул.",
      "source_sha256": "84987f381a45aa2a46fab4c097f58bfdb54054d6c980fdfecc8a55427d21db88",
      "target_id": "ru-id11666",
      "tag": "p",
      "target_sha256": "97d47dc151856d3fc28235736d3a7cb7af27db9f81e43adb8e0cd1719ab8151a"
    },
    {
      "source_id": "id11667",
      "target": "В тот же миг рука Портоса обрушилась вниз; его стальное запястье, быстрое как молния и крепкое как клещи, впилось в шею солдата, подняло его, удушая, втянуло к себе через отверстие, рискуя ободрать его по пути, и опустило на паркет, где д’Артаньян, оставив ему лишь столько времени, чтобы перевести дух, заткнул ему рот своим шарфом и, едва тот был заткнут, принялся раздевать его с проворством и ловкостью человека, изучившего своё ремесло на поле битвы.",
      "source_sha256": "128d0b40ee6c4d0bd64563dee94c8dbf7889d14d8d3a4bb3779af42cc332c128",
      "target_id": "ru-id11667",
      "tag": "p",
      "target_sha256": "ddf2153cf2c07d155d33ed6334b1ed91468d77b66e9c21874f7a524335ed6e3d"
    },
    {
      "source_id": "id11668",
      "target": "Затем связанного солдата с заткнутым ртом отнесли в камин, огонь в котором наши друзья предварительно погасили.",
      "source_sha256": "af486d6121ee0efc41102fd97c45335a23d64b98a282be79979b273851902910",
      "target_id": "ru-id11668",
      "tag": "p",
      "target_sha256": "ac174a65c1cea9d0654e0d83c56338f7e72b959ea40587141db7d235e9395c3a"
    }
  ],
