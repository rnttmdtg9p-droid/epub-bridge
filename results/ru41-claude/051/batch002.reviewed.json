{
  "unit": 51,
  "batch": 2,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id06519",
      "target": "Мазарини бросился вперёд.",
      "source_sha256": "84922458c41501442e7391045f0e75d5a9b0aa902853e73be8e74646303f2d9f",
      "target_id": "ru-id06519",
      "tag": "p",
      "target_sha256": "195e60f45f863bf80d5ac30a52a6f8869394a49dbc3716ff1b7d0360e46aea80"
    },
    {
      "source_id": "id06520",
      "target": "— Сударыня, — сказал он, — если бы я в свой черёд осмелился подать вам совет…",
      "source_sha256": "0ba7d57a25b5e50bcbdab369841ae372898cae363c09a12f69cbda56d1860705",
      "target_id": "ru-id06520",
      "tag": "p",
      "target_sha256": "af503a6e5c40abd255465f4170847e435c4ecd33ce1d0ee0c411f12b142a9a87"
    },
    {
      "source_id": "id06521",
      "target": "— Уж не вернуть ли и Бруселя, сударь? В таком случае можете избавить себя от этого.",
      "source_sha256": "df3cebb16c4fe05c278b036d00ade2abead3327b159b5a8aa03e884016a676ee",
      "target_id": "ru-id06521",
      "tag": "p",
      "target_sha256": "72833b758e3079b3540e7bcfc24ae3943f126369b9e38870c4900c4dc3fda10d"
    },
    {
      "source_id": "id06522",
      "target": "— Нет, — сказал Мазарини, — хотя, быть может, этот стоит не меньше всякого другого.",
      "source_sha256": "7694addcb6953f646604b2fbaa345f011a20704ac3a346fe0a024f6ac1100bfd",
      "target_id": "ru-id06522",
      "tag": "p",
      "target_sha256": "9730001e42027173395b0cf56dbdaa12b14281b2ada4dde880cc8d31cda9b330"
    },
    {
      "source_id": "id06523",
      "target": "— Что же тогда?",
      "source_sha256": "b81896f0faffd5d4e58dfdad5d95a61b01e79383cd2cc29ee520aaf9b9783cd2",
      "target_id": "ru-id06523",
      "tag": "p",
      "target_sha256": "5595820384c291155bb3779d2473d6d2c8f30623181b32455698338f01f06b02"
    },
    {
      "source_id": "id06524",
      "target": "— Позвать господина коадъютора.",
      "source_sha256": "8847c6af1c15b658527f44f1da86b61fd5549648a9361a9b2eea61ea31ddf52d",
      "target_id": "ru-id06524",
      "tag": "p",
      "target_sha256": "95146ac8d9066847afa8b401152f006734943716a65baf56d6b1cdaf7f845e54"
    },
    {
      "source_id": "id06525",
      "target": "— Коадъютора! — воскликнула королева. — Этого ужасного смутьяна! Это он поднял весь этот мятеж.",
      "source_sha256": "a30a488ee5b9fdd870c59bf6b770ef6fa7abcab306982d676a58ed047893e4fe",
      "target_id": "ru-id06525",
      "tag": "p",
      "target_sha256": "1db66c20d11e4aad73e6445b03b5f3c81c2552328c7fd606befc9f59d1968676"
    },
    {
      "source_id": "id06526",
      "target": "— Тем более, — сказал Мазарини. — Если он его поднял, он может его и унять.",
      "source_sha256": "81aeeeaaae9c514c4507cf1d0d6d0196e3688377efda2333fbaef369a62362c9",
      "target_id": "ru-id06526",
      "tag": "p",
      "target_sha256": "4d5b501bcbb1c34492ef339538d1383a192eda94a4b82ef17aa61712fa1f6a16"
    },
    {
      "source_id": "id06527",
      "target": "— И смотрите, сударыня, — сказал Коменж, стоявший у окна и глядевший в него, — смотрите, случай хорош: он как раз даёт благословение на площади Пале-Рояля.",
      "source_sha256": "d93f59673575a7849d171f4f465445d284bbaedee39ae1ebdbaaef95e1b65620",
      "target_id": "ru-id06527",
      "tag": "p",
      "target_sha256": "fbc92a28b9ed360ec9c8ecbe4b9941af4f0e672c85c551a7ae239829abd29c86"
    },
    {
      "source_id": "id06528",
      "target": "Королева бросилась к окну.",
      "source_sha256": "36a8eb063163d5aa19f6bc2fe1f7bf83ff46810622ce1af46a525c9a11902c49",
      "target_id": "ru-id06528",
      "tag": "p",
      "target_sha256": "d3e8c4e57b54f99577e386d9ca07d2a90f121ef304f77ba413a41f8de1abaa9f"
    },
    {
      "source_id": "id06529",
      "target": "— Правда, — сказала она, — мастер-лицемер! Смотрите!",
      "source_sha256": "27ac7fe8fe30302401620a928c7e7b833b3adcf1ad51bf19b00e3b3ede72fd06",
      "target_id": "ru-id06529",
      "tag": "p",
      "target_sha256": "077a3b824ef25ee51629c4fb81d116d86bdb064aa6f3734bc61eb0671ee2572b"
    },
    {
      "source_id": "id06530",
      "target": "— Я вижу, — сказал Мазарини, — что все преклоняют перед ним колена, хотя он всего лишь коадъютор; а будь я на его месте, меня разорвали бы в клочья, хотя я кардинал. Итак, сударыня, я настаиваю на <i>моём желании</i> (Мазарини сделал ударение на этом слове), чтобы Ваше Величество приняли коадъютора.",
      "source_sha256": "bb8755d756be3c470037eaea6f374dc264796db0690fe3de4b2067b1f351cd43",
      "target_id": "ru-id06530",
      "tag": "p",
      "target_sha256": "0881b18549edf1d9169beca4825fca284088da65cc2404e40cf8ffbe196da0c5"
    },
    {
      "source_id": "id06531",
      "target": "— А почему вы тоже не скажете: «на <i>вашей воле</i>»? — тихо ответила королева.",
      "source_sha256": "f16dc9c776bcb6e6eeeadd5c1122ae4089d3c75a2a2ebd4f2d894c5b63965b36",
      "target_id": "ru-id06531",
      "tag": "p",
      "target_sha256": "69e183f55f2765ebf34657b67dcb604571dc758a6bf11ffcf2e7c3fb0ffa6a45"
    },
    {
      "source_id": "id06532",
      "target": "Мазарини поклонился.",
      "source_sha256": "ab70e5b1811cb43f8b692d18d3f790a13ad4ae88f2139e99f344a21f708e899e",
      "target_id": "ru-id06532",
      "tag": "p",
      "target_sha256": "fb2bf333f87232bb090fb72988ee3d6ffeac8436a52767c64302fc00a2a6f3d0"
    },
    {
      "source_id": "id06533",
      "target": "Королева на миг задумалась. Затем, подняв голову:",
      "source_sha256": "17f38d7f57fdd534842a9a31e554d69afccd08a077508584fa0877ce57a24c40",
      "target_id": "ru-id06533",
      "tag": "p",
      "target_sha256": "61421b80790874968e62d21dce3914786adfded05500c641dc66a5ac69013bde"
    },
    {
      "source_id": "id06534",
      "target": "— Господин маршал, — сказала она, — сходите за господином коадъютором и приведите его ко мне.",
      "source_sha256": "377f0e13739664669921c44a474cda083f2eac181f0fc94196231cc80d9f0969",
      "target_id": "ru-id06534",
      "tag": "p",
      "target_sha256": "b225e9675ac92a7ca35e2f9a3536b76d41aa34387d16703ca09791826d93c8ee"
    },
    {
      "source_id": "id06535",
      "target": "— А что мне сказать народу? — спросил маршал.",
      "source_sha256": "157a03a16f616da9112d32fd293ba60b5731febb241e1ed62492e8b0c1bcf1f3",
      "target_id": "ru-id06535",
      "tag": "p",
      "target_sha256": "4013d54b5128ff7fc7af8c26f69b74042084822df406177098ddf80a09a413f0"
    },
    {
      "source_id": "id06536",
      "target": "— Пусть запасётся терпением, — сказала Анна Австрийская. — У меня-то оно есть!",
      "source_sha256": "fec602a326dd33c7f972c25600112f1f05731daaa8d53fc660b7398478e2e159",
      "target_id": "ru-id06536",
      "tag": "p",
      "target_sha256": "9ef4587ca13c74a779f111049f9b54d741ea4c582a124e9c01ada8cb46a4693d"
    },
    {
      "source_id": "id06537",
      "target": "В голосе гордой испанки прозвучала такая повелительная нота, что маршал не сделал ни одного замечания; он поклонился и вышел.",
      "source_sha256": "9cc05a544429524e7707e10c272d57ca1d3922f5048c13e0112ad0bb2d1938f4",
      "target_id": "ru-id06537",
      "tag": "p",
      "target_sha256": "5edfd33b5fb39db655cf800b6c40827577e7426378e3062b996628e9e4f56a4d"
    },
    {
      "source_id": "id06538",
      "target": "Д’Артаньян обернулся к Портосу:",
      "source_sha256": "507f183f9fb274021ef4ca668c8d687ee72e51100813b479b25e1ea8d3eed8d4",
      "target_id": "ru-id06538",
      "tag": "p",
      "target_sha256": "9332e596c059685a9a358098f4e214219fd854be0d16ccc6188a452ab573d75f"
    }
  ],
