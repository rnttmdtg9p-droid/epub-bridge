{
  "unit": 38,
  "batch": 3,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id04907",
      "target": "— Что у меня их пока нет, но что я обедаю с двумя людьми, которые могли бы мне их дать.",
      "source_sha256": "6e797c4677147fafa51e66498732029e0ce42d52edaf7f0e8ec589b173d719ec",
      "target_id": "ru-id04907",
      "tag": "p",
      "target_sha256": "5fc7ac1cd5f51ea07b37b63d0c94f006f0552c48fd2e5113071c84fa838d3c0d"
    },
    {
      "source_id": "id04908",
      "target": "— Вы так ему и сказали! — проговорил Портос, и громкий смех расплылся по его широкому лицу. — Браво! И вам это не страшно, Атос?",
      "source_sha256": "7b267ad3cc8410d1efee2dc2e80d2d0738f85c72568bab596b0d71ad96907e17",
      "target_id": "ru-id04908",
      "tag": "p",
      "target_sha256": "1cbde6e0ad8087dc121f79e48848c8129ef520b07c770a8b0b4cc0d02947e666"
    },
    {
      "source_id": "id04909",
      "target": "— Нет, — сказал Атос, — поисков Мазарини я не боюсь.",
      "source_sha256": "90af27ccb6619221384c0d3205c156bcfb3fbaae8ee98f5bd9c6242cb30e30b6",
      "target_id": "ru-id04909",
      "tag": "p",
      "target_sha256": "7cd27fa5653aaad59674e0a997c3d7274ced514328333b6a4b1bc357e4e13af1"
    },
    {
      "source_id": "id04910",
      "target": "— Вы-то? — подхватил Арамис. — Скажите-ка мне, чего же вы боитесь?",
      "source_sha256": "548fa97757c496618794b76430d15be1968cb9e39d547496b8e6729c48795cbe",
      "target_id": "ru-id04910",
      "tag": "p",
      "target_sha256": "5ef77c57135048006bbb060fa8e7bf951e8b30c4f26f04f242f54a0e67fe59fc"
    },
    {
      "source_id": "id04911",
      "target": "— Ничего, по крайней мере в настоящем, это правда.",
      "source_sha256": "6108e1869a30efd3b70ab44987ccaf35eea524604880e7ad9ceac57596bfdd7d",
      "target_id": "ru-id04911",
      "tag": "p",
      "target_sha256": "0ae6a5476ff8e10a7ce00f946ab61d6370434a7b9a617dd46a06f0d61244c6ed"
    },
    {
      "source_id": "id04912",
      "target": "— А в прошлом? — спросил Портос.",
      "source_sha256": "a8093b091b5322c144f4b38f17692aa8af6e16419b6bf2e26742a29dddea7871",
      "target_id": "ru-id04912",
      "tag": "p",
      "target_sha256": "09d51e3e413fc51ae95b9d131821f5d50cb6b0b614ee68cd20ec303d2348ac32"
    },
    {
      "source_id": "id04913",
      "target": "— Ах! В прошлом — другое дело, — со вздохом сказал Атос, — в прошлом и в будущем…",
      "source_sha256": "e14962ea9a337a82750345a6fe0abb3b83267741edba8a578c62da023b941018",
      "target_id": "ru-id04913",
      "tag": "p",
      "target_sha256": "f4a343bdfe6bc8412699bcff4e7c51338059c214fc4649fc62dd6357ec6defac"
    },
    {
      "source_id": "id04914",
      "target": "— Вы опасаетесь за вашего юного Рауля? — спросил Арамис.",
      "source_sha256": "9eaf38ccf48166ecdabc985d8ba0db41c9ed51a4f764120c2eec1d230a1bc034",
      "target_id": "ru-id04914",
      "tag": "p",
      "target_sha256": "5278cf90464d800633350e81ecbd40e6b94f8557c10c17056584d86344dc9cd5"
    },
    {
      "source_id": "id04915",
      "target": "— Полно! — сказал д’Артаньян. — В первом деле никогда не убивают.",
      "source_sha256": "aa207ec90f79baa80340c85ae9b7de7a3c8e4663bfdec1b28dcc6b5f0c51955b",
      "target_id": "ru-id04915",
      "tag": "p",
      "target_sha256": "3eecdbc0bad3e678486fa2ce47949b103905c1f0459350729399ec234f256de0"
    },
    {
      "source_id": "id04916",
      "target": "— И во втором, — сказал Арамис.",
      "source_sha256": "e641a0732287aa1e429fce36c215c031d08e25953fc1528db91b4f47678ec5f5",
      "target_id": "ru-id04916",
      "tag": "p",
      "target_sha256": "cf5e60d1f4daa40d61e319bc15e3c91eefac94424e645015cdd3fe3d55f36d70"
    },
    {
      "source_id": "id04917",
      "target": "— И в третьем, — сказал Портос. — К тому же, когда тебя убивают, оттуда возвращаются, и доказательство тому — вот мы.",
      "source_sha256": "6ab9665eb500c5c04c4f87b8630903fa56cea8e4819a37360aaa4a399123efa8",
      "target_id": "ru-id04917",
      "tag": "p",
      "target_sha256": "c14ccfcc7a1ca181582cf3f7b8240c0d66900b9833aacb05c7021442ee24826d"
    },
    {
      "source_id": "id04918",
      "target": "— Нет, — сказал Атос, — и Рауль меня тоже не тревожит: ведь он будет вести себя, я надеюсь, как дворянин, а если его убьют, что ж! это будет доблестно; но послушайте, если бы с ним случилось это несчастье, что ж…",
      "source_sha256": "b9bd974830c39d94d6961eda6e261e520d79ca320221e6f057fabca2447c127d",
      "target_id": "ru-id04918",
      "tag": "p",
      "target_sha256": "81339c140a7af852af84666674f17982f29c65f0dc3b232a6c5fe3d325c018a6"
    },
    {
      "source_id": "id04919",
      "target": "Атос провёл рукой по бледному лбу.",
      "source_sha256": "da51dbd6316e9273b5c76ef7ef9d04ebe9fe635a05d647f7976cb487d7733cd2",
      "target_id": "ru-id04919",
      "tag": "p",
      "target_sha256": "078d8418a32b4b6a9b17711e2ba2eed7f072420ec9d92b60ac0dd580089e0143"
    },
    {
      "source_id": "id04920",
      "target": "— Что же? — спросил Арамис.",
      "source_sha256": "6f6c735f3726f73bfc3bd116d4cad0b25e8de2f20998b40087bfcf7f037a0ecc",
      "target_id": "ru-id04920",
      "tag": "p",
      "target_sha256": "ceee3e5d50556153fcad80008d42624ad2c98d7c03c0c8900dedf4bcbbf7897a"
    },
    {
      "source_id": "id04921",
      "target": "— Что ж! Я счёл бы это несчастье искуплением.",
      "source_sha256": "4ec574e0286033f5dce7438fffa5794945d4dffd454261f7d6a147ab4f3dbb5b",
      "target_id": "ru-id04921",
      "tag": "p",
      "target_sha256": "744f0dfc8b81c39b0e1e3f922090f9f4b78bcbc7340cfdf73404166c1843f7ab"
    },
    {
      "source_id": "id04922",
      "target": "— А-а! — сказал д’Артаньян. — Я знаю, что вы хотите сказать.",
      "source_sha256": "20414d55d4b48c55341106ac7e4e304cf785e9c7ce635c17f6abe6bcabb04abe",
      "target_id": "ru-id04922",
      "tag": "p",
      "target_sha256": "bc3ef64d7768a5ca3ca15eb96e4dddcb71b4c2e5eb9b97052e523319365e6ef3"
    },
    {
      "source_id": "id04923",
      "target": "— И я тоже, — сказал Арамис, — но об этом не следует думать, Атос: что было, то было.",
      "source_sha256": "06e3d71aa13d2d0e4dd1116800273a5e1b14cb2cba7c30a1d13ea02b58be8321",
      "target_id": "ru-id04923",
      "tag": "p",
      "target_sha256": "71c2a5f7c69e4c14b7e61d36f8559263b4b060f4e3021cbdcd67f4712038cb57"
    },
    {
      "source_id": "id04924",
      "target": "— Я не понимаю, — сказал Портос.",
      "source_sha256": "5f7a0adb537876cf60405e24f537c83d0803d0768ee196f6c6900d80d84bd965",
      "target_id": "ru-id04924",
      "tag": "p",
      "target_sha256": "11fb3a4b18b76e48b975de90f45fb0d493fc4bc68ef6a5aa63e24c2fb45681f4"
    },
    {
      "source_id": "id04925",
      "target": "— Армантьерское дело, — совсем тихо сказал д’Артаньян.",
      "source_sha256": "e827951b7808bdddb3264ba1d4cf55060a1248b3d3ed91399e6f8a9a2a60f6ab",
      "target_id": "ru-id04925",
      "tag": "p",
      "target_sha256": "24c9361383dc7558b946edd278224ad548ef93a361d6d70c7246640c534e7ef6"
    },
    {
      "source_id": "id04926",
      "target": "— Армантьерское дело? — спросил тот.",
      "source_sha256": "688e0fcd9cfb5f1a0ad2359df554e16595a987d7d17de1ffbfd6661158fd502f",
      "target_id": "ru-id04926",
      "tag": "p",
      "target_sha256": "593b0d0a2fd4c2152e27a1294828c7feb962d1528ef5ea2fc9a1c1c8180a870c"
    }
  ],
