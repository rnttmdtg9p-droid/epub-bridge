{
  "unit": 84,
  "batch": 4,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id11208",
      "target": "— Нет, благодарю.",
      "source_sha256": "38661adb48817a6ada4fb04dccad720c90cf312197fa25fca4bf1e12c4a49761",
      "target_id": "ru-id11208",
      "tag": "p",
      "target_sha256": "7fda15e591bdfae018bd437d293e1889fee6f6a58ba9f28baafadbf416f7ee91"
    },
    {
      "source_id": "id11209",
      "target": "— Если нас арестуют всех четверых и мы окажемся вместе, думаю, нам уже ничто не грозит. Через сутки мы все четверо будем на свободе.",
      "source_sha256": "7a4a11430cbb03000b0a4b78b3f0b376d5df460af3d1a5c00caf9769069cb9e4",
      "target_id": "ru-id11209",
      "tag": "p",
      "target_sha256": "7abd49464e9a5caaeac7901bd118628c9894717926e5d6ee5bcbbe90811589eb"
    },
    {
      "source_id": "id11210",
      "target": "— Дорогой мой, с тех пор как я убил Шатильона, кумира дам Сен-Жермена, вокруг моей особы столько блеска, что тюрьмы мне следует бояться вдвойне. Королева вполне способна в этом случае послушаться советов Мазарини, а совет, который даст ей Мазарини, будет в том, чтобы предать меня суду.",
      "source_sha256": "b5453860f7ceedd41df913505bbb094a298e93a96ddd5f8783fa35605614ffaa",
      "target_id": "ru-id11210",
      "tag": "p",
      "target_sha256": "d1ffa7b1849428f02d3081497605e231561165ebfdd8da119b83b791e30012a7"
    },
    {
      "source_id": "id11211",
      "target": "— Да неужели вы думаете, Арамис, что она любит этого итальянца так сильно, как о том говорят?",
      "source_sha256": "b2bd01a029c0339b1b181522ea8499116299c81fc723aacd9c507bdf42892811",
      "target_id": "ru-id11211",
      "tag": "p",
      "target_sha256": "5c1d2eda7af6c8a6fc0cc5f7a75907b35c17a442663033e303ae89192fdd74f5"
    },
    {
      "source_id": "id11212",
      "target": "— Она ведь любила одного англичанина.",
      "source_sha256": "3fc70fb6e0565fe1561c9dd3dc9c8ccc76c0f16c87850a1dc7cbdcba02a5cc10",
      "target_id": "ru-id11212",
      "tag": "p",
      "target_sha256": "460a15a492767fee8162548c6970c5a53b0fd48e6be9291d5d5de700d570afb3"
    },
    {
      "source_id": "id11213",
      "target": "— Эх, дорогой мой, она же женщина!",
      "source_sha256": "ce7413fb3f887fd0a93ac2f4795b2227601100e6cb7a5634298c84994587d4e8",
      "target_id": "ru-id11213",
      "tag": "p",
      "target_sha256": "6c9dd7ade80998ebed84ba8d35085976f99aeedcf4046b4d74ebb8a8201d6635"
    },
    {
      "source_id": "id11214",
      "target": "— Ничуть; вы ошибаетесь, Атос, она королева!",
      "source_sha256": "6639f981b9a1e42c75b168d45d41e3072e59b2d06136526510d12a347e855a31",
      "target_id": "ru-id11214",
      "tag": "p",
      "target_sha256": "00b43d94d440c04525fc48d8395205695b4fbc62c30bed619026dd80aa24fdc8"
    },
    {
      "source_id": "id11215",
      "target": "— Дорогой друг, я жертвую собой и отправляюсь просить аудиенции у Анны Австрийской.",
      "source_sha256": "9c4d34d508fbe4d0ae0c009d17158d10b2a06c171a1bc40a6396a4b5f2efbb1e",
      "target_id": "ru-id11215",
      "tag": "p",
      "target_sha256": "597d0a162ca540a220e8548bd310ae0943eaf4795d2359f0184fddf46fdb8b57"
    },
    {
      "source_id": "id11216",
      "target": "— Прощайте, Атос, я отправляюсь набирать армию.",
      "source_sha256": "ea5cdc3f27a9262e9454967b17a11ecdf122c3691bb3a4d811cfd13b12f0091b",
      "target_id": "ru-id11216",
      "tag": "p",
      "target_sha256": "7996f20f03bfbeb29a72fdae3fa5322137ce13eccf66af5896eec5a6850a5840"
    },
    {
      "source_id": "id11217",
      "target": "— Зачем?",
      "source_sha256": "4df372979f9c65d2e3491ac5c11122cf1612668eefd2ba7d9c7d1cff8fbb8b86",
      "target_id": "ru-id11217",
      "tag": "p",
      "target_sha256": "2dbb888fa6d413f7fe6e300e2500948cbeaa4517a86bc873b30ce37bc2bed5d3"
    },
    {
      "source_id": "id11218",
      "target": "— Чтобы вернуться и осадить Рюэй.",
      "source_sha256": "2fd672ae5f5274b5c321576844921f1c51282936fb786f4dc89d0e1e78962b91",
      "target_id": "ru-id11218",
      "tag": "p",
      "target_sha256": "e12b5f9cd3576d39c867d1fc10d7d1bbf0a303871a2f36f24a7c5aa587b02606"
    },
    {
      "source_id": "id11219",
      "target": "— Где мы с вами встретимся?",
      "source_sha256": "8a14d9e7e8c84cb69dadf0f4409de24ab7c4a0f8dee9c945b139fa8964458292",
      "target_id": "ru-id11219",
      "tag": "p",
      "target_sha256": "5bd47852a5523b7b6aec4c4e3364e7786ce9f6ba02174a19d4f6c1ce64eb7e40"
    },
    {
      "source_id": "id11220",
      "target": "— У подножия виселицы кардинала.",
      "source_sha256": "4755d0e48bee7a8c83d60335a821da91318a37247f5e0ed41a2660f3c850d2bd",
      "target_id": "ru-id11220",
      "tag": "p",
      "target_sha256": "f126d7bca73665df6e23310413603d245846ff63a99e8b419846ed7d77f0abb7"
    },
    {
      "source_id": "id11221",
      "target": "И два друга расстались: Арамис — чтобы вернуться в Париж, Атос — чтобы несколькими подготовительными шагами проложить себе путь к королеве.",
      "source_sha256": "66a9820b6d63f73307ff816ca741085b41b353e1fa986c7ae3f71c8c6aa29700",
      "target_id": "ru-id11221",
      "tag": "p",
      "target_sha256": "816221fbf852a848d479ba2f7780caae4f46714fdaaa74dff058d4ec232444a9"
    }
  ],
