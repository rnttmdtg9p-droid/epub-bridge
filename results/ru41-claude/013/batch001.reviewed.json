{
  "unit": 13,
  "batch": 1,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id01495",
      "source_sha256": "9723b6a56838cb0ae9866b36613f26978c98bb45258f30dad0eded16fc5fc47a",
      "target": "Уже накрытый стол ждал.",
      "target_id": "ru-id01495",
      "tag": "p",
      "target_sha256": "547e2713c834ae4e6e406a39a7b1c6c3699ae99e20072ddb72023889791c5bf3"
    },
    {
      "source_id": "id01496",
      "source_sha256": "94594e49d530e5fd2623ea5c3fa5bca9af640e6e255dc253bb512cf6486ba1ef",
      "target": "— Вот видите, — сказал Портос, — таков мой обычный стол.",
      "target_id": "ru-id01496",
      "tag": "p",
      "target_sha256": "a8d1bc02ff7564ff2033c2cc315f894c4188f05fb08585f6da2aef3f64ef4bc1"
    },
    {
      "source_id": "id01497",
      "source_sha256": "52389ea700eefc416b817f897e13f0580f42b02af4eab9c098f6105efc4c85f0",
      "target": "— Черт возьми, — сказал д’Артаньян, — поздравляю вас: у короля такого нет.",
      "target_id": "ru-id01497",
      "tag": "p",
      "target_sha256": "ee4b350e4c2e07865f2454f3268c5ae4637b604c9d410aa07f385b29e4e573ff"
    },
    {
      "source_id": "id01498",
      "source_sha256": "8cd2c306eca85d7011f51177ee1fec2e48e5b77047b293a5fa284b9e1963c74c",
      "target": "— Да, — сказал Портос, — я слышал, что господин де Мазарини кормит его очень скверно. Отведайте эту котлету, любезный д’Артаньян, она из моих баранов.",
      "target_id": "ru-id01498",
      "tag": "p",
      "target_sha256": "63f2bdb11f3c97178df35b3f3d2dbc104a05f2e14adce120eb410324b7ec819e"
    },
    {
      "source_id": "id01499",
      "source_sha256": "735ef280271ff563188a6b3ccbc714c4b875444b7cf82453f6330b7065d404a5",
      "target": "— У вас очень нежные бараны, — сказал д’Артаньян, — и я вас с ними поздравляю.",
      "target_id": "ru-id01499",
      "tag": "p",
      "target_sha256": "4ad63c9641f02bee51059a950cd72834db5e621cea6121493f9c81890098b765"
    },
    {
      "source_id": "id01500",
      "source_sha256": "3e654f8b775a3e28fa5e08b7b0e2f174f14a452100c182b137024750c1c833ee",
      "target": "— Да, их откармливают на моих лугах, которые превосходны.",
      "target_id": "ru-id01500",
      "tag": "p",
      "target_sha256": "e0ea20790c9708e6703dd045e3745c2a1997076eeb4e98a2271d99ede51fd069"
    },
    {
      "source_id": "id01501",
      "source_sha256": "84d22db7adfc625fffc20880ed2413df7b6eb403b5ebb636e37701dea7a32765",
      "target": "— Дайте мне еще.",
      "target_id": "ru-id01501",
      "tag": "p",
      "target_sha256": "1a46a16d410403df44783b31b4371a61ecf2da907d4f8e16e84bd1fa26b26100"
    },
    {
      "source_id": "id01502",
      "source_sha256": "ad339a70d9c8e7cf4ee19caad5fdac6b1968c674d2721cad1d433f53f6494095",
      "target": "— Нет, лучше возьмите вот этого зайца, которого я вчера убил в одном из моих заповедных угодий.",
      "target_id": "ru-id01502",
      "tag": "p",
      "target_sha256": "bbb039ae7c7bb2288d7de5558f3217851cd3acf2de67bf42e12a51db9055d065"
    },
    {
      "source_id": "id01503",
      "source_sha256": "8b04b4d995195a07d22d864326523c6182be38afe575009f76ce836b4ce92cfd",
      "target": "— Черт возьми, какой вкус! — сказал д’Артаньян. — Послушайте, да неужели вы кормите ваших зайцев одним чабрецом?",
      "target_id": "ru-id01503",
      "tag": "p",
      "target_sha256": "06febc8149f6c50d33e50ce7018a119bd9ee88ea2ae43ca2eaf39a05f6d7869b"
    },
    {
      "source_id": "id01504",
      "source_sha256": "66b806ad36059c0c8f0fcc0033d3d9c83263d7ac08017770a6601a31c664b16c",
      "target": "— А что вы скажете о моем вине? — спросил Портос. — Оно приятное, не правда ли?",
      "target_id": "ru-id01504",
      "tag": "p",
      "target_sha256": "134dce5a4d5794f3f24caf797b1b77c5ac867fc99b13af1e581481dac1184d0c"
    },
    {
      "source_id": "id01505",
      "source_sha256": "239a47e5ab26e2459d3b69e97e97f202ddc2945a230fab1b415cc27552bbdbb4",
      "target": "— Прелестное.",
      "target_id": "ru-id01505",
      "tag": "p",
      "target_sha256": "66300657a5a7c059522dd76d8660eeaa65851aaea2afb08bf503363380c836d0"
    },
    {
      "source_id": "id01506",
      "source_sha256": "a111ed8d1fae8842128af6bddd56753e13da9344ae30e0ac5a93997b6432f68c",
      "target": "— А между тем это вино здешних мест.",
      "target_id": "ru-id01506",
      "tag": "p",
      "target_sha256": "aea2593923996c9d380d1a1e8f9ecdd4d222fd2e23172dd9cc5a38b3cc37c273"
    },
    {
      "source_id": "id01507",
      "source_sha256": "d5a3f1081b7fa798d5dbbca043895a50bbd842c73f49e24bc65e0562349cbafd",
      "target": "— В самом деле!",
      "target_id": "ru-id01507",
      "tag": "p",
      "target_sha256": "7a1ec58975b63dc1677e3c60c2a68c0c331dbdf2b7559fcd56202fd268ce16d8"
    },
    {
      "source_id": "id01508",
      "source_sha256": "6d272f3fa8e1e721298a333438a17a04bb4d8cc515ab2018d72ee7cb0f8ec58d",
      "target": "— Да, с небольшого южного склона, вон там, на моей горе; он дает двадцать мюидов.",
      "target_id": "ru-id01508",
      "tag": "p",
      "target_sha256": "1c62b4ff79d2e9df37184cab10e19f2ef51009614a49cfbdf8fec7de290c255f"
    },
    {
      "source_id": "id01509",
      "source_sha256": "ca625e660e7f0d68a24f02149d2ec4413ae6f884854e6517e14664a4a963cb3d",
      "target": "— Да это же настоящий сбор винограда!",
      "target_id": "ru-id01509",
      "tag": "p",
      "target_sha256": "a54e3ed7de922a12eb00d8df2895c71835f95e311b86ff842c36be269eac2ced"
    },
    {
      "source_id": "id01510",
      "source_sha256": "c91f09cac39dda221c85fd8f43067236a9925c2c3854e280ff86938d1d2d3dd8",
      "target": "Портос вздохнул в пятый раз. Д’Артаньян считал вздохи Портоса.",
      "target_id": "ru-id01510",
      "tag": "p",
      "target_sha256": "196cd979fd7a11b46b4609d60c1b15df892fa5eaf7c733778d6eca67dce5a761"
    },
    {
      "source_id": "id01511",
      "source_sha256": "f1c402cb144351101d553e29d105e3bff381ce6cb0cfaedeb9cf01ce9b6e3678",
      "target": "— Послушайте, — сказал он, горя любопытством докопаться до сути дела, — можно подумать, дорогой друг, что вас что-то печалит. Уж не нездоровы ли вы случайно?.. Неужели это здоровье…",
      "target_id": "ru-id01511",
      "tag": "p",
      "target_sha256": "332dc235d5c854efa07ee25d562166c77fa868b2de5b45db45ed0f7460c3ecd3"
    },
    {
      "source_id": "id01512",
      "source_sha256": "df7e71f81732bad0e4f2b2d31835409d86716d59a090384d6f7573282ea2275c",
      "target": "— Превосходное, друг мой, лучше прежнего; я убил бы быка одним ударом кулака.",
      "target_id": "ru-id01512",
      "tag": "p",
      "target_sha256": "3a960c75fc2b52a33a05cdbbb607ff12b21041e9e3e3af81cbac978b8ae603b5"
    },
    {
      "source_id": "id01513",
      "source_sha256": "32368d7126be6192aed0abd11c2f980c1b04f3c718cbded798de4c6f67293f7a",
      "target": "— Тогда, значит, семейные огорчения…",
      "target_id": "ru-id01513",
      "tag": "p",
      "target_sha256": "5b9ac43d4d909c633ec4a3cc99cc01a1c27e2039b48aa91caf9f9ce42dd776e2"
    },
    {
      "source_id": "id01514",
      "source_sha256": "10582995106ac7247b431bb3ab01783e1ae4967d6e2900c5f8776ba2f88fd396",
      "target": "— Семейные! К счастью, у меня никого нет на свете, кроме самого себя.",
      "target_id": "ru-id01514",
      "tag": "p",
      "target_sha256": "899aa235098730dd645850c23cd3a05f6d7aebfde8853ad9c5ff575a7665f8d0"
    }
  ],
