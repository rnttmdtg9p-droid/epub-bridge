{
  "unit": 13,
  "batch": 4,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id01555",
      "source_sha256": "5621010bd424e1174431b4840b7ff74d432ddb1ddbd0a3f55eb4f87f09cb3eb2",
      "target": "— Охотно, — сказал д’Артаньян, — только предупреждаю вас, дорогой друг, чтобы вы потом не говорили, будто я захватил вас вероломно, что вам всё-таки придётся изменить образ жизни.",
      "target_id": "ru-id01555",
      "tag": "p",
      "target_sha256": "3e6aeb79287b2e6c9fc656ae6f70d8d99dda73bcbcc569e9571e88ffea23c1f6"
    },
    {
      "source_id": "id01556",
      "source_sha256": "24abe4982bc1efaf04df8781dfe2ce72e9299c18c2fb0ec5d15297b000883304",
      "target": "— Как так?",
      "target_id": "ru-id01556",
      "tag": "p",
      "target_sha256": "b4592186655d9f97c936bc9d5e1c7013346d208284974aa91c654d8e6e435aad"
    },
    {
      "source_id": "id01557",
      "source_sha256": "4ecbbf3e3a36c44e384515454beda747d8565be4fad89aeb1ffbbd15038a9fe7",
      "target": "— Снова надеть сбрую, опоясаться шпагой, искать приключений, оставлять, как в старые времена, частицу собственной плоти на дорогах; словом, вы знаете, по-прежнему, как бывало.",
      "target_id": "ru-id01557",
      "tag": "p",
      "target_sha256": "d1268b12f967cbe22b4fe7bd2a7de463545e1c163193d8cd2186ceddaf46f112"
    },
    {
      "source_id": "id01558",
      "source_sha256": "cbd7fc843608da6a8a488376e32ba794be816df39499f583a5779c0a8d7195c0",
      "target": "— Ах, чёрт! — сказал Портос.",
      "target_id": "ru-id01558",
      "tag": "p",
      "target_sha256": "af7b3a5069838b758120de9ef915638f406e2abbb1ca54a0b3decf0cee88ea87"
    },
    {
      "source_id": "id01559",
      "source_sha256": "a6e125620bfe3736e765bbc50f86489053ebc932c448c46de0c9c9e2a166f60a",
      "target": "— Да, я понимаю, вы избаловались, дорогой друг; у вас вырос живот, и запястье уже не так упруго, как в те времена, когда гвардейцы господина кардинала имели столько тому доказательств.",
      "target_id": "ru-id01559",
      "tag": "p",
      "target_sha256": "e38b675c4d98f8ce527430383f8635d48376f7197865cdb3b8050b1d9daf4191"
    },
    {
      "source_id": "id01560",
      "source_sha256": "35e046d95e60af852f75a736095262956a34f3b3040bfb97047ec141cc2d0ea8",
      "target": "— Ах, запястье ещё хорошо, клянусь вам, — сказал Портос, протягивая руку, похожую на баранью лопатку.",
      "target_id": "ru-id01560",
      "tag": "p",
      "target_sha256": "eca34656c125ab3c5395dda1d02f42200fd8c9d346feb2c18326ea7e4de37aff"
    },
    {
      "source_id": "id01561",
      "source_sha256": "9cfd58f84d591b5b810fc833092da3bd49a791a1ea4c46be476cf4206f56c4fa",
      "target": "— Тем лучше.",
      "target_id": "ru-id01561",
      "tag": "p",
      "target_sha256": "534e38a9d119c9d14dbcbbf50471d35173c7d9afc57babdacde6dc4ef7e9edbe"
    },
    {
      "source_id": "id01562",
      "source_sha256": "7a08487687f8195668d5404b73dffa23f0e1a4615907448fc03ac2ea3fc36642",
      "target": "— Значит, нам предстоит воевать?",
      "target_id": "ru-id01562",
      "tag": "p",
      "target_sha256": "f6f8fcbda723afc7e9b0469e6e1b88f5bac99cb83aebafceb18f2230128704ed"
    },
    {
      "source_id": "id01563",
      "source_sha256": "abae13a26dead6ea7505fa59ce498c4fdf747b9962c24c4573c31c9cfbbe089a",
      "target": "— Ну да, Боже мой!",
      "target_id": "ru-id01563",
      "tag": "p",
      "target_sha256": "4a64eb3a282731db411e63493b289a5d2e0f514a1c74de5aec36e4753fad9516"
    },
    {
      "source_id": "id01564",
      "source_sha256": "f9b98b2bc46e4387ffae96ab4c9129cd29a86ab669e4410763bb5398260dc7c9",
      "target": "— А против кого?",
      "target_id": "ru-id01564",
      "tag": "p",
      "target_sha256": "9357718f194c133ca5511e7b094c5dfd28319abfd65078ffad377a1ade130f8c"
    },
    {
      "source_id": "id01565",
      "source_sha256": "0e7fde437300ab3090e5f30d69264d86e25493c0ebe24bd04b18fa82d3632544",
      "target": "— Вы следили за политикой, друг мой?",
      "target_id": "ru-id01565",
      "tag": "p",
      "target_sha256": "614f609c3c77bbcec016f925594bc116879006217d4bbaa24b48b4d11ca0877f"
    },
    {
      "source_id": "id01566",
      "source_sha256": "05084e677b085a972b93b45e13733338a59047b35af0aac35c4298650d36f312",
      "target": "— Я? Нисколько.",
      "target_id": "ru-id01566",
      "tag": "p",
      "target_sha256": "41e00606962f574b62fcef39a52c6085cb0d091799aeca392da35d0be2dc16f7"
    },
    {
      "source_id": "id01567",
      "source_sha256": "02399352ac086a740526d4eacdbef1207674be91d0937743351a1cc596d49a7b",
      "target": "— Тогда вы за Мазарини или за принцев?",
      "target_id": "ru-id01567",
      "tag": "p",
      "target_sha256": "dc011a7e426e724d194052a9e4738a6d1acb3424101ea88e7777fe5b1e5981e4"
    },
    {
      "source_id": "id01568",
      "source_sha256": "4d745a0cad13acc3bca83c4fcd2640bb8cd15cb10a1b91c43d8f30182a760b32",
      "target": "— Я ни за кого.",
      "target_id": "ru-id01568",
      "tag": "p",
      "target_sha256": "f3eccf6f8af816d0a75f11fc738625673d677b8287efb3cee8b52dca6f5cb304"
    },
    {
      "source_id": "id01569",
      "source_sha256": "f0fd7aa7f89f2f47c7c90b41b45b71ac3fd1367714ab52333b11669a4683a40c",
      "target": "— То есть вы за нас. Тем лучше, Портос, это самое удобное положение, чтобы делать свои дела. Так вот, дорогой мой, скажу вам, что я приехал от имени кардинала.",
      "target_id": "ru-id01569",
      "tag": "p",
      "target_sha256": "7270cf3dbe47b8704bdc47cd4d0189691a2448963fbd084462c19b9fa527a532"
    },
    {
      "source_id": "id01570",
      "source_sha256": "6820fffee1f5c47c69ccd4ea97a8b26defc2176205aa40daa70e4604d6c789f3",
      "target": "Это слово произвело на Портоса своё действие, как если бы всё ещё шёл 1640 год и речь шла о настоящем кардинале.",
      "target_id": "ru-id01570",
      "tag": "p",
      "target_sha256": "e34478992ed66f13a5b1a757c554773c3818327c305975e4ca34c449f13833e2"
    },
    {
      "source_id": "id01571",
      "source_sha256": "7e848d995051a45d7c05347d9d162aec6381a8f26354d55701bb4a30bc935ba1",
      "target": "— О-о! — сказал он. — Чего же хочет от меня Его Высокопреосвященство?",
      "target_id": "ru-id01571",
      "tag": "p",
      "target_sha256": "15e4537db2138c5ae5b18019e327050b8f4fb8dd7679b59b746b20a604ff3e3f"
    },
    {
      "source_id": "id01572",
      "source_sha256": "ffd4502aad5d2c63b67b0886b7926ca555fcce9d95b75cf207e945cf0a671606",
      "target": "— Его Высокопреосвященство хочет взять вас к себе на службу.",
      "target_id": "ru-id01572",
      "tag": "p",
      "target_sha256": "0f157860e36817f0fa81737f33edc83a814c2aec29fc2651b809800d9c49b136"
    },
    {
      "source_id": "id01573",
      "source_sha256": "9128abf57c113a37d2cd6ba8aa0e1ae651e43c1bf2c126a0b2364453331599f3",
      "target": "— А кто ему обо мне говорил?",
      "target_id": "ru-id01573",
      "tag": "p",
      "target_sha256": "b74e61c836d06bb3b77177131e84508a2c035a56b23e80237b3314d408128f09"
    },
    {
      "source_id": "id01574",
      "source_sha256": "1c3f1e5123f0b8f5c54cd1752cffd546bc000b7f80955667d6263d26251aeaa0",
      "target": "— Рошфор. Помните?",
      "target_id": "ru-id01574",
      "tag": "p",
      "target_sha256": "92e86f33f6e190054809f8a4844283347c76675dfab19d5620885c1490668e5e"
    }
  ],
