{
  "unit": 82,
  "batch": 7,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id10923",
      "target": "— Ну что, получили вы какие-нибудь вести? — спросил Атос.",
      "source_sha256": "d2ec136cf695b7eadafd8014122db0803cf369f8713a9bd0ab2814e156367754",
      "target_id": "ru-id10923",
      "tag": "p",
      "target_sha256": "f57943b803064e118dcd7448ae9ac8e126ac1be48fee7c682e94d24316ad0e2c"
    },
    {
      "source_id": "id10924",
      "target": "— Никаких; д’Артаньяна нигде не видели, а Портос ещё не появлялся. А у вас?",
      "source_sha256": "8564cddbb5756e72b632f3a734279fb1b11f27243779c680ea5c76bfa59e23de",
      "target_id": "ru-id10924",
      "tag": "p",
      "target_sha256": "51d800aaec09dc20bb1dfad78dd56bf97f6b401b90fe5b9559785ac587af630c"
    },
    {
      "source_id": "id10925",
      "target": "— Ничего.",
      "source_sha256": "b4dec4a3bdd364779d049eeafa00a836ee8029b5e7fd03b66c993f103d88a8d3",
      "target_id": "ru-id10925",
      "tag": "p",
      "target_sha256": "e3f85c1871f46242f187941d0f81f1c56fd3606d90062b2bf53412b1fd13d61d"
    },
    {
      "source_id": "id10926",
      "target": "— Чёрт возьми! — сказал Арамис.",
      "source_sha256": "91755928ff4121e394d0e10f96706fea5227fb080865128b7c24e94dfd5a6f41",
      "target_id": "ru-id10926",
      "tag": "p",
      "target_sha256": "9b991bd29658579578aa57938de0aba19eabd7b717cd5feb5aadd6c693f17815"
    },
    {
      "source_id": "id10927",
      "target": "— В самом деле, — сказал Атос, — такая задержка неестественна: они поехали самой прямой дорогой, а потому должны были бы прибыть раньше нас.",
      "source_sha256": "b764d74366c4a7a403c5d67d9b65c9b448270321e0bcde002e02896a2b0d2cb7",
      "target_id": "ru-id10927",
      "tag": "p",
      "target_sha256": "069abc02728fb6be6d63eb5a97b4e4cc30f2add55c60000aa9354f1dbd869030"
    },
    {
      "source_id": "id10928",
      "target": "— Прибавьте к этому, — сказал Арамис, — что мы знаем д’Артаньяна как человека стремительных действий, и он не из тех, кто потерял бы хоть час, зная, что мы его ждём…",
      "source_sha256": "b0e240153e6aaf77f3a587a231761b31a670c8ecca73a0821a1164780a7457ae",
      "target_id": "ru-id10928",
      "tag": "p",
      "target_sha256": "4fae9c858acee43dd44d9cfde76c64caeb9472a9ab476966dd087565cb4f04e9"
    },
    {
      "source_id": "id10929",
      "target": "— Он рассчитывал, если вы помните, быть здесь пятого.",
      "source_sha256": "fde445ee47a627d8d2504723cd05d9954b9b3f893d92adbd5a1430eae97d59e6",
      "target_id": "ru-id10929",
      "tag": "p",
      "target_sha256": "cd32fab2a0ff463262bdc48efcb557c2b42bc0d1f5fbc8b8a37c1ac45f70078d"
    },
    {
      "source_id": "id10930",
      "target": "— А теперь уже девятое. Срок истекает сегодня вечером.",
      "source_sha256": "dcd213925af335126c534ef8a8fef8e01011a3c42f0686eb0514d2a169dfd9fa",
      "target_id": "ru-id10930",
      "tag": "p",
      "target_sha256": "9a92d4a86eb055f6f0e826c597d6658bebde4b155620ebe4892808abdf91d567"
    },
    {
      "source_id": "id10931",
      "target": "— Что вы намерены делать, — спросил Атос, — если сегодня вечером у нас не будет известий?",
      "source_sha256": "baf8a7bb6a907c4f818b60f200e5e21053c5004f6bc484415ac461458b9e7f85",
      "target_id": "ru-id10931",
      "tag": "p",
      "target_sha256": "465facb97adffa535407ef6a2d172c89329ddae3c58aa77fb57daade33c17724"
    },
    {
      "source_id": "id10932",
      "target": "— Ей-богу, пуститься на его поиски!",
      "source_sha256": "f505d413b014746e36776dd01ad4375d4bac8a22c62ef23ff2f04b9fd581e137",
      "target_id": "ru-id10932",
      "tag": "p",
      "target_sha256": "86f460bdf914f8703fd911ea23c5d595405c1fa531e42613a28aafbe9a275b9f"
    },
    {
      "source_id": "id10933",
      "target": "— Хорошо, — сказал Атос.",
      "source_sha256": "4d30d09958b909765f659ad93387292ac290f37d4328b3537ac80290eef8a3d9",
      "target_id": "ru-id10933",
      "tag": "p",
      "target_sha256": "805017750781f1d264e3f2c3e680260c2406634530fbe57b8d41861b2e7c1b67"
    },
    {
      "source_id": "id10934",
      "target": "— А Рауль? — спросил Арамис.",
      "source_sha256": "c79e72c60ca4f754fa1331bfe6691035a0f012907c5f39dd37aa9275213950c0",
      "target_id": "ru-id10934",
      "tag": "p",
      "target_sha256": "b8b763954c9630e51dd18a053859b7d9091d8c0db8fd93116e5fd27700d0e95d"
    },
    {
      "source_id": "id10935",
      "target": "На чело графа набежало лёгкое облачко.",
      "source_sha256": "455fa4c7ff188ce5e8d0666799279988a2cdcf464e8ea1c0e9c7644dc7081318",
      "target_id": "ru-id10935",
      "tag": "p",
      "target_sha256": "fa19a12c11c73b1471c2ed45064e17e0ed7a97f3be1bc0997853d63e1c280f89"
    },
    {
      "source_id": "id10936",
      "target": "— Рауль внушает мне большое беспокойство, — сказал он. — Вчера он получил послание от принца Конде, отправился к нему в Сен-Клу и не вернулся.",
      "source_sha256": "59d47e9a563a9f872dc16d19cc2d4fa6d943015f2db5d3ad3c7b817e43530b51",
      "target_id": "ru-id10936",
      "tag": "p",
      "target_sha256": "a5bc40ac1fbdc629cf412912e77382f82f762138f9a01bd2c93a68a05a67f820"
    },
    {
      "source_id": "id10937",
      "target": "— Вы не видели госпожу де Шеврёз?",
      "source_sha256": "6dc5d306df82a5f0f79c3a67778545de3bb54f62cceee210cf0fd0099e212f0c",
      "target_id": "ru-id10937",
      "tag": "p",
      "target_sha256": "268e84cb90f90e21707c507528fff0a0b9eacb5806dc35bf0ba04aca9eed3e8b"
    },
    {
      "source_id": "id10938",
      "target": "— Её не было дома. А вы, Арамис, кажется, собирались зайти к госпоже де Лонгвиль?",
      "source_sha256": "9c5ea803aa864de340cdd12e7061e4dc855c08228212952536b3f6c7da770d2f",
      "target_id": "ru-id10938",
      "tag": "p",
      "target_sha256": "1fae5addfc2beff2e839341b57654c4d033a71c6de83d6a12b23012366326061"
    },
    {
      "source_id": "id10939",
      "target": "— Я действительно заходил.",
      "source_sha256": "4cba0af8a59b85cf5f6ba9c65617a545dfa96ab6184d43b130a3c02eaebbf651",
      "target_id": "ru-id10939",
      "tag": "p",
      "target_sha256": "f2c61f89442e060fa8502b9a2959740e4ea835c316728239228ea089dd9de80a"
    },
    {
      "source_id": "id10940",
      "target": "— Ну и что?",
      "source_sha256": "2caed6e1ccb03a9e5b3191e4e09dc771bdcca703c589c4b9b2a520a990a050f0",
      "target_id": "ru-id10940",
      "tag": "p",
      "target_sha256": "c3c7c847be433d2b02af850bdfcfd0e3734a843506123820fd38a33c0d05ab04"
    },
    {
      "source_id": "id10941",
      "target": "— Её тоже не было дома, но она хотя бы оставила адрес своей новой квартиры.",
      "source_sha256": "9d783996fd3f317a31fd8f666b9b4bd90d53732e196f1db397c4b479fa5c0d08",
      "target_id": "ru-id10941",
      "tag": "p",
      "target_sha256": "c3ad3fafa166234e8256db5069300dd4cadef2781593777bdf1f34c02d50ef48"
    },
    {
      "source_id": "id10942",
      "target": "— Где же она была?",
      "source_sha256": "b894e2bdf699ec1662e04b231b340ca01010e08eae286597779ae7bfb3bed9f1",
      "target_id": "ru-id10942",
      "tag": "p",
      "target_sha256": "be4783e5eede77e4f6b338f16cec6d9e04d4516bec57341b35023e4fccc2cac5"
    }
  ],
