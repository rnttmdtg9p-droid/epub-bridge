{
  "unit": 28,
  "batch": 8,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id03813",
      "target": "— Господин граф де Ла Фер.",
      "source_sha256": "9c83d425d76be21148233627d5776327ec05d9f1b9921d0f32e8e705d5abebdb",
      "target_id": "ru-id03813",
      "tag": "p",
      "target_sha256": "2cda2ef0faed2e0defd2005ecbb3061589ff8a4f5f5fea2781afbc4f10b6ad15"
    },
    {
      "source_id": "id03814",
      "target": "— Атос, Атос, — пробормотал д’Артаньян, — вы думаете обо всём и вы воистину дворянин.",
      "source_sha256": "196d89b7eae0a949bf33a6eeb0b67dda316a83bf1ebcb45da5997c5f4bf11092",
      "target_id": "ru-id03814",
      "tag": "p",
      "target_sha256": "7d52fd06cc43179616fad7cf23ef9b1c7900be09aedb57cbd2cd84c2d095c30f"
    },
    {
      "source_id": "id03815",
      "target": "— Вот и славно! — сказал Портос. — А я уж боялся, что придётся совершать переход пешком.",
      "source_sha256": "487f1b5a365a01da538055bce8a3f51d0e103b7452ca214bc548f6820b4a054b",
      "target_id": "ru-id03815",
      "tag": "p",
      "target_sha256": "dd7841feeabe27d02a462d2f1c267b19ecbf1ffc4da57dd9d22d73781250786b"
    },
    {
      "source_id": "id03816",
      "target": "И он сел в седло. Д’Артаньян был уже в седле.",
      "source_sha256": "2db604bbb128d43dbbda1515369293d52989e5b62b2dffc20e0f881f6f384965",
      "target_id": "ru-id03816",
      "tag": "p",
      "target_sha256": "67d780098cafaf3cfc8de8ee8b05a1923543ed2e46ad0d2a2a1ddc5c8cdec491"
    },
    {
      "source_id": "id03817",
      "target": "— Что же это, Гримо, куда ты? — спросил д’Артаньян. — Ты покидаешь своего господина?",
      "source_sha256": "952a72bf32c14b9c30c0abcf569b6da63c52d53d227c62bf5d596a2f4be8f27b",
      "target_id": "ru-id03817",
      "tag": "p",
      "target_sha256": "1c08a412026c74dccaa8ac6ef108f30a7f22c1b540849c1d9f1af8811c9bf1a7"
    },
    {
      "source_id": "id03818",
      "target": "— Да, — ответил Гримо, — я еду к виконту де Бражелону во Фландрскую армию.",
      "source_sha256": "419e4919725791b79737a2f5b407500ba34224ac00b5c8483df1a9f0b5281e04",
      "target_id": "ru-id03818",
      "tag": "p",
      "target_sha256": "539ea16141fcfadb413de87dfe5854afe6461fbe478ac3cc8b3cc9d450bfb5f2"
    },
    {
      "source_id": "id03819",
      "target": "Они затем молча проехали несколько шагов по большой дороге в сторону Парижа, но вдруг услышали стоны, которые, казалось, доносились из канавы.",
      "source_sha256": "11868fe35ce6fc7ed19b72e9c421ecdf4405b414227c8df18385f43ebd0bf184",
      "target_id": "ru-id03819",
      "tag": "p",
      "target_sha256": "2de1a0b060cd0576b75a4e9caac5e719d68e0145b1e521b13cbbdc97116bf5b4"
    },
    {
      "source_id": "id03820",
      "target": "— Что это? — спросил д’Артаньян.",
      "source_sha256": "e16811827d975bbbfa4880bde1a93fff7e91062cf232b984200d864cdbb6db88",
      "target_id": "ru-id03820",
      "tag": "p",
      "target_sha256": "337156d5cc6bfa7b46ac3d844293ca513645e69f2834e9d9cb951c8fe9332af7"
    },
    {
      "source_id": "id03821",
      "target": "— Это, — сказал Портос, — Мушкетон.",
      "source_sha256": "4d5c98e0e429b41b51ed38c81ee8259b9dcdbf8b1ae897b531e0f356d8d037a1",
      "target_id": "ru-id03821",
      "tag": "p",
      "target_sha256": "391837281a30903a10cab77833b9af900e08563b7dd51b78533d326600217885"
    },
    {
      "source_id": "id03822",
      "target": "— Ах, да, сударь, это я, — произнёс жалобный голос, и на откосе дороги поднялась какая-то тень.",
      "source_sha256": "41decb2614ee5dc945590a9b160de6a6fac0ce648ffa7473309b53bc547c6d48",
      "target_id": "ru-id03822",
      "tag": "p",
      "target_sha256": "89a1d82b286749b59f0a124259f68bb867e94d66bc858aef8518b49222df4216"
    },
    {
      "source_id": "id03823",
      "target": "Портос бросился к своему управляющему, к которому он был искренне привязан.",
      "source_sha256": "a0f64ee696966aea41644ac23c85100691ed33e1ba8ab36d999e66825401389c",
      "target_id": "ru-id03823",
      "tag": "p",
      "target_sha256": "e863350f3f0c5794192c425e45c8d57325eca3c13f46b83e4708f159360ef36c"
    },
    {
      "source_id": "id03824",
      "target": "— Неужто ты опасно ранен, мой милый Мустон? — спросил он.",
      "source_sha256": "19c56c24d098ade6f8cfd8a813d2ac391b8112bb278f7037661760db26fb9293",
      "target_id": "ru-id03824",
      "tag": "p",
      "target_sha256": "01acb429c25d052a139bfc9125ce5ab26c8652367cbe97c5e5ecafffe2f1cf74"
    },
    {
      "source_id": "id03825",
      "target": "— Мустон! — повторил Гримо, широко раскрыв изумлённые глаза.",
      "source_sha256": "369d0a577698337ca4968a722266836b393e0a416853a8cd4e193d8ab68e08b5",
      "target_id": "ru-id03825",
      "tag": "p",
      "target_sha256": "a7dcf78234fdc0bf5d4cf352850dc136dcf1edfb0b2bf4d038cc4c08dcd9bb13"
    },
    {
      "source_id": "id03826",
      "target": "— Нет, сударь, не думаю; но я ранен весьма неудобным образом.",
      "source_sha256": "bf8462e48ee2288b6194db76413d856963a390985d1f84e1b4f34688d6aba150",
      "target_id": "ru-id03826",
      "tag": "p",
      "target_sha256": "e5eb47ff9befe1baae3f183e7e62e4c8fc73771d64824b466a22628dfde841f2"
    },
    {
      "source_id": "id03827",
      "target": "— Значит, ты не можешь ехать верхом?",
      "source_sha256": "1d1b7bf31923adfb3602c2abe2c5192bc36770674dfc0be3350a65e5450c30ad",
      "target_id": "ru-id03827",
      "tag": "p",
      "target_sha256": "fc777f1d661243336213d7d38da7d7bb9642a0cab0cf998b8bc7c9eaf8490b9e"
    },
    {
      "source_id": "id03828",
      "target": "— Ах, сударь, что вы мне предлагаете!",
      "source_sha256": "844712254fdfdfc21d193bf59b79273acd4b5f31740c649d6312c9fd2a114426",
      "target_id": "ru-id03828",
      "tag": "p",
      "target_sha256": "fc4c0a90a9eae780a1114b0cd8534b5c2d5a4e1907ea694455c08442fb868809"
    },
    {
      "source_id": "id03829",
      "target": "— А пешком идти можешь?",
      "source_sha256": "3bddd6711e1a87f488a3ca2b409ba2bb7a4adb33cea9958348f1c261d2e21f5c",
      "target_id": "ru-id03829",
      "tag": "p",
      "target_sha256": "2548c75fc04637ab465070fbff0df213bdb5fd5ddefcd0cb7a6e4650c3628bcb"
    },
    {
      "source_id": "id03830",
      "target": "— Постараюсь, до первого дома.",
      "source_sha256": "3fc3a6db1be27d793bab4dbadb6804ea38e4b29bf9445ec8a820fc0f4a867aed",
      "target_id": "ru-id03830",
      "tag": "p",
      "target_sha256": "cb7cb73bc6b146f4ea7be6d82d48098c5f2170ced527cd689ad57027daed98b2"
    },
    {
      "source_id": "id03831",
      "target": "— Как же быть? — сказал д’Артаньян. — А нам всё-таки надо возвращаться в Париж.",
      "source_sha256": "af4610f14480ae681dc2229e6ec98c4a6aa57a21b80ecd9bffc6f8a75c6944dc",
      "target_id": "ru-id03831",
      "tag": "p",
      "target_sha256": "6256119062a8876992cf98602122c3ec7fef8940c5aae03ce144aea9247ddd01"
    },
    {
      "source_id": "id03832",
      "target": "— Я беру Мушкетона на себя, — сказал Гримо.",
      "source_sha256": "74bcae334ec67199a066a79cf3c5bc3cfd8013f7b506d11b8b4337f4955da45e",
      "target_id": "ru-id03832",
      "tag": "p",
      "target_sha256": "1b033028cca7469e12abde9e04fbebdc25f59745d7669a8d2955084c3b93a5d4"
    }
  ],
