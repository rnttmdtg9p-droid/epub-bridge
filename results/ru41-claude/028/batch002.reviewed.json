{
  "unit": 28,
  "batch": 2,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id03693",
      "target": "— Как же, чёрт возьми, у тебя оказалось две заводные лошади? — спросил д’Артаньян, вскакивая на одну из них.",
      "source_sha256": "6c1eed5bd7668178b7f30281b93227fbcb06788deb7951770bbadef30e92e7dd",
      "target_id": "ru-id03693",
      "tag": "p",
      "target_sha256": "150e6873dbdbe5cb1bd4522273664d7b6f46ffd6417e286187c62786358a47be"
    },
    {
      "source_id": "id03694",
      "target": "— Их хозяева мертвы; я подумал, что лошади могут нам пригодиться, и взял их.",
      "source_sha256": "91690284c4fc62ab2319995284bfad78c5db39256793fed4ed67552e98cc9d98",
      "target_id": "ru-id03694",
      "tag": "p",
      "target_sha256": "30ed8f053d9d72be5461e69a5b7ddfec48879c5010e42ad4debbec94ce0f144b"
    },
    {
      "source_id": "id03695",
      "target": "Тем временем Портос перезарядил свой пистолет.",
      "source_sha256": "ce20da670e2849c2837b9124fd12132a90edf77758acec106b6caacdcbf7c524",
      "target_id": "ru-id03695",
      "tag": "p",
      "target_sha256": "78f463653689db0224f104d0e816a7d818f5b29daedca5277dbf36686f6769b9"
    },
    {
      "source_id": "id03696",
      "target": "— Берегись! — сказал д’Артаньян. — Вот ещё двое.",
      "source_sha256": "d0465e52f43e97e0754363fd6d899bac180758a1b867b14f2f3d8172b0c5b82a",
      "target_id": "ru-id03696",
      "tag": "p",
      "target_sha256": "a2e59607129a28fe92e0c3d2195d92aaf46f9651a7357596d5633c94118eba40"
    },
    {
      "source_id": "id03697",
      "target": "— Ну и ну! Так их, выходит, будет хватать до самого завтра! — сказал Портос.",
      "source_sha256": "38c29302b410528982490037e8c076ee88c962cab5464bc2c777bb2e5a58f90e",
      "target_id": "ru-id03697",
      "tag": "p",
      "target_sha256": "e5b7f2213e2558007e55e847153874f219a0b1fbcaf3236e8c2bbd69e3a8d281"
    },
    {
      "source_id": "id03698",
      "target": "И в самом деле, быстро приближались ещё двое всадников.",
      "source_sha256": "75aa82aac8f041fcb410cfe243259ff3d13249bfc0d9532770b33e6846e1054f",
      "target_id": "ru-id03698",
      "tag": "p",
      "target_sha256": "359b1c155528e30942537ea9dcf6763b48f3abe0b168f842a7823d9b6ee6caf7"
    },
    {
      "source_id": "id03699",
      "target": "— Эй, сударь! — сказал Мушкетон. — Тот, которого вы сбили с коня, поднимается.",
      "source_sha256": "26a6936eb14b51a113b9f1170f348bb54f909e77c2f115ede6c0f11ccdfdfec4",
      "target_id": "ru-id03699",
      "tag": "p",
      "target_sha256": "2b4a278ab9820acdc8ebd6682e54df88fd2066ee98604f38bc204c71316fb8c9"
    },
    {
      "source_id": "id03700",
      "target": "— Почему же ты не поступил с ним так же, как с первым?",
      "source_sha256": "929dfa322b63f8f939b1a54b713623f2887fa0a7fc6d260aaac43f8572e69f88",
      "target_id": "ru-id03700",
      "tag": "p",
      "target_sha256": "bfbc582c4e7012c9dd37852746b85e170de841cca54219789d0890c345d6b9df"
    },
    {
      "source_id": "id03701",
      "target": "— Мне было несподручно, сударь, я держал лошадей.",
      "source_sha256": "6a45f593a7e2811031ec1be6fbc1a5f803c5fa7939ab32ada2829c509b07ed77",
      "target_id": "ru-id03701",
      "tag": "p",
      "target_sha256": "bf80fa871e5545be0b48e23248f1128bacc1888ee6a246771627b3e44b167661"
    },
    {
      "source_id": "id03702",
      "target": "Грянул выстрел, и Мушкетон вскрикнул от боли.",
      "source_sha256": "43289a827b733e2b37de37423ec5258f6e7a839dc74ab77735e54d6349e601ef",
      "target_id": "ru-id03702",
      "tag": "p",
      "target_sha256": "d1acf56a1499a59d5a76e478346a68c9d46f496f1ab910ec034293cbc99446a4"
    },
    {
      "source_id": "id03703",
      "target": "— Ах, сударь! — закричал он. — В другое! Прямо в другое! Этот выстрел будет парой тому, что на амьенской дороге.",
      "source_sha256": "f556f7b89e6462dbb8f1b16cdb8e58333980da40cad0b7278c032e731cb494c2",
      "target_id": "ru-id03703",
      "tag": "p",
      "target_sha256": "bd735cc6c574568dbba0cc8330ee029a480aa45632136aaffe11fffbcf342fe8"
    },
    {
      "source_id": "id03704",
      "target": "Портос повернулся, как лев, и бросился на спешенного всадника; тот попытался выхватить шпагу, но прежде чем она вышла из ножен, Портос эфесом своей нанёс ему по голове такой страшный удар, что тот рухнул, как бык под обухом мясника.",
      "source_sha256": "22f779092b5255e7c29fdfd5cd6268fadccbebd5fbb89bea8153a3bf26a7d80a",
      "target_id": "ru-id03704",
      "tag": "p",
      "target_sha256": "22340c2b711b434ee453a3f8bfa7576f80f2bdd9523753b68c7579201293ce8f"
    },
    {
      "source_id": "id03705",
      "target": "Мушкетон, продолжая стонать, соскользнул вдоль бока своей лошади: полученная им рана не позволяла ему держаться в седле.",
      "source_sha256": "f9084e8663cef4d850ffa6c69dd11da33a9e18e60566dbe68603f0ed105608dd",
      "target_id": "ru-id03705",
      "tag": "p",
      "target_sha256": "acc35a5d5fddb9478a13915f75a70577a89f5c511174271756b96cce690e3bb7"
    },
    {
      "source_id": "id03706",
      "target": "Завидев всадников, д’Артаньян остановился и перезарядил пистолет; к тому же у его новой лошади к луке седла был приторочен карабин.",
      "source_sha256": "800ced03cb4df67e97c6517739bee53613086ec021cebdc20826a1d80a892244",
      "target_id": "ru-id03706",
      "tag": "p",
      "target_sha256": "70c12441ac7f292b29c69905b2834abaf38e732996282246cfe4dec5ca0829a9"
    },
    {
      "source_id": "id03707",
      "target": "— Вот и я! — сказал Портос. — Станем ждать их или нападём?",
      "source_sha256": "57fa172311de40039444b6300551395af72f381fcff1b425be3966196f05406e",
      "target_id": "ru-id03707",
      "tag": "p",
      "target_sha256": "6179366887f34b14f86687608243891af92a85478b0d361364ceb56e81e81d69"
    },
    {
      "source_id": "id03708",
      "target": "— Нападём, — сказал д’Артаньян.",
      "source_sha256": "e076447d76891ce623d3f4ebd094e773b1fba02a7cd252fd9ee6d710d243f6f4",
      "target_id": "ru-id03708",
      "tag": "p",
      "target_sha256": "b8961ed41a1613f7dee953d22719469d93a2cf57f669f207c8935e62a9205d19"
    },
    {
      "source_id": "id03709",
      "target": "— Нападём, — сказал Портос.",
      "source_sha256": "738e24ce72c346e5cebf17c2a21cdd8d731d0524aff4544bf1e6ddcf91bce5fa",
      "target_id": "ru-id03709",
      "tag": "p",
      "target_sha256": "7b5680e903b487bd8db2a14103c8b32d92b0a05b115971649832971dd3cbd0d0"
    },
    {
      "source_id": "id03710",
      "target": "Они вонзили шпоры в бока своих лошадей.",
      "source_sha256": "30c4abca3545fd10d91e1a26644dc16753afb29fc78fdb2642b9c149ce9168ad",
      "target_id": "ru-id03710",
      "tag": "p",
      "target_sha256": "70d2f5ab406446ba5f94df530d926157786d9152ad81b6842c71fb36f698c862"
    },
    {
      "source_id": "id03711",
      "target": "Всадники были уже не далее чем в двадцати шагах от них.",
      "source_sha256": "05d11134fbc8062ca06cf7ff587a7ed75246b3533865925c1788e5af5a8b0d27",
      "target_id": "ru-id03711",
      "tag": "p",
      "target_sha256": "feda0326c7c7f683d851d145711d7755133452cc5355ddd30ef8d1e5d7599b88"
    },
    {
      "source_id": "id03712",
      "target": "— Именем короля! — крикнул д’Артаньян. — Дайте нам проехать.",
      "source_sha256": "79f372e334333d02dbaedca5b953fc52dbf13222e4aa9e218576d7d1b260e576",
      "target_id": "ru-id03712",
      "tag": "p",
      "target_sha256": "0c46abf51354e09986a10d723b490b8b3b19a952e525a0fe3ebadaa355623a8a"
    }
  ],
