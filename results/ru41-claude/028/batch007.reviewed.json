{
  "unit": 28,
  "batch": 7,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id03793",
      "target": "— В котором часу?",
      "source_sha256": "6faa618e65fa36cd6f5ac59abfccc86602b36f6a83d72b83d53debef0a94dbce",
      "target_id": "ru-id03793",
      "tag": "p",
      "target_sha256": "b37c1eae5fed732d479a002241560a7d07735da1b7011251d5712fdbe581d4f3"
    },
    {
      "source_id": "id03794",
      "target": "— В десять часов ночи, вас это устроит?",
      "source_sha256": "29c2c5d79b34cf15310533afe6837b9bde18d930c347f5373af9ea9fee3d1eb1",
      "target_id": "ru-id03794",
      "tag": "p",
      "target_sha256": "b46e38c2769ea98fc34eb097c3287690258ff1924e0450a07e5167822999e8f8"
    },
    {
      "source_id": "id03795",
      "target": "— Превосходно.",
      "source_sha256": "c1a90bbb8bff86446a0b8b3c63d56cf872ebd58a9f6c528ed1b47e037d3b3cda",
      "target_id": "ru-id03795",
      "tag": "p",
      "target_sha256": "4b11a5f9d4c5b936af54475d6db3f69f14198dc61e23ef410196a2186e6b6aef"
    },
    {
      "source_id": "id03796",
      "target": "— Из этого, — сказал Атос, — родится мир или война, но наша честь, друзья, по крайней мере, будет спасена.",
      "source_sha256": "742ddf0f24b772e85fe547f98dcd888aed810c1ae6867d306aa01973dec16596",
      "target_id": "ru-id03796",
      "tag": "p",
      "target_sha256": "18edf1f5013b75474c36aaf34c272c5af24c59c20ccf1eaeeb8483c51803d9fa"
    },
    {
      "source_id": "id03797",
      "target": "— Увы! — пробормотал д’Артаньян. — Наша солдатская честь для нас потеряна.",
      "source_sha256": "0373c87699b95ffc82e3c172a339e612951bd3e869eae0afc55773970e901d53",
      "target_id": "ru-id03797",
      "tag": "p",
      "target_sha256": "600759dd8d464eda7fc777f6c46b0af8be7426ac68b9333984d94118d990af19"
    },
    {
      "source_id": "id03798",
      "target": "— Д’Артаньян, — серьёзно сказал Атос, — клянусь вам, мне больно, что вы думаете об этом, когда я думаю лишь об одном: о том, что мы скрестили шпаги друг против друга. Да, — продолжал он, горестно качая головой, — да, вы это сказали: несчастье тяготеет над нами; идёмте, Арамис.",
      "source_sha256": "0692ddd103134fc486e06a18b12f5327f6fc884623c6bb0d0fe13ec70924dcf2",
      "target_id": "ru-id03798",
      "tag": "p",
      "target_sha256": "3bb5d89c8e47afe48a40a7eb37bd2f34037090e589a0035c6e29a7332377efc3"
    },
    {
      "source_id": "id03799",
      "target": "— А мы, Портос, — сказал д’Артаньян, — вернёмся и отнесём наш позор кардиналу.",
      "source_sha256": "771a77d5a6bccbf1599c215b80a5a053be1f021e1a63e3e53ce518bea90ee36d",
      "target_id": "ru-id03799",
      "tag": "p",
      "target_sha256": "dec4ec82ec82a1128f8788ea6759307b477d2a4e4280060f241bac7ff05b1fb5"
    },
    {
      "source_id": "id03800",
      "target": "— И скажите ему главное, — крикнул чей-то голос, — что я не слишком стар для человека действия.",
      "source_sha256": "1f3d95b358dc755aee6ebbbea10b1aabe6dfc2ec5f1805e0f14fa2e9e2b635be",
      "target_id": "ru-id03800",
      "tag": "p",
      "target_sha256": "6126f0f8a8d25a55e48002a7a0d887950265802aa8d3c44854e54f96c6d45910"
    },
    {
      "source_id": "id03801",
      "target": "Д’Артаньян узнал голос Рошфора.",
      "source_sha256": "4b8f6db5351cbe9602ce39d31c2d0805c0a4f6ca66a33020a1d536dd62d82c2b",
      "target_id": "ru-id03801",
      "tag": "p",
      "target_sha256": "5286f9f8a8accc76df877e756e765d813bfd3360121d6602612bf5f81f25f248"
    },
    {
      "source_id": "id03802",
      "target": "— Могу ли я что-нибудь сделать для вас, господа? — спросил принц.",
      "source_sha256": "e074e7940a8f98fe810790be61b4c9500f97a3f6bc42e5add9cb91c7543b664d",
      "target_id": "ru-id03802",
      "tag": "p",
      "target_sha256": "10ccc0ad59402f4213acb70ade53f0e896fb8eefe16c163a935eafe8fecaad4e"
    },
    {
      "source_id": "id03803",
      "target": "— Засвидетельствовать, что мы сделали всё, что могли, монсеньор.",
      "source_sha256": "e4d031a84669d49ea0ab913ca4a350270bce746d04970c099292a4dcc6a30bc5",
      "target_id": "ru-id03803",
      "tag": "p",
      "target_sha256": "2db2e6acaefe4343ef3f9f02a9bf56910cfc725cb3cd60d90f1c0a7c1df3a215"
    },
    {
      "source_id": "id03804",
      "target": "— Будьте покойны, это будет сделано. Прощайте, господа; через некоторое время мы увидимся снова, надеюсь, под Парижем, а быть может, и в самом Париже, и тогда вы сможете взять реванш.",
      "source_sha256": "20478501134b7615b05c17466bc0556c83cf83b92528d5a6cdc429e7ecb66676",
      "target_id": "ru-id03804",
      "tag": "p",
      "target_sha256": "3253b400db6c9537f516bd4fe970dbbea538996ad99eb58389b180d255275081"
    },
    {
      "source_id": "id03805",
      "target": "С этими словами герцог приветственно махнул рукой, снова пустил коня в галоп и исчез, сопровождаемый своим эскортом, который скрылся из глаз во мраке, а шум его растаял в пространстве.",
      "source_sha256": "325e0fe960e7a4d4460c6d66289d1933790489f46ae514c558d108413c4cda47",
      "target_id": "ru-id03805",
      "tag": "p",
      "target_sha256": "2c25e6924edc8b8eca079202ea3b744f5234ab57b7d92f721e9dd11e703326d3"
    },
    {
      "source_id": "id03806",
      "target": "Д’Артаньян и Портос остались одни на большой дороге с человеком, державшим двух заводных лошадей.",
      "source_sha256": "9a1c180e784077a8230fdb481169660cc5940a399e39af8851ac0d69a18ce9e9",
      "target_id": "ru-id03806",
      "tag": "p",
      "target_sha256": "7b9f5051c5d50be5c1b5bc1d4ccffd00ddd686fd97f1ccbb0e06dfc429d16cd0"
    },
    {
      "source_id": "id03807",
      "target": "Они решили, что это Мушкетон, и подошли.",
      "source_sha256": "7a6d4f432aa4c54a1aa7468814d95d12560563c01548bb585d9229dbf73ba5c1",
      "target_id": "ru-id03807",
      "tag": "p",
      "target_sha256": "1b2c8dabab1fedc34432340395b79b5e663477dc0d7d2fc647799270b82e41a6"
    },
    {
      "source_id": "id03808",
      "target": "— Что я вижу! — воскликнул д’Артаньян. — Это ты, Гримо?",
      "source_sha256": "3d3dddca5c04e80a2d15cc20f2f051461ea595bed14491a8cc9db860025c089f",
      "target_id": "ru-id03808",
      "tag": "p",
      "target_sha256": "1d1bbd30eb916763ae526add892d3df36fce0b0f9ddc17cb32ba7d2ff2d912fa"
    },
    {
      "source_id": "id03809",
      "target": "— Гримо! — сказал Портос.",
      "source_sha256": "5e70411ab9dadd2019b991569d89e90a1f07eddc95342eb5371a9f9816b942de",
      "target_id": "ru-id03809",
      "tag": "p",
      "target_sha256": "bd5eee8f2ba085b8b6102803b6a7c01e7f6aad473c44142fe204f7d22badb861"
    },
    {
      "source_id": "id03810",
      "target": "Гримо знаком показал обоим друзьям, что они не ошиблись.",
      "source_sha256": "80ab94e57424a706abf83cfa17a48c0437b2d0cbfad81592b7452b2c3f81f919",
      "target_id": "ru-id03810",
      "tag": "p",
      "target_sha256": "d99e68c53f3fc2bf9536c8bb2dbb50011780d07fa4afde5d9e35657ced1dce8f"
    },
    {
      "source_id": "id03811",
      "target": "— А чьи это лошади? — спросил д’Артаньян.",
      "source_sha256": "c97930295dff1345ec16faba8d817168661795a7eae495ff2b463d322cd8e69f",
      "target_id": "ru-id03811",
      "tag": "p",
      "target_sha256": "baa19bfb0f1d9e3e6eda08df7543e9fef454e9cb4ba1bb3e8f03b5d8f4177092"
    },
    {
      "source_id": "id03812",
      "target": "— Кто нам их даёт? — спросил Портос.",
      "source_sha256": "a385b292749ada2159458d1c678268ff553c6a2c1202c258e8cab975c795ff8e",
      "target_id": "ru-id03812",
      "tag": "p",
      "target_sha256": "f9f3e3d64caafcb73c269711d8d3f638a44102e83f52b52417c7e0b3e2b7cb47"
    }
  ],
