{
  "unit": 28,
  "batch": 6,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id03773",
      "target": "Д’Артаньян ничего не сказал, но вздохнул.",
      "source_sha256": "ea233feef4839e7bc96fdc48e8880c54ecd982f6780a7e8b2d95be3e92bc88be",
      "target_id": "ru-id03773",
      "tag": "p",
      "target_sha256": "951ce30baba7f7f1ba7f325eb9de56d3e5286be8818d582552585118365191f3"
    },
    {
      "source_id": "id03774",
      "target": "Атос посмотрел на них и взял их руки в свои.",
      "source_sha256": "9a41ba147f8968d50d8f4ae529112bc0ec51474f530b4179e9ad6e0d72882251",
      "target_id": "ru-id03774",
      "tag": "p",
      "target_sha256": "3a74458468745bcdee8a361071319ea3f3022dc68bb695b904285ea9f28505f2"
    },
    {
      "source_id": "id03775",
      "target": "— Господа, — сказал он, — дело это серьёзное, и сердце моё страдает так, словно вы пронзили его насквозь. Да, мы разлучены — вот великая, вот печальная истина, но мы ещё не объявили друг другу войны; быть может, нам нужно оговорить некоторые условия, и последний разговор необходим.",
      "source_sha256": "7c7a827a073f76c8acec43ae8b5428fd1c95d911e0cda26362063bfe35408b9e",
      "target_id": "ru-id03775",
      "tag": "p",
      "target_sha256": "45b96d1d1046c54c9706180b00f47316fcc7789f3d918342409d9e652fe9eff6"
    },
    {
      "source_id": "id03776",
      "target": "— Что до меня, я на нём настаиваю, — сказал Арамис.",
      "source_sha256": "9b374295fe7da0dc598864d21d190ea64899369e576672f0ef07a74662402a81",
      "target_id": "ru-id03776",
      "tag": "p",
      "target_sha256": "0aca887ae532508b5c0c7a205719b7940ea298f5075fdd456ac9fe99af2989e8"
    },
    {
      "source_id": "id03777",
      "target": "— Я согласен, — гордо сказал д’Артаньян.",
      "source_sha256": "2cff7fee92dc1941aab4d8c7d3d8e5785ac6f4952986d6df7ca156d29b9eb8b1",
      "target_id": "ru-id03777",
      "tag": "p",
      "target_sha256": "2d277d6432c316cb744f630d490a711b59cd2b15b3b8b43bd506405abf64f611"
    },
    {
      "source_id": "id03778",
      "target": "Портос наклонил голову в знак согласия.",
      "source_sha256": "0d1faf88ac8757674b9fedd74c7a090b0b1c1209fa60a66e2dc1f3d1f7eaae48",
      "target_id": "ru-id03778",
      "tag": "p",
      "target_sha256": "0658bc2fe19403190e3bc6cd34f47329074f204ebde3168a02844ad164f845b2"
    },
    {
      "source_id": "id03779",
      "target": "— Итак, назначим место встречи, — продолжал Атос, — доступное для всех нас, и на этом последнем свидании окончательно определим наше взаимное положение и то, как нам следует держаться по отношению друг к другу.",
      "source_sha256": "e6f4ba8c1e9a506916fd58186686fcdc8f36af41c3bfbcb813f70d97e876a3c6",
      "target_id": "ru-id03779",
      "tag": "p",
      "target_sha256": "499061ddcfdd56160816a5c0e177db401336dd46146ba1020f425ee8641727a4"
    },
    {
      "source_id": "id03780",
      "target": "— Хорошо! — сказали трое остальных.",
      "source_sha256": "42ab9b0b4a7dcc98061312609adf11b2f14e0250f2d5c49ae3c890c983829115",
      "target_id": "ru-id03780",
      "tag": "p",
      "target_sha256": "134536f451d36f289db4ef466e63096ee65a2d3699bbdc5c3913ba3751e77022"
    },
    {
      "source_id": "id03781",
      "target": "— Значит, вы согласны со мной? — спросил Атос.",
      "source_sha256": "1b884cf57868d610203545138efa9ae1de79af5acc75febfdd7af762a59f3fd3",
      "target_id": "ru-id03781",
      "tag": "p",
      "target_sha256": "83fe9aa9ab6b5438d48fce50c90739d502f367ff38231e36f33158fa12ebfe64"
    },
    {
      "source_id": "id03782",
      "target": "— Вполне.",
      "source_sha256": "4e96bb9d652c22d4f134173525dc874dfc2cfb45e462a35d6db0c9de332230f1",
      "target_id": "ru-id03782",
      "tag": "p",
      "target_sha256": "5aecf09386e9eb14a8e2be8bbd28123a64628cce4318a2897e8ce4c8da9eff63"
    },
    {
      "source_id": "id03783",
      "target": "— Ну так где же?",
      "source_sha256": "0bdbc9b262f9dff156a24c15d9b5e821bfb74422ed1b9c742c6a76dc1d5ad4ca",
      "target_id": "ru-id03783",
      "tag": "p",
      "target_sha256": "18fa0f7b9ac0d69f0bbdac01812e77301ad9683e2930f84ddc377b0814f13e00"
    },
    {
      "source_id": "id03784",
      "target": "— Подойдёт ли вам Королевская площадь? — спросил д’Артаньян.",
      "source_sha256": "5ea17a8d2b92ee51027a0c221fedca248ee9d42b8d1d2842c72ec9c5913de841",
      "target_id": "ru-id03784",
      "tag": "p",
      "target_sha256": "75ea6c6792bf13a1ace2525f80d56e533b8ea4e04b5247fd3ab6494254f8ba42"
    },
    {
      "source_id": "id03785",
      "target": "— В Париже?",
      "source_sha256": "9008cc1bab7fb40f839d2af0a675e950e0fd105c55934567636e1ed2dc042e64",
      "target_id": "ru-id03785",
      "tag": "p",
      "target_sha256": "e919730d795fe7bccd44ec3fbe4a104f3eda886af29d78f4ffcc8f91d85de935"
    },
    {
      "source_id": "id03786",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id03786",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "id03787",
      "target": "Атос и Арамис переглянулись, и Арамис одобрительно кивнул.",
      "source_sha256": "cc166abaaccae9d014fe64cad7027404005bc1995c22b652feef513d8140c87e",
      "target_id": "ru-id03787",
      "tag": "p",
      "target_sha256": "087c9c5a7b989e47f6ebc79a67b240991d6a7cf43f69a568b25f76e81a4fb8a1"
    },
    {
      "source_id": "id03788",
      "target": "— Королевская площадь, пусть так! — сказал Атос.",
      "source_sha256": "57a7ce912e71ab750d0500dfaaead6a2a8ded0bb15aeaea3dd41210a671d377f",
      "target_id": "ru-id03788",
      "tag": "p",
      "target_sha256": "c5181e9c041be3213a5eb006de5d7b427ce8b91a42e228bd7a1dacb0387d4031"
    },
    {
      "source_id": "id03789",
      "target": "— А когда?",
      "source_sha256": "7f2ef6147cd58dbda1ab88fbb5c78a8b964077e82f77cdac121d834209f62649",
      "target_id": "ru-id03789",
      "tag": "p",
      "target_sha256": "87d42443270cd0ef3282131fa0bdf8c34fe42dd82d288f78bf80be2b11c0a753"
    },
    {
      "source_id": "id03790",
      "target": "— Завтра вечером, если хотите.",
      "source_sha256": "2888e5280512f3ad4803f1e429c60367b484a9b249ff8b3ce14c5db4fd6fa462",
      "target_id": "ru-id03790",
      "tag": "p",
      "target_sha256": "c86fc29a16dc91e6e3ca7d1f741181db030f16f2a592e8112526eda66d09df69"
    },
    {
      "source_id": "id03791",
      "target": "— Вы к тому времени вернётесь?",
      "source_sha256": "2b69b837f128a31bb55e87311d8bf6bea21061b48853e5bdcefe04dc429c6a9e",
      "target_id": "ru-id03791",
      "tag": "p",
      "target_sha256": "ea97149d1de4c6f2bfd25520f752a8451f968fbe4b2d2f8c8fb08697f54b25e3"
    },
    {
      "source_id": "id03792",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id03792",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    }
  ],
