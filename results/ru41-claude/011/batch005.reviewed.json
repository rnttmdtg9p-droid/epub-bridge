{
  "unit": 11,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id01356",
      "target": "— К которому он прибавил имя Брасьё, — земля, которая была баронством, честное слово!",
      "source_sha256": "d1a0564bef6bdeb534c1adcd2b9ca9a1fe8f9a993f1ba674e63716798c000b34",
      "target_id": "ru-id01356",
      "tag": "p",
      "target_sha256": "6b3a2b9d6d7a9ba1e66b2a97b816d92bd4e7dd8bfaf33055c030722888af8835"
    },
    {
      "source_id": "id01357",
      "target": "— Так что мы увидим Портоса бароном.",
      "source_sha256": "4c9c65f6e1f1646129175868d176892600971f33d7b13a28b0acfb19ddc18295",
      "target_id": "ru-id01357",
      "tag": "p",
      "target_sha256": "5b52b75bc39d704faedfc7dad852be6ce4a21bf472b40adfeb4a843fc3655a26"
    },
    {
      "source_id": "id01358",
      "target": "— Не сомневаюсь. Баронесса Портос, особенно, восхитительна.",
      "source_sha256": "023b38a2f091efd97ab7e932f1a7b9647d4dc3d709abc56f92521abddc497942",
      "target_id": "ru-id01358",
      "tag": "p",
      "target_sha256": "c5ce5c1cb48da539c46f34d34d4f5f84db3650ff4d66c9a51faacbae32bc68db"
    },
    {
      "source_id": "id01359",
      "target": "Оба друга расхохотались.",
      "source_sha256": "3385b393f6affa095af83551bd44c26b77a1292863be1f382c0814eae66503b3",
      "target_id": "ru-id01359",
      "tag": "p",
      "target_sha256": "5311dbe3c18aaa9262c1cdea79144bab74766c003fd13caa6e9873a4065eb4a0"
    },
    {
      "source_id": "id01360",
      "target": "— Итак, — снова заговорил д’Артаньян, — вы не хотите перейти к Мазарини?",
      "source_sha256": "2b2e45f127045db70b79e6398d3eab96de3b877aad41fd47d72562dbcab97c12",
      "target_id": "ru-id01360",
      "tag": "p",
      "target_sha256": "390bf185edfedb80eb7b177a16003e0c64bff2d16782ad8ea461d37cacd8865e"
    },
    {
      "source_id": "id01361",
      "target": "— И вы не хотите перейти к принцам?",
      "source_sha256": "0bb3755fed2ca73a71cc56e83bcf368a9554ed5f7ff86d39813714f0750eb9b1",
      "target_id": "ru-id01361",
      "tag": "p",
      "target_sha256": "31af92c0d845d2d42157ab10331b2cd65fa6334177a01bfeb38df0f0959fbc03"
    },
    {
      "source_id": "id01362",
      "target": "— Нет. Тогда не будем переходить ни к кому и останемся друзьями; не будем ни кардиналистами, ни фрондёрами.",
      "source_sha256": "2c89997d2e789e833ca5f3828c99e792533141f9caa91bbddbfdc44f4878c387",
      "target_id": "ru-id01362",
      "tag": "p",
      "target_sha256": "a7ef79d4ec5df2ac0c54ec46a1c9e1a064794d8c9cc982db12f33e904bb81069"
    },
    {
      "source_id": "id01363",
      "target": "— Да, — сказал Арамис, — останемся мушкетёрами.",
      "source_sha256": "28985394922b43e35246f6cc4a62bbf290b90506253f31d2331e5826693663da",
      "target_id": "ru-id01363",
      "tag": "p",
      "target_sha256": "6cc21ab2e456eff84894882ba98882c7a5394871c0c4c2bdaf4e03518f7c9e23"
    },
    {
      "source_id": "id01364",
      "target": "— Даже с маленьким воротничком, — добавил д’Артаньян.",
      "source_sha256": "e6379c7c1217b67e13482b4fc57a19600e7373e0fb4ca7173f9407036a301ce1",
      "target_id": "ru-id01364",
      "tag": "p",
      "target_sha256": "4914a5662c1a6df464181f47757ee37e276dcf311fa36bb4ac52e3e4067b582a"
    },
    {
      "source_id": "id01365",
      "target": "— Особенно с маленьким воротничком! — воскликнул Арамис. — В нём-то и вся прелесть.",
      "source_sha256": "136e95248b00e1c41fe01e5f74dbb824aa884783755f2ba0a61f223638b4b53c",
      "target_id": "ru-id01365",
      "tag": "p",
      "target_sha256": "7a966ec97f41a5bc14acbe7817733e0eb805509fdce33336cdc0b346727c6a0c"
    },
    {
      "source_id": "id01366",
      "target": "— Ну так прощайте, — сказал д’Артаньян.",
      "source_sha256": "548f716afad3ff35aa1a48ed9e6b5e3f5179ff3395c28b8fa9a0f786d9ddba76",
      "target_id": "ru-id01366",
      "tag": "p",
      "target_sha256": "e9081eb51855222d598f545377c7907915ae853b770fe2d12804d28bcd1f6687"
    },
    {
      "source_id": "id01367",
      "target": "— Я вас не удерживаю, дорогой мой, — сказал Арамис, — поскольку не знал бы, где вас уложить, и не могу же я, право, предложить вам половину сарая Планше.",
      "source_sha256": "9aa3793f0bbea266c7aa0af5ef47d344a4cf28f026aae97d4af054792ccdcba4",
      "target_id": "ru-id01367",
      "tag": "p",
      "target_sha256": "0bb8bfe189bd192a189b0068f1646bee4c98615862daaa7f61e561e3d0efddcb"
    },
    {
      "source_id": "id01368",
      "target": "— К тому же я всего в трёх лье от Парижа, лошади отдохнули, и меньше чем через час я буду на месте.",
      "source_sha256": "9b222e9692fd5d86e49658d3da8928186acc6200f4ce2989849c9aee09298f41",
      "target_id": "ru-id01368",
      "tag": "p",
      "target_sha256": "83d31d1902f56e7fe0a67ae371e3cf064f9ca30576cff30392fb13e46c3d1a3f"
    },
    {
      "source_id": "id01369",
      "target": "И д’Артаньян налил себе последний стакан вина.",
      "source_sha256": "46555f182248dca8831edc36c3324051b6c469412fc71b776cb971a20a26f745",
      "target_id": "ru-id01369",
      "tag": "p",
      "target_sha256": "b72219c3ec221e981ff92ecd2f72af01ef41cdfb0d4c7107f030176ab4b5ae30"
    },
    {
      "source_id": "id01370",
      "target": "— За наше старое время! — сказал он.",
      "source_sha256": "df4ad510da15e40468a6a2ae852217ca458350e717fd96d420ab9d978b3ef030",
      "target_id": "ru-id01370",
      "tag": "p",
      "target_sha256": "6250daae35ef0d9909b548326e5692c286b0c41a76bf2fd8a75586d1d8e7cb1d"
    },
    {
      "source_id": "id01371",
      "target": "— Да, — отозвался Арамис, — к несчастью, это время прошло… <i>fugit irreparabile tempus</i> …",
      "source_sha256": "90381626cebd034607b7ebf7c54a5f1f003ecb90931a34dbeee45c8769864652",
      "target_id": "ru-id01371",
      "tag": "p",
      "target_sha256": "5095144d3f9a490667e7af95cd99feb50caa5dc97c76bcf4e016ba7df59e8239"
    },
    {
      "source_id": "id01372",
      "target": "— Э, полно! — сказал д’Артаньян. — Быть может, оно вернётся. Во всяком случае, если я вам понадоблюсь, улица Тикетонн, гостиница <i>«Ла Шевретт»</i>.",
      "source_sha256": "4db5daf9db669cc024c50214ade3f9307efd0f3ccafee9e6254d245637789213",
      "target_id": "ru-id01372",
      "tag": "p",
      "target_sha256": "dc1c644e8c28442169c0ecc9c29d3baf36932fe666243226c4a0257bc3bdfdc4"
    },
    {
      "source_id": "id01373",
      "target": "— А я — в монастыре иезуитов: с шести часов утра до восьми часов вечера — через дверь; с восьми часов вечера до шести часов утра — через окно.",
      "source_sha256": "8a18221ae4172dbab1a9702960be5ae61df6477d370d45ab27e71c2b692ba083",
      "target_id": "ru-id01373",
      "tag": "p",
      "target_sha256": "4f5de9dac7cfa2d6bb42324bb1cade8f04a79516e080ee949c8dc40cad0dab2d"
    },
    {
      "source_id": "id01374",
      "target": "— Прощайте, дорогой мой.",
      "source_sha256": "98146eca48ae61bc799f48bfac0924dadcd280b07dda2df2332eb299d105b663",
      "target_id": "ru-id01374",
      "tag": "p",
      "target_sha256": "ccd921a9206f81b5521e6df8766d516d10b9e45655e902ffc493d06e2adffd31"
    },
    {
      "source_id": "id01375",
      "target": "— О! Я не расстанусь с вами так, позвольте мне вас проводить.",
      "source_sha256": "b49d2d765105ced226c51fec9472ae3a9a3acf84510e263ca09db98d47e82561",
      "target_id": "ru-id01375",
      "tag": "p",
      "target_sha256": "34c6f177ea7594e99404ef971057c0a595cef40245e1e3077da11d93e2f9501c"
    }
  ],
