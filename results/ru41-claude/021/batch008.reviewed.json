{
  "unit": 21,
  "batch": 8,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id02642",
      "target": "— Тот же, что и вчера?",
      "source_sha256": "bdce0123d0b6b90467608e81342f7e795be7529b8c2277511406ba7916999e3e",
      "target_id": "ru-id02642",
      "tag": "p",
      "target_sha256": "25bf614034a2c617cef80b2ed7d2f0c1178bb2094f531d8102b5e96f705893d3"
    },
    {
      "source_id": "id02643",
      "target": "Гримо повторил свой знак.",
      "source_sha256": "3c545499e5c1a61ab3af591f83f432446beb5ce050bedc5cdcf2bf834333798e",
      "target_id": "ru-id02643",
      "tag": "p",
      "target_sha256": "37dd8265205ecd060021b06a60ffe73f204df1dbb424da035fcf331fecb42b31"
    },
    {
      "source_id": "id02644",
      "target": "— Тогда граф де Рошфор?",
      "source_sha256": "314c3e839717830de07bdbb04729f4ac542b942976f8a4b359040b12ad3191d4",
      "target_id": "ru-id02644",
      "tag": "p",
      "target_sha256": "ae05fbd752e95908f3df8ec69dfc26a223809eebcd2804b43f2e26433c2b5f7b"
    },
    {
      "source_id": "id02645",
      "target": "Гримо трижды подал знак, что да.",
      "source_sha256": "a2251796e4306296455d29dd81cb0732c965a58c14259a214f76f616125c8332",
      "target_id": "ru-id02645",
      "tag": "p",
      "target_sha256": "6dcba12c1b18a6d172ac1a2ed2919993e06c75ff5cd372c1a6d0041501f1410e"
    },
    {
      "source_id": "id02646",
      "target": "— Но послушай, — сказал герцог, — расскажи мне хотя бы кое-какие подробности о том, как мы будем бежать.",
      "source_sha256": "3769dc14465cc5e9ab1b2d31233d86153d71530c3851bd3c9d021fc5e0c65375",
      "target_id": "ru-id02646",
      "tag": "p",
      "target_sha256": "b6c5dfd81fdd60cff6d876ff7690a5c1a2b712f8ab9b8457f938cd30295943e3"
    },
    {
      "source_id": "id02647",
      "target": "— Мне это запрещено, — сказал Гримо, — до самой минуты исполнения.",
      "source_sha256": "be0eccf5830746c0755be6a0635cfb435425edbc9eb4e1d58602d32d7f87ff56",
      "target_id": "ru-id02647",
      "tag": "p",
      "target_sha256": "1987eaeeeaa74c9c259d9e3a9b01b4f3f8128483a720dd56551d3b46ff1078b4"
    },
    {
      "source_id": "id02648",
      "target": "— Кто те люди, которые будут ждать меня по ту сторону рва?",
      "source_sha256": "5b5b6e55b772d865f94aa0b5c9a4c8e3722d3bc4436a581fb1bfe7109befed5d",
      "target_id": "ru-id02648",
      "tag": "p",
      "target_sha256": "d42cbb5c51b6990cd11ff11554f094726cf99f7c97f237c199dbbb1829d28721"
    },
    {
      "source_id": "id02649",
      "target": "— Я ничего об этом не знаю, монсеньор.",
      "source_sha256": "1043b745bb803c1cd16b84c601e3d9b225a77baa0c13b6d3cbd3b2698986b7bd",
      "target_id": "ru-id02649",
      "tag": "p",
      "target_sha256": "0b74ee612fcc8c4db168bf84a8b559e88eb20b510161b1d1c39d0d0cbad3814e"
    },
    {
      "source_id": "id02650",
      "target": "— Но хотя бы скажи мне, что будет в этом знаменитом пироге, если ты не хочешь, чтобы я сошёл с ума.",
      "source_sha256": "68492a2de4de357afb4c122afcf8cd308bb39295c880e71d39b36ec1fec051cb",
      "target_id": "ru-id02650",
      "tag": "p",
      "target_sha256": "27ff9e788cc135dfd8fde74e19b28670732718ae7d6f8c1ce3ad5c8077ee931a"
    },
    {
      "source_id": "id02651",
      "target": "— Монсеньор, — сказал Гримо, — в нём будут два кинжала, верёвка с узлами и кляп.",
      "source_sha256": "74d3613b39c30905ebbc535fb69e518cfc466a2be0c5deb5cd982686113671ac",
      "target_id": "ru-id02651",
      "tag": "p",
      "target_sha256": "9935931aa7c3bc1bf06274bc9bcc21becf6c216c4075e0916c69af9caebacb2b"
    },
    {
      "source_id": "id02652",
      "target": "— Хорошо, я понимаю.",
      "source_sha256": "f0b3a338897f50a14ce87a2f39221e9352f3ef300f5b1babd0d85c52b0759feb",
      "target_id": "ru-id02652",
      "tag": "p",
      "target_sha256": "a745b3950f3bc4e314aa4784d4aeff01614139c303ee7c4c8f5f8a08b87d84fa"
    },
    {
      "source_id": "id02653",
      "target": "— Монсеньор видит, что хватит на всех.",
      "source_sha256": "dbf234eaca5c6050dc523031dba7734afb6482afabc085ebee62e4a430e21cb3",
      "target_id": "ru-id02653",
      "tag": "p",
      "target_sha256": "b6376bec0cf300bb812c277ff4b30e6b07de690ff39792001fc1f40ccf293809"
    },
    {
      "source_id": "id02654",
      "target": "— Кинжалы и верёвку мы возьмём себе, — сказал герцог.",
      "source_sha256": "b522907f34af053d5f7f0e9a9bc9b2976be704374ef242d679259a2262bf022e",
      "target_id": "ru-id02654",
      "tag": "p",
      "target_sha256": "2e19f5af7113b4c3423ef97049c567a1261b3f839d4f79fa100ad9c7bed796a5"
    },
    {
      "source_id": "id02655",
      "target": "— А кляп дадим съесть Ла Раме, — ответил Гримо.",
      "source_sha256": "13395b6ce86bfb69d605a461d5126cdaffb771235dbce7693efa740ade043742",
      "target_id": "ru-id02655",
      "tag": "p",
      "target_sha256": "48f1d2c5d30a436ddb519195b00d72de22dec83e6468f48038b83e584ce5bdf8"
    },
    {
      "source_id": "id02656",
      "target": "— Мой дорогой Гримо, — сказал герцог, — ты говоришь не часто, но, надо отдать тебе справедливость, когда говоришь, то говоришь золотые слова.",
      "source_sha256": "537ccdc177b122219de32412a037fff268f8891bf39715e39b942abdbace0104",
      "target_id": "ru-id02656",
      "tag": "p",
      "target_sha256": "70c12026606916033d91cfba48f5ada5c89303491c4ddef0becc780b42d7b7d9"
    }
  ],
