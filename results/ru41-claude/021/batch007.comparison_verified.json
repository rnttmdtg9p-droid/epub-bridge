{
  "unit": 21,
  "batch": 7,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id02622",
      "target": "— А что мне писать?",
      "source_sha256": "106b6ef48614faa31bd77eb8503cd822a14711d0ee331f36d893ee37decc6d27",
      "target_id": "ru-id02622",
      "tag": "p",
      "target_sha256": "8e21152fe0494e7f95e9fea6363e6487ef5553e726ca92c351c27c7ff39129aa"
    },
    {
      "source_id": "id02623",
      "target": "Гримо сделал знак пальцем и продиктовал:",
      "source_sha256": "3dee39a1c803f7489d49fa0e7ca2f7fa4d08d2308f84327627d68e4508f52dc7",
      "target_id": "ru-id02623",
      "tag": "p",
      "target_sha256": "8987d476511fcf9783e2f0bba792152573c6c55fda37aa90d4aa27bfedb0e51a"
    },
    {
      "source_id": "id02624",
      "target": "«Всё готово на завтрашний вечер, будьте настороже с семи до девяти часов, держите наготове двух запасных лошадей, мы спустимся через первое окно галереи.»",
      "source_sha256": "d27200667a0bcb06ce51c29c9a37134d9b56a6afe9a6e7a708c6a3fe7d95554e",
      "target_id": "ru-id02624",
      "tag": "p",
      "target_sha256": "99f6252b7e3b72c842efdb327785ea90b2aca009e4ad4b01a0e70c4b2faab9a7"
    },
    {
      "source_id": "id02625",
      "target": "— А дальше? — спросил герцог.",
      "source_sha256": "2bdc5f390994bf6dd3866b5bdcbb7a42768d2acc8969406cfa62298ac18a288c",
      "target_id": "ru-id02625",
      "tag": "p",
      "target_sha256": "179c0c819de03a82d2cbc60381bb6b5f3ea8fa21d4efe327ad4bdaacb1f82ff7"
    },
    {
      "source_id": "id02626",
      "target": "— Дальше, монсеньор? — удивился Гримо. — Дальше подпишите.",
      "source_sha256": "5b8c977f1508a1bd15154f4a80a243e3d09d82785b5b18b880e71dc78d96ac18",
      "target_id": "ru-id02626",
      "tag": "p",
      "target_sha256": "282c92168ab66cf5f3150b33410fe5ea0bd750d4d1ea8fd3237aede8773a0b79"
    },
    {
      "source_id": "id02627",
      "target": "— И это всё?",
      "source_sha256": "80a6a52fcb8f97bcb16f02cd1d5280aa69fa37322282a613a9389eac762374e8",
      "target_id": "ru-id02627",
      "tag": "p",
      "target_sha256": "62677d134425435697ccb24c2fb164fbe02e3bbde3c9e9b7e83f29b5d84703c9"
    },
    {
      "source_id": "id02628",
      "target": "— Чего же вам ещё, монсеньор? — ответил Гримо, державшийся самой суровой краткости.",
      "source_sha256": "7be379226fc5bcdeb1e0bb2fafefbe771c4847679d029f8e010b3b20fbbbf8c8",
      "target_id": "ru-id02628",
      "tag": "p",
      "target_sha256": "826cd925acfa7e974b37c60b7aac93569c6326f33b1c982d89239b679414ff74"
    },
    {
      "source_id": "id02629",
      "target": "Герцог подписал.",
      "source_sha256": "db23c21a32f4a459178ce719152504438a4c770fbf1aa31a62cc560a360c260a",
      "target_id": "ru-id02629",
      "tag": "p",
      "target_sha256": "56510982a17f37e7620f1eab86b4f491737f1b6cfa6ce30e30267aff7bd7bef3"
    },
    {
      "source_id": "id02630",
      "target": "— Теперь, — сказал Гримо, — не потерял ли монсеньор мяч?",
      "source_sha256": "d778d347239b481cdc33124e8a3a4df50e835ac174295bc5ac86b15d7e4fda0e",
      "target_id": "ru-id02630",
      "tag": "p",
      "target_sha256": "99ba0530a474c63a9520a3c5e72070f91140fd5b789c5ab148db43e5786b84c0"
    },
    {
      "source_id": "id02631",
      "target": "— Какой мяч?",
      "source_sha256": "39a834c6319904204d8e57db1f76fd221af35a7fb1b168414d5b190266b1c955",
      "target_id": "ru-id02631",
      "tag": "p",
      "target_sha256": "183e6fdb85eb5f8ab1c918cc1a894cbec166a92ed229cbe8e2f1c8aca7d902c4"
    },
    {
      "source_id": "id02632",
      "target": "— Тот, в котором было письмо.",
      "source_sha256": "1f027a9d8be51c793c4d3cd6b5edb6eb472fc3a00b5573374a1ae8a7b74a2316",
      "target_id": "ru-id02632",
      "tag": "p",
      "target_sha256": "59ed821d5bce2675aaf014b70a87836a43039333e8d9ab7c6bf39718357afb50"
    },
    {
      "source_id": "id02633",
      "target": "— Нет, я подумал, что он может нам пригодиться. Вот он.",
      "source_sha256": "5a61ed8d365354fe941cace3a0623914515a39be79dd5ea6e9bb3073bb88f295",
      "target_id": "ru-id02633",
      "tag": "p",
      "target_sha256": "378f132f0edc6323a7b46e6dfb2192227e98b09dc3af50c1d906404694d7a870"
    },
    {
      "source_id": "id02634",
      "target": "И герцог достал мяч из-под подушки и протянул его Гримо.",
      "source_sha256": "0c9b454b4b8de64c59436b2e468207671da421d7019a7d0768e5fb51a7760fe7",
      "target_id": "ru-id02634",
      "tag": "p",
      "target_sha256": "7c99e46ef02e60a1ed4f84d2193e2c6e3923dc40005906d38ee4718e6a2a594c"
    },
    {
      "source_id": "id02635",
      "target": "Гримо улыбнулся как мог приятнее.",
      "source_sha256": "0bf566fdd2f066e91729582dc39465ba3b68ced3d6cba46f120aadc785febb1f",
      "target_id": "ru-id02635",
      "tag": "p",
      "target_sha256": "e0afcdc3c3434694702e52caa3f9245392bf69db1c513814a8cc4c36e03d7e68"
    },
    {
      "source_id": "id02636",
      "target": "— Ну так что? — спросил герцог.",
      "source_sha256": "16ab7679cbf7e085077cde909b8d138b28012007de3622456a939eb3038e46a2",
      "target_id": "ru-id02636",
      "tag": "p",
      "target_sha256": "26132b26c3c445d2a40b5cd62077fdc94fbdd766a16fc69390cda9f231995d52"
    },
    {
      "source_id": "id02637",
      "target": "— Ну так вот, монсеньор, — сказал Гримо, — я зашью бумагу обратно в мяч, а вы, играя в мяч, закинете его в ров.",
      "source_sha256": "37b7c54146a2781737768d55560dae7c4e4ec360b3ace40fdcdacef4d588b5e7",
      "target_id": "ru-id02637",
      "tag": "p",
      "target_sha256": "85a1dad1ab127a1f5ae927846072a8fb9066f31a248c064c464a681d895ea889"
    },
    {
      "source_id": "id02638",
      "target": "— Но, может быть, он пропадёт?",
      "source_sha256": "55e160e85e9cf8b518e4c34ff8fb484e1746027ea60c238ecc1cc2be8835e707",
      "target_id": "ru-id02638",
      "tag": "p",
      "target_sha256": "d90671019c8d1f6ab4277884f015cd99cefc468be6655ce8827390d7ac508939"
    },
    {
      "source_id": "id02639",
      "target": "— Будьте спокойны, монсеньор, найдётся кто-нибудь, кто его подберёт.",
      "source_sha256": "e2ceb6312d42dc4f87cfb456dabfaeb2e696c68601179a8fe600a200d678bc79",
      "target_id": "ru-id02639",
      "tag": "p",
      "target_sha256": "b0b5880fa66dbdc03a4500642e1e5233247a8f0ff6cf494a9afe482046e7eb4f"
    },
    {
      "source_id": "id02640",
      "target": "— Садовник? — спросил герцог.",
      "source_sha256": "57c155fee8f10c359161fe78ea680e9e75f7a87a81ed1792198c250a6cceec4b",
      "target_id": "ru-id02640",
      "tag": "p",
      "target_sha256": "d145220e3e0af1f78a513bd80d4e1c4f8e26c217ddaa9faae455aa44d8dcf972"
    },
    {
      "source_id": "id02641",
      "target": "Гримо подал знак, что да.",
      "source_sha256": "a2cc50828b3d797da605683d9163df84a550069e809dc5467114563aade36b00",
      "target_id": "ru-id02641",
      "tag": "p",
      "target_sha256": "e1d42719f4582d03db6ad705890f3654b00f9726e8db8b748349e1a50a666ec7"
    }
  ],
