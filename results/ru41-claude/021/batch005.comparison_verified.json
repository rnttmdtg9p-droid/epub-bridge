{
  "unit": 21,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id02582",
      "target": "— Тсс! — сказал Ла Рамэ.",
      "source_sha256": "70893f731ed3e00c0234e8c7ad953609dc9522b9ebb96da5387168eb99716a76",
      "target_id": "ru-id02582",
      "tag": "p",
      "target_sha256": "e6ea46a4b56e087e941561d87d97dfdf9362d66c3baf101bebffe314ce80bb98"
    },
    {
      "source_id": "id02583",
      "target": "И он под каким-нибудь предлогом удалил стражников одного за другим.",
      "source_sha256": "6dc25056edb36606d065453a6c1b31156f94fa32d58b96ac41e9cbcf785f6e9f",
      "target_id": "ru-id02583",
      "tag": "p",
      "target_sha256": "bf1b42399a331409d711b5b05997bda8d860ef1161a5c593a79a9afd069a2728"
    },
    {
      "source_id": "id02584",
      "target": "— Ну что? — спросил герцог, когда они остались одни.",
      "source_sha256": "0448d2123b83d8c419512451fc8730bcaaee731542a36ffc4218e03537172a70",
      "target_id": "ru-id02584",
      "tag": "p",
      "target_sha256": "04c030a99ede0636f149368b79bd5c7300127a74a92adbf462337fa4e781a22c"
    },
    {
      "source_id": "id02585",
      "target": "— Ну что ж! — сказал Ла Рамэ. — Ваш ужин заказан.",
      "source_sha256": "9eb2dda145f0afc1bb6c3c520454c980da1b3f11a5ee9096b64014ab86b68113",
      "target_id": "ru-id02585",
      "tag": "p",
      "target_sha256": "c1e9d4e4107af4ff55943ff08c750cd0fb59ca6cca9972131980b1515a0973d9"
    },
    {
      "source_id": "id02586",
      "target": "— А! — сказал принц. — И из чего же он будет состоять? Ну-ка, господин мой мажордом.",
      "source_sha256": "aa47973d9906cb564fa2af1dce16d2e46da41533708b5902557ef3e2b453da4c",
      "target_id": "ru-id02586",
      "tag": "p",
      "target_sha256": "8993c40ac22c909cd8733db43872ebdc03e5ce256f181e5420d87f5b0fb2159e"
    },
    {
      "source_id": "id02587",
      "target": "— Монсеньор обещал положиться на меня.",
      "source_sha256": "7fa77775359210c7c7c40cb0483fa046e3a9869cfd9b6404cfd9077bcbe4e867",
      "target_id": "ru-id02587",
      "tag": "p",
      "target_sha256": "0ec1da8609fbe95d41ff2e9b9c610ec0e5dbdcd62b2d5223cf8c56057d190061"
    },
    {
      "source_id": "id02588",
      "target": "— И будет паштет?",
      "source_sha256": "48947fcfc877b833b5baa63a502bca09564506783f89f91c71a021a5aed38e9d",
      "target_id": "ru-id02588",
      "tag": "p",
      "target_sha256": "3dcc18ae9052492cf15ef1c4d19cd24367a6e74d07ca1da15ab27c5542c5aa7f"
    },
    {
      "source_id": "id02589",
      "target": "— Ещё бы! Величиной с башню.",
      "source_sha256": "827c0483848e7ae377f3562b2d565b20d71183a0e76d496fecc46f1392a921e5",
      "target_id": "ru-id02589",
      "tag": "p",
      "target_sha256": "28db81bc23d60cba0166f44f533956cac172e491bccd748be89e4999a1d4b919"
    },
    {
      "source_id": "id02590",
      "target": "— Сделанный преемником папаши Марто?",
      "source_sha256": "453268530b8b427f0cf35be1a0f415d4d1a0d21bd74d8a81205e40764b92d71a",
      "target_id": "ru-id02590",
      "tag": "p",
      "target_sha256": "609bf69dfda073fe3440a0cadbf6c3163f190f1993c7086da54467fdfdaeb704"
    },
    {
      "source_id": "id02591",
      "target": "— Он заказан.",
      "source_sha256": "7dfbee9715094cec71a6fce9e2dd6909fc7ac7fb64ba2a09204c44c3f9bd25d5",
      "target_id": "ru-id02591",
      "tag": "p",
      "target_sha256": "2aac5f0acbea4a332a059cd3a625ee815adc16680cd6ca18a3fe30e29c628de1"
    },
    {
      "source_id": "id02592",
      "target": "— И ты сказал ему, что это для меня?",
      "source_sha256": "6d5139cb0d952c93f2532d6f67a23722f2a046d75af5fdcff368e3f6a38d3fff",
      "target_id": "ru-id02592",
      "tag": "p",
      "target_sha256": "18ec79897125a3b8125d2c6151293623ff72471eefd06d7b9e1823a5f7366f13"
    },
    {
      "source_id": "id02593",
      "target": "— Сказал.",
      "source_sha256": "4874b062bccdffe08bf0be278b3aa44f2daccb37386459fc6871fd6e04c7cdb0",
      "target_id": "ru-id02593",
      "tag": "p",
      "target_sha256": "19ab76d1357a9e8ccdab55ab3430575ad91c184434c64de4be23143ef2e26f84"
    },
    {
      "source_id": "id02594",
      "target": "— А он что ответил?",
      "source_sha256": "e3d3d999b5780268e06f1dd11209af7bf78bf7f1283c5bb265ae222da1451205",
      "target_id": "ru-id02594",
      "tag": "p",
      "target_sha256": "ea5192d5772b76dce052e2711245ad026ed1b9024059c7ccc3f51191935c4706"
    },
    {
      "source_id": "id02595",
      "target": "— Что сделает всё возможное, чтобы угодить Вашему Высочеству.",
      "source_sha256": "6b9fa8433a3d19641556ec3c1d377daf92f3ad5ccc766c01783928122cc91cf5",
      "target_id": "ru-id02595",
      "tag": "p",
      "target_sha256": "af5d81049869b00abc64649eccd4d968b47c3790c55f0ab0369f6bcda27fc8df"
    },
    {
      "source_id": "id02596",
      "target": "— Вот и прекрасно! — сказал герцог, потирая руки.",
      "source_sha256": "5f73e953a00a3c1632e5b823349140fbf8164ab0b0cecfc9fca686148b0187e4",
      "target_id": "ru-id02596",
      "tag": "p",
      "target_sha256": "346433635613f1e665659839735b8f17fdb7781f15842b755eff844d1e087374"
    },
    {
      "source_id": "id02597",
      "target": "— Чёрт возьми! Монсеньор, — сказал Ла Рамэ, — как жадно вы клюнули на лакомство! За пять лет я ещё ни разу не видел у вас такого весёлого лица, как сейчас.",
      "source_sha256": "65fa904304f8e7ed34ae3a3aeb799a2becfbfc9d193100da74cf785fa5e3810b",
      "target_id": "ru-id02597",
      "tag": "p",
      "target_sha256": "33643fca6a0d580469429825f60281fa820194fbc666b39ee24783def5775e09"
    },
    {
      "source_id": "id02598",
      "target": "Герцог понял, что недостаточно владел собой; но в это мгновение, словно он подслушивал у двери и понял, что необходимо срочно отвлечь мысли Ла Рамэ, вошёл Гримо и дал Ла Рамэ знак, что хочет ему кое-что сказать.",
      "source_sha256": "37c57a4dfd7c49ce4cfff0c7b911e9de28d30d2e7521c446a23295ceb129e767",
      "target_id": "ru-id02598",
      "tag": "p",
      "target_sha256": "fe5559561b2afdda99f1ad7bfc9892329b122abb2b5ee3ba3854a0bca31d880f"
    },
    {
      "source_id": "id02599",
      "target": "Ла Рамэ подошёл к Гримо, который заговорил с ним шёпотом. Герцог тем временем оправился.",
      "source_sha256": "47f698ac12e3c4ea6767403c0980b3fecd55dcc74d5e5fc6b6095f538632a6fa",
      "target_id": "ru-id02599",
      "tag": "p",
      "target_sha256": "2aa0ab1f1a96f2764259ea99bac2efcbb976cd32eb91404f961c2c1f9b407710"
    },
    {
      "source_id": "id02600",
      "target": "— Я уже запретил этому человеку, — сказал он, — являться сюда без моего позволения.",
      "source_sha256": "43b3770d5963aca063d9e3ef5c1229d833f9765443efa06085554370176df370",
      "target_id": "ru-id02600",
      "tag": "p",
      "target_sha256": "c6c416f42f6130f722e9bf8011d557b9aae99132742d464822b46722d7a0882b"
    },
    {
      "source_id": "id02601",
      "target": "— Монсеньор, — сказал Ла Рамэ, — его надо простить, ведь это я его вызвал.",
      "source_sha256": "e2b6c59a6f78048e86a0dd76c29cead55680b74d574e780b2a9d59fd68df3e47",
      "target_id": "ru-id02601",
      "tag": "p",
      "target_sha256": "015f164762d7644dad8a3637b72dbbf3275ac17544dc6b95251a59e10126c8ce"
    }
  ],
