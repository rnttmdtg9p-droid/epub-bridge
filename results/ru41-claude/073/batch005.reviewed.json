{
  "unit": 73,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id09714",
      "target": "Гримо подошёл. Ярость вернулась к нему вместе с сознанием, но держался он твёрдо.",
      "source_sha256": "f2764c5b2a953ae61081ce60d6f0b63ce5fa2a665ff080bba3bb0eccef0977af",
      "target_id": "ru-id09714",
      "tag": "p",
      "target_sha256": "014744241df28c0972d43b1e912ad9ec3be8b2020091299f9296ee4620179a8a"
    },
    {
      "source_id": "id09715",
      "target": "— Хорошо, — продолжал д’Артаньян. — Теперь снова поднимитесь на этот балкон и скажите нам, всё ли ещё этот Мордаунт в компании, собирается ли он уходить или ложиться спать. Если он в компании, мы подождём, пока он останется один; если выйдет, схватим его при выходе; если останется, выставим окно. Это всё-таки менее шумно и менее трудно, чем дверь.",
      "source_sha256": "b2f77ef8925f9fe93285c6a142d52204f6ee100416c6b85109f82fc251cb37a3",
      "target_id": "ru-id09715",
      "tag": "p",
      "target_sha256": "61064f2f23de1080b65725c64c2a48a7afc0e981669387aadf49a52437b040cc"
    },
    {
      "source_id": "id09716",
      "target": "Гримо начал бесшумно взбираться к окну.",
      "source_sha256": "9b0699f946c8049060a9761bf1bdd18e7b9e591c78ad3bd8970e94a972b1a483",
      "target_id": "ru-id09716",
      "tag": "p",
      "target_sha256": "609b139a8a1db07d3d1bf585b9cd5ae59dede87dcc7c01e1af8ba7b10b49bc74"
    },
    {
      "source_id": "id09717",
      "target": "— Стерегите другой выход, Атос и Арамис; мы остаёмся здесь с Портосом.",
      "source_sha256": "04111f3f58ca0231538b6278340745857448acd2ff65f6b65b9cd82428676e2b",
      "target_id": "ru-id09717",
      "tag": "p",
      "target_sha256": "5cb19f022a304c1856bba792aedf27a7c090cdd4098c29b78fd0ddd18e4b3a51"
    },
    {
      "source_id": "id09718",
      "target": "Оба друга повиновались.",
      "source_sha256": "713546d07535225cc15ea868711aa6c7245aaa67cf86a936db2f001a8138c42f",
      "target_id": "ru-id09718",
      "tag": "p",
      "target_sha256": "1134b94fc522c2f4688172e54fac0bcdfeead97f7ba586845f8a9b201dd2b2d7"
    },
    {
      "source_id": "id09719",
      "target": "— Ну что, Гримо? — спросил д’Артаньян.",
      "source_sha256": "1819bef7f7225b0be409f37a5fa097f6543bae7405adde84a6334f7ffdbc7f64",
      "target_id": "ru-id09719",
      "tag": "p",
      "target_sha256": "ef1323a0700cd76cc97e292f8f6f378f5f213efe403a3b88ff8afa1eca9b72f2"
    },
    {
      "source_id": "id09720",
      "target": "— Он один, — сказал Гримо.",
      "source_sha256": "229bdde24ada2f290d94a9854200df465c8a038b866a5a3283d21085f5dbe6e2",
      "target_id": "ru-id09720",
      "tag": "p",
      "target_sha256": "c51cd445cf9ead396c584600d9c50ead8dc1179d47bd07b062c0264b8e6aaa41"
    },
    {
      "source_id": "id09721",
      "target": "— Ты в этом уверен?",
      "source_sha256": "432ab41c37a13a3a391d8afe1d156d37ad76da3e3557907c6d35a7f43e07a46f",
      "target_id": "ru-id09721",
      "tag": "p",
      "target_sha256": "0ece552ef99db7efef4bec30dfccb5e847ecd636e5d1a4a4fb841f64fe7ee17a"
    },
    {
      "source_id": "id09722",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id09722",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "id09723",
      "target": "— Мы не видели, чтобы его спутник выходил.",
      "source_sha256": "5f9ca19fb3b500056916129a0897d90729edb9100c75f44123fa2ed632cf14c7",
      "target_id": "ru-id09723",
      "tag": "p",
      "target_sha256": "813105b00cd61249ce710a15e990f296f931d4333fe3f7df2b9830e6cf523f24"
    },
    {
      "source_id": "id09724",
      "target": "— Может быть, он вышел через другую дверь.",
      "source_sha256": "252a9d75a3957cee954aefbff2782267c04855b3f3bcb70c55cbeb50c7c68b12",
      "target_id": "ru-id09724",
      "tag": "p",
      "target_sha256": "c4b16d961018adbde2e5cab961e412bb49a26e1defee762476572407c888b9ad"
    },
    {
      "source_id": "id09725",
      "target": "— Что он делает?",
      "source_sha256": "e9d5f26089fad7b6bf3c0aa83ed37cb63a4b197bc31f0a5f1f834963917cb07c",
      "target_id": "ru-id09725",
      "tag": "p",
      "target_sha256": "dd00162949e68378ec2e7e00ae6bde99aa4142fc453423bc293907a3449fbbba"
    },
    {
      "source_id": "id09726",
      "target": "— Закутывается в плащ и надевает перчатки.",
      "source_sha256": "a3573eba0eba4b48546186e61aad2fa599d6b73abb9880c96d9533fe1f4f3145",
      "target_id": "ru-id09726",
      "tag": "p",
      "target_sha256": "ceb498c630561c9f558e8de7794ffba8aaf884705ccb49c34ff153166b4d5b11"
    },
    {
      "source_id": "id09727",
      "target": "— Теперь наш черёд! — прошептал д’Артаньян.",
      "source_sha256": "aea89c70d9fbc2236a7b771337bb1026c4c497b5cf9b4cb0360691e0f036b99b",
      "target_id": "ru-id09727",
      "tag": "p",
      "target_sha256": "e8c458a448c0086254a2c8811aa0181b7a2ddad9bed84e6e87037bd3372f7530"
    },
    {
      "source_id": "id09728",
      "target": "Портос схватился за кинжал и машинально вытащил его из ножен.",
      "source_sha256": "8cd59583d0381883ed381ab0f04bab442038e5013ec9c7c7bd73894694888710",
      "target_id": "ru-id09728",
      "tag": "p",
      "target_sha256": "dc31bcfc765772fe429902a3287cb87e93ae235a2864cdc034516e27c4c693ed"
    },
    {
      "source_id": "id09729",
      "target": "— Спрячь его, друг Портос, — сказал д’Артаньян, — здесь дело не в том, чтобы ударить первым. Он у нас в руках, станем действовать по порядку. Нам нужно потребовать друг у друга кое-каких объяснений, и это пара к сцене в Армантьере; только будем надеяться, что у этой не будет потомства и что, если мы его раздавим, всё будет раздавлено начисто вместе с ним.",
      "source_sha256": "fa026681bd99b5ff294a8e933989b1943822c55b1de50ce35c3efa3ab813825e",
      "target_id": "ru-id09729",
      "tag": "p",
      "target_sha256": "b380ca25cc968c3e30d062b903b0d478e945f558f9525b3727684f908966d32a"
    },
    {
      "source_id": "id09730",
      "target": "— Тсс! — сказал Гримо. — Вот, он собирается выходить. Подходит к лампе. Задувает её. Я больше ничего не вижу.",
      "source_sha256": "40c8603c4c79b0c56d2d3e350b3359ab3f7e6e1ce4b17e4ea4ba8ce8eb5ff126",
      "target_id": "ru-id09730",
      "tag": "p",
      "target_sha256": "f301f60764937feda11b9276a29668840e9ea7692c4ee2712cf71234a3c7f62b"
    },
    {
      "source_id": "id09731",
      "target": "— Тогда на землю, на землю!",
      "source_sha256": "f5b0c5d414f45c090d0a53c2e3533a4888e95dcf5c291b82790ab2061d2ca5c7",
      "target_id": "ru-id09731",
      "tag": "p",
      "target_sha256": "35533c51f5273006432eec012247bb50c3a736810dc3d39c52c18b42828c8c9f"
    },
    {
      "source_id": "id09732",
      "target": "Гримо спрыгнул назад и опустился на ноги. Снег заглушил звук. Ничего не было слышно.",
      "source_sha256": "61db6280e32c5109789d221abca5b304c3527ee33b53a3d9a9d0ac9199441119",
      "target_id": "ru-id09732",
      "tag": "p",
      "target_sha256": "4062a19db47a89137b313ff29f6e692864dfa775a6a62b8941deb63f6b1babad"
    },
    {
      "source_id": "id09733",
      "target": "— Пойди предупреди Атоса и Арамиса, чтобы они встали по обе стороны двери, как сейчас сделаем мы с Портосом; пусть хлопнут в ладоши, если схватят его, а мы хлопнем в свои, если схватим его мы.",
      "source_sha256": "3d64ec53719be6ec158b9d923cea38682ee1a2eb545131035c0e56152fc29f7c",
      "target_id": "ru-id09733",
      "tag": "p",
      "target_sha256": "842c62d5a0b5f29b86691aae20b1568eaffca813a5ac449c4435a9385a7e0514"
    }
  ],
