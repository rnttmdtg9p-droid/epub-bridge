{
  "unit": 73,
  "batch": 1,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id09634",
      "target": "— Я полагал, что ваша милость почитает смерть Карла I несчастьем, необходимым для блага Англии.",
      "source_sha256": "4993faa3d6eda2cb1a8cab11f68ed93b3ac54de33232817da5f71a6913b56e71",
      "target_id": "ru-id09634",
      "tag": "p",
      "target_sha256": "aa99bcc41510acb8403e7117548f585624dc531dead7d56ba7abe1e720d84475"
    },
    {
      "source_id": "id09635",
      "target": "— Что ж! — сказал Кромвель. — Я и теперь так думаю. Но лишь бы он умер — это было всё, что требовалось; пожалуй, лучше было бы, если бы не на эшафоте.",
      "source_sha256": "90f1d646efc00bbd97313d36a56e14ce19e70e2385bd4da7dc88d63c95666fd7",
      "target_id": "ru-id09635",
      "tag": "p",
      "target_sha256": "b9b677aacb3bfe37244c579f4bde7ea501b32643a1a811668b84661d17229df6"
    },
    {
      "source_id": "id09636",
      "target": "— Почему же, ваша милость?",
      "source_sha256": "708314a03c54d1f969f163b585d179e4c338d891b54d4cf7fecb5852debec20f",
      "target_id": "ru-id09636",
      "tag": "p",
      "target_sha256": "45887672240ac05a49f8ae9d78043c66868af29345296c2fc256eb7a4e64ba1b"
    },
    {
      "source_id": "id09637",
      "target": "Кромвель улыбнулся.",
      "source_sha256": "d007247b877dc214362b5cf339a22e43f5a9226f0ea7701079d8b8f91c425e7e",
      "target_id": "ru-id09637",
      "tag": "p",
      "target_sha256": "e95c6611e6d9ee9a57fdb6cbc7a374cdfeb94cad5582b93f2d146d642aa5067d"
    },
    {
      "source_id": "id09638",
      "target": "— Простите, — сказал Мордонт, — но вам известно, генерал, что я ученик в политике и хочу при всяких обстоятельствах извлекать пользу из уроков, которые мой учитель соблаговоляет мне давать.",
      "source_sha256": "b55f4a83230d5de7c54f9bfb0be10aac210c2d1930fd9edc171309711847dad2",
      "target_id": "ru-id09638",
      "tag": "p",
      "target_sha256": "0a0592c08a7b9dc7feb06a1b7bd2ca6690f5c947e2c4a0de3d5108f14909e389"
    },
    {
      "source_id": "id09639",
      "target": "— Потому что стали бы говорить, будто я велел осудить его из справедливости, а дал ему бежать из милосердия.",
      "source_sha256": "d34c8e1a7b72f0a99b50f3803eab71541c3eca1db87d73cf3f8b5aa8810e44a1",
      "target_id": "ru-id09639",
      "tag": "p",
      "target_sha256": "c2c32f584412cabd20f914c551de779d577e7570da173f45778bce83461e078f"
    },
    {
      "source_id": "id09640",
      "target": "— Но если бы он и в самом деле бежал?",
      "source_sha256": "7b07cbfeefb881636ba1fc3d5d3b22f90fefeacbe5d8d90871cf6a9a579c386f",
      "target_id": "ru-id09640",
      "tag": "p",
      "target_sha256": "bb8097a5f983fc1890986916a2b1f77975df28643e4f0d29beb7ae0a044436e6"
    },
    {
      "source_id": "id09641",
      "target": "— Невозможно.",
      "source_sha256": "727dc0506b7fbe6a845b447d96d22621b6edf93037b9ec2e173c6d7634480922",
      "target_id": "ru-id09641",
      "tag": "p",
      "target_sha256": "19872cfacd9316e743888a21f9e89816c4fcbb822dc99efb48fbf56fe0708921"
    },
    {
      "source_id": "id09642",
      "target": "— Невозможно?",
      "source_sha256": "1a887eb66e3dbdefc0ff1403282de70a94af7b44bd2909cdd4f8af6b6c38c3a9",
      "target_id": "ru-id09642",
      "tag": "p",
      "target_sha256": "5c448c1ff6d860b60d8bfb2380fdad71cea26eeb8422014af0777443c39274d7"
    },
    {
      "source_id": "id09643",
      "target": "— Да, мои меры были приняты.",
      "source_sha256": "cb963fb2cec99881fbdd6b30e3e7afdd08fc9dc5628d754923ee88815766dea6",
      "target_id": "ru-id09643",
      "tag": "p",
      "target_sha256": "75856ce1214b19d8d3c8d7ff906d03e4b84e3ccddc995c70a3c7e8efab1f7332"
    },
    {
      "source_id": "id09644",
      "target": "— А знает ли ваша милость тех четверых, что взялись спасти короля?",
      "source_sha256": "65bdc2e120bdc644803cd4a2107af3505e4be58b4f68154475fe913825137177",
      "target_id": "ru-id09644",
      "tag": "p",
      "target_sha256": "302a52d60e301e85e1eeb03b625784d9fcc4e8160c2fd158920d40d891f1ffad"
    },
    {
      "source_id": "id09645",
      "target": "— Это те четыре француза, из которых двоих прислала госпожа Генриетта своему мужу, а двоих — Мазарини мне.",
      "source_sha256": "de87f405592c15ae999a55f871c032df00ad1f9d0199026a8eb62cf70dc53794",
      "target_id": "ru-id09645",
      "tag": "p",
      "target_sha256": "852eee8a857afb9c6f87598db27d09bb88e62fcac958be586d39e06218da8bd2"
    },
    {
      "source_id": "id09646",
      "target": "— И полагаете ли вы, сударь, что Мазарини поручил им делать то, что они сделали?",
      "source_sha256": "d11670ea326076e02e56a514569c51b85e857168dbe7e226f6b1b9684d6cbf72",
      "target_id": "ru-id09646",
      "tag": "p",
      "target_sha256": "0db8e2ea499e5ddb99ea2ac3dccef06364eb699c5cb73fbae92928fc9321d7b9"
    },
    {
      "source_id": "id09647",
      "target": "— Возможно; но он от них откажется.",
      "source_sha256": "781a746b9e69cf7ebb11140f35cf394f8e23d3e8f7ef333be566bf18fd44e3f8",
      "target_id": "ru-id09647",
      "tag": "p",
      "target_sha256": "77aeaf3c146462d4e2b2687d19033f117001db9b38113bbbc677072c5b37639b"
    },
    {
      "source_id": "id09648",
      "target": "— Вы так думаете?",
      "source_sha256": "c0acd61ab4a2f57fa9de81dfaa5b0b6d661bbc0a46b7ccf3ea1cc6a925f8fc46",
      "target_id": "ru-id09648",
      "tag": "p",
      "target_sha256": "23b76228d976f298dbc0d40d4891112605dcdbe7fbce3bb24b5d1e75d05cf1c5"
    },
    {
      "source_id": "id09649",
      "target": "— Я в этом уверен.",
      "source_sha256": "90c5de57d169d13611bd9b1ebacc3fdd7604b77585aeaf0446b0ec931653ae77",
      "target_id": "ru-id09649",
      "tag": "p",
      "target_sha256": "436fc3cea136c6d2bb8a7d5681039237a4205ad79df491c8588917b619d06829"
    },
    {
      "source_id": "id09650",
      "target": "— Почему?",
      "source_sha256": "a8fa7453ebc8a0dbf427ff426d3b569471c511fefc35a91dd136e6ca4f0242f4",
      "target_id": "ru-id09650",
      "tag": "p",
      "target_sha256": "5a7f49277ce4099a8cda575751c41cbe2652b4e11515588f5af4642c420fb08d"
    },
    {
      "source_id": "id09651",
      "target": "— Потому что они потерпели неудачу.",
      "source_sha256": "ebb8bf8020726e9f91b34fd76cd1ad6b05585f7ac3157e381ad85e7922f39f6c",
      "target_id": "ru-id09651",
      "tag": "p",
      "target_sha256": "2e666b836b93ef3782f3772a56f194e2e6a64bf41b120e17ca0f8bce1196e106"
    },
    {
      "source_id": "id09652",
      "target": "— Ваша милость отдали мне двоих из этих французов, когда они были виновны лишь в том, что подняли оружие в защиту Карла I. Теперь же они виновны в заговоре против Англии; угодно ли вашей милости отдать мне всех четверых?",
      "source_sha256": "9f563b150d479fbf5cbfad5c27990ba264dc53e9e3fdf84b7fe916f28fd23654",
      "target_id": "ru-id09652",
      "tag": "p",
      "target_sha256": "de34d9a111641e73661039545ce5bdc79597bcedbdf7fe8923f77c2bf18b9f95"
    },
    {
      "source_id": "id09653",
      "target": "— Берите их, — сказал Кромвель.",
      "source_sha256": "38bc90e55f96031fabae0c9e3c905f67f972a60df2641514a55d8e97bb284f00",
      "target_id": "ru-id09653",
      "tag": "p",
      "target_sha256": "56fa2948c4ffd8353ba3268f06db9049494edb90b8d32f16bdb1c7f18df2d329"
    }
  ],
