{
  "unit": 27,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id03593",
      "target": "— Мой милый друг, — сказал д’Артаньян, — если вы скажете хоть слово, я вышибу вам мозги.",
      "source_sha256": "7357e1ce55a9866a12f4e2c5202b1fdfceabe8b1e45c5d443fd53c7fc53733df",
      "target_id": "ru-id03593",
      "tag": "p",
      "target_sha256": "74862fcc495ee3b9469793f8a6c146b821f5428d9fe8cee315257b99493ceed3"
    },
    {
      "source_id": "id03594",
      "target": "И он показал ему дуло пистолета, который тут же снова сунул под мышку, чтобы продолжать свою работу.",
      "source_sha256": "4172c9f72ee8eb2c298f3dc593d4eadac2ce4c03dcdbbb3f03d6efa068f41770",
      "target_id": "ru-id03594",
      "tag": "p",
      "target_sha256": "37ee1521b6dfbf9e9d81fbaee7e30fce45f55ed0d7a452a50cb3709c659aeac3"
    },
    {
      "source_id": "id03595",
      "target": "— Но, сударь, — сказал управляющий, — известно ли вам, что эти лошади принадлежат г-ну де Монбазону?",
      "source_sha256": "c8054cc90d959ef198572345a54a7259b7d7cbe15691096dc3ad1cc8a9a56fc1",
      "target_id": "ru-id03595",
      "tag": "p",
      "target_sha256": "15a27772bd692ec7003c09ec7b674a8592804a6f0c425de845e0f6a6f1cb6258"
    },
    {
      "source_id": "id03596",
      "target": "— Тем лучше, — сказал д’Артаньян, — должно быть, это хорошие животные.",
      "source_sha256": "ecbf995e9618099077b45805e4f16b2f9b927f297023e182d152323217f86341",
      "target_id": "ru-id03596",
      "tag": "p",
      "target_sha256": "03102cff1672574e64d28508e4cf764f54c2f892b6757beae7f9f05a5b3fd768"
    },
    {
      "source_id": "id03597",
      "target": "— Сударь, — сказал управляющий, пятясь шаг за шагом и пытаясь добраться до двери, — предупреждаю вас, что я сейчас позову своих людей.",
      "source_sha256": "8060ef463dd81a82b750ea2f8b88091d6cee7cd60cbecf9232707430a8a12418",
      "target_id": "ru-id03597",
      "tag": "p",
      "target_sha256": "62c279f192d07c608690a4204bc69bba4f870d437f9640ed623b372297ae67bd"
    },
    {
      "source_id": "id03598",
      "target": "— А я своих, — сказал д’Артаньян. — Я лейтенант королевских мушкетёров, за мной следуют десять гвардейцев, и вот, слышите, как они скачут? Сейчас увидим.",
      "source_sha256": "a353c18727b97cb02e90f7a4115a29645da351dd93c46be9b92345d418cb1419",
      "target_id": "ru-id03598",
      "tag": "p",
      "target_sha256": "0622369e44404b7ec234a669d11bd4c9b8a392f458491c713983dccebc2c8533"
    },
    {
      "source_id": "id03599",
      "target": "Ничего не было слышно, но управляющий испугался, что услышит.",
      "source_sha256": "46bb16a00befe2a6e79cb13287dabeccfcb6578b5f22bb569460ec9c799d4fbd",
      "target_id": "ru-id03599",
      "tag": "p",
      "target_sha256": "cc7b8b5963205a39e82e3f88da1e7f443b3caa96e84e9cd4b351571f5f4041eb"
    },
    {
      "source_id": "id03600",
      "target": "— Готовы, Портос? — сказал д’Артаньян.",
      "source_sha256": "d1d036cfb456307a7e2176115499bc87f9967461486214492ea51bd33affdb4b",
      "target_id": "ru-id03600",
      "tag": "p",
      "target_sha256": "284e35500b1855f0977c13567adce8660f4caafedaf96b8dfef1019bfe2397cd"
    },
    {
      "source_id": "id03601",
      "target": "— Я кончил.",
      "source_sha256": "f723e3a839e6e151fbf0cd4187c3acd08a9e378bb649ba230d90b9b4461fae68",
      "target_id": "ru-id03601",
      "tag": "p",
      "target_sha256": "272968fb94a40350132338e1532c347f50412cc8add49eb5b709498075468baa"
    },
    {
      "source_id": "id03602",
      "target": "— А вы, Мустон?",
      "source_sha256": "3ab56c0e1daa6c059bf874b3c085000cbb1cdf33127840d45247a0bf5bf9ee7c",
      "target_id": "ru-id03602",
      "tag": "p",
      "target_sha256": "db53003759d087eb3ed4eca73a0c39010519d3c0bc430d187bc4f805a3f6088b"
    },
    {
      "source_id": "id03603",
      "target": "— Я тоже.",
      "source_sha256": "c0c45a6b4bb9e58fd3e5ca5a4c657482e4e8796bd14dad15747578e6830af523",
      "target_id": "ru-id03603",
      "tag": "p",
      "target_sha256": "3bf5c31fa57481f6fd9e0bcdce6af15bfbfb94d9a71b636aed54ed74a30eb150"
    },
    {
      "source_id": "id03604",
      "target": "— Тогда в седло, и поехали.",
      "source_sha256": "994aaaef5d434cc53d5987d33db20b10722b3888de8ae32b845ecb0a52c95d77",
      "target_id": "ru-id03604",
      "tag": "p",
      "target_sha256": "20f742530c33030697281296d7797ad79c9ae5bb5d3cc2353cbcb720170f5423"
    },
    {
      "source_id": "id03605",
      "target": "Все трое вскочили на лошадей.",
      "source_sha256": "798b8a282a1fc2467367fcfee02bbd8832aebc8bb3489630f939400152561b4e",
      "target_id": "ru-id03605",
      "tag": "p",
      "target_sha256": "862552e02b2048a45cf50be3704b6bcbf7a7e42929bbc215f8eaf37a7a094875"
    },
    {
      "source_id": "id03606",
      "target": "— Ко мне! — закричал управляющий. — Ко мне, лакеи, и карабины!",
      "source_sha256": "c1fa701aa492b2db6e5a759f0b51230122f0aa2e44d2ff1745d6a5fe50d2089a",
      "target_id": "ru-id03606",
      "tag": "p",
      "target_sha256": "74d80496037450756c40ded64980161cee6c7c5d8c8f206648f528a7e5d49d28"
    },
    {
      "source_id": "id03607",
      "target": "— В путь! — сказал д’Артаньян. — Сейчас будет мушкетная пальба.",
      "source_sha256": "d306bb84e141abb77a7a326a96376db66af843ec7d7a36e9af30ae4507dc67e6",
      "target_id": "ru-id03607",
      "tag": "p",
      "target_sha256": "906bb14d4f0f813de56081181d3df8a032e4b1d7b7d1bb8e84288297480019d1"
    },
    {
      "source_id": "id03608",
      "target": "И все трое помчались, как ветер.",
      "source_sha256": "e4b316f18462dbea3e8423dfd6fe2e640e85906b70bddf864a9a02ad7fee7711",
      "target_id": "ru-id03608",
      "tag": "p",
      "target_sha256": "3996769ba79917fe294bb0658c6745f2e85209c0a8fa7c0955beedcd827d038f"
    },
    {
      "source_id": "id03609",
      "target": "— Ко мне! — взвыл управляющий, а конюх тем временем бежал к соседнему строению.",
      "source_sha256": "25d772a3f5737144035fa7fa2141626a1b8e09a0a2bd5a90020b51c2eaf65f53",
      "target_id": "ru-id03609",
      "tag": "p",
      "target_sha256": "f7aa57f8c9440c98d36380cdabebd8a308df497f025676d1496ca5e2f20dc603"
    },
    {
      "source_id": "id03610",
      "target": "— Смотрите, не убейте ваших лошадей! — крикнул д’Артаньян, разразившись смехом.",
      "source_sha256": "a77382cd07fd693b911e3e65d955b7f2bb3b3e5da1278c4bfb5696bee4f6557b",
      "target_id": "ru-id03610",
      "tag": "p",
      "target_sha256": "b7b1ff845154b2b62d885fb098132dfbd672dc9f06f64366bbda649b4c2a50b6"
    },
    {
      "source_id": "id03611",
      "target": "— Огонь! — отозвался управляющий.",
      "source_sha256": "205575ea3891d9e797fdbbc028895e5537205c047d1ccc6fc31d12108b44df54",
      "target_id": "ru-id03611",
      "tag": "p",
      "target_sha256": "016674ae15f0848994f4d2752d00de60245602a7fda87fc5c598d5cfc1cacc38"
    },
    {
      "source_id": "id03612",
      "target": "Вспышка, подобная молнии, осветила дорогу; затем, одновременно с грохотом выстрелов, трое всадников услышали свист пуль, которые затерялись в воздухе.",
      "source_sha256": "9ec730801719ee70c0e38125982bac2f9be74a15e85b4b006556e3c1414b7794",
      "target_id": "ru-id03612",
      "tag": "p",
      "target_sha256": "a3785d799979f522a9f0a6159659120c4c3b8b9e481696aadda79fdf19e042c7"
    }
  ],
