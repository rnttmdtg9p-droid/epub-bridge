{
  "unit": 27,
  "batch": 7,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id03633",
      "target": "— Ага! Неужели мы их нагнали?",
      "source_sha256": "cbce1beef908867a8f0577e9e5cac0291cd937f93d505c826c981e5348667329",
      "target_id": "ru-id03633",
      "tag": "p",
      "target_sha256": "274d1661d0af5909fb8e2483b0dfc21d9b85fa84966759ec88b06ee83b34735e"
    },
    {
      "source_id": "id03634",
      "target": "— Так! Мёртвая лошадь! — сказал д’Артаньян, возвращая на дорогу свою лошадь, только что шарахнувшуюся в сторону. — Похоже, и они тоже выдохлись.",
      "source_sha256": "88f53dc0edb48a2a8fd67d83b7fcf4bd4b6c7dfb2b4394975ad26d21d7b588b1",
      "target_id": "ru-id03634",
      "tag": "p",
      "target_sha256": "34a908bfe61aa129e5b102eff3712ed0bd5e02ca8a8846947f02b4339b280467"
    },
    {
      "source_id": "id03635",
      "target": "— Кажется, слышен топот отряда всадников, — сказал Портос, пригнувшись к гриве своего коня.",
      "source_sha256": "2eb28953ed8e550427756790cb67de0f10cbb34c3234a0d1a5fafc948629bd1f",
      "target_id": "ru-id03635",
      "tag": "p",
      "target_sha256": "c89649462a93403f535a7e9ced1fc6376558d770e100609806518a936638a0de"
    },
    {
      "source_id": "id03636",
      "target": "— Не может быть.",
      "source_sha256": "727dc0506b7fbe6a845b447d96d22621b6edf93037b9ec2e173c6d7634480922",
      "target_id": "ru-id03636",
      "tag": "p",
      "target_sha256": "16199da8da3936e5b2c56d89b953602a6dca53ff58129f1911edfb4157faa939"
    },
    {
      "source_id": "id03637",
      "target": "— Их много.",
      "source_sha256": "8131787c7d0cbaa527219f2307db8d85fb6f840645e60cc37d59e0e697258790",
      "target_id": "ru-id03637",
      "tag": "p",
      "target_sha256": "51c161b969a9d291bd71f60861f9e76fd9344ee433f1c5f2746b04d8202422ca"
    },
    {
      "source_id": "id03638",
      "target": "— Тогда другое дело.",
      "source_sha256": "e61bdd737702da4449fdb4225d19a9779d7004d7e3db44f18691635ba851cb91",
      "target_id": "ru-id03638",
      "tag": "p",
      "target_sha256": "e91a00f23df235cf5ea6aab17dd20a7eff7c40c792038d8e79b2ad956b3fe395"
    },
    {
      "source_id": "id03639",
      "target": "— Ещё одна лошадь! — сказал Портос.",
      "source_sha256": "d1b524db2839ee33ebbc29941df32b46ed64bfe14ba501c5968daf2d00b4b890",
      "target_id": "ru-id03639",
      "tag": "p",
      "target_sha256": "96364abee26139d1be7a9044b9a727fc16b1ac40f839192165926ae65c7421e2"
    },
    {
      "source_id": "id03640",
      "target": "— Мёртвая?",
      "source_sha256": "517f211d70b8ee7ec11f47eaad8838e4664a9f98a589a0cf8965d6d8a9b663c0",
      "target_id": "ru-id03640",
      "tag": "p",
      "target_sha256": "85d4723af332daba84c1e782c83842a5c6f9f984740e00841406c4603cd52125"
    },
    {
      "source_id": "id03641",
      "target": "— Нет, издыхает.",
      "source_sha256": "469cf54768932bf6c8dad89639f4bcc804273f95a9550a4e983bd18828cd3f72",
      "target_id": "ru-id03641",
      "tag": "p",
      "target_sha256": "b6153a88e8cc92886ef2fba95e9171c10699984bdbcb0ac692f0decd286c0aea"
    },
    {
      "source_id": "id03642",
      "target": "— Осёдланная или расседланная?",
      "source_sha256": "0400f6771e0524e58fe9d45b088178b58a196a0a0a4073171d9f9722b99ae65d",
      "target_id": "ru-id03642",
      "tag": "p",
      "target_sha256": "fb94994a5f0d63de6d4d305914d476506a24700a32af315a1aeb76957948ca34"
    },
    {
      "source_id": "id03643",
      "target": "— Осёдланная.",
      "source_sha256": "3b9acd9fa4d94ac5b6195067f207d6c12ed7e3e942014972dc4a2f9c1284a229",
      "target_id": "ru-id03643",
      "tag": "p",
      "target_sha256": "7a4b3a6ad95309a631b24d62c6fc196c14a949b78f83b2ec99601a0b020fcc27"
    },
    {
      "source_id": "id03644",
      "target": "— Значит, это они.",
      "source_sha256": "ab1768fda8f6737848f8b9d20cedd6bfcf41d9a1648d33ec416713a5cedd9544",
      "target_id": "ru-id03644",
      "tag": "p",
      "target_sha256": "9203e7b31ad639c64d2a680bb06fe5a14055bb108c3eba22d0895d4a84a756e7"
    },
    {
      "source_id": "id03645",
      "target": "— Смелее! Они у нас в руках.",
      "source_sha256": "85d1f6ec358dd787ec3a5bb16ff16fb9a5168af392e3266d59ebd3ac51f188ae",
      "target_id": "ru-id03645",
      "tag": "p",
      "target_sha256": "d1be54edf410c3bf268d428891942664a412a293c18bae46f2c5d73568eacb0c"
    },
    {
      "source_id": "id03646",
      "target": "— Но если их много, — сказал Мушкетон, — то это не они у нас в руках, а мы у них.",
      "source_sha256": "8bae4a108664d83e447fcae4806c39942f22b01a41acdece456537ae2821bf18",
      "target_id": "ru-id03646",
      "tag": "p",
      "target_sha256": "b66f162e79c05a6701787fab2bf943f66856c147b330fa1f4b0a73f04efa03e3"
    },
    {
      "source_id": "id03647",
      "target": "— Полно! — сказал д’Артаньян. — Они сочтут нас сильнее себя, раз мы их преследуем; тогда они испугаются и разбегутся.",
      "source_sha256": "11dde66c64c894d19e1e55e26985f8fbeaeef2b55bda4b4b10d2515014bfa314",
      "target_id": "ru-id03647",
      "tag": "p",
      "target_sha256": "a96459e014fdf22027b5c4b503ead93a18f0dd690fe114a8507f90fb4204f1a1"
    },
    {
      "source_id": "id03648",
      "target": "— Это верно, — сказал Портос.",
      "source_sha256": "22c32fceb0b8ee573f997a97b2a0b5867691c029d226ca67322d7dca35724122",
      "target_id": "ru-id03648",
      "tag": "p",
      "target_sha256": "9bf5a6bcb56d07d5a24f970c5168ca106495c52f233e0a618b859e829afeae75"
    },
    {
      "source_id": "id03649",
      "target": "— А! Видите? — воскликнул д’Артаньян.",
      "source_sha256": "375f16114b9effc521307fcd43612f1d2bd6c0db9c44cff4330696821885fd3c",
      "target_id": "ru-id03649",
      "tag": "p",
      "target_sha256": "b0959faf122a9b7e251c38e33b1ac1c28d3e7a8e0802d89b71fa78577e9b7eee"
    },
    {
      "source_id": "id03650",
      "target": "— Да, опять искры; на этот раз и я их увидел, — сказал Портос.",
      "source_sha256": "884897a43ed3fae95085b8bf707f5532f36c2201ffcd8f427fec4f81df36dde1",
      "target_id": "ru-id03650",
      "tag": "p",
      "target_sha256": "70ed3c2d0606f6baf3fab090f225e317f5db24e5c6fad226633f0528c813dac6"
    },
    {
      "source_id": "id03651",
      "target": "— Вперёд, вперёд! — сказал д’Артаньян своим пронзительным голосом. — Через пять минут мы посмеёмся.",
      "source_sha256": "2ef49bbe07a318c3da3ab18715a07e34e5250ee1c9bb2bb4b84c0c3fc2c07339",
      "target_id": "ru-id03651",
      "tag": "p",
      "target_sha256": "8e4f176bf0251eea7deccdbb7f9fac0c536f9f1c89691743b7267075d8e4a838"
    },
    {
      "source_id": "id03652",
      "target": "И они снова ринулись вперёд. Лошади, обезумевшие от боли и соперничества, летели по тёмной дороге, посреди которой начинала виднеться масса более плотная и более тёмная, чем остальной горизонт.",
      "source_sha256": "843b93747b05dcf8365c0980ebf286c913a01a198d521022f606320109640b54",
      "target_id": "ru-id03652",
      "tag": "p",
      "target_sha256": "3c1dc7100f7cab84c369d430a6dc8a00494db2f306283f77073231b8e7042563"
    }
  ],
