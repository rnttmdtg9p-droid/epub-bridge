{
  "unit": 27,
  "batch": 3,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id03553",
      "target": "В этот миг послышалось ржание.",
      "source_sha256": "88c84ff64e64c9c4e855c73c71f531739ba38c6d389e9f1529cf2b8313355c02",
      "target_id": "ru-id03553",
      "tag": "p",
      "target_sha256": "e7b9544628b855ed1eca9e6b076517148a9f64b2591145c0a1b2c901fe8e4af6"
    },
    {
      "source_id": "id03554",
      "target": "— Тсс! — сказал д’Артаньян.",
      "source_sha256": "10d1315229e4d91e8f2061b294893935e1db2cbaa094e529f6dd2fb9b698c082",
      "target_id": "ru-id03554",
      "tag": "p",
      "target_sha256": "aa13e8bd067e54b2ba29da0dbfae2297677ecec62e390b9b6a9a45ed7c2ba6ef"
    },
    {
      "source_id": "id03555",
      "target": "— Что там?",
      "source_sha256": "8dad25a675e936bbea76ec0a701ae328f744941d04bc05e02a543e9b2235e1f4",
      "target_id": "ru-id03555",
      "tag": "p",
      "target_sha256": "034af6cfc7fe2c095202615c2fa1ccf925eddd0e649b9dc8106dff36cb8bf5e8"
    },
    {
      "source_id": "id03556",
      "target": "— Я слышу лошадь.",
      "source_sha256": "8334e0c05b1d2a5b9ec56f16e01611a3677cde32ce0e3739172e9bd3d91644e4",
      "target_id": "ru-id03556",
      "tag": "p",
      "target_sha256": "303e3f6fdf10787985f4d41f10776cec56995c9bf4afa3d9547e9622ceadb27b"
    },
    {
      "source_id": "id03557",
      "target": "— Это конь кого-нибудь из наших товарищей, который нас нагоняет.",
      "source_sha256": "1eda8da99ea72fc0390c4222abf363b5758207edea5c42dfdca7b690fd2e7a41",
      "target_id": "ru-id03557",
      "tag": "p",
      "target_sha256": "9332ffafa8c3a15b48e265f710b2d5fcc5636f374241aebb4ed7b202fe5432e8"
    },
    {
      "source_id": "id03558",
      "target": "— Нет, — сказал д’Артаньян, — это впереди.",
      "source_sha256": "559e1aaa272273255aec9a2cdaf68fa4da69c6cb4397cf8cb5b522c26f0e295b",
      "target_id": "ru-id03558",
      "tag": "p",
      "target_sha256": "cd43c1a0ba5a954523ae370429f8635642617e4a3d97fab04b16c1a503f05c16"
    },
    {
      "source_id": "id03559",
      "target": "— Тогда другое дело, — сказал Портос.",
      "source_sha256": "970028f70af78a04034b324616c6d98b9abf5d7e7c6b941460a6dc17f00543d8",
      "target_id": "ru-id03559",
      "tag": "p",
      "target_sha256": "0b43c78fa92801bcc7f98c614241b551fba7192ffd58d9b1368ed10ff766ef6f"
    },
    {
      "source_id": "id03560",
      "target": "И он в свою очередь прислушался, повернув ухо в ту сторону, которую указал д’Артаньян.",
      "source_sha256": "746d5592b47757bc90670fa08f00426637f632baa6bbc3c62dd6efcbb459e998",
      "target_id": "ru-id03560",
      "tag": "p",
      "target_sha256": "eac6c70b5cf11eba44582428df479e71085af4b539944dbd948cb024e0c575a1"
    },
    {
      "source_id": "id03561",
      "target": "— Сударь, — сказал Мушкетон, который, бросив свою лошадь на большой дороге, пешком нагнал хозяина, — сударь, Феб не выдержал, и…",
      "source_sha256": "49a7e421f572c4ff38b8249c8997d9130d902fc0043eedb2392cb85f19d81902",
      "target_id": "ru-id03561",
      "tag": "p",
      "target_sha256": "4478adbdc407ee18d5c612fe592565088d21a3273765caa3569b9898138e218a"
    },
    {
      "source_id": "id03562",
      "target": "— Да замолчи же! — сказал Портос.",
      "source_sha256": "672a955ac9c816a260d4a4c6e8ad34c4d39a3cd63a18c5ac0582df689b9d9a72",
      "target_id": "ru-id03562",
      "tag": "p",
      "target_sha256": "cde73b5971a17ce2cc837714a3b746b19f87cb77b921fadc14b8bf960db96475"
    },
    {
      "source_id": "id03563",
      "target": "И в самом деле, в это мгновение второе ржание пронеслось, подхваченное ночным ветерком.",
      "source_sha256": "d76eb70d8b01c2f6c505ea03e9f611419fb660a2249c2d8b008a88a4ae963851",
      "target_id": "ru-id03563",
      "tag": "p",
      "target_sha256": "15bf6441b2dc1480d841bdf828777dcd81e99fd086c1ebef885602709f347984"
    },
    {
      "source_id": "id03564",
      "target": "— Это в пятистах шагах отсюда, впереди нас, — сказал д’Артаньян.",
      "source_sha256": "ed84dc7f32e5d6a02e3c5787ffd0c7e0491c549bce7edb2f918070c3bbdb8088",
      "target_id": "ru-id03564",
      "tag": "p",
      "target_sha256": "bb6af6c8551b7ccba48020d6dc9df5aa06f1ef597b560259732b0c9ebb52fce9"
    },
    {
      "source_id": "id03565",
      "target": "— Точно так, сударь, — сказал Мушкетон, — и в пятистах шагах от нас стоит небольшой охотничий домик.",
      "source_sha256": "2162c3b1131d7ddc830129a3de7a840f8718b7826f953a8d9bdba4d04a970c1b",
      "target_id": "ru-id03565",
      "tag": "p",
      "target_sha256": "dd1bfc089f474af9bb73c4002c9576ab31913f086241376c9664b21d105e6b0b"
    },
    {
      "source_id": "id03566",
      "target": "— Мушкетон, твои пистолеты, — сказал д’Артаньян.",
      "source_sha256": "8ed4030ae25fc308b0066437403aa05b3824175a51a311aa6aa4c3641b9bafea",
      "target_id": "ru-id03566",
      "tag": "p",
      "target_sha256": "2470e618b3ead3524aa8c10b258bb40c8f33153824a013ed14f5ccaaec891e4e"
    },
    {
      "source_id": "id03567",
      "target": "— Они у меня в руке, сударь.",
      "source_sha256": "a0e90b67f17fa10ae527ac7e5cdaf57d329eae89ece81af7a89ef4dd2d17fb29",
      "target_id": "ru-id03567",
      "tag": "p",
      "target_sha256": "ad13a431563ab58f38ee382ad9127093bcd461431549b0d17e242fc193c00504"
    },
    {
      "source_id": "id03568",
      "target": "— Портос, возьмите свои из седельных кобур.",
      "source_sha256": "c4b0a048df44f6cf825dcefa5b1e415b2e353fe66c43f021a2ffacf0747cf4fa",
      "target_id": "ru-id03568",
      "tag": "p",
      "target_sha256": "c41a0af34473ed247d6dda8659c95188c13f64c6440a4145a06c4f74227c69f1"
    },
    {
      "source_id": "id03569",
      "target": "— Я их держу.",
      "source_sha256": "886a3649966f72bd7ea3f4b98ec13a4d3e44008f5a09ee15783a9663adea95ef",
      "target_id": "ru-id03569",
      "tag": "p",
      "target_sha256": "6f5da664afc89b2022aea478f56befc93d74d51c4d3c6e9c8fb41204b921f792"
    },
    {
      "source_id": "id03570",
      "target": "— Хорошо! — сказал д’Артаньян, в свою очередь берясь за свои. — Теперь вы понимаете, Портос?",
      "source_sha256": "bdc1ae6a75c6773331db9ece909d136d4ada557baac60903489b4341db651387",
      "target_id": "ru-id03570",
      "tag": "p",
      "target_sha256": "59791c5b723680625e418b5b0144c3ca6828a6411321e03505b0e6d8b226f3a0"
    },
    {
      "source_id": "id03571",
      "target": "— Не совсем.",
      "source_sha256": "4d0d908fb345d6c32134451e04cd18c66693aee0ee2dcb832efd04f07566d18f",
      "target_id": "ru-id03571",
      "tag": "p",
      "target_sha256": "bf8f4d568f141039acb213f1bd0985406e4ff73b0df0c1da6274068fffd9a6ed"
    },
    {
      "source_id": "id03572",
      "target": "— Мы скачем по королевской службе.",
      "source_sha256": "b441329bdca415e6dfc9f85251c06d927b7516ddd43a4d6a37dfa899b55c92cf",
      "target_id": "ru-id03572",
      "tag": "p",
      "target_sha256": "869a3b66da300f3a5e416e577996f52288117b5b12de08dd6b5de85ac2eaea8a"
    }
  ],
