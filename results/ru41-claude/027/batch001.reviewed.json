{
  "unit": 27,
  "batch": 1,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id03513",
      "target": "Д’Артаньян достал из кармана бумагу.",
      "source_sha256": "d01a6376705267ac72a6b7566b598e822954cba6a9d3a85920f2f4f0e75d0bf2",
      "target_id": "ru-id03513",
      "tag": "p",
      "target_sha256": "abbc8d8675945942207d275a3d2732aee44e9efa5c4a63ebf92b616b82cf7222"
    },
    {
      "source_id": "id03514",
      "target": "— Приказ короля, — сказал он.",
      "source_sha256": "460689de58864a157e78bb1fea675aa9a742eb4b28f02af54774025119623213",
      "target_id": "ru-id03514",
      "tag": "p",
      "target_sha256": "072de9f4057033d115c0f8fba9ee39c15569fb04bfdb07bd15a95ee4bd9eaa08"
    },
    {
      "source_id": "id03515",
      "target": "— Тогда говорите с губернатором.",
      "source_sha256": "e0725761679a04a46ee9450b171aa2d5c97a2a45f23d55ca9b4e2d5a7d90fc4a",
      "target_id": "ru-id03515",
      "tag": "p",
      "target_sha256": "29a147ae117d16529702492bb3b410c7452ee3ac08f7ac4522c5157c4e71cd45"
    },
    {
      "source_id": "id03516",
      "target": "— А где губернатор?",
      "source_sha256": "55d8eeb0962758fe2cdf8e98bfb97e81bd4ba7cd7a314847fc9474980bdbbc25",
      "target_id": "ru-id03516",
      "tag": "p",
      "target_sha256": "57f9390553c406c2b2533e6b944431a51c9cf3f89ab51cf7573a96b836b6dbe6"
    },
    {
      "source_id": "id03517",
      "target": "— За городом.",
      "source_sha256": "d0bb63c2b4cdb35eb42d42856778c2d3ab1fbaac67a6f6ffa8cbca8c7bc7c9f9",
      "target_id": "ru-id03517",
      "tag": "p",
      "target_sha256": "6683c66ae8ade106aee5e353409bad967d55c76b1edc100db4e435760f5e88b2"
    },
    {
      "source_id": "id03518",
      "target": "Гнев бросился в лицо д’Артаньяну: лоб его нахмурился, виски налились краской.",
      "source_sha256": "c23cc6769565293e6f5fc73cf9870be8798d5c0f3b063e90ba7f8c1202805ca5",
      "target_id": "ru-id03518",
      "tag": "p",
      "target_sha256": "cf17bfeb91e0b07271ebab5d831f70f5f5716d9e69e2c255a8b6dc569615f3b3"
    },
    {
      "source_id": "id03519",
      "target": "— Ах, негодяй! — сказал он сержанту. — Кажется, ты надо мной смеёшься. Погоди же!",
      "source_sha256": "5d856af745bf0674f7020ecd5d8ac578f8265cf961fcbcb8097850bdb03806ab",
      "target_id": "ru-id03519",
      "tag": "p",
      "target_sha256": "ce9fd235c76c406df049f050f98770662ef2a2c5f727c5e3aac556c860f62f81"
    },
    {
      "source_id": "id03520",
      "target": "Он развернул бумагу, одной рукой протянул её сержанту, а другой достал из седельной кобуры пистолет и взвёл курок.",
      "source_sha256": "da3790e6e0dedb18bba5022c91273478c13a03cc638cd40ce5fab4ebc703dca6",
      "target_id": "ru-id03520",
      "tag": "p",
      "target_sha256": "d3ba2109603e1dc79b48c9826599b872c78e496dbe53782cef269be308d42ab9"
    },
    {
      "source_id": "id03521",
      "target": "— Приказ короля, говорю тебе. Читай и отвечай, не то я вышибу тебе мозги! По какой дороге они поехали?",
      "source_sha256": "7519031ddad1e6fd2c0ee38c41192b40bc33787150b2b3f4586500e10ba7fd96",
      "target_id": "ru-id03521",
      "tag": "p",
      "target_sha256": "bc03113adb599927e6c4f36288ea9d815ce42ac5bcd0e8873432a2305b4b274d"
    },
    {
      "source_id": "id03522",
      "target": "Сержант увидел, что д’Артаньян говорит всерьёз.",
      "source_sha256": "4117af59bd6d4daa6c187574b7eeb9065fc3ecf5b33c8691eb0aadf60722ea85",
      "target_id": "ru-id03522",
      "tag": "p",
      "target_sha256": "8d1556d7028734d8bfa21722a8739fa2b76e26833079d5c0b4a1d1e78e5bfc4c"
    },
    {
      "source_id": "id03523",
      "target": "— По дороге на Вандомуа, — ответил он.",
      "source_sha256": "3ed6178858ecb4692f9d17fd3b3dea0bb8ecb01b364aab794e689a5053ccc16f",
      "target_id": "ru-id03523",
      "tag": "p",
      "target_sha256": "6000afe74a602b9125a6f7f23ce956df6e7975348fcc8920af12a7a5495bf4f6"
    },
    {
      "source_id": "id03524",
      "target": "— А через какие ворота они выехали?",
      "source_sha256": "4ff9f44b5de780d08d5684b210c6c9e5d0b4f6f9d4b0b294ec6a25111bf4f44a",
      "target_id": "ru-id03524",
      "tag": "p",
      "target_sha256": "5ef3ab97d0b98fe4f5cac81536668b288731f4c8e69247a89dfbbdbe9d712123"
    },
    {
      "source_id": "id03525",
      "target": "— Через ворота Сен-Мор.",
      "source_sha256": "ccbf160a8ea7ac7e4c2ff99a1156c448de9175fb6f5c14d69d9da5a88834ac47",
      "target_id": "ru-id03525",
      "tag": "p",
      "target_sha256": "416cf2068ff53ea2ec9a144947b7f3abb416dea4ba320af1342a3fa99ea94562"
    },
    {
      "source_id": "id03526",
      "target": "— Если ты меня обманываешь, негодяй, — сказал д’Артаньян, — завтра же будешь повешен!",
      "source_sha256": "465b89301d9928ff1d69ad90a4f3b504aa365f0ef300b830c8d00bb3c358bd7f",
      "target_id": "ru-id03526",
      "tag": "p",
      "target_sha256": "4efc99f13ea50edda74670ab82513b4a3716fd37394bbca02863216dfafe7b57"
    },
    {
      "source_id": "id03527",
      "target": "— А вы, если их догоните, не вернётесь, чтобы меня повесить, — пробормотал сержант.",
      "source_sha256": "ca5eeef427f2aeb3ff1e0918a784b0a63b52222add01a962b11bacf70db36b61",
      "target_id": "ru-id03527",
      "tag": "p",
      "target_sha256": "a1fc7cd07d2acf2f096eb3f5b7f1c2cf9212c2445202874c496bdbd2430b2616"
    },
    {
      "source_id": "id03528",
      "target": "Д’Артаньян пожал плечами, подал знак своему эскорту и пришпорил коня.",
      "source_sha256": "2ebd1dd0c382769ebeb4ea59f608cd29bfd43e7af7e0ef0904d492b71dd17d3e",
      "target_id": "ru-id03528",
      "tag": "p",
      "target_sha256": "67b01e1fda249945d6f99a76bf58c9bced3f672ba1491dcd331e4908047997f8"
    },
    {
      "source_id": "id03529",
      "target": "— Сюда, господа, сюда! — крикнул он, направляясь к указанным воротам парка.",
      "source_sha256": "8dea1ad89d26bfe601a137a0b3ea1788f621b9ad6723c44daf3bea0e781a7e54",
      "target_id": "ru-id03529",
      "tag": "p",
      "target_sha256": "b5431034fd1039174c58117c236d0f829f9f19f57b1c361805988a8682fd469a"
    },
    {
      "source_id": "id03530",
      "target": "Но теперь, когда герцог бежал, привратник счёл уместным запереть ворота на два оборота ключа. Пришлось заставить его отпереть, как до этого заставили сержанта, и это отняло ещё десять минут.",
      "source_sha256": "25a17b7cc34bfdd2a3296e2aa18dfaf6cec42f868f9cf45f7a33599166013ffb",
      "target_id": "ru-id03530",
      "tag": "p",
      "target_sha256": "23060d9d1a184dc25294058a577d5b1102f6c9fb1bf92e1f54cb6ca81c74d929"
    },
    {
      "source_id": "id03531",
      "target": "Когда последнее препятствие было преодолено, отряд возобновил скачку с прежней стремительностью.",
      "source_sha256": "a3a3002a6c6e58524433f85c257d03b0e64dbc77dc9cf4bc36401896dd9b66ca",
      "target_id": "ru-id03531",
      "tag": "p",
      "target_sha256": "002a8e08caf58c2f1b0b2d3c31a357e82bc3ad4bc33e312f081a55a19798eedc"
    },
    {
      "source_id": "id03532",
      "target": "Но не все лошади продолжали бежать с прежним пылом; некоторые не смогли долго выдерживать эту бешеную скачку; три остановились после часа пути; одна упала.",
      "source_sha256": "df1162916c0997507822cd78060ea61a7e76984e285f9f45d0b1c22e97efab9f",
      "target_id": "ru-id03532",
      "tag": "p",
      "target_sha256": "24dda15b9b2e67091441f3eacb481bb8fea0b66e3ab9fccd5bbb8f74ceb2cf53"
    }
  ],
