{
  "unit": 27,
  "batch": 4,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id03573",
      "target": "— Ну и что?",
      "source_sha256": "2caed6e1ccb03a9e5b3191e4e09dc771bdcca703c589c4b9b2a520a990a050f0",
      "target_id": "ru-id03573",
      "tag": "p",
      "target_sha256": "c3c7c847be433d2b02af850bdfcfd0e3734a843506123820fd38a33c0d05ab04"
    },
    {
      "source_id": "id03574",
      "target": "— Мы реквизируем этих лошадей для службы короля.",
      "source_sha256": "8f419d081507a21a562cbb228475790abe00c848d94b31fdd7fc7d47ec99e493",
      "target_id": "ru-id03574",
      "tag": "p",
      "target_sha256": "89025d85d458222cd29a92ae33f72542d90589ad26aadd246f9b6ae6c20d52d7"
    },
    {
      "source_id": "id03575",
      "target": "— Вот именно, — сказал Портос.",
      "source_sha256": "661c158967ef8e2b61ad4d08b9f4688819d4c3273ad4791eb6a3ba49244ff5b1",
      "target_id": "ru-id03575",
      "tag": "p",
      "target_sha256": "6c78833f8982a1c9b038dc0cc0fe7774a928487434f1905a1fb5e920067eb4d7"
    },
    {
      "source_id": "id03576",
      "target": "— Тогда ни слова — и за дело!",
      "source_sha256": "36bb24343e79ce8271316ca99c8e5384960ffaeed7dc376b4eb9e8f1892cd32f",
      "target_id": "ru-id03576",
      "tag": "p",
      "target_sha256": "75c5408c1b64180c2e2ddcf20d84d1b9d02fd30f505b15d28d271b8ad76c437c"
    },
    {
      "source_id": "id03577",
      "target": "Все трое двинулись вперёд в ночи, безмолвные, как призраки. На повороте дороги они увидели среди деревьев мерцающий огонёк.",
      "source_sha256": "495254433604364e69a577394f1944526da083b07c12c714991943c434cda1c7",
      "target_id": "ru-id03577",
      "tag": "p",
      "target_sha256": "679f9df4ddbf2584569ec962e057ac4aac63dc11733d5d642123e7f517d07604"
    },
    {
      "source_id": "id03578",
      "target": "— Вот и дом, — шёпотом сказал д’Артаньян. — Предоставьте действовать мне, Портос, и делайте то же, что буду делать я.",
      "source_sha256": "68a4fe252c0ffcc8f77d5c453ea61b74d0a5b3f6a3c8097eedb36942359b47c6",
      "target_id": "ru-id03578",
      "tag": "p",
      "target_sha256": "75e5ee767aff319c52de8c5aa4235822a977edc5068e5dea2e3ddbfed470c2fe"
    },
    {
      "source_id": "id03579",
      "target": "Они скользили от дерева к дереву и, никем не замеченные, подобрались к дому на двадцать шагов. Добравшись до этого места, они при свете фонаря, подвешенного под навесом, разглядели четырёх видных лошадей. Слуга их чистил. Рядом лежали сёдла и уздечки.",
      "source_sha256": "49de461fbec0924ac99af218d9561d0dad78e36209bd032d270678dde6aa3bca",
      "target_id": "ru-id03579",
      "tag": "p",
      "target_sha256": "95427a26858f57188b849d8067a30ce21e78e91e1dc46f115d509a7168b6fcfb"
    },
    {
      "source_id": "id03580",
      "target": "Д’Артаньян быстро приблизился, делая знак своим спутникам держаться на несколько шагов позади.",
      "source_sha256": "debeec69976d7d95bd27fa7dd36b5ced6bf0dcc99e7830bee70bcd4c2c16b546",
      "target_id": "ru-id03580",
      "tag": "p",
      "target_sha256": "0bc9d667451f2696e9a83b4fbb3cb3a2aa399bd187fb6d477aad68b587c1a091"
    },
    {
      "source_id": "id03581",
      "target": "— Я покупаю этих лошадей, — сказал он слуге.",
      "source_sha256": "d0c2e98bf2ac0b941ce32858ea4f02930733d3c3357d8fe780be1fcd2e798a09",
      "target_id": "ru-id03581",
      "tag": "p",
      "target_sha256": "d5c572267ac26c1d872b73dd34b3ca5797c8e95de301434ecdba871d708b1df3"
    },
    {
      "source_id": "id03582",
      "target": "Тот обернулся, удивлённый, но ничего не сказал.",
      "source_sha256": "21d35e380b7c559c27d47c1cc8bc963bdfd40eff57301d23ca8e5025cfc13cc5",
      "target_id": "ru-id03582",
      "tag": "p",
      "target_sha256": "9905ea8ea86bce9b0bc9c2b30e4d9993ac81c3fa7985a1ff8b069eae83684fd9"
    },
    {
      "source_id": "id03583",
      "target": "— Ты разве не слышал, любезный? — повторил д’Артаньян.",
      "source_sha256": "524c4e07f2963d19b5b29e1daf391102ba47610babc5eefe5c81404fab0809ce",
      "target_id": "ru-id03583",
      "tag": "p",
      "target_sha256": "4c715ccff683867e9d610c3bb6f896ba66336d70ee293f8d1d3df585278ee7a3"
    },
    {
      "source_id": "id03584",
      "target": "— Слышал, — сказал тот.",
      "source_sha256": "634380b4eabf97041ccac8568967c9b893f80a5760d5d6d436537023b0851835",
      "target_id": "ru-id03584",
      "tag": "p",
      "target_sha256": "253f2751aae194ae500d814003d39ee037dd3c1af7a889e7bc5a0d40236c7b10"
    },
    {
      "source_id": "id03585",
      "target": "— Почему же ты не отвечаешь?",
      "source_sha256": "a12b8f773578b3b17595601ff3f71b908d52ac3bf232fb7b41f6a29c7f3a957d",
      "target_id": "ru-id03585",
      "tag": "p",
      "target_sha256": "1ac2152023ee78b9e64c75e566e2d9bdce9d657ef4073682058d131992929344"
    },
    {
      "source_id": "id03586",
      "target": "— Потому что эти лошади не продаются.",
      "source_sha256": "0ae72813fb7cea61b5e2fc585d07c48003115c54d1c8867822e5900dff3abd0a",
      "target_id": "ru-id03586",
      "tag": "p",
      "target_sha256": "43d6b6c5e4e2cd3a21ff282e054770e85e8eaae5d45a735100e32d5ae7fa3045"
    },
    {
      "source_id": "id03587",
      "target": "— В таком случае я их беру, — сказал д’Артаньян.",
      "source_sha256": "d0a42a64e432f6bc40564318ae3b12359f2e0966b8a60ab12b7f2e81824c1846",
      "target_id": "ru-id03587",
      "tag": "p",
      "target_sha256": "a9ae536889166965d95e65510a0a0ed23365e1a7d6970df1f055aff77764b481"
    },
    {
      "source_id": "id03588",
      "target": "И он положил руку на ту, что оказалась ближе. В ту же минуту появились двое его спутников и сделали то же самое.",
      "source_sha256": "0274e84f1513ad3d06ba35183b30d717e699eff4cb16ffa35acbaaa0339dec42",
      "target_id": "ru-id03588",
      "tag": "p",
      "target_sha256": "e882f9bc8241a8741490e7b5b0ce64d8b10a5feba56d6631c9dfc4a091cdf95c"
    },
    {
      "source_id": "id03589",
      "target": "— Но, господа! — воскликнул лакей. — Они только что проделали перегон в шесть лье, и их расседлали едва с полчаса назад.",
      "source_sha256": "0ebc2269b508f160dce0fb6fd082517fe0a479c36488373bee5d9d0650b3b516",
      "target_id": "ru-id03589",
      "tag": "p",
      "target_sha256": "2c9e3033e9b2b7da7e3f8b2cb89a1abfec14a64da9527f14d316ec6cdf42d7c2"
    },
    {
      "source_id": "id03590",
      "target": "— Получаса отдыха достаточно, — сказал д’Артаньян, — и они только лучше разойдутся.",
      "source_sha256": "b08fe20c0d856815a56012c81d380aeba9a3999331545b183876952627d7217b",
      "target_id": "ru-id03590",
      "tag": "p",
      "target_sha256": "3ba26decbb52c4d0c4b538ef6b041ce25812d1dcb3443b2c084c19364eb94cfd"
    },
    {
      "source_id": "id03591",
      "target": "Конюх позвал на помощь. Некто вроде управляющего вышел как раз в тот миг, когда д’Артаньян и его спутники седлали лошадей.",
      "source_sha256": "5dfc67a6b1961c6d7b1eb6cf4d3e650372f73055240b57132527ce5588b2fb61",
      "target_id": "ru-id03591",
      "tag": "p",
      "target_sha256": "4587224db21ca4cd381cb0eedc7dbbf260fc0c52b44e3f6a3c28ad4ab34f344d"
    },
    {
      "source_id": "id03592",
      "target": "Управляющий хотел заговорить грозным голосом.",
      "source_sha256": "4a4254c39d73482f0e7e2d0712381fa6cc6bf3104cc80809023cefb3fa2d9aee",
      "target_id": "ru-id03592",
      "tag": "p",
      "target_sha256": "8323fa88c32c5b666f0382fe300d9f08bcd054c6ca36cecc9a5f8947df47edd5"
    }
  ],
