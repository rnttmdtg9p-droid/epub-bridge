{
  "unit": 27,
  "batch": 0,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id03493",
      "source_sha256": "4a411e03c9713ca5830cfcc72c5f81d1a91d96991da93932de82be014af78bab",
      "target": "XXVII. Большая дорога",
      "target_id": "ru-id03493",
      "tag": "heading",
      "target_sha256": "b0caf6b0b1496271cf39c734106ee472e1e3b10cc0b17517a6bd653619e28d17"
    },
    {
      "source_id": "id03494",
      "source_sha256": "5d1d55366f3b0722cf8aec238f44c7f7fbe92cbaf08f02296d955cc9fc4ce593",
      "target": "Так они мчались по всей длине предместья Сент-Антуан и по Венсенской дороге; вскоре они оказались за городом, вскоре — в лесу, вскоре — в виду деревни.",
      "target_id": "ru-id03494",
      "tag": "p",
      "target_sha256": "21ba17409c14c8b56c5606e71024b07cb0614c9236c55e74eb11609f9fb5c63b"
    },
    {
      "source_id": "id03495",
      "source_sha256": "ce7091fb9978401119e4a5cb58d7c50c284e4f4048383a2b9da1b5a7c97b7f4b",
      "target": "Казалось, с каждым шагом лошади всё более разгорячались, и ноздри их начинали рдеть, как пылающие горны. Д’Артаньян, вонзив шпоры в бока коня, опережал Портоса не более чем на два фута. Мушкетон следовал в двух корпусах позади. Гвардейцы растянулись за ними, каждый соответственно достоинствам своей лошади.",
      "target_id": "ru-id03495",
      "tag": "p",
      "target_sha256": "7bebf77cc7cf22fd53beb661303ca32ad1d44586c5bcd92781089b92b6ed7e41"
    },
    {
      "source_id": "id03496",
      "source_sha256": "1dd122ea0b3ac54cd170bdf676567bf07d148b6d567466ccaefd6f408d3e90e2",
      "target": "С вершины пригорка д’Артаньян увидел группу людей, остановившихся по ту сторону рва, напротив той части главной башни, что обращена к Сен-Мору. Он понял, что именно здесь бежал узник и что именно с этой стороны он получит сведения. Через пять минут он был у цели, куда один за другим подоспели и гвардейцы.",
      "target_id": "ru-id03496",
      "tag": "p",
      "target_sha256": "9a6325f2e4fc5c867afacaf42aba2f6d78de9e1d598f1b6832bef0fbf2abe7ad"
    },
    {
      "source_id": "id03497",
      "source_sha256": "ff993bd664372151229925d6264b735e4b8d7908bfd039ea9beeb3003eec9cce",
      "target": "Все люди, составлявшие эту группу, были чрезвычайно заняты: они смотрели на верёвку, всё ещё висевшую в бойнице и оборванную в двадцати футах от земли. Глаза их измеряли высоту, и они обменивались множеством догадок. Наверху, по стене, взад и вперёд ходили часовые с растерянным видом.",
      "target_id": "ru-id03497",
      "tag": "p",
      "target_sha256": "4f71b6f1146b4c3ae4f9e444c517f94e15c5c54d00c6504180f80e4c18fb784a"
    },
    {
      "source_id": "id03498",
      "source_sha256": "88b9572898870b263a32abbd4e677461487b88290050d699f07e080258cb983c",
      "target": "Караул солдат под командой сержанта удалял горожан от того места, где герцог сел на коня.",
      "target_id": "ru-id03498",
      "tag": "p",
      "target_sha256": "bee3eedc36ab0db19c683566f29316f14653887029bb70fc1526f476e1fc011c"
    },
    {
      "source_id": "id03499",
      "source_sha256": "c334f9ba476c59d28c9ae0e66094c38f3da387a5239008da75333b9006f119aa",
      "target": "Д’Артаньян поскакал прямо к сержанту.",
      "target_id": "ru-id03499",
      "tag": "p",
      "target_sha256": "297ff98393fbc63254031d6085c33f1490b1aa5bb41bcf160fb2eef1b15a3b89"
    },
    {
      "source_id": "id03500",
      "source_sha256": "2ba335452eea04494e612e43ec78bc420e843ed3edfb6cafc9804a3f4eecc2cb",
      "target": "— Господин офицер, — сказал сержант, — здесь останавливаться не положено.",
      "target_id": "ru-id03500",
      "tag": "p",
      "target_sha256": "2cd08fd3ea8a9f1ae91f26eecd68216c3275da6e70cf4415a19709b130305702"
    },
    {
      "source_id": "id03501",
      "source_sha256": "1e8eb071e6554324cce643cbe3285577a5eff56d7f93636a8437fb2af8d1f910",
      "target": "— Этот приказ не для меня, — сказал д’Артаньян. — Беглецов преследовали?",
      "target_id": "ru-id03501",
      "tag": "p",
      "target_sha256": "a579a41ca68bf64a6e50dc71bef80bf459703be41542ea92820dd6deb09e9fbc"
    },
    {
      "source_id": "id03502",
      "source_sha256": "a319d3f728ed3cd7fec6a5c56f58ce41bc9f4efcd9163a7cc1b648c07251aa92",
      "target": "— Да, господин офицер; к несчастью, они хорошо верхом — кони у них отменные.",
      "target_id": "ru-id03502",
      "tag": "p",
      "target_sha256": "f1399526176dd8518ee8cf482ff5b96c539ddf5797d2d56b7a56e0d07098a7ab"
    },
    {
      "source_id": "id03503",
      "source_sha256": "25b528517356582b5de0623838304cc3b6b0380b38497a2ec5964ec22304b4f6",
      "target": "— А сколько их?",
      "target_id": "ru-id03503",
      "tag": "p",
      "target_sha256": "34f90f36574e3dab3c2a1b300e1266cb7b79cffd697fce54a3b11004a7382acc"
    },
    {
      "source_id": "id03504",
      "source_sha256": "c826885602ee7954eb0bc07866813fc0498974255e9b801fbface9bcd40f7aa3",
      "target": "— Четверо здоровых и пятый, которого они увезли раненым.",
      "target_id": "ru-id03504",
      "tag": "p",
      "target_sha256": "a3997fbe6736eccd0951120d772bb878809471e03be7e413e4a0f5c0c55993d7"
    },
    {
      "source_id": "id03505",
      "source_sha256": "396e870bf90e6cc1f2f49cd399528afc1e9863fa74f55312624d602765465bcb",
      "target": "— Четверо! — сказал д’Артаньян, взглянув на Портоса. — Слышишь, барон? Их всего четверо!",
      "target_id": "ru-id03505",
      "tag": "p",
      "target_sha256": "7ecb7f5e5a73d0943bb2e654266ce93e839f2f97ed179a3ce132fde01bb169e4"
    },
    {
      "source_id": "id03506",
      "source_sha256": "98b119e7f5f2e6bc0a8c6fa5a18093ff3b73b26b42342ff202c8fbbf1e57674a",
      "target": "Радостная улыбка озарила лицо Портоса.",
      "target_id": "ru-id03506",
      "tag": "p",
      "target_sha256": "81c77a6a5391139fe23b9f64cb7f8500c428d47ed9e1ff1cb34b70cf45fe0741"
    },
    {
      "source_id": "id03507",
      "source_sha256": "63c01ee9319b84d4fc1a640bea3001bbc13f1fc033744375c220100822ca8b20",
      "target": "— А какая у них фора?",
      "target_id": "ru-id03507",
      "tag": "p",
      "target_sha256": "bb00a8b1b2220cd5c084464aab0bf809ffb1ebaa26d8eb4d8c87ab494338c694"
    },
    {
      "source_id": "id03508",
      "source_sha256": "fea507e5ce5ee879d9b4276da86394658851fe1fdd89ca5b53c138ef1d3369c1",
      "target": "— Два часа с четвертью, господин офицер.",
      "target_id": "ru-id03508",
      "tag": "p",
      "target_sha256": "af65f9ef2fd44b8e3104f883defae8c450b70666685b7df974d48f21ee56c268"
    },
    {
      "source_id": "id03509",
      "source_sha256": "fa034ef6d6b1dcf8ad3a451a89a2b778dea4b2c70c02b16e14ba8d8e843c3d27",
      "target": "— Два часа с четвертью — это пустяки, у нас хорошие кони, не правда ли, Портос?",
      "target_id": "ru-id03509",
      "tag": "p",
      "target_sha256": "357347ad9e5fb2d12f799458146e7c4de395af9bf73424d6eee499704f02d9a6"
    },
    {
      "source_id": "id03510",
      "source_sha256": "9332f2f63a5992f8494e9e13396528d639d831708f55f0bb2b6947855ec1d6a1",
      "target": "Портос вздохнул: он подумал о том, что ожидает его бедных лошадей.",
      "target_id": "ru-id03510",
      "tag": "p",
      "target_sha256": "873d8a4ea32832cb461656959ba90b8f3fff3fbd9ab7e1bfa62bc515dc90cc3f"
    },
    {
      "source_id": "id03511",
      "source_sha256": "7e9e1604c6d74e3dbfa417ae0bfba5922fa849ff3a22d702e41ac5ba67113499",
      "target": "— Прекрасно, — сказал д’Артаньян, — а теперь скажите, в какую сторону они уехали?",
      "target_id": "ru-id03511",
      "tag": "p",
      "target_sha256": "c87a855edc24f4b23ab66e7a89750498ebb85a4a09e1c48802499442d42f8bb7"
    },
    {
      "source_id": "id03512",
      "source_sha256": "060c376ab6d05ddbd85ad5acd03555a9fde3bc5c23cf27778a1cb591dc21a089",
      "target": "— Об этом, господин офицер, говорить запрещено.",
      "target_id": "ru-id03512",
      "tag": "p",
      "target_sha256": "6f0bb3715bc93cb8ab434a781554825bd2a7eda3ee28ddd35dcd0de056a128c6"
    }
  ],
