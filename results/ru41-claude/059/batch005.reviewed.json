{
  "unit": 59,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id08048",
      "target": "— Сдавайтесь, — сказал он ему, пристально глядя на него.",
      "source_sha256": "925316733dbcb268c69a40a0f5212b1c8dce577b9b9889acb398c0d0d09ac5a4",
      "target_id": "ru-id08048",
      "tag": "p",
      "target_sha256": "befc0c38478df5f60b9df77ba9001fde5c26ab2fb9fa60bfaa6d16fa55f15193"
    },
    {
      "source_id": "id08049",
      "target": "Арамис поднимает голову, Атос оборачивается.",
      "source_sha256": "6dfeb442c838800bd170b3961978e2385a1260cf5b51552416e2f973fcecc143",
      "target_id": "ru-id08049",
      "tag": "p",
      "target_sha256": "e2b5957fc040be9b94a178d064566c7390224f31702f79a517e0d695d9f000d9"
    },
    {
      "source_id": "id08050",
      "target": "— Д’Арт… — вскричал Атос, но гасконец закрыл ему рот рукой.",
      "source_sha256": "09b8625da1b1602d6be61ee6e647105cb552c1772c11f4b35352b276d111eab2",
      "target_id": "ru-id08050",
      "tag": "p",
      "target_sha256": "15469caa2833acd64e3eafd1cb8f1a53d6bf23dd1712972a4487428dbceba23c"
    },
    {
      "source_id": "id08051",
      "target": "— Я сдаюсь, — сказал Арамис, протягивая свою шпагу Портосу.",
      "source_sha256": "8f710e5eb8b19150e19f9a1a06b06df9ade5535e151945d31b768354e13a0bc6",
      "target_id": "ru-id08051",
      "tag": "p",
      "target_sha256": "2478cb4648f09850a1d3a7398a0876bae17d22b68f53d548c7c1375c9ad75710"
    },
    {
      "source_id": "id08052",
      "target": "— Огонь! Огонь! — кричал Мордаунт, возвращаясь к группе, где находились два друга.",
      "source_sha256": "be96f1a0350c1fd13929761de9d8a9d2b70ab41b000f22fe5042a79b55590426",
      "target_id": "ru-id08052",
      "tag": "p",
      "target_sha256": "2d9eecdb483dd31544f26ac57cfdf7042964f9160c6fb35a9169b05d9ad3536e"
    },
    {
      "source_id": "id08053",
      "target": "— А почему огонь? — сказал полковник. — Все сдались.",
      "source_sha256": "6a14472d265597bfced54c0d3086c9afad7df0204dd9c502bdbc55839d42ddf0",
      "target_id": "ru-id08053",
      "tag": "p",
      "target_sha256": "e2a46d8862799fbf506f9f3ef23c8c5fe42601bc21c7203decde669af791aed4"
    },
    {
      "source_id": "id08054",
      "target": "— Это сын Миледи, — сказал Атос д’Артаньяну.",
      "source_sha256": "d5b56ad8896c1b5d8f0b6e41e4f94022ad113be87752e5b963919ce5e687f158",
      "target_id": "ru-id08054",
      "tag": "p",
      "target_sha256": "5ac4b7644130907c17606c5a9efefa2f5f12268c80c808055139649f05c7320e"
    },
    {
      "source_id": "id08055",
      "target": "— Я его узнал.",
      "source_sha256": "32793d07866c412aad166b0be2130a7ccd946dab65861d007faf2a72232c3914",
      "target_id": "ru-id08055",
      "tag": "p",
      "target_sha256": "09ee00650eabc155f1a40d3f81a04b1e8979ad8ccad3d0041108a668be0de063"
    },
    {
      "source_id": "id08056",
      "target": "— Это монах, — сказал Портос Арамису.",
      "source_sha256": "3529f741c86170980e40b49afc6214e5f65c268bd6d53156ce56d1a9e98b08ee",
      "target_id": "ru-id08056",
      "tag": "p",
      "target_sha256": "9849810192f9c16e060e0e6719de35833f628f2787ef68e769fac5dd887d36bc"
    },
    {
      "source_id": "id08057",
      "target": "— Знаю.",
      "source_sha256": "fe2310c329e9adf8364558b96da4abf6b483886867150a9723e93f15d5782784",
      "target_id": "ru-id08057",
      "tag": "p",
      "target_sha256": "3a2702d40f5db907f6b67aa9cf199dd288808ef729b56862e96d9b7510247e81"
    },
    {
      "source_id": "id08058",
      "target": "Тем временем ряды начали раздвигаться. Д’Артаньян держал под уздцы лошадь Атоса, Портос — лошадь Арамиса. Каждый из них старался увести своего пленника подальше от поля битвы.",
      "source_sha256": "9a12ef3ea274fa30374293a28b9e4e5dc014a44da67013ef40a69cc1b5588cb4",
      "target_id": "ru-id08058",
      "tag": "p",
      "target_sha256": "6704ae131c56ed212abaff20d4d83bf19f9ea4033f4c91ead63ec4a7625755ec"
    },
    {
      "source_id": "id08059",
      "target": "Это движение открыло то место, где упало тело де Винтера. По инстинкту ненависти Мордаунт отыскал его и, склонившись в седле, глядел на него с отвратительной улыбкой.",
      "source_sha256": "ca196b2eae318064ef59dda43f468c5944647876fb6f79df8bc73877b75c12bf",
      "target_id": "ru-id08059",
      "tag": "p",
      "target_sha256": "7b7aa3488fe11abd84c6b0c0b5da2ee9831d7248fcdbf05cd83598ebe07c84d8"
    },
    {
      "source_id": "id08060",
      "target": "Атос, как ни был он спокоен, положил руку на седельные кобуры, где ещё оставались пистолеты.",
      "source_sha256": "36ca7fd0577d6b2a29c507b995df9bdb010c7886b784dc81d0c5f8df34d70cba",
      "target_id": "ru-id08060",
      "tag": "p",
      "target_sha256": "86b59f9675b14551d925ab0137df19ba94fe1af1077d402227fee2270fb23d65"
    },
    {
      "source_id": "id08061",
      "target": "— Что вы делаете? — сказал д’Артаньян.",
      "source_sha256": "8c404b847ad75fb1d54ced413f9581ef291e88fcb7fafa7fefc5ee5a997c9ce1",
      "target_id": "ru-id08061",
      "tag": "p",
      "target_sha256": "90f20a32f23f270b14becbf6c4e41b0f34e06262a7571f799b984fe2a2f110bc"
    },
    {
      "source_id": "id08062",
      "target": "— Позвольте мне убить его.",
      "source_sha256": "ce75ae209ae9d3bda4dbbd86b9ba3050f0d5cf347161188fa6490efb83d0890f",
      "target_id": "ru-id08062",
      "tag": "p",
      "target_sha256": "43b787c2d37335f1649d594c9faa9d0949052b0f9cc83ae5de032b08336d7b5d"
    },
    {
      "source_id": "id08063",
      "target": "— Ни одного жеста, по которому можно было бы подумать, что вы его знаете, иначе мы погибли все четверо.",
      "source_sha256": "617636265134cd2f041f77bcad2c377630d5ec4787a1eefafa95a1256632fcc1",
      "target_id": "ru-id08063",
      "tag": "p",
      "target_sha256": "ae270a9430e83c0ffdf415e150efd4b50f4ae5f15832f9f71f43708d5be48c19"
    },
    {
      "source_id": "id08064",
      "target": "Затем, повернувшись к молодому человеку:",
      "source_sha256": "d4f6f57ff672b41cd28cea90e36d29881e85b67a7dea8312ff76b7cd7c5d3cda",
      "target_id": "ru-id08064",
      "tag": "p",
      "target_sha256": "2e5ce30503b55c48165abc8f7268910275a5285d6477b46f4e58b5f4f33c88ae"
    },
    {
      "source_id": "id08065",
      "target": "— Хорошая добыча! — воскликнул он. — Хорошая добыча, друг Мордаунт! У каждого из нас по пленнику, у господина дю Валлона и у меня: кавалеры ордена Подвязки, не больше и не меньше.",
      "source_sha256": "9fb7487a7270482150170a7da3abd9d3acc1da92fa710fc66cd85261340c52b6",
      "target_id": "ru-id08065",
      "tag": "p",
      "target_sha256": "9c6da470e77e98e1c928567501670a65a4b32665f7d1e38b06bba224651d7c64"
    },
    {
      "source_id": "id08066",
      "target": "— Но, — воскликнул Мордаунт, глядя на Атоса и Арамиса налитыми кровью глазами, — но ведь это французы, как мне кажется?",
      "source_sha256": "76d5a3bf261165e68062860af3dc665856f75efdf5f4aaafc931a6108d6b3a83",
      "target_id": "ru-id08066",
      "tag": "p",
      "target_sha256": "96c316e6840b78e0f45696c5835596ac22c16c81aba9f538d1082c73413b204e"
    },
    {
      "source_id": "id08067",
      "target": "— Право, не знаю. Вы француз, сударь? — спросил он Атоса.",
      "source_sha256": "41c404aa31b83c54778bcdbc2a986ec306aceaff0a1e60425c6013348e4f4b87",
      "target_id": "ru-id08067",
      "tag": "p",
      "target_sha256": "54daf3cf1675123394eb1c84be9c74e249835e554f9a4333aceb9a106fa67007"
    }
  ],
