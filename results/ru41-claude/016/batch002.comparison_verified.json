{
  "unit": 16,
  "batch": 2,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id01870",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id01870",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "id01871",
      "target": "— Вы слышали о нём когда-нибудь?",
      "source_sha256": "efc071ffeaca8f20250f6928d6a053eb6198871dc805386e400bf30579ed378e",
      "target_id": "ru-id01871",
      "tag": "p",
      "target_sha256": "b58f0cf6061eb2687c1cb8443a159c9f143c754549193fd357c1542a39025e1d"
    },
    {
      "source_id": "id01872",
      "target": "— Никогда.",
      "source_sha256": "d3bde89d68e972b67a1ed046c32267bfc02088ddda7adbbc16a5b6569f9cbda2",
      "target_id": "ru-id01872",
      "tag": "p",
      "target_sha256": "6c1c9778fffa852af7ec721ad4fe3db66fd677f7f188a2ad1f44b15faf7a487a"
    },
    {
      "source_id": "id01873",
      "target": "— Ему должно быть двадцать три года, — пробормотал Атос. — Я часто думаю об этом молодом человеке, д’Артаньян.",
      "source_sha256": "f2a5c99217ee67a1f793ff147c5c112003708ae4222c55dbb2fc358ec2268584",
      "target_id": "ru-id01873",
      "tag": "p",
      "target_sha256": "abb27807cb58b19eac030a0c9a612df71f3ed10d54b9d3bf9df0e344d4f78881"
    },
    {
      "source_id": "id01874",
      "target": "— Странно! А я-то о нём забыл!",
      "source_sha256": "bfc58ef8b51c695805329ec9ad694a3eeb4421353e71a7aff68917c4159b525c",
      "target_id": "ru-id01874",
      "tag": "p",
      "target_sha256": "56794c6cc6f12a03dd1ea8b04a23dd7e86b306d799ed08176153b7630bde5014"
    },
    {
      "source_id": "id01875",
      "target": "Атос печально улыбнулся.",
      "source_sha256": "6c282bfe90d7c7235d1f8721280cb0c94e08921e13bf5a8161f6df3445545874",
      "target_id": "ru-id01875",
      "tag": "p",
      "target_sha256": "5d359b6240d78cca27f118b0c0e3070e69e3a4d57478fa869e14383e776948d0"
    },
    {
      "source_id": "id01876",
      "target": "— А лорд Винтер — есть ли у вас о нём какие-нибудь вести?",
      "source_sha256": "4428073883e442a302ca3a6860d8d66b2657f100d48d3dfec10f289245d68514",
      "target_id": "ru-id01876",
      "tag": "p",
      "target_sha256": "780b0d7d8e65728f9c93468a6f01ed983abb1a3355a67c02cd21f53c27d96080"
    },
    {
      "source_id": "id01877",
      "target": "— Знаю, что он был в большой милости у короля Карла I.",
      "source_sha256": "1749b8d4f402e0c33b240511414753dc99d175b8863c20e921b3b50000ee4031",
      "target_id": "ru-id01877",
      "tag": "p",
      "target_sha256": "2c965fb14bbf61bc67bc4f8285a3eeb78177c5cbd8e21d05ad5ff5505e9ff759"
    },
    {
      "source_id": "id01878",
      "target": "— Он, должно быть, последовал за его судьбой, а она сейчас скверна. Вот видите, д’Артаньян, — продолжал Атос, — это возвращается к тому, что я вам только что сказал. Он позволил пролиться крови Страффорда; кровь взывает к крови. А королева?",
      "source_sha256": "5ba77f52f7c68587c7482381318eb112ea1bab4b890dc90568de8f56dfbc4c72",
      "target_id": "ru-id01878",
      "tag": "p",
      "target_sha256": "1e475e5874c3795f07a0ccc3137a286af35870d777ef1f74360c85dd8393b0cd"
    },
    {
      "source_id": "id01879",
      "target": "— Какая королева?",
      "source_sha256": "b98c7aab7cda527d2328314f1e4f6b9e24e43a41da2c562ea0f754ba17684e41",
      "target_id": "ru-id01879",
      "tag": "p",
      "target_sha256": "8daac95b470e779aba443f9c90f00e228477420ba4261e7eb3db114a7d7ea7c3"
    },
    {
      "source_id": "id01880",
      "target": "— Госпожа Генриетта Английская, дочь Генриха IV.",
      "source_sha256": "b94b690f59f0372b8ab32d22014f6361fe9966cf0f17827094ddbfcb7ff78b1b",
      "target_id": "ru-id01880",
      "tag": "p",
      "target_sha256": "62b90a573f9ef5f0a9e73b0aa12071b2ee590fd4bf202f7c067e0d570473b5d7"
    },
    {
      "source_id": "id01881",
      "target": "— Она в Лувре, как вы знаете.",
      "source_sha256": "dab4612fe4e06d9dbcab31d2abf50842b0edb51eba24baf3f9f505828deb766a",
      "target_id": "ru-id01881",
      "tag": "p",
      "target_sha256": "42723a60e413f68a0d3359d3df882756c82c4775d2b32c8a44af854e18847dc5"
    },
    {
      "source_id": "id01882",
      "target": "— Да, где ей всего недостаёт, не так ли? Во время сильных холодов этой зимы её больная дочь, как мне говорили, вынуждена была из-за отсутствия дров лежать в постели. Вы это понимаете? — сказал Атос, пожав плечами. — Дочь Генриха IV дрожит от холода из-за недостатка вязанки хвороста! Почему она не пришла просить приюта у первого встречного из нас, вместо того чтобы просить его у Мазарини! Она ни в чём не терпела бы нужды.",
      "source_sha256": "0f6e763072736398fd6931ffc3a51d7ed7e7393966ff47904a984505c9c46104",
      "target_id": "ru-id01882",
      "tag": "p",
      "target_sha256": "d12abeb7f153b87302580ee474915f123935b69bdd2bc103a8081fa5a653eb94"
    },
    {
      "source_id": "id01883",
      "target": "— Так вы её знаете, Атос?",
      "source_sha256": "a60cb25dc00e5135039d5f949d18ef7f081683247165139d3b643c6a379971fe",
      "target_id": "ru-id01883",
      "tag": "p",
      "target_sha256": "57bdcefa4a80d661a10b5266fec7fda78d9e496ba4613178513d166b7cfb11ca"
    },
    {
      "source_id": "id01884",
      "target": "— Нет, но моя мать видела её ребёнком. Говорил ли я вам когда-нибудь, что моя мать была статс-дамой Марии Медичи?",
      "source_sha256": "bc868536d55315ccaa09c206ff9f15f5bcaf1ba316b3fcb825cb9310c7f22972",
      "target_id": "ru-id01884",
      "tag": "p",
      "target_sha256": "72b089988fd7569a65a1e28182d3cf777cd8c7c3786ab2bcceff47baee897038"
    },
    {
      "source_id": "id01885",
      "target": "— Никогда. Вы не говорите о таких вещах, Атос.",
      "source_sha256": "05437b012c1e29fb650263151149cf0fe8b863320311be267b730e2bdc043574",
      "target_id": "ru-id01885",
      "tag": "p",
      "target_sha256": "83f40d497f00b1b0829a01923b8a3eaae12d88790769c25c50e8e27354a5f1a6"
    },
    {
      "source_id": "id01886",
      "target": "— Ах, Боже мой, говорю, как видите, — отвечал Атос, — но для этого нужно, чтобы представился случай.",
      "source_sha256": "d8be921998af653241789edc834bed3bfbca57043d1528d0445461be7e60c935",
      "target_id": "ru-id01886",
      "tag": "p",
      "target_sha256": "b489b2515d74bddf0193a74d2f445f2624bd626ecffcadb71840f67b9fbbe849"
    },
    {
      "source_id": "id01887",
      "target": "— Портос не ждал бы его так терпеливо, — сказал д’Артаньян с улыбкой.",
      "source_sha256": "e8e0badf4a821307633cc14a142baa91ce06487455b4b21b4ba147f9eb60b348",
      "target_id": "ru-id01887",
      "tag": "p",
      "target_sha256": "e80f2405be5305e2f24bf62a833029ddac7c9731fcbca86cfdc96f6d27bed910"
    },
    {
      "source_id": "id01888",
      "target": "— У каждого своя натура, мой дорогой д’Артаньян. У Портоса, при некоторой доле тщеславия, превосходные качества. Вы видели его снова?",
      "source_sha256": "1053e9359c2e95fc2cefa3c770a3644e4a11af9e58766bbf41adc3194f34d29e",
      "target_id": "ru-id01888",
      "tag": "p",
      "target_sha256": "9ad55ae3684e9b73f18e704199cbb596e85868e419f19fa69d886db92f3dd663"
    },
    {
      "source_id": "id01889",
      "target": "— Я расстался с ним пять дней назад, — сказал д’Артаньян.",
      "source_sha256": "4ff17ccbb908d8dbbce4fc273d005a1e4a436f37c96fa66a52cd64c8ee2b60e3",
      "target_id": "ru-id01889",
      "tag": "p",
      "target_sha256": "d8f750c186b81ec5efc78c7a18a6fae522e18e4eafc3d892714ce767b958b249"
    }
  ],
