{
  "unit": 14,
  "batch": 3,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id01698",
      "source_sha256": "1ec3af3a32d569bf2fea81363bf269d85eb3e3026bea2abd9c676bc1156e2e88",
      "target": "— А для утомительных переходов?",
      "target_id": "ru-id01698",
      "tag": "p",
      "target_sha256": "dc12fa2487431fdd494eb273b80cbbef1454d186d1b7f758dc0bba5a99f8ff59"
    },
    {
      "source_id": "id01699",
      "source_sha256": "32d1a43784aa06e18e290925c58658b366e7950853b895699bd6a5b709cc5057",
      "target": "— Баярд.",
      "target_id": "ru-id01699",
      "tag": "p",
      "target_sha256": "0f9898b48240692799bd0aaad771db2fb11473c07157ac469b3aa2d8e8dfa291"
    },
    {
      "source_id": "id01700",
      "source_sha256": "01857c52fb594ff7449c60d791685daee68034c16d2f0d372b68db089b1880f1",
      "target": "— А какая лошадь нравится тебе самому?",
      "target_id": "ru-id01700",
      "tag": "p",
      "target_sha256": "0652c377b0289a87c95a6e2df2b125c48d3816213cd3bc60f14caf88a4d18518"
    },
    {
      "source_id": "id01701",
      "source_sha256": "f9df99e5f4196914234c1359a6e363c9bf0996ff3501a25a2ca0b5cc63367878",
      "target": "— Мне нравится Рюсто, монсеньор; это славная скотинка, мы с ней прекрасно ладим.",
      "target_id": "ru-id01701",
      "tag": "p",
      "target_sha256": "ca25d277c21623cdc421e2de00593f4710d547f8613e8fce7ecc68f67bdb4f00"
    },
    {
      "source_id": "id01702",
      "source_sha256": "0430788727b50742228b52f11da66ea0c78b09d45e3b0b79a5af0f2b3d1a16b3",
      "target": "— Она ведь выносливая, не так ли?",
      "target_id": "ru-id01702",
      "tag": "p",
      "target_sha256": "1a0c0a5a14b1c04ac0a03a3acac32abf9de7dd5e0ab1ea206cce377ecf1b3b1e"
    },
    {
      "source_id": "id01703",
      "source_sha256": "f8a43312413fc013753923c2d9041592dc0e9b2dd6ef38bb1f09113ca678c826",
      "target": "— Нормандская, скрещённая с мекленбургской: пойдёт и днём и ночью.",
      "target_id": "ru-id01703",
      "tag": "p",
      "target_sha256": "185e71f02b8c156b29569f069df92c50e69b00ea0adde40eb6409b18efcdfb97"
    },
    {
      "source_id": "id01704",
      "source_sha256": "2b95ac0869146acbc7406d00c948879a19b1540e75043807a3b505546769fa88",
      "target": "— Вот это нам и нужно. Ты поправишь силы всем трём лошадям, вычистишь или прикажешь вычистить моё оружие; кроме того, пистолеты для тебя и охотничий нож.",
      "target_id": "ru-id01704",
      "tag": "p",
      "target_sha256": "62a90122f76a71759cdfbef8e0b358b491b1d4f70feee99a45e0d60986e093a3"
    },
    {
      "source_id": "id01705",
      "source_sha256": "6c840b7598d07573ed82833bead1405fe7d7c78d221aaaf22ab53fb50e937169",
      "target": "— Значит, мы отправимся в дорогу, монсеньор? — спросил Мускетон с тревогой.",
      "target_id": "ru-id01705",
      "tag": "p",
      "target_sha256": "3669ba81cc38b1ee0c782fea55d59b6c96fae49ae0555ec57c10cb0fbdc35fca"
    },
    {
      "source_id": "id01706",
      "source_sha256": "c60ab69791c080e64c57ac1b60543600f284421b4fb84a1ae8576d73d629f6d8",
      "target": "Д’Артаньян, который до сих пор брал лишь неопределённые аккорды, ударил марш.",
      "target_id": "ru-id01706",
      "tag": "p",
      "target_sha256": "52f48187532c44485ea6e97e9d34466dcbdcc62f8b7186ba16daff99895565e4"
    },
    {
      "source_id": "id01707",
      "source_sha256": "9e4e3bb675254c9df3f90902a19dc46579f0983a959023a69edea92183be8d58",
      "target": "— Больше того, Мустон! — ответил Портос.",
      "target_id": "ru-id01707",
      "tag": "p",
      "target_sha256": "796596de4fc5d5f9bacb1b9485846a092d46ced824a31f6db47c844c95ec2c04"
    },
    {
      "source_id": "id01708",
      "source_sha256": "da08a7e1c52fb2756df69b280e6193c50b3796bb339cd8a8373980af19c41f02",
      "target": "— Мы отправляемся в поход, сударь? — спросил управляющий, чьи розы начали обращаться в лилии.",
      "target_id": "ru-id01708",
      "tag": "p",
      "target_sha256": "31eadd6431b95427aee029f630b37adee0e5a634baa1c489407e67974c9670e9"
    },
    {
      "source_id": "id01709",
      "source_sha256": "7e5ce42a05f5e52110132812a5a09700505f51f74d16f0ec01fc7ddbc29693c8",
      "target": "— Мы возвращаемся на службу, Мустон! — ответил Портос, всё ещё пытаясь вернуть усам тот воинственный изгиб, который они утратили.",
      "target_id": "ru-id01709",
      "tag": "p",
      "target_sha256": "de758c81d8e30dad346949d33ca79b2333491c1eaf758378a1f7d979f9f431e5"
    },
    {
      "source_id": "id01710",
      "source_sha256": "55cec5015271e8834558c7d62c73117c6be67cb96ce867ec43b477324e6f789b",
      "target": "Едва были произнесены эти слова, как Мускетона охватила дрожь, заколыхавшая его толстые пятнистые щёки; он взглянул на д’Артаньяна с невыразимым нежным упрёком, которого офицер не смог вынести, не растрогавшись; потом он пошатнулся и сдавленным голосом проговорил:",
      "target_id": "ru-id01710",
      "tag": "p",
      "target_sha256": "dcd1c7e30b4a5142a4e3dfefb70f38487cc9947cc0beb5c4c8f96728bba4eae3"
    },
    {
      "source_id": "id01711",
      "source_sha256": "530f0c5333ec59a3c5b52f303af76f493a08cb17e841fd6dd3d4183dae07b3e2",
      "target": "— На службу! На службу в королевской армии? — сказал он.",
      "target_id": "ru-id01711",
      "tag": "p",
      "target_sha256": "abf2f0e642e2e16293c80a069c7741e2435ecce4199041b04a8d01ed1dcec982"
    },
    {
      "source_id": "id01712",
      "source_sha256": "45eb47622af8d7c9424976a389303f734c81ff30a670f881f10d05b067957343",
      "target": "— И да и нет. Мы снова отправимся в поход, будем искать всяческих приключений, словом, вернёмся к прежней жизни.",
      "target_id": "ru-id01712",
      "tag": "p",
      "target_sha256": "7f6a6c22b62fdb97a40b55b3a34dc089aefc0c36f412a3c095d8cbe48963c8ad"
    },
    {
      "source_id": "id01713",
      "source_sha256": "8798bab37d7b01f3426bc4094125651d8ec77b9b6602f865175a9556b7544620",
      "target": "Это последнее слово обрушилось на Мускетона как удар грома. Именно это столь ужасное <i>прежде</i> и делало <i>теперь</i> таким сладким.",
      "target_id": "ru-id01713",
      "tag": "p",
      "target_sha256": "c5589fdbc58a46b07e115feea4591c5558aa40d633d91ce912bb067ac7b57fae"
    },
    {
      "source_id": "id01714",
      "source_sha256": "9fa6f055fade2c3b8e6acbbed9f013c43fffbb5ac704ff719ab4f4aeb9e5c479",
      "target": "— О, Боже мой! Что я слышу? — сказал Мускетон, взглянув на д’Артаньяна ещё более умоляюще, чем в первый раз.",
      "target_id": "ru-id01714",
      "tag": "p",
      "target_sha256": "94b5743a8d4512e3994899bfd21c23e06e0c822d63d14d9fc21f3b09f59a73d1"
    },
    {
      "source_id": "id01715",
      "source_sha256": "d58b6f9178c0a7d22a96c70b361ac850615fd9a710b5a0bad5152262cb23f550",
      "target": "— Что поделаешь, бедный мой Мустон? — сказал д’Артаньян. — Рок…",
      "target_id": "ru-id01715",
      "tag": "p",
      "target_sha256": "54e822388a05e2d945821045ab1b69fc9aeaff2def6b8ecd6329ed0481e0ce03"
    },
    {
      "source_id": "id01716",
      "source_sha256": "799ff7f49a516af0a02275dcbe5a29afd6e7c15632bb04f76cd8cbf602c8adcd",
      "target": "Несмотря на предосторожность д’Артаньяна, который не стал говорить ему «ты» и придал его имени ту меру, к какой Мускетон стремился, тот всё равно получил удар, и удар был так страшен, что он вышел совершенно потрясённый, забыв затворить дверь.",
      "target_id": "ru-id01716",
      "tag": "p",
      "target_sha256": "6b1d29cae89aae8a571a02d37005b16e54ac71c9de1d49ba760a3079c716c559"
    },
    {
      "source_id": "id01717",
      "source_sha256": "a519dfc9e4a93a1786acbd2c26d82d4a94c7840c533b146a1d2867c50156ed2c",
      "target": "— Славный Мускетон, он не помнит себя от радости, — сказал Портос тоном, каким, должно быть, Дон Кихот подбадривал Санчо оседлать своего серого осла для последнего похода.",
      "target_id": "ru-id01717",
      "tag": "p",
      "target_sha256": "ed46c65cc13bd8bbdcb228ddcec7629e79d6f98453866767cfb580e9e9064d45"
    }
  ],
