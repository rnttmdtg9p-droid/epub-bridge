{
  "unit": 14,
  "batch": 2,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id01678",
      "source_sha256": "733e2425d17821daf2f38b006bc121a93f7d1d9e9dec79d5014d44da800b663f",
      "target": "— К тому же, — спросил Портос, — разве вы сами не держите до сих пор при себе всё того же лакея: этого славного, степенного, смышлёного… как бишь его зовут?",
      "target_id": "ru-id01678",
      "tag": "p",
      "target_sha256": "2e9202e4994d2c9fc68607ddb50d0b237bb085809adb4a0c863dcc55d7b4d794"
    },
    {
      "source_id": "id01679",
      "source_sha256": "dc678f8666be64daec1a8e5b3f28dbdab13ed6341a158af6db551c3a2687221e",
      "target": "— Планше. Да, я его разыскал, но он уже не лакей.",
      "target_id": "ru-id01679",
      "tag": "p",
      "target_sha256": "7df7f03f6b622099efcc8408025347756cb14a23d03fac50311d68874664b6c2"
    },
    {
      "source_id": "id01680",
      "source_sha256": "1d95110700959b6265fdd625e03557ab0fa75824ab4a1fe2e73d8b6a7e6afb67",
      "target": "— Кто же он теперь?",
      "target_id": "ru-id01680",
      "tag": "p",
      "target_sha256": "c5acf4f9cc251fe9c22c29e101cc90dcf24617b66f7574e67615f5f0da18f7c8"
    },
    {
      "source_id": "id01681",
      "source_sha256": "f5e6dca092139351a2846361be670fc8f57f8ca80629c8601ff85ac7df456a29",
      "target": "— Ну так вот! На свои тысячу шестьсот ливров, помните, те тысячу шестьсот ливров, что он заработал при осаде Ла-Рошели, отвезя письмо лорду Винтеру, он завёл небольшую лавку на улице Ломбардцев и стал кондитером.",
      "target_id": "ru-id01681",
      "tag": "p",
      "target_sha256": "722f6b11348202b02c78dffeb8098e989a4842182634fc9442b33b8f087a0980"
    },
    {
      "source_id": "id01682",
      "source_sha256": "904fe3ead31a603cad731d30ef11eb5bf8136080a4cbeeeb0cfed02fed887d77",
      "target": "— А! Он кондитер на улице Ломбардцев! Но как же он вам служит?",
      "target_id": "ru-id01682",
      "tag": "p",
      "target_sha256": "58dccc5ad7cf007f76427a8e1b184e13b16155d16bae4f79f37bb327363450ba"
    },
    {
      "source_id": "id01683",
      "source_sha256": "591c88949687ff4a6f94c0a20c0fd64ba9bf0f8dec4f5f1dbae88d7c2ebf5717",
      "target": "— Он позволил себе кое-какие выходки, — сказал д’Артаньян, — и опасается, как бы его не потревожили.",
      "target_id": "ru-id01683",
      "tag": "p",
      "target_sha256": "ee9323b3eb8483c144fa2a33874f93243f9db3b2df7342ea50fee3bba2ec7720"
    },
    {
      "source_id": "id01684",
      "source_sha256": "2204be3a907bcea004b1e465cf5beea9527ed96d25e1a2db468744daad362896",
      "target": "И мушкетёр рассказал своему другу, как он разыскал Планше.",
      "target_id": "ru-id01684",
      "tag": "p",
      "target_sha256": "a579cad5cc480416b864e68e23e913e534c7ea8cd17ca89eed069ae8d61598d4"
    },
    {
      "source_id": "id01685",
      "source_sha256": "243c1a8f9278b7638cd17ac268e5f743c2796b30340fbc78c0ad7b67339cc235",
      "target": "— Ну так вот! — сказал тогда Портос. — А если бы вам сказали, мой милый, что в один прекрасный день Планше поможет бежать Рошфору, а вы станете из-за этого его прятать?",
      "target_id": "ru-id01685",
      "tag": "p",
      "target_sha256": "1a27429eeb6f6c19eaa289e09506353ef6a38f4c090da8da360d832d07fd381e"
    },
    {
      "source_id": "id01686",
      "source_sha256": "0a587fdf67345d818962974f2932da09abb9496467500775c0dd376add7bcee8",
      "target": "— Я бы не поверил. Но что поделаешь? События меняют людей.",
      "target_id": "ru-id01686",
      "tag": "p",
      "target_sha256": "0e9e045adc3821b9c62ed9404d332de8a3056dcee7c2b54d7a5ee93e8040766d"
    },
    {
      "source_id": "id01687",
      "source_sha256": "878bea9d7e41c5430560731b07b751c9159114d43fb20cd92c5f91dfb1dc45c7",
      "target": "— Нет ничего вернее, — сказал Портос, — но вот что не меняется, или меняется лишь затем, чтобы стать лучше, — это вино. Попробуйте-ка вот это; оно из тех испанских виноградников, которые наш друг Атос очень ценил: это херес.",
      "target_id": "ru-id01687",
      "tag": "p",
      "target_sha256": "28dca3c8bf3a9a0d85c86c7faa4b1d093538a34773b7d8918fde868e44d679ec"
    },
    {
      "source_id": "id01688",
      "source_sha256": "a8d4c7b79137097038804a6aa422b92be07310a4ebb13b0a905ee8c26999f3e6",
      "target": "В эту минуту управитель пришёл спросить хозяина о завтрашнем меню, а также о задуманной охоте.",
      "target_id": "ru-id01688",
      "tag": "p",
      "target_sha256": "2c3d8fa935b2b3e377e1b3d218b0f78618193a38da459f5d9b2c600ae09df9ba"
    },
    {
      "source_id": "id01689",
      "source_sha256": "3001bafdd4e431fd0ebe3039f2c3b6770e2f3621252fcf98eb778af403883c58",
      "target": "— Скажи-ка, Мустон, — сказал Портос, — в добром ли состоянии моё оружие?",
      "target_id": "ru-id01689",
      "tag": "p",
      "target_sha256": "94be3bb559f0c71e980dce4cfd22fe270da034d5fe3da8969d0f39bc1aa1ed45"
    },
    {
      "source_id": "id01690",
      "source_sha256": "4bcf684be9437c0421ff301f972e3c8e9026272920fd11500a87e5b82befb93f",
      "target": "Д’Артаньян принялся отбивать такт по столу, чтобы скрыть своё смущение.",
      "target_id": "ru-id01690",
      "tag": "p",
      "target_sha256": "00f4db42e4066df49d02ed8ed9c428d5b08c069d510800f8290b0830b2099a57"
    },
    {
      "source_id": "id01691",
      "source_sha256": "b0cc0d5a6ce298dde75f5fa512b1c4ccdf4f6ce20b067e48bdb406242fa12869",
      "target": "— Ваше оружие, монсеньор? — спросил Мустон. — Какое оружие?",
      "target_id": "ru-id01691",
      "tag": "p",
      "target_sha256": "868791c2564f955da38615c09d1c56b61f67d22c592abbb5b8ae5b47228ce3b1"
    },
    {
      "source_id": "id01692",
      "source_sha256": "788a6f1e5b38de07b2b08a72c45b064acbd47e45a0e015b8d4518042368ce741",
      "target": "— Да чёрт возьми, мои доспехи!",
      "target_id": "ru-id01692",
      "tag": "p",
      "target_sha256": "49fef01406c89c9edc47863da220c7679194e7f7106cbf4f9642093f9431caf8"
    },
    {
      "source_id": "id01693",
      "source_sha256": "88fdc3bfbda529ec33c5e3556c000de5db19d2721250aa4df3c8dd21ec660645",
      "target": "— Какие доспехи?",
      "target_id": "ru-id01693",
      "tag": "p",
      "target_sha256": "2db4117ae654eba2a89dc3e5afabfb21ccaea437829c824b197bbf42d9b0d7d2"
    },
    {
      "source_id": "id01694",
      "source_sha256": "f81959606a320c454e6581aed8c691ac5e3c3cfd97a5d84927d6dccfb65398a9",
      "target": "— Мои боевые доспехи.",
      "target_id": "ru-id01694",
      "tag": "p",
      "target_sha256": "dfe714248cbe4ea13728d7fa9b5a505835f4167cf21fce7a3332bc7f6a86a43a"
    },
    {
      "source_id": "id01695",
      "source_sha256": "625485df3ec80860de48710c6a2a96f2adea484a18a2ce3d85d3d5ec10e3a390",
      "target": "— Ну да, монсеньор. По крайней мере, я так полагаю.",
      "target_id": "ru-id01695",
      "tag": "p",
      "target_sha256": "281aba82b6cb51ffe2f5525cbfccc551c524345348b7fbee5bb9aa399569acd4"
    },
    {
      "source_id": "id01696",
      "source_sha256": "9df9ec7bfc2adcc18e512feb69dd5947d6f9ff63fabe82e06880483ce50fd3a3",
      "target": "— Завтра удостоверишься и прикажешь их вычистить, если понадобится. Какая у меня лучшая скаковая лошадь?",
      "target_id": "ru-id01696",
      "tag": "p",
      "target_sha256": "5d3afc41cf2782f85f21b004cadf433609f60bfd9121c0282badaccee9638359"
    },
    {
      "source_id": "id01697",
      "source_sha256": "a5d570b3864deb375c66b87602ce2237bee670a0e6be32fe9203059b2e6de47e",
      "target": "— Вулкан.",
      "target_id": "ru-id01697",
      "tag": "p",
      "target_sha256": "bd260f12026fd1b8038cb83c57db6a98cdfedd128b709b95b27d4ca9e8ac2e79"
    }
  ],
