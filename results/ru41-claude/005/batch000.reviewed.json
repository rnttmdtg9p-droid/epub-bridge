{
  "unit": 5,
  "batch": 0,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id00601",
      "source_sha256": "6ed155325e9dd85ed55e168fc1315365361d40423f5731d29738058ccda00fe6",
      "target": "V. Гасконец и итальянец",
      "target_id": "ru-id00601",
      "tag": "heading",
      "target_sha256": "9b6fffa6f9e6e5e5f637ffa8752387c7b95b60336e96dddfc68fc380f563783d"
    },
    {
      "source_id": "id00602",
      "source_sha256": "8c2a39a252c10609571a5d2d933ad5739952a26e7a9d11b5bbd344fb47feac74",
      "target": "Тем временем кардинал вернулся в свой кабинет; у дверей его бодрствовал Бернуин, и кардинал спросил его, не случилось ли чего нового и не приходило ли каких-нибудь вестей извне. Получив отрицательный ответ, он знаком велел ему удалиться.",
      "target_id": "ru-id00602",
      "tag": "p",
      "target_sha256": "b67e04a0b7a096f2204dd65fb19fec7d31eb260b156c608aaa6d59de2ac96c06"
    },
    {
      "source_id": "id00603",
      "source_sha256": "ec8b5d11a4b409b375c202eb17d664b71492baa24b1eb4ff6403a1760cbc5e3d",
      "target": "Оставшись один, он пошёл отворить дверь в коридор, затем дверь в приёмную; д’Артаньян, утомлённый, спал на скамье.",
      "target_id": "ru-id00603",
      "tag": "p",
      "target_sha256": "2e2e1768a7f665399945f538a726028461392b4e0ae0470f6fdd6dfdb894ea97"
    },
    {
      "source_id": "id00604",
      "source_sha256": "e919ab97ccbe7071626e06976caccb5630f9271d9cb1b73b0be9c47b76065672",
      "target": "— Господин д’Артаньян! — произнёс он мягким голосом.",
      "target_id": "ru-id00604",
      "tag": "p",
      "target_sha256": "4144a0a45fc57d29b5b05d1f87b99d76e066922dded2e55c2a4903b937ee1411"
    },
    {
      "source_id": "id00605",
      "source_sha256": "30b4253de98ead4ec549618f965c75fb1be0803ad637901ef43f4eaf5be23af3",
      "target": "Д’Артаньян не шелохнулся.",
      "target_id": "ru-id00605",
      "tag": "p",
      "target_sha256": "3aa7954d8c834c97daacb91273b0f17d5d14946b2524f03bfe06eabdcc6e6a99"
    },
    {
      "source_id": "id00606",
      "source_sha256": "28e7d0b0502ac083aecf84a8457e1406f89c87edaf4e089ab67d42a89e6e8b1f",
      "target": "— Господин д’Артаньян! — произнёс он громче.",
      "target_id": "ru-id00606",
      "tag": "p",
      "target_sha256": "ba445c3f6d9965eb004135f6a5292dff62931bcccdeda37d1d31da74b8edc91b"
    },
    {
      "source_id": "id00607",
      "source_sha256": "5e865e31aa12cea9f04fd33f05465752a96295706b3cc5dadac80cd967f0ebc1",
      "target": "Д’Артаньян продолжал спать.",
      "target_id": "ru-id00607",
      "tag": "p",
      "target_sha256": "66f9f0ca5f8cd6b4f37c7810f5145c0cb709f438074cb667d980290500835000"
    },
    {
      "source_id": "id00608",
      "source_sha256": "3d3566060e5de6fe8aa3953d23ee7c05dad9716728f834434e9f0dc329f70303",
      "target": "Кардинал подошёл к нему и кончиком пальца коснулся его плеча.",
      "target_id": "ru-id00608",
      "tag": "p",
      "target_sha256": "f5c4e20573da3791bd15ea4f0ae155063858902dd57a9873057fb57efcc1f4d9"
    },
    {
      "source_id": "id00609",
      "source_sha256": "a2f11a37d9f8f10a00164ba79ae317c0b43e4c431f4362c8fcc616b49a34c790",
      "target": "На этот раз д’Артаньян вздрогнул, проснулся и, просыпаясь, оказался уже стоящим на ногах, словно солдат под ружьём.",
      "target_id": "ru-id00609",
      "tag": "p",
      "target_sha256": "95226a83d350e3c8a4b54aabf904ce4b022a9dc2335947b7c6074ab25bd83383"
    },
    {
      "source_id": "id00610",
      "source_sha256": "e5f610c5fa899fb6e1faed2dfd5871fa328a91a1ab63458204b68cf95ff6be8b",
      "target": "— Я здесь, — сказал он. — Кто меня зовёт?",
      "target_id": "ru-id00610",
      "tag": "p",
      "target_sha256": "b32e2121d5eb7794d7d293c0459e1c791acd332ee586bc4c5e52766c0c29d84f"
    },
    {
      "source_id": "id00611",
      "source_sha256": "7e39b28663afec3abad10d1dfb65a982e9b80fe8e33ed3b7c755d9cfa802733d",
      "target": "— Я, — сказал Мазарини с самым улыбчивым своим лицом.",
      "target_id": "ru-id00611",
      "tag": "p",
      "target_sha256": "727ed82f00b47884512803e561c3b2efe84af8820b9bf7258869ae5f1b655c27"
    },
    {
      "source_id": "id00612",
      "source_sha256": "d0de69c35357770f10a6c3343f98e45c7b0c18e0d92edc5e6b9042bffa65a701",
      "target": "— Прошу прощения у вашего высокопреосвященства, — сказал д’Артаньян, — но я так устал…",
      "target_id": "ru-id00612",
      "tag": "p",
      "target_sha256": "66b847b68e1cc0e74a857cca1e2972af67aba2ab97adbb1bee375fec6c0da426"
    },
    {
      "source_id": "id00613",
      "source_sha256": "b725f99813054b4bb681b22ab0cf74a205e37aac1d75ce5a3330a8d0308bb2aa",
      "target": "— Не просите у меня прощения, сударь, — сказал Мазарини, — ведь вы утомились на моей службе.",
      "target_id": "ru-id00613",
      "tag": "p",
      "target_sha256": "facfacde6d0f5da0b3945207b767fb91e5e6f5d5bd9c5b4a85024d350f01042a"
    },
    {
      "source_id": "id00614",
      "source_sha256": "2064b84d94f51f5a8fde206f8c36fede547888df8db1ebb727d54fb3bf092dc5",
      "target": "Д’Артаньян подивился любезному виду министра.",
      "target_id": "ru-id00614",
      "tag": "p",
      "target_sha256": "5e9c4921b41ca8d72ee53fe08d2f7901de44f05827d0e4993905905166ec4067"
    },
    {
      "source_id": "id00615",
      "source_sha256": "ae8afd9933a55aaca2ff07e3db859772be1d6aa9563534f7c4671b4758cf7319",
      "target": "— Ого! — сказал он сквозь зубы. — Стало быть, правда то, что говорит пословица: добро приходит во сне?",
      "target_id": "ru-id00615",
      "tag": "p",
      "target_sha256": "158f11ad39d28a9c48bb4dce52990b43173d5c245c2dd4725a6fca5fea2cba57"
    },
    {
      "source_id": "id00616",
      "source_sha256": "b92a6b224aed1ed22e3d93f95e1d5f0ae47f3bc49dddeb07b8b9de8caba9d01d",
      "target": "— Следуйте за мной, сударь! — сказал Мазарини.",
      "target_id": "ru-id00616",
      "tag": "p",
      "target_sha256": "563a97bb50a0e21b03193733d822c40cf1172cd31b03d8748f37fe56ae433310"
    },
    {
      "source_id": "id00617",
      "source_sha256": "c55e6f76905d288217ea4c46cfa0787babd160e1715d565bcc5ca226fc640a0e",
      "target": "— Так, так, — пробормотал д’Артаньян, — Рошфор сдержал слово; вот только, чёрт возьми, каким путём он прошёл?",
      "target_id": "ru-id00617",
      "tag": "p",
      "target_sha256": "41cba74a0490b5cba070325adc5435aa891093d3e7606ba68b7a0614865db7da"
    },
    {
      "source_id": "id00618",
      "source_sha256": "92e94394f2e00bc1732db16fc99416602fe7ccd88af04bf5be9f409caae92ce1",
      "target": "И он заглянул в самые укромные уголки кабинета, но Рошфора там уже не было.",
      "target_id": "ru-id00618",
      "tag": "p",
      "target_sha256": "234d1a88ded6d310f057c75aa9992c644f00ecc4558ddd57c8d8315696668e2f"
    },
    {
      "source_id": "id00619",
      "source_sha256": "d7432edf241c5d82fc64af5ce536de3bda2f22a216998daacbe32689af9067c2",
      "target": "— Господин д’Артаньян, — сказал Мазарини, садясь и устраиваясь поудобнее в кресле, — вы всегда казались мне храбрым и благородным человеком.",
      "target_id": "ru-id00619",
      "tag": "p",
      "target_sha256": "1ae05c48dd355a0566f52984dde449db39c1b71aa9a08527e26ea8358a74976b"
    },
    {
      "source_id": "id00620",
      "source_sha256": "3bf909089bb9e9d3c06c07115d478e4a01cdfcfbbf262f5175c801d0b8b7c9fa",
      "target": "«Возможно, — подумал д’Артаньян, — но он не очень-то торопился мне об этом сказать».",
      "target_id": "ru-id00620",
      "tag": "p",
      "target_sha256": "842c9ad5f027a0b2eefb57f85ff845619d70eeb516adcbabee1f4d771f1bff5b"
    }
  ],
