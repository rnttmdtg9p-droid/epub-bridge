{
  "unit": 44,
  "batch": 6,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id05513",
      "target": "— Да, сударь, — ответил молодой человек с лёгкой запинкой, — я плохо спал.",
      "source_sha256": "5b03c4fd45d14875e32bd946a4275981e108044b39d5ba404544c2b64ad7087f",
      "target_id": "ru-id05513",
      "tag": "p",
      "target_sha256": "c1c7a68d67cc321e69da435ea187f5535b1d0b3fba28c317cea1447ff74937f9"
    },
    {
      "source_id": "id05514",
      "target": "— Вы, Рауль! Вы плохо спали? Что-то вас, стало быть, тревожило? — спросил Атос.",
      "source_sha256": "1bf308c2bb3cf99e93d3fa535b11265eb605f7c15c71ebd3ba916f25fab05c64",
      "target_id": "ru-id05514",
      "tag": "p",
      "target_sha256": "7df13d4560797d236ee55618c27ae5fa221d55a611ef82e29b8ba182b677e33f"
    },
    {
      "source_id": "id05515",
      "target": "— Сударь, вы скажете, что я слишком спешу покинуть вас, едва успев приехать, но…",
      "source_sha256": "d39511134b6b48640740580c789ca3a2062511fb76863569f7526210396c62f2",
      "target_id": "ru-id05515",
      "tag": "p",
      "target_sha256": "900832a21e412c0b090962788765cad9e952a3ac070fdf6ef05b3db480114c0e"
    },
    {
      "source_id": "id05516",
      "target": "— Стало быть, у вас был отпуск всего на два дня, Рауль?",
      "source_sha256": "1590402297c4c7934d8f94c857c266a9b7db9422e7044812cab31d679ce0eb36",
      "target_id": "ru-id05516",
      "tag": "p",
      "target_sha256": "550099d977e1bf5516327c50ef86d4065dab3e0365d3a675eafcf15add7ef2c7"
    },
    {
      "source_id": "id05517",
      "target": "— Напротив, сударь, у меня их десять, и потому я хотел бы поехать вовсе не в лагерь.",
      "source_sha256": "235c1c989ec6dfa8d883513819118288e218a84351c9e6803651a3fd1860fc56",
      "target_id": "ru-id05517",
      "tag": "p",
      "target_sha256": "01e7e049adca217b4d58207ccf875c7fcf04a9f527b8bdfeb649a55ecade92f4"
    },
    {
      "source_id": "id05518",
      "target": "Атос улыбнулся.",
      "source_sha256": "41d83615f00b996cf74f702abf9773a5cdbf92628d49bc8ae74c4cd36ad41e4c",
      "target_id": "ru-id05518",
      "tag": "p",
      "target_sha256": "0280e3ba2a23c70da6770e97ce3f187156ba8e067a9a0faa15fd348e9013ec0a"
    },
    {
      "source_id": "id05519",
      "target": "— Куда же, — сказал он, — если только это не тайна, виконт? Вы теперь почти мужчина, ведь вы уже понюхали пороху, и вы заслужили право ехать куда хотите, не говоря мне об этом.",
      "source_sha256": "05cd5b3e5c5fd02e8343f78c48fe68350efc7159c5971071a40987a42b89fcd4",
      "target_id": "ru-id05519",
      "tag": "p",
      "target_sha256": "3d5423a6951dca0a602010a87cec5b0e9756fe378dd4d0478d308b767b803917"
    },
    {
      "source_id": "id05520",
      "target": "— Никогда, сударь, — сказал Рауль, — пока я имею счастье видеть в вас своего покровителя, я не сочту, что имею право избавиться от опеки, которая мне так дорога. Итак, мне хотелось бы съездить на один день в Блуа, только и всего. Вы смотрите на меня — и сейчас посмеётесь надо мной?",
      "source_sha256": "ee05b4d4b7696ba61bc3508509b8bc4b26e55b2dc580eb7a13168094c1652312",
      "target_id": "ru-id05520",
      "tag": "p",
      "target_sha256": "596e9cd8f8c8d0e3ab27e5741e55c6b8f2f2f49d73f37e5533c32e75fd3a17c0"
    },
    {
      "source_id": "id05521",
      "target": "— Нет, напротив, — сказал Атос, подавив вздох, — нет, я не смеюсь, виконт. Вам хочется снова увидеть Блуа, но это так естественно!",
      "source_sha256": "56d389723a84be89beb310a4d1f5036d95ac6987c096b89d1e7c753e2ed51b55",
      "target_id": "ru-id05521",
      "tag": "p",
      "target_sha256": "e37ec4fdb9f38dd8573fec485c9e4d4ac038d1e7b81bfc9d935a4722e4f031b3"
    },
    {
      "source_id": "id05522",
      "target": "— Значит, вы мне позволяете? — воскликнул Рауль, весь сияя.",
      "source_sha256": "8ba3d9cab430fb2421222b45e579558108d03d475dee04099ee3ed4b7160382c",
      "target_id": "ru-id05522",
      "tag": "p",
      "target_sha256": "9d3595bd206de9db44ab10c6a7965c94ff12f5174eda14af23190dfb386d25d9"
    },
    {
      "source_id": "id05523",
      "target": "— Разумеется, Рауль.",
      "source_sha256": "7adb5c2774a3be04d1987c31aebd50d058634ea4818d8059a0bfbd85e81f720e",
      "target_id": "ru-id05523",
      "tag": "p",
      "target_sha256": "c796aa9f4bf36dad350739e1c9745ad0c5bb01787340fd286c4f59825ace935a"
    },
    {
      "source_id": "id05524",
      "target": "— В глубине души, сударь, вы не сердитесь?",
      "source_sha256": "2f027b6ffd6c518755e3749a06e0a1122d870ddf3b6f9aea3b22d085b3d7ee5d",
      "target_id": "ru-id05524",
      "tag": "p",
      "target_sha256": "a3ace9753c2ca554851fb53362f74585d47ec8a0acc7287857985c396b5a8ad6"
    },
    {
      "source_id": "id05525",
      "target": "— Нисколько. Почему бы мне сердиться на то, что доставляет вам удовольствие?",
      "source_sha256": "cc394586bbb3a1edfa3408607f5d0aa8e257e6c66bdd50f77ce9ff2dc1ab4eda",
      "target_id": "ru-id05525",
      "tag": "p",
      "target_sha256": "714f560b4158c4a4ad0c4854be345870c6394735813443da35789e7aad831ed8"
    },
    {
      "source_id": "id05526",
      "target": "— Ах, сударь, как вы добры! — воскликнул молодой человек, сделав движение, чтобы броситься Атосу на шею, но почтение его удержало.",
      "source_sha256": "9ffe8a1eecfbe8de08647f52f5013ae92f280ce67bf037f633f36de80e2a31eb",
      "target_id": "ru-id05526",
      "tag": "p",
      "target_sha256": "11630ccbd260e9b5526becacd7630deae32baf4276a08ba93b9e05d97f300137"
    },
    {
      "source_id": "id05527",
      "target": "Атос раскрыл ему объятия.",
      "source_sha256": "0207df8cd04dadc2542c57f2c08b73c7eee154c85a6abca2ff65929d694cfa55",
      "target_id": "ru-id05527",
      "tag": "p",
      "target_sha256": "c1f34359ea11eea1d47df1ff1f7536de7733a1f980454fa1f447e0dc26e67489"
    },
    {
      "source_id": "id05528",
      "target": "— Значит, я могу ехать сейчас же?",
      "source_sha256": "d8c02147d513532d06a4ac9b6e55b3de02a35b4b4dd4be559a4f33a144e59c10",
      "target_id": "ru-id05528",
      "tag": "p",
      "target_sha256": "817c5a77cd7706a28a19328501383a5d958d7469caaec0fb91f61eebb1f5cb5c"
    },
    {
      "source_id": "id05529",
      "target": "— Когда пожелаете, Рауль.",
      "source_sha256": "4c16d107d1c956a7614b1e0a841fa87b819518677c7b87e0868ca9ebfe9644ed",
      "target_id": "ru-id05529",
      "tag": "p",
      "target_sha256": "cefedf6a25b9c4ecb6099e808b1d99ac64e55ca95740611fd8702360d0641329"
    },
    {
      "source_id": "id05530",
      "target": "Рауль сделал три шага к двери.",
      "source_sha256": "8ba534a936275afa409ce90d46d585aae07790b46ee8a9946734f9d0cde8b3e9",
      "target_id": "ru-id05530",
      "tag": "p",
      "target_sha256": "e0bc709b8e6c759b5f17e2b26b22465999f68b51927937d375943527f9298e3b"
    },
    {
      "source_id": "id05531",
      "target": "— Сударь, — сказал он, — я подумал вот о чём: именно госпоже герцогине де Шеврёз, столь доброй ко мне, я обязан тем, что был представлен господину принцу.",
      "source_sha256": "d02534f10320a9d41d75cf5c80a76699bfe1395f2a4cf8c8e48755b7a103481e",
      "target_id": "ru-id05531",
      "tag": "p",
      "target_sha256": "1ec65266aa9b3e5558a36f0305672cb5fc7a4a61b55c205479041fadd15da14a"
    },
    {
      "source_id": "id05532",
      "target": "— И что вы должны её поблагодарить, не так ли, Рауль?",
      "source_sha256": "9d2114d86b16ecb2261cd44cb0e875d39f833f8ec0dd50bf65a9e14ec7839d3e",
      "target_id": "ru-id05532",
      "tag": "p",
      "target_sha256": "6323340526b981a393f788243ff00c2e3522804e534b67cb66bc98abed423477"
    }
  ],
