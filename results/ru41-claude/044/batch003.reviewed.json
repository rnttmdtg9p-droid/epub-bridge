{
  "unit": 44,
  "batch": 3,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id05453",
      "target": "— Это ребёнок, которого я воспитываю и который даже не знает своего отца.",
      "source_sha256": "6cdc1a6b31e1a47a7c34223a98f3fefc55fbd2b73769657c68bae6550dfc5a33",
      "target_id": "ru-id05453",
      "tag": "p",
      "target_sha256": "9b52810978574d7ebb0729319a629ae49e8bc95efbc574634d9fb241f423bed4"
    },
    {
      "source_id": "id05454",
      "target": "— Прекрасно; вы всё тот же, Атос, возвышенный и великодушный.",
      "source_sha256": "89d8ec8f6b22d260ee5c6bdca9d1eb032ef333b47e616a9a3963362fe3655025",
      "target_id": "ru-id05454",
      "tag": "p",
      "target_sha256": "a0c78c23a669259edd19b0ded190c8b892ca032804ece7fad4faf63a65014753"
    },
    {
      "source_id": "id05455",
      "target": "— Итак, милорд, о чём вы меня просите?",
      "source_sha256": "9ece487b7239da565f3c22d17a4e5d4c9fa5cc035548ee65ae2b0a43348d5903",
      "target_id": "ru-id05455",
      "tag": "p",
      "target_sha256": "19f633deaede53173599b5af2e00fa8cf0860340ebcfa636e56316e8d0abe68a"
    },
    {
      "source_id": "id05456",
      "target": "— Господа Портос и Арамис по-прежнему ваши друзья?",
      "source_sha256": "9f0ea903929b4e6137c6490adff9686f97df76881ba840ff296a49d568a2e5a0",
      "target_id": "ru-id05456",
      "tag": "p",
      "target_sha256": "4ef60d4b9988c4e1b01e4bae68087c6ade1ce714225742ebe27cb6adde6c6778"
    },
    {
      "source_id": "id05457",
      "target": "— И прибавьте к ним д’Артаньяна, милорд. Нас по-прежнему четверо друзей, преданных друг другу, как некогда, но когда речь заходит о том, чтобы служить кардиналу или сражаться с ним, быть мазаринистами или фрондёрами, нас остаётся только двое.",
      "source_sha256": "a4a40036cf65ed20b8e12b50b32479ce0fdc467a1678364d6dbaf1707ba0ef7a",
      "target_id": "ru-id05457",
      "tag": "p",
      "target_sha256": "914c3c836ee82249dec419c4cce1b2fca9569399fb36074efb9fa5e3787545d2"
    },
    {
      "source_id": "id05458",
      "target": "— Господин Арамис с д’Артаньяном? — спросил лорд де Винтер.",
      "source_sha256": "cd04c7509cb44e1d6212df5cd63fdbba1a860867528ec0456ee10dc4b9515d47",
      "target_id": "ru-id05458",
      "tag": "p",
      "target_sha256": "b135290a94f7a40699c5493360901b22ba347acd593f41e01a0d44dede49547a"
    },
    {
      "source_id": "id05459",
      "target": "— Нет, — сказал Атос, — господин Арамис оказывает мне честь, разделяя мои убеждения.",
      "source_sha256": "d3f9219cf4c3a2c6771595c773cf95961e87faae1e9fbd5521108b293f1184c6",
      "target_id": "ru-id05459",
      "tag": "p",
      "target_sha256": "a61db43360488cc3fbca731a840a939799d8004e844ac13dde034e4779065eaa"
    },
    {
      "source_id": "id05460",
      "target": "— Можете ли вы свести меня с этим столь очаровательным и столь остроумным другом?",
      "source_sha256": "9900a8483967fbd6f37952d159315f32e473b156f29153bc256fa3d3de1d04a4",
      "target_id": "ru-id05460",
      "tag": "p",
      "target_sha256": "24403e75a8ac488664c72254a44b4eaa8a19b410d6fd4068a9ae51c48631af37"
    },
    {
      "source_id": "id05461",
      "target": "— Без сомнения, как только вам будет угодно.",
      "source_sha256": "2d9b6dd680bccc4a053183675a01ae2a3eb6fc01de72df16619c2dce4ee63268",
      "target_id": "ru-id05461",
      "tag": "p",
      "target_sha256": "8bd931983c0dfae4abc6ce98c996a3e90c1dd27400b33d6618d6ae79f7ba79d2"
    },
    {
      "source_id": "id05462",
      "target": "— Он изменился?",
      "source_sha256": "ca4aca55e1be4e555077b93aa8203af6bd7d33e22fbc2027ac05fb265e926075",
      "target_id": "ru-id05462",
      "tag": "p",
      "target_sha256": "1edc9d0808b084e73641fbdd2112a3e378051a4323763d1a27584f4b30b788a3"
    },
    {
      "source_id": "id05463",
      "target": "— Он сделался аббатом, вот и всё.",
      "source_sha256": "4d3c2dffa485163b2f7499a011927000685167b0d119a8cf942f5fa4740ea3ea",
      "target_id": "ru-id05463",
      "tag": "p",
      "target_sha256": "4f3948c0fc3e8eda66368622166d3e60e76a02749e5cf8f6d5ab8c5041d68c34"
    },
    {
      "source_id": "id05464",
      "target": "— Вы меня пугаете. Значит, его сан, должно быть, заставил его тогда отказаться от великих предприятий.",
      "source_sha256": "ed9434109b59bdcb7fbc38431c0c82e62f811399007c1e20b4938e8809e2e681",
      "target_id": "ru-id05464",
      "tag": "p",
      "target_sha256": "1b698335d573b766e905f3abc77bc89a7fe47c43c9d1d86ddf58fc8b5f91205e"
    },
    {
      "source_id": "id05465",
      "target": "— Напротив, — сказал Атос, улыбаясь, — он никогда не был так мушкетёром, как с тех пор, как стал аббатом, и вы найдёте в нём настоящего Галаора. Хотите, я пошлю за ним Рауля?",
      "source_sha256": "b8b9bb42103150ba9658ef8cdcc74136f4c91acbdec60942355c59a862c1404f",
      "target_id": "ru-id05465",
      "tag": "p",
      "target_sha256": "b067fb60460da320b8faf692455039bcd368db97f83ad3fb3398549594f08956"
    },
    {
      "source_id": "id05466",
      "target": "— Благодарю, граф, в этот час его могут не застать дома. Но раз вы полагаете, что можете за него поручиться…",
      "source_sha256": "6f6a5ffedf6c7923a2802ee22e28188a763a46822c4b6f5b53357ac3d8ac4379",
      "target_id": "ru-id05466",
      "tag": "p",
      "target_sha256": "95cb0f31e4edae8ad72debc9494a50949e6546820ecc449cd5258fa16d2b34b8"
    },
    {
      "source_id": "id05467",
      "target": "— Как за самого себя.",
      "source_sha256": "77d6f9da4869d7449f17c386208920c90fc7ac252099b11acc71585c01caca9e",
      "target_id": "ru-id05467",
      "tag": "p",
      "target_sha256": "fc32d9e130337276546044bcbbc41e8cf8ae49ddcd56fd88de1897e6a446a251"
    },
    {
      "source_id": "id05468",
      "target": "— Можете ли вы обязаться привести его ко мне завтра в десять часов на мост Лувра?",
      "source_sha256": "4d0cd021ca7ee40386c1f4b2e134076ee10c01c58fb91438d2ee3128ac43461d",
      "target_id": "ru-id05468",
      "tag": "p",
      "target_sha256": "50fde29b0bf7fa34ba7799384d4a69be9ad428b27f0baf91a37d384b58915b17"
    },
    {
      "source_id": "id05469",
      "target": "— А-а! — сказал Атос, улыбаясь. — У вас дуэль?",
      "source_sha256": "08d18424eefe930f133872b6ba2df52eb7403bb2f1a7328e4d62c058a475131e",
      "target_id": "ru-id05469",
      "tag": "p",
      "target_sha256": "4256970b9f774ff48afdcb34799ad8b367898b682b5f76b1b758f064cb7815dd"
    },
    {
      "source_id": "id05470",
      "target": "— Да, граф, и прекрасная дуэль, дуэль, в которой, надеюсь, вы примете участие.",
      "source_sha256": "2a1ba552ef8b3db65b1c681b1ab9f0c4bcd0363c32fdfa92566e07f9a7304100",
      "target_id": "ru-id05470",
      "tag": "p",
      "target_sha256": "e9f61215c934b05648e3e36ae29afaaaaceb0f8e683623bc7277a82522043b6e"
    },
    {
      "source_id": "id05471",
      "target": "— Куда мы отправимся, милорд?",
      "source_sha256": "cc96e33e5b5674c361b74aef6d27aa69cbb321f3edddf389e6e77c9ea03bb061",
      "target_id": "ru-id05471",
      "tag": "p",
      "target_sha256": "9de777928e070ec8db0e9916eff7b1462d7ecf5b5189deeb6805130fce1aac2a"
    },
    {
      "source_id": "id05472",
      "target": "— К её величеству королеве Англии, которая поручила мне представить вас ей, граф.",
      "source_sha256": "36f599f5cd55c5f92e472f15bb31d576a3f118660f2e9c5f44befea96f6c2776",
      "target_id": "ru-id05472",
      "tag": "p",
      "target_sha256": "51a4874c928057d9172b9fc6732aeb611f99b347743fbff325d6d3e7699a62ae"
    }
  ],
