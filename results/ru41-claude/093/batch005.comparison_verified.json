{
  "unit": 93,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id11903",
      "target": "Внезапно д’Артаньян наткнулся на что-то тёплое, что шевельнулось.",
      "source_sha256": "4f06e2ae9cdc6e00e912ebaeb2ab7792970aaa6c4fab83e8712c9f80e558192c",
      "target_id": "ru-id11903",
      "tag": "p",
      "target_sha256": "059a0c7083064151253c7f7aafec865b780b0aed7213023e7e9cc6fe4e2ff72c"
    },
    {
      "source_id": "id11904",
      "target": "— Вот так так! Лошадь! — сказал он. — Я только что нашёл лошадь, господа!",
      "source_sha256": "16882dbefad5a0f08d14df1bb81cdb8a43f8670c325310dc358173022680c117",
      "target_id": "ru-id11904",
      "tag": "p",
      "target_sha256": "4d581cb7988da4732254a20271e9a76dcd5e4c80eb2d010cdf0f357b0f099106"
    },
    {
      "source_id": "id11905",
      "target": "— И я тоже! — сказал Атос.",
      "source_sha256": "c9b31d585d8d6ebdea756b34deacfec140eba3dd81d35f009ab209b8d3fed882",
      "target_id": "ru-id11905",
      "tag": "p",
      "target_sha256": "6a5c84b449e64b7e360158309e7a767b6bd369c122f782abab03de2d4afc665e"
    },
    {
      "source_id": "id11906",
      "target": "— И я тоже! — сказал Портос, который, верный приказу, всё ещё держал кардинала под руку.",
      "source_sha256": "3e12cf08cba10ca1fc70a6e415e3be83b607ca078060c9ab17e948e1824722e8",
      "target_id": "ru-id11906",
      "tag": "p",
      "target_sha256": "b6915e78d87685f5aadeb71b144496b48b02037a3bb905a53e047db24288bc2e"
    },
    {
      "source_id": "id11907",
      "target": "— Вот это называется удача, монсеньер, — сказал д’Артаньян, — как раз в ту минуту, когда Ваше Высокопреосвященство жаловалось, что приходится идти пешком…",
      "source_sha256": "fa1f0b4df3c7b3c23982371bba28cf09baab508caea27ffebd4d2ac22986c703",
      "target_id": "ru-id11907",
      "tag": "p",
      "target_sha256": "3c4bb898f50b7e8373c90cfb3ee9ffb8b3ae3295688b560e9dcd7103095382c6"
    },
    {
      "source_id": "id11908",
      "target": "Но в ту минуту, когда он произносил эти слова, ствол пистолета опустился, нацелившись ему в грудь; он услышал, как кто-то серьёзно произнёс:",
      "source_sha256": "fa8146e93769e0ae769fec22de58fe97b675b5bbedf1dc2fe96005014c8e6ce7",
      "target_id": "ru-id11908",
      "tag": "p",
      "target_sha256": "f52f91a12f1871e765f94c7e0cc3657d0291366e743dd20b48587946c112e71e"
    },
    {
      "source_id": "id11909",
      "target": "— Не трогать!",
      "source_sha256": "1d8eb24b990e4c65d0c4fbbf3cc3a418a09aa06b08f4ed6718bfffb5fd49173f",
      "target_id": "ru-id11909",
      "tag": "p",
      "target_sha256": "e5a20df99690c7adb40abebd0a5998a13ab3bac69548fe616c339b27941039eb"
    },
    {
      "source_id": "id11910",
      "target": "— Гримо! — воскликнул он. — Гримо! Что ты тут делаешь? Уж не небо ли тебя послало?",
      "source_sha256": "a09dd3c71b722c8b0cf04135d9029b94dfbbf3e70c042d82c1a6e0417f7af2d8",
      "target_id": "ru-id11910",
      "tag": "p",
      "target_sha256": "a8102fce855d64ffe2e64c29c12ba4269fb622f613fcfe1b55df77b4a59fd390"
    },
    {
      "source_id": "id11911",
      "target": "— Нет, сударь, — сказал честный слуга, — это господин Арамис велел мне сторожить лошадей.",
      "source_sha256": "9b190cd7ab00b9992821b769d558c7200d9f83bdd6a734e0c1b75899ceb2a1af",
      "target_id": "ru-id11911",
      "tag": "p",
      "target_sha256": "602e9f155eaf13a310fcf61f245225a92889a7390c4efad18e6fb2d606cc71b0"
    },
    {
      "source_id": "id11912",
      "target": "— Значит, Арамис здесь?",
      "source_sha256": "e99979fc539f21d090384f995ae1c31686afb9d4f6937bfe5a23eeb5aaf8fc98",
      "target_id": "ru-id11912",
      "tag": "p",
      "target_sha256": "bd72f2de6d5cf2e4229deb386fe5ed94333259b564d6d15d3895f5ba598dcf21"
    },
    {
      "source_id": "id11913",
      "target": "— Да, сударь, со вчерашнего дня.",
      "source_sha256": "8a1c3c30e7adc6269068901144fe1817c6a385298c7f525b555314504560d670",
      "target_id": "ru-id11913",
      "tag": "p",
      "target_sha256": "b7b1c1ec09a57b39aca1aeb2908dd527c84f7552a8e406a29d9594f3d3c1fcc1"
    },
    {
      "source_id": "id11914",
      "target": "— А что вы делаете?",
      "source_sha256": "d3966351b9d87da62c8595631f6c1028225b25e566492cd4db45df332a5c1a4d",
      "target_id": "ru-id11914",
      "tag": "p",
      "target_sha256": "dff1caa93d1f5708340fe9ce08236f4922d2035429550855d91fac7c4b885f03"
    },
    {
      "source_id": "id11915",
      "target": "— Мы подстерегаем.",
      "source_sha256": "b289af20e72e7b630ff5bea77958428b3c40bbb6462251f36c09581c3e1da3f5",
      "target_id": "ru-id11915",
      "tag": "p",
      "target_sha256": "0440320a14516fcb0a13c09c7258e3c7ad4d12af190d8dc35c5c3b613b527909"
    },
    {
      "source_id": "id11916",
      "target": "— Как! Арамис здесь? — повторил Атос.",
      "source_sha256": "fd5e4776cedbe764cc3f933d88d4a5eb03ddef6170511c44fba9bb550baf0da0",
      "target_id": "ru-id11916",
      "tag": "p",
      "target_sha256": "2a9b74fee61cafbd4b2039511455705ca63456c90e4db649f34913e523db5904"
    },
    {
      "source_id": "id11917",
      "target": "— У маленькой двери замка. Там был его пост.",
      "source_sha256": "d5e3233632d6aeeb08fa15b1955386df1b8d3250ff7dcf8c530c97546d8e4907",
      "target_id": "ru-id11917",
      "tag": "p",
      "target_sha256": "44df4ad7e03127ee294e9db21bd46c29bbadc895018523a95365b6955c43e13a"
    },
    {
      "source_id": "id11918",
      "target": "— Так вас много?",
      "source_sha256": "253ff0663a62bdea56ce337bbcd70f3a9229f02b11bdb6ae7656ff8b92d1e44e",
      "target_id": "ru-id11918",
      "tag": "p",
      "target_sha256": "256c3b782054cfb8f07f27a64d6fb6dc3791c6f182e4c38ea1749dd3a2aa5944"
    },
    {
      "source_id": "id11919",
      "target": "— Нас шестьдесят.",
      "source_sha256": "8141056247f4c5eb8601321ae4e43a887f606996055910ee5e73f8042da080e6",
      "target_id": "ru-id11919",
      "tag": "p",
      "target_sha256": "b3a3c3dd1a1a2ebddbde1d6f1007ee894509fc575e71b6d1659d910efe9ce77e"
    },
    {
      "source_id": "id11920",
      "target": "— Дай ему знать.",
      "source_sha256": "20ccc8a6096053c8d2595baf65bed303fc18bc6599f248edf5f3ca233af02022",
      "target_id": "ru-id11920",
      "tag": "p",
      "target_sha256": "03485fd88e34ef9cd06f0b32fc61b284f0cc145874e7746abe534e64c99fbe7e"
    },
    {
      "source_id": "id11921",
      "target": "— В ту же минуту, сударь.",
      "source_sha256": "25e6fa8780209f457605fcca8b2753b0e7ca6cb0b643e0f1ec05bc958db3de64",
      "target_id": "ru-id11921",
      "tag": "p",
      "target_sha256": "f5b1b16ee54ee65b37dda8d4e74c0c008dcc622da4b1d0870ebae6df49339fbd"
    },
    {
      "source_id": "id11922",
      "target": "И, полагая, что никто не исполнит поручение лучше него, Гримо со всех ног пустился бежать, а трое друзей, наконец-то собравшиеся вместе, ждали.",
      "source_sha256": "207e5920fe18f430d9b594eea565a33246bf64485beda0ae6ba17767d2c70ff1",
      "target_id": "ru-id11922",
      "tag": "p",
      "target_sha256": "6b137848bd8ff26c65a763be708a3097ac1a62c4c7de63de49f94a03db6f0e5e"
    }
  ],
