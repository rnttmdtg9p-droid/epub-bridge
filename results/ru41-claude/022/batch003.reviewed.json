{
  "unit": 22,
  "batch": 3,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id02717",
      "target": "— Говорите же, сударь.",
      "source_sha256": "353701fcf38a86800d3bcd57331fdb84e52c1a8df66cca2b0ac1bec0cb873409",
      "target_id": "ru-id02717",
      "tag": "p",
      "target_sha256": "b3eb8efd7cd390b678ee93c7d65895fbf1f117b51e5f607c1ea1d524e6ca68dc"
    },
    {
      "source_id": "id02718",
      "target": "— Прежде, — сказал граф де Ла Фер, — меня звали Атосом.",
      "source_sha256": "df3681424baa4037a9d3999511011b8e421798d6d8256105bc1daeb1805f6a4c",
      "target_id": "ru-id02718",
      "tag": "p",
      "target_sha256": "ff622b083717c1c603392fd8618fd93996e55b69524f79341443aef83f61f010"
    },
    {
      "source_id": "id02719",
      "target": "Госпожа де Шеврёз широко раскрыла удивлённые глаза. Было очевидно, как и говорил ей граф, что это имя не совсем изгладилось из её памяти, хотя и оказалось там сильно затерянным среди старых воспоминаний.",
      "source_sha256": "24bae56d05837d8984195f48077675a7d1d0dc48e6bc0eca35ab4c1ad77c092c",
      "target_id": "ru-id02719",
      "tag": "p",
      "target_sha256": "7fe2a1d1d0d3c7b0968e6532f6d8d23e14a7db0b6151b11e60c692120814df06"
    },
    {
      "source_id": "id02720",
      "target": "— Атос? — сказала она. — Постойте-ка!..",
      "source_sha256": "54c253d45ee632d9671228ff81affdf04c75cff264031faddeab7a944e025722",
      "target_id": "ru-id02720",
      "tag": "p",
      "target_sha256": "7a7de507607f13157977d6e2e4cc8afbe85f5fe1678848e984606fc30d1b8f11"
    },
    {
      "source_id": "id02721",
      "target": "И она приложила обе руки ко лбу, словно желая заставить тысячу мимолётных мыслей, которые там теснились, остановиться хоть на мгновение и позволить ей разглядеть их блестящую пёструю толпу.",
      "source_sha256": "8db8880b605facf1cb02590760ef3f668dc1df4670a75627f926bf99eeb3ca9f",
      "target_id": "ru-id02721",
      "tag": "p",
      "target_sha256": "79d298c34a1928902a104c88b4058aff13eb24d4278f81c6bc818204ca110867"
    },
    {
      "source_id": "id02722",
      "target": "— Хотите, я вам помогу, сударыня? — спросил, улыбаясь, Атос.",
      "source_sha256": "cde8f4640246967ac37bb567f09e2aa71dcae9fa99403216a8cbea04e0988bfd",
      "target_id": "ru-id02722",
      "tag": "p",
      "target_sha256": "cbba696545150f77c5c67edc785fd80d8e3d48c698c2e02a83d1fc716b357296"
    },
    {
      "source_id": "id02723",
      "target": "— Ну конечно, — сказала герцогиня, уже уставшая искать, — вы доставите мне удовольствие.",
      "source_sha256": "761abc1769390e11189ce674a9419d1240eec621b615e62db3dc54be02397031",
      "target_id": "ru-id02723",
      "tag": "p",
      "target_sha256": "2f1d9d9b3aac7ccd122f2fc4a2785fd5ddf4878dacc448c5b64e799017b3349b"
    },
    {
      "source_id": "id02724",
      "target": "— Этот Атос дружил с тремя молодыми мушкетёрами, которых звали д’Артаньян, Портос и…",
      "source_sha256": "fdf39fc3743943d2e793657cbcdfe67229e72b6ef56b5f5748098a76d967af1c",
      "target_id": "ru-id02724",
      "tag": "p",
      "target_sha256": "4d09fc84966ca4ea62c065fb3f6d2f88211c676f71a9b3cd96e130bfcb0e1c7b"
    },
    {
      "source_id": "id02725",
      "target": "Атос остановился.",
      "source_sha256": "9fc732fcccca4f6ec980effa8c875ecc31bc011b59bdc946f00f969e9e02bcca",
      "target_id": "ru-id02725",
      "tag": "p",
      "target_sha256": "d2b8c44acfb046f066e5a0b3320d7f9f0343a85b57a9da13ae31562c5411a09d"
    },
    {
      "source_id": "id02726",
      "target": "— И Арамис, — живо сказала герцогиня.",
      "source_sha256": "dd4b4c0b7a72964b31e7cf96c4d588d0ad451142582f5589f1d02991e0dc622f",
      "target_id": "ru-id02726",
      "tag": "p",
      "target_sha256": "c3eba4bc3270f43f36ff0b6eb4537ca6c0d0857a3f6232c677b97f534eebb639"
    },
    {
      "source_id": "id02727",
      "target": "— И Арамис, именно так, — подхватил Атос. — Значит, вы всё же не совсем забыли это имя?",
      "source_sha256": "b590be4bdc8f0636281af99f2246200c1f93f364a4b6bbb79f0946d18fe4c01b",
      "target_id": "ru-id02727",
      "tag": "p",
      "target_sha256": "cc86c1df71037290e1be88b84a4dbb0aab29fdc5cb427a85a836db941d28854d"
    },
    {
      "source_id": "id02728",
      "target": "— Нет, — сказала она, — нет; бедный Арамис! Это был очаровательный дворянин, изящный, скромный и писавший прелестные стихи; кажется, он плохо кончил, — добавила она.",
      "source_sha256": "00c1e14e17037b0b218f048c2a9505f8889b016ca67280faa4ea0c709a8a8a4b",
      "target_id": "ru-id02728",
      "tag": "p",
      "target_sha256": "ca672a6e9e2cc4321c4cec954c2f168a624da54ce2ee061b9851ef257f45b342"
    },
    {
      "source_id": "id02729",
      "target": "— Хуже некуда: он стал аббатом.",
      "source_sha256": "63d70e6ab49912e4bbbaf2ad7341116a6f7a6b4751c22a57690ca7d7d5646fde",
      "target_id": "ru-id02729",
      "tag": "p",
      "target_sha256": "18b3af387093e9552bf443c6403e767ef17638c7a401fd7187713d5ddaffa8e1"
    },
    {
      "source_id": "id02730",
      "target": "— Ах, какое несчастье! — сказала госпожа де Шеврёз, небрежно играя веером. — По правде, сударь, я вас благодарю.",
      "source_sha256": "95b5fa89585bcdc4062eeaedf027df88934ee044f408b0688294417be6ccc9ba",
      "target_id": "ru-id02730",
      "tag": "p",
      "target_sha256": "14bc6a94c4138ce74392ce3b52c8627f2e1c6d9b0899de697d68431ad653a817"
    },
    {
      "source_id": "id02731",
      "target": "— За что, сударыня?",
      "source_sha256": "c17efce27b598be5a336eb071aa2e44de4447cfb17c40d56e40697edc2e7652a",
      "target_id": "ru-id02731",
      "tag": "p",
      "target_sha256": "bbc53e5b5fca9fd57a605db88917f6e8aac61be62e5294d436e114c5f233391e"
    },
    {
      "source_id": "id02732",
      "target": "— За то, что напомнили мне это воспоминание, одно из приятных воспоминаний моей юности.",
      "source_sha256": "b2970aa691f2643bd70857df4b4c19c858214d9eeff53d18bc38f04ec9ce5730",
      "target_id": "ru-id02732",
      "tag": "p",
      "target_sha256": "b91f007f55bf2a2a3e09ca9226d536de63e15478cd223fbfc20d52cb27b66315"
    },
    {
      "source_id": "id02733",
      "target": "— Позволите ли вы мне тогда, — сказал Атос, — напомнить вам ещё одно?",
      "source_sha256": "0400b75ca14bea2773d4067a106caa57314e77fa58121a0e1f44bfc07ced6656",
      "target_id": "ru-id02733",
      "tag": "p",
      "target_sha256": "cd225f210d3a90612a375fea778a4c88d18a5d467a0b32ded29885d1bfd0f685"
    },
    {
      "source_id": "id02734",
      "target": "— Связанное с этим?",
      "source_sha256": "3e31d661d6c8bf5c6a351600e90f0217cf6434aeb1253acadd73480996ae3941",
      "target_id": "ru-id02734",
      "tag": "p",
      "target_sha256": "4dfb8ede14dcad8023743226e9195f2daefd41142064c8fee902968ecbd7067b"
    },
    {
      "source_id": "id02735",
      "target": "— И да, и нет.",
      "source_sha256": "b7d4a1b805ebf46ea5080baf3d99651bd699bc9e9872a8d5c32fb9e31891f98b",
      "target_id": "ru-id02735",
      "tag": "p",
      "target_sha256": "d80b3f75204a2b7bb49e2d14d95746232c36e39c10b37ff6e82dd02db77906b1"
    },
    {
      "source_id": "id02736",
      "target": "— Право же, — сказала госпожа де Шеврёз, — говорите; от такого человека, как вы, я готова рискнуть чем угодно.",
      "source_sha256": "b9f7f96cfe3f63e97066dacc80e761049c1737a006571d8dc1ef3f48d35e99f6",
      "target_id": "ru-id02736",
      "tag": "p",
      "target_sha256": "8e68339a1c914b05b106801dae24444108b3efdc31919de6c9caaa41f5045020"
    }
  ],
