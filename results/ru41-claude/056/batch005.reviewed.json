{
  "unit": 56,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id07541",
      "target": "— Господин д’Артаньян! — кричал голос. — Господин д’Артаньян!",
      "source_sha256": "e191fdeb4a46e16984ff0136d67294f24caf291f83cb32c489cb40b9864d0b06",
      "target_id": "ru-id07541",
      "tag": "p",
      "target_sha256": "6a436e5c193f04c806f2c612e5feeac77135de5933bf38cbfa70ac0ce0025a06"
    },
    {
      "source_id": "id07542",
      "target": "— Здесь, — сказал Портос, — здесь!",
      "source_sha256": "246fc9dd004b437e056f521c4b304393820246ddc00f46af0376d8358a15826b",
      "target_id": "ru-id07542",
      "tag": "p",
      "target_sha256": "2efc25feaf06d1e4d8a388d604a1f49d401ac5f071dbb01708506f84e886ebdc"
    },
    {
      "source_id": "id07543",
      "target": "Портос понимал, что если д’Артаньян уйдёт, постель достанется ему одному.",
      "source_sha256": "6d0df483fbd483f8e7a268c3426beeb8da336a5cb1c60bf7073a727af2e04edf",
      "target_id": "ru-id07543",
      "tag": "p",
      "target_sha256": "2f8a1a09a80db761c3aad5ca82cd73193368e5b701e637059818c94456db72ae"
    },
    {
      "source_id": "id07544",
      "target": "Подошёл офицер.",
      "source_sha256": "f0628bfd3afbe45d42e86afc4882b307199a06ede2563c4aba3c816b0bb1a1d0",
      "target_id": "ru-id07544",
      "tag": "p",
      "target_sha256": "4d1c12357fda365e005488727800b39588d416d79b7c59d6f6196019a96ebbc9"
    },
    {
      "source_id": "id07545",
      "target": "Д’Артаньян приподнялся на локте.",
      "source_sha256": "611d2a5518b89bb7661d272ee1a0fd6baff9519cc5949c8c6c1675d074437f60",
      "target_id": "ru-id07545",
      "tag": "p",
      "target_sha256": "3083373a61239c367397a64642027875295d352987725d112d78b1ca0476af0a"
    },
    {
      "source_id": "id07546",
      "target": "— Это вы господин д’Артаньян? — спросил он.",
      "source_sha256": "4202bfc476ddcf09218fe6dcd9ae3376c4f8aba68a269011ff5e1c03e4e4efa1",
      "target_id": "ru-id07546",
      "tag": "p",
      "target_sha256": "792251281bf95ad290115a3f65fa7e42e7697f65e3c5419eb90daed3d46111f6"
    },
    {
      "source_id": "id07547",
      "target": "— Да, сударь; что вам угодно?",
      "source_sha256": "e564ba49a7bfb07971352bc92b88c82f288ced42d6a10e6b75b36aeb5b69f580",
      "target_id": "ru-id07547",
      "tag": "p",
      "target_sha256": "65c80f133fb77f1d3f3187e7f32ce782df9329a09683992f312d60e222124105"
    },
    {
      "source_id": "id07548",
      "target": "— Я пришёл за вами.",
      "source_sha256": "46dc120b97d1aa2450ccec8f98bfbd49dc6da5b0a3f8130c6a9ce66b52d004ef",
      "target_id": "ru-id07548",
      "tag": "p",
      "target_sha256": "4024dadc99fe02985d34b9952e7fa98b77609edd63594d2abfaeec473a782213"
    },
    {
      "source_id": "id07549",
      "target": "— От кого?",
      "source_sha256": "c355cd05e4631fe261abdf5cbf8bcca887996b672e8d8919bf2d25d4da20c0b2",
      "target_id": "ru-id07549",
      "tag": "p",
      "target_sha256": "71d9ee30c51d925b2c95eb07e4858fb0e353422696cd6ead49228c186415208d"
    },
    {
      "source_id": "id07550",
      "target": "— От его высокопреосвященства.",
      "source_sha256": "e96a84d368714e62a7dfb3f495fd7f23ab6f7759fb5778e1f223f92e04b29dd6",
      "target_id": "ru-id07550",
      "tag": "p",
      "target_sha256": "1a2a485043e619ed58a81bfb4894c5b351f04654ffea2add395d2762eca70faf"
    },
    {
      "source_id": "id07551",
      "target": "— Передайте монсеньёру, что я иду спать и по-дружески советую ему сделать то же.",
      "source_sha256": "cd9d76b7b138757a547ddc56cba48f45ade618d2f76c638d4e959a046f12b5d8",
      "target_id": "ru-id07551",
      "tag": "p",
      "target_sha256": "8fbcbba034264e79083f8255bf68dddc3a3fad4c4a6138467a4d13e89091a77c"
    },
    {
      "source_id": "id07552",
      "target": "— Его высокопреосвященство не ложился и не ляжет, и он просит вас к себе сию же минуту.",
      "source_sha256": "b77e22c37bbc97d6806b2ddc92448855135d2daf3486cfcee386e855ec4ec725",
      "target_id": "ru-id07552",
      "tag": "p",
      "target_sha256": "f1723c9de4a4df0aac2bf3d5b1f179d739b88ed384b3f33dd5a389c463fae2e5"
    },
    {
      "source_id": "id07553",
      "target": "— Чтоб чума задушила этого Мазарини, который не умеет спать вовремя! — пробормотал д’Артаньян. — Что ему от меня нужно? Уж не затем ли он зовёт, чтобы сделать меня капитаном? В таком случае я ему прощаю.",
      "source_sha256": "e6be2a515857279cd5ff328b9fdcf29b1ca5995fa70e65bbc3b4a6c024532e35",
      "target_id": "ru-id07553",
      "tag": "p",
      "target_sha256": "fc256377f5cbd309a767fef18873fbf3e6b936cfe72a7130b232d6a091bddff7"
    },
    {
      "source_id": "id07554",
      "target": "И мушкетёр, ворча, поднялся, взял шпагу, шляпу, пистолеты и плащ и последовал за офицером, а Портос, оставшийся единственным владельцем постели, пытался повторить превосходные приготовления своего друга.",
      "source_sha256": "d5fb240e12eb272b5af1bbd621203bd63f465382513b388b0303a144f9dfb8b3",
      "target_id": "ru-id07554",
      "tag": "p",
      "target_sha256": "d07b546a1edf6621e0cd82716a6b53d6f3e5d9d927da086291a3c231e2a43102"
    },
    {
      "source_id": "id07555",
      "target": "— <i>Мосье</i> д’Артаньян, — сказал кардинал, увидев того, за кем только что так некстати послал, — я отнюдь не забыл, с каким рвением вы мне служили, и сейчас дам вам в том доказательство.",
      "source_sha256": "f93820183549bdcbb8d5169fbf73b08f94a16764172619c704208dec4f7b1b29",
      "target_id": "ru-id07555",
      "tag": "p",
      "target_sha256": "6156f58a787e6934110d6710efb0983803712337dd89543ca17a6754c2b70a0d"
    },
    {
      "source_id": "id07556",
      "target": "— Добро! — подумал д’Артаньян. — Начало многообещающее.",
      "source_sha256": "2e2ed1c3f15f41f17ee7f4557bc38241efda72df3c85a7f8d6204a3b4f51249c",
      "target_id": "ru-id07556",
      "tag": "p",
      "target_sha256": "0f0b043b8868bd07cab1b7e80c26108c9f6b7a4cef95a0405af38e1a32c90ba4"
    },
    {
      "source_id": "id07557",
      "target": "Мазарини смотрел на мушкетёра и увидел, как его лицо просияло.",
      "source_sha256": "c8adcf35285d621398f8d860c98f21b42f06dfa4ce0159c62934b52b7e6bb659",
      "target_id": "ru-id07557",
      "tag": "p",
      "target_sha256": "4184526f5ee026ae698271a29f7e01816e63f15e102406b8b5bd5d33f6827012"
    },
    {
      "source_id": "id07558",
      "target": "— Ах! Монсеньёр…",
      "source_sha256": "16cfd81a177854208fd6be9082323df754f2a1e0b13582ff81f143ca4493f2d5",
      "target_id": "ru-id07558",
      "tag": "p",
      "target_sha256": "a5712b0bcfa0178517a718263662294ffd5615c634559f6a95c0455b254a6f70"
    },
    {
      "source_id": "id07559",
      "target": "— Господин д’Артаньян, — сказал он, — очень ли вам хочется быть капитаном?",
      "source_sha256": "a94a757e72dc6e0d9955dcea2a40ea8ea19ed540a646e20a9e57ce0f155e9ad2",
      "target_id": "ru-id07559",
      "tag": "p",
      "target_sha256": "ef68c9f15d365ca69d8cc37a5d4dec62e1606341c38b862da4d5b48c1b0e4efb"
    },
    {
      "source_id": "id07560",
      "target": "— Да, монсеньёр.",
      "source_sha256": "13e24f3381ef68e918470010b319a51fb81d457ef2ba9929b18fdfa99ff3cbff",
      "target_id": "ru-id07560",
      "tag": "p",
      "target_sha256": "003359fd9fc6dbca41b6da41f877f251a89ddc4120aa6cc65184af207614e035"
    }
  ],
