{
  "unit": 56,
  "batch": 3,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id07501",
      "target": "И так как вокруг толпились самые разные люди и с изумлением глядели на приезд двора, он докончил свою фразу совсем тихо, на ухо Портосу.",
      "source_sha256": "401576b6a05fed0ee7cc29bd22bf67e69d84e06ba501d5b6909bd951405231be",
      "target_id": "ru-id07501",
      "tag": "p",
      "target_sha256": "1e3995eb44f41e2bc9cd78085bd4bdf89936eb62d18fe367cb581198240068b4"
    },
    {
      "source_id": "id07502",
      "target": "— Понимаю, — сказал Портос, — понимаю прекрасно, честное слово! По двести луидоров каждому — это недурно; но что станут говорить?",
      "source_sha256": "e382b5e942735ba1f270e3c273ed62f4a8973a4d6e28945a9d8347a294c363c9",
      "target_id": "ru-id07502",
      "tag": "p",
      "target_sha256": "8535e85c208978bf1580fb29506587ca373938afdfe96e2c89f2ab04fd84e86a"
    },
    {
      "source_id": "id07503",
      "target": "— Пусть говорят что угодно; да и откуда узнают, что это мы?",
      "source_sha256": "c7f25ad22641ec1129b4c17ac8e9e553a01eb473553e9497b097ae4149c0b7fa",
      "target_id": "ru-id07503",
      "tag": "p",
      "target_sha256": "52b3395a8bc89223f9cdea42d541e8fdbfffdfecb020e6cd330601f9e14c694f"
    },
    {
      "source_id": "id07504",
      "target": "— Но кто возьмёт на себя раздачу?",
      "source_sha256": "b858acda98ca7f7b43d8ce0fc05819a28e6eedc36e1bf3634a48338161e1d87f",
      "target_id": "ru-id07504",
      "tag": "p",
      "target_sha256": "7bc7e621a603e56600764d31858b29d29ee57d3eb1c5106c91875744cb2e79de"
    },
    {
      "source_id": "id07505",
      "target": "— А Мушкетон разве не здесь?",
      "source_sha256": "43c7dbc378f0b303e571287d5f0058fbf3c2c0d2afffc7329a936a0b19c1d28c",
      "target_id": "ru-id07505",
      "tag": "p",
      "target_sha256": "d5e0c300db5dbe7468e6f1686c3bfb83c4d775637815daa56767b34882cdfa7e"
    },
    {
      "source_id": "id07506",
      "target": "— А моя ливрея! — сказал Портос. — Ведь узнают мою ливрею.",
      "source_sha256": "a7c058f6ca88b03a32fbe7e1a94c175423e55a94bebe18d953988feb89db1ba2",
      "target_id": "ru-id07506",
      "tag": "p",
      "target_sha256": "8c3b15f9b4b8dd34364521fe1a0e07648c0f32e8d31d8d57c6062b83529f7f2b"
    },
    {
      "source_id": "id07507",
      "target": "— Он вывернет свой кафтан наизнанку.",
      "source_sha256": "02e8b63ab1ac7a85aeea4fd44d9c0560d1b10abdae0cf46d6614b054faea2055",
      "target_id": "ru-id07507",
      "tag": "p",
      "target_sha256": "d14df5fd492db02ab46afee85956f6570d7d3af65be9fb08084e4a1b6b548890"
    },
    {
      "source_id": "id07508",
      "target": "— Вы всегда правы, мой милый, — воскликнул Портос, — но откуда, чёрт возьми, вы берёте все эти ваши идеи?",
      "source_sha256": "f6a3486a4799ebeb0ab5b802be400257296f94b48a45d8948ea225e5315b1289",
      "target_id": "ru-id07508",
      "tag": "p",
      "target_sha256": "d9d9b3b0f4b3617ebfb7bd1fb7a96dbc45056470567e8d6644f3ef36fe8bcdb4"
    },
    {
      "source_id": "id07509",
      "target": "Д’Артаньян улыбнулся.",
      "source_sha256": "7a0939bd2ce4ae2dafd2d38d319cc436de18ed4d140f9114c3aa22ed09f9203f",
      "target_id": "ru-id07509",
      "tag": "p",
      "target_sha256": "87277d0260c7aaa3e9d278d537074d2a100f2d92537ee784bb2ac06134131dff"
    },
    {
      "source_id": "id07510",
      "target": "Оба друга свернули в первую же попавшуюся улицу; Портос постучал в дверь дома справа, а д’Артаньян в то же время стучал в дверь дома слева.",
      "source_sha256": "b58be5cc910aab22d177b8881550f1358e99afbb3864230853b9a7a6ff9e70d5",
      "target_id": "ru-id07510",
      "tag": "p",
      "target_sha256": "d0440f234cf929299760c1ec8fcc51c56e6c9806214d084d418d515a870c68ae"
    },
    {
      "source_id": "id07511",
      "target": "— Соломы! — сказали они.",
      "source_sha256": "e7d66a789598ddd08f0676445d306cf4b090ccbb07c661b544677f93f455ee20",
      "target_id": "ru-id07511",
      "tag": "p",
      "target_sha256": "fb45293ad3a6703b35f989f192e760a081b9aec16cedda1ad490981b389c2403"
    },
    {
      "source_id": "id07512",
      "target": "— Сударь, у нас её нет, — ответили те, кто вышел отворить, — но обратитесь к торговцу фуражом.",
      "source_sha256": "6c324dc9d43e1dc0873d5b5a656cc4d50613c6ec535707fdc5a480feea5667dd",
      "target_id": "ru-id07512",
      "tag": "p",
      "target_sha256": "9ab2830bada89cfc265bd3de25f78a420c4f33e76315f994f29fc5078163acb1"
    },
    {
      "source_id": "id07513",
      "target": "— А где он, этот торговец фуражом?",
      "source_sha256": "0098a0558296145574d25e75f7eddf7709898a2d65de26e8c95d08d9da2898ec",
      "target_id": "ru-id07513",
      "tag": "p",
      "target_sha256": "bbd7732d7837f200c8a065d50514d8a548b7159ffbcc6c2ba77f3ecee40a2c22"
    },
    {
      "source_id": "id07514",
      "target": "— В последних больших воротах на этой улице.",
      "source_sha256": "0e7840123ac8bbd57582413826b78f58c116b7de9c6036692d65e510d788a4b9",
      "target_id": "ru-id07514",
      "tag": "p",
      "target_sha256": "800538addcf3ebd268d3375e2ebdddc3df1ab4a5e24fbe1cc04edd4452c50e77"
    },
    {
      "source_id": "id07515",
      "target": "— С правой стороны или с левой?",
      "source_sha256": "fe5ad4e48ccb666fc84dfe09eaf9692d5c0864eb80e58b034fad0b7ab2df11d6",
      "target_id": "ru-id07515",
      "tag": "p",
      "target_sha256": "3a1c3da1015f9dd5e43b51e4f921193d88f03f83fcc5076d8c05469fda51259b"
    },
    {
      "source_id": "id07516",
      "target": "— С левой.",
      "source_sha256": "a2974b5bfd5839ef0740c9b5548878185e9696d28592929c583b26267d1fab81",
      "target_id": "ru-id07516",
      "tag": "p",
      "target_sha256": "c1d8bff321c33dfd8612a47c32bc8905c402b03635b8893adb6aec241e500525"
    },
    {
      "source_id": "id07517",
      "target": "— А есть ли ещё в Сен-Жермене другие люди, у которых можно было бы её найти?",
      "source_sha256": "16442b32c0d2e5e13f737e44d12aedd20f01e3bedd6a5ce05ffa2884cc22c33f",
      "target_id": "ru-id07517",
      "tag": "p",
      "target_sha256": "d4d27d84444d943d58d59b459383eb19904bcb145757abbdb82259a39d5a8da5"
    },
    {
      "source_id": "id07518",
      "target": "— Есть трактирщик из «<i>Венчанного барана</i>» и Гро-Луи, фермер.",
      "source_sha256": "47e17bc2831fff337c8aa0cfee84e2dd1d23eb8864f6dd98c8cb1f0a6a478780",
      "target_id": "ru-id07518",
      "tag": "p",
      "target_sha256": "2e6601db2f350392c46be48803fa7939763379aa0eb4dccde5c1bfc767062e94"
    },
    {
      "source_id": "id07519",
      "target": "— Где они живут?",
      "source_sha256": "44f8e813cd8e312c4f87ab3e0f0dd78cba8efd4b75c62bf2a95a4e18af34f096",
      "target_id": "ru-id07519",
      "tag": "p",
      "target_sha256": "0d7627f46e268339f41eb07aad1c0c8c064313d8756862e7fff2d2267a491e85"
    },
    {
      "source_id": "id07520",
      "target": "— На улице Урсулинок.",
      "source_sha256": "34a3b948d8d6bfd28c69e07e75026a82c18766f3a341f145b885d33892d6caf3",
      "target_id": "ru-id07520",
      "tag": "p",
      "target_sha256": "fefea73459537228185fd899797f09fd9488a1e3d4e5df5b234295f0ecc628f7"
    }
  ],
