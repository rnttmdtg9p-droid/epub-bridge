{
  "unit": 25,
  "batch": 6,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id03282",
      "target": "— Поспешим, — сказал герцог.",
      "source_sha256": "95685d9d40fa4380adb10f2689150342d4cf3b95cc84f02037cafa4fa88c1422",
      "target_id": "ru-id03282",
      "tag": "p",
      "target_sha256": "8f5a158e44ea4a30db4a10ea031baeadb74c2ad3982d6cc1311cacdad1592650"
    },
    {
      "source_id": "id03283",
      "target": "— Монсеньер, одну последнюю милость.",
      "source_sha256": "a3ef50a17888a4d1201327ba1d6101c74d77365d945b4156645831d4843e7555",
      "target_id": "ru-id03283",
      "tag": "p",
      "target_sha256": "ce079e80ba1f364bc47712827d0be720b6f3f83ba055d4b9f43632bed16989d7"
    },
    {
      "source_id": "id03284",
      "target": "— Какую? Говори, поторапливайся.",
      "source_sha256": "088251fcc01605db01f7aea80ebad4eac636644468eba92c16c68803d85cb528",
      "target_id": "ru-id03284",
      "tag": "p",
      "target_sha256": "ea368bab1f642d4bb592b99b432fe84f260cb3e4017089466652138d436030d6"
    },
    {
      "source_id": "id03285",
      "target": "— Свяжите меня покрепче, монсеньер.",
      "source_sha256": "8a40c3295f363d37332e579040a18e4a3c5ef0867ea466e1141a0fed9dd36cf4",
      "target_id": "ru-id03285",
      "tag": "p",
      "target_sha256": "c858965de2b9f9d26bd9fb3dd4b2d028e6aa69abbfe6c68821f6928dc0657e45"
    },
    {
      "source_id": "id03286",
      "target": "— Это ещё зачем — связать тебя?",
      "source_sha256": "fc848f31a2d8e0796e3ed6d112ad815ac00b2e3e09e683a76c97c47ad5ebde59",
      "target_id": "ru-id03286",
      "tag": "p",
      "target_sha256": "fad74726a5ee5ad9fa44c42ef75ef278a3ed1289c2d740309c5cab6ed76b4437"
    },
    {
      "source_id": "id03287",
      "target": "— Чтобы не подумали, будто я ваш сообщник.",
      "source_sha256": "462227d354f8aae772260bfed97d19641b97a4e07909bb7a66c6e355419719f5",
      "target_id": "ru-id03287",
      "tag": "p",
      "target_sha256": "a21f7eed0cc9805c0b73fedb7e0f3ed8f6fc0ea4458f407a12bf6762fc26f6ac"
    },
    {
      "source_id": "id03288",
      "target": "— Руки! — сказал Гримо.",
      "source_sha256": "384f75a3dc8071aa847e7ff6201e01b5ac773e376f2c6ff778d75e8eafb2501e",
      "target_id": "ru-id03288",
      "tag": "p",
      "target_sha256": "7692371f69384af11802544476e9b541eaaba761ef4e776dc5b6c3b99d5e094f"
    },
    {
      "source_id": "id03289",
      "target": "— Не спереди, а сзади же, сзади!",
      "source_sha256": "2ea6d45c5a5c56dee5b26e53a287c48a21419d3b0571f360a697c9ef58a7c4eb",
      "target_id": "ru-id03289",
      "tag": "p",
      "target_sha256": "a55ebe1d7cfb6326a5d38ba81fb0932f2ba507bcb0af3aeefef24daa168a25f9"
    },
    {
      "source_id": "id03290",
      "target": "— Но чем? — сказал герцог.",
      "source_sha256": "b6737f66dd97927378fc5a0f12bb65314419e87342bc76cf34d46dd1e6e00da6",
      "target_id": "ru-id03290",
      "tag": "p",
      "target_sha256": "e8df7e1027a8118c0a134292692e3554c3bc5a365295fd6e086ef45fea07f898"
    },
    {
      "source_id": "id03291",
      "target": "— Вашим поясом, монсеньер, — отвечал Ла Рамей.",
      "source_sha256": "17abd5a84acba36ea71f916b8c4f321871779d7c12f4eec4458e88d2e993ebcb",
      "target_id": "ru-id03291",
      "tag": "p",
      "target_sha256": "512289e0c58c07945de053aa224de1794a7d7eb45b8324f1a054369f39632d05"
    },
    {
      "source_id": "id03292",
      "target": "Герцог отстегнул пояс и отдал его Гримо, который связал Ла Рамею руки так, чтобы тот остался доволен.",
      "source_sha256": "99a72149694e64d4c1057a08565de18e9aed6b63dbeab1ba2e92267c7ab0eae0",
      "target_id": "ru-id03292",
      "tag": "p",
      "target_sha256": "f41dbfcb0d1237cd293bf1d6b7f757419462eb0e9e8d03fed13190d25d414b7b"
    },
    {
      "source_id": "id03293",
      "target": "— Ноги, — сказал Гримо.",
      "source_sha256": "74a27ab884e4391c6c2459e2fdd3e8ab457505bdb690c6e87bf6aacfe7d974e5",
      "target_id": "ru-id03293",
      "tag": "p",
      "target_sha256": "fcf9392522190dabb13bbc9dbbb74ba1f7876279ac9059a1096e871db57fac96"
    },
    {
      "source_id": "id03294",
      "target": "Ла Рамей вытянул ноги; Гримо взял салфетку, разорвал её на полосы и обвязал Ла Рамея.",
      "source_sha256": "b5b4cc472c19185158a8dcafc1226b8738eee8f4a09576b1697a6131a6e5d680",
      "target_id": "ru-id03294",
      "tag": "p",
      "target_sha256": "0bd83e83b301bf0c2cd1397c7cf2f4fa53670f570eec3132d523ea9e2fefe4b9"
    },
    {
      "source_id": "id03295",
      "target": "— Теперь моя шпага, — сказал Ла Рамей. — Свяжите же эфес моей шпаги.",
      "source_sha256": "f8961e0b38d63fa597748cdc723014b2a52d52f795dff09d6b7395f0c012f8fa",
      "target_id": "ru-id03295",
      "tag": "p",
      "target_sha256": "0c70a207d98e5d25339dc3aab477c9e7691dfb991aa5c2103eff937044bafcd3"
    },
    {
      "source_id": "id03296",
      "target": "Герцог оторвал одну из лент от своих штанов и исполнил желание своего стража.",
      "source_sha256": "8436d5acae1623655c40b4cbff5fbc6731eadcf0155a4625e130ecdd2238a6d5",
      "target_id": "ru-id03296",
      "tag": "p",
      "target_sha256": "be2953cd4840d9e5c69204e3176fa086a31448c565e8e1e033bd7502d7f7e88c"
    },
    {
      "source_id": "id03297",
      "target": "— Теперь, — сказал бедняга Ла Рамей, — грушу-кляп; я её прошу, иначе меня предадут суду за то, что я не кричал. Заталкивайте, монсеньер, заталкивайте.",
      "source_sha256": "69c677ba1b348980ba692c62e49ea8513972e0e03b9942119d64fab173490d3a",
      "target_id": "ru-id03297",
      "tag": "p",
      "target_sha256": "4173d9d5f09492237ea7b4fc71b52ff3395db515bca30b71cd6040a2ed54b0d1"
    },
    {
      "source_id": "id03298",
      "target": "Гримо приготовился исполнить желание сержанта, но тот сделал движение, давая понять, что хочет что-то сказать.",
      "source_sha256": "570fec684f890f322894357e9ff1e0b0025440c19466274f9abc2d3fa3e9208a",
      "target_id": "ru-id03298",
      "tag": "p",
      "target_sha256": "8e8a4b587347b54c3f68cac642a4beb28b5e089a8ea4eaa7ef304ff016d9375e"
    },
    {
      "source_id": "id03299",
      "target": "— Говори, — сказал герцог.",
      "source_sha256": "9902f35aacee4cafdf52072c49b73fd616281ef40b382aa8ecae260714b2a9ff",
      "target_id": "ru-id03299",
      "tag": "p",
      "target_sha256": "4f17b05dc14fadc1e96a40118a05535a6a108fb64c2a28378509f1932632b058"
    },
    {
      "source_id": "id03300",
      "target": "— Теперь, монсеньер, — сказал Ла Рамей, — не забудьте, если со мной случится беда из-за вас, что у меня жена и четверо детей.",
      "source_sha256": "5537521153c5816a55e482d6d027d1b4735286a52ba2ecde87d42d03854f9d64",
      "target_id": "ru-id03300",
      "tag": "p",
      "target_sha256": "3f17c22035f7283c82d0a2b11c111814783aee2e749b1739dafd133c81286d1c"
    },
    {
      "source_id": "id03301",
      "target": "— Будь спокоен. Заталкивай, Гримо.",
      "source_sha256": "23bbc50df7aa3fdb37c26b910e4bc501493a220912ef9bda3ae563563db7a911",
      "target_id": "ru-id03301",
      "tag": "p",
      "target_sha256": "76bc14d6d9c215e291420d80a55c1746af55324b618e39b8056fd6d3304e7737"
    }
  ],
