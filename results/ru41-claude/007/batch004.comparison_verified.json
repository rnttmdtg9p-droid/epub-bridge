{
  "unit": 7,
  "batch": 4,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id00860",
      "target": "— Тоже нет.",
      "source_sha256": "80600169db40a692856fb6af354976d03f4fbb02777879509e272aef6be49b0c",
      "target_id": "ru-id00860",
      "tag": "p",
      "target_sha256": "b73f13d5a25ea445989308e42a4c9db9477f151c373624ba46bedf8299ccffbc"
    },
    {
      "source_id": "id00861",
      "target": "— Чёрт, чёрт, чёрт!",
      "source_sha256": "26ab3a939c3ab5a5455f7b815ff2f309823b05ca2c164b481d1d44adabdf0a08",
      "target_id": "ru-id00861",
      "tag": "p",
      "target_sha256": "7608d47378d6efda4555b934993b6ec719e02880f3327281e58d01c9000911d0"
    },
    {
      "source_id": "id00862",
      "target": "— Но, — сказал Планше со своим насмешливым видом, — я ведь знаю, где Базен?",
      "source_sha256": "a91b0eb8e4b6105ed0ccc662d758584854f65fa19b363619d9bdaafae260b285",
      "target_id": "ru-id00862",
      "tag": "p",
      "target_sha256": "51592211aa3dacefa1b859cbcc77aa6fdcf3e420fc19e48efbf41bfce1948e78"
    },
    {
      "source_id": "id00863",
      "target": "— Как! Ты знаешь, где Базен?",
      "source_sha256": "de94510ddd492c60e55bbbe0df0de2792f18637119350c62f63ce506c3787ee2",
      "target_id": "ru-id00863",
      "tag": "p",
      "target_sha256": "8b94536dfeebf579becd74a4da99b17d5e8ef886496edc9348493b8075e73bed"
    },
    {
      "source_id": "id00864",
      "target": "— Да, сударь.",
      "source_sha256": "0d5465ec58ffd8a169046d0b5a9216b597e575402307c2d51b58ce3a1f4a288b",
      "target_id": "ru-id00864",
      "tag": "p",
      "target_sha256": "0f30ca25a26a70285ef79b1fb369b91f72bbcf35f0b8954f7043730d2f6ae3c7"
    },
    {
      "source_id": "id00865",
      "target": "— И где же он?",
      "source_sha256": "3f79a617aeaad7ea3084aeadb3e3a3e45dc48f7b2d361a9a832b418246354b78",
      "target_id": "ru-id00865",
      "tag": "p",
      "target_sha256": "2de359a970e6065c9a70fdc45a73513c95a2c4cc0a3c1e7bbbbb7cda46b583b1"
    },
    {
      "source_id": "id00866",
      "target": "— В Нотр-Дам.",
      "source_sha256": "64b3388a3eb69841c464ea098e31ca3a55867bb45d16e29c20fc79d929d13d12",
      "target_id": "ru-id00866",
      "tag": "p",
      "target_sha256": "2e2a34ec4b0d841847e0fbda0d7ee47160fc165f92a04ae696720d7b412f4f42"
    },
    {
      "source_id": "id00867",
      "target": "— А что он делает в Нотр-Дам?",
      "source_sha256": "b69a5fbf6b2406fa36f9ca5d6a65082794308b6076bc0739e7e18cb6ab79849d",
      "target_id": "ru-id00867",
      "tag": "p",
      "target_sha256": "aca1ad6ca080440ae77f29c40d2fd39a83c8f8ac8f81da537fa7c6b2e1478d97"
    },
    {
      "source_id": "id00868",
      "target": "— Он церковный служитель.",
      "source_sha256": "2c7077fffb109e8a4b195afe88069eb29d0b2d976c4685eff8ddd1a7cfe06fa7",
      "target_id": "ru-id00868",
      "tag": "p",
      "target_sha256": "f3c79445c938157e9cacf6070b3bcd01d14ed3daa427ac5accf0054fd014b890"
    },
    {
      "source_id": "id00869",
      "target": "— Базен — церковный служитель в Нотр-Дам! Ты в этом уверен?",
      "source_sha256": "7dc6de15db1022bcc390cd6b63f5e92b36d3d8b2ed63562a2575b48d124efe74",
      "target_id": "ru-id00869",
      "tag": "p",
      "target_sha256": "74dc40bdd04208c682affbfab49647c6f37bb79a7d8144f3bd10b54ab1c29a85"
    },
    {
      "source_id": "id00870",
      "target": "— Совершенно уверен: я видел его, я с ним говорил.",
      "source_sha256": "ff3bb011d433ba62e0298a7055e1389d12b1223b6aabb6b0f62716c0ae188b91",
      "target_id": "ru-id00870",
      "tag": "p",
      "target_sha256": "cd1bb04b0283d133f1f6e256e5c55bf4880ee3af96989ecc44b0f85cf930788a"
    },
    {
      "source_id": "id00871",
      "target": "— Он должен знать, где его господин.",
      "source_sha256": "3d50767dfb3dd3775dd35351902712fe57c6ef51e7bbfaf6e45286a462ce53bf",
      "target_id": "ru-id00871",
      "tag": "p",
      "target_sha256": "08334db14680143736970f70da779465d5b37ea01be5e23f0c1c5930a580597c"
    },
    {
      "source_id": "id00872",
      "target": "— Без всякого сомнения.",
      "source_sha256": "02541af703437b2f511c91aee97af5c3234029f454ba9f05aa882ecc524d2a05",
      "target_id": "ru-id00872",
      "tag": "p",
      "target_sha256": "e999eadee96593b9015c0b1835aebd8a54f10b5da0dd6f390b3bdf5a210e01e3"
    },
    {
      "source_id": "id00873",
      "target": "Д’Артаньян поразмыслил, потом взял плащ и шпагу и приготовился уйти.",
      "source_sha256": "508ccf8fbec74a28ae79e2fa1cd890c4fff3747063804aa14a9313f5b1287817",
      "target_id": "ru-id00873",
      "tag": "p",
      "target_sha256": "997d9b00f2b0ffdadad0c73eb6794b4ff2e2e749db733ce64e87407f8d53ab3d"
    },
    {
      "source_id": "id00874",
      "target": "— Сударь, — жалобным голосом сказал Планше, — неужели вы так меня бросаете? Подумайте, вся моя надежда только на вас!",
      "source_sha256": "9e1c9485b5b9d627fcd7429235232ac1d6d3b7f094df9170af23500a39ea1143",
      "target_id": "ru-id00874",
      "tag": "p",
      "target_sha256": "d127b55c8283f0f380f96b38de2293b1d62bcaf17d9e334abc7ddaffe00ccea1"
    },
    {
      "source_id": "id00875",
      "target": "— Но тебя ведь не придут искать здесь, — сказал д’Артаньян.",
      "source_sha256": "2f89539d36fcf23468a22915b482c54464e696818c51efc82ea0b7d6e326a2ca",
      "target_id": "ru-id00875",
      "tag": "p",
      "target_sha256": "da044d017d305e0a597bd02f9ed3230e19b2d8bd672dc59d131ca70950e79f2e"
    },
    {
      "source_id": "id00876",
      "target": "— И всё же, если бы сюда пришли, — сказал осторожный Планше, — подумайте: для людей в доме, которые не видели, как я вошёл, я вор.",
      "source_sha256": "baced3aa0763e96432ba81f053db1be856227d9b4e8fe352772ce319d1bce362",
      "target_id": "ru-id00876",
      "tag": "p",
      "target_sha256": "b9507c4b45436025b02c66df73decb6c1c0d9a7e880efb34286ef48d3ddbec41"
    },
    {
      "source_id": "id00877",
      "target": "— Это справедливо, — сказал д’Артаньян. — Ну-ка, ты говоришь на каком-нибудь говоре?",
      "source_sha256": "06ae6f86eaddd38acef9ec8ce469381f9395ee96e769ffb2137bd110e0b86a10",
      "target_id": "ru-id00877",
      "tag": "p",
      "target_sha256": "3ff88981cbfbeed70dd90a31debab15a0a6431cdfe64b8acacfd438b7dc2754b"
    },
    {
      "source_id": "id00878",
      "target": "— Я говорю лучше, чем на говоре, сударь, — сказал Планше, — я говорю на языке; я говорю по-фламандски.",
      "source_sha256": "9da9c7758c19e47f256b46332232258f1753c054a783445f15e081ff63e19072",
      "target_id": "ru-id00878",
      "tag": "p",
      "target_sha256": "133712a44789f5cbc59a8bae5c1c3334f6a1d9be852d3beff3cf58a9c5c781e1"
    },
    {
      "source_id": "id00879",
      "target": "— И где, чёрт возьми, ты его выучил?",
      "source_sha256": "94aaae09490fd57320cf2f2d3e5ddac64c9920846253749936539aa2868638ee",
      "target_id": "ru-id00879",
      "tag": "p",
      "target_sha256": "9978088a5684a6e9e5286ba2399c1b59ae438cb2a22df52e951f03ea57794c7b"
    }
  ],
