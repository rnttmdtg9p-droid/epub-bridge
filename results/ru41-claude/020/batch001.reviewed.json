{
  "unit": 20,
  "batch": 1,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_BOOK_RECONCILIATION",
  "rows": [
    {
      "source_id": "id02297",
      "source_sha256": "c7401e8f6d20346566c173fb13fffe5fbb782d4b64b4c6680c941ebcc49cad7f",
      "target": "— Кто же ты тогда? Отвечай, я приказываю, — сказал герцог.",
      "target_id": "ru-id02297",
      "tag": "p",
      "target_sha256": "918bd3bd35832da9384a3fd4b61ea0939bdcb02881543b6a565409c8c1034063"
    },
    {
      "source_id": "id02298",
      "source_sha256": "0015b7759f47c975c18f1f40b3dbdcabc32370d30a4afa6bbf4b5f182c8fa342",
      "target": "— Страж, — ответил Гримо.",
      "target_id": "ru-id02298",
      "tag": "p",
      "target_sha256": "e2cac4cdca46d2150cac6caf12f8acf11b019d8c2124ddec3c896813fd242c52"
    },
    {
      "source_id": "id02299",
      "source_sha256": "82756d132e004f979c0aa1333ae3a1e2cd9fa58810577bf1275707c173f88ace",
      "target": "— Страж! — воскликнул герцог. — Прекрасно, в моей коллекции недоставало только этой виселичной рожи. Эй! Ла Раме, кто-нибудь!",
      "target_id": "ru-id02299",
      "tag": "p",
      "target_sha256": "f9aab703ea3f63990028ca10c336dd08bd7e1b263e528a53dc1f41089ef5b0ec"
    },
    {
      "source_id": "id02300",
      "source_sha256": "1aa95ba37775ce7a1a4753b7ff63045ab7c85bd6276316a94a7869e4bd0eb699",
      "target": "Позванный Ла Раме прибежал; к несчастью для принца, он собирался, положившись на Гримо, ехать в Париж, уже был во дворе и поднялся обратно недовольный.",
      "target_id": "ru-id02300",
      "tag": "p",
      "target_sha256": "f43e1d459df99df4d0bb3dbed1c210762d649005f56d680ac5671434105ac20f"
    },
    {
      "source_id": "id02301",
      "source_sha256": "3b05f2504fbfe22566f3f18ea85b76e52499bdb6011eb12ae515d4ec0fa5469f",
      "target": "— В чём дело, монсеньор? — спросил он.",
      "target_id": "ru-id02301",
      "tag": "p",
      "target_sha256": "bce10239ebe3dd07dd0b1f785701e33c102a70be3f095c25b68fad0f65e61100"
    },
    {
      "source_id": "id02302",
      "source_sha256": "3ba1f4cb0628b417c6976dc912a65dcc533525f7180673b0d3da7803aeee39f7",
      "target": "— Что это за мерзавец, который берёт мой гребень и кладёт его к себе в карман? — спросил г-н де Бофор.",
      "target_id": "ru-id02302",
      "tag": "p",
      "target_sha256": "f703409ae89be01bf65f08b34b378e74074581bd2fe066e1879cd3520045fa42"
    },
    {
      "source_id": "id02303",
      "source_sha256": "39845a9992a0d467923fec32406e2021324b0c7dea43f3ed4d7d8a582d5d3276",
      "target": "— Это один из ваших стражей, монсеньор, малый, исполненный достоинств, и вы оцените его так же, как господин де Шавиньи и я, в этом я уверен.",
      "target_id": "ru-id02303",
      "tag": "p",
      "target_sha256": "d43f70c3bf156026fe924ca97ba518868f803b868f250851e19123c560263c3a"
    },
    {
      "source_id": "id02304",
      "source_sha256": "abd94044ef468c39c11f89e1a15ef421b5dfb48d78b093dce5f17cb53c042389",
      "target": "— Почему он берёт мой гребень?",
      "target_id": "ru-id02304",
      "tag": "p",
      "target_sha256": "7662cb4025cb05bae70d7476931a13436b04593a5e66168da6f9e8cd72104275"
    },
    {
      "source_id": "id02305",
      "source_sha256": "859f6c3655d2d6a54189643680d2810e84ae47a3671d0457727c22ed65a36cdc",
      "target": "— В самом деле, — сказал Ла Раме, — почему вы берёте гребень монсеньора?",
      "target_id": "ru-id02305",
      "tag": "p",
      "target_sha256": "5481d2639e1e35feb7a0177b89fb1c5bf6d637f0507ecae584ff5878b8bc6734"
    },
    {
      "source_id": "id02306",
      "source_sha256": "8ff68b65fed55e9d6654eab0879fb363952d3455947bb8f90e2e756d3a27efae",
      "target": "Гримо достал гребень из кармана, провёл по нему пальцем и, глядя на самый крупный зубец и показывая его, ограничился одним-единственным словом:",
      "target_id": "ru-id02306",
      "tag": "p",
      "target_sha256": "36b172a93448ac4cdd791cdb37fcdf950b110b48d7f18c53e572e3fbbf916ad7"
    },
    {
      "source_id": "id02307",
      "source_sha256": "2c72f2433c1dc23905bcdbcecdcbbbcc0837c798bb78a45d00e099859f253aba",
      "target": "— Колется.",
      "target_id": "ru-id02307",
      "tag": "p",
      "target_sha256": "7c4478fc35280af6c8495f353ae1772dd123f76699348e5b9c6fdf795409944c"
    },
    {
      "source_id": "id02308",
      "source_sha256": "cad232f1e7063c386d0554bdd1e53fd48bf992c81e94909362ae86f01d8a39c7",
      "target": "— Это правда, — сказал Ла Раме.",
      "target_id": "ru-id02308",
      "tag": "p",
      "target_sha256": "61eb99cb2d1e9c2e88eb409d2f590b43f008ff7cb2320219ee6d085807b88c75"
    },
    {
      "source_id": "id02309",
      "source_sha256": "958d7e7fd27a31190a9f4f049794d7d2e6b32bdcc148dcebaa9d3fdb2af5d008",
      "target": "— Что говорит это животное? — спросил герцог.",
      "target_id": "ru-id02309",
      "tag": "p",
      "target_sha256": "eaae3662fbe84b4d3ff4fc05702df9a01f6667b9e91dc603d55bef4b68bc55f6"
    },
    {
      "source_id": "id02310",
      "source_sha256": "9df35221e6f0e5709b1aceaf60a127e3905eff48bd99f43a656ff1159a2ae1f9",
      "target": "— Что король запретил монсеньору любые колющие предметы.",
      "target_id": "ru-id02310",
      "tag": "p",
      "target_sha256": "09a9e01823127d6da2ad18bba4e365d83babcfe89b9be7517511755aa88e5d2f"
    },
    {
      "source_id": "id02311",
      "source_sha256": "5696a0efb3be90c8dd68670e8e7f561b80ae9214af0970a2f7bac9ed0c61f76f",
      "target": "— Да что это! — сказал герцог. — Вы с ума сошли, Ла Раме? Ведь вы сами мне его и дали, этот гребень.",
      "target_id": "ru-id02311",
      "tag": "p",
      "target_sha256": "7f47e60f599ddfe788a57144ea8e42ee7d5530781d817168822b6f210f938403"
    },
    {
      "source_id": "id02312",
      "source_sha256": "2bd372f487df3eaebc5d2a2217ff07278e1e33693e03060d86b39d5a7987e350",
      "target": "— И очень напрасно, монсеньор, ибо, давая его вам, я нарушил свой приказ.",
      "target_id": "ru-id02312",
      "tag": "p",
      "target_sha256": "b24e5f68106d4c87547230ebbb50c5d958ea27419a0a09e5a3985a37b390c959"
    },
    {
      "source_id": "id02313",
      "source_sha256": "eb7703e1e28980fa4503cc207c2ead0a87f1477ec0a7fe66d7829dee4eddd9cd",
      "target": "Герцог яростно посмотрел на Гримо, который вернул гребень Ла Раме.",
      "target_id": "ru-id02313",
      "tag": "p",
      "target_sha256": "3f43891bc1033e139ee8600fbc213cd2922c4179c7aeca716080463e89e1ca01"
    },
    {
      "source_id": "id02314",
      "source_sha256": "2a335decd0a74b2bfbb785357fc73f953968ed389483df67d4463f2d80aa4366",
      "target": "— Предвижу, что этот плут будет мне крайне неприятен, — пробормотал принц.",
      "target_id": "ru-id02314",
      "tag": "p",
      "target_sha256": "2f4b65cd4d25217b934432b832242400faaca850773f21f5331f91b19e83e5ac"
    },
    {
      "source_id": "id02315",
      "source_sha256": "14675522e926c77bec1bb76985024d40048a760e0fa43943f82d012d20b39b7e",
      "target": "В самом деле, в тюрьме нет промежуточных чувств. Так как всё, и люди и вещи, бывает для вас либо другом, либо врагом, то любят или ненавидят иногда по справедливости, но гораздо чаще по одному инстинкту. И вот по той бесконечно простой причине, что Гримо с первого взгляда понравился господину де Шавиньи и Ла Раме, он должен был, — ведь его достоинства в глазах коменданта и стража обращались в недостатки в глазах узника, — с самого начала не понравиться господину де Бофору.",
      "target_id": "ru-id02315",
      "tag": "p",
      "target_sha256": "e62a688d800d3d6c66543e05eba5d53d40b5553078d0edb5f0f734b980e61984"
    },
    {
      "source_id": "id02316",
      "source_sha256": "81a714874574291b763e5a23734f83208196295ed6b4809282c2bac90c08180a",
      "target": "Однако Гримо не пожелал с первого же дня открыто ссориться с узником; ему нужна была не наскоро сымпровизированная неприязнь, а хорошая, крепкая и стойкая ненависть.",
      "target_id": "ru-id02316",
      "tag": "p",
      "target_sha256": "7ca4e8a8c491c9b3cd83f8cc548ba868449f045ce1f7fcbfc0f77ef2ca2a0333"
    }
  ],
