{
  "unit": 46,
  "batch": 4,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id05788",
      "target": "Де Уинтер обернулся и посмотрел туда, куда указывал палец Арамиса. Маяк заливал светом узкий пролив, который им предстояло пройти, и скалу, на которой стоял молодой человек; он ждал с непокрытой головой, скрестив на груди руки.",
      "source_sha256": "291463580768cc0cc9debd3b6ecdfaaf1dbc285d468d02709a63fd04b8a32159",
      "target_id": "ru-id05788",
      "tag": "p",
      "target_sha256": "bf52c7b41dd308d64192dc6c8fc4b9df8af3abe6f92172e751283a0d16801f1e"
    },
    {
      "source_id": "id05789",
      "target": "— Это он! — воскликнул лорд де Уинтер, схватив Атоса за руку. — Это он; мне и вправду показалось, что я узнал его, и я не ошибся.",
      "source_sha256": "a81f1ffec3511bad7f5f61e19792260334b1c22e92e0e81e0795f66c015b86e2",
      "target_id": "ru-id05789",
      "tag": "p",
      "target_sha256": "560c028b567eddf9217e12915e86855ca853b7ab63fcb23f0e3a197a2ab9e97b"
    },
    {
      "source_id": "id05790",
      "target": "— Кто — он? — спросил Арамис.",
      "source_sha256": "6ba51f870e03a9867800889d9b4ce8101b7d9a5e30b77b0a539ff94332b7523c",
      "target_id": "ru-id05790",
      "tag": "p",
      "target_sha256": "6a1c52ce79988431f98e2e57940d9f2b98761c1ae802cac7ec6913fd1c575ef4"
    },
    {
      "source_id": "id05791",
      "target": "— Сын миледи, — ответил Атос.",
      "source_sha256": "a12860f03be17c6e7bf0a866b735ce51bb12fb06e9e546d7d15a457a85167072",
      "target_id": "ru-id05791",
      "tag": "p",
      "target_sha256": "c1f971ab62b99feec77ad2e536f5d10c92eb4b5bfb61e76873154bc0b7c04d06"
    },
    {
      "source_id": "id05792",
      "target": "— Монах! — вскричал Гримо.",
      "source_sha256": "749a5f7316603df7479d875f49aba8e927b333194a5a9406d7cd6fcb1f8443fd",
      "target_id": "ru-id05792",
      "tag": "p",
      "target_sha256": "b316ddb1e5118050aaa806f0e3261d7c93f2f7185b823d51784d49b46e0b8198"
    },
    {
      "source_id": "id05793",
      "target": "Молодой человек услышал эти слова; казалось, он вот-вот бросится вниз — так близко к краю скалы он стоял, наклонившись над морем.",
      "source_sha256": "7a51d1e59c55b1343aa0b8448dc05047eb22fb7ed70ab000bf9a5a756881b7b2",
      "target_id": "ru-id05793",
      "tag": "p",
      "target_sha256": "9b972355feb3f5e3155cd102a28f6882d1fef596ca0d947ef193c29547e7b2f7"
    },
    {
      "source_id": "id05794",
      "target": "— Да, это я, дядя; я, сын миледи; я, монах; я, секретарь и друг Кромвеля, и я знаю вас, вас и ваших спутников.",
      "source_sha256": "fdf7f15acf98ed151d3a115dfafa9439a30c676e0f4e819a177406cac0e806f1",
      "target_id": "ru-id05794",
      "tag": "p",
      "target_sha256": "0170d61cb466b98a565129ceadd7f36d88bbecb654dd34b0b26560ace33bbb67"
    },
    {
      "source_id": "id05795",
      "target": "В лодке сидели трое мужчин, храбрых, конечно, и таких, чью отвагу никто не осмелился бы оспаривать; и всё же от этого голоса, от этого тона, от этого жеста они почувствовали, как по их жилам пробежал озноб ужаса.",
      "source_sha256": "753b4457a782828ff2aabf392525e90015707f1bb77f7c723e8a5aceed904dcd",
      "target_id": "ru-id05795",
      "tag": "p",
      "target_sha256": "1ca86d4fe0e51c34ab26ec759d05cd3c74c4f66e260b4b311c6a804e28a97273"
    },
    {
      "source_id": "id05796",
      "target": "Что до Гримо, у него волосы встали дыбом, а со лба катился пот.",
      "source_sha256": "186b898b99c2890241bd8c6c3a715ee3a2baee64d3aabf774e47f891e2076bf3",
      "target_id": "ru-id05796",
      "tag": "p",
      "target_sha256": "82fdec9cb406a84de9108127f3e9c326770ede1a3890bf5eaf39240e7a903924"
    },
    {
      "source_id": "id05797",
      "target": "— Ах! — сказал Арамис. — Так это племянник, это монах, это сын миледи, как он сам говорит?",
      "source_sha256": "5f2dd2f32da431e14a6333bbc03e9cd7203ec82c0549ce24c7b4012f3bf1161d",
      "target_id": "ru-id05797",
      "tag": "p",
      "target_sha256": "1c35f412503b680a0c9bcca434742d3776de4df9fda339df5b489ac5b8549f8d"
    },
    {
      "source_id": "id05798",
      "target": "— Увы, да, — пробормотал де Уинтер.",
      "source_sha256": "9a531c0cd37df5e5621d65bee9505eaa7b7dee1737426830be8f7fc905bce2da",
      "target_id": "ru-id05798",
      "tag": "p",
      "target_sha256": "06e74fa5b47ba376207b9d54628be1d8fffef2d090bb6b05afcb2cc617ebd969"
    },
    {
      "source_id": "id05799",
      "target": "— Тогда погодите! — сказал Арамис.",
      "source_sha256": "c584741101823f503b8978ab18b0e3152614ecc0748fbe58c2e19f3a57b26892",
      "target_id": "ru-id05799",
      "tag": "p",
      "target_sha256": "92c4a26ffd56ce60b154ea5e5912f2d94506d8d97cb07bbc81f4ef406566cd1e"
    },
    {
      "source_id": "id05800",
      "target": "И он с тем страшным хладнокровием, которое появлялось у него в решительные минуты, взял один из двух мушкетов, что держал Тони, взвёл его и прицелился в человека, стоявшего на этой скале, словно ангел проклятий.",
      "source_sha256": "abccbc2976207f09863a1c72441a3b691d51126e236108e5d40270e9041f13f2",
      "target_id": "ru-id05800",
      "tag": "p",
      "target_sha256": "e3df41d0c9d5b74c3c756a005a5f9861a69a83a914d9381e7d4f293ce3d2a176"
    },
    {
      "source_id": "id05801",
      "target": "— Огонь! — крикнул Гримо, вне себя.",
      "source_sha256": "98dfe052beeb707a5b9d729de4842e0ab8635b4528143e8b029e44d025f50c79",
      "target_id": "ru-id05801",
      "tag": "p",
      "target_sha256": "fa3a137ef70d21f4106198288743974dbcc3f3cfc8462e40766e0648dfc3ccdb"
    },
    {
      "source_id": "id05802",
      "target": "Атос бросился на ствол карабина и остановил выстрел, который уже готов был грянуть.",
      "source_sha256": "b9b6f45f491cc4e95e7b91184a37a357ccb8999d379bb05dec9c2ffef22b38a5",
      "target_id": "ru-id05802",
      "tag": "p",
      "target_sha256": "cb86765aac425cbb860e7fbdafa5cffefe278c9a74a9968520f8873a80ec05cd"
    },
    {
      "source_id": "id05803",
      "target": "— Чёрт бы вас побрал! — воскликнул Арамис. — Я так хорошо держал его на конце моего мушкета; я всадил бы ему пулю прямо в грудь.",
      "source_sha256": "362bc6e6b2c436456a15bf6b64c35f5c9de1b50edcc69de64f51044e4a9a2917",
      "target_id": "ru-id05803",
      "tag": "p",
      "target_sha256": "c9ee4cfbe5c1bd488aa5e7e1518a6f5cf40e1fb17363e7c5225662f9b05047cd"
    },
    {
      "source_id": "id05804",
      "target": "— Довольно и того, что убили мать, — глухо сказал Атос.",
      "source_sha256": "bea55c1387fe4dab5c2a483d6f832c9852e8c8d5561a2204ba92b8e3d9352395",
      "target_id": "ru-id05804",
      "tag": "p",
      "target_sha256": "58beec15064ff8e56aad7d30080e815d8b96502e2c1ac8ae7d154be10a298b8c"
    },
    {
      "source_id": "id05805",
      "target": "— Мать была злодейка, которая поразила всех нас — или нас самих, или тех, кто нам был дорог.",
      "source_sha256": "f4f15ac18077f217e82084b4371bb8fd5f42c6ebc6ee0c7cee31818a904ad6e4",
      "target_id": "ru-id05805",
      "tag": "p",
      "target_sha256": "df60cc05f7c5251a0ebde9770d7031f073350b883fbb977e86613216fb8fbbe1"
    },
    {
      "source_id": "id05806",
      "target": "— Да, но сын-то нам ничего не сделал.",
      "source_sha256": "c9c22dc64b136f8a648ea8f6ff6f2d7e7b355b2277d6af156580e86821f3f6f3",
      "target_id": "ru-id05806",
      "tag": "p",
      "target_sha256": "e6e52c5c6b9af11cf94d0133b1cc2bf4ba10277a9d1aab663b39d821611a7a4d"
    },
    {
      "source_id": "id05807",
      "target": "Гримо, приподнявшийся, чтобы увидеть действие выстрела, упал духом и опустился назад, всплеснув руками.",
      "source_sha256": "1a9dce95be28be54c40043f7c1691bcbc7d7aab51687a69d35dfe3e843dbb514",
      "target_id": "ru-id05807",
      "tag": "p",
      "target_sha256": "bcca0de1a0ccb8f75e4b47dd55bf3d1e0c3ae3e1c40502d926cdbdfef6246017"
    }
  ],
