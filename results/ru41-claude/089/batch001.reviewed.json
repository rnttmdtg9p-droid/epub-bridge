{
  "unit": 89,
  "batch": 1,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id11468",
      "target": "— Совсем недалеко отсюда, — ответил Коменж с улыбкой.",
      "source_sha256": "ceccb7d361b361cb6818a8f396079db2c1ba3742622103d637b227a32d08b4ad",
      "target_id": "ru-id11468",
      "tag": "p",
      "target_sha256": "256970081eca2ac35309b6905b0a7274f6ed19dc3da6b247d50cfaa4f577e5eb"
    },
    {
      "source_id": "id11469",
      "target": "— Совсем недалеко отсюда! — повторил д’Артаньян, и глаза его блеснули.",
      "source_sha256": "80c317656b215bcd2628a1d3c518d3c1369227bc7d74b23357d1f5730e9ccaf7",
      "target_id": "ru-id11469",
      "tag": "p",
      "target_sha256": "6bc0395c5860a0912f4b495f2699339a1871d4216c54e5da99bd998691449086"
    },
    {
      "source_id": "id11470",
      "target": "— Так близко, что, если бы окна, выходящие в оранжерею, не были заложены, вы могли бы увидеть его с того места, где сейчас находитесь.",
      "source_sha256": "4833743213d15598d308047230efb8d8d6995a66c0dd220ebadc32991363be0a",
      "target_id": "ru-id11470",
      "tag": "p",
      "target_sha256": "61ecc1c3b5eead49f46d105c1e6e829fdc434431e115c0c45f3fc1470bfe9ea3"
    },
    {
      "source_id": "id11471",
      "target": "«Он бродит где-то вокруг замка», — подумал д’Артаньян. И громко добавил:",
      "source_sha256": "dca18a0e8cc0d9c31131301101389d378165def62e398753e50efd7210f7c815",
      "target_id": "ru-id11471",
      "tag": "p",
      "target_sha256": "b6cb74988875422b6d3e1c9f06bb4da252f51a3498f50b5f3c7202f92e5a6506"
    },
    {
      "source_id": "id11472",
      "target": "— Вы встретили его на охоте, — сказал он, — в парке, быть может?",
      "source_sha256": "1b0041eed341be3f5fa0f27a91ef189fc920867f5cca597534fec7ddf794d0c5",
      "target_id": "ru-id11472",
      "tag": "p",
      "target_sha256": "6b02080f76b246f950d2367e777a9d3b3d3785f36aaed519488311d178442682"
    },
    {
      "source_id": "id11473",
      "target": "— Нет, ближе, ещё ближе. Вот, за этой стеной, — сказал Коменж, стукнув по стене.",
      "source_sha256": "22c983753f557ed7064b193069efa27fba13f5849f5903724c0cc10bf42ff1ea",
      "target_id": "ru-id11473",
      "tag": "p",
      "target_sha256": "4b5073eedaa252b6233b4402bbe2e7ee8416a62fe044e4717d6c7b30c5ae8676"
    },
    {
      "source_id": "id11474",
      "target": "— За этой стеной? Что же там, за этой стеной? Меня привезли сюда ночью, так что, чёрт меня побери, если я знаю, где нахожусь.",
      "source_sha256": "7bcf16aaf6434b828290424ae544ac51b5cb33b57d8c8813d012617448fc9a46",
      "target_id": "ru-id11474",
      "tag": "p",
      "target_sha256": "5a5b94560d5f0b2268926fa621170e301f77f88dc203cc459cd165e8f52767d4"
    },
    {
      "source_id": "id11475",
      "target": "— Ну хорошо! — сказал Коменж. — Предположите одну вещь.",
      "source_sha256": "57d2ca9ab0aaf0c31c211d98d57c416fba3e7ec4dac961ab4ae8b2d15b501707",
      "target_id": "ru-id11475",
      "tag": "p",
      "target_sha256": "a40029a780a0d50f2dd0ac8beff221c1efe1f981b0a02d8608acbbf78fab8a2f"
    },
    {
      "source_id": "id11476",
      "target": "— Я предположу всё, что вам угодно.",
      "source_sha256": "9c3c47eda799c090d7c00fa32571607546c9bfcb543805bf1c6d215c969e0e7b",
      "target_id": "ru-id11476",
      "tag": "p",
      "target_sha256": "90544b17ab1ae0d3a4c98135e91c435f9cc4d83bf653284b3beabbe61578873f"
    },
    {
      "source_id": "id11477",
      "target": "— Предположите, что в этой стене есть окно.",
      "source_sha256": "d46b0efadc3093d07dc602ece9f5e1307fc99dd64ec3f699e0d2520d64148890",
      "target_id": "ru-id11477",
      "tag": "p",
      "target_sha256": "1cb4d600f72386ad8dbedb9e0dcf4e9607effb708f65165ae52c3a0807b057ce"
    },
    {
      "source_id": "id11478",
      "target": "— Ну и что?",
      "source_sha256": "2caed6e1ccb03a9e5b3191e4e09dc771bdcca703c589c4b9b2a520a990a050f0",
      "target_id": "ru-id11478",
      "tag": "p",
      "target_sha256": "c3c7c847be433d2b02af850bdfcfd0e3734a843506123820fd38a33c0d05ab04"
    },
    {
      "source_id": "id11479",
      "target": "— Ну так вот! Из этого окна вы увидели бы господина де ла Фера у его окна.",
      "source_sha256": "05067ae2fdea897de0c2158c014d2e26db6c0c6a0099d73b978de0bae9cf09e0",
      "target_id": "ru-id11479",
      "tag": "p",
      "target_sha256": "9eb2b011e764a898284429f9a8b1b9f68312e688bf336c0dcf5fbc9f0e46f943"
    },
    {
      "source_id": "id11480",
      "target": "— Стало быть, господин де ла Фер помещён в замке?",
      "source_sha256": "1af700c6be5fb8f65b8e3945453c88e96480f54260d2ddc5cd5c56400dba39e1",
      "target_id": "ru-id11480",
      "tag": "p",
      "target_sha256": "1c08a840d2ea674de4d64ddc55fa72aae89b4d633d616845c2a78157494f57d6"
    },
    {
      "source_id": "id11481",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id11481",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "id11482",
      "target": "— В каком качестве?",
      "source_sha256": "575cd6cdcdca9786b2e2596f3766281191be1fefdfe1df365e155177532cbc68",
      "target_id": "ru-id11482",
      "tag": "p",
      "target_sha256": "42dd8e6cec0b414790fe8abfd8c000c33379c62ebe612decc2171e7ae01a1ffd"
    },
    {
      "source_id": "id11483",
      "target": "— В том же, что и вы.",
      "source_sha256": "794b8d7cd94e309471ec0a14b05d529a841c83b4e3d0698f8191ccbcac409997",
      "target_id": "ru-id11483",
      "tag": "p",
      "target_sha256": "219ddee75ae862c81cd864311910057e92b63a522a676f5ec1ac35a69ac03320"
    },
    {
      "source_id": "id11484",
      "target": "— Атос — узник?",
      "source_sha256": "0a572ed30b44153e522142065bcab374f92788432ad63417ab6be5e15cac024b",
      "target_id": "ru-id11484",
      "tag": "p",
      "target_sha256": "55cee8fdf190bb94a139129150973b8e7103a44a460616c61d2985aa08bb04db"
    },
    {
      "source_id": "id11485",
      "target": "— Вы же прекрасно знаете, — со смехом сказал Коменж, — что в Рюэле нет узников, раз там нет тюрьмы.",
      "source_sha256": "27d0dcb8184b3057d7d9e82711866d45ced1b764158fbe47045a4bdba066bf30",
      "target_id": "ru-id11485",
      "tag": "p",
      "target_sha256": "8edab221e9a4f7745fa7845a761f2ce6c48cfbedee9aa0261a4db8b7ca0e3992"
    },
    {
      "source_id": "id11486",
      "target": "— Не будем играть словами, сударь: Атос арестован?",
      "source_sha256": "c7d2bc64b53f271919247752e58486d53ef7bf70d12588f4bb94e59c6d3ccb2d",
      "target_id": "ru-id11486",
      "tag": "p",
      "target_sha256": "3771eed8fe7148cd2b73979ec3aba8f8a5dab4f093dd220ba65c4cbdf7a3c068"
    },
    {
      "source_id": "id11487",
      "target": "— Вчера, в Сен-Жермене, когда выходил от королевы.",
      "source_sha256": "34e01d18a37a0eb1d57ecc83efaf10a9abe110d4be8edf3d75fdd7adfda8e92f",
      "target_id": "ru-id11487",
      "tag": "p",
      "target_sha256": "b97a992cd36febbad1b23f259fcc1afdbb87a9859f7e5806e3941cf0a45ee501"
    }
  ],
