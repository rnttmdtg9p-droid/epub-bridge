{
  "unit": 55,
  "batch": 3,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id07251",
      "target": "— Это вы, Бернуин? — сказала она. — Господин д’Артаньян здесь?",
      "source_sha256": "c4f63b4e452a21bd878121c2afffa16b5a790dc282b900136cf0211e1293955f",
      "target_id": "ru-id07251",
      "tag": "p",
      "target_sha256": "9641f28c7d6438bdf88131bdea0765961bf8275e69a15fbc8bc07fec37b6275b"
    },
    {
      "source_id": "id07252",
      "target": "— Да, сударыня, в вашей молельне. Он ждёт, когда Ваше Величество будет готово.",
      "source_sha256": "262c0a40059266e96a95ef5d50844ff322f2abc4313ffe8774198c2c9a148e31",
      "target_id": "ru-id07252",
      "tag": "p",
      "target_sha256": "300eb3e62e55c521a2bdc6ee62a21af0d56d7f7fb2770d5cc0e13be0b3aa1584"
    },
    {
      "source_id": "id07253",
      "target": "— Я готова. Пойдите скажите Лапорту, чтобы разбудил и одел короля, а оттуда зайдите к маршалу де Вильруа и предупредите его от моего имени.",
      "source_sha256": "09d8a24f1df3c2f27c0592c2e0e076880c62c7df03573e525d475c1ac2ffb66c",
      "target_id": "ru-id07253",
      "tag": "p",
      "target_sha256": "3129d74fbe43c19b532b468299023c936283eb8822805d48e43a1a1a92c3ae8b"
    },
    {
      "source_id": "id07254",
      "target": "Бернуин поклонился и вышел.",
      "source_sha256": "79691a437aa335a49ee2f73632d257950644f5b6ec44480c625da9a50f44ca2c",
      "target_id": "ru-id07254",
      "tag": "p",
      "target_sha256": "b8fd3dfed0e1f69f59d053d076dfecf609dcc7dccc462f3ce7cc7e3df8308ed3"
    },
    {
      "source_id": "id07255",
      "target": "Королева вошла в молельню, которую освещала лишь одна простая лампа из венецианского стекла. Она увидела д’Артаньяна: он стоял и ждал её.",
      "source_sha256": "b7cf7344810c40850f67710b7e0b7e8714d42ee92fc20cc9d63729f592880349",
      "target_id": "ru-id07255",
      "tag": "p",
      "target_sha256": "8ce05e2d394afb15506cda1b5f853d5bbfa9767e7d09c3f5f7a15da44cc1415a"
    },
    {
      "source_id": "id07256",
      "target": "— Это вы? — сказала она ему.",
      "source_sha256": "276a3441d9294d676ae31becb91ea3bb6e732f7c7bf6eda179aa6c8e903e0429",
      "target_id": "ru-id07256",
      "tag": "p",
      "target_sha256": "1c894d48a7fc487a4d6bdac9c18ce79854fcc1ae37c3273131cfd3f27d5e3f0c"
    },
    {
      "source_id": "id07257",
      "target": "— Да, сударыня.",
      "source_sha256": "b31be5da3cabab37543ce6b20e55df5b29f0fca850525532cf071d756ad31053",
      "target_id": "ru-id07257",
      "tag": "p",
      "target_sha256": "34f750387d5adcfe5f9effac728a91bfc41985364b4c7e9f6581324afa8df7f3"
    },
    {
      "source_id": "id07258",
      "target": "— Вы готовы?",
      "source_sha256": "806ba2046e5262f3baebc1d653433365799e2a3e1a14a3cfa92f5c13bed7f5db",
      "target_id": "ru-id07258",
      "tag": "p",
      "target_sha256": "07cfcb590d41354e6b0489480c4064e3235a7d59e71582f31d7c8fa4c48fee77"
    },
    {
      "source_id": "id07259",
      "target": "— Готов.",
      "source_sha256": "110fd6807fb8e40a907aae0fed97c2fc059638136235f92c1dc2322abdf0b1e4",
      "target_id": "ru-id07259",
      "tag": "p",
      "target_sha256": "c60279ab4fe4274b35144043aec7707dbfb71f85903c31de9133702f63732828"
    },
    {
      "source_id": "id07260",
      "target": "— А господин кардинал?",
      "source_sha256": "d5a27f478c9f49e22f43d0d5aed0a484560054a2a3d6530b8ba1df4e7b1f82ef",
      "target_id": "ru-id07260",
      "tag": "p",
      "target_sha256": "a5f48ecfd08feb4944e1302eb957ef2ea265091cbc6ba30ed41dc02536870907"
    },
    {
      "source_id": "id07261",
      "target": "— Вышел благополучно. Он ждёт Ваше Величество на Кур-ла-Рен.",
      "source_sha256": "6ef7b2ea1c1e322777443d4758fe602e45b527dde3cf816846bb04174a3f7b61",
      "target_id": "ru-id07261",
      "tag": "p",
      "target_sha256": "2f183dcff9a9f2c9a3b2310d2d79eba413c83b299008aacd6bada5442060c410"
    },
    {
      "source_id": "id07262",
      "target": "— Но в какой карете мы поедем?",
      "source_sha256": "04db7966c480af976ee801e2c76a00672afd5947ae80f02f64b607248851ca05",
      "target_id": "ru-id07262",
      "tag": "p",
      "target_sha256": "c7b81c575712ee205183cf4d40508883c1e5a9ea4989eb53113bfe17c843f1c5"
    },
    {
      "source_id": "id07263",
      "target": "— Я всё предусмотрел: внизу карета ждёт Ваше Величество.",
      "source_sha256": "6a73638aaeb2686ae4d5f26fd41319de327285a3ac869ca067727aceb4d92df8",
      "target_id": "ru-id07263",
      "tag": "p",
      "target_sha256": "2af7a3623ec8c9094a9c0598e0db5a704cc79cf19ec9d8b58fcfba93adc106f0"
    },
    {
      "source_id": "id07264",
      "target": "— Зайдём к королю.",
      "source_sha256": "b0e324d793af8c277f3a746bf2baf941ae1592bde5a8a0dd573e97226f6a17d2",
      "target_id": "ru-id07264",
      "tag": "p",
      "target_sha256": "79537b3ef7bd271431c771aa44a29d42881c0ea9c28749e69af8a0693acd9775"
    },
    {
      "source_id": "id07265",
      "target": "Д’Артаньян поклонился и последовал за королевой.",
      "source_sha256": "8715b99c1e8cef22f7e9f58d728fa7e00276bf75a684edb0d3deb239bfb42f8f",
      "target_id": "ru-id07265",
      "tag": "p",
      "target_sha256": "e413a6bf26ea32fbd1d92828bb89fa0e77472390b30b3a70ed8f2b555c907a59"
    },
    {
      "source_id": "id07266",
      "target": "Юный Людовик был уже одет, кроме башмаков и камзола; он с удивлённым видом позволял с собой возиться и осыпал вопросами Лапорта, который отвечал ему только следующее:",
      "source_sha256": "05ad900da5fccf101d0a0c94919e59f74eefc7fdeed47e9c0a1ef31390830f6c",
      "target_id": "ru-id07266",
      "tag": "p",
      "target_sha256": "c2e6a42881e6b0ea09f21095a834c5cfa0f1cb340abc0a5c96717d7836ba3ec8"
    },
    {
      "source_id": "id07267",
      "target": "— Государь, это по приказанию королевы.",
      "source_sha256": "c91f6e94096571bae05fe45797d3488888afc187fbbe70f0a766fe690d6f8da4",
      "target_id": "ru-id07267",
      "tag": "p",
      "target_sha256": "0abc96e5f8d86c9e460e8f88ade22b3001a13c7d90af0e7b41557cb6763afd3c"
    },
    {
      "source_id": "id07268",
      "target": "Постель была откинута, и видны были королевские простыни, настолько изношенные, что кое-где в них зияли дыры.",
      "source_sha256": "a6fe2436366f0687cbf8b945796f8e5362897e4f5a05bf4246be6d35f7c6c01b",
      "target_id": "ru-id07268",
      "tag": "p",
      "target_sha256": "e03b7a9260320e0faac1f6a5b0c13399311b696dcdbd5f70c83b1c26464aee65"
    },
    {
      "source_id": "id07269",
      "target": "Это было ещё одним следствием скаредности Мазарини.",
      "source_sha256": "d0e6d05d4a8679008404fcabd8ecc4862d26a6ff3d227752e57a638077d969ed",
      "target_id": "ru-id07269",
      "tag": "p",
      "target_sha256": "2ddcaa73ac3c31685717b25bad4b2f3de4fb5bc0091e196bcd82e53e165fcb71"
    },
    {
      "source_id": "id07270",
      "target": "Королева вошла, а д’Артаньян остановился на пороге. Увидев королеву, ребёнок вырвался из рук Лапорта и бросился к ней.",
      "source_sha256": "441db0ec3a9711b842b01b7f4c95a929260b7cd4eff9bee922536468942a6692",
      "target_id": "ru-id07270",
      "tag": "p",
      "target_sha256": "ffb501636039f038740b0bf1d661152251ef3668e0d9add466f6e101fd4855e5"
    }
  ],
