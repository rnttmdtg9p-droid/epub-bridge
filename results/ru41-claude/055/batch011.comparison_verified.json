{
  "unit": 55,
  "batch": 11,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id07411",
      "target": "— Карета господина коадъютора! — воскликнула она, отступив на шаг.",
      "source_sha256": "e08cb5015310e46416658984cce660f5a9ea94e70ececae632512a5433d55364",
      "target_id": "ru-id07411",
      "tag": "p",
      "target_sha256": "2e4681b85b5d12b0aa47bdbe1a99a02979d3e4037ad6707f220ea77d5060759f"
    },
    {
      "source_id": "id07412",
      "target": "— Да, сударыня, — сказал д’Артаньян, — но садитесь смело: правлю ею я.",
      "source_sha256": "39499c19f7ca0e853fd7b4c443dd6825c9a047884840d279bed888104466837b",
      "target_id": "ru-id07412",
      "tag": "p",
      "target_sha256": "b8e33f85145523efe5e8fd6dae6c2c5066bd9ed102ad0e4cf775a7b8660e0bdf"
    },
    {
      "source_id": "id07413",
      "target": "Королева вскрикнула от удивления и села в карету. Король и Месье поднялись следом за нею и сели подле неё.",
      "source_sha256": "06f25d6a00d48c119a91e1d4b3025f0fa6cbdba9141d71ba89a119ba61513294",
      "target_id": "ru-id07413",
      "tag": "p",
      "target_sha256": "edfdb4d0f86d4f6c15376a050491f1b1f406eae12cc404e94cb74054c1182fb1"
    },
    {
      "source_id": "id07414",
      "target": "— Идёмте, Лапорт, — сказала королева.",
      "source_sha256": "fae7d0568cd6c76bb490e656758a622aaf4c8d952e556aa4adeac657dea0a250",
      "target_id": "ru-id07414",
      "tag": "p",
      "target_sha256": "8e74434d68d4112b8db5344d25d21e1719ad2e55c45cc6d636060c38152f4dfb"
    },
    {
      "source_id": "id07415",
      "target": "— Как, сударыня! — сказал камердинер. — В одной карете с Вашими Величествами?",
      "source_sha256": "9c804bb3b5ede351447e0133ecebc9e397f30f074f6fa3fefc6ed98fdd0ae461",
      "target_id": "ru-id07415",
      "tag": "p",
      "target_sha256": "d4eff6b6356bfc9e2ae76654192c26ca0bbf9c0d65e81d672ab47580c80c9a6f"
    },
    {
      "source_id": "id07416",
      "target": "— Сегодня вечером дело не в королевском этикете, а в спасении короля. Садитесь, Лапорт!",
      "source_sha256": "a33eb489bec633fbdddf3a04ccf9f58dd2494032b46cba1353cfb3da59afe60a",
      "target_id": "ru-id07416",
      "tag": "p",
      "target_sha256": "f1bb37db924b071435cdc79eafb51edd75388146cc286f4f6cdb51640c3d4a56"
    },
    {
      "source_id": "id07417",
      "target": "Лапорт повиновался.",
      "source_sha256": "804cb1f6bfc5918e7b20afb95be5e55833001cce604f2e8f29d8eaa681df93c5",
      "target_id": "ru-id07417",
      "tag": "p",
      "target_sha256": "0f772ecd6baf51d48f4a020c98f69f03c4fc387f862c9687f072fe55084ad9b5"
    },
    {
      "source_id": "id07418",
      "target": "— Закройте занавеси, — сказал д’Артаньян.",
      "source_sha256": "a1c251a3efd5b736b91ddb5b4a887b91dc7b88f559efe0e74a0aef77426b136e",
      "target_id": "ru-id07418",
      "tag": "p",
      "target_sha256": "3145773b6a2777f7188e07af88958fb984b0d67306e65ebd3e114ad9ee9a47ab"
    },
    {
      "source_id": "id07419",
      "target": "— Но не вызовет ли это недоверия, сударь? — спросила королева.",
      "source_sha256": "9fbfe55cc9d0e48114bc200c1da42225e9720fd0c135fdd9a7a2642ce40302ed",
      "target_id": "ru-id07419",
      "tag": "p",
      "target_sha256": "6bb32ff799d489cb0d48263acfff0515b6f85359471d92e81b2f41d482dda61b"
    },
    {
      "source_id": "id07420",
      "target": "— Пусть Ваше Величество будет спокойно, — сказал д’Артаньян, — у меня ответ наготове.",
      "source_sha256": "1f387a1e0cda6ae3ce2ad705c567155eae0861e60a5c16b8f34379c0ff50cbed",
      "target_id": "ru-id07420",
      "tag": "p",
      "target_sha256": "0b14e8116901d609cbbeea818e277ec52d4117be72f863abcfe251e6c7e952bd"
    },
    {
      "source_id": "id07421",
      "target": "Занавеси закрыли, и карета помчалась галопом по улице Ришелье. Когда подъехали к воротам, начальник караула вышел вперёд во главе дюжины человек, держа в руке фонарь.",
      "source_sha256": "7566292a749a70d5eb0e6d6a952f3e3a18778476150787c36dec382249d636b8",
      "target_id": "ru-id07421",
      "tag": "p",
      "target_sha256": "dccafd80cc7a3836b657cae7f6dcf9876761a09dfc7c91e1347bb87f25dc2415"
    },
    {
      "source_id": "id07422",
      "target": "Д’Артаньян знаком подозвал его.",
      "source_sha256": "be5dbb77e19948954d198c0ea70c7f62fa7507004412f33f9b877f1db23ed210",
      "target_id": "ru-id07422",
      "tag": "p",
      "target_sha256": "aeab586a909a97015ea3fea1eb2b4421325b16f70636946c672e539cda75154d"
    },
    {
      "source_id": "id07423",
      "target": "— Узнаёте эту карету? — спросил он сержанта.",
      "source_sha256": "f30d86ff9bcbba124f0b82098485d374ecc901b914eff40f92c00d31ae22370b",
      "target_id": "ru-id07423",
      "tag": "p",
      "target_sha256": "bc541fe0b018834970d7f8d0ba528374366c6042c9762803e14b0a219684d27c"
    },
    {
      "source_id": "id07424",
      "target": "— Нет, — ответил тот.",
      "source_sha256": "a0a7703e0a633f1c0c3178280d28f0b1022fd957a670bc49ee05e81037021bc8",
      "target_id": "ru-id07424",
      "tag": "p",
      "target_sha256": "7a5e87beb41cb17c970708ff4b45066cd829f8b9a82377ae5575325985a67dfa"
    },
    {
      "source_id": "id07425",
      "target": "— Взгляните на герб.",
      "source_sha256": "866d165b5f61a05ade480da8ff23be199d071c227bfbe4378a7869fcc30267d6",
      "target_id": "ru-id07425",
      "tag": "p",
      "target_sha256": "1fe0352f17a2e22cc80777b432dedfe05686b8042a1e0ca29f249c9876c1646c"
    },
    {
      "source_id": "id07426",
      "target": "Сержант поднёс фонарь к дверце.",
      "source_sha256": "bb20f9f7743a971720634e21314276ae8297c7991f714ddfac3f37d66cefcd61",
      "target_id": "ru-id07426",
      "tag": "p",
      "target_sha256": "e1936ed5b9a07d4a16a266c1e07ba79156c8349f3b46e800b5501cbc7c5a0747"
    },
    {
      "source_id": "id07427",
      "target": "— Это герб господина коадъютора! — сказал он.",
      "source_sha256": "f21f4e8a4391913658bee7fba1cb6b6e028d8c3f8a790a456e9c205a4684177b",
      "target_id": "ru-id07427",
      "tag": "p",
      "target_sha256": "3580e073da1d25539ab2a2b9e30c11836cd4e538a1f9fc9288cb8f8d2bfdd3d2"
    },
    {
      "source_id": "id07428",
      "target": "— Тсс! У него любовное приключение с госпожой де Гемене.",
      "source_sha256": "dcda935f571f83fe271e1cbc11823fe599cf086e0464cbefd36246c5b09aa67f",
      "target_id": "ru-id07428",
      "tag": "p",
      "target_sha256": "d2fe805120ef6e6181f77aa677f6ad527f5d9b75e394c87b117068e9219d8ad7"
    },
    {
      "source_id": "id07429",
      "target": "Сержант рассмеялся.",
      "source_sha256": "51ef36bc56a9a133dcf1bd1ab742ed74120bb49fdd9576c138fc19d3777f7f27",
      "target_id": "ru-id07429",
      "tag": "p",
      "target_sha256": "7b9f170414a30abe50e579bd168f29070159ab9bebca6328a9268ad3daa42969"
    },
    {
      "source_id": "id07430",
      "target": "— Откройте ворота, — сказал он, — я знаю, в чём дело.",
      "source_sha256": "7a5f5bafa077dc385f7836c4c2e0c560b093fac4693a6ac10d780c46d64b0c55",
      "target_id": "ru-id07430",
      "tag": "p",
      "target_sha256": "2465d1920543fe2e58839aece5072e2dec655527d1e10cfbfbd4d357d9ee2117"
    }
  ],
