{
  "unit": 55,
  "batch": 12,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id07431",
      "target": "Затем, подойдя к опущенной шторке, он сказал:",
      "source_sha256": "8aeaa2ac68f28cb3127625516c2dcaaf1a6e39aa8af684a4c2fa5aba6c847668",
      "target_id": "ru-id07431",
      "tag": "p",
      "target_sha256": "398b627a0f7236653963eec1979429a8743f0ee14a090ea5cdc8347cee043c50"
    },
    {
      "source_id": "id07432",
      "target": "— Приятного вам времяпрепровождения, монсеньор! — сказал он.",
      "source_sha256": "c0e8dbaf5ae92f903753b93bb9d4eddc6d8e191418c082c8f84738b9ff93c861",
      "target_id": "ru-id07432",
      "tag": "p",
      "target_sha256": "f498cc76f710d9d5d9556155a342713281db2539ae6be023ae2803a3d5dd5811"
    },
    {
      "source_id": "id07433",
      "target": "— Болтун! — крикнул д’Артаньян. — Из-за вас меня выгонят.",
      "source_sha256": "6115d05174dd4111166dda82a8df5a13d2d01c2e20bed1ea681768b7a1fc99ae",
      "target_id": "ru-id07433",
      "tag": "p",
      "target_sha256": "539c003831be8329002b5f3b7940ee0ccb9b50d885daa6a2aed91aebd9cb761d"
    },
    {
      "source_id": "id07434",
      "target": "Шлагбаум заскрипел на петлях; д’Артаньян, увидев, что путь свободен, хлестнул лошадей, и те крупной рысью понеслись вперёд.",
      "source_sha256": "2b43016b241409d5674f6c8510b6c7e4238782bdbf24d5e659f22eafc9152fce",
      "target_id": "ru-id07434",
      "tag": "p",
      "target_sha256": "afd9c58caac51d4a129dd68836fcf18e9d950d2558a9234a2831fedda5b0ab18"
    },
    {
      "source_id": "id07435",
      "target": "Через пять минут они догнали карету кардинала.",
      "source_sha256": "fd3a0b4b90acfcf73c194c72c43e8991e82aca3fa01a3d6b6b67a51ed28b1f49",
      "target_id": "ru-id07435",
      "tag": "p",
      "target_sha256": "15cf7a5566aa043a43a1b0fd8a8a52a37771b0261ecb38ea3201d8e1cbf6b39a"
    },
    {
      "source_id": "id07436",
      "target": "— Мушкетон, — крикнул д’Артаньян, — поднимите шторки на карете Его Величества.",
      "source_sha256": "bbb6357f27b99c4797acfde8315c18797192cc7c4116dccf462b85178a622209",
      "target_id": "ru-id07436",
      "tag": "p",
      "target_sha256": "0b5876fc73e8ee6916176776240a392c7ec4ea3e97cad50cafcc2455ee2b7062"
    },
    {
      "source_id": "id07437",
      "target": "— Это он, — сказал Портос.",
      "source_sha256": "b2eae4bf2d2fff6e19f5826230675ac612a6af287dc93a251a17168641393d7e",
      "target_id": "ru-id07437",
      "tag": "p",
      "target_sha256": "2560f78edcbe8b9a7638779c8b25ef9c41cb5d3cabc343fcbe4559d59c7c2797"
    },
    {
      "source_id": "id07438",
      "target": "— В кучерах! — воскликнул Мазарини.",
      "source_sha256": "e2bcd58b55dc68d6428b30a0597c4b2b5f51bf3af13ab96fd594d8ad23b638dc",
      "target_id": "ru-id07438",
      "tag": "p",
      "target_sha256": "94590f0a2e590095fd40ed2bbfa0d5d6b98d6b9e5661bf1ac3fa434f16dce0bc"
    },
    {
      "source_id": "id07439",
      "target": "— Да ещё с каретой коадъютора! — сказала королева.",
      "source_sha256": "4cbb83ad593cd336f12afb1fc2740bad138624f6300f2ff2373f54ae859a8f73",
      "target_id": "ru-id07439",
      "tag": "p",
      "target_sha256": "16f4fbd2bd98f4a02e3180c28de56915f193a07d7203086845e657204fc70728"
    },
    {
      "source_id": "id07440",
      "target": "— <i>Corpo di Dio!</i> <i>Монсу</i> д’Артаньян, — сказал Мазарини, — вы стоите своего веса в золоте!",
      "source_sha256": "67e143cb2d0a116a1a58c822bf02200be2fa7b3cb9d93c8e90fabd7d7805ae79",
      "target_id": "ru-id07440",
      "tag": "p",
      "target_sha256": "8ecb5ceede28226f9ce1bce2d4e3556a1ac7212d31cb5a6700ab05ac84ace03c"
    }
  ],
