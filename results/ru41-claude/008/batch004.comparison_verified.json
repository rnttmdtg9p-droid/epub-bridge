{
  "unit": 8,
  "batch": 4,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id00977",
      "target": "— Смотрите-ка! — сказал мальчик. — Наш пономарь собирается в дорогу.",
      "source_sha256": "8958d3b2612dae2c164c5d0675d4f2047396b8c088d3bb39587f7e789763f479",
      "target_id": "ru-id00977",
      "tag": "p",
      "target_sha256": "a42166a9480159996fd4ded082cf4d67297f22f1482a88935254041dc4fc8be1"
    },
    {
      "source_id": "id00978",
      "target": "— А куда это он едет? — спросил д’Артаньян.",
      "source_sha256": "cb609b8462ea84ee468789e8faba3158df8ed01a3ca25d7017e729a619f4a2c9",
      "target_id": "ru-id00978",
      "tag": "p",
      "target_sha256": "53c0c8d6a54fda1492276b41c844561fdf963394401d045eb066a173ef31e033"
    },
    {
      "source_id": "id00979",
      "target": "— Помилуйте, я ничего об этом не знаю.",
      "source_sha256": "fd78757f6a46b54690035232611c6d14b414ae61183ac770da108f773cf6e883",
      "target_id": "ru-id00979",
      "tag": "p",
      "target_sha256": "44d9605f492b1a9f6361548921f763b594021f8f2061e9a7f29d31039cbf1ed1"
    },
    {
      "source_id": "id00980",
      "target": "— Полпистоля, — сказал д’Артаньян, — если ты сумеешь это узнать.",
      "source_sha256": "340045ddd14b22f53ac68f5b7bc42fdbc725c202a3382d463756da6831e7a655",
      "target_id": "ru-id00980",
      "tag": "p",
      "target_sha256": "a05dca8c7f9aa17d5943e333bf69ced75b4fcd9a4b3d15d53a405f3fc0e1bad1"
    },
    {
      "source_id": "id00981",
      "target": "— Мне! — воскликнул мальчик, и глаза его заблестели от радости. — Если я сумею узнать, куда едет Базен! Это нетрудно. Вы не смеётесь надо мной?",
      "source_sha256": "f0b5a1d84e001f9e6718938d85ceed3d4d48f0a5dfa9bf573ba531065b9de399",
      "target_id": "ru-id00981",
      "tag": "p",
      "target_sha256": "6abf095faa63f844b96f5f5be8f485cf203a11a6dd5f775f8d03f26b3ee82be8"
    },
    {
      "source_id": "id00982",
      "target": "— Нет, клянусь честью офицера. Вот, смотри, полпистоля.",
      "source_sha256": "ff0534a666c7a1a1ed250bac2aec2efd9774a8f5d7e783e74837b8a46aa9eb2c",
      "target_id": "ru-id00982",
      "tag": "p",
      "target_sha256": "a7dca980391af6d49838cae4fae384442fd71e534e2252d6d07858ddb0cc4b01"
    },
    {
      "source_id": "id00983",
      "target": "И он показал ему соблазнительную монету, однако не отдал её.",
      "source_sha256": "25e430b2e991d4770bf8a3190e55507e111abd70815d93335a9da1a7c399f268",
      "target_id": "ru-id00983",
      "tag": "p",
      "target_sha256": "02df815e25c3f8d94c6ae105d54f0719ec35a68cb9b78a17870c6a4b91f2dd38"
    },
    {
      "source_id": "id00984",
      "target": "— Пойду спрошу у него.",
      "source_sha256": "275a7832586bb0ef9a89fb51b8efcea2b7768b3a0a60be74285175bef9c66712",
      "target_id": "ru-id00984",
      "tag": "p",
      "target_sha256": "b4caa5820a6183f552e5e7ab2728cef378e2369742ca85f53dc30c9dbc7af95c"
    },
    {
      "source_id": "id00985",
      "target": "— Это как раз верный способ ничего не узнать, — сказал д’Артаньян. — Подожди, пока он уедет, а потом, ну что ж, расспрашивай, разузнавай, выведывай. Это уж твоё дело, а полпистоля вот она. И он спрятал монету обратно в карман.",
      "source_sha256": "5645969eb95fa6a676a9a65124fc93bbf7d0457764aba477228f8f9a2febd7dd",
      "target_id": "ru-id00985",
      "tag": "p",
      "target_sha256": "c9acdc62adbebc7a784535b5a76317e8d679ea082f00992ad5b891bc93c221e8"
    },
    {
      "source_id": "id00986",
      "target": "— Понимаю, — сказал мальчик с той насмешливой улыбкой, какая свойственна лишь парижскому мальчишке. — Что ж, подождём.",
      "source_sha256": "9e5a2361b002ad625b97c8bcc537d5971b8ed4a431e4bf128f1904f26c2f1c08",
      "target_id": "ru-id00986",
      "tag": "p",
      "target_sha256": "53ed463f38947ed88a2e0a1e943906fa4026078d5496463f0cc40c3060c2d547"
    },
    {
      "source_id": "id00987",
      "target": "Ждать пришлось недолго. Минут через пять Базен тронулся мелкой рысью, подгоняя лошадь ударами зонта.",
      "source_sha256": "f7c802ee7c8f8c3bd30e8bdc117a09f7b47cd0c34c3729bc7aad821d9774dc97",
      "target_id": "ru-id00987",
      "tag": "p",
      "target_sha256": "93d3b332fd0503d6c5767cca871d5febfef867ed3e3516484eefef57d03fd48a"
    },
    {
      "source_id": "id00988",
      "target": "Базен всегда имел обыкновение носить зонт вместо хлыста.",
      "source_sha256": "942dc490538edf144b883ed1fe6e1fadc7710067a7df799ef97f8722bfbb89c4",
      "target_id": "ru-id00988",
      "tag": "p",
      "target_sha256": "e9baca66cb5b0adb93ae2eb912d89ee0e22af0742288fb855aba18c5792300ea"
    },
    {
      "source_id": "id00989",
      "target": "Едва он завернул за угол улицы Жюиври, как мальчик, словно гончая, бросился по его следу.",
      "source_sha256": "eef1abea397556804207891dd7c026bef1f355ccc123664a3fae7158e235c736",
      "target_id": "ru-id00989",
      "tag": "p",
      "target_sha256": "fe09f9e07ac5266449eb87927bc1eb9889add5140cbf39619db7ab96ebe655dc"
    },
    {
      "source_id": "id00990",
      "target": "Д’Артаньян вернулся на своё место за столом, где сидел с самого прихода, вполне уверенный, что не пройдёт и десяти минут, как он узнает то, что хотел узнать.",
      "source_sha256": "b7de23aad430380bdf8baff1ba98047bd4280fe7f75cbe915d425312efb78037",
      "target_id": "ru-id00990",
      "tag": "p",
      "target_sha256": "edf11debcc5090343eae4247e502443a6c4f9e423fc0d910332b301bfa0259e8"
    },
    {
      "source_id": "id00991",
      "target": "И в самом деле, прежде чем это время истекло, мальчик вернулся.",
      "source_sha256": "ec72b3d4c807b2aec741044557666fce9c94b3034b1f7b3d49f480fcf3e4d11b",
      "target_id": "ru-id00991",
      "tag": "p",
      "target_sha256": "49bbfa46b121cb914e2c911a686f303791601ef1089fe05a6603bab4c56de3f1"
    },
    {
      "source_id": "id00992",
      "target": "— Ну что? — спросил д’Артаньян.",
      "source_sha256": "f08c659ca4c2ff20971f4dc7c332b0491543e1fca4adfcbfd031aead258a3959",
      "target_id": "ru-id00992",
      "tag": "p",
      "target_sha256": "25b30dfaa64a04a43a482fb98ae25c12f17685e4696e4ca9f1b6ba52531f45f3"
    },
    {
      "source_id": "id00993",
      "target": "— Ну вот, — сказал мальчуган, — всё выяснено.",
      "source_sha256": "58ab2ac1cac158fcb3f9fc5ce97d6d69d76c2de23ac45e787da0c9cac3dec729",
      "target_id": "ru-id00993",
      "tag": "p",
      "target_sha256": "4f2eab4f09039c32e79e02b8ebf258ad5e19a37f990cf120d7f5ecf10da8ecd1"
    },
    {
      "source_id": "id00994",
      "target": "— И куда же он поехал?",
      "source_sha256": "f924072fda2d5fef097f22c6907824a58812008dddc177effd5333c97db93c7b",
      "target_id": "ru-id00994",
      "tag": "p",
      "target_sha256": "139a3c1073f3574fde4b3e92da5165f0ed9c4c2039fc77e0ba6c5bbc1ccfe4f7"
    },
    {
      "source_id": "id00995",
      "target": "— Полпистоля по-прежнему мои?",
      "source_sha256": "ad572a3fd8147907b74f0c866a945524256eb1556919187defd4ba576eaecb69",
      "target_id": "ru-id00995",
      "tag": "p",
      "target_sha256": "283a5e082dd29ad56ea3b6f1cd0336cfda5d5e22ffb22b18d45ca916bc693ade"
    },
    {
      "source_id": "id00996",
      "target": "— Конечно! Отвечай.",
      "source_sha256": "802b1ebb3275d164a87fb70126261eda7b9cfe7dfa4f686324f6ccce2abab676",
      "target_id": "ru-id00996",
      "tag": "p",
      "target_sha256": "58acb3e865dd08a0f0bb043a3d7033c2be35ca3f176dfd07929d50cd2704eaee"
    }
  ],
