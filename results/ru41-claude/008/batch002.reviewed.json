{
  "unit": 8,
  "batch": 2,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id00937",
      "target": "— Я пришёл возблагодарить Бога за моё счастливое освобождение, — сказал Рошфор.",
      "source_sha256": "03a586117556f8cb74e1030b2f4213b688f9714af24b403c1b8b06e40e62be2c",
      "target_id": "ru-id00937",
      "tag": "p",
      "target_sha256": "5c9b0ddb1d6b4ae77beda4b7eec3f08ea1f0c5c092c9b60ce66f68302c9b5ab4"
    },
    {
      "source_id": "id00938",
      "target": "— А что ещё? Ведь, полагаю, это не всё.",
      "source_sha256": "0fe4cf016d3fbe81c07258b3867fa34c546c1beeb460d981a7e058426f564dbd",
      "target_id": "ru-id00938",
      "tag": "p",
      "target_sha256": "c81e72f6b94843e374734b326532a28e49c898894d1a3fe96a646b677dfc851e"
    },
    {
      "source_id": "id00939",
      "target": "— А ещё затем, чтобы получить приказания коадъютора и посмотреть, нельзя ли нам немного позлить Мазарини.",
      "source_sha256": "823e702f721f2043b1166ff30fb06ea1911ecbb5d83eff9796d82cfcd60bbc32",
      "target_id": "ru-id00939",
      "tag": "p",
      "target_sha256": "b09190ab605de2cec9bc9c7fa6f3e1de8fe777188b6a8664c62d4a190e0e18b8"
    },
    {
      "source_id": "id00940",
      "target": "— Горячая голова! Вы опять дадите засадить себя в Бастилию.",
      "source_sha256": "b80fc0d631adfd48849157f73ecd440107d56f58b615c482f2ac4a5d4993cd0b",
      "target_id": "ru-id00940",
      "tag": "p",
      "target_sha256": "5e93f7d9e72b49174092bf81bd8f871c5d16a704ecd29673ec39f27bba9d6b4f"
    },
    {
      "source_id": "id00941",
      "target": "— О, на этот счёт я буду начеку, ручаюсь вам! Свежий воздух — это такая прелесть! Поэтому, — продолжал Рошфор, дыша полной грудью, — я отправлюсь погулять за город, совершить поездку по провинции.",
      "source_sha256": "80d3f87c310ea25f8db1409ed93836ef1ca16a240f14445c3eea5ddedd9fcb53",
      "target_id": "ru-id00941",
      "tag": "p",
      "target_sha256": "194dd57666a0522f9cf5e27f0fe21c1e933a91fa271fd4e9e7558768124ee83d"
    },
    {
      "source_id": "id00942",
      "target": "— Вот как! — сказал д’Артаньян. — И я тоже!",
      "source_sha256": "f8cac981c36c74b24508321452afbf4703b42eae2e97ac139ad90f1eb8d355fc",
      "target_id": "ru-id00942",
      "tag": "p",
      "target_sha256": "740f6988b635e2e057ef0e72991088defc3d5aeec136aba9a921129a27b7df27"
    },
    {
      "source_id": "id00943",
      "target": "— А можно без нескромности спросить, куда вы едете?",
      "source_sha256": "9267ca9abb63bec5f28e3021973354fc17b8fda00835b3d4a187e0bac61449e1",
      "target_id": "ru-id00943",
      "tag": "p",
      "target_sha256": "c88bafb6a75beec7aa72c72a8540414d5f16a70dfac93d6ae5eec22a358f9126"
    },
    {
      "source_id": "id00944",
      "target": "— На поиски моих друзей.",
      "source_sha256": "1ea7c485f593082aac902f8dc5af026df9fe65502577310874c015f2201a17da",
      "target_id": "ru-id00944",
      "tag": "p",
      "target_sha256": "58ba629f9fb932563ca8d61500c4dd446e74cd0ce6202344953ccd1f6b398318"
    },
    {
      "source_id": "id00945",
      "target": "— Каких друзей?",
      "source_sha256": "9c19683a37c16f3805e0790644c70647d24fd95ea5eeacc5d3b7c9b53ac05bc7",
      "target_id": "ru-id00945",
      "tag": "p",
      "target_sha256": "39a8e60f0e9de81f3789d32e389f2dadd18d9fcb4dfab1ce22c4cd6bdb2e4deb"
    },
    {
      "source_id": "id00946",
      "target": "— Тех, о ком вы вчера спрашивали у меня новостей.",
      "source_sha256": "b5be803bbd29d6b7fd69c5564273e7329ea244036aee35c5ba682f07609f41ef",
      "target_id": "ru-id00946",
      "tag": "p",
      "target_sha256": "740a821a6127a4e9e24ebae87e1804c2c6d1cde037e46974cf0088cf9bf7690f"
    },
    {
      "source_id": "id00947",
      "target": "— Об Атосе, Портосе и Арамисе? Вы их ищете?",
      "source_sha256": "d756a73362173fae83510e242f5a48a045654e2e7921bb7dbf41457b1305f138",
      "target_id": "ru-id00947",
      "tag": "p",
      "target_sha256": "ea0d95e126117670c5d703fa7ee7d7123786be9fbc26ff3fc2740d776150f05b"
    },
    {
      "source_id": "id00948",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id00948",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "id00949",
      "target": "— Честное слово?",
      "source_sha256": "898f43301bbc45780ee2ea293c26fa9d88ca2f9c8ace163a3886b06d1d9f89b5",
      "target_id": "ru-id00949",
      "tag": "p",
      "target_sha256": "b4aa0b56093e46f0efb242e1a61fddac34f44950c639474e2168fcba9686676f"
    },
    {
      "source_id": "id00950",
      "target": "— Что же тут удивительного?",
      "source_sha256": "43656a86f77ca79953bf353b3e01ba50306bcce94ec00509b56dd9b909d97d4c",
      "target_id": "ru-id00950",
      "tag": "p",
      "target_sha256": "d397cfa8628776ce07ba0136a345091909547ad272f9338d757f5ad9716ac134"
    },
    {
      "source_id": "id00951",
      "target": "— Ничего. Забавно. А по чьему поручению вы их ищете?",
      "source_sha256": "4e032c2ffbd4d224ff630d6893ecf3f6d1512964be6133ae0b26e7fefd454b17",
      "target_id": "ru-id00951",
      "tag": "p",
      "target_sha256": "2d31e6f8e3b1b9f3e27aee7cdb822d2a0af7a294da08c91fe812eaa2078f605b"
    },
    {
      "source_id": "id00952",
      "target": "— Вы и не догадываетесь.",
      "source_sha256": "073c54189b51370c76a78a90d2934f7119d266bb55dce141e8c902df427904f9",
      "target_id": "ru-id00952",
      "tag": "p",
      "target_sha256": "902891ac644e190b4318bc9fa38bc5fac24e8965b196fb93fe92688706c39361"
    },
    {
      "source_id": "id00953",
      "target": "— Ещё как догадываюсь.",
      "source_sha256": "6a4cde9452bd112b5f84dd958246ac90c2cccad80cc2fae841a28518d2a88b59",
      "target_id": "ru-id00953",
      "tag": "p",
      "target_sha256": "1ec3b67e5acc13133858261b961ad83b2ea6717d9691dfa1d5b3f32b8640db9a"
    },
    {
      "source_id": "id00954",
      "target": "— К несчастью, я не знаю, где они.",
      "source_sha256": "3881723d09a365b054a9f4e8ddfa215920934714be7ee1fd707bd8c11bb10501",
      "target_id": "ru-id00954",
      "tag": "p",
      "target_sha256": "99481da89a8f99336ab5591f1ad15f6036817700a316c31b27f72514adba972e"
    },
    {
      "source_id": "id00955",
      "target": "— И у вас нет никакого способа получить о них известия? Подождите неделю, и я вам их доставлю.",
      "source_sha256": "e5e3ea5be7b548e12913bd26aca12bc521194035e50707af7e38f8a77727c898",
      "target_id": "ru-id00955",
      "tag": "p",
      "target_sha256": "7a24e3e42fa678781473783dd9679fa54d2c3b580a5a19aa5325e0d8319f7a7c"
    },
    {
      "source_id": "id00956",
      "target": "— Неделя — это слишком долго; мне нужно, чтобы я нашёл их до истечения трёх дней.",
      "source_sha256": "5e4a9858799cc8231c3b21e13d51b31a2074f1a3760c5165b09ee575c28c9e04",
      "target_id": "ru-id00956",
      "tag": "p",
      "target_sha256": "49f94e509e0083425ef5dd2dc00be4c0f3c53347e63a7e9571858fd889f75f59"
    }
  ],
