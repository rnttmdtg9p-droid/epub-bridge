{
  "unit": 8,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id00997",
      "target": "— Хочу на неё взглянуть. Одолжите мне её, я посмотрю, не фальшивая ли.",
      "source_sha256": "67f7573637e695664de78ebd60cb0b278a3650e09f31771855b5cfa6423503a1",
      "target_id": "ru-id00997",
      "tag": "p",
      "target_sha256": "882a2eedf28826992b5a3144908d6e6a316874f72772f566fb50384aefc9a5fe"
    },
    {
      "source_id": "id00998",
      "target": "— Вот она.",
      "source_sha256": "ad6eb0eb80fce69998d36fd6fd4dbfc4b3e7b18627bb274a603065fc1bbdb052",
      "target_id": "ru-id00998",
      "tag": "p",
      "target_sha256": "7a30064105c5fb5434184b04a4f409c8a7a7d0bf6ee39d2563ceae4ac2e107e2"
    },
    {
      "source_id": "id00999",
      "target": "— Послушайте-ка, хозяин, — сказал мальчик, — этот господин просит разменять.",
      "source_sha256": "093d4ad44cb4d4cc8d183a4ef6acdbb548cc4cd1ddc163e834560ce68aab2330",
      "target_id": "ru-id00999",
      "tag": "p",
      "target_sha256": "5af4b968162a3c11b78dbd6d3f9c78c91f0609d04a2c90a5e0dd9fbd7ab83773"
    },
    {
      "source_id": "id01000",
      "target": "Хозяин был за своей стойкой; он отсчитал сдачу и взял полпистоля.",
      "source_sha256": "03fba83f98b98c1e3c0fcea559116c2c1cc82d42c11e742d0c185ed1537de6a1",
      "target_id": "ru-id01000",
      "tag": "p",
      "target_sha256": "979fa89d2b49461d2c94d6f7a9e756cee50b8db6a944971cd28129d48f4cfa0d"
    },
    {
      "source_id": "id01001",
      "target": "Мальчик положил мелочь в карман.",
      "source_sha256": "ce1f0e2c47b6b137944fecf009dc0826576ace303a5df6b6ee868018c470e608",
      "target_id": "ru-id01001",
      "tag": "p",
      "target_sha256": "1102ab3d43881892afd83b1fa1c38823cdd9dd9329280b3add5439620f3d1238"
    },
    {
      "source_id": "id01002",
      "target": "— А теперь куда он поехал? — спросил д’Артаньян, со смехом наблюдавший за его маленькой проделкой.",
      "source_sha256": "c87ceae6464d119b46172e3da824fb7c4a9075e1f79b9971261e5f0ebb11d9ce",
      "target_id": "ru-id01002",
      "tag": "p",
      "target_sha256": "a1022689fa7b3cbb02ce3b426abe20d5c6edf8291e8758bda97b3172e6d54a65"
    },
    {
      "source_id": "id01003",
      "target": "— Он поехал в Нуази.",
      "source_sha256": "79ec0c66cb43e596cd45ed2a297d64852a840ec0ce35e72d08a1ccbe23281f69",
      "target_id": "ru-id01003",
      "tag": "p",
      "target_sha256": "b14bf56858dd2f9df647daec450629d6e5ee1da754bdf8f0a92a2097f237ea78"
    },
    {
      "source_id": "id01004",
      "target": "— Откуда ты это знаешь?",
      "source_sha256": "6bbe35f67959d017dd385a55589f7d62100ccc0d938d35b60e17bde17334fc00",
      "target_id": "ru-id01004",
      "tag": "p",
      "target_sha256": "d678bfaf18564ca0cd1ee4df4b5605840458eba7bf9ccbacb007ad1e8d700305"
    },
    {
      "source_id": "id01005",
      "target": "— Ах, ей-богу! Тут не надо было быть особенно хитрым. Я узнал лошадь: она мясникова, он время от времени сдаёт её внаём господину Базену. Ну, и я подумал, что мясник не стал бы вот так сдавать свою лошадь, не спросив, куда её поведут, хотя я и не думаю, что господин Базен способен загнать лошадь.",
      "source_sha256": "3a632043543b0d18b9b1d2343a97f08ccdc028e99fd3430fe9b2c8ada3c5e23e",
      "target_id": "ru-id01005",
      "tag": "p",
      "target_sha256": "d4dbdeac97c2d6bc8a8df37ea7abeca19b55d154c0d2538957754184eba11be1"
    },
    {
      "source_id": "id01006",
      "target": "— И он ответил тебе, что господин Базен…",
      "source_sha256": "d719978fbefba945c38bda1b53e388824799fcac2795fa5b5554e3b5588f46af",
      "target_id": "ru-id01006",
      "tag": "p",
      "target_sha256": "c7a82574c66f0f2997003dd0d7eb674f1dfc9d40f0cac90963975a70676f1665"
    },
    {
      "source_id": "id01007",
      "target": "— Едет в Нуази. Впрочем, похоже, у него такая привычка: он ездит туда два-три раза в неделю.",
      "source_sha256": "4053d042bc19b32dded76b1a5544f3a9b775b5e533c4b4e7159d9b92d4be0b09",
      "target_id": "ru-id01007",
      "tag": "p",
      "target_sha256": "ab9ec13007d11ca47700c3d62ba666f49dc89ff89e128b474ac329427887fc64"
    },
    {
      "source_id": "id01008",
      "target": "— А знаешь ты Нуази?",
      "source_sha256": "bef1edc444d76440d69b3b4012096e3f3402da9de378b4294dc544b53a169282",
      "target_id": "ru-id01008",
      "tag": "p",
      "target_sha256": "a1f67849d1fd08b55891791c3a9156fbf3a459c0bc10dc75fc53bae97d07336e"
    },
    {
      "source_id": "id01009",
      "target": "— Ещё бы не знать, там живёт моя кормилица.",
      "source_sha256": "eca077fec5b4503d2138e51fdf1ce3db2981bada62e36eca70a6bf8700049d55",
      "target_id": "ru-id01009",
      "tag": "p",
      "target_sha256": "24487b43f264013062bca0cdb74da1ebdba98fdb597b05fd81846fe3dd1dc5a9"
    },
    {
      "source_id": "id01010",
      "target": "— Есть ли в Нуази монастырь?",
      "source_sha256": "7eb788154d5d253db11dad5a48726db5358e7d30a283da4a8b5218cfd10f5ee7",
      "target_id": "ru-id01010",
      "tag": "p",
      "target_sha256": "9fbf85644c034a18d1a0605aa232b0588a422bdc691e7b2919a3e61bd13a401e"
    },
    {
      "source_id": "id01011",
      "target": "— И ещё какой, иезуитский монастырь.",
      "source_sha256": "0bca52d29dca7a5c1e5797c7cf4b54e6cbf13f1b87dee265cb6d4cdc222080d8",
      "target_id": "ru-id01011",
      "tag": "p",
      "target_sha256": "b5b9d3e5f69401974cf32dcc38df1b5eacd6a87356f19626e964dcc9e4888357"
    },
    {
      "source_id": "id01012",
      "target": "— Хорошо, — сказал д’Артаньян, — больше никаких сомнений!",
      "source_sha256": "f181d0832a4c576b53c0caf6c4150d2e4dfb5f7c13ad2581d66767ca03383a47",
      "target_id": "ru-id01012",
      "tag": "p",
      "target_sha256": "2a1ff73d9907f84d19c6a44cb0ee5af76310dae45f5a697e394b1e3486ac0af3"
    },
    {
      "source_id": "id01013",
      "target": "— Значит, вы довольны?",
      "source_sha256": "c686c22c971ca1249e22f9ff02eea819d2bfbeb48fc6fc7aee1a364c128d2e12",
      "target_id": "ru-id01013",
      "tag": "p",
      "target_sha256": "2a4e6528049b0171aa65357799d8b823b4d782cbea4fa34e020f832844090845"
    },
    {
      "source_id": "id01014",
      "target": "— Да. Как тебя зовут?",
      "source_sha256": "f4397459d52b6582d3b25221caa26a9d522c2f3a13d0fc62fc9e5da211d6763e",
      "target_id": "ru-id01014",
      "tag": "p",
      "target_sha256": "809c39b7c6fc62a13fc7cb425da018839c3019c4eedf0d3bfd6596576717b1df"
    },
    {
      "source_id": "id01015",
      "target": "— Фрике.",
      "source_sha256": "94a86f904efe1ff1f175a3a1ae409482f90ae990c376d7d2f733012e3559b1e9",
      "target_id": "ru-id01015",
      "tag": "p",
      "target_sha256": "206605e573cf610a6c6b9315ecdbfbaf7d7a1baad0fa45ab1a8d90816622236a"
    },
    {
      "source_id": "id01016",
      "target": "Д’Артаньян достал записную книжку и записал имя мальчика и адрес кабачка.",
      "source_sha256": "cdc61d98dc813977627f19a689db8830bedb386afa7b564faa5da570b5067c03",
      "target_id": "ru-id01016",
      "tag": "p",
      "target_sha256": "3d69856f39ed26860b99d76391ae141f99819253f0dc8055ce085ed8a4ba0cc9"
    }
  ],
