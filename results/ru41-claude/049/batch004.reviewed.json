{
  "unit": 49,
  "batch": 4,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id06317",
      "target": "— Он позволит мне вести переговоры о моей кардинальской шляпе по моему собственному усмотрению.",
      "source_sha256": "93e4e2c9addaf6f4f639abb200c1bf6aba95f367f2343f837de22f67311289b7",
      "target_id": "ru-id06317",
      "tag": "p",
      "target_sha256": "9ffae86c04d04202de41aa87bb6fc503a7e1b533c77bd78b3607798b89410d13"
    },
    {
      "source_id": "id06318",
      "target": "— Вы так ею дорожите?",
      "source_sha256": "2468710dd9157799b500d08089db5f1b65088a2814010fc0b4fa49d44220f3b9",
      "target_id": "ru-id06318",
      "tag": "p",
      "target_sha256": "494e348e5ed22887c6d8e2e7eb646c37c1e74e26a8c21688ff3557010dffd1c4"
    },
    {
      "source_id": "id06319",
      "target": "— Раз меня принуждают носить шляпу такого фасона, который мне не подходит, — сказал Гонди, — я хочу, по крайней мере, чтобы эта шляпа была красной.",
      "source_sha256": "7d5625594c11e9e07aff8ea0573f4019e097e4e798f8e618530e315f20584a65",
      "target_id": "ru-id06319",
      "tag": "p",
      "target_sha256": "70eab8d9eb2dcb4636fdb081f8ece25d6be92096750bf220176d48171cd5b440"
    },
    {
      "source_id": "id06320",
      "target": "— О вкусах и цветах не спорят, — смеясь, сказал Рошфор. — За его согласие я ручаюсь.",
      "source_sha256": "a547b3bb065e017d52edf67dbf539de0511062b7187765710dbad50045f4305b",
      "target_id": "ru-id06320",
      "tag": "p",
      "target_sha256": "cf8c101a14d0f5b80ce7afe8ac81b2ab6e98379544e8e0f2e566ca8e4976537d"
    },
    {
      "source_id": "id06321",
      "target": "— И вы напишете ему сегодня вечером?",
      "source_sha256": "ee9510c432e8bc1a5b100c9769fa3e29518867f5bc5c6c627ba1eb75e7bb1480",
      "target_id": "ru-id06321",
      "tag": "p",
      "target_sha256": "fdf75be0d35ca9f669c4261bd010f8e9b943fb930cd310e97949843f5eba68dc"
    },
    {
      "source_id": "id06322",
      "target": "— Я сделаю лучше: пошлю к нему гонца.",
      "source_sha256": "621ec7165ca675608422a7a92202aff27e4bf6ddb28545560889c9a73339fb8b",
      "target_id": "ru-id06322",
      "tag": "p",
      "target_sha256": "66ea704f2a5151ea5cb8eec1682fe4e10a726bd9481c5d0f0675bf098b6b5980"
    },
    {
      "source_id": "id06323",
      "target": "— Через сколько дней он может быть здесь?",
      "source_sha256": "350841a9195a941e7a6f805b2a4f2556ebc5be5cdade440d2a78d7892fb37b27",
      "target_id": "ru-id06323",
      "tag": "p",
      "target_sha256": "b2b5a15bcbaaa449e7ed89de9ff7b2da05d65da13a7acc9b4ef4a2cd4d0d249a"
    },
    {
      "source_id": "id06324",
      "target": "— Через пять дней.",
      "source_sha256": "94268970c369f0e9d03ca97ff64b52225617de7c1aa610b7fa20df471bfdfe8f",
      "target_id": "ru-id06324",
      "tag": "p",
      "target_sha256": "b97026eb52a18d569baf090bbc7a1c19f380e620284c196efdd8ddc1d5767c0c"
    },
    {
      "source_id": "id06325",
      "target": "— Пусть приезжает, и он найдёт перемену.",
      "source_sha256": "4075aeccaa1a9cda97c3c22203895fc19f818106f66888d0ea084eedf3f23fdf",
      "target_id": "ru-id06325",
      "tag": "p",
      "target_sha256": "2536dfa1bcc7f3c95be1fe2297c83816e6ccda8991101e05f1d5f60c5fa1152b"
    },
    {
      "source_id": "id06326",
      "target": "— Я этого желаю.",
      "source_sha256": "f9a5667039960441c844702e3f1ac85c86f78a8b18902b9ee759e8e905144ae5",
      "target_id": "ru-id06326",
      "tag": "p",
      "target_sha256": "aca09fdf8b588d6423b4da10f158ff877834908415cc3b7706f52b2121b1dc33"
    },
    {
      "source_id": "id06327",
      "target": "— Я за это ручаюсь.",
      "source_sha256": "d833e53e1cda13d66a953e220373d0780c6cbbdd143c7507969cea84342041fa",
      "target_id": "ru-id06327",
      "tag": "p",
      "target_sha256": "c3f783a96f6fb8af5384991fe8751a5bc9047bc5acb3d0759ec637eb59ef104f"
    },
    {
      "source_id": "id06328",
      "target": "— Итак?",
      "source_sha256": "9e58ecc723fa1c2330fc3240cf6fae43ef61954f281f86ed22bb23d23149d409",
      "target_id": "ru-id06328",
      "tag": "p",
      "target_sha256": "d4537febfedda1a9b840bc7e84d1df401d1bbf57c27914bf24fc6a2243f7104d"
    },
    {
      "source_id": "id06329",
      "target": "— Ступайте соберите ваших пятьдесят человек и будьте наготове.",
      "source_sha256": "27ee204d12c0f3f2252e89c9838f29b55adfc1ba5eec2d6b9031a6083c68284e",
      "target_id": "ru-id06329",
      "tag": "p",
      "target_sha256": "5fb14f4b5377f78dbee656b2f6aaead8a7612d37d891f5bf807f5ac75c6b30df"
    },
    {
      "source_id": "id06330",
      "target": "— Готов к чему?",
      "source_sha256": "8c3e705c49bb906702c152522c7e5bddf8588698a795403cb388fd6394109b8f",
      "target_id": "ru-id06330",
      "tag": "p",
      "target_sha256": "b74bc092872d03a95c7c3518104f88a36357ee0e747f40c1f764d2fc23fa672e"
    },
    {
      "source_id": "id06331",
      "target": "— Ко всему.",
      "source_sha256": "bfff07b54dd059d122130dc626bb52b935b4919defe47c91157022e871ea6189",
      "target_id": "ru-id06331",
      "tag": "p",
      "target_sha256": "c143fef94e3753ce134a9d4f8829f8459e693f8da4b6e970df93d93451e8d521"
    },
    {
      "source_id": "id06332",
      "target": "— Есть ли условный знак для сбора?",
      "source_sha256": "74fa520be59f7a0dd6b564342f5987186bd57d370852bbf0d1064c61f1da7312",
      "target_id": "ru-id06332",
      "tag": "p",
      "target_sha256": "c8dfe14d552ed4a1799fd3d99c395f2cbf48828f3f600887604b05f8e49f01b8"
    },
    {
      "source_id": "id06333",
      "target": "— Соломенный бант на шляпе.",
      "source_sha256": "05222378a16df89f1a1819b84a3c6da70dbf4807016b3a611c7a6785dfbf8fbb",
      "target_id": "ru-id06333",
      "tag": "p",
      "target_sha256": "e5873c9f0c3ec539050a7d38893f0b720b9c2a0485481e5e31df05291185577b"
    },
    {
      "source_id": "id06334",
      "target": "— Хорошо. Прощайте, монсеньор.",
      "source_sha256": "97603d03835f8a7d3d3f06aaf69eaf9c809da1fddb86499c562b84d98cff1b1d",
      "target_id": "ru-id06334",
      "tag": "p",
      "target_sha256": "38a9f75851448170f82a400987bcbcd97e54c808405dc76d15fdb0985f30e73a"
    },
    {
      "source_id": "id06335",
      "target": "— Прощайте, мой дорогой Рошфор.",
      "source_sha256": "fea2a9f09fb12f111115302a322b067cc43c0cfc17d0f54ab0ada99bff10e571",
      "target_id": "ru-id06335",
      "tag": "p",
      "target_sha256": "3103e6b55f59def2185963160c20197d4283d22c48ce9c88de4e05ab9902f9eb"
    },
    {
      "source_id": "id06336",
      "target": "— Ах, мосье Мазарини, мосье Мазарини! — сказал Рошфор, увлекая за собой своего кюре, который так и не нашёл случая вставить хоть слово в этот разговор. — Вы увидите, слишком ли я стар, чтобы быть человеком действия!",
      "source_sha256": "82f874a582727da58650fc066f3726b74dab2f780243c445dc67e5532c903d19",
      "target_id": "ru-id06336",
      "tag": "p",
      "target_sha256": "8fd8d13570fd9576bfa6c8b2cfbf398c62f33815dc9641c339d2fc0359e60e59"
    }
  ],
