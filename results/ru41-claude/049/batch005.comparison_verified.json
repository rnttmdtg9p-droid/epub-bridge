{
  "unit": 49,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id06337",
      "target": "Было половина десятого; коадъютору требовалось добрых полчаса, чтобы дойти от архиепископства до башни Сен-Жак-ла-Бушери.",
      "source_sha256": "f8fafb844fe8fc81abfb451e787b3e75e7895766603ee4ad1859fb1a5fd4e410",
      "target_id": "ru-id06337",
      "tag": "p",
      "target_sha256": "8a0d3032f7d06953f8f8e2b27ff55e21e32e8bdca4468514f0f66a5ca469a7f5"
    },
    {
      "source_id": "id06338",
      "target": "Коадъютор заметил, что в одном из самых высоких окон башни горит свет.",
      "source_sha256": "fe0eb5071f2aff3bddeae915c8fc64b1cee14fb7e0dc83d0417c6ffcd2ee898c",
      "target_id": "ru-id06338",
      "tag": "p",
      "target_sha256": "73761429545bda1b269e254b5c2a0eeec0c51ac492810a9a056fe47369c6b324"
    },
    {
      "source_id": "id06339",
      "target": "— Хорошо, — сказал он, — наш синдик на своём посту.",
      "source_sha256": "428f6b2e9876e3f64273d140fcd29ec24028f601c94e69f68f7c8e431310fc6d",
      "target_id": "ru-id06339",
      "tag": "p",
      "target_sha256": "0746519aba3e742df815c87be968285ea16b0a03e0383b7ec00f972fe8ae9a8a"
    },
    {
      "source_id": "id06340",
      "target": "Он постучал; ему пришли отпереть. Сам викарий ждал его и, освещая путь, провёл на самый верх башни; там он указал ему небольшую дверь, поставил свет в углу стены, чтобы коадъютор мог найти его, когда будет выходить, и спустился.",
      "source_sha256": "a0286b8824288a60a3ace88af091eec57aa4082eed3f84a66954fa94cb812cd4",
      "target_id": "ru-id06340",
      "tag": "p",
      "target_sha256": "521e98a46f8ad92d63bb9d8cc4d840debb2e1413f31990c45e189a1ce7dc9158"
    },
    {
      "source_id": "id06341",
      "target": "Хотя ключ торчал в двери, коадъютор постучал.",
      "source_sha256": "6b36f8c3467917fcefc3b04c1ac2eb675816473d5e394a9caf981d59beb002a1",
      "target_id": "ru-id06341",
      "tag": "p",
      "target_sha256": "8c55d937a04bf2e310fe4e3873dff92a76f77155ed1a61086f672611bd5f87fc"
    },
    {
      "source_id": "id06342",
      "target": "— Войдите, — произнёс голос, в котором коадъютор узнал голос нищего.",
      "source_sha256": "b3c3dcbc74f18b77e40e62e67f528284fc043f0ebffbd5239f3144ca9082e042",
      "target_id": "ru-id06342",
      "tag": "p",
      "target_sha256": "a0fe3eea9ad2c358b695af0306c56ff0c7d5719f86aad1655417a713845f8412"
    },
    {
      "source_id": "id06343",
      "target": "Гонди вошёл. Это действительно был раздатчик святой воды с паперти Сент-Эсташ. Он ждал, лёжа на каком-то подобии убогой койки.",
      "source_sha256": "fc5ca0d2c3effcd4115a655488c43573e4d0716aa73c6f568ecd6f5183ad6819",
      "target_id": "ru-id06343",
      "tag": "p",
      "target_sha256": "c157fc57e2a076c644e06b18c5f9393eefdc96652ed891b485fe1519df729936"
    },
    {
      "source_id": "id06344",
      "target": "Увидев входящего коадъютора, он встал.",
      "source_sha256": "1488d4938342cfd8c5338251d420c0282e0928b93109096950a519b6937e9285",
      "target_id": "ru-id06344",
      "tag": "p",
      "target_sha256": "c3802839cb5e6e5352596d4b88e62c011b80db85ca34c7f91fe9b8a973634744"
    },
    {
      "source_id": "id06345",
      "target": "Пробило десять.",
      "source_sha256": "fc36404936e1a240c69965c9d685b80e6fb0287b1a70fcc66ac9f9c46a8e8847",
      "target_id": "ru-id06345",
      "tag": "p",
      "target_sha256": "98d65820556ba52ce21c616106aeb68a529d6b91bb3d0ef5cae2b9d45775e763"
    },
    {
      "source_id": "id06346",
      "target": "— Ну что же! — сказал Гонди. — Ты сдержал слово?",
      "source_sha256": "e784dd41c1c7c187e1569baf3c56b01583158f0ac34113d2e62feb3d56439e42",
      "target_id": "ru-id06346",
      "tag": "p",
      "target_sha256": "2a2478ebae6eeed5ca6bb31ffd2209c1cc5f59540f7c8ebc7aeb5d3c2e4f6f4b"
    },
    {
      "source_id": "id06347",
      "target": "— Не совсем, — ответил нищий.",
      "source_sha256": "8ec4d30283fdd725ccbfd71944961ad8fbfd0c1ecc9537f7b4708092f7f6c209",
      "target_id": "ru-id06347",
      "tag": "p",
      "target_sha256": "cb2b91eb7196b3fdb50397c8a312fefdac41b226a46ee7ff82b3d05099c4b1cc"
    },
    {
      "source_id": "id06348",
      "target": "— Как так?",
      "source_sha256": "24abe4982bc1efaf04df8781dfe2ce72e9299c18c2fb0ec5d15297b000883304",
      "target_id": "ru-id06348",
      "tag": "p",
      "target_sha256": "b4592186655d9f97c936bc9d5e1c7013346d208284974aa91c654d8e6e435aad"
    },
    {
      "source_id": "id06349",
      "target": "— Вы просили у меня пятьсот человек, не так ли?",
      "source_sha256": "a9639681183fcb078cb6444c9a590345409ba154a7c2b067e821c75deb8ec156",
      "target_id": "ru-id06349",
      "tag": "p",
      "target_sha256": "35fdd9828ca62a7b0de3654f7b00378123eeec36a6d55c33c6eab78ec5306b3b"
    },
    {
      "source_id": "id06350",
      "target": "— Да, и что же?",
      "source_sha256": "4972d923b0a5dfe79f2718813c10e5d600a4b114769a1e7d3bbc28994b43151a",
      "target_id": "ru-id06350",
      "tag": "p",
      "target_sha256": "33dd9ef4282e487954644d0e6a0010a4deed021fb303b7daa153217ecf4a8f27"
    },
    {
      "source_id": "id06351",
      "target": "— Так вот, я раздобуду вам две тысячи.",
      "source_sha256": "c4a25167240507d512f6b245e083f4506f0d0f49a532bea03ca49f56ad867623",
      "target_id": "ru-id06351",
      "tag": "p",
      "target_sha256": "e7db63c363ec163e6afc31abcea18e2d48259173ccd1a689718ead38a037ee62"
    },
    {
      "source_id": "id06352",
      "target": "— Ты не хвастаешь?",
      "source_sha256": "e34ea09132e1458f08c61c58509f20b8a983058e3cc4a06a8c7931bef47e1b0a",
      "target_id": "ru-id06352",
      "tag": "p",
      "target_sha256": "13e29e8534796cb3d1b01a95488846559972244b2d7a1fe380ab5f7c6fed6637"
    },
    {
      "source_id": "id06353",
      "target": "— Хотите доказательство?",
      "source_sha256": "084ba6238df68298a93ccf7050e2b1d34a1bf309048d9a84da93f8a8f0735349",
      "target_id": "ru-id06353",
      "tag": "p",
      "target_sha256": "6b474136124a1e82e72a89e0c158332f0a3ce9051e9b5f70902b97362bfd1795"
    },
    {
      "source_id": "id06354",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id06354",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "id06355",
      "target": "Были зажжены три свечи, и каждая горела перед окном; одно из окон выходило на Сите, другое — на Пале-Рояль, третье — на улицу Сен-Дени.",
      "source_sha256": "3c91c6651dd09d9df3d30d17edc3c299aea7c4304068ae6508749634d53c7799",
      "target_id": "ru-id06355",
      "tag": "p",
      "target_sha256": "42b11390cf04efe1757a858ebde4465ddbd28f22454188ca726485f2da01d772"
    },
    {
      "source_id": "id06356",
      "target": "Человек молча подошёл к каждой из трёх свечей и погасил их одну за другой.",
      "source_sha256": "1f3a0c3573dc232769bc5db0a72c6096db4ce7ab356badca20c348aed15fb3c3",
      "target_id": "ru-id06356",
      "tag": "p",
      "target_sha256": "fdc798abc4e958c2ddb8d8b79a83087dc50f3aa8165ff0ec3c65686b576bb7a3"
    }
  ],
