{
  "unit": 49,
  "batch": 3,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id06297",
      "target": "— Но… я на это надеюсь.",
      "source_sha256": "d7348336f50da5a0eb0cfb66444f11b7ee4178bc75ccdb121263539d885fdc3b",
      "target_id": "ru-id06297",
      "tag": "p",
      "target_sha256": "9f3f65016c8ec4888223375e7ffc29bc23762c0da4456dea54d03394a3982c41"
    },
    {
      "source_id": "id06298",
      "target": "— А когда начнутся танцы?",
      "source_sha256": "501222a1610b02f1696e49e55d8ad371c7225ad699916cfc9946ff287ff0cfc1",
      "target_id": "ru-id06298",
      "tag": "p",
      "target_sha256": "c0d668107124656ca942c34a28a4741b37b939d058739002d342ace09a1ece00"
    },
    {
      "source_id": "id06299",
      "target": "— Приглашения рассылаются на эту ночь, — сказал коадъютор, — но скрипки начнут играть только завтра утром.",
      "source_sha256": "a34455e0bb34b54e90c324eea5da6ea0149a487b3c5bc9a7ce4c63454a8baa99",
      "target_id": "ru-id06299",
      "tag": "p",
      "target_sha256": "187ca95e425530a08e8e622f6a234a7a073c3c3cc06abcffc2fc6d82a79e6f23"
    },
    {
      "source_id": "id06300",
      "target": "— Вы можете рассчитывать на меня и на пятьдесят солдат, которых обещал мне шевалье д’Юмьер на случай, если они мне понадобятся.",
      "source_sha256": "9252e03c307c2b4fffbff4369cfd4f574c297f7a9b05a42ef5a212308c25d43c",
      "target_id": "ru-id06300",
      "tag": "p",
      "target_sha256": "c18a1d1ebb5f728b43568587e39d0e7e96ab3192460e48b1c70b5de43304341b"
    },
    {
      "source_id": "id06301",
      "target": "— На пятьдесят солдат?",
      "source_sha256": "31dd34f193d1b4f8f1296a501a63a750bcbcab59861af7f23e7738a97c5f44b0",
      "target_id": "ru-id06301",
      "tag": "p",
      "target_sha256": "ad371eb0b5e2ca4f9e36b6704273f606606431fa54d132e33c6e413e3fc16024"
    },
    {
      "source_id": "id06302",
      "target": "— Да; он набирает рекрутов и одалживает их мне; когда праздник кончится, если кого-нибудь недостанет, я заменю их.",
      "source_sha256": "aec21493d8d4aadc017c7a1eb49f6e6ea3c9e05da3a72f4be7da9eb667353c1f",
      "target_id": "ru-id06302",
      "tag": "p",
      "target_sha256": "261b4304d72f879b128464fde822a28cc506b11984bae040e19a5f86a49f122e"
    },
    {
      "source_id": "id06303",
      "target": "— Хорошо, мой милый Рошфор; но это еще не всё.",
      "source_sha256": "50e64a17d5251b197d3219d2152a238b4824b4987abd9c03942b2028b973972d",
      "target_id": "ru-id06303",
      "tag": "p",
      "target_sha256": "530cdbf392b49cc58353ca4dd0fe3d3d1a975504114118c5e97fd4a625505467"
    },
    {
      "source_id": "id06304",
      "target": "— Что там еще? — спросил Рошфор с улыбкой.",
      "source_sha256": "88aab4dfab5e016757dbf8bde70bd9c705bd9a51a43844435584c9c566b28987",
      "target_id": "ru-id06304",
      "tag": "p",
      "target_sha256": "8a08723eb4bbcf5d6ec3b2d5126212e2cf4b1b126c7caac7b6d0019dc745b1dd"
    },
    {
      "source_id": "id06305",
      "target": "— Господин де Бофор, что вы с ним сделали?",
      "source_sha256": "cc64c245f9f4b669f1a1b06a591242471e2a22c9afa3b7a299a31904b2389c8d",
      "target_id": "ru-id06305",
      "tag": "p",
      "target_sha256": "3e2ca6ff0610475a280bc27e3359562d1f3202454b800a8b1ca378a2201e96bb"
    },
    {
      "source_id": "id06306",
      "target": "— Он в Вандомуа и ждет, пока я напишу ему, чтобы он вернулся в Париж.",
      "source_sha256": "8575cbe0c29013d745873dff5cea33bafaaba7d5697632b4994b0ae6bc2328e0",
      "target_id": "ru-id06306",
      "tag": "p",
      "target_sha256": "721f22c741ec44db5d141f7272932c9b405f901b132f12ec4e7339d000a1500e"
    },
    {
      "source_id": "id06307",
      "target": "— Напишите ему: пора.",
      "source_sha256": "ab1ee418218515ae27f3c0dad6db0d26047197fda206e90eb98c00af08b4d90b",
      "target_id": "ru-id06307",
      "tag": "p",
      "target_sha256": "8a36ab12fac7fac1a1ef0ee4abef53b2bd779a9b3dcc67637256b6da59097e70"
    },
    {
      "source_id": "id06308",
      "target": "— Вы, стало быть, уверены в своем деле?",
      "source_sha256": "c7618c23857be68c6381068fc5afe5584c349ef61c7c71d24b66f74a416a6c6d",
      "target_id": "ru-id06308",
      "tag": "p",
      "target_sha256": "58c2aed3b1f53b276e69d0fbe4f441ba41d5bf3b1cc6e050633967ae8d6fd819"
    },
    {
      "source_id": "id06309",
      "target": "— Да, но ему надо поторопиться; ведь едва парижский народ взбунтуется, как у нас окажется десять принцев на одного, и все захотят встать во главе его: если он промедлит, то найдет место занятым.",
      "source_sha256": "17960a2e70bc812670ce9e4a6b2b7c6fea7ab76929cfddeeaf955ef043da55b1",
      "target_id": "ru-id06309",
      "tag": "p",
      "target_sha256": "484790472086c815c1777f29b5ab319216b469543597e55b56e1c48aeb9cb003"
    },
    {
      "source_id": "id06310",
      "target": "— Могу ли я уведомить его от вашего имени?",
      "source_sha256": "7b629a45d0d3fd1d254b588a65d4f21f64108bcf9204b6f483fe001e580c764e",
      "target_id": "ru-id06310",
      "tag": "p",
      "target_sha256": "27a1656094676bd4a08a8644d4d14532890e6550be0fe237e0ad8b4ddaf28288"
    },
    {
      "source_id": "id06311",
      "target": "— Да, вполне.",
      "source_sha256": "d3f5c1b194eb98eaf42ab5849bf4c1f352c7123661e97a43259b5c7c03cd1732",
      "target_id": "ru-id06311",
      "tag": "p",
      "target_sha256": "d8bcd8ee2c308d255a39b79c81dd4880a7d4739380000f6c4d59ca5fa053a8e8"
    },
    {
      "source_id": "id06312",
      "target": "— Могу ли я сказать ему, что он должен рассчитывать на вас?",
      "source_sha256": "6545eba9bc3d89fdeec7cbdd0985dcd811d854a910b5d0eab5da4da3b4332dbc",
      "target_id": "ru-id06312",
      "tag": "p",
      "target_sha256": "7b64be6b910d3841a4a148fd871d95055c17f9784eb23a51203b6ec5d3852bfc"
    },
    {
      "source_id": "id06313",
      "target": "— Превосходно.",
      "source_sha256": "c1a90bbb8bff86446a0b8b3c63d56cf872ebd58a9f6c528ed1b47e037d3b3cda",
      "target_id": "ru-id06313",
      "tag": "p",
      "target_sha256": "4b11a5f9d4c5b936af54475d6db3f69f14198dc61e23ef410196a2186e6b6aef"
    },
    {
      "source_id": "id06314",
      "target": "— И вы предоставите ему всю власть?",
      "source_sha256": "f8af82e14109fc22b28ae3445474bc11b58ab2890353bcf94ecf118db50e0961",
      "target_id": "ru-id06314",
      "tag": "p",
      "target_sha256": "11fa903d5506eec48622841778d59fdcf17595c9c2a63b194a8f7cf431fd56d6"
    },
    {
      "source_id": "id06315",
      "target": "— В военных делах — да; что же до политики…",
      "source_sha256": "8b507a61832c8238c33360a487518a63594e7b60a8955e34c738647b2cf71be3",
      "target_id": "ru-id06315",
      "tag": "p",
      "target_sha256": "52c25b5b1afbbd60f5cb855d57970655994cefb64d2fc69942aa8c23dc338c66"
    },
    {
      "source_id": "id06316",
      "target": "— Вы знаете, что это не его сильная сторона.",
      "source_sha256": "ace79a53dfe8bc3acc726563483ff82972dd0b2093709ad8d7186f4c07107921",
      "target_id": "ru-id06316",
      "tag": "p",
      "target_sha256": "68ef020f3dc6d6847a885a52f19324ab97e661aafe70c7ca23d5158f0a56a643"
    }
  ],
