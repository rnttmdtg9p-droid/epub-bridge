{
  "unit": 47,
  "batch": 8,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id05994",
      "target": "— Выпейте два глотка этого, — сказал он.",
      "source_sha256": "20521a7b5df66836aa2096e8f747879824f301a7bb5c38d057d12fd2cc0cc3c0",
      "target_id": "ru-id05994",
      "tag": "p",
      "target_sha256": "6c3017654c384449d3e555f1c448b2a19df722f96d1e961bca2f084083e8966f"
    },
    {
      "source_id": "id05995",
      "target": "Рауль выпил и хотел повторить свои благодарности.",
      "source_sha256": "5dd3946dcb23f2e5d3a222853ad81c68ed651d50d4f4ac8ea42fa13b65f349d4",
      "target_id": "ru-id05995",
      "tag": "p",
      "target_sha256": "254627837de611a2a33e92ce926c9101d970e36d681c95fe34420f62ba92d813"
    },
    {
      "source_id": "id05996",
      "target": "— Дорогой мой, — сказал д’Артаньян, — об этом мы поговорим после.",
      "source_sha256": "62862a47a761dbcffe181f60d77c900a5d5c4ebd0de2b00aa73ff740eaea8c9a",
      "target_id": "ru-id05996",
      "tag": "p",
      "target_sha256": "afab46738e6f6e9fcc72eef03d25bac4ac1d0deec76167396f0b504485ce6bd4"
    },
    {
      "source_id": "id05997",
      "target": "Затем, увидев, что мушкетёры очистили набережную от Нового моста до набережной Сен-Мишель и возвращаются, он поднял шпагу, чтобы они прибавили шагу.",
      "source_sha256": "1da441a3d93f74422625ca9cf217fb7520b26fd549d7bd98a55650ed70cce78b",
      "target_id": "ru-id05997",
      "tag": "p",
      "target_sha256": "025f9ec8634f389c75b33a2007619935d99b4acd1a6e89a091d7ff98157c8e4d"
    },
    {
      "source_id": "id05998",
      "target": "Мушкетёры подъехали рысью; в то же время с другой стороны набережной подъезжали десять человек эскорта, которых д’Артаньян дал Коменжу.",
      "source_sha256": "4e91eb71dff95cc0af97f34476061362fc05619271c55b2ee47883a61efaf009",
      "target_id": "ru-id05998",
      "tag": "p",
      "target_sha256": "24b00fb0125451636810855916dabe3510b8e358f69f4c96a9ae90b2de0d0bee"
    },
    {
      "source_id": "id05999",
      "target": "— Эй! — сказал д’Артаньян, обращаясь к ним. — Случилось что-нибудь новое?",
      "source_sha256": "c47ace2e3a892d67b424a2ba0c1536ab34fd731a3ef64a7648a2d2bda5a460eb",
      "target_id": "ru-id05999",
      "tag": "p",
      "target_sha256": "13aa2fa2b68db1fec4fb5f12b3c2f4b5fb2660398dc5cdd6bc8a380c8d0a7dd5"
    },
    {
      "source_id": "id06000",
      "target": "— Эх, сударь, — сказал сержант, — их карета опять сломалась; это настоящее проклятие.",
      "source_sha256": "e3a73cdae22bfc570844cecf0b5b03259ae5c3471272ba0ac56a34de62efa614",
      "target_id": "ru-id06000",
      "tag": "p",
      "target_sha256": "aefc703a935aa3c0f7c93ebd568569055349e2e1633929a8a364dac79bfa8242"
    },
    {
      "source_id": "id06001",
      "target": "Д’Артаньян пожал плечами.",
      "source_sha256": "67a9503468dae6c0bead7457397c3a072fe1131934ce70a19b217bb5d37d70e0",
      "target_id": "ru-id06001",
      "tag": "p",
      "target_sha256": "c74fd695f03a05cfb3d8e4262b005ca8723ceef2d13023fb270a66bc560efaab"
    },
    {
      "source_id": "id06002",
      "target": "— Неумехи, — сказал он. — Когда выбираешь карету, она должна быть прочной: карета, в которой арестовывают какого-нибудь Бруселя, должна выдерживать десять тысяч человек.",
      "source_sha256": "21a11942dda537e0403455842a63b55a75a46878dfcddd786f5a1ac4c022a814",
      "target_id": "ru-id06002",
      "tag": "p",
      "target_sha256": "91b7ae68c21a17bd38dea968695ac7898676864e1c095dce1990c570dc9ac844"
    },
    {
      "source_id": "id06003",
      "target": "— Что прикажете, господин лейтенант?",
      "source_sha256": "38164d1da2294458dc578240ab522220944075bd12f1120d4ddd1ee47e2e5422",
      "target_id": "ru-id06003",
      "tag": "p",
      "target_sha256": "27c237c299cbf4fe05c76468577b7181807a97e24c7557d90ec27039670069fd"
    },
    {
      "source_id": "id06004",
      "target": "— Возьмите отряд и отведите его в казарму.",
      "source_sha256": "6abac65b53c5c308f6009a4cc546d0a0d879a48a11c77584554369dc5b7c0f5d",
      "target_id": "ru-id06004",
      "tag": "p",
      "target_sha256": "19120f270a400ab1c5f200b1137ebd6239013824d507e442c2fa6a6d71113e03"
    },
    {
      "source_id": "id06005",
      "target": "— Но неужели вы уезжаете один?",
      "source_sha256": "afad2afd936b2f013d802b5d4982bceb1c1f961fe038a69fe92d6e5bd56050ba",
      "target_id": "ru-id06005",
      "tag": "p",
      "target_sha256": "1244fa1e56035c04fa3d801a4182dc400efae8c171a7d125f30579d46a4db9cb"
    },
    {
      "source_id": "id06006",
      "target": "— Разумеется. Не думаете же вы, что мне нужен эскорт?",
      "source_sha256": "47ebeb6521ae18d803778d88af6e0b3144c25cc5668b936f288d32b20478ddaf",
      "target_id": "ru-id06006",
      "tag": "p",
      "target_sha256": "4cbc3e7948b93bceae277384c6a5cf1a4ba046bcda50e42555f052afb7ee4ea1"
    },
    {
      "source_id": "id06007",
      "target": "— Однако…",
      "source_sha256": "d619b4c36860b22b201adcbc0876a9e65bd57a4af21a8db76fae7b2c02df2131",
      "target_id": "ru-id06007",
      "tag": "p",
      "target_sha256": "7a756cc14bcd76301822ea1421bd2d28a3b357c992f821988d8d3dab11ef683b"
    },
    {
      "source_id": "id06008",
      "target": "— Ступайте же.",
      "source_sha256": "e76da92b87a6c86511b368112caefc279c89799faa0e26323a785cb6e9450911",
      "target_id": "ru-id06008",
      "tag": "p",
      "target_sha256": "a88f4ae7b21d6f0cbdab684fc0bf1fd95dd68b95fd75593d1e2b1be5fe828a3d"
    },
    {
      "source_id": "id06009",
      "target": "Мушкетёры уехали, и д’Артаньян остался наедине с Раулем.",
      "source_sha256": "59667477063088575d55e7fd0b9065b2b6fbd70b559fa10e00b24342182ca783",
      "target_id": "ru-id06009",
      "tag": "p",
      "target_sha256": "327148280b0ce85eb393e7a0115c7e3149809f0f7c575124c09e87ddab00f60e"
    },
    {
      "source_id": "id06010",
      "target": "— Теперь вам больно? — сказал он ему.",
      "source_sha256": "d38730fa6b4fe7bf7c6d2158395c8a809a24b2058461265db1e6aec4c0b432e7",
      "target_id": "ru-id06010",
      "tag": "p",
      "target_sha256": "9d473d3f55e9fea0bc984601b32373fc6621655c115359bbafcac7b617be0c4c"
    },
    {
      "source_id": "id06011",
      "target": "— Да, сударь, голова у меня тяжёлая и горит.",
      "source_sha256": "0e5ab9547da9ba714559db336fec866292542e8f50876ac829b238c53685cf25",
      "target_id": "ru-id06011",
      "tag": "p",
      "target_sha256": "784898a0b982f0e1cae8e961aede5be3b781b9d573eccce5447eddd1797e357d"
    },
    {
      "source_id": "id06012",
      "target": "— Что же у вас с этой головой? — сказал д’Артаньян, приподнимая шляпу. — А-а! Ушиб.",
      "source_sha256": "4a2dae7a15b234b40e3fe90b1bd27a3d82aede2eefa2fcdb9768f1bf3d04972e",
      "target_id": "ru-id06012",
      "tag": "p",
      "target_sha256": "7da659c38564158ecd7323ba8f3f23dbd8ef248cfcd60057919dda13291333df"
    },
    {
      "source_id": "id06013",
      "target": "— Да, кажется, я получил по голове цветочным горшком.",
      "source_sha256": "0393a6470619d6fa25a91bd721619f91a0f0428e08438161e1f113e503a3a1df",
      "target_id": "ru-id06013",
      "tag": "p",
      "target_sha256": "e02431e46dd72c30be939d0765966b5db72fca9ec6038031c7ce22ca952e15d6"
    }
  ],
