{
  "unit": 54,
  "batch": 5,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id07015",
      "target": "— О, на этот счёт предоставьте всё мне.",
      "source_sha256": "9cdd477a145f37fba0ef646d9ce8a5a18c752f353d24876b2dde1a684f534006",
      "target_id": "ru-id07015",
      "tag": "p",
      "target_sha256": "9e113f1e1afe6b2921f6d28d943f70b1bbcc9b1ba6ff170e2fa6ced88a33d95f"
    },
    {
      "source_id": "id07016",
      "target": "— Я даю вам полную власть: берите такой многочисленный эскорт, какой вам угодно.",
      "source_sha256": "385bdba6dccfb6866d01e9e0ee7c6d30a79209c30cc29f3bd9cfea6693e903fb",
      "target_id": "ru-id07016",
      "tag": "p",
      "target_sha256": "ed1c2ddcd4ae0670c6dd37e6ec770441596c5b1602290d57293d31ae3eb8c458"
    },
    {
      "source_id": "id07017",
      "target": "Д’Артаньян покачал головой.",
      "source_sha256": "58a9a91b9cf52aa784e81f0e1eeef81d71cbf759fce1cc7a54dfe101831fd596",
      "target_id": "ru-id07017",
      "tag": "p",
      "target_sha256": "15d8d855aba7db50ee700af2d00f19f2e00d7947ee76c82a429ac6ac84c93877"
    },
    {
      "source_id": "id07018",
      "target": "— Мне, однако, кажется, что это самое верное средство, — сказал Мазарини.",
      "source_sha256": "5b6ce6c30b1537a78e86dbf18b5152f3d657b8bc580a8fa20132f2222baa4975",
      "target_id": "ru-id07018",
      "tag": "p",
      "target_sha256": "945052d31e3389f99313d4ba65a8873f8555e7ddbccad3821d2626c9ff21b1ac"
    },
    {
      "source_id": "id07019",
      "target": "— Да, для вас, монсеньор, но не для королевы.",
      "source_sha256": "fbfb9424c3a824fb41892e2fe1663a97dc686573ca839a6f847b4810116597fb",
      "target_id": "ru-id07019",
      "tag": "p",
      "target_sha256": "d06375e3ede50540935e24a81e0af0755bb26319cb6b46d06e9be7fbd7c346b2"
    },
    {
      "source_id": "id07020",
      "target": "Мазарини закусил губу.",
      "source_sha256": "9cc7837ebf6e2bddea5dd72acf1c4b6b31e5da97aada5bcca84025f5a097ecec",
      "target_id": "ru-id07020",
      "tag": "p",
      "target_sha256": "6f18ae70f452bf16ea43e261a46f409e608c37f11c8d2508ebb7d503c0731e90"
    },
    {
      "source_id": "id07021",
      "target": "— Так как же, — спросил он, — мы будем действовать?",
      "source_sha256": "d42ddee903d4a7efa6c28a9d4179e5e1bfcc7f9a369a1506666a0abebe2de0fc",
      "target_id": "ru-id07021",
      "tag": "p",
      "target_sha256": "2da878548af917e5d2151cae34e137a3142b32e55fb45dd40b0cc6da17d53cf6"
    },
    {
      "source_id": "id07022",
      "target": "— Предоставьте всё мне, монсеньор.",
      "source_sha256": "9192c411427635c41ba78d07f1fd1c86c31b258aa3f529a6d1766a7e9a03dc9e",
      "target_id": "ru-id07022",
      "tag": "p",
      "target_sha256": "e1f0e899f40bf974befa835866875085497cdeabcbed410e3daf6f15ec229c59"
    },
    {
      "source_id": "id07023",
      "target": "— Гм! — произнёс Мазарини.",
      "source_sha256": "94bd1b0711bcb297183004de6375afc08c83e9d5b48a5b449f872233e5c22772",
      "target_id": "ru-id07023",
      "tag": "p",
      "target_sha256": "1a182dbf2ace14d933bdf912a7e08cd36129ca29c528caa0aedec487a853b2cd"
    },
    {
      "source_id": "id07024",
      "target": "— И отдайте мне полное руководство этим предприятием.",
      "source_sha256": "e8be5d53613cd81f2559e65b5eeb113286e610e4caeb8eec56ab3011f805f043",
      "target_id": "ru-id07024",
      "tag": "p",
      "target_sha256": "adf535868e9a77e55154de62dceea4732f5242085857300cb1c12d307b1d517a"
    },
    {
      "source_id": "id07025",
      "target": "— Однако…",
      "source_sha256": "d619b4c36860b22b201adcbc0876a9e65bd57a4af21a8db76fae7b2c02df2131",
      "target_id": "ru-id07025",
      "tag": "p",
      "target_sha256": "7a756cc14bcd76301822ea1421bd2d28a3b357c992f821988d8d3dab11ef683b"
    },
    {
      "source_id": "id07026",
      "target": "— Или ищите другого, — сказал д’Артаньян, поворачиваясь спиной.",
      "source_sha256": "ea55bda3b38a588162cec3c99290e7ff8bda3f77c953086dc4402bc70b1a945e",
      "target_id": "ru-id07026",
      "tag": "p",
      "target_sha256": "8b83a6bb6a8d79fa54e8374490aaca6596266ed8141a9dec66417706f59fcc89"
    },
    {
      "source_id": "id07027",
      "target": "— Эге! — совсем тихо сказал Мазарини. — Кажется, он уходит вместе с бриллиантом.",
      "source_sha256": "7eaf8b265a549fb8c53b0dd4f7154415cb927d452ddfd67a989e0bbb907aeb75",
      "target_id": "ru-id07027",
      "tag": "p",
      "target_sha256": "e2d1018fc157676eb6aec0d3a7b6f2aee7146ca91c1146adb66ad9d44f022c8e"
    },
    {
      "source_id": "id07028",
      "target": "И он окликнул его.",
      "source_sha256": "885c23521e4c11ee0cc60565dba6537a44d368cabe17676aabb955bb52dedf24",
      "target_id": "ru-id07028",
      "tag": "p",
      "target_sha256": "3b2dcaca434591044ad9f00c13eeb9b19d72f0108606e8b21de312771afe3b57"
    },
    {
      "source_id": "id07029",
      "target": "— <i>Мосью</i> д’Артаньян, мой милый <i>мосью</i> д’Артаньян, — произнёс он вкрадчивым голосом.",
      "source_sha256": "4505cb69f031da66de6c7de4016d2f091681bf0227ccd983302a07bd7a2c7f47",
      "target_id": "ru-id07029",
      "tag": "p",
      "target_sha256": "e55f4f14e6ff0c2e33cc22257273f7d25ba71635dcb26374704febf96d9116b4"
    },
    {
      "source_id": "id07030",
      "target": "— Монсеньор?",
      "source_sha256": "f8f2c0f0364de2b4cfb85ea1cc35daeafc0a34d748e9a810d195dcdc5a7bf00d",
      "target_id": "ru-id07030",
      "tag": "p",
      "target_sha256": "6ab14d4b42a46604d2edcc833048bc718caeceab641837db29ae1f72937f60e1"
    },
    {
      "source_id": "id07031",
      "target": "— Вы отвечаете мне за всё?",
      "source_sha256": "d4cf7b3608f15490198bfa3b3f4addcea03c1c0627eda3b9132c63cf75cd71cb",
      "target_id": "ru-id07031",
      "tag": "p",
      "target_sha256": "bdae5d7d3ac4d30432d206ebba61b3d899d9488abc0e982441605eae7e5c676b"
    },
    {
      "source_id": "id07032",
      "target": "— Я ни за что не отвечаю, я сделаю всё, что смогу.",
      "source_sha256": "183bc5226c58af5ac3e9b54522f8679fb3bde46447999f5dee507ec3d13d35ae",
      "target_id": "ru-id07032",
      "tag": "p",
      "target_sha256": "5ae23a6c6020228679c12e45675f2fb07c58980a9f1e1ade075cf5e31aedd644"
    },
    {
      "source_id": "id07033",
      "target": "— Всё, что сможете?",
      "source_sha256": "5172e9895408e34d5ea82b2d154a3a256a044b2af5474a71060a70b447cf6fcc",
      "target_id": "ru-id07033",
      "tag": "p",
      "target_sha256": "e3d70229cf20123c450e0389f8351c2368f03e8cce80fc712e8a70388ca6dc6f"
    },
    {
      "source_id": "id07034",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id07034",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    }
  ],
