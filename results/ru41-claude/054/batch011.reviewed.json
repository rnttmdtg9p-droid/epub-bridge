{
  "unit": 54,
  "batch": 11,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id07135",
      "target": "— Пропустите, — сказал он, — это друзья.",
      "source_sha256": "c5c74d4b2670ffd864f70aaaf0cd24a8e993161a03e9313b8707b0265cdd1189",
      "target_id": "ru-id07135",
      "tag": "p",
      "target_sha256": "e5490ceadcc744d1666cfb2a59615acbe727cff384e457a098926197b942f3a4"
    },
    {
      "source_id": "id07136",
      "target": "Карета снова тронулась, и Мазарини, который затаил дыхание, решился вздохнуть.",
      "source_sha256": "9f5c9ac4fa44a46139d5fea5a12b95ef1a5679bf9c428af9e01ae07de357bf5e",
      "target_id": "ru-id07136",
      "tag": "p",
      "target_sha256": "4cf488bfb6d225e4fc1074601ae7ac81f4799154e7f21e0b663aadb2b1dd5d57"
    },
    {
      "source_id": "id07137",
      "target": "— <i>Bricconi!</i> — пробормотал он.",
      "source_sha256": "b4f774cae1841716883b40aa310c72878c56c6e740e0c02d72867f17e1eabf4e",
      "target_id": "ru-id07137",
      "tag": "p",
      "target_sha256": "28f6ce3958a85e5368143d9e9f14553b3375ccec8fa3450ede3c7bbcf0ceee88"
    },
    {
      "source_id": "id07138",
      "target": "За несколько шагов до ворот Сент-Оноре встретился третий отряд; он состоял из людей с дурными физиономиями, больше похожих на разбойников, чем на что-либо иное: то были люди нищего от Сент-Эсташа.",
      "source_sha256": "5436295ea02961c32540cf51391ac1734db7c4b69d132e2299dc55340ee2947d",
      "target_id": "ru-id07138",
      "tag": "p",
      "target_sha256": "f635db3e1953544650f1c53070ad21cbef9ab460d485d232d691eeae30d7ac9d"
    },
    {
      "source_id": "id07139",
      "target": "— Внимание, Портос! — сказал д’Артаньян.",
      "source_sha256": "75bdfe6e3f77a89a9f9e73ff414a96aa8227774f4e00e142e79cc174f7976502",
      "target_id": "ru-id07139",
      "tag": "p",
      "target_sha256": "a5c8692529eea115937be0fb7a77608f949d7c7c9b67b9f2d49ca6b506d3753c"
    },
    {
      "source_id": "id07140",
      "target": "Портос протянул руку к пистолетам.",
      "source_sha256": "f15425c9ba40d4f9d27b4a09580382c14c2c90ebd0833d1c786e1aaa2e108110",
      "target_id": "ru-id07140",
      "tag": "p",
      "target_sha256": "b3784d0683dbcd5b9c6d6b6a7eda8c47ab04b3e465a682fb680c5655118d87d3"
    },
    {
      "source_id": "id07141",
      "target": "— Что там такое? — спросил Мазарини.",
      "source_sha256": "363230d849a55d35b8a5f8c0dc18592a3a884a2f27f9798112a7b09795826569",
      "target_id": "ru-id07141",
      "tag": "p",
      "target_sha256": "fda98e413a2aa609dc2680b96346cbe51f67b134924eeb609fde200ca12e725e"
    },
    {
      "source_id": "id07142",
      "target": "— Монсеньер, мне кажется, мы в дурной компании.",
      "source_sha256": "2563a3adf91261c489a6f312deb0d381a1e4163c4dcbd55422264b1ac422ca20",
      "target_id": "ru-id07142",
      "tag": "p",
      "target_sha256": "cac914ae8b88e7c233236aadb8f456ea573162c68c4772a7069916b945175275"
    },
    {
      "source_id": "id07143",
      "target": "Какой-то человек с чем-то вроде косы в руке подошёл к дверце.",
      "source_sha256": "0aba7790e158cba46e6aad05babf9b898d24c76054f03d94072f308a1c5bffcc",
      "target_id": "ru-id07143",
      "tag": "p",
      "target_sha256": "46b259930f9a93e7255c29504461b880076eb8dae2189e500f6c3f98e8c8423f"
    },
    {
      "source_id": "id07144",
      "target": "— Кто идёт? — спросил этот человек.",
      "source_sha256": "67687d848e8cd0bbe9dc98ca56ad153e82e0ddb99390ea7d263e3367ebc55839",
      "target_id": "ru-id07144",
      "tag": "p",
      "target_sha256": "648c47a1c063d62e742b013b7bae74b88bc12b5b3b52e86c600a6e559e256365"
    },
    {
      "source_id": "id07145",
      "target": "— Эй, плут, — сказал д’Артаньян, — разве вы не узнаёте карету господина принца?",
      "source_sha256": "d26d9f7beaecd338009d352a5ca03e97d5cfb7b77277c53bcd40856f44f55380",
      "target_id": "ru-id07145",
      "tag": "p",
      "target_sha256": "208103d4151d2cdb746aee57beb36573d2fd81ded6b829b5cc79ad8b9d0f60f9"
    },
    {
      "source_id": "id07146",
      "target": "— Принц или не принц, — сказал этот человек, — отворяйте! Мы стережём ворота, и никто не пройдёт, пока мы не узнаем, кто проезжает.",
      "source_sha256": "96c9b7dd4d1bc11a7c84460583acfbd64a8fe8fc7b3c7b01827d483b87f9b9b0",
      "target_id": "ru-id07146",
      "tag": "p",
      "target_sha256": "e382a1a4f5ce337b9f1a5e53fe6c78d8bbd56a4e9c9f9890fcb7cde3dedb196e"
    },
    {
      "source_id": "id07147",
      "target": "— Что же делать? — спросил Портос.",
      "source_sha256": "290f80f82587e8042676d3b6216aaad868db920f1169f3f3f6e1731fe03d0e8a",
      "target_id": "ru-id07147",
      "tag": "p",
      "target_sha256": "89d2a451c3417b071e628b8dc462ba7025b76107d7c2da140a0cae8f736e6861"
    },
    {
      "source_id": "id07148",
      "target": "— Ей-богу, проехать, — сказал д’Артаньян.",
      "source_sha256": "1ff9368606a68fa35ea806dc75f1880c79173e45f56541b839be3fd2dd66aa62",
      "target_id": "ru-id07148",
      "tag": "p",
      "target_sha256": "10f2e216e16caad1eed9975eca791e5aa34d8fc7a5ceae2418be8141998d0ce0"
    },
    {
      "source_id": "id07149",
      "target": "— Но как проехать? — спросил Мазарини.",
      "source_sha256": "1dfe489f68f5d23e7079754c847f991321c82d73cf23dae32de371843b6ac9c1",
      "target_id": "ru-id07149",
      "tag": "p",
      "target_sha256": "e0440512e9f30e7ba44974b0e01e3ac0b2c5798dfd068e204201cf5dbc55e9fb"
    },
    {
      "source_id": "id07150",
      "target": "— Сквозь них или поверх них. Кучер, в галоп!",
      "source_sha256": "b98346eda9ab2df655b44624195da7b8026ef76b00fcc6538b19f4b2ac9bbb13",
      "target_id": "ru-id07150",
      "tag": "p",
      "target_sha256": "5e653a0d81dd72bfad45fb637dc0ce4ff83d90c166cc1866de7317a7a7e94a30"
    },
    {
      "source_id": "id07151",
      "target": "Кучер поднял кнут.",
      "source_sha256": "9e71f058883e27ff20291d1f779d49cc0da79eb67363726ebb61bab6859905a7",
      "target_id": "ru-id07151",
      "tag": "p",
      "target_sha256": "21461071bc77227ae2bebda6a3dc20b5bd54e524da29033432687d28f17690aa"
    },
    {
      "source_id": "id07152",
      "target": "— Ни шагу дальше, — сказал человек, который, по-видимому, был у них главным, — не то я перережу вашим лошадям поджилки.",
      "source_sha256": "ae990a42a3c7e1d6c98f0bc691d781817b9a198bd2f3cf33e4409a488209e0de",
      "target_id": "ru-id07152",
      "tag": "p",
      "target_sha256": "536c2d0bcfe9283c8e16ef2d73c415b873959ae6308f2bdb65c6b44ad4d29d69"
    },
    {
      "source_id": "id07153",
      "target": "— Чёрт возьми! — сказал Портос. — Было бы жаль: эти животные стоят мне по сто пистолей за штуку.",
      "source_sha256": "d1faeb02f8cca96f70ff0d67d68d26f482ffbf9b5ac42f3662b26b771c6dea8b",
      "target_id": "ru-id07153",
      "tag": "p",
      "target_sha256": "952eb5b44ae8a799fa93ee14165d669ec09c68821df1933bb930e5190b675df9"
    },
    {
      "source_id": "id07154",
      "target": "— Я заплачу вам за них по двести, — сказал Мазарини.",
      "source_sha256": "9d0e70d24f9652d34dd0e85b467035ef1e7cfc141d37cde018ef700844ef7731",
      "target_id": "ru-id07154",
      "tag": "p",
      "target_sha256": "82c8795a3ab1ff6dc6d66edff7e11b2ff962fe8dfa200ffb4523f39021dfa3cc"
    }
  ],
