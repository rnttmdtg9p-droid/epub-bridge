{
  "unit": 54,
  "batch": 8,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id07075",
      "target": "— Да, монсеньор.",
      "source_sha256": "13e24f3381ef68e918470010b319a51fb81d457ef2ba9929b18fdfa99ff3cbff",
      "target_id": "ru-id07075",
      "tag": "p",
      "target_sha256": "5cf7ef4dc3ea09fc5bfc0543a5e3dba3d03bc9178390c27d04cbe5dc8f7afbed"
    },
    {
      "source_id": "id07076",
      "target": "— А этот славный господин дю Валлон — неужели мы не насладимся его обществом?",
      "source_sha256": "39fd830c11b8e18dd1dafaed6e604f68f50b850ec94f378894a8582cfe258604",
      "target_id": "ru-id07076",
      "tag": "p",
      "target_sha256": "b3483df202a83def80bcd4f49d79f0ec4ac104522f121f9b0ed96f02ede30781"
    },
    {
      "source_id": "id07077",
      "target": "— Как же, монсеньор, он ждёт в своей карете.",
      "source_sha256": "8ed78a50041daf6532f7b5de2fb9cc22c9f00290e5f9ac9d46951663607864bf",
      "target_id": "ru-id07077",
      "tag": "p",
      "target_sha256": "b0e03e65eb2c3e1815dc9cf8390776309a0c1d0dcb0867776ffdbb3991e35f6e"
    },
    {
      "source_id": "id07078",
      "target": "— Где же?",
      "source_sha256": "349748df10f9251c932d34b0f3c821fa7c6a6af2bceda1015f77227f570efde5",
      "target_id": "ru-id07078",
      "tag": "p",
      "target_sha256": "9b691ccb7a4d015da8a444ba56eeeb76f3e78170d71f3f76292a1d469c77af73"
    },
    {
      "source_id": "id07079",
      "target": "— У дверей сада Пале-Рояля.",
      "source_sha256": "39b3b8185939e74204d6169b2cfbd3e91b7f4f532da9f15746c3e113a0859fb9",
      "target_id": "ru-id07079",
      "tag": "p",
      "target_sha256": "290159cff9dbc730c58c5fa75eb71f210cc2ffb39d512c401e88903c59a214d4"
    },
    {
      "source_id": "id07080",
      "target": "— Значит, мы поедем в его карете?",
      "source_sha256": "70713dff44869d20c93e4ddbc194b86bb6ea627504bf036b2b112fc32a43a9ff",
      "target_id": "ru-id07080",
      "tag": "p",
      "target_sha256": "1fe6c97a26efa4dd2ad04fa549c991ded608ece219042f41456623f8562b82be"
    },
    {
      "source_id": "id07081",
      "target": "— Да, монсеньор.",
      "source_sha256": "13e24f3381ef68e918470010b319a51fb81d457ef2ba9929b18fdfa99ff3cbff",
      "target_id": "ru-id07081",
      "tag": "p",
      "target_sha256": "5cf7ef4dc3ea09fc5bfc0543a5e3dba3d03bc9178390c27d04cbe5dc8f7afbed"
    },
    {
      "source_id": "id07082",
      "target": "— И без другой охраны, кроме вас двоих?",
      "source_sha256": "7d031465c8bee28fb389fff15699c5a93ef9b38f115a7e2094f646cd972eb172",
      "target_id": "ru-id07082",
      "tag": "p",
      "target_sha256": "2666e51d6d8f842144b50619d4179071b9ae67b6e8060ced53fad480a1216745"
    },
    {
      "source_id": "id07083",
      "target": "— Разве этого мало? Хватило бы и одного из нас!",
      "source_sha256": "4851067977342a39ec9ed2eab2ae6044bd49ca1776612930c2d89e73d4b3f5c3",
      "target_id": "ru-id07083",
      "tag": "p",
      "target_sha256": "d51b801f7df55504c8159c5cb5adb252e59845ea98c7ddbc1ab600c985dec74c"
    },
    {
      "source_id": "id07084",
      "target": "— Право, дорогой господин д’Артаньян, — сказал Мазарини, — вы пугаете меня своим хладнокровием.",
      "source_sha256": "3354936d4f59f1cdb982cbc44d3bcc43b44614b40fcb9e1e0667431cd723c52e",
      "target_id": "ru-id07084",
      "tag": "p",
      "target_sha256": "8e53e569af9f38a85e91571403cc3ddbd430cb1e37411f7d979d11263cf7dcb2"
    },
    {
      "source_id": "id07085",
      "target": "— Я бы, напротив, подумал, что оно должно внушать вам доверие.",
      "source_sha256": "4e87b73563bc20b268b959ba7d71b69afec38fb1938df29108ced4302bb3d096",
      "target_id": "ru-id07085",
      "tag": "p",
      "target_sha256": "63304b03ae6692a1232c717150e071b83e2600d64fa9b58c47a5ae88354afd17"
    },
    {
      "source_id": "id07086",
      "target": "— А Бернуин — разве я не возьму его с собой?",
      "source_sha256": "44e9ddf6fa28bd4c66c2a7b801090cc2db446abde6a77f85eeb39fc4c5af5311",
      "target_id": "ru-id07086",
      "tag": "p",
      "target_sha256": "a707eb24afb882ec3c748351d5d4fcaf55fc9f419b9a0a2c062014bb7d001395"
    },
    {
      "source_id": "id07087",
      "target": "— Для него нет места; он присоединится к вашему высокопреосвященству.",
      "source_sha256": "a5253a81332b052277cfa043aca39130eadc16759bc27851233c1b24b7a6b20a",
      "target_id": "ru-id07087",
      "tag": "p",
      "target_sha256": "b7d33fc776367d8ac43cde45afef76fb868bde084a533406efe8c6ed4007457b"
    },
    {
      "source_id": "id07088",
      "target": "— Ну что ж, — сказал Мазарини, — раз уж во всём приходится поступать так, как вы желаете.",
      "source_sha256": "fc4a5a6bc02f871b8b5e23f21fc78ad38cdcd39db447333610c2076b88a47232",
      "target_id": "ru-id07088",
      "tag": "p",
      "target_sha256": "cac61e9c59a3b4c6a969b78aab333011e46f908618f2f92851ac23ab6a0870a0"
    },
    {
      "source_id": "id07089",
      "target": "— Монсеньор, отступить ещё не поздно, — сказал д’Артаньян, — и ваше высокопреосвященство совершенно свободны.",
      "source_sha256": "8a37ce1f63850338ec5a6698d93d8073c022da1050d90590024f56b3f3a70564",
      "target_id": "ru-id07089",
      "tag": "p",
      "target_sha256": "0dc719696a1b177de96288d60367271829be5ea1a8c1902d0afec68cbb6bc86b"
    },
    {
      "source_id": "id07090",
      "target": "— Нет, нет, — сказал Мазарини, — едем.",
      "source_sha256": "e2deb0789f7de7782e65d70635d9a79b72e6357fa4bb1f38f68013901f97e128",
      "target_id": "ru-id07090",
      "tag": "p",
      "target_sha256": "1797e69d12290a5d1bce572796a064d649a8762212aeb994a5ff6baa33862a2f"
    },
    {
      "source_id": "id07091",
      "target": "И они вдвоём спустились по потайной лестнице; Мазарини опирался на руку д’Артаньяна, и мушкетёр чувствовал, как эта рука дрожит на его руке.",
      "source_sha256": "7d4de5fb2b123e24a8986c4da827f78423e108127e6b3942d25d748abb632021",
      "target_id": "ru-id07091",
      "tag": "p",
      "target_sha256": "20262c4907ff64f89e34d7075f3139f25e98399cd7634bf7a9c14c8e0c9ecbe0"
    },
    {
      "source_id": "id07092",
      "target": "Они пересекли дворы Пале-Рояля, где ещё стояло несколько карет запоздавших гостей, вышли в сад и добрались до маленькой калитки.",
      "source_sha256": "db46deccd60b38d77e164d0e36c4d343f10acc99afc82b1df0f837509146c26f",
      "target_id": "ru-id07092",
      "tag": "p",
      "target_sha256": "80f97f80a242bc37b0b38af221fede9b132943d17b5aec4f4aee9ac0dc61c4ac"
    },
    {
      "source_id": "id07093",
      "target": "Мазарини попытался отпереть её ключом, который достал из кармана, но рука у него так дрожала, что он не мог найти замочную скважину.",
      "source_sha256": "dcf8903369d921f8efb63cad22490b0c2193f3455aa8e8cb389adcccf5362307",
      "target_id": "ru-id07093",
      "tag": "p",
      "target_sha256": "db197a912c97be64d9ed33744cb52613bf518ca93a8b3eb96f81e4cc94485b3c"
    },
    {
      "source_id": "id07094",
      "target": "— Дайте, — сказал д’Артаньян.",
      "source_sha256": "fc32582743d779ab94539e7b9e6d629c3b6b5845b972afba1b27610b82831257",
      "target_id": "ru-id07094",
      "tag": "p",
      "target_sha256": "4c97eae68a8c2b0bed6d95b45a51186a0194b10c47e51fcaa9ccab3a9c261c1e"
    }
  ],
