{
  "unit": 54,
  "batch": 10,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id07115",
      "target": "Примерно на середине улицы Птит-Шан карету остановил второй патруль.",
      "source_sha256": "8c7a6403928605f674460f9d51ed8a42bff7e0efdf74ad60b5da8db6918fef87",
      "target_id": "ru-id07115",
      "tag": "p",
      "target_sha256": "7f805cde0dda5f7c433e25d0f8cb43167ef9ea84cc24f55bc0571284d0532f7b"
    },
    {
      "source_id": "id07116",
      "target": "— Кто идёт? — крикнул начальник патруля.",
      "source_sha256": "1d4b449ff0953c44f62d252f2671bfef814f546b5fe3345d7f0a3e21d4920f94",
      "target_id": "ru-id07116",
      "tag": "p",
      "target_sha256": "eea65eb5a099cbda0bdd4de58fa0443c58e87dd007c59b8ca146b1bf0ac688ed"
    },
    {
      "source_id": "id07117",
      "target": "— Подвиньтесь, монсеньер, — сказал д’Артаньян.",
      "source_sha256": "0cc9d51a6303c7cd738f5b7b6eeb28e6f0339715b9eef7a08e8f128dd99d3990",
      "target_id": "ru-id07117",
      "tag": "p",
      "target_sha256": "72105c1e153c449e2ec3088dd96b9eef052c0cf58bb0c623ca6e4dea2d34eba8"
    },
    {
      "source_id": "id07118",
      "target": "И Мазарини так глубоко забился между двумя друзьями, что совершенно исчез, весь скрытый ими.",
      "source_sha256": "0bb6660f2bdd69209ce4e2ba6cfb598857563af4d6e357081cfa04d825e0b99a",
      "target_id": "ru-id07118",
      "tag": "p",
      "target_sha256": "c9fc609284c9c9af64fb5c0f857b210d30cd16b0197b74ff1cf80e722840b2d2"
    },
    {
      "source_id": "id07119",
      "target": "— Кто идёт? — нетерпеливо повторил тот же голос.",
      "source_sha256": "ee236b8639f1f74cfa71987e753bbde8e485c73b5fc724534ffa3c1a1d3ae231",
      "target_id": "ru-id07119",
      "tag": "p",
      "target_sha256": "ec28a198069f8dbd1da506d0e331503b2dd2792c9ba3a4ed5462e5886a5385a0"
    },
    {
      "source_id": "id07120",
      "target": "И д’Артаньян почувствовал, что бросились к головам лошадей.",
      "source_sha256": "294aaf8d85bdae0f8122a52d5faf3999ada908ec605680fd8ec0a98148f1b391",
      "target_id": "ru-id07120",
      "tag": "p",
      "target_sha256": "4a9f53367b3db10fa666e582747bbf48e9940064afb13081b75ef06937da96fb"
    },
    {
      "source_id": "id07121",
      "target": "Он высунулся из кареты наполовину.",
      "source_sha256": "4f374334de6fd26d0677b21fdceb746cc8c1ae6c60b4bbd64d1cfa9a1a47f14c",
      "target_id": "ru-id07121",
      "tag": "p",
      "target_sha256": "217d00701b1a2a1cb82327b0494ea1469fa1c3e8e7ce133e1fc35667c82064ba"
    },
    {
      "source_id": "id07122",
      "target": "— Эй! Планше, — сказал он.",
      "source_sha256": "97464996a4d8ebd0c13378cad147cb32e5465146762daf3db9eae8217ee86bc6",
      "target_id": "ru-id07122",
      "tag": "p",
      "target_sha256": "c7fa8fc92b81ca7a73973cd883194f365d51a9e55f3633e955a4ad5804562319"
    },
    {
      "source_id": "id07123",
      "target": "Начальник подошёл: это и в самом деле был Планше. Д’Артаньян уже узнал голос своего бывшего лакея.",
      "source_sha256": "e5c3481e46bf629fc3eda7d24c11e0c424d380c57957c70369ca553e1b72fb84",
      "target_id": "ru-id07123",
      "tag": "p",
      "target_sha256": "f1429c3f007ac138ed9454fd4aab0931696d05bc631d839a443bdc8272bf257b"
    },
    {
      "source_id": "id07124",
      "target": "— Как! сударь, — сказал Планше, — это вы?",
      "source_sha256": "24ff5d820e2c6cf58a320594df7bdcf1dbe089fb4bf9402af69cf104d5243ad4",
      "target_id": "ru-id07124",
      "tag": "p",
      "target_sha256": "7638a984d157a4f16b49d6eca44dca6d02b073060bd29a063f759d5d6d07ff9c"
    },
    {
      "source_id": "id07125",
      "target": "— Ах, Боже мой, да, мой дорогой друг. Наш милый Портос только что получил удар шпагой, и я везу его назад, в его загородный дом в Сен-Клу.",
      "source_sha256": "8ab246dddec29bf32574c5c274b31e13879a4d90903d91132c7a10749f9c6a38",
      "target_id": "ru-id07125",
      "tag": "p",
      "target_sha256": "9a9cc9b7a7fb705bef897535d66c473c603b10037c7efdc777216c47d228273a"
    },
    {
      "source_id": "id07126",
      "target": "— О! Неужели? — сказал Планше.",
      "source_sha256": "e3664d7f976704d5479ac5912a9856e8b705bad671aba941e100be770c834dae",
      "target_id": "ru-id07126",
      "tag": "p",
      "target_sha256": "5a0fd6504bdf0eca90036ab6a9dcc02e371e8dafa899db8e4818e675d8c0cdc9"
    },
    {
      "source_id": "id07127",
      "target": "— Портос, — продолжал д’Артаньян, — если вы ещё можете говорить, мой дорогой Портос, скажите же словечко этому славному Планше.",
      "source_sha256": "d123b5d254ccad371ff0b9aa8708465e2bbc7feb77bc68619c5d7ac6b3f44a9a",
      "target_id": "ru-id07127",
      "tag": "p",
      "target_sha256": "9ff72d79d47bec8ddc265de70c6f755ab16c6f7b550306e458cfc71b873c2509"
    },
    {
      "source_id": "id07128",
      "target": "— Планше, друг мой, — сказал Портос жалобным голосом, — я очень болен, и если ты встретишь лекаря, окажи мне любезность, пришли мне его.",
      "source_sha256": "bc3455ce381842784874b25dc2c451dcadbc8ef3dfb72d3e8a190a724724a5e1",
      "target_id": "ru-id07128",
      "tag": "p",
      "target_sha256": "21cb2df990d8f2fcc7038ca52e09a171aedbd0abcac5069c96c3f0c715ce1db4"
    },
    {
      "source_id": "id07129",
      "target": "— Ах! Великий Боже! — сказал Планше. — Какое несчастье! А как это случилось?",
      "source_sha256": "f9fab3584717bcba6ac2651db700b37f30bfbef440bbbd56a9b3003c3362939c",
      "target_id": "ru-id07129",
      "tag": "p",
      "target_sha256": "2fa9235cf0178da31a240b8c57c1e5c307cf98d50e101acbe13d1b3300322e44"
    },
    {
      "source_id": "id07130",
      "target": "— Я тебе расскажу, — сказал Мушкетон.",
      "source_sha256": "212e85b83057ac4b9da88bd862292bbd9bbe0226ac50091d7ece3957118e5ed3",
      "target_id": "ru-id07130",
      "tag": "p",
      "target_sha256": "e5204ce919470aab38617d4e16c9d6df7a28c5b01d89dcf5fec9ab431b152568"
    },
    {
      "source_id": "id07131",
      "target": "Портос испустил глубокий стон.",
      "source_sha256": "bc6911d1ef158b88da657c0b417fe8c4541f688b32c8b929e6b3473104a95e85",
      "target_id": "ru-id07131",
      "tag": "p",
      "target_sha256": "065d36fd0ef618bf30c3cff30ffd975e33d464d1d81a7ad0622d3f4416242a05"
    },
    {
      "source_id": "id07132",
      "target": "— Расчисти нам дорогу, Планше, — совсем тихо сказал д’Артаньян, — не то он не доедет живым: лёгкие задеты, мой друг.",
      "source_sha256": "644b208fc35f53019e4eeebbe19e62fa3c604a36039b4dddfd6de4de9184e958",
      "target_id": "ru-id07132",
      "tag": "p",
      "target_sha256": "ae740faddd41578b392815069bcff2d627d65160e01f1adcd4cbe36e2f9e7074"
    },
    {
      "source_id": "id07133",
      "target": "Планше покачал головой с видом человека, который говорит: «В таком случае дело плохо».",
      "source_sha256": "25a961962d808645265d7c6d84cec4c7bcf29311e1d38349198b2038794daf3e",
      "target_id": "ru-id07133",
      "tag": "p",
      "target_sha256": "61e22210dedfacbd1dda524c2c2a8a637fde9184b0a0b33c4c803e7cae88ca2b"
    },
    {
      "source_id": "id07134",
      "target": "Затем, обернувшись к своим людям:",
      "source_sha256": "6ba60239153dfe2dcd954a39a6b1a0b46887491b51f3155518234339dbe69e6a",
      "target_id": "ru-id07134",
      "tag": "p",
      "target_sha256": "ffd4675a2e3f57c962fd74f6e6170493e7ff3567de9d400b4e8b08d7e06c63d8"
    }
  ],
