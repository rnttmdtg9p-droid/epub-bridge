{
  "unit": 54,
  "batch": 13,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id07175",
      "target": "— Очарован, <i>мосью</i>, — сказал Мазарини, рискнув высунуть голову в одну из дверец. — А теперь сделайте то же самое для королевы.",
      "source_sha256": "923c23bfcd2b2db5a8f01f7dede0185246aad336c7b74d9a1e1211438b3d95f3",
      "target_id": "ru-id07175",
      "tag": "p",
      "target_sha256": "1f454346a9f7dd5ffd996a6ea592edd8b13d837a676459fae3203af8c5dda1f8"
    },
    {
      "source_id": "id07176",
      "target": "— Это будет легче, — сказал д’Артаньян, спрыгивая на землю. — Господин дю Валлон, поручаю вам Его Высокопреосвященство.",
      "source_sha256": "5df3a0bc0b27a7d2c2643372d38be016b20b4f268da0e7341cade15442e81a2e",
      "target_id": "ru-id07176",
      "tag": "p",
      "target_sha256": "0c98b4a9870a316d1fc4f0fb2ef36f82d2e0d661b29805ae7e6419b364d885cd"
    },
    {
      "source_id": "id07177",
      "target": "— Будьте покойны, — сказал Портос, протянув руку.",
      "source_sha256": "5394b6daf4d1ad64a13fa7ab460e1a507f5e4e4d256a4e9883f8e630534b730a",
      "target_id": "ru-id07177",
      "tag": "p",
      "target_sha256": "f994fb20802eba01b24399e2a4308e5b92e117e9da2ec9d062286f63d1ee4572"
    },
    {
      "source_id": "id07178",
      "target": "Д’Артаньян взял руку Портоса и потряс её.",
      "source_sha256": "9824ef5cc1165c5be8019a027dd530aa10c392aeddb19ff26b18c9f6f1d90cb5",
      "target_id": "ru-id07178",
      "tag": "p",
      "target_sha256": "e34cb3abffa42205637bcab30109d4658b4dee7fbc6f8de1ab0b3f8c336cfbea"
    },
    {
      "source_id": "id07179",
      "target": "— Ай! — вскрикнул Портос.",
      "source_sha256": "b6ef1d7deb04ec3985e9a37a894d8ea34acdc2451ed13144fa9143c8667d1501",
      "target_id": "ru-id07179",
      "tag": "p",
      "target_sha256": "8cce2c231e680cb63fa4726b7c43d9380ff6918a0aa90431a5bf2ea4024ce491"
    },
    {
      "source_id": "id07180",
      "target": "Д’Артаньян с удивлением посмотрел на друга.",
      "source_sha256": "3d9f7c9146bac27a85c96a3a144cdbd172c0b6e2bf14cdb7747b78df5ebae898",
      "target_id": "ru-id07180",
      "tag": "p",
      "target_sha256": "0b4ac4c414e7390b6de2a9702ffe52ed4ec2dfcce899c853d79d074419fb201b"
    },
    {
      "source_id": "id07181",
      "target": "— Что с вами? — спросил он.",
      "source_sha256": "40ba103cc8f9eaad9546de7e4e12e3837f74c6e176f88852f3665b6e97e307b6",
      "target_id": "ru-id07181",
      "tag": "p",
      "target_sha256": "7f2aca5330b0b849aefb118e0289c677a9af36df5a04275745786b94d7743d2a"
    },
    {
      "source_id": "id07182",
      "target": "— Кажется, я вывихнул запястье, — сказал Портос.",
      "source_sha256": "b4af57033f2e9ada6d3793b76e5fe0a08b241ac2ebab56ebc8ccce507ab55cdc",
      "target_id": "ru-id07182",
      "tag": "p",
      "target_sha256": "0edf8d704213cc09ba8a8dffe325825cce9b4983c51f3b09644d05b969adcfa1"
    },
    {
      "source_id": "id07183",
      "target": "— Да чёрт возьми, вы и бьёте, как глухой.",
      "source_sha256": "17fbe291365e27ef9534af6b72b200a7d434ef5a3ca45e275e584c2aedf0fe80",
      "target_id": "ru-id07183",
      "tag": "p",
      "target_sha256": "c28bdfbed1601ca8fd17a0bfca62f9245503f4571d59cd499bcd27213878eeaf"
    },
    {
      "source_id": "id07184",
      "target": "— Пришлось: мой человек уже собирался выпалить в меня из пистолета. А вы-то как избавились от своего?",
      "source_sha256": "6aa4d94f06d48ac4b917f1eda5c4d79a630373308fe248870f9f9e33500fbfc3",
      "target_id": "ru-id07184",
      "tag": "p",
      "target_sha256": "d3358f9f58af77afdd15e27449768e895856e56191ad8c09ed45f559deef516e"
    },
    {
      "source_id": "id07185",
      "target": "— О, мой, — сказал д’Артаньян, — был не человек.",
      "source_sha256": "ff5d78a786c0cc8896d6e7a300bb91f44cd9c6b7d196532585d3611e83919639",
      "target_id": "ru-id07185",
      "tag": "p",
      "target_sha256": "8026306b259e5cd90dc11ba6edd0921872be4982a774fb7fbecf2c95154d8595"
    },
    {
      "source_id": "id07186",
      "target": "— А кто же?",
      "source_sha256": "7612c9affe4d11a9e911210d43a06e5e26fbff9f2158ed2c60a16e4b74edd801",
      "target_id": "ru-id07186",
      "tag": "p",
      "target_sha256": "67b217e6aa1a182fe8a210ef0574cb2599d7c94efc854da6774aacece66932fc"
    },
    {
      "source_id": "id07187",
      "target": "— Призрак.",
      "source_sha256": "cd676ef27b4a486de0db09660abdf57263f7b2260c8c9c5b18ffd6d7c6c9318d",
      "target_id": "ru-id07187",
      "tag": "p",
      "target_sha256": "a574d19421c95625a095f98097620ce37408fef8a0e486e9ab2be270ec1a3905"
    },
    {
      "source_id": "id07188",
      "target": "— И…",
      "source_sha256": "cb4c2b583d9117a5f969b0d0df4ac4ccd73f707ad49654437256f2544c1b20f8",
      "target_id": "ru-id07188",
      "tag": "p",
      "target_sha256": "e641d6dd65741dd634acdba527c51e8ad0d97b557a46fd6db2b4186907a84eb0"
    },
    {
      "source_id": "id07189",
      "target": "— И я его заклял.",
      "source_sha256": "f9849a37178c44a6b8ed455b6643ee34cc0c2dd1c3c078002a06535930d07b38",
      "target_id": "ru-id07189",
      "tag": "p",
      "target_sha256": "ee7e7343ad0595108bc173db1ce4e7c3bd6d3d274603e0c3a1615c4b2f5349ab"
    },
    {
      "source_id": "id07190",
      "target": "Без дальнейших объяснений д’Артаньян взял пистолеты, лежавшие на передней скамье, заткнул их за пояс, завернулся в плащ и, не желая возвращаться через ту же заставу, через которую вышел, направился к воротам Ришелье.",
      "source_sha256": "0ad0ac56c6897fdde5d658f73b6a388673ef0c09f774817f3607b1e3e46bf95d",
      "target_id": "ru-id07190",
      "tag": "p",
      "target_sha256": "aad72ae7a2e0ee4aaff90f0c720806fa722be60dbe0dffc6091c14b7896ef8bd"
    }
  ],
