  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id06955",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id06955",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "id06956",
      "target": "— Своей жизнью?",
      "source_sha256": "720f85d56b4230c9098896d00bc111ff61ee6eeb579e3803e1d6f397d6afe427",
      "target_id": "ru-id06956",
      "tag": "p",
      "target_sha256": "5ca6d9ec7471b7a06970f83428ee2e7849f6d72af74c316b1fc669710281ed6b"
    },
    {
      "source_id": "id06957",
      "target": "— Своей жизнью.",
      "source_sha256": "64445f827a10fb5741a6822f2b72f426825e4633e28a687a557832b8482548f9",
      "target_id": "ru-id06957",
      "tag": "p",
      "target_sha256": "d21c1b38233b2d5d1d4636f7966fd06bfd1ff26d9cb87ce31092ce65a51414d2"
    },
    {
      "source_id": "id06958",
      "target": "— Да вы герой, любезный мой! — сказал Мазарини, глядя на мушкетёра с восхищением.",
      "source_sha256": "7f4305b88a397e83d6d1be6528369b8a50333c318564fe7b954ed570c37deab2",
      "target_id": "ru-id06958",
      "tag": "p",
      "target_sha256": "496e2080cfb8f0711f9361d7b2d125954c465d417c19c5054bbbacc1baa83915"
    },
    {
      "source_id": "id06959",
      "target": "Д’Артаньян улыбнулся.",
      "source_sha256": "7a0939bd2ce4ae2dafd2d38d319cc436de18ed4d140f9114c3aa22ed09f9203f",
      "target_id": "ru-id06959",
      "tag": "p",
      "target_sha256": "87277d0260c7aaa3e9d278d537074d2a100f2d92537ee784bb2ac06134131dff"
    },
    {
      "source_id": "id06960",
      "target": "— А я? — спросил Мазарини после минутного молчания, пристально глядя на д’Артаньяна.",
      "source_sha256": "cddafa1c6ed544225aa3c7dca21fec30fcd9beee6082c23d0b957c936d86140a",
      "target_id": "ru-id06960",
      "tag": "p",
      "target_sha256": "ec120be97e30a11cf3255956b69f81e7bd1cc24769ce2c5597b70e1038653e21"
    },
    {
      "source_id": "id06961",
      "target": "— Как это — а вы, монсеньер?",
      "source_sha256": "4cf284a22e93737db151114d4fc3675b0ffd139672d8c123e7f78b0d67c4cd4c",
      "target_id": "ru-id06961",
      "tag": "p",
      "target_sha256": "6018dbd417f9111c598b82d18313b487324f22be81f33c7777267789cbc44c72"
    },
    {
      "source_id": "id06962",
      "target": "— А я, если захочу уехать?",
      "source_sha256": "a57dde37705eaa8543c5d4d8ee08800670f4bab5c8358ae9e6176a07f189e930",
      "target_id": "ru-id06962",
      "tag": "p",
      "target_sha256": "e102dd8ebc86b008c2a04d849cf462dce0977c5673c136fc3448eaff0248b609"
    },
    {
      "source_id": "id06963",
      "target": "— Это будет труднее.",
      "source_sha256": "c6c4b365ea54df5a6e80ef5b8eaca721063c9f1e10329a84218f1558cac888fa",
      "target_id": "ru-id06963",
      "tag": "p",
      "target_sha256": "53761bd260c7fddeb859c421e7fe02a618ba288a4a240110e60410002fc0af00"
    },
    {
      "source_id": "id06964",
      "target": "— Отчего же?",
      "source_sha256": "24abe4982bc1efaf04df8781dfe2ce72e9299c18c2fb0ec5d15297b000883304",
      "target_id": "ru-id06964",
      "tag": "p",
      "target_sha256": "60dfab8fe9529c71539e81f404dca0b45bf5e598f61c46988a035c07ac188b5c"
    },
    {
      "source_id": "id06965",
      "target": "— Ваше высокопреосвященство могут быть узнаны.",
      "source_sha256": "3948cf4a8c57758c97d36598025947d1e214d41265dc42b96d4b22d07f3e16e8",
      "target_id": "ru-id06965",
      "tag": "p",
      "target_sha256": "1fd4646f7c1f477bcd173a50f685b4a7bbd6b73d96af3945dc76a2fc6725ec8a"
    },
    {
      "source_id": "id06966",
      "target": "— Даже в этом переодевании? — сказал Мазарини.",
      "source_sha256": "8b5182f18bf3356deeb5b377e19041f14906a5d26c900584ce896d2aeecbb502",
      "target_id": "ru-id06966",
      "tag": "p",
      "target_sha256": "76c82b2d26290aacc7e97924ebebe8bba4b505908123005c62ea8b112882f19e"
    },
    {
      "source_id": "id06967",
      "target": "И он приподнял плащ, покрывавший кресло, на котором лежало полное кавалерское платье жемчужно-серого и гранатового цвета, всё обшитое серебряным галуном.",
      "source_sha256": "ea207ff7a51608eb7851e204a8168e9f82cf5c9cb07c463a747d132b44b6d47c",
      "target_id": "ru-id06967",
      "tag": "p",
      "target_sha256": "8cf1e226e4109754c1a7620bc7bcc6498d994c8e2ccf265f1862892276ae78bc"
    },
    {
      "source_id": "id06968",
      "target": "— Если ваше высокопреосвященство переоденутся, это станет легче.",
      "source_sha256": "d097af65c8b93c2ba0fbbf37c2d33fb50fe838868db42fb68cb8c8c2e57395cf",
      "target_id": "ru-id06968",
      "tag": "p",
      "target_sha256": "053bed5db03f3b2b19b22f536db1251740b39c8f5db664aaacc72eca68014d41"
    },
    {
      "source_id": "id06969",
      "target": "— А! — сказал Мазарини, переводя дух.",
      "source_sha256": "f51f2928d13c65ab4aa65df091d4b8a9c9f72d7d08aaee737c1036e53d63cbba",
      "target_id": "ru-id06969",
      "tag": "p",
      "target_sha256": "328ba89f3cfdbe32ffcdf5548606e0e9463d81a4d6d68c7c6cdc627439892818"
    },
    {
      "source_id": "id06970",
      "target": "— Но придётся сделать то, что, как ваше высокопреосвященство говорили на днях, они сделали бы на нашем месте.",
      "source_sha256": "16af19e377cbefda9d84071ebc04f3490381baabeaa5e7397e97cf1a8e62ce67",
      "target_id": "ru-id06970",
      "tag": "p",
      "target_sha256": "ba234936f2434f01d94d534874a2f8ece02c4113ba1197c98fc2064605233853"
    },
    {
      "source_id": "id06971",
      "target": "— Что же придётся сделать?",
      "source_sha256": "e870eaaaff7776d0e2a306494ac385688a1545a8089657d17a3553ddc7097acc",
      "target_id": "ru-id06971",
      "tag": "p",
      "target_sha256": "88acff7cafe1910cc6bc669ed8ca538007c16499485e9ca2dd1833c2aa0a51cf"
    },
    {
      "source_id": "id06972",
      "target": "— Кричать: «Долой Мазарини!»",
      "source_sha256": "f5e2c810d8725adcc7c30e47e30a870427e8287795aad88f328acc9354de5d85",
      "target_id": "ru-id06972",
      "tag": "p",
      "target_sha256": "54dc63a85ea26682c9015a4a1c8e7747c2f4e0eaca6f8164cbfbce7e5403ae1a"
    },
    {
      "source_id": "id06973",
      "target": "— Я буду кричать.",
      "source_sha256": "d510e9ecc46c4024f06e3643adedfc78b1b933a409a04c36ae591fc2a0a5bcef",
      "target_id": "ru-id06973",
      "tag": "p",
      "target_sha256": "c6188f0370dfd07257713ccba2a31d978abae810b86dd562f7f14647428676ac"
    },
    {
      "source_id": "id06974",
      "target": "— По-французски, на чистом французском, монсеньер, следите за выговором: у нас на Сицилии перебили шесть тысяч анжуйцев за то, что они плохо произносили итальянские слова. Берегитесь, как бы французы не взяли над вами реванш за Сицилийскую вечерню.",
      "source_sha256": "b7d8fab35bc02876b3a38095f0286393eeb72328de0e7bcd91163d2919194df0",
      "target_id": "ru-id06974",
      "tag": "p",
      "target_sha256": "7c1a3d628838cab405c8010e63bd0d8170bc9bdfe327345bf6cb2f91799e1721"
    }
  ],
