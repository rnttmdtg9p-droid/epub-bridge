{
  "unit": 54,
  "batch": 3,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id06975",
      "target": "— Я сделаю всё, что смогу.",
      "source_sha256": "0894969532bcedbf684f5dceb5c20ca3c03f0292fbef6753f26d7b239e32a258",
      "target_id": "ru-id06975",
      "tag": "p",
      "target_sha256": "69412753ea5a3176072d6ffd5a16961fa24f3c90fe00a66e32fc2505ff0d28fb"
    },
    {
      "source_id": "id06976",
      "target": "— На улицах немало вооружённых людей, — продолжал д’Артаньян. — Вы уверены, что никто не знает о замысле королевы?",
      "source_sha256": "00d4f9621f9e7935e3cc9ccf8adbbcc62952a331a1c14ee676bcd4b64e5ba786",
      "target_id": "ru-id06976",
      "tag": "p",
      "target_sha256": "12b2d721e6e500f808ab05e1b0fc668fdf38cb5ad09ff910f85c8818517ed531"
    },
    {
      "source_id": "id06977",
      "target": "Мазарини задумался.",
      "source_sha256": "7062627762b6f4b07cd6aaae1e71da6fef9aa106aa369d7f56ac0fcba512b6b3",
      "target_id": "ru-id06977",
      "tag": "p",
      "target_sha256": "8beab4fed58356744bed95186c100ca93e95ac4e834163a9a3c5f73188b3e5f5"
    },
    {
      "source_id": "id06978",
      "target": "— Для изменника, монсеньер, это было бы славное дело — то, что вы мне предлагаете: случайности нападения всё бы оправдали.",
      "source_sha256": "febfc32f2d98f4aae6efff9f04326411fffcc0a66529170c680d1cb66c5d9647",
      "target_id": "ru-id06978",
      "tag": "p",
      "target_sha256": "698ee90fbd47cb6354330cd1791efbe87190ce1243713147cd69b7f034bf1085"
    },
    {
      "source_id": "id06979",
      "target": "Мазарини вздрогнул, но тут же подумал, что человек, замышляющий измену, не стал бы предупреждать.",
      "source_sha256": "e6f0621cb5ae550b72ced0f068b8ccc5fade1c13c2ad63eecf498dbb101488de",
      "target_id": "ru-id06979",
      "tag": "p",
      "target_sha256": "a720f8ec10ff6a7b1d5e231cea255257ac1d223b5eb6ef82c2749d0cdf932d73"
    },
    {
      "source_id": "id06980",
      "target": "— Потому-то, — живо сказал он, — я и не доверяюсь первому встречному, и доказательство тому — что я выбрал вас себе в провожатые.",
      "source_sha256": "c676d3fc799f66ac16ec96a18285a507f12be4bfee8c8a10955b6a879d5160c6",
      "target_id": "ru-id06980",
      "tag": "p",
      "target_sha256": "1dd068b817919d1f5f369b5ff9118a380654a493d4cf890842b26a96aa35681f"
    },
    {
      "source_id": "id06981",
      "target": "— Разве вы не едете вместе с королевой?",
      "source_sha256": "3807010d402d0cb736758b2d8219d1b737750c5500fb1f27f71a687d53190e20",
      "target_id": "ru-id06981",
      "tag": "p",
      "target_sha256": "289ece4cd60a1033fc4e03c2a1c05553299a6dbe2290b12b503eae2176afafac"
    },
    {
      "source_id": "id06982",
      "target": "— Нет, — сказал Мазарини.",
      "source_sha256": "fcf5bbc1d5a697388f3807b18eace3648c8913ebe0480b8064ba4a713c8c4809",
      "target_id": "ru-id06982",
      "tag": "p",
      "target_sha256": "dc4384f5a7396cbcba9f9376534688b6a1e4d8f65f04ed74c0f54402497affae"
    },
    {
      "source_id": "id06983",
      "target": "— Тогда вы выезжаете вслед за королевой?",
      "source_sha256": "ac0e0ed02f5c4abe7e27cc3af6addfbcc40ce66264f6e7ed7158ee74e9452198",
      "target_id": "ru-id06983",
      "tag": "p",
      "target_sha256": "8dabcf370cdd92a158c98e3b970b6e7b02baa175da0216680e1f0ce001c7983a"
    },
    {
      "source_id": "id06984",
      "target": "— Нет, — снова сказал Мазарини.",
      "source_sha256": "3554e7de40e70965663f173f019f375ff229d2a348184004cccd08a8877daddf",
      "target_id": "ru-id06984",
      "tag": "p",
      "target_sha256": "8589696a4491debcda7edba0191419031af0bf2bfccce0c10d248cff84d2eea5"
    },
    {
      "source_id": "id06985",
      "target": "— А! — сказал д’Артаньян, начиная понимать.",
      "source_sha256": "ce113f14b226e7e95f6d8700c3e9831e61fb5ab492ef282e5adb5ce53bb764ae",
      "target_id": "ru-id06985",
      "tag": "p",
      "target_sha256": "776c63af681bd91df3cb1d20dd33ee0508a0bf45f984ed10fabac4d3dce75822"
    },
    {
      "source_id": "id06986",
      "target": "— Да, у меня свои расчёты, — продолжал кардинал. — Если я поеду с королевой, я удвою её дурные шансы; если после королевы — её отъезд удвоит мои; а потом, когда двор будет спасён, обо мне могут и забыть: сильные мира сего неблагодарны.",
      "source_sha256": "759d6e2acc5acbbfec1564f4edb6255bb3bdd6757ca64de6b2fd5e69e997b511",
      "target_id": "ru-id06986",
      "tag": "p",
      "target_sha256": "9aea2e4f1804f1323b8ffbc50dd648039700c9503d217c3b332b47ec3a0fc953"
    },
    {
      "source_id": "id06987",
      "target": "— Это правда, — сказал д’Артаньян, невольно бросив взгляд на бриллиант королевы, который был на пальце у Мазарини.",
      "source_sha256": "87d85aa56d6b94030a6824e9dfa9986c31094df89bf99c4d55e56243aec35a7c",
      "target_id": "ru-id06987",
      "tag": "p",
      "target_sha256": "f6cf4cc364d3069563d6f22ce09db31a02db05760b6546147f8e42a90b0a43ea"
    },
    {
      "source_id": "id06988",
      "target": "Мазарини проследил направление этого взгляда и тихонько повернул оправу перстня внутрь.",
      "source_sha256": "7de8b1db122d7d088f950e74c53a8a52084023f0b9979ac69a39468536e29d26",
      "target_id": "ru-id06988",
      "tag": "p",
      "target_sha256": "b2a577693cc3a7b982f1a9c431e93cffd41547677de1d90b2ae3018a4b717dca"
    },
    {
      "source_id": "id06989",
      "target": "— Вот я и хочу, — сказал Мазарини со своей тонкой улыбкой, — не дать им быть неблагодарными ко мне.",
      "source_sha256": "c0f1020dc9839a62615c03b1743a4e90c9c37129fcf77302e3de774d7e197fbe",
      "target_id": "ru-id06989",
      "tag": "p",
      "target_sha256": "9a022bf2f6baaafc76a49ec36eddf75490dc1b21a7896f27ed2912ad7ae71224"
    },
    {
      "source_id": "id06990",
      "target": "— Это христианское милосердие, — сказал д’Артаньян, — не вводить ближнего во искушение.",
      "source_sha256": "0d7cf599f924307f4bc6c125b49ec68013cc4a789de0b8e18e3c5888f5fbf189",
      "target_id": "ru-id06990",
      "tag": "p",
      "target_sha256": "dad68f6dece8ec98e152d41ec7d14c27b31ff284e833c8ede7c4d107bfa49af1"
    },
    {
      "source_id": "id06991",
      "target": "— Именно поэтому, — сказал Мазарини, — я и хочу уехать раньше их.",
      "source_sha256": "8518a3f0fdc4e18012e4803b574f2d22567a49b56f7665135e7867f536e8f2e0",
      "target_id": "ru-id06991",
      "tag": "p",
      "target_sha256": "6017a80e9c9e256f24b103665e74f65f34b55420526d9170aabb48387c602500"
    },
    {
      "source_id": "id06992",
      "target": "Д’Артаньян улыбнулся: он был человек, способный прекрасно понять эту итальянскую хитрость.",
      "source_sha256": "56c3fd9fe109e45ce1c3c528f224a8c3bd5b12ec81d4393a631c1b9b47620346",
      "target_id": "ru-id06992",
      "tag": "p",
      "target_sha256": "913fe055bd8a42125da92973f6c5e7c46f78f06d6ac93cda08f358e1fc4989e2"
    },
    {
      "source_id": "id06993",
      "target": "Мазарини увидел его улыбку и воспользовался минутой.",
      "source_sha256": "0e586bb5f1c293767d15377e2d8bf13fca85500f09cb9edef7542960b1c6cd9e",
      "target_id": "ru-id06993",
      "tag": "p",
      "target_sha256": "b72ee89d93e74a8dfa85baf1542e5ad3ef74cc6f0ead9e64de23df1db1909c1c"
    },
    {
      "source_id": "id06994",
      "target": "— Итак, вы начнёте с того, что прежде всего выведете меня из Парижа, не так ли, мой дорогой <i>мосье</i> д’Артаньян?",
      "source_sha256": "d248a704c6ba8de9dd85ac5f44095f2be1ce2f8db4ae08850a252d4f6f08a728",
      "target_id": "ru-id06994",
      "tag": "p",
      "target_sha256": "57cc1c76ef32c248a0e82165e77a44e7106f3a1f0c74be8ef35b9f37bfb95047"
    }
  ],
