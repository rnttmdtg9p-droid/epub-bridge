{
  "unit": 54,
  "batch": 6,
  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id07035",
      "target": "— Ну что ж, ладно, я полагаюсь на вас.",
      "source_sha256": "250466abc7980bf57d301d4389ad82d0f4123e8375a882ee1417962632536fbd",
      "target_id": "ru-id07035",
      "tag": "p",
      "target_sha256": "e004351ee90e65c1563d8126f1af033077ff8b8ae74afaabef5c1d73863cec4a"
    },
    {
      "source_id": "id07036",
      "target": "— Наконец-то, — сказал себе д’Артаньян.",
      "source_sha256": "a8bb0213764c96c69ba524ca8590576794c6b1257fbd5cedf5e4d8f119223525",
      "target_id": "ru-id07036",
      "tag": "p",
      "target_sha256": "91a7207d5e1fe02aa73b4cc23e1930bd1b6b28f4e2dcbddfbd2bc1fe98d18bbf"
    },
    {
      "source_id": "id07037",
      "target": "— Итак, вы будете здесь в половине десятого.",
      "source_sha256": "04976d093beecf84b1f3fc19c818db95047c9bc2b3fa6205f819a9a74b6298bd",
      "target_id": "ru-id07037",
      "tag": "p",
      "target_sha256": "490320cc03b6ee87b05161b8df65b83ca24c618c3a4132d706fe930b04a469c4"
    },
    {
      "source_id": "id07038",
      "target": "— И я найду Ваше Преосвященство готовым?",
      "source_sha256": "97a4fef1da51ce577c4c734d6a965839e93dc5d95c9865434d224dbc9a55edc9",
      "target_id": "ru-id07038",
      "tag": "p",
      "target_sha256": "b475d51fbab3dfecaae1e43af0dd8ad26345cae41ddb9a0cb775e63770f30acb"
    },
    {
      "source_id": "id07039",
      "target": "— Разумеется, совсем готовым.",
      "source_sha256": "ec6de7839f2a9f01ab52d2f757cacde3addc965cb71e7585c5472a10a5b2daac",
      "target_id": "ru-id07039",
      "tag": "p",
      "target_sha256": "2575e4447dd9d8957c93bc6a04206b61c86e9786b01661798fdba7b672640305"
    },
    {
      "source_id": "id07040",
      "target": "— Тогда всё решено. А теперь не угодно ли Монсеньеру проводить меня к королеве?",
      "source_sha256": "bafedff41eee1f6b5d4dd0cc1b11c9e20081cb9525e128427b829fa932ea8d6e",
      "target_id": "ru-id07040",
      "tag": "p",
      "target_sha256": "fd261edb927e21a7f96b7a5f401176578d837a5f59b38b82a1bf200f6906836d"
    },
    {
      "source_id": "id07041",
      "target": "— Зачем это?",
      "source_sha256": "3c8987db231fbe6ab97b1d8a9738f1714b22df8dc5c7a4bb47938b9dbfbbbb58",
      "target_id": "ru-id07041",
      "tag": "p",
      "target_sha256": "afc65d18537fbe3e971ffb2897c7064d8cf21095343c4c0331e1f91ee5c6e1c2"
    },
    {
      "source_id": "id07042",
      "target": "— Я желал бы получить приказания Её Величества из её собственных уст.",
      "source_sha256": "e6c4ad1d302903f5aa6b4abc31e01f1ec79bcb2db6052660f72c2c0041fdde32",
      "target_id": "ru-id07042",
      "tag": "p",
      "target_sha256": "cbcb86b581b59c59758f4d92e0421163bb25ea4bcf0ed626c4c07f36b298392c"
    },
    {
      "source_id": "id07043",
      "target": "— Она поручила мне передать их вам.",
      "source_sha256": "c9bd7b85cd1f31e2b62246cfd9671cd77845bd09915e28a8ac740502c5e0e9c1",
      "target_id": "ru-id07043",
      "tag": "p",
      "target_sha256": "1e10a17ff970ab6eff49d2b0bc609353e29eb6def07e1054710e70a53c852582"
    },
    {
      "source_id": "id07044",
      "target": "— Она могла что-нибудь забыть.",
      "source_sha256": "3a468a1f9b42d8fc72ab8bc152b21be653fe700efb38d2eb0b1af892912ca009",
      "target_id": "ru-id07044",
      "tag": "p",
      "target_sha256": "6e8a334513f48b2ec0ff13f357414bf1811acad5c03c4be09b992115e3180dd7"
    },
    {
      "source_id": "id07045",
      "target": "— Вы настаиваете на том, чтобы её увидеть?",
      "source_sha256": "1eed329bddffd0df6ad769c396ecf2f73926ae8ff6014d3896db20e9ad7aaf6b",
      "target_id": "ru-id07045",
      "tag": "p",
      "target_sha256": "0627c72a85a8b0fcea3863e591d821f0df6c7447fa80489a293b26b7c70eb586"
    },
    {
      "source_id": "id07046",
      "target": "— Это необходимо, Монсеньер.",
      "source_sha256": "796afe0de1f6d7f53b76fdf8586d0a61886ec497954b130e3dc857d3bf96f6b5",
      "target_id": "ru-id07046",
      "tag": "p",
      "target_sha256": "6d1f915dc6d4a5141d41a92fb255981b774367ccd02c547e99046f07f0712616"
    },
    {
      "source_id": "id07047",
      "target": "Мазарини минуту поколебался; д’Артаньян остался невозмутимо тверд в своём желании.",
      "source_sha256": "04215daa8c3229d89c2690c931e1a29d9a342f40934be85d0636e2e36df16385",
      "target_id": "ru-id07047",
      "tag": "p",
      "target_sha256": "ad7e55a8c95b9858c94a1261a8b970fab4daac3a0176d4ac703c4022e5f794e1"
    },
    {
      "source_id": "id07048",
      "target": "— Ну хорошо, — сказал Мазарини, — я провожу вас, но ни слова о нашем разговоре.",
      "source_sha256": "8334265ba16fa6a7e01d853fca6e1669bd3e007ccda0647046dbcae8b1ca8937",
      "target_id": "ru-id07048",
      "tag": "p",
      "target_sha256": "43c402d3b3b59f3e4e7d32cf07a932bc423048b871328fe2b7a66332297447de"
    },
    {
      "source_id": "id07049",
      "target": "— То, что было сказано между нами, касается только нас, Монсеньер, — ответил д’Артаньян.",
      "source_sha256": "58af9a46a2445aee0d0175653c8f74bb66d00e08617b74eac81dac929382b62a",
      "target_id": "ru-id07049",
      "tag": "p",
      "target_sha256": "00bea5115b3786b7195c770fdb3cdfc7a1e40c8cf958c0cbf89bf8f91e59583d"
    },
    {
      "source_id": "id07050",
      "target": "— Вы клянётесь молчать?",
      "source_sha256": "043aed77cf1823a8ebb7dca4c34330da5fd4f8b8af035cb23b6cf33c9fa9f615",
      "target_id": "ru-id07050",
      "tag": "p",
      "target_sha256": "235b51d7b5665e52d62dfd447d17a5de0a1368fbf908531a41e1794d0d5cd683"
    },
    {
      "source_id": "id07051",
      "target": "— Я никогда не клянусь, Монсеньер. Я говорю «да» или говорю «нет», и, поскольку я дворянин, я держу слово.",
      "source_sha256": "0214e30a06db566499c3cc7bc4efbfb3a585b83239e64f134315200ef99fb5d9",
      "target_id": "ru-id07051",
      "tag": "p",
      "target_sha256": "74eaa277f9f72d148afad8b561e74f4f4dd1e4d2269b66863e4aacca588f1bd7"
    },
    {
      "source_id": "id07052",
      "target": "— Что ж, вижу, мне придётся довериться вам безо всяких оговорок.",
      "source_sha256": "df99ff2bd9257c8776594838901a11df5fbeabbb89ae2fbfe5d585646c3dca9b",
      "target_id": "ru-id07052",
      "tag": "p",
      "target_sha256": "4ae3300cbff37ecedf1c99b2ba0ed40c39f8364b99500ae596290ae0aaa3d271"
    },
    {
      "source_id": "id07053",
      "target": "— Это лучшее, что можно сделать, поверьте мне, Монсеньер.",
      "source_sha256": "bd6ab3fc797a8dac7e38e2c0dbfd2615e801bb6d10acdd573308ffaaf18547e0",
      "target_id": "ru-id07053",
      "tag": "p",
      "target_sha256": "086f52f687196e67b8291a6a049e4a5b00f8c270f40b8c05c0a349ba4088c563"
    },
    {
      "source_id": "id07054",
      "target": "— Идёмте, — сказал Мазарини.",
      "source_sha256": "27c8f99efd1720450e9c4af15476cd3df4ec7c2cd57cfd9412fed9c5305c441a",
      "target_id": "ru-id07054",
      "tag": "p",
      "target_sha256": "f18314d0aafbb82c3183ef977537899e553b38e36f8071c2aa1e70ab3d241a08"
    }
  ],
