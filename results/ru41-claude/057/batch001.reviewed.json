{
  "unit": 57,
  "batch": 1,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "id07627",
      "target": "— А проклятый итальянец?",
      "source_sha256": "295f050bb086d6b18acaa574e2d090e6c8d706b4148eeb9daad4a538d9d6200f",
      "target_id": "ru-id07627",
      "tag": "p",
      "target_sha256": "917c4c0c13f9f34c1e4e7eb27bfc1dc43e52a79d685c6bae4722e7b8db64378e"
    },
    {
      "source_id": "id07628",
      "target": "— Бодрствует. Так что держитесь крепко: если они уехали, то уж наверняка неспроста. Но поскольку в конечном счёте вы сильнее, — продолжал д’Артаньян, — не изводите женщин и стариков, а вините истинные причины.",
      "source_sha256": "7301a128f9173fc5adebdf3bdffb4ea7ea9c76a4bb0e51ff2cb1a0422e8af26b",
      "target_id": "ru-id07628",
      "tag": "p",
      "target_sha256": "c1991a83f6f07790aa83c4d1f8d989fc788d4b1ac8640cff5c60c1c36db59da8"
    },
    {
      "source_id": "id07629",
      "target": "Народ выслушал эти слова с удовольствием и пропустил дам, которые поблагодарили д’Артаньяна красноречивым взглядом.",
      "source_sha256": "01b400a8d59896c5ba4e45897d4467606443f44dc644ce857cec24f6f5bcbe2b",
      "target_id": "ru-id07629",
      "tag": "p",
      "target_sha256": "58aff1ea03e99444b42eb3c8cd69a466eb1b549a60f93e2a222e7d8410d1f411"
    },
    {
      "source_id": "id07630",
      "target": "— А теперь вперёд! — сказал д’Артаньян.",
      "source_sha256": "63ad8430cb65a59c12ae6a6324068eecb95182b98c2c2358e8a0246b1e5a9bbe",
      "target_id": "ru-id07630",
      "tag": "p",
      "target_sha256": "729d423a09f1cc1ac96e992775beb15a1fd745a48f2cdda558af14d7b0591922"
    },
    {
      "source_id": "id07631",
      "target": "И они продолжили путь, минуя баррикады, перешагивая через цепи, толкаемые, расспрашиваемые и сами расспрашивающие.",
      "source_sha256": "b429c902de8613f614679e7e968909c683e9dd757c7cfe5007057170ad1d9e32",
      "target_id": "ru-id07631",
      "tag": "p",
      "target_sha256": "9d86411342ffbb69ed336a7f169345bb98c32c10335791423fdb9d88b380180a"
    },
    {
      "source_id": "id07632",
      "target": "На площади Пале-Рояля д’Артаньян увидел сержанта, который обучал строю пять или шесть сотен горожан: это был Планше, употреблявший на пользу городской милиции свои воспоминания о Пьемонтском полке.",
      "source_sha256": "a7989fb15f6253bfe9c3ee0576981a85ea513be75f687f3c937faf1e1b6b95a9",
      "target_id": "ru-id07632",
      "tag": "p",
      "target_sha256": "80446119e644a4a912216b4463f9e664ead7ff17d3ecd709114c6bce6b8d07bc"
    },
    {
      "source_id": "id07633",
      "target": "Проходя мимо д’Артаньяна, он узнал своего прежнего хозяина.",
      "source_sha256": "71eb5b5646410de006feb29f0d572d34775a6fe0bdc97b5c857bb23afaca021f",
      "target_id": "ru-id07633",
      "tag": "p",
      "target_sha256": "146ae0e8c41267c5230a778edd7c04674042749b908a3a590a3ea72c7055cd11"
    },
    {
      "source_id": "id07634",
      "target": "— Здравствуйте, господин д’Артаньян, — сказал Планше с гордым видом.",
      "source_sha256": "92b727664a0bc7a77600f0ff3abc9d56058638aa27f30f8b7a5bb9e74300be6c",
      "target_id": "ru-id07634",
      "tag": "p",
      "target_sha256": "e86452a53a73482420e2e36b2e4c0b1b87b41f663092dcc3508256c677c48e9b"
    },
    {
      "source_id": "id07635",
      "target": "— Здравствуйте, господин Дюлорье, — ответил д’Артаньян.",
      "source_sha256": "18c3d91f65b680aae27dd98c34e22219c3b281f050bee7e7084281edb8f26a61",
      "target_id": "ru-id07635",
      "tag": "p",
      "target_sha256": "3f00648c3e4c43147e7aca221eaea14074645f16ec27c0b459c78620064063ff"
    },
    {
      "source_id": "id07636",
      "target": "Планше как вкопанный остановился, уставив на д’Артаньяна огромные ошеломлённые глаза; первый ряд, видя, что его начальник остановился, остановился в свою очередь, и так далее до последнего.",
      "source_sha256": "05bb803b9163d52911d5ac61e5c0071f8a81d8c01f59f0ecb2ca65e5f6f495f9",
      "target_id": "ru-id07636",
      "tag": "p",
      "target_sha256": "64fcfa037e6c5300b332b98469fcf25e38c5e22492bb7b54981e0f0d0bbc55ee"
    },
    {
      "source_id": "id07637",
      "target": "— Эти горожане до ужаса смешны, — сказал д’Артаньян Портосу.",
      "source_sha256": "ef3590a354854d373c8e18fc3807666e6fda4fda5790834a6a4ba9b5012028de",
      "target_id": "ru-id07637",
      "tag": "p",
      "target_sha256": "52bdbee846041ecda5721f581502ed867b9b9e42310847eaec8bfab4cbd4331a"
    },
    {
      "source_id": "id07638",
      "target": "И он продолжил свой путь.",
      "source_sha256": "d118ed67f91bfd13d962ed4337bc3ed7c9bb6cdad4fcd9856ed2fa56586f3b2b",
      "target_id": "ru-id07638",
      "tag": "p",
      "target_sha256": "d5fa6ae9e774dd10f544dcb3f05e2abf75baebe98da78762e7df6e2c14a36414"
    },
    {
      "source_id": "id07639",
      "target": "Пять минут спустя он спешился у гостиницы «Козочка».",
      "source_sha256": "2a1d412fea92fdbcee00e5eca992a7247045079ada9e3f6871054430580a664b",
      "target_id": "ru-id07639",
      "tag": "p",
      "target_sha256": "d0ce260e15123cc16bc092839f087f14cfe5eedea0afc817f2317f7c4ce340a4"
    },
    {
      "source_id": "id07640",
      "target": "Прекрасная Мадлен бросилась навстречу д’Артаньяну.",
      "source_sha256": "1589b0a6d0c0e0eaa5b3ae37e7b68b0ca504684d5007889835a9ba61223c013a",
      "target_id": "ru-id07640",
      "tag": "p",
      "target_sha256": "40debe1df5730ed97da5c71d213028bd07d333c5182058721a6ccadee6828e3b"
    },
    {
      "source_id": "id07641",
      "target": "— Любезная госпожа Тюркен, — сказал д’Артаньян, — если у вас есть деньги, поскорее зарывайте их, если у вас есть драгоценности, спрячьте их без промедления, если у вас есть должники, требуйте с них платы; если у вас есть кредиторы, не платите им.",
      "source_sha256": "2e90e15011c38849ffb14d5ce0e6ced16ed94bfaa8d78f2f1cd3daddf241e984",
      "target_id": "ru-id07641",
      "tag": "p",
      "target_sha256": "9b6a95bbccd7087b093b81b3fefe47d3db9286a181ca1628b07edad354aed8a0"
    },
    {
      "source_id": "id07642",
      "target": "— Почему же? — спросила Мадлен.",
      "source_sha256": "2048c64f648caf0aed317cf73b7b1293638138167c05be3ecf111c306a76a523",
      "target_id": "ru-id07642",
      "tag": "p",
      "target_sha256": "75941d4211e4a4e5aa9d16bc46007705ced52e033c0fbe910c308e5607f007bc"
    },
    {
      "source_id": "id07643",
      "target": "— Потому что Париж будет обращён в пепел, ни дать ни взять как Вавилон, о котором вы, без сомнения, слышали.",
      "source_sha256": "e5ca8588c931642562c40c4f45ca983f90eb7dfc1eb0384ce92dd874ffb520df",
      "target_id": "ru-id07643",
      "tag": "p",
      "target_sha256": "b86de7ef1b40cb8f9d000ba25e776337ac8590a9d3421e5cfe9f31c603495b92"
    },
    {
      "source_id": "id07644",
      "target": "— И вы покидаете меня в такую минуту?",
      "source_sha256": "0e5fc02ff3bc8f0189441b05faae0c4818657c2052a549184bcfa98ef1a90984",
      "target_id": "ru-id07644",
      "tag": "p",
      "target_sha256": "a3ab85b43da0cde19f0aff9aaa1113a732d07a50f3e2343d72d3dbab1cb5268d"
    },
    {
      "source_id": "id07645",
      "target": "— Сию же минуту, — сказал д’Артаньян.",
      "source_sha256": "6e32c8990497479402793cc6fb0c2820f2a379c3f55291478eae32ba1ff93917",
      "target_id": "ru-id07645",
      "tag": "p",
      "target_sha256": "8dffea85eb7d3d47f11842b4f91354fa477550f1fb024876d907b6395b385ce3"
    },
    {
      "source_id": "id07646",
      "target": "— А куда вы едете?",
      "source_sha256": "8ccdde5b931cf154af5a1b8397f1abe54dd2ec0e7cfe40fd6d57c7618743f4e4",
      "target_id": "ru-id07646",
      "tag": "p",
      "target_sha256": "37200427915a47c94113ec4ef11daefe057f52381b0c8af0773137737af8d41a"
    }
  ],
