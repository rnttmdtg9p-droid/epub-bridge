  "state": "SOURCE_ALIGNED_AI_REVIEW_AND_CORRECTION_COMPARISON_COMPLETE_PENDING_BOOK_QA",
  "rows": [
    {
      "source_id": "id12168",
      "target": "— Дальше, сударыня?..",
      "source_sha256": "900f723c0b29eb41cfd6f1dcf914c65829f3404fe8c5bd17c6cb496b089250fc",
      "target_id": "ru-id12168",
      "tag": "p",
      "target_sha256": "b80c7146874401331ad7943e3abb01900014e7072d36fce040e25958080c2347"
    },
    {
      "source_id": "id12169",
      "target": "— Да.",
      "source_sha256": "9f4a2e0ce3c8b67038a54bfa044334c55d6f083e8cb634d6147afc7307b16a6f",
      "target_id": "ru-id12169",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    },
    {
      "source_id": "id12170",
      "target": "— Это всё.",
      "source_sha256": "4f84cd240977270b1e84551bde884d179ad0d3a7c051547f385b65bc1226c7e9",
      "target_id": "ru-id12170",
      "tag": "p",
      "target_sha256": "320e1e3647ee82633ce827743765b0c01fb28a16de23a618dd34201076fbc4c9"
    },
    {
      "source_id": "id12171",
      "target": "— Разве у вас нет четвёртого товарища?",
      "source_sha256": "1e5a6e5fa86fbb7fb0405765eb7fcea2e16e2133b04ffc80c5e3f6c272b520c3",
      "target_id": "ru-id12171",
      "tag": "p",
      "target_sha256": "762e8d88e945dca2d0f468302d3c51f54e93e84cc849687e46bca0552ac13d75"
    },
    {
      "source_id": "id12172",
      "target": "— Есть, сударыня: господин граф де Ла Фер.",
      "source_sha256": "8a94a4128ccd79cd42d1d1d395bb62842d6c98c286f00adc108a6127a53b75fc",
      "target_id": "ru-id12172",
      "tag": "p",
      "target_sha256": "290e7d5a04f3b13233447a905fcd9319271ecc23ed1d43be8d1ba08381a2f281"
    },
    {
      "source_id": "id12173",
      "target": "— Чего он просит?",
      "source_sha256": "a878972a7ae7d6e7d97a6cf95ba5d5ab24c058e297cb9bd221aadf91c5e9ef3e",
      "target_id": "ru-id12173",
      "tag": "p",
      "target_sha256": "2af695ab066be0119a0b421b4adb4ac91f8e2aca068263a669f998b829ad8fd4"
    },
    {
      "source_id": "id12174",
      "target": "— Он ничего не просит.",
      "source_sha256": "506b197243f659334bf0eac4d081918fbed7f529015699c6a0daeafb390ffd6f",
      "target_id": "ru-id12174",
      "tag": "p",
      "target_sha256": "aaa9e1020aa0a836aca14f779f1207e9a142eb32971f944f9c348df49adf73de"
    },
    {
      "source_id": "id12175",
      "target": "— Ничего?",
      "source_sha256": "2f7f47e1859ddf58c8d1895fd4c7425cba25e6df7945727c9d80e2d7726e2d14",
      "target_id": "ru-id12175",
      "tag": "p",
      "target_sha256": "8b0087fe7e16a5a06074026e5c5ee6bdc9253877e9b8f0868b4b8ca165786277"
    },
    {
      "source_id": "id12176",
      "target": "— Нет.",
      "source_sha256": "ac641d7ffd6b132ddcd7d7944dc3ccc96acf3113cab60712c9516858cbfdaab2",
      "target_id": "ru-id12176",
      "tag": "p",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "id12177",
      "target": "— Есть на свете человек, который, имея возможность просить, не просит?",
      "source_sha256": "c15350e0c340b5176765c4255754da050f004fd1fdb8859bb73fdbdc9511ffce",
      "target_id": "ru-id12177",
      "tag": "p",
      "target_sha256": "de22b5628ca07940496d52c2a1acdd7fb0e12e75ecb1fac67d667c66b6d72b43"
    },
    {
      "source_id": "id12178",
      "target": "— Есть господин граф де Ла Фер, сударыня; господин граф де Ла Фер не человек.",
      "source_sha256": "104f29aa5650879327942f12ed44211236a92fdcae47939321f3733e83faa412",
      "target_id": "ru-id12178",
      "tag": "p",
      "target_sha256": "671f4df0387da53bcf313939586edddffd0d0597e92317b8772b74d9964efb29"
    },
    {
      "source_id": "id12179",
      "target": "— Кто же он?",
      "source_sha256": "e3c7fd2a7619a907e9ebe8be4a51cf726678a0a60e0926928bf045dca49140c3",
      "target_id": "ru-id12179",
      "tag": "p",
      "target_sha256": "4a48725832b06a564b66a15484166ad58eca9dd8ecfafd0c05d200b216826d89"
    },
    {
      "source_id": "id12180",
      "target": "— Господин граф де Ла Фер — полубог.",
      "source_sha256": "b9ad2b5b3465c8a6f2c67ca1e6a8cf2145e8e22605d40ab825ac6055a3c6864e",
      "target_id": "ru-id12180",
      "tag": "p",
      "target_sha256": "a77b1b1fc183457de20d99b109bebd2673bb59e1fbe5e9bdb80b6ccc8ca9194a"
    },
    {
      "source_id": "id12181",
      "target": "— Нет ли у него сына, молодого человека, родственника, племянника, о котором мне говорил Коменж как о славном юноше и который вместе с господином де Шатильоном привёз знамёна Ланса?",
      "source_sha256": "5408461b1866fea536fda5af3ab53e86dc5d19d0b7a2d1a49c37ab8f4db13b02",
      "target_id": "ru-id12181",
      "tag": "p",
      "target_sha256": "1989bc11580ea040e39089a3c3070dcf52fba79534fdf5a5996b0a75af6f87ad"
    },
    {
      "source_id": "id12182",
      "target": "— У него есть, как говорит Ваше Величество, воспитанник, которого зовут виконт де Бражелон.",
      "source_sha256": "bb3ad04741d0a021654a7f68e15c5d8e68e1485f38cd733e36e811791231e044",
      "target_id": "ru-id12182",
      "tag": "p",
      "target_sha256": "4b27f8ea1e1d272d3e40d84824c695014807bc41e26689d3e54adf672635e4be"
    },
    {
      "source_id": "id12183",
      "target": "— Если бы этому молодому человеку дали полк, что сказал бы его опекун?",
      "source_sha256": "23a33f27b01bb719e253fa294d14bffc4cd5fe3d1554b825385958ddea5f7e11",
      "target_id": "ru-id12183",
      "tag": "p",
      "target_sha256": "f1af5b0b9987e5cb46128e7fa01a56a5d2b0baa978169510e5d9b5ab41ea5515"
    },
    {
      "source_id": "id12184",
      "target": "— Быть может, он согласился бы.",
      "source_sha256": "55ec4da9e9b6fecd100f4bf9b7cb99fa0001d6fdf229e6bf52bd0df7bcedd679",
      "target_id": "ru-id12184",
      "tag": "p",
      "target_sha256": "31fd0f17545a4cd6c765d7d8ffb16adab5886c3bcfcb717b82487d9f675eaa62"
    },
    {
      "source_id": "id12185",
      "target": "— Быть может!",
      "source_sha256": "144cb4aebcee8bc921beba9ba80bb9bbd50938c5eac7e35ef2e3fbe2e2cdcb32",
      "target_id": "ru-id12185",
      "tag": "p",
      "target_sha256": "23ff5718098e613d3aab548d793876ce30bf6373d8c8be6d9690478794a0d70c"
    },
    {
      "source_id": "id12186",
      "target": "— Да, если бы Ваше Величество лично попросило его согласиться.",
      "source_sha256": "e1c18f4ecb860c9155a996603ed34e303af3905f1ada6759b1d372fe610a2d2f",
      "target_id": "ru-id12186",
      "tag": "p",
      "target_sha256": "4a53160aab24d6f38eec12e10a58964ff391fed082d65f2d9790b7abb66ee130"
    },
    {
      "source_id": "id12187",
      "target": "— Вы сказали верно, сударь: это странный человек. Что ж, мы подумаем об этом и, быть может, попросим его. Довольны ли вы, сударь?",
      "source_sha256": "5edba21fd55bdbe3aadde0bbfc2b9426d98495347ca5ca3b93b2063312398329",
      "target_id": "ru-id12187",
      "tag": "p",
      "target_sha256": "eda170ccf544799d5942352ba6bbaf3e8a3658ce528c46e6a979a8f3a0b4fff7"
    }
  ],
