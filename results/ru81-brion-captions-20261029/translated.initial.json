{
  "state": "INITIAL_CLAUDE_TRANSLATION_ONLY_PENDING_COMPLETE_INDEPENDENT_REVIEW",
  "utc": "2026-10-29T00:06:02.425403+00:00",
  "rows": [
    {
      "source_id": "fr81-brion201-caption",
      "target": "Это был Наполеон, всё ещё пытавшийся идти вперёд.",
      "source_sha256": "97fc1f20e899fe80dcf02880ddb137fc5996a80c2fc096aee9cd235cc0f63157",
      "target_sha256": "f26e025cef2b7a19de76227ce916c59771c21504d6529e2d5fee0079d2509d97"
    },
    {
      "source_id": "fr81-brion202-caption",
      "target": "Он проходил как бы по какому-то жуткому смотру мертвецов. Он шёл, ступая по крови.",
      "source_sha256": "53d5a0994ecdc5219335f8e5947f41aff02ecb577d3170b1e91e7bede8d704d2",
      "target_sha256": "ba2e06ff235d676065b6bbd7b478637bc68b779808cbbcb0ec18aa3318f502f8"
    },
    {
      "source_id": "fr81-brion218-caption",
      "target": "Ребёнок не испугался.",
      "source_sha256": "5d8551a67985c93857b1c0d52d44c621cf0eb523e8b62584ea619c8c38f41c99",
      "target_sha256": "9a6863b7bfeeab43388a959869dfe956cac4c6835d3f892823570e3dadffa049"
    },
    {
      "source_id": "fr81-brion273-caption",
      "target": "Это и есть вечное поклонение.",
      "source_sha256": "2fa2b6f4fcb4dbac9c9c84be76d24a76dbb64b66c23e20c5b32028d97f5c9b54",
      "target_sha256": "b08f650b99a997abe0d3a7f1d5f6d5d81b721d069bae40cfb87f2789c87539a6"
    },
    {
      "source_id": "fr81-brion313-caption",
      "target": "Фошлеван взял лопату, а Жан Вальжан — кирку.",
      "source_sha256": "e9c696e27d3e70d0e2a5114b7cd55c581516dba31ecc1efd4a16eb2a8dc770e4",
      "target_sha256": "fbb260bc353d64bcc67d26d426548f64fae80da26bfa153c3b95d06e3d21344a"
    },
    {
      "source_id": "fr81-brion369-caption",
      "target": "Он встал с постели…",
      "source_sha256": "f05fe4ee04b6c9ae834734e58357a5cfd48d52566162c648ffb4b522e42b3579",
      "target_sha256": "578066d85ee7ff983fe3f5ce9b055d2bdb21ee1d470f32b45513c105580da3fa"
    },
    {
      "source_id": "fr81-brion522-caption",
      "target": "Старик принял удар.",
      "source_sha256": "80321779fbf1927d9b78ec4269aadd00023d513bb9dd7912e37d44dd375eaffc",
      "target_sha256": "03e0cd37938614b94d37c80bda76b0c79ad69191d645cae8835c98844f136946"
    },
    {
      "source_id": "fr81-brion553-caption",
      "target": "Это был слон высотой в сорок футов.",
      "source_sha256": "031203737d1bd1abf55c28456ec58380cbe388553f9d0644689749c5d4b1a93a",
      "target_sha256": "78967a8a6732b8f18c3d2e324e6eb7607b772581b59563060280fa1e872be510"
    },
    {
      "source_id": "fr81-brion562-caption",
      "target": "… одним прыжком перемахнули через пропасть.",
      "source_sha256": "db9a35fb400b7edbdffb8165b2cce0e425b24f8ebaf36a91b662f335614bf387",
      "target_sha256": "0f50a04ecae0f337b68b3dabe8e866e7836884bce04aeb4155b3da9cc3c8fbc0"
    },
    {
      "source_id": "fr81-brion642-caption",
      "target": "Он схватил Кабюка за волосы.",
      "source_sha256": "282f3cf7c622e08d5aac6a08a5e2688e81e18a270824524304dbc50485b3ac9e",
      "target_sha256": "010dd4cfe7b1bf8634c4fe6d717cc09dcce88b6310f662f70c327c74cc64d03c"
    },
    {
      "source_id": "fr81-brion650-caption",
      "target": "Она ещё попыталась улыбнуться и испустила дух.",
      "source_sha256": "88562fe264c462a50765368c1c1569faffe51dee1cc1429a7ef51e32ec4f539c",
      "target_sha256": "19171459e5ffaeabcb4482fb517b752af1606ffd8301c1b3eeb01f6c877f78e0"
    },
    {
      "source_id": "fr81-brion705-caption",
      "target": "Обе руки Мариуса обвивали его шею.",
      "source_sha256": "c8f7e666940fc0806c8d2f31b348ba0ddeb1d6c7e346b3ad647e753128206679",
      "target_sha256": "73fcf9e6b8aec9f4e725f2c37bf473741b8c3bfe62653f9e4f1d587d930d5f53"
    },
    {
      "source_id": "fr81-brion714-caption",
      "target": "Жавер осмотрел его и узнал.",
      "source_sha256": "f513d437bf9a0fe363471c42e7f2339e13d8ab6d76db1be50ada8be3b730ad86",
      "target_sha256": "6890c528fef79d076a1326c3e814e0aef22ae74a25f1a84e9353c1f03f4fc776"
    },
    {
      "source_id": "fr81-brion730-caption",
      "target": "Мгновение спустя высокая чёрная фигура появилась, стоя на парапете.",
      "source_sha256": "e3e7ef6c2ecd7cd6cb896a1b97ef610bec75d95e7981ea9e1c3be918239329e7",
