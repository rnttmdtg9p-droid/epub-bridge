  },
  "rows": [
    {
      "source_id": "ru77-art-caption-03-047",
      "target": "СЭР АРТУР ВЗЯЛ ЕГО ЗА РУЧКИ.",
      "source_sha256": "d1a38522932401e11d935cf9bab5eb2cdd63b7360ce9ea840d29120081819965",
      "target_id": "ru-ru77-art-caption-03-047",
      "tag": "figcaption",
      "target_sha256": "dd41dfaf9a63a3d0c5ae57a7a57d7e32e9d60cc09caf049182aeb12d74b9df57"
    },
    {
      "source_id": "ru77-art-caption-02-035",
      "target": "ХВАТИТ; Я СКАЗАЛ, ПОЛАГАЮ, ВЫ ПАЦИЕНТ.",
      "source_sha256": "088fe2e17be79818fb0f5f828fb095787d7bec22e3a5441e29fbcb89af0e2e14",
      "target_id": "ru-ru77-art-caption-02-035",
      "tag": "figcaption",
      "target_sha256": "87a4bfa152507dfffbae4bd44221e542012b96d60d33ca8dd6f2e81e6ce78aa8"
    },
    {
      "source_id": "ru77-art-caption-04-056",
      "target": "КОРОЛЕВА ГВИНЕВЕРА БЫЛА СТОЛЬ ЖЕ НАИВНО ЗАИНТЕРЕСОВАНА, КАК И ВСЕ ОСТАЛЬНЫЕ.",
      "source_sha256": "2979920348a307a5abb9e39c4b48ccb92387118630689587a3aee9d6a17142ae",
      "target_id": "ru-ru77-art-caption-04-056",
      "tag": "figcaption",
      "target_sha256": "895b591e32c7a583ce4c184cffe7ae09828278b3d3203205caa6dd1573fd392a"
    },
    {
      "source_id": "ru77-art-caption-05-063",
      "target": "О, ОСТЕРЕГИТЕСЬ! ЭТО УЖАСНЫЕ СЛОВА!",
      "source_sha256": "d3fa1968649afc54fcbae4d60077bd01fc25a27a884a46a96a3805044a299721",
      "target_id": "ru-ru77-art-caption-05-063",
      "tag": "figcaption",
      "target_sha256": "45a801cf6db3831339839a991fd2012957502f3846d7aeb6532ded8a938eea94"
    },
    {
      "source_id": "ru77-art-caption-06-074",
      "target": "ЭТО БЫЛ БЛАГОРОДНЫЙ ЭФФЕКТ.",
      "source_sha256": "1d38bae3e84848c2f27f2033f3e3e7b2fa6305e17cd432a14facdbb453057842",
      "target_id": "ru-ru77-art-caption-06-074",
      "tag": "figcaption",
      "target_sha256": "adb4e0654ecda8ed86a34efe41c1b68076c474bb1f6440208305c78b9b42e1fb"
    },
    {
      "source_id": "ru77-art-caption-06-078",
      "target": "ЗАДУШЕННЫЙ БЛАГОСЛОВЕНИЯМИ.",
      "source_sha256": "55a4b350ed4e29afce36725ac5d161ac42535e9b5f5792da6a27cbf7ee07bb99",
      "target_id": "ru-ru77-art-caption-06-078",
      "tag": "figcaption",
      "target_sha256": "619eff4308a794fc85db686c7ed8f615e59790f8c091422cc5f2d130b0f5b44b"
    },
    {
      "source_id": "ru77-art-caption-07-084",
      "target": "НЕ БЫЛО НИ МЫЛА, НИ СПИЧЕК, НИ ЗЕРКАЛА.",
      "source_sha256": "8d67a48a4937c8b1be88a45979e5ae2004fed782b4defed265ce3926247e3a06",
      "target_id": "ru-ru77-art-caption-07-084",
      "tag": "figcaption",
      "target_sha256": "2c2fbc86c98506f3c3ded93a8725e45aa8d301d462cb66a630ec3dfa416f03f1"
    },
    {
      "source_id": "ru77-art-caption-07-086",
      "target": "БЛАГОГОВЕЙНЫЕ И ПОРАЖЁННЫЕ ТРЕПЕТОМ ТОЛПЫ.",
      "source_sha256": "534f5c80ef6838e55bb0dd39041c90cf3d66a770623ffd838f4c5d881c45382c",
      "target_id": "ru-ru77-art-caption-07-086",
      "tag": "figcaption",
      "target_sha256": "d902a674a2fdde36b3f429bd39ec8ff5a0784b3a57640fc35a8c065d288b6d9c"
    },
    {
      "source_id": "ru77-art-caption-07-090",
      "target": "ТА СТАРАЯ БАШНЯ ВЗЛЕТЕЛА В НЕБО ОБЛОМКАМИ.",
      "source_sha256": "8298744b77bf47428999ffd9eed5c20961b20c3a17c2b4b9cc7fa745cdea0bdc",
      "target_id": "ru-ru77-art-caption-07-090",
      "tag": "figcaption",
      "target_sha256": "6dd42950c992b14d6fdbb7146e30cb9b1ea510daee931aa6a66fd822849010ab"
    },
    {
      "source_id": "ru77-art-caption-08-097",
      "target": "ДА ЭТО ЖЕ БЫЛИ ВСЕГО-НАВСЕГО КРОЛИКИ.",
      "source_sha256": "5a0f0b48b85ece4624a6fe3056355ccab79f7ef6ce6608010617cbcbe3e6cd84",
      "target_id": "ru-ru77-art-caption-08-097",
      "tag": "figcaption",
      "target_sha256": "73635f94444c6b3029ca6c711a8a25b54a82cf50f1e469a81dfed70f7f3bc2b6"
    },
    {
      "source_id": "ru77-art-caption-09-108",
      "target": "ПЕТЬ, ПЛЯСАТЬ, ГУЛЯТЬ КАЖДУЮ НОЧЬ.",
      "source_sha256": "8c6e88fd66bc46be8f850b55c012eb57ad48db81dd81e444c4f99ab866c9c631",
      "target_id": "ru-ru77-art-caption-09-108",
      "tag": "figcaption",
      "target_sha256": "f7588657d44b3926b7837543fd85bf86f4c4eabd17929c600d565f2a59b6000e"
    },
    {
      "source_id": "ru77-art-caption-09-109",
      "target": "ОТРЯДИЛ СМЫШЛЁНОГО СВЯЩЕННИКА И ПРИКАЗАЛ ЕМУ ДОНЕСТИ ОБ ЭТОМ.",
      "source_sha256": "ff335d968f08b81c5218b1693a44fcc5ffc7e46a52a7f0c84c8864efcffa41b7",
      "target_id": "ru-ru77-art-caption-09-109",
      "tag": "figcaption",
      "target_sha256": "dc64101e746703ee2a14e5d27a95c950a7c74169fd74cec6a9c2bbd50b5d93ed"
    },
    {
      "source_id": "ru77-art-caption-10-119",
      "target": "ДЕВЯТНАДЦАТЫЙ ВЕК ГРЕМИТ У НЕГО ПРЯМО ПОД НОСОМ.",
      "source_sha256": "7036e71cb9e0ae704766f59966d4eb1df389c855fafb1b826616b7380f88d9cb",
      "target_id": "ru-ru77-art-caption-10-119",
      "tag": "figcaption",
      "target_sha256": "4f4296dee849a0b1db259b961acaffb1d8fe81671cef562f5a74c0bf097f09b7"
    },
    {
      "source_id": "ru77-art-caption-10-122",
      "target": "ГАРДЕМАРИН ИЗ МОЕЙ МОРСКОЙ АКАДЕМИИ.",
      "source_sha256": "a7d1ad2ffbd951f77ffa61a63c5a7090386ee2c3910251007a103eb420f249b2",
      "target_id": "ru-ru77-art-caption-10-122",
      "tag": "figcaption",
      "target_sha256": "adcc1b0ee416fdde99e6d56c7c94d3b2cf88db94523324ff7c9941126816c4ae"
    },
    {
      "source_id": "ru77-art-caption-11-127",
      "target": "РЕБЯТА ПОМОГЛИ МНЕ, ИНАЧЕ Я НИ ЗА ЧТО НЕ ВЛЕЗ БЫ.",
      "source_sha256": "282e801d3f6d009b32359193a687366ecef8359a7afbe9a8b958e9dc3da9a282",
      "target_id": "ru-ru77-art-caption-11-127",
      "tag": "figcaption",
      "target_sha256": "bafc9013ded1c09b4753ba2f7fec62e4790fa01b3d4b49385a746d2fc27000c4"
    },
    {
      "source_id": "ru77-art-caption-11-128",
      "target": "ТРИ БРАТА В ОПИСАНИИ СЭНДИ.",
      "source_sha256": "483ec1a64f9412a4ff109de8642edc1a721c191af90506584a93e79d17274200",
      "target_id": "ru-ru77-art-caption-11-128",
      "tag": "figcaption",
      "target_sha256": "4508d7538e86780803c75e434da95eeb6b20804e15654eedb74b5f5af1862881"
    },
    {
      "source_id": "ru77-art-caption-13-154",
      "target": "ПО САРКАЗМУ ЗАКОНА И СЛОВА ОНИ БЫЛИ СВОБОДНЫМИ ЛЮДЬМИ.",
      "source_sha256": "8decbece3d6ca5dd1e1c342f0f90b1f2b12b3d0d4c5cd3cafb31d4d199acb066",
      "target_id": "ru-ru77-art-caption-13-154",
      "tag": "figcaption",
      "target_sha256": "5aea18db7c76b640797711ae08aa50cc8f353cf664646ab43cf8aa2e6f6880fe"
    },
    {
      "source_id": "ru77-art-caption-14-167",
      "target": "ДЕЙСТВИЕ ТРУБКИ НА СЭНДИ.",
      "source_sha256": "bee55b52006ef4bc7166cd43c9915cc3e5701a964359fc853fc488c9ff404a03",
      "target_id": "ru-ru77-art-caption-14-167",
      "tag": "figcaption",
      "target_sha256": "701edc9d17786921b047768d28ad6afb90fc6a1f9d3cc6c01386319a566e22d9"
    },
    {
      "source_id": "ru77-art-caption-15-177",
      "target": "СЭР ГАВЕЙН И СЭР УЭЙН.",
      "source_sha256": "017b358cf7ce3b0f75c34dd92ab5c0ebed053396fc6b0aff672c41eefe50230b",
      "target_id": "ru-ru77-art-caption-15-177",
      "tag": "figcaption",
      "target_sha256": "9ee7dfaa1b4f5ecde8f92ec6ec12763d37f28d6e176dce083cca690ea70b67eb"
    },
    {
      "source_id": "ru77-art-caption-15-179",
      "target": "ОСТОРОЖНО, ДЕРЖИТЕСЬ КРЕПЧЕ!",
      "source_sha256": "4f6c720dadaea8a3dbc3187845a4b19ba3cb41fffc5f20c53a35f40d3dd293a9",
      "target_id": "ru-ru77-art-caption-15-179",
