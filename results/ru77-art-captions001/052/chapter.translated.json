    },
    {
      "source_id": "ru77-art-caption-16-192",
      "target": "СЭР КОТ МАЛЬ ТАЙЕ.",
      "source_sha256": "7ae1e424c3ac36d05092ad43347fc9543bfcf8021e39bf8a7abed55f4ec664e9",
      "target_id": "ru-ru77-art-caption-16-192",
      "tag": "figcaption",
      "target_sha256": "cba06940951a9136af07121ca69d92f2635902328867eb178e1b3ea5904cf239"
    },
    {
      "source_id": "ru77-art-caption-16-194",
      "target": "СТРАЖИ ОКЛИКНУЛИ НАС, И ПОСЛЕ ПЕРЕГОВОРОВ НАС ВПУСТИЛИ.",
      "source_sha256": "893ef4cd11a9d3c5238dd103300345b037a93ae482845e90bb323ea880cedcd6",
