      "tag": "figcaption",
      "target_sha256": "2fab19520ac901ef5962f1cc922c8a655467ae18a2aa8011ae943d6ffd3fb120"
    },
    {
      "source_id": "ru77-art-caption-17-208",
      "target": "Я УВИДЕЛ КАРТИНУ, КОТОРАЯ НЕ ВЫЙДЕТ У МЕНЯ ИЗ ПАМЯТИ.",
      "source_sha256": "6050ad93e5d10fb5088e2f236f983fbc709992611ebd75409e04aee64259835e",
