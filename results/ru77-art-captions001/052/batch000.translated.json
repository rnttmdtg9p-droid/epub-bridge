    },
    {
      "source_id": "ru77-art-caption-03-047",
      "target": "СЭР АРТУР ВЗЯЛ ЕГО ЗА РУЧКИ.",
      "source_sha256": "d1a38522932401e11d935cf9bab5eb2cdd63b7360ce9ea840d29120081819965",
