    },
    {
      "source_id": "ru77-art-caption-02-035",
      "target": "ХВАТИТ; Я СКАЗАЛ, ПОЛАГАЮ, ВЫ ПАЦИЕНТ.",
      "source_sha256": "088fe2e17be79818fb0f5f828fb095787d7bec22e3a5441e29fbcb89af0e2e14",
      "target_id": "ru-ru77-art-caption-02-035",
