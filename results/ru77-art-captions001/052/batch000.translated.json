    },
    {
      "source_id": "ru77-art-caption-09-109",
      "target": "ОТРЯДИЛ СМЫШЛЁНОГО СВЯЩЕННИКА И ПРИКАЗАЛ ЕМУ ДОНЕСТИ ОБ ЭТОМ.",
