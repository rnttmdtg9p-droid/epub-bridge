    },
    {
      "source_id": "ru77-art-caption-07-090",
      "target": "ТА СТАРАЯ БАШНЯ ВЗЛЕТЕЛА В НЕБО ОБЛОМКАМИ.",
      "source_sha256": "8298744b77bf47428999ffd9eed5c20961b20c3a17c2b4b9cc7fa745cdea0bdc",
      "target_id": "ru-ru77-art-caption-07-090",
