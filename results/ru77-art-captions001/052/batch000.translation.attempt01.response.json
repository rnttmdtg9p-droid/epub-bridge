      "text": "{\"rows\":[{\"source_id\":\"ru77-u052-heading\",\"target\":\"ВНУТРЕННЯЯ ПЕРЕДАЧА ПОДПИСЕЙ К ИЛЛЮСТРАЦИЯМ, ПАКЕТ 001: ИСКЛЮЧИТЬ ИЗ ТЕКСТА ДЛЯ ЧИТАТЕЛЯ\"},{\"source_id\":\"ru77-art-caption-03-047\",\"target\":\"СЭР АРТУР ВЗЯЛ ЕГО ЗА РУЧКИ.\"},{\"source_id\":\"ru77-art-caption-02-035\",\"target\":\"ХВАТИТ; Я СКАЗАЛ, ПОЛАГАЮ, ВЫ ПАЦИЕНТ.\"},{\"source_id\":\"ru77-art-caption-04-056\",\"target\":\"КОРОЛЕВА ГВИНЕВЕРА БЫЛА СТОЛЬ ЖЕ НАИВНО ЗАИНТЕРЕСОВАНА, КАК И ВСЕ ОСТАЛЬНЫЕ.\"},{\"source_id\":\"ru77-art-caption-05-063\",\"target\":\"О, ОСТЕРЕГИТЕСЬ! ЭТО УЖАСНЫЕ СЛОВА!\"},{\"source_id\":\"ru77-art-caption-06-074\",\"target\":\"ЭТО БЫЛ БЛАГОРОДНЫЙ ЭФФЕКТ.\"},{\"source_id\":\"ru77-art-caption-06-078\",\"target\":\"ЗАДУШЕННЫЙ БЛАГОСЛОВЕНИЯМИ.\"},{\"source_id\":\"ru77-art-caption-07-084\",\"target\":\"НЕ БЫЛО НИ МЫЛА, НИ СПИЧЕК, НИ ЗЕРКАЛА.\"},{\"source_id\":\"ru77-art-caption-07-086\",\"target\":\"БЛАГОГОВЕЙНЫЕ И ПОРАЖЁННЫЕ ТРЕПЕТОМ ТОЛПЫ.\"},{\"source_id\":\"ru77-art-caption-07-090\",\"target\":\"ТА СТАРАЯ БАШНЯ ВЗЛЕТЕЛА В НЕБО ОБЛОМКАМИ.\"},{\"source_id\":\"ru77-art-caption-08-097\",\"target\":\"ДА ЭТО ЖЕ БЫЛИ ВСЕГО-НАВСЕГО КРОЛИКИ.\"},{\"source_id\":\"ru77-art-caption-09-108\",\"target\":\"ПЕТЬ, ПЛЯСАТЬ, ГУЛЯТЬ КАЖДУЮ НОЧЬ.\"},{\"source_id\":\"ru77-art-caption-09-109\",\"target\":\"ОТРЯДИЛ СМЫШЛЁНОГО СВЯЩЕННИКА И ПРИКАЗАЛ ЕМУ ДОНЕСТИ ОБ ЭТОМ.\"},{\"source_id\":\"ru77-art-caption-10-119\",\"target\":\"ДЕВЯТНАДЦАТЫЙ ВЕК ГРЕМИТ У НЕГО ПРЯМО ПОД НОСОМ.\"},{\"source_id\":\"ru77-art-caption-10-122\",\"target\":\"ГАРДЕМАРИН ИЗ МОЕЙ МОРСКОЙ АКАДЕМИИ.\"},{\"source_id\":\"ru77-art-caption-11-127\",\"target\":\"РЕБЯТА ПОМОГЛИ МНЕ, ИНАЧЕ Я НИ ЗА ЧТО НЕ ВЛЕЗ БЫ.\"}]}"
    }
