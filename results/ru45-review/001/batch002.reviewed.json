    {
      "source_id": "045-001-0072",
      "before": "«Моя личная бумага для писем».",
      "after": "— Моя личная почтовая бумага."
    },
    {
      "source_id": "045-001-0073",
      "before": "«Украден».",
      "after": "— Украдена."
    },
    {
      "source_id": "045-001-0074",
      "before": "«Моя собственная печать».",
      "after": "— Моя собственная печать."
    },
    {
      "source_id": "045-001-0075",
      "before": "«Подделка».",
      "after": "— Подделана."
    },
    {
      "source_id": "045-001-0076",
      "before": "«Мою фотографию».",
      "after": "— Моя фотография."
    },
    {
      "source_id": "045-001-0077",
      "before": "«Куплена».",
      "after": "— Куплена."
    },
    {
      "source_id": "045-001-0078",
      "before": "«На фотографии были мы оба».",
      "after": "— На фотографии мы сняты вдвоём."
    },
    {
      "source_id": "045-001-0079",
      "before": "«О, боже! Это очень плохо! Ваше Величество действительно совершило опрометчивый поступок».",
      "after": "— О боже! Это очень скверно! Ваше величество и впрямь совершили неосторожность."
    },
    {
      "source_id": "045-001-0080",
      "before": "«Я был в безумном состоянии — сошел с ума».",
      "after": "— Я был вне себя — безумен."
    },
    {
      "source_id": "045-001-0081",
      "before": "— Вы серьезно подвергли себя риску.",
      "after": "— Вы серьёзно скомпрометировали себя."
    },
    {
      "source_id": "045-001-0082",
      "before": "«Тогда я был всего лишь наследным принцем. Я был молод. Сейчас мне всего тридцать».",
      "after": "— Я был тогда всего лишь кронпринцем. Я был молод. Мне и сейчас только тридцать."
    },
    {
      "source_id": "045-001-0083",
      "before": "— Его нужно вернуть.",
      "after": "— Её необходимо вернуть."
    },
    {
      "source_id": "045-001-0084",
      "before": "«Мы пытались, но потерпели неудачу».",
      "after": "— Мы пытались, но безуспешно."
    },
    {
      "source_id": "045-001-0085",
      "before": "«Ваше Величество должно заплатить. Его нужно купить».",
      "after": "— Ваше величество должны заплатить. Её нужно выкупить."
    },
    {
      "source_id": "045-001-0086",
      "before": "«Она не продаст».",
      "after": "— Она не продаст."
    },
    {
      "source_id": "045-001-0087",
      "before": "«Значит, украсть».",
      "after": "— Тогда выкрасть."
    },
    {
      "source_id": "045-001-0088",
      "before": "«Было предпринято пять попыток. Дважды нанятые мной грабители перевернули её дом вверх дном. Однажды мы перенаправили её багаж, когда она была в пути. Дважды её перехватывали на дороге. Ничего не вышло».",
      "after": "— Было предпринято пять попыток. Дважды нанятые мною взломщики обшаривали её дом. Однажды мы подменили маршрут её багажа, когда она путешествовала. Дважды её подстерегали на дороге. Результата нет."
    },
    {
      "source_id": "045-001-0089",
      "before": "«Никаких следов?»",
      "after": "— Никаких следов?"
    },
    {
      "source_id": "045-001-0090",
      "before": "«Абсолютно никакой».",
      "after": "— Абсолютно никаких."
    },
    {
      "source_id": "045-001-0091",
      "before": "Холмс рассмеялся. «Это довольно милая маленькая загадка», — сказал он.",
      "after": "Холмс рассмеялся.\n— Это весьма изящная маленькая задача, — сказал он."
    },
    {
      "source_id": "045-001-0092",
      "before": "— Но для меня это очень серьезно, — ответил король укоризненно.",
      "after": "— Но для меня очень серьёзная, — с упрёком возразил король."
    },
    {
      "source_id": "045-001-0093",
      "before": "— «Очень даже. И что она собирается делать с этой фотографией?»",
      "after": "— Очень, разумеется. И что она намерена сделать с фотографией?"
    },
    {
      "source_id": "045-001-0094",
      "before": "— Чтобы погубить меня.",
      "after": "— Погубить меня."
    },
