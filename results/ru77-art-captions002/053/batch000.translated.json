      "target_sha256": "aabc89578c9fb98b527acbe7bc865fb9541ae95c72ddd0c0912703d7b2c1044c"
    },
    {
      "source_id": "ru77-art-caption-18-223",
      "target": "СОБСТВЕННАЯ КОРОЛЕВЫ.",
      "source_sha256": "9a45cdaa2685acc30a0d0ca1f444b781f179cea93de1a848831333b88e478d63",
      "target_id": "ru-ru77-art-caption-18-223",
      "tag": "figcaption",
      "target_sha256": "4682d3a9c68e7196f772348c1570d16e9684d36c7e9c219eb90bd99d30492796"
    },
    {
      "source_id": "ru77-art-caption-20-243",
      "target": "СЭНДИ В ОБЩЕСТВЕ КОРОНОВАННЫХ ОСОБ.",
      "source_sha256": "d2bb4df64204837466a018d6ae5b75eb2b4fa19a546ced90b74e251eadf0cd08",
      "target_id": "ru-ru77-art-caption-20-243",
      "tag": "figcaption",
      "target_sha256": "c05d036827e1918812bd118b9417bb45786225ed741fa86c7375eb329b7f35b4"
    },
    {
      "source_id": "ru77-art-caption-21-260",
      "target": "ВЕРЕНИЦА РАБОВ.",
      "source_sha256": "e5027572926e432f5ff49762fc110fa63f80d2a04d8d06c3f8a6c6a591855589",
      "target_id": "ru-ru77-art-caption-21-260",
      "tag": "figcaption",
      "target_sha256": "1e59071c148b5ac769aef6090cc607b26a66a026100d214653035d51227ed453"
    },
    {
      "source_id": "ru77-art-caption-22-279",
      "target": "«ОН РАСЧЕХЛИЛ СВОЙ ЯЗЫК И ЗАРУГАЛСЯ, КАК ЕПИСКОП».”",
      "source_sha256": "932540ae34d812912e158b0623b208a86aa4c353f45fdae1d5054d9ec5984018",
      "target_id": "ru-ru77-art-caption-22-279",
      "tag": "figcaption",
      "target_sha256": "a3c9b4931ced990c5963430de71fa708efb68dcc2a4151f80f04bf4496091ae1"
    },
    {
      "source_id": "ru77-art-caption-23-290",
      "target": "«ТОРЖЕСТВЕННОЕ ШЕСТВИЕ АББАТА».”",
      "source_sha256": "a279b46d321db84e3c7a9056d8ea4c8181adee3936fa04c9f5a484dcc088c86e",
      "target_id": "ru-ru77-art-caption-23-290",
      "tag": "figcaption",
      "target_sha256": "f6f6b9fe1e2056d0e467df2a38c201aadb8f6af75a4e48a1fa4ce97bdb955903"
    },
    {
      "source_id": "ru77-art-caption-26-337",
      "target": "«НЕ ВИДАЛ ЛИ ТЫ ГДЕ-ЛИБО СЭРА ЛАНСЕЛОТА?»",
      "source_sha256": "826f8c9a89ee034e2d8af6640a7307efb08e58e384471c054e6f3d06cee22de3",
      "target_id": "ru-ru77-art-caption-26-337",
      "tag": "figcaption",
      "target_sha256": "03c4ee061b6178cd89b9f17c1cc24dbe2ac239e8310f52594d6da9da3de65a02"
    },
    {
      "source_id": "ru77-art-caption-26-338",
      "target": "«КАК ПРИЯТНО БЫЛО СНОВА УВИДЕТЬ ГАЗЕТУ».”",
      "source_sha256": "6e4b4bb2e3ac3462c522a16033c77e977d49fc700a4c424935265f62a0ddc1f4",
      "target_id": "ru-ru77-art-caption-26-338",
      "tag": "figcaption",
      "target_sha256": "70c7805e1c2f9af42873ac129b3cfcf1cac5e9f0df081acfe288030c84277293"
    },
    {
      "source_id": "ru77-art-caption-26-343",
      "target": "ОСНОВАТЕЛЬНОЕ УТЕШЕНИЕ.",
      "source_sha256": "63c8f5cb2aaf3751ded7d3652296bbd1271a69b60e214ddaa5c3bef66015b582",
      "target_id": "ru-ru77-art-caption-26-343",
      "tag": "figcaption",
      "target_sha256": "2b39e5ae52f1ea26fba243c79815e132373d47f7ad29b683b8603197dd27cba7"
    },
    {
      "source_id": "ru77-art-caption-28-362",
      "target": "«ЭЙ, ХОЛОП, ПОДАЙ МНЕ ТО УГОЩЕНИЕ, КАКОЕ У ТЕБЯ ЕСТЬ».”",
      "source_sha256": "659286ccab804010a194d8dac64ab52695964a7b2ed40009d9d91df5b1f29434",
      "target_id": "ru-ru77-art-caption-28-362",
      "tag": "figcaption",
      "target_sha256": "68faf6ebce1f4c390757d4a38d749c3381f0187712ae9482495c41ee5792637f"
    },
    {
      "source_id": "ru77-art-caption-28-365",
      "target": "«ДОСПЕХ ТЯЖЕЛ, НО ТО ГОРДОЕ БРЕМЯ, И ЧЕЛОВЕК В НЁМ СТОИТ ПРЯМО».”",
      "source_sha256": "b1c50fee294bef32fd60ae339b8e3732e0bfe7a7654f73b5539fccc0cf995638",
      "target_id": "ru-ru77-art-caption-28-365",
      "tag": "figcaption",
      "target_sha256": "961eaa61a94043242045a609e3529c84609c22629a01fe19061c0da35327d613"
    },
    {
      "source_id": "ru77-art-caption-29-373",
      "target": "НЕКОТОРАЯ МУЖЕСТВЕННОСТЬ ДАЖЕ В КОРОЛЕ.",
      "source_sha256": "f751b299af11fbfee0124fda17eb62166e8516b4c2c1f4214b5593aa07c14574",
      "target_id": "ru-ru77-art-caption-29-373",
      "tag": "figcaption",
      "target_sha256": "38e1f09d7e4e1dd590d367e089a1f8a5508113570fc7243d6aa2ed0da02eac80"
    },
    {
      "source_id": "ru77-art-caption-29-375",
      "target": "ПОД ПРОКЛЯТИЕМ РИМА.",
      "source_sha256": "5eea7fee70fda28a3f1ebf7b34ad59c357429222374da458255d3f8493bf3f9f",
      "target_id": "ru-ru77-art-caption-29-375",
      "tag": "figcaption",
      "target_sha256": "b2d384da4d9c1540820cb154a2fc0216eee784370714e5ca16f4770b98d10f02"
    },
    {
      "source_id": "ru77-art-caption-31-400",
      "target": "«КОГДА МИМО ПРОХОДИЛ РАБ, ОН ДАЖЕ НЕ ВИДЕЛ ЕГО».”",
      "source_sha256": "d3ff8d5da6bb983f4540dfec1ddc32e88bd5405f323b98dc0be2bc095588eb99",
      "target_id": "ru-ru77-art-caption-31-400",
      "tag": "figcaption",
      "target_sha256": "c3849590cbb25ded81fec2bbfec76ff624091d1a451f000adbf3f2c88790d59e"
    },
    {
      "source_id": "ru77-art-caption-32-409",
      "target": "«И ВСКОРЕ УЖЕ БЫЛИ ТАК ОБЩИТЕЛЬНЫ, СЛОВНО СТАРЫЕ ЗНАКОМЫЕ».”",
      "source_sha256": "690700fd970abac96238bc81044cbf064d982ae3e51980ecf96dc16c2858657b",
      "target_id": "ru-ru77-art-caption-32-409",
      "tag": "figcaption",
      "target_sha256": "e9474105f36b746411e3ca20ddff1f5ea67be5a6d3a6e46e5ebe1e3c3eee2d75"
    },
    {
      "source_id": "ru77-art-caption-32-413",
