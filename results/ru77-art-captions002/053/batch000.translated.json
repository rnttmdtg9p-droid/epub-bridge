  "rows": [
    {
      "source_id": "ru77-u053-heading",
      "target": "ВНУТРЕННИЙ ПАКЕТ ПОДПИСЕЙ К ИЛЛЮСТРАЦИЯМ, ПАРТИЯ 002: НЕ ВКЛЮЧАТЬ В ТЕКСТ ДЛЯ ЧИТАТЕЛЯ",
      "source_sha256": "edcd51e01d78c302586fd96f374969d8564dddee05631f4874a3b3bd9ffb30e3",
      "target_id": "ru-ru77-u053-heading",
