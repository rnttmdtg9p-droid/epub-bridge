{
  "unit": 29,
  "batch": 1,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "043-029-0020",
      "target": "— Нет, говорил!",
      "source_sha256": "ffe5d423815231dd1c26e10a5d4c5d1398b757c2103171c1a3c9af41ea1f7a6d",
      "target_id": "ru-043-029-0020",
      "tag": "p",
      "target_sha256": "57637c1403111b49012919342e2c48d23104af205569ab3bb726412d564646ec"
    },
    {
      "source_id": "043-029-0021",
      "target": "— Не говорил.",
      "source_sha256": "daa9b30880483dd9854e8d63c0d225eeed00b89ce05468931eacc9d8709f6ecb",
      "target_id": "ru-043-029-0021",
      "tag": "p",
      "target_sha256": "6358d11eafd040bf9d353570f4468d6c9ff43849e41dffbb0491cf6d47935cde"
    },
    {
      "source_id": "043-029-0022",
      "target": "— Говорил.",
      "source_sha256": "ee1531b16a00796255be8d4d8de2f2675540af2899c634b59a2a060b8bc3d40f",
      "target_id": "ru-043-029-0022",
      "tag": "p",
      "target_sha256": "2016abcac5dbb6cd9919607f5627b3cd494d13770a472ff9eb95cb99bf4cfde7"
    },
    {
      "source_id": "043-029-0023",
      "target": "— Я отродясь ничего такого не говорил.",
      "source_sha256": "20a8460a55170bbccd9e8088676c56551557010b83a9f6add503e922c4fdad9b",
      "target_id": "ru-043-029-0023",
      "tag": "p",
      "target_sha256": "47447d3943c063bdf9e0d84220f5616336d2c97b1c8d4ad83f6b2f1386bfd44e"
    },
    {
      "source_id": "043-029-0024",
      "target": "— Ну, а что же ты тогда <i>сказал</i>?",
      "source_sha256": "1bb070f1ef4322755be3f0b523c85000791c257a6ebe622aa137ae34a2a35a7a",
      "target_id": "ru-043-029-0024",
      "tag": "p",
      "target_sha256": "99168d723669556630ad7a8c59158286da1e77a231ca960762e372024876fe4e"
    },
    {
      "source_id": "043-029-0025",
      "target": "— Сказал, что он приехал принимать морские <i>ванны</i> — вот что я сказал.",
      "source_sha256": "6832ad77ae338f0cacbaedd7b9ed46028671c011b09495723d22538abc75b74a",
      "target_id": "ru-043-029-0025",
      "tag": "p",
      "target_sha256": "7ea0363ea302d9032147aba8b978845ee6a4635fc4d87d7f6cb15885d04ab89d"
    },
    {
      "source_id": "043-029-0026",
      "target": "— Ну так как же он будет принимать морские ванны, если это не на море?",
      "source_sha256": "c17b13250c5a9e771ab8e4bbfbd17a3564e7432ff56c9edd5465999931bc0c1d",
      "target_id": "ru-043-029-0026",
      "tag": "p",
      "target_sha256": "679431ba321c1cf14fd44cbcafacca42e3396da07ebe749ae91a49c3beb33ef0"
    },
    {
      "source_id": "043-029-0027",
      "target": "— Слушай-ка, — говорю я, — ты когда-нибудь видела конгрессовскую воду?",
      "source_sha256": "e00e48a85692cdb6b73d5affd5c58d8512d5eb0c3c4d8e06e620e7e83f8d48e2",
      "target_id": "ru-043-029-0027",
      "tag": "p",
      "target_sha256": "de5929c7f6c40253aeed2d38eea46cb88b7d7b2f7fcdf25013a17f3cf0f44611"
    },
    {
      "source_id": "043-029-0028",
      "target": "— Видела.",
      "source_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "target_id": "ru-043-029-0028",
      "tag": "p",
      "target_sha256": "c354a99ebed4d92b1a2402e7ef3f4ecd38c73cdec7b802dabff9319bbb1cffd7"
    },
    {
      "source_id": "043-029-0029",
      "target": "— Ну а тебе что, пришлось ехать в Конгресс, чтобы её достать?",
      "source_sha256": "891c07fac88239a4d39e82783e8e76220045118654362f766a57a10b6b555459",
      "target_id": "ru-043-029-0029",
      "tag": "p",
      "target_sha256": "76b10054f34b56e0de7ee923406b49daded14ef6c28a0f04ac015e981c71ee7b"
    },
    {
      "source_id": "043-029-0030",
      "target": "— Да нет, конечно.",
      "source_sha256": "a8a6a4e7612633f5a5317646ea2e47427c501a94fb924965a8b4412f051d172d",
      "target_id": "ru-043-029-0030",
      "tag": "p",
      "target_sha256": "cdaccc1b4d4eb1ca4185a990af715b7818ea7c646cc683a72ea946cb341a5a1e"
    },
    {
      "source_id": "043-029-0031",
      "target": "— Ну вот и Вильгельму Четвёртому тоже не надо ехать к морю, чтобы принять морскую ванну.",
      "source_sha256": "73132e957cb4489b67f23cfd52c2f65fee598827b38207441619ee67d760e164",
      "target_id": "ru-043-029-0031",
      "tag": "p",
      "target_sha256": "9590cdefbc0054ab92ac9c582f5ea1be565920f7c9ce85403570719aee5cfca4"
    },
    {
      "source_id": "043-029-0032",
      "target": "— А как же он её принимает?",
      "source_sha256": "feaee8f2193327d5fbadeb467b2ea16f4dbf86f0666b5a3df211668488568f6d",
      "target_id": "ru-043-029-0032",
      "tag": "p",
      "target_sha256": "7ace1cae9c62e80f0a3ea8fa6b465a4c9e20e9ca8d80aeb3c327aefeee6145e1"
    },
    {
      "source_id": "043-029-0033",
      "target": "— Достаёт так же, как здешний народ достаёт конгрессовскую воду, — в бочках. Там у них, во дворце в Шеффилде, есть печи, а ему надо, чтобы вода была горячая. Они не могут кипятить столько воды где-то там, далеко, у моря. Для этого у них нет никаких удобств.",
      "source_sha256": "c1ed2adcffe51409689346f2aa219e76c73002afc9f06ed11ca55825230acf03",
      "target_id": "ru-043-029-0033",
      "tag": "p",
      "target_sha256": "c5878aa6d560a0f33d75d67a46a0a5bfed4b8a26ec2e10e5f7bc4d56b63bcb7b"
    },
    {
      "source_id": "043-029-0034",
      "target": "— А, теперь понятно. Могла бы так сразу и сказать, и мы бы время сберегли.",
      "source_sha256": "8be9c1666b0ec7db2b1236123bea0de8a984ab9d38bb9ca35766ad7aa9943e68",
      "target_id": "ru-043-029-0034",
      "tag": "p",
      "target_sha256": "80b3c03760c38267b616e5a48daf6e4e4ce92eb3d331ba3882b7265b6a37cd74"
    },
    {
      "source_id": "043-029-0035",
      "target": "Когда она это сказала, я увидел, что опять выбрался из чащи, и мне стало спокойно и радостно. Потом она говорит:",
      "source_sha256": "339bec950cb2417deff33423d829525d810a9f2df2802c523d747f94a9beee68",
      "target_id": "ru-043-029-0035",
      "tag": "p",
      "target_sha256": "5353685fb77fd72208784f6d72905465c2e05341f396f4f8e73eac8ade7028be"
    },
    {
      "source_id": "043-029-0036",
      "target": "— А ты тоже в церковь ходишь?",
      "source_sha256": "6a26b8c1346ae1d206680070cd742fee8c4782ceecc0766e0f03018931f082a4",
      "target_id": "ru-043-029-0036",
      "tag": "p",
      "target_sha256": "081b34f560cca19507014c8ef0577cb2b827d5aa26bdb498a7e60d4a08513d86"
    },
    {
      "source_id": "043-029-0037",
      "target": "— Хожу — регулярно.",
      "source_sha256": "565e0931dc1f51f2fca04186639a46cbdd5a5dd435d3097a59dc63fcf23ab43e",
      "target_id": "ru-043-029-0037",
      "tag": "p",
      "target_sha256": "a11cb0ae56478e87247069889c4798f505bcbef73c8a6d6b3b486eed1b6c86a8"
    },
    {
      "source_id": "043-029-0038",
      "target": "— А где ты сидишь?",
      "source_sha256": "15742e40e98306638ed0b2764b22015f1529fd2d1928c273fd46c9a96c7a216a",
      "target_id": "ru-043-029-0038",
      "tag": "p",
      "target_sha256": "be3ec6a6b0a1ea8d1ecba466bce840e2310600a8578de9b7adee6ce29ac8fbc9"
    },
    {
      "source_id": "043-029-0039",
      "target": "— Как где, на нашей скамье.",
      "source_sha256": "853d835551b5f9f8fc7fd20dbb9d68a3cf6a0745b55359464b627eebf3ce75e5",
      "target_id": "ru-043-029-0039",
      "tag": "p",
      "target_sha256": "6beaa6fe7e0fbde91af2fe1fd999add57198440df3971b4797bc861edb977f4f"
    }
  ],
