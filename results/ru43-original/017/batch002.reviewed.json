{
  "unit": 17,
  "batch": 2,
  "state": "SOURCE_ALIGNED_AI_REVIEWED_PENDING_COMPARISON",
  "rows": [
    {
      "source_id": "043-017-0040",
      "target": "— Ну так почему ж он не может <i>сказать</i> по-людски?",
      "source_sha256": "5d0fed25e7651cb210b3801cf8a5bf5bc1da61098265b733d585f30cb5afa5b2",
      "target_id": "ru-043-017-0040",
      "tag": "p",
      "target_sha256": "2dc47e966f91156f39867e81c8978b2b355aebb86acd3f9b11b4945922c36f0f"
    },
    {
      "source_id": "043-017-0041",
      "target": "— Да он как раз <i>и говорит</i>. Это у французов такой <i>способ</i> говорить.",
      "source_sha256": "021a431c0e1a41d03b221c48c4f4bdb49c054cd7e1727402f85cb4327127da77",
      "target_id": "ru-043-017-0041",
      "tag": "p",
      "target_sha256": "a4b6da69e27522cb5c8cfb233ac23e74499018481605fe8cc7fc9e49115660b8"
    },
    {
      "source_id": "043-017-0042",
      "target": "— Ну, и дурацкий же это способ, и я про него больше слышать не желаю. Нету в нём никакого смыслу.",
      "source_sha256": "6132618e5f3ad23d28423b162680770c3fc635103ada477ededfbfafa61ffe65",
      "target_id": "ru-043-017-0042",
      "tag": "p",
      "target_sha256": "ca95946d458da12a5cb99e9e2f102a09dc6d34b2553a956618e2b930c6f7ed1a"
    },
    {
      "source_id": "043-017-0043",
      "target": "— Слушай, Джим: разве кошка говорит так, как мы?",
      "source_sha256": "09d8e934f6cb44aecddda906aa1ca081928cd2e2f6b899ea5f335fc52039f9c2",
      "target_id": "ru-043-017-0043",
      "tag": "p",
      "target_sha256": "c2cd7ac6e43422cb7245fbafc9056d8fb6a2638777ee388c0a59c7f711e60a21"
    },
    {
      "source_id": "043-017-0044",
      "target": "— Нет, кошка не говорит.",
      "source_sha256": "7a77d8da15a33cace62b19fa43a63989bda47cd15b5557e6bfa80ac6e7220a47",
      "target_id": "ru-043-017-0044",
      "tag": "p",
      "target_sha256": "a4a24614b3fcfbb8a03d8c2a6cdd83c4afd0ef430d4e7821a8075685aa144ddc"
    },
    {
      "source_id": "043-017-0045",
      "target": "— А корова говорит?",
      "source_sha256": "8c7f1bd1f1e2dec996f5def3ed41f0ab935e30063309e0cbcf935fce51d03ae2",
      "target_id": "ru-043-017-0045",
      "tag": "p",
      "target_sha256": "dd6e132f2292fcb14f780513cfd0a87d9a1726392ffc01c2cd2ca62bdc29f229"
    },
    {
      "source_id": "043-017-0046",
      "target": "— Нет, и корова не говорит.",
      "source_sha256": "bda086f97853620fa507911b640e129bf99cf0228274052f26c063e92b555468",
      "target_id": "ru-043-017-0046",
      "tag": "p",
      "target_sha256": "656691b620e69c7232a608cdb42cb17be84cafb6a7497fa5fd5c83410ae5efec"
    },
    {
      "source_id": "043-017-0047",
      "target": "— А кошка говорит как корова, или корова как кошка?",
      "source_sha256": "8572ad7f8610970c859232da4d7dcc39167a449bf2770cf93636588c7cb4d8f4",
      "target_id": "ru-043-017-0047",
      "tag": "p",
      "target_sha256": "7bcff497a1f088173b251b69970b34ab19d8217866b0b5d2e7778b35c90fcd27"
    },
    {
      "source_id": "043-017-0048",
      "target": "— Нет, не говорят.",
      "source_sha256": "fd0810d4818c824587df6ca2d0b4b7d947a6a881f97d8f672daeed6ce5b2ede4",
      "target_id": "ru-043-017-0048",
      "tag": "p",
      "target_sha256": "ab0d05c2c4015e1caca64c3dc6d5bcdd6301be06c71bfa87628c6407709fecb7"
    },
    {
      "source_id": "043-017-0049",
      "target": "— Ведь это естественно и правильно, что они говорят не одинаково, а по-разному, так?",
      "source_sha256": "63eb97bc1d67a38f2057f856f277845ff072515352504fe703cbc497aac4f5bd",
      "target_id": "ru-043-017-0049",
      "tag": "p",
      "target_sha256": "2943f30cf7b915476cef563ca279ed5c176c4c16d1af2fe7b849a73643420ed2"
    },
    {
      "source_id": "043-017-0050",
      "target": "— Ясное дело.",
      "source_sha256": "48dfdb1ad21d5f12dfcb8dd43a2d7241ddbee00a8d1291995a8dea779ec9b4ad",
      "target_id": "ru-043-017-0050",
      "tag": "p",
      "target_sha256": "6a74358ef088986aad9f9a23d88c94ceabb0c9b65ab4eae85c78db7ae0e039a6"
    },
    {
      "source_id": "043-017-0051",
      "target": "— А разве не естественно и не правильно, что кошка и корова говорят не так, как <i>мы</i>?",
      "source_sha256": "2225b3042ca5e9fe8dca0c68d354f3ecb74f38ebba73fdaed24609541367a998",
      "target_id": "ru-043-017-0051",
      "tag": "p",
      "target_sha256": "f0e13a402d428803d83a96c635f345f1a6ef7b2372b1083f767844e079ca188c"
    },
    {
      "source_id": "043-017-0052",
      "target": "— Ну, конечно, это так.",
      "source_sha256": "8208a97202be89a822bd4b20742f52d6aac751ae2d6f4c6783ba970aac025e21",
      "target_id": "ru-043-017-0052",
      "tag": "p",
      "target_sha256": "27c74a5017a931bd7264aa2d57888f995bfd662abe6b72f1e68bf723010d6d88"
    },
    {
      "source_id": "043-017-0053",
      "target": "— Ну, тогда почему же не естественно и не правильно, чтобы <i>француз</i> говорил не так, как мы? Ответь-ка мне на это.",
      "source_sha256": "e955624f0b6bcc152035c195907b0971d6eb81e0f7b51164b2cf584e7b3f70bf",
      "target_id": "ru-043-017-0053",
      "tag": "p",
      "target_sha256": "a934f79a4e4607cc4680afc5fbb47f8aee14f1c5d30e8b8e5d890c6519615aa8"
    },
    {
      "source_id": "043-017-0054",
      "target": "— А кошка — это человек, Гек?",
      "source_sha256": "a95294efedf61dd50fd7977076389ef72af88efcefd3631ffebde91312258f9d",
      "target_id": "ru-043-017-0054",
      "tag": "p",
      "target_sha256": "6b35702fb1cfdaba3e91fe17f89c9c9d17254471869da2735031d8523da3090d"
    },
    {
      "source_id": "043-017-0055",
      "target": "— Нет.",
      "source_sha256": "5d7358f5d297147882a18b021672039ea250258c9f60eafc2a4aa698a193f399",
      "target_id": "ru-043-017-0055",
      "tag": "p",
      "target_sha256": "69a324f4996b8b6a7d3d28f1e77fa840d2b3b98071502749b80a16035cbc0564"
    },
    {
      "source_id": "043-017-0056",
      "target": "— Ну так нету никакого смыслу, чтоб кошка говорила, как человек. А корова — это человек? Или корова — это кошка?",
      "source_sha256": "e851130e4d1e846acc1855005a0f55447b2fedde36f16bdc20622bb2448b0641",
      "target_id": "ru-043-017-0056",
      "tag": "p",
      "target_sha256": "621eb265d0ce90fcca068482d8c079c926f3ede13c715e7176db8bf267961731"
    },
    {
      "source_id": "043-017-0057",
      "target": "— Нет, она ни то, ни другое.",
      "source_sha256": "c557d399a17bafbf77476e648860df72246cce5724cd550b15b336dfd2ac1ee8",
      "target_id": "ru-043-017-0057",
      "tag": "p",
      "target_sha256": "4178f7f80cec1b82e460b7e41126da4f27fe08f2b01c9cdac5f03b654e8024ed"
    },
    {
      "source_id": "043-017-0058",
      "target": "— Ну так и не её дело говорить ни как одно, ни как другое. А француз — это человек?",
      "source_sha256": "ed3ef1c2f39977fb4da15a43aa6c331511be330ca5eed87f266c3fc23d907e15",
      "target_id": "ru-043-017-0058",
      "tag": "p",
      "target_sha256": "b8e0e8a01e391ddaad81b475b51553f69b710778655c4e911d50cb23d0991a06"
    },
    {
      "source_id": "043-017-0059",
      "target": "— Да.",
      "source_sha256": "838a04296799794f4e1a85c40540fd52027a3aa3d6a1cd735f69b489839212cf",
      "target_id": "ru-043-017-0059",
      "tag": "p",
      "target_sha256": "b38bdfda461dc2130aa710240e46c220d11d45c3bc5fe7d22b9278a9a8f4972c"
    }
  ],
