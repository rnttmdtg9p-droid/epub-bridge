{
  "translations": [
    {
      "text": "И заболел ли юный Стивен,",
      "detected_source_language": "EN",
      "model_type_used": "quality_optimized"
    },
    {
      "text": "А умер ли молодой Стивен?",
      "detected_source_language": "EN",
      "model_type_used": "quality_optimized"
    },
    {
      "text": "И не сжались ли грустные сердца,",
      "detected_source_language": "EN",
      "model_type_used": "quality_optimized"
    },
    {
      "text": "А плакали ли скорбящие?",
      "detected_source_language": "EN",
      "model_type_used": "quality_optimized"
    },
    {
      "text": "Нет; такова не была судьба",
      "detected_source_language": "EN",
      "model_type_used": "quality_optimized"
    },
    {
      "text": "Молодой Стивен Даулинг Ботс;",
      "detected_source_language": "EN",
      "model_type_used": "quality_optimized"
    },
    {
      "text": "Хотя вокруг него сгущались печальные сердца,",
      "detected_source_language": "EN",
      "model_type_used": "quality_optimized"
    },
    {
      "text": "Это было не от прививок от болезней.",
