{
  "unit": 5,
  "batch": 6,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "ru78-u005-r0096",
      "target": "Но Фрэнсис, всё ещё ожесточавший против неё своё сердце, медленно покачал головой и сказал:",
      "source_sha256": "7089ad898650bafef34779bc968a9d468666a6d065f9f545468f38957ffc2265",
      "target_id": "ru-ru78-u005-r0096",
      "tag": "p",
      "target_sha256": "ed2467f2069c012ff5700f80fe8873cf26487920e3e6faa48708336823cf2ad9"
    },
    {
      "source_id": "ru78-u005-r0097",
      "target": "— Это вас не спасёт, Леонсия. Я оставил на вас метку, которая никогда не сойдёт.",
      "source_sha256": "0349b63cea2de2782ab6a1d00db90b89160b5d98311310ac55e84505c2083996",
      "target_id": "ru-ru78-u005-r0097",
      "tag": "p",
      "target_sha256": "6d0774b169a24cf3a41fe678d79116f672756bd20e14ca51dbcd9856e3e6ff0a"
    },
    {
      "source_id": "ru78-u005-r0098",
      "target": "Он указал на ссадины, которые оставил на её колене, и рассмеялся.",
      "source_sha256": "4de0aefaa9fcdb7f4632073a966b1760b69355961efec967a7d95428bd6c0808",
      "target_id": "ru-ru78-u005-r0098",
      "tag": "p",
      "target_sha256": "4a72e74ef4f3f88a21c1c80aeb2848200e750a3473b06e211f1f9836d28ade72"
    },
    {
      "source_id": "ru78-u005-r0099",
      "target": "— Метка зверя, — парировала она, поворачиваясь, чтобы уйти. — Советую вам убраться отсюда, мистер Генри Морган.",
      "source_sha256": "c8eed8dc9742ea0159b51569f3f0d13b8fa1a45ced436e08d9e6d1ec82302bf8",
      "target_id": "ru-ru78-u005-r0099",
      "tag": "p",
      "target_sha256": "20d75545c0ea9d4e1b23908fc10a37c71c1c8288b96ceb94c0461173e368716f"
    },
    {
      "source_id": "ru78-u005-r0100",
      "target": "Но он заступил ей дорогу.",
      "source_sha256": "7b50826a626193a9fd68505b9d46dc30969da5626a474d27eea86731e23f39c6",
      "target_id": "ru-ru78-u005-r0100",
      "tag": "p",
      "target_sha256": "e9b7b374495c94d87258574f511f028f0534273f95ed07d0fa632b7e9f80514b"
    },
    {
      "source_id": "ru78-u005-r0101",
      "target": "— А теперь поговорим о деле, мисс Солано, — сказал он уже другим тоном. — И вы меня выслушаете. Пусть ваши глаза мечут сколько угодно молний, но не перебивайте меня. — Он наклонился и поднял записку, которую писал. — Я как раз собирался послать её вам с мальчиком, когда вы закричали. Возьмите. Прочтите. Она не укусит. Это не гадюка.",
      "source_sha256": "583064106f00432f10bef4006fbed43a06e398378c21b4027fa8c20b89fd6939",
      "target_id": "ru-ru78-u005-r0101",
      "tag": "p",
      "target_sha256": "aa38708355c107d2f9e9d46d90fe0cdd317591c7b24154cb7d8c5053328a3fda"
    },
    {
      "source_id": "ru78-u005-r0102",
      "target": "Хотя она отказывалась взять записку, глаза её невольно пробежали первую строку:",
      "source_sha256": "f7e4c3d1310aec0e1b64ffc5d64d7c164c56d1ce04ce7e2113479adb67670f03",
      "target_id": "ru-ru78-u005-r0102",
      "tag": "p",
      "target_sha256": "5a248bf09377c448eb703e60260255f5aea65e1723e5e7107837ad3fb9abf88c"
    },
    {
      "source_id": "ru78-u005-r0103",
      "target": "[[I]]Я тот человек, которого вы приняли за Генри Моргана[[/I]]...",
      "source_sha256": "3c9ab6be20a698b9231b88ff090aeb7776fdcf41b2156c93ae598c36e6c7ec47",
      "target_id": "ru-ru78-u005-r0103",
      "tag": "p",
      "target_sha256": "a708e218846e61e392c4947894e13238d69920b792686d02d2dd61f2dcbf0381"
    },
    {
      "source_id": "ru78-u005-r0104",
      "target": "Она взглянула на него испуганными глазами, которые мало что могли постичь, но уже угадывали многое смутное.",
      "source_sha256": "20a8417ea667880406030566f658d966c353472d6a36ed2e206b8335a02bb328",
      "target_id": "ru-ru78-u005-r0104",
      "tag": "p",
      "target_sha256": "9a0635aaa7d0d9c1f015a5bcbe5c99e7e15c2f6eb576e0a4759593264e2de006"
    },
    {
      "source_id": "ru78-u005-r0105",
      "target": "— Даю слово чести, — серьёзно сказал он.",
      "source_sha256": "0f3faa81a52fb47dfcbb4061cb76d623b1ef9bccc27c32663b5e09da438b40cf",
      "target_id": "ru-ru78-u005-r0105",
      "tag": "p",
      "target_sha256": "84e7d15de6c72281e6d82a39578f4ff535661d60966d072788d7b2fc4a06d86e"
    },
    {
      "source_id": "ru78-u005-r0106",
      "target": "— Вы... не... Генри? — выдохнула она.",
      "source_sha256": "3226b9a027b5f4d3d55382746f417dc593380196dad2aa5980aac03e4c3eea7e",
      "target_id": "ru-ru78-u005-r0106",
      "tag": "p",
      "target_sha256": "69fc53f3bef0551f19b1ce814127b1495e08be81c0728c98b4904c4ca51dc2ac"
    },
    {
      "source_id": "ru78-u005-r0107",
      "target": "— Нет, не он. Не возьмёте ли вы записку и не прочтёте ли её?",
      "source_sha256": "a9b9eff48d702cda5ff6400f8b9896d7f9e79f069f856f8ac98bcda63db5d111",
      "target_id": "ru-ru78-u005-r0107",
      "tag": "p",
      "target_sha256": "81a5c70472e45d2f62b29418c9ccc76eb6c551af9c25c48406a150992adeeeb6"
    },
    {
      "source_id": "ru78-u005-r0108",
      "target": "На этот раз она уступила, а он смотрел во все глаза на золотистую бледность, которую солнце оставило на её светловолосом, тронутом тропическим загаром лице, — бледность, что окрашивала кровь под кожей или же сама была тронута этой кровью, — и оттого она становилась удивительно прекрасной, золотой.",
      "source_sha256": "0208b05cda0c03d010a1ba5877be7f5e09f1c0979c39804494ca1a63e1c9ecfb",
      "target_id": "ru-ru78-u005-r0108",
      "tag": "p",
      "target_sha256": "3f17736a57d20036f0e9bda2f42898eed66a389dbc16add3a617da7cc80d7488"
    },
    {
      "source_id": "ru78-u005-r0109",
      "target": "Словно во сне он обнаружил, что смотрит в её испуганные, вопрошающие бархатно-карие глаза.",
      "source_sha256": "e4c81a3a09e47f52fe58819d81e36404cad63eb86a1d60e28c9b4eca627a66b8",
      "target_id": "ru-ru78-u005-r0109",
      "tag": "p",
      "target_sha256": "e085919860b06e97c41ceb202737a3d9923b061b92abd216e9c6355dbbe1a470"
    },
    {
      "source_id": "ru78-u005-r0110",
      "target": "— А кто же должен был это подписать? — повторила она.",
      "source_sha256": "0586c04c42e78b43a0e8c4ff0abc40a35f4a2778c28f8c88c97e7cd907246ffb",
      "target_id": "ru-ru78-u005-r0110",
      "tag": "p",
      "target_sha256": "9fa693686b15efbce21c668bec585200eabb2302b6b8cc53b5d0b48fa2d7119a"
    },
    {
      "source_id": "ru78-u005-r0111",
      "target": "Он опомнился и поклонился.",
      "source_sha256": "f3dac20706fe2be154ff9f4e948d34d18676b487217f7836390cafa0a4bebbe2",
      "target_id": "ru-ru78-u005-r0111",
      "tag": "p",
      "target_sha256": "c3c9abcacdeff798916f3a13eaeb293e5e0ca468507fb564f5d0334ddc7d36aa"
    }
  ],
