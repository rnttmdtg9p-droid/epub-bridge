{
  "unit": 5,
  "batch": 7,
  "state": "INITIAL_TRANSLATION_ONLY_PENDING_INDEPENDENT_REVIEW",
  "rows": [
    {
      "source_id": "ru78-u005-r0112",
      "target": "— А имя? Ваше имя?",
      "source_sha256": "0694a96be93620be7a0ec1560df969bac44ee4a9ed838652df004513bb2aad96",
      "target_id": "ru-ru78-u005-r0112",
      "tag": "p",
      "target_sha256": "327f989352f7a5255d1d832a0602b04722a16b74b986440ed41c7ec1cc7e599c"
    },
    {
      "source_id": "ru78-u005-r0113",
      "target": "— Морган. Фрэнсис Морган. Как я там объяснил, мы с Генри какие-то дальние родственники — сорок пятые кузены или что-то в этом роде.",
      "source_sha256": "4e9b2d5a9533424ddcf0fe70a190336cf7d23e1433d4bbcc0c00e97925503edc",
      "target_id": "ru-ru78-u005-r0113",
      "tag": "p",
      "target_sha256": "28d154998b13724c0bda752ad76dfcc8a7e37ce852b7c31ad23cb252deaa2ecf"
    },
    {
      "source_id": "ru78-u005-r0114",
      "target": "К его удивлению, в её глазах вдруг забрезжило большое сомнение, и вспыхнул прежний, хорошо знакомый гнев.",
      "source_sha256": "81d1f0c2ba6a4f6778d4459d4d464062f88268013f72ccdbec9f9f14054a7fa4",
      "target_id": "ru-ru78-u005-r0114",
      "tag": "p",
      "target_sha256": "3aa9805b6c6f5b05d38ce9b157158823e90e89925afe4fbfd3b2b32ee1fe2669"
    },
    {
      "source_id": "ru78-u005-r0115",
      "target": "— Генри, — обвинила она его. — Это уловка, дьявольская хитрость, которую вы пытаетесь сыграть со мной. Конечно, вы Генри.",
      "source_sha256": "91035f616489ea71564e5f4814dd71f4bfa9cd0dbf997f1f6872da4694235695",
      "target_id": "ru-ru78-u005-r0115",
      "tag": "p",
      "target_sha256": "4f895e27115482fbd7e46a316739a682a978963c299ba1878cec9b150e0fcbce"
    },
    {
      "source_id": "ru78-u005-r0116",
      "target": "Фрэнсис указал на свои усы.",
      "source_sha256": "9722ab1351663f55c0bd1889ec23af990a3ec530e4b3b556b5dc8f71d5e3977d",
      "target_id": "ru-ru78-u005-r0116",
      "tag": "p",
      "target_sha256": "baff8721f0f0f1e0b77e72cec9c227771bca8c28067abdf42550571f2f4a1a58"
    },
    {
      "source_id": "ru78-u005-r0117",
      "target": "— Вы отрастили их с тех пор, — возразила она.",
      "source_sha256": "61cf3232e68881e2e1fb32f9371d66c4ebab05d304d09d28090b1ca75267823e",
      "target_id": "ru-ru78-u005-r0117",
      "tag": "p",
      "target_sha256": "0f0aa936d49f5ed346b7ae1d212a55d78d766f8824d7c6c2f8958e71330e210f"
    },
    {
      "source_id": "ru78-u005-r0118",
      "target": "Он закатал рукав и показал ей левую руку от запястья до локтя. Но она лишь взглядом выразила, что не понимает смысла его действия.",
      "source_sha256": "6f46ff16f3b2e53cb0d59ceb8196d18762ffd9b89f289879366a23157cbb1e22",
      "target_id": "ru-ru78-u005-r0118",
      "tag": "p",
      "target_sha256": "c508dd9441703863150dd45bc1780bed2e21fa5d4ca5f727100aab4651ba7404"
    },
    {
      "source_id": "ru78-u005-r0119",
      "target": "— Вы помните шрам? — спросил он.",
      "source_sha256": "2b1a21783e94dc0aa8ca1a343ec0173d8422597da2621d67d01033053d3bdfde",
      "target_id": "ru-ru78-u005-r0119",
      "tag": "p",
      "target_sha256": "d5a85b84c49b9f6e6154b8fdbb6636e2f8edafe9f434767ff83e2d8f65870c0f"
    },
    {
      "source_id": "ru78-u005-r0120",
      "target": "Она кивнула.",
      "source_sha256": "48227c9e068972bd3e8156c10a8fed117e17c15eeda69c6db52f61ff2ca87908",
      "target_id": "ru-ru78-u005-r0120",
      "tag": "p",
      "target_sha256": "8a4aea9882326b219b67736a07811b14b2a1b11a5882cf808a1c3f9d4863f804"
    },
    {
      "source_id": "ru78-u005-r0121",
      "target": "— Тогда найдите его.",
      "source_sha256": "7a5b64954809999371ba11dfc11f8b96f6af2efa2c6acdbc7bb44ce9a2288619",
      "target_id": "ru-ru78-u005-r0121",
      "tag": "p",
      "target_sha256": "461c5d21faf3532a129a5c0e29d10bb406e84ae27d2261adb48f629f2ef6d0d2"
    },
    {
      "source_id": "ru78-u005-r0122",
      "target": "Она быстро наклонила голову в напрасных поисках, потом медленно покачала ею и запнулась:",
      "source_sha256": "d81d0c25256d36ba4abae30a99030063681792fdf5c1ea9391db9acec75a019d",
      "target_id": "ru-ru78-u005-r0122",
      "tag": "p",
      "target_sha256": "0bb96a17388d53b9174049af17003fc152725f9448cf870713b9f68b67ec4fc8"
    },
    {
      "source_id": "ru78-u005-r0123",
      "target": "— Я... я прошу у вас прощения. Я ужасно ошиблась, и когда я думаю о том, как я... как я с вами обошлась...",
      "source_sha256": "f7e4c151e112510015c32fa7a592457a80caef94a1434adf8d02eb0b54c547c0",
      "target_id": "ru-ru78-u005-r0123",
      "tag": "p",
      "target_sha256": "0d751ff963bc73b31e4b0c2346415d60c3cfbf94a797fa711a3c488549677484"
    },
    {
      "source_id": "ru78-u005-r0124",
      "target": "— Этот поцелуй был восхитителен, — озорно отмахнулся он.",
      "source_sha256": "1d00d9dec221c52637ae50e8a680af91b9c591629086a1a94d3eef1d6746652d",
      "target_id": "ru-ru78-u005-r0124",
      "tag": "p",
      "target_sha256": "63e09ae5c9debf4b293ac5e1f41f546a32e2850bb0bf7cadbf70d0327d13e8ef"
    },
    {
      "source_id": "ru78-u005-r0125",
      "target": "Она вспомнила о более недавних эпизодах, взглянула на своё колено и подавила хихиканье, которое, по его суждению, было прелестнейшим на свете.",
      "source_sha256": "ab4b9ec424aaf317016587589a3f94dade1d4b858e287070afb79099c2167708",
      "target_id": "ru-ru78-u005-r0125",
      "tag": "p",
      "target_sha256": "3bcec6b8925721d2316d7c86c6328850ae92f7caee8d48550b382bdbe4e174b6"
    },
    {
      "source_id": "ru78-u005-r0126",
      "target": "— Вы говорите, что у вас есть весть от Генри, — резко переменила она тему. — И что он невиновен...? Это правда? О, как я хочу вам поверить!",
      "source_sha256": "d8b79cbc9baed0965f1628e83c614c1f8716f0e122ef5aaf96b6936e322022ab",
      "target_id": "ru-ru78-u005-r0126",
      "tag": "p",
      "target_sha256": "ae5bc1c921b78a97509716ac3daf2d2acb50773510d5ffe7aa6e58b6ae6153fd"
    },
    {
      "source_id": "ru78-u005-r0127",
      "target": "— Я морально уверен, что Генри убил вашего дядю не больше, чем я —",
      "source_sha256": "ddb2e8696d2f6e2630d959c784140528468af81ac673d7657087d42b2a9f5a2c",
      "target_id": "ru-ru78-u005-r0127",
      "tag": "p",
      "target_sha256": "e51c394460290bfd161601215ab5898ad69d175d642f89c16ea91e6ae47e6f67"
    }
  ],
