  "rows": [
    {
      "source_id": "ru78-u002-heading",
      "target": "Спиной к спине у грот-мачты",
      "source_sha256": "bda77f57fcf7f0788ee67decc1284f9c93ab18983d5f2baa1549f77e6df17c15",
      "target_id": "ru-ru78-u002-heading",
      "tag": "heading",
      "target_sha256": "5ad525b2b62feba8f4272a0c4e9a309a2e019c60a1c8711a8955c939e419ec90"
    },
    {
      "source_id": "ru78-u002-r0001",
      "target": "Ищете веселья и богатства?\nСлушайте, бродяги, что скажу!\nИщите их в просторах океана —\nВы найдёте их на море.",
      "source_sha256": "0b7bba86773c063e5238e3128d8b27857be9887d092a13a0d526e09a17e9609b",
      "target_id": "ru-ru78-u002-r0001",
      "tag": "verse_group",
      "target_sha256": "b6a088c94d36bb06cec27466f408d34e3e1260ec9162da1ea115a4cbb61c4b20"
    },
    {
      "source_id": "ru78-u002-r0002",
      "target": "Припев:",
      "source_sha256": "59961cd490b777f64543dce156d17f6bdb76633347ef65d2a00e3d2cb9a03e46",
      "target_id": "ru-ru78-u002-r0002",
      "tag": "verse_group",
      "target_sha256": "19c801181a36dfc91df91dbf4e6b15b8b728980333c72d7444b699a35cc70edd"
    },
    {
      "source_id": "ru78-u002-r0003",
      "target": "Рёв ветров и синяя пучина!\nМы — весёлые черти, что у грот-мачты,\nСпина к спине, стояли насмерть,\nНе подпуская весь экипаж.",
      "source_sha256": "826e4a210642ce96ea6bf597a39ef493957e4d120d63712ff0ee0e1acfab0d86",
      "target_id": "ru-ru78-u002-r0003",
      "tag": "verse_group",
      "target_sha256": "ca3147689f9f8d0556eed1502e0a863dcae243c1ec2d9b0adfc000e3c02d665c"
    },
    {
      "source_id": "ru78-u002-r0004",
      "target": "Дайте кинжал, дайте пистолеты!\nСегодня мы возьмём своё!\nПусть пушки крушат борта!\nПусть абордажная сабля пробьёт дорогу!",
      "source_sha256": "b293b00c5aa21576a0e8d39c23d13356bc0c8973c8f2152f76caeb5442e37ce7",
      "target_id": "ru-ru78-u002-r0004",
      "tag": "verse_group",
      "target_sha256": "cc7350a48038fb8b671f2caa5d1c2ac4db5ed6ea873fe206a464fad28040124e"
    },
    {
      "source_id": "ru78-u002-r0005",
      "target": "Припев:",
      "source_sha256": "59961cd490b777f64543dce156d17f6bdb76633347ef65d2a00e3d2cb9a03e46",
      "target_id": "ru-ru78-u002-r0005",
      "tag": "verse_group",
      "target_sha256": "19c801181a36dfc91df91dbf4e6b15b8b728980333c72d7444b699a35cc70edd"
    },
    {
      "source_id": "ru78-u002-r0006",
      "target": "Рёв ветров и синяя пучина!\nМы — весёлые черти, что у грот-мачты,\nСпина к спине, стояли насмерть,\nНе подпуская весь экипаж.",
      "source_sha256": "826e4a210642ce96ea6bf597a39ef493957e4d120d63712ff0ee0e1acfab0d86",
      "target_id": "ru-ru78-u002-r0006",
      "tag": "verse_group",
      "target_sha256": "ca3147689f9f8d0556eed1502e0a863dcae243c1ec2d9b0adfc000e3c02d665c"
    },
    {
      "source_id": "ru78-u002-r0007",
      "target": "Выпьем за ром и выпьем за добычу!\nВыпьем за все ветры, что дуют!\nПусть матросы молят о пощаде!\nПусть льётся кровь капитанов!",
      "source_sha256": "43de9e4619020e15c90f15f33a05e5aadeb628b9c242185f17efbf9d35b2305f",
      "target_id": "ru-ru78-u002-r0007",
      "tag": "verse_group",
      "target_sha256": "1a58808982a29a898545c85520b4b4b8abb3d25c611075dbfc6c15ae997e0cd2"
    },
    {
      "source_id": "ru78-u002-r0008",
      "target": "Припев:",
      "source_sha256": "59961cd490b777f64543dce156d17f6bdb76633347ef65d2a00e3d2cb9a03e46",
      "target_id": "ru-ru78-u002-r0008",
      "tag": "verse_group",
      "target_sha256": "19c801181a36dfc91df91dbf4e6b15b8b728980333c72d7444b699a35cc70edd"
    },
    {
      "source_id": "ru78-u002-r0009",
      "target": "Рёв ветров и синяя пучина!\nМы — весёлые черти, что у грот-мачты,\nСпина к спине, стояли насмерть,\nНе подпуская весь экипаж.",
      "source_sha256": "826e4a210642ce96ea6bf597a39ef493957e4d120d63712ff0ee0e1acfab0d86",
      "target_id": "ru-ru78-u002-r0009",
      "tag": "verse_group",
      "target_sha256": "ca3147689f9f8d0556eed1502e0a863dcae243c1ec2d9b0adfc000e3c02d665c"
    },
    {
      "source_id": "ru78-u002-r0010",
      "target": "Выпьем за суда, что мы взяли!\nОни видели, кто из мужчин лучше.\nМы увозили девиц и грузы,\nА остальное досталось акулам.",
      "source_sha256": "b2d72a1d142571cea39c23cc5e1db124a361f99e22643173407368c8d11f15aa",
      "target_id": "ru-ru78-u002-r0010",
      "tag": "verse_group",
      "target_sha256": "21eb9f97505547d7cc4ef38ea8fa5abe2ac75dbbd93df6b9ba81d5a94c555c37"
    },
